///| Wave M2-F6 Track F6-1 unit tests:
///| 1. Cross-package `pub let` / `pub const` value type ABI export, roundtrip,
///|    backward compatibility, alias remapping, and struct-update resolution.
///| 2. Universal MoonBit checked-error lowering (`suberror`, `raise`, `try`, `catch`,
///|    `noraise`, `try?`, `try!`) positive and fail-closed negative cases.

test "F6-1: ABI v2 values serialization, backward compat & tamper rejection" {
  // 1. Empty values MUST be omitted from JSON so existing ABI v2 SHA-256 hashes are 100% unchanged
  let empty_abi = empty_package_abi("plain_pkg")
  let empty_sha = compute_abi_payload_sha256(empty_abi)
  let empty_pion = "// abi-sha256: " + empty_sha + "\npub fn f() -> Int { 1 }\n"
  let empty_json = render_abi_json(empty_abi, [("lib.pion", empty_pion)])
  assert_true(!str_has(empty_json, "\"values\""), "empty values omitted from ABI v2 JSON")
  let d_empty : Array[Diag] = []
  match verify_and_parse_dep_abi("plain_pkg", "/tmp/plain", [("lib.pion", empty_pion)], Some(empty_json), d_empty) {
    Some(p) => assert_true(p.values.length() == 0 && d_empty.length() == 0, "legacy ABI v2 without values parses as empty")
    None => assert_true(false, "valid ABI v2 without values must verify")
  }

  // 2. Non-empty values are sorted deterministically, roundtrip cleanly, and detect tampering
  let val_abi = PackageAbi::{
    package_name: "up",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [
      AbiValueSchema::{ name: "z_const", ty: "Int" },
      AbiValueSchema::{ name: "default_cfg", ty: "up::Cfg" },
    ],
    raising_fns: [],
    ffi_shim_prefix: "",
    publishable: true,
  }
  let val_sha = compute_abi_payload_sha256(val_abi)
  let val_pion = "// abi-sha256: " + val_sha + "\npub let default_cfg : Cfg = Cfg::{ x: 0 }\n"
  let val_json = render_abi_json(val_abi, [("lib.pion", val_pion)])
  assert_true(str_has(val_json, "\"values\""), "non-empty values included in ABI v2 JSON")
  let d_ok : Array[Diag] = []
  match verify_and_parse_dep_abi("up", "/tmp/up", [("lib.pion", val_pion)], Some(val_json), d_ok) {
    Some(p) => {
      assert_true(p.values.length() == 2, "2 exported values parsed")
      assert_true(p.values[0].name == "default_cfg" && p.values[0].ty == "up::Cfg", "sorted first value")
      assert_true(p.values[1].name == "z_const" && p.values[1].ty == "Int", "sorted second value")
    }
    None => assert_true(false, "valid values ABI must verify")
  }
  // Tampered value type MUST be rejected
  let d_bad : Array[Diag] = []
  match verify_and_parse_dep_abi("up", "/tmp/up", [("lib.pion", val_pion)], Some(str_replace_all(val_json, "\"up::Cfg\"", "\"up::Other\"")), d_bad) {
    Some(_) => assert_true(false, "tampered values must fail")
    None => assert_true(d_bad.length() > 0 && d_bad[0].code == "MBT2PION_DEP_ABI_ERROR", "tampered values rejected")
  }
}

test "F6-1: cross-package pub let / pub const ABI export resolves downstream struct update" {
  let noop_check = fn(_ : Array[(String, String)]) -> String {
    "{\"ok\":true,\"diagnostics\":[]}"
  }
  // Upstream package `up` defines `pub(all) struct Cfg`, `pub let default_cfg : Cfg`, `pub const MAX_STEP : Int`,
  // plus private and untyped bindings that must NOT be exported.
  let up_src = SourceFile::{
    rel_path: "cfg.mbt",
    content: "pub(all) struct Cfg {\n  x : Int\n  y : Int\n}\n\npub let default_cfg : Cfg = { x: 1, y: 2 }\npub const MAX_STEP : Int = 8\nlet hidden_cfg : Cfg = { x: 0, y: 0 }\npub let untyped_val = 99\n",
    is_test: false,
  }
  let up_opts = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "up",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let up_res = transpile_package([up_src], empty_api_map(), default_recipes(), [], [], up_opts, [], false, noop_check)
  assert_true(up_res.blockers == 0, "upstream package transpiles cleanly")
  assert_true(up_res.abi.values.length() == 2, "only typed pub let/pub const exported")
  assert_true(up_res.abi.values[0].name == "MAX_STEP" && up_res.abi.values[0].ty == "Int", "pub const Int exported")
  assert_true(up_res.abi.values[1].name == "default_cfg" && up_res.abi.values[1].ty == "up::Cfg", "pub let Cfg qualified with pkg prefix")

  // Direct symbol table check (including import alias remapping `u` -> `up`)
  let st = empty_symbol_table()
  symtab_load_dep_abi(st, "up", up_res.abi)
  assert_true(st.val_types.get("up::default_cfg") == Some("up::Cfg"), "symtab loads up::default_cfg -> up::Cfg")
  assert_true(st.val_types.get("up::MAX_STEP") == Some("Int"), "symtab loads up::MAX_STEP -> Int")
  let st_alias = empty_symbol_table()
  symtab_load_dep_abi(st_alias, "u", up_res.abi)
  assert_true(st_alias.val_types.get("u::default_cfg") == Some("u::Cfg"), "aliased dep remaps pkg prefix in val_types")

  // Downstream package uses `{ ..@up.default_cfg, x: 10 }` -> MUST resolve to `up::Cfg::{ ... }` with 0 AMBIGUOUS_STRUCT_UPDATE!
  let down_src = SourceFile::{
    rel_path: "use_cfg.mbt",
    content: "pub fn override_x() -> @up.Cfg {\n  { ..@up.default_cfg, x: 10 }\n}\n",
    is_test: false,
  }
  let down_opts = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "down",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let down_res = transpile_package_with_abis(
    [down_src],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [("up", up_res.abi)],
    [],
    down_opts,
    [],
    false,
    noop_check,
  )
  let mut has_ambig = false
  for d in down_res.diagnostics {
    if str_has(d.code, "AMBIGUOUS_STRUCT_UPDATE") {
      has_ambig = true
    }
  }
  assert_true(!has_ambig, "downstream struct update on @up.default_cfg has 0 AMBIGUOUS_STRUCT_UPDATE")
  assert_true(down_res.files.length() > 0 && str_has(down_res.files[0].content, "up::Cfg::{"), "downstream emits up::Cfg::{ ... }")
}

test "F6-1: lower_error suberror declarations" {
  let cfg = default_error_lower_config()
  let diags : Array[Diag] = []
  let src = "suberror SimpleErr String\npub suberror ApiErr Int\npriv suberror ParseErr {\n  ParseErr(String)\n} derive(Show)\nsuberror MultiErr {\n  BadCode(Int)\n  BadMsg(String)\n} derive(Show, Eq)\nsuberror UnitErr\n"
  let out = lower_checked_errors_single(src, "errs.mbt", cfg, diags)
  assert_true(diags.length() == 0, "suberror lowering has 0 diagnostics")
  assert_true(str_has(out, "enum SimpleErr { SimpleErr(String) }"), "payload suberror lowered")
  assert_true(str_has(out, "pub enum ApiErr { ApiErr(Int) }"), "pub suberror preserves pub")
  assert_true(str_has(out, "enum ParseErr {\n  ParseErr(String)\n} derive(Show)"), "braced suberror with derive preserved")
  assert_true(str_has(out, "enum MultiErr {\n  BadCode(Int)\n  BadMsg(String)\n} derive(Show, Eq)"), "multi-variant suberror lowered")
  assert_true(str_has(out, "enum UnitErr { UnitErr }"), "unit suberror lowered")
}

test "F6-1: lower_error local catch, try-catch, noraise, try? and try!" {
  let cfg = default_error_lower_config()
  let diags : Array[Diag] = []
  let src = "priv suberror ParseErr String\nfn parse_num(s : String) -> Int raise ParseErr {\n  if s == \"\" { raise ParseErr(\"empty\") }\n  42\n}\nfn helper(s : String) -> Unit {\n  let a = @json.parse(s) catch { _ => return }\n  let _ = a\n}\nfn loop_catch(xs : Array[String]) -> Int {\n  let mut n = 0\n  for s in xs {\n    let v = @json.parse(s) catch { _ => continue }\n    let _ = v\n    n = n + 1\n  }\n  n\n}\nfn try_some(s : String) -> Option[Json] {\n  try Some(@json.parse(s)) catch { _ => None }\n}\nfn try_noraise(s : String) -> Int {\n  try parse_num(s) catch { ParseErr(_) => -1 } noraise { v => v + 1 }\n}\nfn try_compound(s : String) -> Int {\n  try { let a = parse_num(s); a + 10 } catch { _ => 0 }\n}\nfn try_q(s : String) -> Result[Int, ParseErr] {\n  try? parse_num(s)\n}\nfn try_bang(s : String) -> Int {\n  try! parse_num(s)\n}\n"
  let out = lower_checked_errors_single(src, "handlers.mbt", cfg, diags)
  assert_true(diags.length() == 0, "all supported catch/try forms lower with 0 diagnostics")
  assert_true(str_has(out, "match mbt_compat::mbt_json_parse(s) { Ok(") && str_has(out, "Err(_) => return }"), "postfix catch with return lowered inline")
  assert_true(str_has(out, "Err(_) => continue }"), "postfix catch with continue lowered inline")
  assert_true(str_has(out, "=> Some(") && str_has(out, "Err(_) => None }"), "try Some(@json.parse(s)) zero-closure fast path")
  assert_true(str_has(out, "match parse_num(s) { Ok(v) => v + 1, Err("), "try ... catch ... noraise lowered directly")
  assert_true(str_has(out, "(fn() { Ok({ let a = (match parse_num(s) { Ok(") && str_has(out, "return Err("), "compound try body lowered via IIFE with match propagation")
  assert_true(str_has(out, "fn try_q(s : String) -> Result[Int, ParseErr] {\n  parse_num(s)\n}"), "try? on direct call returns Result directly")
  assert_true(str_has(out, "mbt_compat::mbt_abort(\"try! failed\")"), "try! calls mbt_compat::mbt_abort on Err")
}

test "F6-1: lower_error raise functions, methods & non-try-op mode" {
  let cfg = default_error_lower_config()
  let diags : Array[Diag] = []
  let src = "priv suberror ParseErr String\nstruct Scanner { mut pos : Int }\nfn[T] Scanner::fail(self : Scanner, msg : String) -> T raise ParseErr {\n  raise ParseErr(msg)\n}\nfn Scanner::step(self : Scanner) -> Unit raise ParseErr {\n  if self.pos < 0 { self.fail(\"neg\") }\n  self.pos = self.pos + 1\n}\nfn Scanner::read_int(self : Scanner) -> Int raise ParseErr {\n  self.step()\n  if self.pos == 0 { return 0 }\n  self.pos\n}\n"
  let out = lower_checked_errors_single(src, "raising.mbt", cfg, diags)
  assert_true(diags.length() == 0, "raising functions and methods lower cleanly")
  assert_true(str_has(out, "fn[T] Scanner::fail(self : Scanner, msg : String) -> Result[T, ParseErr] {"), "generic raising method signature lowered")
  assert_true(!str_has(out, "Ok({ return Err("), "tail raise is not double-wrapped in Ok")
  assert_true(str_has(out, "self.fail(\"neg\")?"), "raising method call propagated with ?")
  assert_true(str_has(out, "self.step()?"), "unit raising method call propagated with ?")
  assert_true(str_has(out, "return Ok(0)"), "early return inside raising fn wrapped in Ok")

  // Verify `use_try_op: false` expands propagation to explicit `match`
  let cfg_match = ErrorLowerConfig::{
    known_raising_calls: cfg.known_raising_calls,
    use_try_op: false,
    default_err_type: "String",
  }
  let d2 : Array[Diag] = []
  let out2 = lower_checked_errors_single(src, "raising_match.mbt", cfg_match, d2)
  assert_true(d2.length() == 0, "match-expansion mode lowers cleanly")
  assert_true(str_has(out2, "(match self.step() { Ok(") && str_has(out2, "=> return Err("), "match-expansion emits explicit match propagation")
}

test "F6-1: lower_error fail-closed negative cases" {
  let cfg = default_error_lower_config()
  let bad_cases : Array[(String, String)] = [
    ("hof_raise_param", "suberror E String\nfn run(cb : (Int) -> Int raise E) -> Int { cb(1) }\n"),
    ("inline_raise_closure", "suberror E String\nfn f() -> Unit { let _ = (fn(x : Int) -> Int raise E { raise E(\"x\") })(1) }\n"),
    ("unknown_ext_catch", "fn f(s : String) -> Int { @unknown.parse(s) catch { _ => 0 } }\n"),
    ("unknown_ext_try", "fn f(s : String) -> Int { try @unknown.parse(s) catch { _ => 0 } }\n"),
    ("first_class_raise_fn", "suberror E String\nfn boom() -> Int raise E { raise E(\"x\") }\nfn f() -> Unit { let g = boom; let _ = g }\n"),
    ("uncaught_raise", "suberror E String\nfn f() -> Int { raise E(\"x\") }\n"),
    ("uncaught_raising_call", "suberror E String\nfn boom() -> Int raise E { raise E(\"x\") }\nfn f() -> Int { boom() }\n"),
    ("unresolved_method_recv", "suberror E String\nstruct S { x : Int }\nfn S::boom(self : S) -> Int raise E { raise E(\"x\") }\nfn f(xs : Array[S]) -> Int raise E { xs[0].boom() }\n"),
    ("break_in_compound_try", "suberror E String\nfn boom() -> Int raise E { raise E(\"x\") }\nfn f() -> Int { let mut a = 0; while a < 3 { a = a + (try { if a == 1 { break }; boom() } catch { _ => 0 }) }; a }\n"),
    ("bare_raise", "fn f(x : Int) -> Int raise { x }\n"),
    ("raise_error", "fn f(x : Int) -> Int raise Error { x }\n"),
    ("incomplete_catch", "suberror E { A; B(Int) }\nfn boom() -> Int raise E { raise A }\nfn f() -> Int { boom() catch { A => 1 } }\n"),
    ("guarded_catch", "suberror E { A; B(Int) }\nfn boom() -> Int raise E { raise A }\nfn f(c : Bool) -> Int { boom() catch { A if c => 1; B(_) => 2 } }\n"),
    ("refutable_payload_catch", "suberror E { A; B(Int) }\nfn boom() -> Int raise E { raise A }\nfn f() -> Int { boom() catch { A => 1; B(0) => 2 } }\n"),
    ("catch_bang_plain_fn", "suberror E { A; B(Int) }\nfn boom() -> Int raise E { raise A }\nfn f() -> Int { boom() catch! { A => 1 } }\n"),
    ("catch_bang_mismatch_err", "suberror E1 { A1; B1 }\nsuberror E2 { A2 }\nfn boom() -> Int raise E1 { raise A1 }\nfn f() -> Int raise E2 { boom() catch! { A1 => 1 } }\n"),
    ("rethrow_mismatch_err", "suberror E1 { A1; B1 }\nsuberror E2 { A2 }\nfn boom() -> Int raise E1 { raise A1 }\nfn f() -> Int raise E2 { boom() catch { e => raise e } }\n"),
  ]
  for bc in bad_cases {
    let ds : Array[Diag] = []
    let _ = lower_checked_errors_single(bc.1, bc.0 + ".mbt", cfg, ds)
    let mut hit = false
    for d in ds {
      if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" {
        hit = true
      }
    }
    assert_true(hit, "fail-closed case `" + bc.0 + "` MUST emit MBT2PION_UNSUPPORTED_SYNTAX")
  }
}

test "F6-1: R2 regressions (nested raising arg in try/catch, bare try boundary, trailing comment & multiline return, let/for shadow)" {
  let cfg = default_error_lower_config()
  // P1-1: nested raising argument inside `try ... catch` and postfix `catch` must NOT escape via `?` to outer RaisingFn
  let d1 : Array[Diag] = []
  let src1 = "priv suberror ParseErr String\nfn parse_num(s : String) -> Int raise ParseErr {\n  if s == \"\" { raise ParseErr(\"empty\") }\n  42\n}\nfn outer_try(s : String) -> Int raise ParseErr {\n  try parse_num(parse_num(s).to_string()) catch { _ => 0 }\n}\nfn outer_postfix(s : String) -> Int raise ParseErr {\n  parse_num(parse_num(s).to_string()) catch { _ => 0 }\n}\n"
  let out1 = lower_checked_errors_single(src1, "p1_1.mbt", cfg, d1)
  assert_true(d1.length() == 0, "P1-1 nested raising args lower cleanly")
  assert_true(!str_has(out1, "parse_num(s)?"), "P1-1 inner parse_num(s) must NOT use `?` and bypass try/catch")
  assert_true(str_has(out1, "match (fn() { Ok({ (match parse_num((match parse_num(s)"), "P1-1 both outer and inner calls lowered inside TryClosure IIFE")

  // P1-2: bare `try` without `catch` must NOT cross `;` or newline to steal a later statement's `catch`
  let d2a : Array[Diag] = []
  let _ = lower_checked_errors_single("fn f(s : String) -> Int {\n  try parse_num(s); let x = @json.parse(s) catch { _ => 0 }\n  x\n}\n", "p1_2a.mbt", cfg, d2a)
  let mut hit2a = false
  for d in d2a { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit2a = true } }
  assert_true(hit2a, "P1-2a bare try before `;` fails closed without stealing next catch")
  let d2b : Array[Diag] = []
  let _ = lower_checked_errors_single("fn f(s : String) -> Int {\n  try parse_num(s)\n  let x = @json.parse(s) catch { _ => 0 }\n  x\n}\n", "p1_2b.mbt", cfg, d2b)
  let mut hit2b = false
  for d in d2b { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit2b = true } }
  assert_true(hit2b, "P1-2b bare try before newline fails closed without stealing next catch")

  // P1-3: trailing line comment inside raising fn body does not swallow `})` and multiline binary return is not truncated
  let d3 : Array[Diag] = []
  let src3 = "priv suberror E String\nfn with_comment_and_ml_ret(a : Int, b : Int) -> Int raise E {\n  if a < 0 {\n    return a +\n      b\n  }\n  a + b // trailing comment\n}\n"
  let out3 = lower_checked_errors_single(src3, "p1_3.mbt", cfg, d3)
  assert_true(d3.length() == 0, "P1-3 trailing comment & multiline return lower cleanly")
  assert_true(str_has(out3, "// trailing comment\n}) }"), "P1-3 newline separates trailing comment from closing braces")
  assert_true(str_has(out3, "return Ok(a +\n      b)"), "P1-3 multiline binary return stays intact inside Ok(...)")

  // P1-4: `let (boom, x) = ...` and `for boom in xs` shadow same-named `pkg_raise_fns`
  let d4 : Array[Diag] = []
  let src4 = "priv suberror E String\nfn boom() -> Int raise E { raise E(\"x\") }\nfn shadow_test(pair : (Int, Int), xs : Array[Int]) -> Int {\n  let (boom, x) = pair\n  let mut acc = boom + x\n  for boom in xs {\n    acc = acc + boom\n  }\n  acc\n}\n"
  let out4 = lower_checked_errors_single(src4, "p1_4.mbt", cfg, d4)
  assert_true(d4.length() == 0, "P1-4 destructuring let and for-in binders shadow raising fn boom")
  assert_true(str_has(out4, "acc = acc + boom"), "P1-4 shadowed boom preserved verbatim")

  // P1-5: match arm pattern shadowing + unknown Type::fn() return type fails closed
  let d5a : Array[Diag] = []
  let src5a = "priv suberror E String\nstruct Scanner { mut pos : Int }\nfn Scanner::step(self : Scanner) -> Unit raise E { raise E(\"x\") }\nfn match_shadow(s : Scanner, opt : Option[Int]) -> Int {\n  let _ = s\n  match opt {\n    Some(s) => s + 1\n    None => 0\n  }\n}\n"
  let out5a = lower_checked_errors_single(src5a, "p1_5a.mbt", cfg, d5a)
  assert_true(d5a.length() == 0 && str_has(out5a, "Some(s) => s + 1"), "P1-5a match arm binds s cleanly")
  let d5b : Array[Diag] = []
  let src5b = "priv suberror E String\nstruct Scanner { mut pos : Int }\nfn Scanner::step(self : Scanner) -> Unit raise E { raise E(\"x\") }\nfn f(s : Scanner, opt : Option[Other]) -> Unit raise E {\n  let _ = s\n  match opt {\n    Some(s) => s.step()\n    None => ()\n  }\n}\n"
  let _ = lower_checked_errors_single(src5b, "p1_5b.mbt", cfg, d5b)
  let mut hit5b = false
  for d in d5b { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit5b = true } }
  assert_true(hit5b, "P1-5b match-shadowed s.step() must NOT inherit outer Scanner type")
  let d5c : Array[Diag] = []
  let src5c = "priv suberror E String\nstruct Scanner { mut pos : Int }\nfn Scanner::step(self : Scanner) -> Unit raise E { raise E(\"x\") }\nfn f() -> Unit raise E {\n  let x = Scanner::unknown_ctor()\n  x.step()\n}\n"
  let _ = lower_checked_errors_single(src5c, "p1_5c.mbt", cfg, d5c)
  let mut hit5c = false
  for d in d5c { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit5c = true } }
  assert_true(hit5c, "P1-5c unknown Type::fn() return type must NOT guess Scanner")

  // P1-6: `match try? parse_num(s) { ... }` truncates before outer `{`
  let d6 : Array[Diag] = []
  let src6 = "priv suberror ParseErr String\nfn parse_num(s : String) -> Int raise ParseErr {\n  if s == \"\" { raise ParseErr(\"empty\") }\n  42\n}\nfn use_match_try_q(s : String) -> Int {\n  match try? parse_num(s) {\n    Ok(v) => v\n    Err(_) => 0\n  }\n}\n"
  let out6 = lower_checked_errors_single(src6, "p1_6.mbt", cfg, d6)
  assert_true(d6.length() == 0, "P1-6 match try? lowers cleanly")
  assert_true(str_has(out6, "match parse_num(s) {\n    Ok(v) => v"), "P1-6 try? stops before match body brace")

  // P1-7: trailing generics `fn id_raise[T](x : T) -> T raise E`
  let d7 : Array[Diag] = []
  let src7 = "priv suberror E String\nfn id_raise[T](x : T) -> T raise E {\n  x\n}\nfn call_id(n : Int) -> Int raise E {\n  id_raise(n)\n}\n"
  let out7 = lower_checked_errors_single(src7, "p1_7.mbt", cfg, d7)
  assert_true(d7.length() == 0, "P1-7 trailing generic raising fn lowers cleanly")
  assert_true(str_has(out7, "id_raise(n)?"), "P1-7 trailing generic raising fn call recognized and propagated")

  // P2-1: conflicting canonical `values` across two aliases marks ambiguity and removes ambiguous canon entry
  let abi_c1 = PackageAbi::{ package_name: "shared", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [AbiValueSchema::{ name: "v", ty: "Int" }], raising_fns: [], ffi_shim_prefix: "", publishable: true }
  let abi_c2 = PackageAbi::{ package_name: "shared", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [AbiValueSchema::{ name: "v", ty: "String" }], raising_fns: [], ffi_shim_prefix: "", publishable: true }
  let st_amb = empty_symbol_table()
  symtab_load_dep_abi(st_amb, "a1", abi_c1)
  symtab_load_dep_abi(st_amb, "a2", abi_c2)
  assert_true(st_amb.val_types.get("a1::v") == Some("Int") && st_amb.val_types.get("a2::v") == Some("String"), "P2-1 direct alias keys preserved")
  assert_true(st_amb.val_types.get("shared::v") == None && st_amb.canon_val_types_ambig.contains("shared::v"), "P2-1 conflicting canonical value removed & marked ambiguous")

  // P2-2: top-level `let`/`const` containing `try`/`catch`/`raise` fails closed
  let d8 : Array[Diag] = []
  let _ = lower_checked_errors_single("let bad : Int = @json.parse(\"1\") catch { _ => 0 }\n", "p2_2.mbt", cfg, d8)
  let mut hit8 = false
  for d in d8 { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit8 = true } }
  assert_true(hit8, "P2-2 residual catch outside top-level fn/test fails closed")
}

test "F6-1: R3 regressions (unannotated cross-pkg struct update, interp in try/top-level, order-invariant canon_val_types, arrow closures)" {
  let noop_check = fn(_ : Array[(String, String)]) -> String {
    "{\"ok\":true,\"diagnostics\":[]}"
  }
  // P1-1: unannotated `let b = { ..@up.preset, x: 10 }; b.x + b.y` (direct, aliased `@u.preset`, and `pub using` re-export)
  let up_src = SourceFile::{
    rel_path: "cfg.mbt",
    content: "pub(all) struct Cfg {\n  x : Int\n  y : Int\n}\npub let preset : Cfg = { x: 1, y: 3 }\n",
    is_test: false,
  }
  let up_opts = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "up",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let up_res = transpile_package([up_src], empty_api_map(), default_recipes(), [], [], up_opts, [], false, noop_check)
  assert_true(up_res.blockers == 0, "R3 P1-1 upstream compiles cleanly")

  // Direct `@up.preset` with NO outer type annotation on `let b` or return type
  let down_direct = SourceFile::{
    rel_path: "direct.mbt",
    content: "pub fn run() -> Int {\n  let b = { ..@up.preset, x: 10 }\n  b.x + b.y\n}\n",
    is_test: false,
  }
  let down_opts = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "down",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let res_direct = transpile_package_with_abis([down_direct], empty_api_map(), default_recipes(), [], [], [], [("up", up_res.abi)], [], down_opts, [], false, noop_check)
  assert_true(res_direct.blockers == 0 && str_has(res_direct.files[0].content, "up::Cfg::{"), "R3 P1-1 unannotated @up.preset struct update resolves to up::Cfg")

  // Aliased `@u.preset` with NO outer type annotation
  let down_alias = SourceFile::{
    rel_path: "alias.mbt",
    content: "pub fn run() -> Int {\n  let b = { ..@u.preset, x: 10 }\n  b.x + b.y\n}\n",
    is_test: false,
  }
  let res_alias = transpile_package_with_abis([down_alias], empty_api_map(), default_recipes(), [], [], [], [("u", up_res.abi)], [], down_opts, [], false, noop_check)
  assert_true(res_alias.blockers == 0 && str_has(res_alias.files[0].content, "u::Cfg::{"), "R3 P1-1 unannotated @u.preset struct update resolves to u::Cfg")

  // Re-exported `pub using @up { type Cfg, preset }`: remaps `up::Cfg` -> `mid::Cfg` (and alias `m::Cfg`) in `symtab_finalize_dep_reexports`
  let mid_abi = PackageAbi::{
    package_name: "mid",
    enums: [],
    struct_val_fields: [],
    structs: Some([]),
    companion_files: [],
    op_impls: [],
    reexports: [
      AbiReexport::{ name: "Cfg", kind: "type", target_pkg: "up", target_name: "Cfg" },
      AbiReexport::{ name: "preset", kind: "value", target_pkg: "up", target_name: "preset" },
    ],
    values: [],
    raising_fns: [],
    ffi_shim_prefix: "",
    publishable: true,
  }
  let st_re = empty_symbol_table()
  symtab_load_dep_abi(st_re, "up", up_res.abi)
  symtab_load_dep_abi(st_re, "mid", mid_abi)
  let d_re : Array[Diag] = []
  symtab_finalize_dep_reexports(st_re, d_re)
  assert_true(d_re.length() == 0 && st_re.val_types.get("mid::preset") == Some("mid::Cfg"), "R3 P1-1 re-exported value type remaps to mid::Cfg")
  let st_re_alias = empty_symbol_table()
  symtab_load_dep_abi(st_re_alias, "up", up_res.abi)
  symtab_load_dep_abi(st_re_alias, "m", mid_abi)
  let d_re_a : Array[Diag] = []
  symtab_finalize_dep_reexports(st_re_alias, d_re_a)
  assert_true(d_re_a.length() == 0 && st_re_alias.val_types.get("m::preset") == Some("m::Cfg"), "R3 P1-1 aliased re-exported value type remaps to m::Cfg")

  // P1-2: raising call inside string interpolation in `try ... catch` / postfix `catch` + top-level interp residual
  let cfg = default_error_lower_config()
  let d_interp : Array[Diag] = []
  let src_interp = "priv suberror E String\nfn bad() -> Int raise E { raise E(\"boom\") }\nfn take(s : String) -> Int raise E { s.length() }\nfn outer_try() -> Int raise E {\n  try take(\"\\{bad()}\") catch { _ => 7 }\n}\nfn outer_postfix() -> Int raise E {\n  take(\"\\{bad()}\") catch { _ => 7 }\n}\n"
  let out_interp = lower_checked_errors_single(src_interp, "p1_2_interp.mbt", cfg, d_interp)
  assert_true(d_interp.length() == 0, "R3 P1-2 interp inside try/catch lowers cleanly")
  assert_true(!str_has(out_interp, "bad()?"), "R3 P1-2 bad() inside interp must NOT use `?` and escape try/catch")
  assert_true(str_has(out_interp, "(fn() { Ok({ (match take(\"\\{(match bad()"), "R3 P1-2 interp raising call lowered inside TryClosure IIFE")

  let d_top_interp : Array[Diag] = []
  let _ = lower_checked_errors_single("let n : String = \"\\{@json.parse(\"1\") catch { _ => 7 }}\"\n", "p1_2_top.mbt", cfg, d_top_interp)
  let mut hit_top_interp = false
  for d in d_top_interp { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit_top_interp = true } }
  assert_true(hit_top_interp, "R3 P1-2 top-level string interpolation with catch fails closed")

  // P2-1: load-order invariance between `(shared, b)` and `(b, shared)` when sharing `package_name = "shared"`
  let abi_s1 = PackageAbi::{ package_name: "shared", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [AbiValueSchema::{ name: "v", ty: "Int" }], raising_fns: [], ffi_shim_prefix: "", publishable: true }
  let abi_s2 = PackageAbi::{ package_name: "shared", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [AbiValueSchema::{ name: "v", ty: "String" }], raising_fns: [], ffi_shim_prefix: "", publishable: true }
  let st_ab = empty_symbol_table()
  symtab_load_dep_abi(st_ab, "shared", abi_s1)
  symtab_load_dep_abi(st_ab, "b", abi_s2)
  let st_ba = empty_symbol_table()
  symtab_load_dep_abi(st_ba, "b", abi_s2)
  symtab_load_dep_abi(st_ba, "shared", abi_s1)
  assert_true(st_ab.val_types.get("shared::v") == Some("Int") && st_ba.val_types.get("shared::v") == Some("Int"), "R3 P2-1 direct shared::v order-invariant")
  assert_true(st_ab.val_types.get("b::v") == Some("String") && st_ba.val_types.get("b::v") == Some("String"), "R3 P2-1 direct b::v order-invariant")
  assert_true(st_ab.canon_val_types.get("shared::v") == None && st_ba.canon_val_types.get("shared::v") == None, "R3 P2-1 conflicting canon_val_types removed in both orders")
  assert_true(st_ab.canon_val_types_ambig.contains("shared::v") && st_ba.canon_val_types_ambig.contains("shared::v"), "R3 P2-1 canon_val_types_ambig true in both orders")

  // P2-2: arrow closures isolate `return` from enclosing raising fn and reject `raise` inside arrow closure
  let d_arr : Array[Diag] = []
  let src_arr = "priv suberror E String\nfn with_arrows() -> Int raise E {\n  let f = n => { if n > 0 { return 3 }; 2 }\n  let g = (a, b) => { if a > b { return a }; b }\n  f(1) + g(4, 2)\n}\n"
  let out_arr = lower_checked_errors_single(src_arr, "p2_2_arrow.mbt", cfg, d_arr)
  assert_true(d_arr.length() == 0, "R3 P2-2 arrow closures inside raising fn lower cleanly")
  assert_true(str_has(out_arr, "return 3") && str_has(out_arr, "return a"), "R3 P2-2 return inside arrow closure NOT wrapped in Ok")
  assert_true(!str_has(out_arr, "return Ok(3)") && !str_has(out_arr, "return Ok(a)"), "R3 P2-2 no Ok-wrapping of arrow closure returns")

  let d_arr_bad : Array[Diag] = []
  let _ = lower_checked_errors_single("priv suberror E String\nfn f() -> Int raise E {\n  let g = n => { if n < 0 { raise E(\"neg\") }; n }\n  g(1)\n}\n", "p2_2_arrow_bad.mbt", cfg, d_arr_bad)
  let mut hit_arr_bad = false
  for d in d_arr_bad { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit_arr_bad = true } }
  assert_true(hit_arr_bad, "R3 P2-2 raise inside arrow closure fails closed")
}

test "F6-1: R4 regressions (nonlocal control flow in interp, match arm vs inner arrow closure)" {
  let cfg = default_error_lower_config()
  // 1. `return` inside string interpolation in `try ... catch` and postfix `catch` lowers via MbtTryOutcome
  let d1a : Array[Diag] = []
  let out1a = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn take(s : String) -> Int raise E { s.length() }\nfn outer(stop : Bool) -> Int raise E {\n  let v = try take(\"\\{if stop { return 42 } else { bad() }}\") catch { _ => 7 }\n  v + 1\n}\n", "r4_1a.mbt", cfg, d1a)
  assert_true(d1a.length() == 0 && str_has(out1a, "MbtTryOutcome") && str_has(out1a, "return MbtTryRet(42)"), "R4 return inside try interp lowered via MbtTryOutcome")

  let d1b : Array[Diag] = []
  let out1b = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn take(s : String) -> Int raise E { s.length() }\nfn outer(stop : Bool) -> Int raise E {\n  let v = take(\"\\{if stop { return 42 } else { bad() }}\") catch { _ => 7 }\n  v + 1\n}\n", "r4_1b.mbt", cfg, d1b)
  assert_true(d1b.length() == 0 && str_has(out1b, "MbtTryOutcome") && str_has(out1b, "return MbtTryRet(42)"), "R4 return inside postfix catch interp lowered via MbtTryOutcome")

  // 2. `break` inside string interpolation inside `try` within outer loop fails closed
  let d2 : Array[Diag] = []
  let _ = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn f() -> Int {\n  let mut acc = 0\n  while acc < 10 {\n    acc = acc + (try { let _ = \"\\{break}\"; bad() } catch { _ => 7 })\n  }\n  acc\n}\n", "r4_2.mbt", cfg, d2)
  let mut hit2 = false
  for d in d2 { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit2 = true } }
  assert_true(hit2, "R4 break inside try interp fails closed")

  // 3. `match` arm `pat => { return 42 }` inside `try` lowers via MbtTryOutcome (never mistaken for arrow closure!)
  let d3 : Array[Diag] = []
  let out3 = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn f(stop : Bool) -> Int {\n  try { match stop { true => { return 42 }; false => bad() } } catch { _ => 7 }\n}\n", "r4_3.mbt", cfg, d3)
  assert_true(d3.length() == 0 && str_has(out3, "return MbtTryRet(42)"), "R4 match arm return inside try lowered via MbtTryOutcome")

  // 4. Inner arrow closure `let g = n => { if n > 0 { return n }; 0 }` inside `try` passes cleanly without MbtTryOutcome
  let d4 : Array[Diag] = []
  let out4 = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn f() -> Int {\n  try { let g = n => { if n > 0 { return n }; 0 }; g(bad()) } catch { _ => 7 }\n}\n", "r4_4.mbt", cfg, d4)
  assert_true(d4.length() == 0 && !str_has(out4, "MbtTryOutcome"), "R4 inner arrow closure return inside try allowed")
  assert_true(str_has(out4, "if n > 0 { return n }"), "R4 inner arrow closure return preserved verbatim")

  // 5. Comma-separated `match` arm inside `try` (top-level or nested inside parens) lowers via MbtTryOutcome
  let d5a : Array[Diag] = []
  let out5a = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn f(stop : Bool) -> Int {\n  try { match stop { true => 0, y => { return 42 } }; bad() } catch { _ => 7 }\n}\n", "r5_1a.mbt", cfg, d5a)
  assert_true(d5a.length() == 0 && str_has(out5a, "return MbtTryRet(42)"), "R5 comma-separated match arm return inside try lowered via MbtTryOutcome")

  let d5b : Array[Diag] = []
  let out5b = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn id(x : Int) -> Int { x }\nfn f(stop : Bool) -> Int {\n  try { id(match stop { true => 0, y => { return 42 } }) + bad() } catch { _ => 7 }\n}\n", "r5_1b.mbt", cfg, d5b)
  assert_true(d5b.length() == 0 && str_has(out5b, "return MbtTryRet(42)"), "R5 comma-separated match arm nested inside call parens lowered via MbtTryOutcome")

  // 6. Comma-separated call-argument arrow closure `apply(1, n => { return n })` inside `try` passes cleanly
  let d6 : Array[Diag] = []
  let out6 = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn apply(x : Int, f : (Int) -> Int) -> Int { f(x) }\nfn f() -> Int {\n  try { apply(1, n => { if n > 0 { return n }; 0 }) + bad() } catch { _ => 7 }\n}\n", "r5_2.mbt", cfg, d6)
  assert_true(d6.length() == 0 && !str_has(out6, "MbtTryOutcome"), "R5 call-arg arrow closure after comma inside try allowed")
  assert_true(str_has(out6, "if n > 0 { return n }"), "R5 call-arg arrow closure return preserved verbatim")
}

test "F6-1: R6 regressions (interp char/comment boundaries, loop cond block depth, wildcard/if-branch arrow closures)" {
  let cfg = default_error_lower_config()

  // 1a. `split_interp_string` respects char literals `'}'`, `'"'`, `b'}'`, line comments `// }`, and block comments `/* } */`
  let sp1 = split_interp_string("\"a\\{if c == '}' { 1 } else { 2 }}b\"", false)
  assert_true(sp1.length() == 3 && sp1[1].is_expr && sp1[1].text == "if c == '}' { 1 } else { 2 }", "split_interp_string keeps char '}' inside hole")
  let sp2 = split_interp_string("\"\\{if c == '\"' && b == b'}' { 1 } else { 2 }}\"", false)
  assert_true(sp2.length() == 1 && sp2[0].is_expr && sp2[0].text == "if c == '\"' && b == b'}' { 1 } else { 2 }", "split_interp_string keeps '\"' and b'}' inside hole")
  let sp3 = split_interp_string("\"\\{1 /* } /* } */ */ + // }\n2}\"", false)
  assert_true(sp3.length() == 1 && sp3[0].is_expr && sp3[0].text == "1 /* } /* } */ */ + // }\n2", "split_interp_string skips // } and nested /* } */ comments")

  // 1b. Nonlocal `return` after `c == '}'` inside `try` and postfix `catch` interp lowers via MbtTryOutcome
  let d1a : Array[Diag] = []
  let out1a = lower_checked_errors_single("priv suberror E String\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn take(s : String, x : Int) -> Int raise E { s.length() + x }\nfn outer(c : Char) -> Int raise E {\n  let v = try take(\"\\{if c == '}' { return 42 } else { 0 }}\", good(false)) catch { _ => 7 }\n  v + 1\n}\n", "r6_1a.mbt", cfg, d1a)
  assert_true(d1a.length() == 0 && str_has(out1a, "return MbtTryRet(42)"), "R6 return after char '}' inside try interp lowered via MbtTryOutcome")

  let d1b : Array[Diag] = []
  let out1b = lower_checked_errors_single("priv suberror E String\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn take(s : String, x : Int) -> Int raise E { s.length() + x }\nfn outer(c : Char) -> Int raise E {\n  let v = take(\"\\{if c == '}' { return 42 } else { 0 }}\", good(false)) catch { _ => 7 }\n  v + 1\n}\n", "r6_1b.mbt", cfg, d1b)
  assert_true(d1b.length() == 0 && str_has(out1b, "return MbtTryRet(42)"), "R6 return after char '}' inside postfix catch interp lowered via MbtTryOutcome")

  // 2. Loop with block-containing condition inside `try` keeps loop depth for body `break`
  let d2 : Array[Diag] = []
  let out2 = lower_checked_errors_single("priv suberror E String\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f() -> Int {\n  try {\n    let mut i = 0\n    while i < (if i == 0 { 2 } else { 3 }) {\n      i = i + 1\n      let _ = \"\\{if i == 2 { break } else { 1 }}\"\n    }\n    i + good(false)\n  } catch { _ => 7 }\n}\n", "r6_2.mbt", cfg, d2)
  assert_true(d2.length() == 0, "R6 loop with block condition inside try allows body break")
  assert_true(str_has(out2, "break"), "R6 loop body break preserved")

  // 3. Wildcard `_ => { return 5 }` and `if`-branch tail `n => { return n + 4 }` inside `try` pass cleanly
  let d3a : Array[Diag] = []
  let out3a = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn apply(x : Int, f : (Int) -> Int) -> Int { f(x) }\nfn f() -> Int {\n  try { apply(1, _ => { return 5 }) + bad() } catch { _ => 7 }\n}\n", "r6_3a.mbt", cfg, d3a)
  assert_true(d3a.length() == 0 && !str_has(out3a, "MbtTryOutcome"), "R6 wildcard arrow closure inside try allowed")
  assert_true(str_has(out3a, "_ => { return 5 }"), "R6 wildcard arrow closure return preserved verbatim")

  let d3b : Array[Diag] = []
  let out3b = lower_checked_errors_single("priv suberror E String\nfn bad() -> Int raise E { raise E(\"b\") }\nfn f(c : Bool) -> Int {\n  try {\n    let g = if c { n => { return n + 4 } } else { _ => { return 5 } }\n    g(bad())\n  } catch { _ => 7 }\n}\n", "r6_3b.mbt", cfg, d3b)
  assert_true(d3b.length() == 0 && !str_has(out3b, "MbtTryOutcome"), "R6 if-branch tail arrow closures inside try allowed")
  assert_true(str_has(out3b, "return n + 4") && !str_has(out3b, "return Ok(n + 4)"), "R6 if-branch arrow closure return not wrapped in Ok")
}

test "F6-1: R7 regressions (match empty block scrutinee, bare while condition block, loop arm return lowering)" {
  let cfg = default_error_lower_config()

  // 1. `match {} { _ => { if stop { return 42 } } }` inside `try` lowers via MbtTryOutcome (empty `{}` is scrutinee, not arm block)
  let d1 : Array[Diag] = []
  let out1 = lower_checked_errors_single("priv suberror E String\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Int raise E {\n  let v = try { match {} { _ => { if stop { return 42 } } }; good(false) } catch { _ => 7 }\n  v + 1\n}\n", "r7_1.mbt", cfg, d1)
  assert_true(d1.length() == 0 && str_has(out1, "return MbtTryRet(42)"), "R7 match empty block scrutinee arm return inside try lowered via MbtTryOutcome")

  // 2a. Bare condition block `while { i < 2 } { ... break ... }` inside `try` keeps loop depth
  let d2a : Array[Diag] = []
  let out2a = lower_checked_errors_single("priv suberror E String\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f() -> Int {\n  try {\n    let mut i = 0\n    while { i < 2 } {\n      i = i + 1\n      let _ = \"\\{if i == 2 { break } else { 1 }}\"\n    }\n    i + good(false)\n  } catch { _ => 7 }\n}\n", "r7_2a.mbt", cfg, d2a)
  assert_true(d2a.length() == 0, "R7 bare while condition block inside try allows body break")
  assert_true(str_has(out2a, "break"), "R7 bare while condition block break preserved")

  // 2b. Struct-pattern `while h is { count: 1 } && i < 2 { ... break ... }` inside `try` keeps loop depth
  let d2b : Array[Diag] = []
  let out2b = lower_checked_errors_single("priv suberror E String\nstruct Holder { count : Int }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f(h : Holder) -> Int {\n  try {\n    let mut i = 0\n    while h is { count: 1 } && i < 2 {\n      i = i + 1\n      let _ = \"\\{if i == 2 { break } else { 1 }}\"\n    }\n    i + good(false)\n  } catch { _ => 7 }\n}\n", "r7_2b.mbt", cfg, d2b)
  assert_true(d2b.length() == 0, "R7 while is-struct-pattern condition inside try allows body break")
  assert_true(str_has(out2b, "break"), "R7 while is-struct-pattern break preserved")

  // 3. `loop 1 { _ => { return 42 } }` inside `raise` fn wraps `return 42` as `return Ok(42)` (not PlainFn arrow closure!)
  let d3 : Array[Diag] = []
  let out3 = lower_checked_errors_single("priv suberror E String\nfn f() -> Int raise E {\n  loop 1 {\n    _ => { return 42 }\n  }\n}\n", "r7_3.mbt", cfg, d3)
  assert_true(d3.length() == 0, "R7 loop arm return in raising fn lowers cleanly")
  assert_true(str_has(out3, "return Ok(42)"), "R7 loop arm return wrapped as Ok(42)")
}

test "F6-1: R8 regressions (for-in trailing semi, newline block after while, struct literal with arrow in match scrutinee)" {
  let cfg = default_error_lower_config()

  // 1. `for x in [1, 2] { i = i + x; break }; good(false) + i` inside `try` passes cleanly (0 diag)
  let d1 : Array[Diag] = []
  let out1 = lower_checked_errors_single("priv suberror E String\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f() -> Int {\n  try {\n    let mut i = 0\n    for x in [1, 2] { i = i + x; break }; good(false) + i\n  } catch { _ => 7 }\n}\n", "r8_1.mbt", cfg, d1)
  assert_true(d1.length() == 0, "R8 for-in followed by semicolon inside try allows body break")
  assert_true(str_has(out1, "break"), "R8 for-in body break preserved")

  // 2. `while i < 2 { i = i + 1; break }\n{ good(false) + i }` inside `try` passes cleanly (0 diag)
  let d2 : Array[Diag] = []
  let out2 = lower_checked_errors_single("priv suberror E String\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f() -> Int {\n  try {\n    let mut i = 0\n    while i < 2 { i = i + 1; break }\n    { good(false) + i }\n  } catch { _ => 7 }\n}\n", "r8_2.mbt", cfg, d2)
  assert_true(d2.length() == 0, "R8 while followed by newline block inside try allows body break")
  assert_true(str_has(out2, "break"), "R8 while body break preserved")

  // 3. `match H::{ cb: n => { n + 1 } } { _ => { if stop { return 42 } } }` inside `try` lowers via MbtTryOutcome
  let d3 : Array[Diag] = []
  let out3 = lower_checked_errors_single("priv suberror E String\nstruct H { cb : (Int) -> Int }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Int raise E {\n  let v = try { match H::{ cb: n => { n + 1 } } { _ => { if stop { return 42 } } }; good(false) } catch { _ => 7 }\n  v + 1\n}\n", "r8_3.mbt", cfg, d3)
  assert_true(d3.length() == 0 && str_has(out3, "return MbtTryRet(42)"), "R8 match struct literal with arrow field scrutinee lowered via MbtTryOutcome")
}

test "F6-1: R9 regressions (match/loop value expressions followed by binary op)" {
  let cfg = default_error_lower_config()

  // 1. `(match x { _ => { if stop { return 42 }; 0 } }) + good(false)` inside `try` lowers via MbtTryOutcome
  let d1 : Array[Diag] = []
  let out1 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(x : Int, stop : Bool) -> Int raise E {\n  try { (match x { _ => { if stop { return 42 }; 0 } }) + good(false) } catch { _ => 7 }\n}\n", "r9_1.mbt", cfg, d1)
  assert_true(d1.length() == 0 && str_has(out1, "return MbtTryRet(42)"), "R9 match value expr followed by + lowered via MbtTryOutcome")

  // 2. `fn f(x : Int) -> Int raise E { (match x { _ => { return 42 } }) + 1 }` wraps `return Ok(42)`
  let d2 : Array[Diag] = []
  let out2 = lower_checked_errors_single("suberror E { E(String) }\nfn f(x : Int) -> Int raise E {\n  (match x { _ => { return 42 } }) + 1\n}\n", "r9_2.mbt", cfg, d2)
  assert_true(d2.length() == 0, "R9 match value expr followed by + in raising fn lowers cleanly")
  assert_true(str_has(out2, "return Ok(42)"), "R9 match value expr arm return wrapped as Ok(42)")

  // 3. `(loop 0 { _ => { if stop { return 42 }; break 0 } }) + good(false)` inside `try` lowers via MbtTryOutcome
  let d3 : Array[Diag] = []
  let out3 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Int raise E {\n  try { (loop 0 { _ => { if stop { return 42 }; break 0 } }) + good(false) } catch { _ => 7 }\n}\n", "r9_3.mbt", cfg, d3)
  assert_true(d3.length() == 0 && str_has(out3, "return MbtTryRet(42)"), "R9 loop value expr followed by + lowered via MbtTryOutcome")

  // 4. `(loop 0 { 0 => break 1; n => continue n - 1 }) + good(false)` inside `try` passes cleanly (0 diag)
  let d4 : Array[Diag] = []
  let out4 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn f() -> Int {\n  try { (loop 0 { 0 => break 1; n => continue n - 1 }) + good(false) } catch { _ => 7 }\n}\n", "r9_4.mbt", cfg, d4)
  assert_true(d4.length() == 0, "R9 loop value expr followed by + allows local break/continue")
  assert_true(str_has(out4, "break 1") && str_has(out4, "continue n - 1"), "R9 loop break/continue preserved")
}

test "F6-1: R10 regressions (LL(1) header/body lbrace grammar across match/loop/while/for)" {
  let cfg = default_error_lower_config()

  // 1. `match 0 + ({} : Map[Int, Int])\n  .get(1).unwrap_or(3) { _ => { if stop { return 42 } } }` lowers via MbtTryOutcome
  let d1 : Array[Diag] = []
  let out1 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Int raise E {\n  let v = try {\n    match 0 + ({} : Map[Int, Int])\n      .get(1).unwrap_or(3) {\n      _ => { if stop { return 42 } }\n    }\n    good(false)\n  } catch { _ => 7 }\n  v + 1\n}\n", "r10_1.mbt", cfg, d1)
  assert_true(d1.length() == 0 && str_has(out1, "return MbtTryRet(42)"), "R10 match with multiline method chain after brace scrutinee lowered via MbtTryOutcome")

  // 1b. Same with bare empty `{}` (`match 0 + {}\n  .get(1).unwrap_or(3)`)
  let d1b : Array[Diag] = []
  let out1b = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Int raise E {\n  let v = try {\n    match 0 + {}\n      .get(1).unwrap_or(3) {\n      _ => { if stop { return 42 } }\n    }\n    good(false)\n  } catch { _ => 7 }\n  v + 1\n}\n", "r10_1b.mbt", cfg, d1b)
  assert_true(d1b.length() == 0 && str_has(out1b, "return MbtTryRet(42)"), "R10 match with bare {} + multiline .get() scrutinee lowered via MbtTryOutcome")

  // 2. `match 0 + { let g : (Int)->Int = n => { n + 1 }; [g(0)] }[0] { _ => { if stop { return 42 } } }` lowers via MbtTryOutcome
  let d2 : Array[Diag] = []
  let out2 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Int raise E {\n  let v = try {\n    match 0 + { let g : (Int) -> Int = n => { n + 1 }; [g(0)] }[0] {\n      _ => { if stop { return 42 } }\n    }\n    good(false)\n  } catch { _ => 7 }\n  v + 1\n}\n", "r10_2.mbt", cfg, d2)
  assert_true(d2.length() == 0 && str_has(out2, "return MbtTryRet(42)"), "R10 match with block+arrow+index scrutinee lowered via MbtTryOutcome")

  // 3. `choose(loop 0 { _ => { if stop { return 42 }; break 1 } }, good(false))` lowers via MbtTryOutcome
  let d3 : Array[Diag] = []
  let out3 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn choose(a : Int, b : Int) -> Int { a + b }\nfn outer(stop : Bool) -> Int raise E {\n  let v = try { choose(loop 0 { _ => { if stop { return 42 }; break 1 } }, good(false)) } catch { _ => 7 }\n  v + 1\n}\n", "r10_3.mbt", cfg, d3)
  assert_true(d3.length() == 0 && str_has(out3, "return MbtTryRet(42)"), "R10 loop inside call arg before comma lowered via MbtTryOutcome")

  // 4. `while i < { [2] }[0] { i = i + 1; break }` inside `try` passes cleanly (0 diag)
  let d4 : Array[Diag] = []
  let out4 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f() -> Int {\n  try {\n    let mut i = 0\n    while i < { [2] }[0] { i = i + 1; break }\n    i + good(false)\n  } catch { _ => 7 }\n}\n", "r10_4.mbt", cfg, d4)
  assert_true(d4.length() == 0, "R10 while with indexed block condition inside try allows body break")
  assert_true(str_has(out4, "break"), "R10 while indexed block body break preserved")

  // 5. `for x = 0; x < 2 { i = i + x + 1; break }; good(false) + i` inside `try` passes cleanly (0 diag)
  let d5 : Array[Diag] = []
  let out5 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f() -> Int {\n  try {\n    let mut i = 0\n    for x = 0; x < 2 { i = i + x + 1; break }; good(false) + i\n  } catch { _ => 7 }\n}\n", "r10_5.mbt", cfg, d5)
  assert_true(d5.length() == 0, "R10 2-clause C-style for followed by semicolon inside try allows body break")
  assert_true(str_has(out5, "break"), "R10 2-clause C-style for body break preserved")
}

test "F6-1: R11 regressions (prefix bang before block and ident-lexed noraise in header/try scan)" {
  let cfg = default_error_lower_config()

  // 1. `match !{false} { _ => { if stop { return Ok(42) } } }` inside `try` lowers via MbtTryOutcome
  let d1 : Array[Diag] = []
  let out1 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Result[Int, E] {\n  let v = try {\n    match !{false} {\n      _ => { if stop { return Ok(42) } }\n    }\n    good(false)\n  } catch { _ => 7 }\n  Ok(v + 1)\n}\n", "r11_1.mbt", cfg, d1)
  assert_true(d1.length() == 0 && str_has(out1, "return MbtTryRet(Ok(42))"), "R11 match with prefix !{false} scrutinee lowered via MbtTryOutcome")

  // 2. `while !{i >= 2} { i = i + 1; break }` inside `try` passes cleanly (0 diag)
  let d2 : Array[Diag] = []
  let out2 = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 3 }\nfn f() -> Int {\n  try {\n    let mut i = 0\n    while !{i >= 2} { i = i + 1; break }\n    i + good(false)\n  } catch { _ => 7 }\n}\n", "r11_2.mbt", cfg, d2)
  assert_true(d2.length() == 0, "R11 while with prefix !{i >= 2} condition inside try allows body break")
  assert_true(str_has(out2, "break"), "R11 while !{...} body break preserved")

  // 3a. `noraise { _ => { if stop { return Ok(42) }; 0 } }` inside `try` lowers via MbtTryOutcome
  let d3a : Array[Diag] = []
  let out3a = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Result[Int, E] {\n  let v = try {\n    let _ = try { good(false) } catch { _ => 0 } noraise { _ => { if stop { return Ok(42) }; 0 } }\n    good(false)\n  } catch { _ => 7 }\n  Ok(v + 1)\n}\n", "r11_3a.mbt", cfg, d3a)
  assert_true(d3a.length() == 0 && str_has(out3a, "return MbtTryRet(Ok(42))"), "R11 noraise arm return inside outer try lowered via MbtTryOutcome")

  // 3b. `match (try { good(false) } catch { _ => 0 } noraise { v => v }) { _ => { if stop { return Ok(42) } } }` lowers via MbtTryOutcome
  let d3b : Array[Diag] = []
  let out3b = lower_checked_errors_single("suberror E { E(String) }\nfn good(b : Bool) -> Int raise E { if b { raise E(\"b\") }; 1 }\nfn outer(stop : Bool) -> Result[Int, E] {\n  let v = try {\n    match (try { good(false) } catch { _ => 0 } noraise { v => v }) {\n      _ => { if stop { return Ok(42) } }\n    }\n    good(false)\n  } catch { _ => 7 }\n  Ok(v + 1)\n}\n", "r11_3b.mbt", cfg, d3b)
  assert_true(d3b.length() == 0 && str_has(out3b, "return MbtTryRet(Ok(42))"), "R11 match with parenthesized try-catch-noraise scrutinee lowered via MbtTryOutcome")
}

test "F6-2a: ABI raising_fns roundtrip, canonical package identity & explicit rethrow / catch!" {
  // 1. ABI v2 raising_fns serialization, empty omission, and tamper rejection
  let rf_abi = PackageAbi::{
    package_name: "up",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [AbiRaisingFn::{ name: "parse_code", err_ty: "up::ApiErr" }],
    ffi_shim_prefix: "",
    publishable: true,
  }
  let rf_sha = compute_abi_payload_sha256(rf_abi)
  let rf_pion = "// abi-sha256: " + rf_sha + "\npub fn parse_code(s : String) -> Result[Int, ApiErr] { Ok(1) }\n"
  let rf_json = render_abi_json(rf_abi, [("lib.pion", rf_pion)])
  assert_true(str_has(rf_json, "\"raising_fns\""), "non-empty raising_fns serialized in ABI v2")
  let d_ok : Array[Diag] = []
  match verify_and_parse_dep_abi("up", "/tmp/up", [("lib.pion", rf_pion)], Some(rf_json), d_ok) {
    Some(p) => assert_true(p.raising_fns.length() == 1 && p.raising_fns[0].name == "parse_code" && p.raising_fns[0].err_ty == "up::ApiErr", "raising_fns roundtrips cleanly")
    None => assert_true(false, "valid raising_fns ABI must verify")
  }
  let d_bad : Array[Diag] = []
  match verify_and_parse_dep_abi("up", "/tmp/up", [("lib.pion", rf_pion)], Some(str_replace_all(rf_json, "\"up::ApiErr\"", "\"up::Other\"")), d_bad) {
    Some(_) => assert_true(false, "tampered raising_fns must fail")
    None => assert_true(d_bad.length() > 0 && d_bad[0].code == "MBT2PION_DEP_ABI_ERROR", "tampered raising_fns rejected")
  }

  // 2. Canonical package identity: custom dep aliased `@json` is NOT rewritten to `mbt_compat::mbt_json_parse`,
  //    while standard `moonbitlang/core/json` imported as `@j` IS lowered to `mbt_compat::mbt_json_parse`!
  let st = empty_symbol_table()
  parse_moon_pkg_imports("import { \"demo/custom_json\" @json, \"moonbitlang/core/json\" @j }\n", st.moon_import_paths)
  let custom_abi = empty_package_abi("custom_json")
  let env = build_external_error_env(st, [("json", custom_abi)], Map())
  let d_alias : Array[Diag] = []
  let src_alias = "pub fn f(s : String) -> Int {\n  let a = @json.parse(s)\n  let b = @j.parse(s) catch { _ => return a }\n  let _ = b\n  a + 1\n}\n"
  let out_alias = lower_checked_errors_with_env([SourceFile::{ rel_path: "alias.mbt", content: src_alias, is_test: false }], default_error_lower_config(), env, d_alias)
  assert_true(d_alias.length() == 0, "canonical pkg identity lowers with 0 diags")
  assert_true(str_has(out_alias[0].content, "let a = @json.parse(s)"), "custom @json NOT mistaken for stdlib mbt_json_parse")
  assert_true(str_has(out_alias[0].content, "mbt_compat::mbt_json_parse(s)"), "renamed stdlib @j lowered to mbt_compat::mbt_json_parse")

  // 3. Explicit rethrow (`e => raise e`) and `catch!` inside matching raising boundary & outer try
  let d_rt : Array[Diag] = []
  let src_rt = "suberror E { A; B(Int) }\nfn boom(x : Int) -> Int raise E { if x == 0 { raise A }; raise B(x) }\nfn outer_rethrow(x : Int) -> Int raise E {\n  boom(x) catch { A => 1; e => raise e }\n}\nfn outer_catch_bang(x : Int) -> Int raise E {\n  boom(x) catch! { A => 1 }\n}\nfn nested_try(x : Int) -> Int {\n  try {\n    try { boom(x) } catch { A => 1; e => raise e }\n  } catch { A => 10; B(n) => n * 2 }\n}\n"
  let out_rt = lower_checked_errors_single(src_rt, "rethrow.mbt", default_error_lower_config(), d_rt)
  assert_true(d_rt.length() == 0, "explicit rethrow, catch!, and nested try rethrow lower cleanly")
  assert_true(str_has(out_rt, "return Err(e)") && str_has(out_rt, "return Err(__mbt_rethrow_"), "rethrow emits enclosing Err return")
}

test "F6-2a R2: Category A soundness, load-order invariance, opaque catch, unannotated closure & struct is-pat" {
  // 1. P0-1: Category A rejects `fail(...)`, external raising calls, raising methods, and postfix `catch` on helper
  let cat_a_bads : Array[(String, String)] = [
    ("cat_a_fail", "fn h() -> Int raise { fail(\"boom\") }\ntest { let _ = h() }\n"),
    ("cat_a_ext", "fn h(s : String) -> Int raise { let _ = @json.parse(s); 1 }\ntest { let _ = h(\"1\") }\n"),
    ("cat_a_postfix", "fn h(x : Int) -> Int raise { assert_eq(x, 1); x }\ntest { let _ = h(2) catch { _ => 0 } }\n"),
    ("cat_a_method", "struct T { x : Int }\nfn T::h(self : T) -> Unit raise { assert_eq(self.x, 1) }\ntest { T::{ x: 1 }.h() }\n"),
  ]
  for bc in cat_a_bads {
    let ds : Array[Diag] = []
    let _ = preprocess_controlled_errors([SourceFile::{ rel_path: bc.0 + "_test.mbt", content: bc.1, is_test: true }], ds)
    let mut hit = false
    for d in ds { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit = true } }
    assert_true(hit, "R2 P0-1 `" + bc.0 + "` MUST fail closed")
  }

  // 2. P0-2: Load-order invariance when two dep aliases share/collide on package_name
  let abi_one = PackageAbi::{ package_name: "one", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [], raising_fns: [AbiRaisingFn::{ name: "f", err_ty: "one::E1" }], ffi_shim_prefix: "", publishable: true }
  let abi_two = PackageAbi::{ package_name: "two", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [], raising_fns: [AbiRaisingFn::{ name: "f", err_ty: "two::E2" }], ffi_shim_prefix: "", publishable: true }
  let st_lo = empty_symbol_table()
  let env_ab = build_external_error_env(st_lo, [("one", abi_two), ("renamed", abi_one)], Map())
  let env_ba = build_external_error_env(st_lo, [("renamed", abi_one), ("one", abi_two)], Map())
  assert_true(
    le_resolve_external_call_raw(default_error_lower_config(), env_ab, "one", "f") == Some(("@one.f", "two::E2")) &&
    le_resolve_external_call_raw(default_error_lower_config(), env_ba, "one", "f") == Some(("@one.f", "two::E2")),
    "R2 P0-2 alias lookup is 100% load-order invariant",
  )

  // 3. Opaque catch, local raising closure, public Failure/method, unannotated closure & postfix catch arg fail-closed cases
  let r2_bads : Array[(String, String)] = [
    ("paren_opaque_bind", "fn f(s : String) -> Int { @json.parse(s) catch { (e) => { let _ = e; 0 } } }\n"),
    ("or_opaque_bind", "fn f(s : String) -> Int { @json.parse(s) catch { _ | e => { let _ = e; 0 } } }\n"),
    ("ctor_stdlib_catch", "fn f(s : String) -> Int { @json.parse(s) catch { ParseError(_) => 1; _ => 2 } }\n"),
    ("mut_local_raise_closure", "suberror E { A }\nfn f() -> Int { let mut g = fn(x : Int) -> Int raise E { if x < 0 { raise A }; x }; try { g(1) } catch { A => 0 } }\n"),
    ("ann_local_raise_closure", "suberror E { A }\nfn f() -> Int { let g : (Int) -> Int raise E = fn(x : Int) -> Int raise E { if x < 0 { raise A }; x }; try { g(1) } catch { A => 0 } }\n"),
    ("pub_raise_failure", "pub fn f() -> Int raise Failure { fail(\"x\") }\n"),
    ("pub_raise_method", "pub suberror E { A }\npub struct S { x : Int }\npub fn S::boom(self : S) -> Int raise E { raise A }\n"),
    ("arrow_try_return", "suberror E { A }\nfn boom() -> Int raise E { raise A }\nfn f() -> Unit { let g = x => { try { if x > 0 { return 1 }; boom() } catch { A => 0 } }; let _ = g }\n"),
    ("unann_fn_try_return", "suberror E { A }\nfn boom() -> Int raise E { raise A }\nfn f() -> Unit { let g = fn(x : Int) { try { if x > 0 { return 1 }; boom() } catch { A => 0 } }; let _ = g }\n"),
    ("postfix_catch_arg_mixed", "suberror E1 { A1 }\nsuberror E2 { A2 }\nfn g1(x : Int) -> Int raise E1 { if x < 0 { raise A1 }; x }\nfn g2() -> Int raise E2 { raise A2 }\nfn f() -> Int { try { g1(g2()) catch { A1 => 1 } } catch { A1 => 2 } }\n"),
  ]
  for bc in r2_bads {
    let ds : Array[Diag] = []
    let _ = lower_checked_errors_single(bc.1, bc.0 + ".mbt", default_error_lower_config(), ds)
    let mut hit = false
    for d in ds { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit = true } }
    assert_true(hit, "R2 fail-closed case `" + bc.0 + "` MUST emit MBT2PION_UNSUPPORTED_SYNTAX")
  }

  // 4. Struct `is`-pattern: `if s is { field: f } { ... }` shadows `f` cleanly inside the `if` scope
  let d_is : Array[Diag] = []
  let src_is = "suberror E { A }\nstruct Box { field : Int }\nfn f() -> Int raise E { raise A }\nfn check_box(b : Box) -> Int {\n  let mut acc = 0\n  if b is { field: f } { acc = acc + f }\n  acc + (f() catch { A => 5 })\n}\n"
  let out_is = lower_checked_errors_single(src_is, "is_struct.mbt", default_error_lower_config(), d_is)
  assert_true(d_is.length() == 0 && str_has(out_is, "acc = acc + f"), "R2 struct is-pattern shadows f inside if without affecting outer f()")

  // 5. Known non-raising stdlib call inside try/catch (`@utf8.encode` nested inside `@utf8.decode`),
  //    while custom user dep aliased as `@utf8` is NOT misidentified as stdlib.
  let d_u8 : Array[Diag] = []
  let src_u8 = "pub fn f() -> String? {\n  let good_u : String? = Some(@utf8.decode(@utf8.encode(\"hi\"))) catch { _ => Option::None }\n  good_u\n}\n"
  let out_u8 = lower_checked_errors_single(src_u8, "utf8_nested.mbt", default_error_lower_config(), d_u8)
  assert_true(d_u8.length() == 0 && str_has(out_u8, "utf8_decode_strict"), "known non-raising @utf8.encode inside @utf8.decode catch lowers cleanly")
  let st_u8 = empty_symbol_table()
  st_u8.moon_import_paths["utf8"] = "myorg/custom_utf8"
  let env_custom_u8 = build_external_error_env(st_u8, [], Map())
  assert_true(!le_is_known_non_raising_stdlib(env_custom_u8, "utf8", "encode"), "custom dep aliased as @utf8 must NOT match stdlib allowlist")
  let st_core_u8 = empty_symbol_table()
  st_core_u8.moon_import_paths["u8"] = "moonbitlang/core/encoding/utf8"
  let env_core_u8 = build_external_error_env(st_core_u8, [], Map())
  assert_true(le_is_known_non_raising_stdlib(env_core_u8, "u8", "encode"), "canonical core encoding/utf8::encode matches stdlib allowlist")
  assert_true(!le_is_known_non_raising_stdlib(env_core_u8, "u8", "decode"), "raising core encoding/utf8::decode must NOT match non-raising allowlist")

  // 6. R4 P1-1: `is <pat>` scope isolation (no leak into outer block; scoped to `if`/`while` then & `&&` chain only)
  let d_is2 : Array[Diag] = []
  let src_is2 = "suberror E { Bad }\nfn g() -> Int raise E { raise Bad }\nfn good(b : Bool) -> Int raise E { if b { raise Bad }; 0 }\nfn t1() -> Int { try { let _ = Some(1) is Some(g); let _ = g(); good(false) + 42 } catch { _ => 7 } }\nfn t2() -> Int { let a = if Some(1) is Some(g) { g } else { g() catch { _ => 9 } }; let ok = Some(1) is Some(g) && g > 0; a + (if ok { g() catch { _ => 3 } } else { 0 }) }\n"
  let out_is2 = lower_checked_errors_single(src_is2, "is_scope_r4.mbt", default_error_lower_config(), d_is2)
  assert_true(d_is2.length() == 0 && str_has(out_is2, "match g()"), "R4 P1-1: `let _ = Some(1) is Some(g)` does NOT shadow outer raising `g()`")

  // 7. R4 P1-2: `mbt_compat` shadowing fails closed when emitting `mbt_abort`
  let d_sh : Array[Diag] = []
  let src_sh = "suberror E { A }\nfn g() -> Int raise E { raise A }\nfn f() -> Int { let mbt_compat = 1; let _ = mbt_compat; try! g() }\n"
  let _ = lower_checked_errors_single(src_sh, "mbt_compat_shadow.mbt", default_error_lower_config(), d_sh)
  assert_true(d_sh.length() > 0 && d_sh[0].code == "MBT2PION_UNSUPPORTED_SYNTAX", "R4 P1-2: shadowing mbt_compat fails closed on try!")

  // 8. R4 P1-3 & R5 P1-1: Swapped dep aliases (`a @b, b @a`) AND same-tail distinct paths (`left/cache @cache, right/cache @other`)
  let abi_a = PackageAbi::{ package_name: "a", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [], raising_fns: [], ffi_shim_prefix: "", publishable: true }
  let abi_b = PackageAbi::{ package_name: "b", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [], raising_fns: [AbiRaisingFn::{ name: "fetch", err_ty: "b::BErr" }], ffi_shim_prefix: "", publishable: true }
  let st_sw = empty_symbol_table()
  st_sw.moon_import_paths["b"] = "mod/a"
  st_sw.moon_import_paths["a"] = "mod/b"
  st_sw.dep_pkg_names["a"] = true
  st_sw.dep_pkg_names["b"] = true
  st_sw.dep_alias_names["a"] = true
  st_sw.dep_alias_names["b"] = true
  let env_sw1 = build_external_error_env(st_sw, [("a", abi_a), ("b", abi_b)], Map())
  let env_sw2 = build_external_error_env(st_sw, [("b", abi_b), ("a", abi_a)], Map())
  assert_true(
    le_resolve_external_call_raw(default_error_lower_config(), env_sw1, "b", "fetch") == None &&
    le_resolve_external_call_raw(default_error_lower_config(), env_sw2, "b", "fetch") == None &&
    le_resolve_external_call_raw(default_error_lower_config(), env_sw1, "a", "fetch") == Some(("@a.fetch", "b::BErr")) &&
    le_resolve_external_call_raw(default_error_lower_config(), env_sw2, "a", "fetch") == Some(("@a.fetch", "b::BErr")) &&
    resolve_pkg_ref_alias(st_sw, "b") == "a" &&
    resolve_pkg_ref_alias(st_sw, "a") == "b",
    "R4 P1-3: swapped aliases (a @b, b @a) resolve to exact target packages regardless of dep order",
  )
  let st_same_tail = empty_symbol_table()
  st_same_tail.moon_import_paths["cache"] = "mod/left/cache"
  st_same_tail.moon_import_paths["other"] = "mod/right/cache"
  st_same_tail.dep_pkg_names["cache"] = true
  st_same_tail.dep_pkg_names["other"] = true
  st_same_tail.dep_alias_names["cache"] = true
  st_same_tail.dep_alias_names["other"] = true
  assert_true(
    resolve_pkg_ref_alias(st_same_tail, "cache") == "cache" &&
    resolve_pkg_ref_alias(st_same_tail, "other") == "other",
    "R5 P1-1: distinct full paths sharing trailing segment keep their distinct --dep aliases",
  )

  // 9. R4 P2-4: `pub(all) suberror` preserves `pub(all)` visibility modifier
  let d_pa : Array[Diag] = []
  let out_pa = lower_checked_errors_single("pub(all) suberror E { Bad }\n", "pub_all_err.mbt", default_error_lower_config(), d_pa)
  assert_true(d_pa.length() == 0 && str_has(out_pa, "pub(all) enum E"), "R4 P2-4: pub(all) suberror lowers to pub(all) enum")

  // 10. R4/R5 P2-5: Bool (including trailing comma) & Pion-compat Unit constructor payload exhaustiveness
  let d_bool_ok : Array[Diag] = []
  let _ = lower_checked_errors_single(
    "suberror E { Flag(Bool) }\nfn g() -> Int raise E { raise Flag(false) }\nfn f() -> Int { g() catch { Flag(true,) => 1; Flag(false,) => 2 } }\n",
    "bool_ok.mbt",
    default_error_lower_config(),
    d_bool_ok,
  )
  assert_true(d_bool_ok.length() == 0, "R5 P2-5: Flag(true,) + Flag(false,) on Bool payload is exhaustive")
  // Pion-compat single Unit payload `U(())`
  let d_unit_ok : Array[Diag] = []
  let _ = lower_checked_errors_single(
    "suberror E { U(Unit) }\nfn g() -> Int raise E { raise U(()) }\nfn f() -> Int { g() catch { U(()) => 1 } }\n",
    "unit_ok.mbt",
    default_error_lower_config(),
    d_unit_ok,
  )
  assert_true(d_unit_ok.length() == 0, "Pion-compat U(()) on Unit payload is exhaustive")

  // 10b. R5 P1-2 (paren `if` + `guard ... is`), P1-3 (`is <pat> == expr`), P2-4 (top-level `let` local shadow)
  let d_r5_ok : Array[Diag] = []
  let src_r5_ok = "suberror E { Bad }\nfn g() -> Int raise E { raise Bad }\nfn yes(_x : Int) -> Bool { true }\nlet datum1 : Int = { let g = 41; g + 1 }\nlet datum2 : Int = match Some(41) { Some(g) => g + 1; None => 0 }\nfn test_paren_guard() -> Int {\n  let local_fn = fn() -> Int { 1 }\n  let a = if (Some(local_fn) is Some(g)) { g() } else { 0 }\n  guard Some(local_fn) is Some(g) else { return 0 }\n  a + g()\n}\nfn test_is_eq() -> Int {\n  try { let _ = Some(1) is Some(_) == yes(g()); 42 } catch { _ => 7 }\n}\n"
  let out_r5_ok = lower_checked_errors_single(src_r5_ok, "r5_ok.mbt", default_error_lower_config(), d_r5_ok)
  assert_true(d_r5_ok.length() == 0 && str_has(out_r5_ok, "yes((match g()"), "R5 P1-2/P1-3/P2-4: paren if, guard is, is == expr, and top-level let local shadow all lower cleanly")

  // 10c. R6 P1-1 (transitive dep alias), P1-2 (guard else scope isolation), P1-3 (paren `is` && chain), external first-class raising value
  let st_tr = empty_symbol_table()
  st_tr.moon_import_paths["y"] = "review/mod/x"
  st_tr.dep_pkg_names["x"] = true
  st_tr.dep_pkg_names["y"] = true
  st_tr.dep_alias_names["x"] = true
  st_tr.dep_alias_names["y"] = true
  st_tr.dep_alias_to_canon_pkg["x"] = "x"
  st_tr.dep_alias_to_canon_pkg["y"] = "y"
  assert_true(resolve_pkg_ref_alias(st_tr, "y") == "x", "R6 P1-1: transitive --dep y must NOT hijack direct import review/mod/x @y")

  let d_r6_ok : Array[Diag] = []
  let src_r6_ok = "suberror E { Bad }\nfn g() -> Int raise E { raise Bad }\nfn yes(_x : Int) -> Bool { true }\nfn yes_b(_b : Bool) -> Bool { true }\nfn t_guard_else() -> Int {\n  let loc = fn() -> Int { 1 }\n  try {\n    guard true else { let g = loc; let _ = g(); return 0 }\n    let _ = g()\n    42\n  } catch { _ => 7 }\n}\nfn t_paren_and() -> Int {\n  let loc = fn() -> Int { 1 }\n  let _ = (Some(loc) is Some(g)) && yes(g())\n  g() catch { _ => 7 }\n}\nfn t_call_and_neg_paren() -> Int {\n  try {\n    let _ = yes_b(Some(1) is Some(g)) && yes(g())\n    let _ = !(None is Some(g)) && yes(g())\n    let _ = false == (None is Some(g)) && yes(g())\n    let _ = true != (None is Some(g)) && yes(g())\n    42\n  } catch { _ => 7 }\n}\nfn t_newline_paren_and() -> Int {\n  let loc = fn() -> Int { 1 }\n  let keep = yes(1)\n  let _ = keep\n  let _ = (Some(loc) is Some(g)) && yes(g())\n  42\n}\nstruct R9S { v : Bool }\nfn both_fn(a : Bool, _b : Int) -> Bool { a }\nfn t_struct_field_paren_and() -> Int {\n  let loc = fn() -> Int { 1 }\n  let obj = R9S::{ v: (Some(loc) is Some(g)) && yes(g()) }\n  if obj.v { 42 } else { 0 }\n}\nfn t_pipe_stops_and_chain() -> Int {\n  let loc = fn() -> Int { 1 }\n  try {\n    let z1 = R9S::{ v: (Some(loc) is Some(g)) && yes(g()) |> both_fn(g()) }\n    let z2 = R9S::{ v: Some(loc) is Some(g) && yes(g()) |> both_fn(g()) }\n    let z3 = if (Some(loc) is Some(g)) && yes(g()) |> both_fn(g()) { 1 } else { 0 }\n    if z1.v && z2.v && z3 > 0 { 42 } else { 0 }\n  } catch { _ => 7 }\n}\nfn rb_fail() -> Bool raise E { raise Bad }\nfn ov_fail() -> Int? raise E { raise Bad }\nfn t_r11_cmp_and_expr_catch() -> Int {\n  let loc = fn() -> Int { 1 }\n  let _ = false == true is _\n  let _ = (Some(1) is Some(x)) && rb_fail() catch { _ => false }\n  let _ = Some(1) is Some(x) && rb_fail() catch { _ => false }\n  let _ = (ov_fail() is Some(x)) && rb_fail() catch { _ => false }\n  try {\n    let _ = false == true is _ && yes(g())\n    let _ = (Some(loc) is Some(g)) && rb_fail() catch { _ => { let _ = g(); false } }\n    let mut x = 3\n    x += g() catch { _ => 9 }\n    let _ = x\n    let _ = { let _ = g(); 42 } catch { _ => 4 }\n    if false == None is Some(g) { let _ = g(); 42 } else { 0 }\n  } catch { _ => 7 }\n}\n"
  let out_r6_ok = lower_checked_errors_single(src_r6_ok, "r6_ok.mbt", default_error_lower_config(), d_r6_ok)
  assert_true(
    d_r6_ok.length() == 0 && str_has(out_r6_ok, "false == (true is _)") && str_has(out_r6_ok, "x += match g()") && str_has(out_r6_ok, "yes(g())") && str_has(out_r6_ok, "both_fn((match g()") && str_has(out_r6_ok, "yes((match g()") && str_has(out_r6_ok, "match g()"),
    "R6-R12: compound assign catch, bare block catch, comparison-RHS is in cond, and expr-level catch all lower cleanly",
  )
  // R12 pure no-error-keyword file: top-level let, default param, and string interpolation `false == true is _`
  let d_pure : Array[Diag] = []
  let src_pure = "let flag : Bool = false == true is _\nfn val1(x? : Bool = false == true is _) -> Bool { x }\nfn interp_len() -> Int { \"\\{false == true is _}\".length() }\n"
  let out_pure = lower_checked_errors_single(src_pure, "pure_is.mbt", default_error_lower_config(), d_pure)
  assert_true(
    d_pure.length() == 0 && str_has(out_pure, "let flag : Bool = false == (true is _)") &&
    str_has(out_pure, "x? : Bool = false == (true is _)") &&
    str_has(out_pure, "\"\\{false == (true is _)}\""),
    "R12: pure no-error-keyword file parenthesizes comparison-RHS `is` in top-level let, default param, and string interpolation",
  )

  // R13: default param lexical scope (prior params shadow package raising fns) + raising fn default param inherits RaisingFn frame
  let d_r13 : Array[Diag] = []
  let src_r13 = "suberror E { Bad }\nfn g() -> Int raise E { raise Bad }\nfn calm() -> Int raise E { 1 }\nfn yes_res(_r : Result[Int, E]) -> Bool { true }\nfn yes_i(_x : Int) -> Bool { true }\nfn pick_shadow_res(g : () -> Result[Int, E], x? : Bool = yes_res(g()) && yes_i(calm()) catch { _ => false }) -> Bool { x }\nfn pick_shadow_int(g : () -> Int, x? : Int = g()) -> Int { x }\nfn pick_raise_def(x? : Int = g()) -> Int raise E { x }\nfn pick_raise_chain(a : Int, x? : Int = a + 1, y? : Int = x + g()) -> Int raise E { y }\n"
  let out_r13 = lower_checked_errors_single(src_r13, "r13_def.mbt", default_error_lower_config(), d_r13)
  assert_true(
    d_r13.length() == 0 &&
    str_has(out_r13, "yes_res(g())") &&
    str_has(out_r13, "x? : Int = g()") &&
    str_has(out_r13, "x? : Int = g()?") &&
    str_has(out_r13, "y? : Int = x + g()?"),
    "R13: default params see prior params in lexical scope and raising fns inherit RaisingFn frame",
  )

  // R14: Stage A default param deferred positional binding, prior keyword param rename, and labeled/self-shadow fail-closed
  let r14_opts = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "r14",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let r14_pos_src = SourceFile::{
    rel_path: "r14_pos.mbt",
    content: "pub(all) suberror E { Bad }\nfn g() -> Int raise E { raise Bad }\nfn val() -> Int raise E { raise Bad }\npub fn pick_later_shadow(x? : Int = g(), g : () -> Result[Int, E]) -> Int raise E { let _ = g; x }\npub fn pick_kw_rename(val : () -> Int, val_ : () -> Int, x? : Int = val()) -> Int { let _ = val_; x }\npub fn pick_kw_later(x? : Int = val(), val : () -> Int, val_ : () -> Int) -> Int raise E { let _ = val; let _ = val_; x }\n",
    is_test: false,
  }
  let r14_pos_res = transpile_package([r14_pos_src], empty_api_map(), default_recipes(), [], [], r14_opts, [], false, noop_check)
  let r14_code = if r14_pos_res.files.length() > 0 { r14_pos_res.files[0].content } else { "" }
  assert_true(
    r14_pos_res.blockers == 0 &&
    str_has(r14_code, "__mbt_parg_1_g") &&
    str_has(r14_code, "let g = __mbt_parg_1_g") &&
    str_has(r14_code, "None => val_1()") &&
    str_has(r14_code, "__mbt_parg_2_val_") &&
    str_has(r14_code, "let val_ = __mbt_parg_2_val_"),
    "R14: Stage A defers shadowed positional params and applies prior keyword param renames in defaults",
  )
  let r14_neg_cases : Array[(String, String)] = [
    ("labeled_shadow", "suberror E { Bad }\nfn g() -> Int raise E { raise Bad }\npub fn p(x? : Int = g(), g~ : () -> Result[Int, E]) -> Int raise E { let _ = g; x }\n"),
    ("self_shadow", "suberror E { Bad }\nfn g() -> Int raise E { raise Bad }\npub fn p(g? : Int = g()) -> Int raise E { g }\n"),
    ("autofill_loc_shadow", "let loc : String = \"seed\"\n#callsite(autofill(loc))\npub fn p(x? : String = loc, loc~ : SourceLoc) -> Int { let _ = loc; if x == \"seed\" { 42 } else { 9 } }\n"),
    ("r16_labeled_cmp_is", "fn g() -> Int { 2 }\nfn none_i() -> Int? { None }\npub fn p(x? : Int = if false == (none_i() is Some(g)) { g() } else { 0 }, g~ : () -> Int) -> Int { let _ = g; x }\n"),
    ("r16_labeled_or_is", "fn g() -> Int { 2 }\nfn none_i() -> Int? { None }\npub fn p(x? : Int = if (none_i() is Some(g)) || true { g() } else { 0 }, g~ : () -> Int) -> Int { let _ = g; x }\n"),
    ("r16_labeled_match_struct", "struct R16V { a : Int }\nfn g() -> Int { 2 }\npub fn p(x? : Int = match R16V::{ a: g() } { { a } => a }, g~ : () -> Int) -> Int { let _ = g; x }\n"),
    ("r17_bare_is_cmp", "fn g() -> Bool { true }\npub fn p(x? : Bool = true is _ == g(), g~ : () -> Bool) -> Int { let _ = g; if x { 1 } else { 0 } }\n"),
    ("r17_newline_after_cmp", "fn g() -> Bool { true }\nfn none_i() -> Int? { None }\npub fn p(x? : Bool = false ==\n(none_i() is Some(g)) && g(), g~ : () -> Bool) -> Int { let _ = g; if x { 1 } else { 0 } }\n"),
    ("r18_kw_not_labeled", "fn not() -> Bool { true }\npub fn p(x? : Bool = not(), not~ : () -> Bool) -> Int { let _ = not; if x { 1 } else { 0 } }\n"),
    ("r18_kw_or_labeled", "fn or() -> Bool { true }\npub fn p(x? : Bool = or(), or~ : () -> Bool) -> Int { let _ = or; if x { 1 } else { 0 } }\n"),
    ("r18_nested_interp_labeled", "fn g() -> Bool { true }\nfn choose(_s : String, b : Bool) -> Bool { b }\npub fn p(x? : String = \"\\{choose(\"\\{\"}\"}\", g())}\", g~ : () -> Bool) -> Int { let _ = g; x.length() }\n"),
    ("r18_match_block_scrut_labeled", "fn g() -> Bool { true }\npub fn p(x? : Bool = match { let t = g(); t } { true => true; false => false }, g~ : () -> Bool) -> Int { let _ = g; if x { 1 } else { 0 } }\n"),
  ]
  for nc in r14_neg_cases {
    let ns = SourceFile::{ rel_path: nc.0 + ".mbt", content: nc.1, is_test: false }
    let nr = transpile_package([ns], empty_api_map(), default_recipes(), [], [], r14_opts, [], false, noop_check)
    let mut hit = false
    for d in nr.diagnostics { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit = true } }
    assert_true(hit, "R14-R18 fail-closed `" + nc.0 + "` MUST emit MBT2PION_UNSUPPORTED_SYNTAX")
  }
  // R15/R16/R17/R18: __mbt_parg collision avoidance, keyword-ident defer, match-block scrut, non-self-rec interp
  let r15_pos_src = SourceFile::{
    rel_path: "r15_pos.mbt",
    content: "let tag : String = \"seed\"\nlet r17_g : Bool = false\nstruct R16V { a : Int }\npub(all) struct R19S { a : Int; g : Int }\npub(all) enum R19Dir { Left; Right }\nfn none_i() -> Int? { None }\nfn g() -> Int { 1 }\nfn g_true() -> Bool { true }\nfn not(g~ : Bool = true) -> Bool { g }\nfn or() -> Bool { true }\nfn val_(_n : Int) -> Int { 99 }\nfn walk(_n : Int) -> Int { 99 }\nfn __mbt_parg_1_g() -> Int { 2 }\nfn value_g(g~ : Int) -> Int { g }\nfn r21_val_not(not~ : Int) -> Int { not }\npub fn pick_clash(x? : Int = g(), g : () -> Int) -> Int { let _ = g; x * 10 + __mbt_parg_1_g() }\n#callsite(autofill(loc))\npub fn pick_tag_loc(x? : String = tag, loc~ : SourceLoc) -> Int { let _ = loc; if x == \"seed\" { 42 } else { 9 } }\npub fn pick_let_g(x? : Int = { let g = 1; g }, g~ : Int) -> Int { x + g }\npub fn pick_pat_g(x? : Int = match Some(1) { Some(g) => g; None => 0 }, g~ : Int) -> Int { x + g }\npub fn pick_named_g(x? : Int = value_g(g=1), g~ : Int) -> Int { x + g }\npub fn pick_pos_cmp_is(x? : Int = if false == (none_i() is Some(g)) { g() } else { 0 }, g : () -> Int) -> Int { let _ = g; x }\npub fn pick_pos_or_is(x? : Int = if (none_i() is Some(g)) || true { g() } else { 0 }, g : () -> Int) -> Int { let _ = g; x }\npub fn pick_pos_match_s(x? : Int = match R16V::{ a: g() } { { a } => a }, g : () -> Int) -> Int { let _ = g; x }\npub fn pick_lbl_paren_and(x? : Bool = (Some(1) is Some(g)) && g == 1, g~ : Int) -> Int { if x { g } else { 0 } }\npub fn pick_lbl_bare_and(x? : Bool = Some(1) is Some(g) && g == 1, g~ : Int) -> Int { if x { g } else { 0 } }\npub fn pick_r17_interp(x? : String = \"\\{true is _ == g_true()}\", g_true : () -> Bool) -> Int { let _ = g_true; x.length() }\npub fn pick_r17_ml_and(x? : Bool = (Some(true) is Some(g)) && true &&\ng, g~ : Bool) -> Int { if x && !g { 1 } else { 0 } }\npub fn pick_r17_rec() -> Int { let r17_g = true; fn rec(n : Int) -> Bool { if n == 0 { true is _ == r17_g } else { rec(n - 1) } }; if rec(2) { 1 } else { 0 } }\npub fn pick_r18_not(x? : Bool = not(), not : () -> Bool) -> Int { let _ = not; if x { 1 } else { 0 } }\npub fn pick_r18_or(x? : Bool = or(), or : () -> Bool) -> Int { let _ = or; if x { 1 } else { 0 } }\npub fn pick_r18_rec_block() -> Int { let r17_g = true; fn rec(n : Int) -> Bool { if n == 0 { match { let t = r17_g; t } { true => true; false => false } } else { rec(n - 1) } }; if rec(2) { 1 } else { 0 } }\npub fn pick_r18_nonrec_wrap() -> Int { fn wrap(x : Int) -> Int { \"\\{match Some(x) { Some(wrap) => wrap; None => 0 }}\".length() }; wrap(7) }\npub fn pick_r19_val_selfrec() -> Int { fn val_(val : Int) -> Int { if val == 0 { 1 } else { val_(val - 1) } }; val_(1) }\npub fn pick_r19_val_cap() -> Int { let val_ : Int = 7; fn go(val : Int) -> Int { if val == 0 { val_ } else { go(val - 1) } }; go(1) }\npub fn pick_r19_let_not(x? : Bool = { let not = true; not }, not~ : () -> Bool) -> Int { let _ = not; if x { 1 } else { 0 } }\npub fn pick_r19_pat_not(x? : Bool = match Some(true) { Some(not) => not; None => false }, not~ : () -> Bool) -> Int { let _ = not; if x { 1 } else { 0 } }\npub fn pick_r19_arm_blk(d : R19Dir) -> Int { fn walk(n : Int) -> Int { match n > 0 { true => { let a = 1; a } + walk(n - 1)\n false => 0 } }; let dv = match d { .Left => { let a = 1; a }\n .Right => 2 }; walk(2) + dv }\npub fn pick_r19_ascribe_rec() -> Int { let r17_g = true; fn walk(n : Int) -> Int { if n == 0 { if (r17_g : Bool) { 1 } else { 0 } } else { (walk : (Int) -> Int)(n - 1) } }; walk(2) }\npub fn pick_r19_not_named(x? : Bool = not(g=true), g~ : Bool) -> Int { if x && !g { 1 } else { 0 } }\npub fn pick_r19_struct_f1(x? : R19S = R19S::{ g: 2, a: 1 }, g~ : Int) -> Int { x.a + x.g + g }\npub fn pick_r19_struct_f2(x? : R19S = R19S::{ a: 1, g: 2 }, g~ : Int) -> Int { x.a + x.g + g }\npub fn pick_r20_rec_not() -> Int { fn not(n : Int) -> Int { if n == 0 { 1 } else { not(n - 1) } }; not(1) }\npub fn pick_r20_rec_or() -> Int { fn or(n : Int) -> Int { if n == 0 { 1 } else { or(n - 1) } }; or(1) }\npub fn pick_r20_val_cap_val_(val : (Int) -> Int) -> Int { fn val_(n : Int) -> Int { if n == 0 { 5 } else if n == 1 { val(0) } else { val_(n - 1) } }; val_(2) }\npub fn pick_r20_val__cap_val(val_ : (Int) -> Int) -> Int { fn val(n : Int) -> Int { if n == 0 { 5 } else if n == 1 { val_(0) } else { val(n - 1) } }; val(2) }\npub fn pick_r20_self_tramp_clash() -> Int { fn val(val_ : Int) -> Int { if val_ == 0 { 1 } else { (val : (Int) -> Int)(val_ - 1) } }; val(2) }\npub fn pick_r20_arm_eq_nl() -> Int { fn walk(n : Int) -> Int { match n > 0 { true => if { 1 } ==\n walk(n - 1) { 1 } else { 0 }\n false => 1 } }; walk(2) }\npub fn pick_r20_same_line_semi() -> Int { let mut x = 0; fn walk(n : Int) -> Int { if n == 0 { 1 } else { walk(n - 1) } }; x = walk(1); x }\npub fn pick_r20_shadow_lifted() -> Int { fn walk(n : Int) -> Int { if n == 0 { 1 } else { let inner = { let walk = fn(_x : Int) { 9 }; walk(0) }; inner + walk(n - 1) } }; let a = walk(1); let b = { let walk = fn(_x : Int) { 20 }; walk(0) }; a + b + walk(0) }\npub fn pick_r21_shadow_cap(x : Int) -> Int { fn rec(n : Int) -> Int { if n == 0 { x } else if n == 1 { let x = 9; x } else { rec(n - 1) } }; fn rec2(n : Int) -> Int { if n == 0 { x } else if n == 1 { (fn(x : Int) { x })(9) } else { rec2(n - 1) } }; rec(2) + rec2(2) }\npub fn pick_r21_esc_val_(val : (Int) -> Int) -> Int { fn val_(n : Int) -> Int { if n == 0 { 1 } else { val_(n - 1) } }; let cb = val_; val(0) * 10 + cb(1) }\npub fn pick_r21_esc_val(val_ : (Int) -> Int) -> Int { fn val(n : Int) -> Int { if n == 0 { 1 } else { val(n - 1) } }; let cb = val; val_(0) * 10 + cb(1) }\npub fn pick_r21_is_and(cb : (Int) -> Int) -> Int { fn walk(n : Int) -> Int { if n == 0 { 1 } else { walk(n - 1) } }; let b = (Some(cb) is Some(walk)) && walk(0) == 9; let mut opt : ((Int) -> Int)? = Some(cb); let mut acc = 0; while (opt is Some(walk)) && walk(0) == 9 { acc = acc + walk(0); opt = None }; if b { acc + walk(0) } else { 0 } }\npub fn pick_r21_named_not_cap() -> Int { let not : Int = 42; fn rec(n : Int) -> Int { if n == 0 { r21_val_not(not~) + r21_val_not(not=not) } else { rec(n - 1) } }; rec(1) }\n",
    is_test: false,
  }
  let r15_pos_res = transpile_package([r15_pos_src], empty_api_map(), default_recipes(), [], [], r14_opts, [], false, noop_check)
  let mut r15_code = ""
  for rf in r15_pos_res.files { r15_code = r15_code + rf.content }
  assert_true(
    r15_pos_res.blockers == 0 && str_has(r15_code, "__mbt_parg_1_g_") && str_has(r15_code, "let g = __mbt_parg_1_g_"),
    "R15: deferred param avoids __mbt_parg_1_g clash and free-ident check allows local/pattern/named-arg bindings",
  )

  // 10d. R9: PackageAbi canonical JSON field order (`values -> raising_fns -> ffi_shim_prefix -> publishable`) & abi_sha256 roundtrip
  let both_abi = PackageAbi::{
    package_name: "dual",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [AbiValueSchema::{ name: "k", ty: "Int" }],
    raising_fns: [AbiRaisingFn::{ name: "f", err_ty: "dual::E" }],
    ffi_shim_prefix: "dual_ffi_",
    publishable: true,
  }
  let both_sha = compute_abi_payload_sha256(both_abi)
  let both_files : Array[(String, String)] = [("dual.pion", "// abi-sha256: " + both_sha + "\npub fn f() -> Int { 1 }\n")]
  let both_json = render_abi_json(both_abi, both_files)
  let iv = both_json.index_of("\"values\"")
  let ir = both_json.index_of("\"raising_fns\"")
  let iffi = both_json.index_of("\"ffi_shim_prefix\"")
  let ipub = both_json.index_of("\"publishable\"")
  assert_true(iv > 0 && ir > iv && iffi > ir && ipub > iffi, "R9: canonical ABI JSON order is values -> raising_fns -> ffi_shim_prefix -> publishable")
  let d_both : Array[Diag] = []
  match verify_and_parse_dep_abi("dual", "/tmp/dual", both_files, Some(both_json), d_both) {
    Some(parsed_both) =>
    assert_true(
      d_both.length() == 0 && parsed_both.raising_fns.length() == 1 && parsed_both.ffi_shim_prefix == "dual_ffi_",
      "R9: PackageAbi with both raising_fns and ffi_shim_prefix roundtrips with valid abi_sha256",
    )
    None => assert_true(false, "R9: verify_and_parse_dep_abi must succeed for combined raising_fns + ffi_shim_prefix")
  }

  let abi_u_fc = PackageAbi::{
    package_name: "u",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [
      AbiRaisingFn::{ name: "f", err_ty: "u::UE" },
      AbiRaisingFn::{ name: "parse", err_ty: "u::UE" },
    ],
    ffi_shim_prefix: "",
    publishable: true,
  }
  let st_u_fc = empty_symbol_table()
  symtab_load_dep_abi(st_u_fc, "u", abi_u_fc)
  let env_u_fc = build_external_error_env(st_u_fc, [("u", abi_u_fc)], Map())
  let ext_fc_bads : Array[(String, String)] = [
    ("ext_fc_local", "fn h() -> Int { let g = @u.f; let _ = g; 0 }\n"),
    ("ext_fc_top", "let g = @u.f\n"),
    ("ext_fc_arg", "fn h(xs : Array[String]) -> Unit { let _ = xs.map(@u.parse) }\n"),
  ]
  for bc in ext_fc_bads {
    let ds : Array[Diag] = []
    let _ = lower_checked_errors_with_env([SourceFile::{ rel_path: bc.0 + ".mbt", content: bc.1, is_test: false }], default_error_lower_config(), env_u_fc, ds)
    let mut hit = false
    for d in ds { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit = true } }
    assert_true(hit, "R6 external first-class raising value `" + bc.0 + "` MUST emit MBT2PION_UNSUPPORTED_SYNTAX")
  }

  // 11. R4 P2-5 negatives, expression-body arrow closures, and top-level let raising fn
  let r4_bads : Array[(String, String)] = [
    ("bool_incomplete", "suberror E { Flag(Bool) }\nfn g() -> Int raise E { raise Flag(false) }\nfn f() -> Int { g() catch { Flag(true) => 1 } }\n"),
    ("int_lit_incomplete", "suberror E { Code(Int) }\nfn g() -> Int raise E { raise Code(1) }\nfn f() -> Int { g() catch { Code(1) => 1; Code(2) => 2 } }\n"),
    ("expr_arrow_uncaught", "suberror E { A }\nfn f(x : Int) -> Int raise E { if x < 0 { raise A }; x }\nfn g(xs : Array[Int]) -> Unit { xs.each(x => f(x) |> ignore) }\n"),
    ("expr_arrow_in_try", "suberror E { A }\nfn f(x : Int) -> Int raise E { if x < 0 { raise A }; x }\nfn g(xs : Array[Int]) -> Int { try { let _ = xs.map(x => f(x)); 1 } catch { A => -1 } }\n"),
    ("top_let_raising_fn", "suberror E { A }\nfn f() -> Int raise E { raise A }\nlet g = f\n"),
  ]
  for bc in r4_bads {
    let ds : Array[Diag] = []
    let _ = lower_checked_errors_single(bc.1, bc.0 + ".mbt", default_error_lower_config(), ds)
    let mut hit = false
    for d in ds { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit = true } }
    assert_true(hit, "R4 fail-closed case `" + bc.0 + "` MUST emit MBT2PION_UNSUPPORTED_SYNTAX")
  }
}
