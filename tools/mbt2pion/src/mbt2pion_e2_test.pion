///| Wave M2-E2 unit tests: ABI v2 `reexports` + `pub using` + controlled error lowering.

test "E2-1: ABI v2 reexports roundtrip, tamper rejection & v1/v2 backward compat" {
  let abi = PackageAbi::{ package_name: "mid", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [AbiReexport::{ name: "rect", kind: "value", target_pkg: "orig", target_name: "rect" }, AbiReexport::{ name: "Side", kind: "type", target_pkg: "orig", target_name: "Side" }], values: [], raising_fns: [], fn_mutation_summaries: [], ffi_shim_prefix: "", publishable: true, empty_target_pkg: false, empty_target: "" }
  let pion_txt = "// abi-sha256: " + compute_abi_payload_sha256(abi) + "\npub fn dummy() -> Int { 1 }\n"
  let raw_json = render_abi_json(abi, [("lib.pion", pion_txt)])
  assert_true(str_has(raw_json, "\"reexports\""), "rendered ABI v2 includes reexports")
  let d_ok : Array[Diag] = []
  match verify_and_parse_dep_abi("mid", "/tmp/mid", [("lib.pion", pion_txt)], Some(raw_json), d_ok) {
    Some(p) => assert_true(p.reexports.length() == 2 && p.reexports[0].name == "Side" && p.reexports[1].name == "rect", "sorted reexports parsed")
    None => assert_true(false, "valid reexports ABI should verify")
  }
  let d_bad : Array[Diag] = []
  match verify_and_parse_dep_abi("mid", "/tmp/mid", [("lib.pion", pion_txt)], Some(str_replace_all(raw_json, "\"orig\"", "\"evil\"")), d_bad) {
    Some(_) => assert_true(false, "tampered reexports must fail")
    None => assert_true(d_bad.length() > 0 && d_bad[0].code == "MBT2PION_DEP_ABI_ERROR", "tampered reexports rejected")
  }
  let old_abi = PackageAbi::{ package_name: "old", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: [], values: [], raising_fns: [], fn_mutation_summaries: [], ffi_shim_prefix: "", publishable: false, empty_target_pkg: false, empty_target: "" }
  let old_pion = "// abi-sha256: " + compute_abi_payload_sha256(old_abi) + "\npub fn x() -> Int { 0 }\n"
  let old_json = render_abi_json(old_abi, [("lib.pion", old_pion)])
  assert_true(!str_has(old_json, "\"reexports\""), "empty reexports omitted for v2 compat")
  let d_old : Array[Diag] = []
  match verify_and_parse_dep_abi("old", "/tmp/old", [("lib.pion", old_pion)], Some(old_json), d_old) {
    Some(p) => assert_true(!p.publishable && p.reexports.length() == 0, "publishable=false preserved")
    None => assert_true(false, "old v2 without reexports should parse")
  }
}

test "E2-1: preprocess_pub_using validation & consumer rewrite" {
  let doc_orig = "{\"packages\":[{\"name\":\"orig\",\"items\":[{\"kind\":\"enum\",\"name\":\"Side\",\"sig\":\"pub enum Side { Left; Right }\"},{\"kind\":\"fn\",\"name\":\"rect\",\"sig\":\"pub fn rect(x : Int) -> Int\"}]}]}"
  let d1 : Array[Diag] = []
  let (mid_out, mid_re) = preprocess_pub_using([SourceFile::{ rel_path: "mid.mbt", content: "pub using @orig { type Side, rect }\npub fn id(s : Side) -> Side { s }\n", is_test: false }], Map(), Map(), [doc_orig], [], d1)
  assert_true(d1.length() == 0 && mid_re.length() == 2 && !str_has(mid_out[0].content, "pub using"), "valid pub using lowered")
  let d2 : Array[Diag] = []
  let (_, _) = preprocess_pub_using([SourceFile::{ rel_path: "bad.mbt", content: "pub using @orig { type rect, nope }\n", is_test: false }], Map(), Map(), [doc_orig], [], d2)
  assert_true(d2.length() == 2 && d2[0].code == "MBT2PION_DEP_ABI_ERROR", "wrong kind + missing rejected")
  let mid_abi = PackageAbi::{ package_name: "mid", enums: [], struct_val_fields: [], structs: None, companion_files: [], op_impls: [], reexports: mid_re, values: [], raising_fns: [], fn_mutation_summaries: [], ffi_shim_prefix: "", publishable: true, empty_target_pkg: false, empty_target: "" }
  let d3 : Array[Diag] = []
  let leaf_out = rewrite_dep_reexports([SourceFile::{ rel_path: "leaf.mbt", content: "using @mid { type Side }\npub fn f(s : @mid.Side) -> String {\n  let rect = 99\n  let _ = @mid.Side::Left\n  \"\\{@mid.rect(rect)}\"\n}\n", is_test: false }], Map(), Map(), [doc_orig], [("mid", mid_abi)], d3)
  assert_true(d3.length() == 0 && str_has(leaf_out[0].content, "using @orig { type Side }") && str_has(leaf_out[0].content, "@orig.Side::Left") && str_has(leaf_out[0].content, "let rect = 99") && str_has(leaf_out[0].content, "@orig.rect(rect)"), "consumer rewrite preserves local shadow")
  let doc_anchor = "{\"packages\":[{\"name\":\"orig\",\"items\":[{\"kind\":\"enum\",\"name\":\"DrawCmd\",\"sig\":\"pub enum DrawCmd { Poly(Array[Int]) }\"},{\"kind\":\"struct\",\"name\":\"Box\",\"sig\":\"pub struct Box[T : Foo[Int], U] { x : T }\"}]}]}"
  let anc = render_reexport_verify_anchor([AbiReexport::{ name: "DrawCmd", kind: "type", target_pkg: "orig", target_name: "DrawCmd" }, AbiReexport::{ name: "Box", kind: "type", target_pkg: "orig", target_name: "Box" }], [doc_anchor])
  assert_true(str_has(anc, "Option[orig::DrawCmd]") && !str_has(anc, "orig::DrawCmd[Int]") && str_has(anc, "Option[orig::Box[Int, Int]]"), "anchor arity ignores enum body brackets and nested constraints")
}

test "E2-2: preprocess_controlled_errors active blockers & Category A/B lowering" {
  let bad_cases : Array[(String, String, Bool)] = [
    ("pub_raise", "pub fn f() -> Int raise { 1 }\n", false), ("cat_a_alias", "fn h(x : Int) -> Unit raise { assert_eq(x, 1) }\ntest { let f = h; f(1) }\n", true),
    ("cat_a_in_try", "fn h(x : Int) -> Int raise { assert_eq(x, 1); x }\ntest { let _ = try { h(2) } catch { _ => 0 } }\n", true),
    ("cat_a_braceless_try", "fn h(x : Int) -> Int raise { assert_eq(x, 1); x }\ntest { let _ = try h(2) catch { _ => 0 } }\n", true),
    ("fn_val_alias", "priv suberror Bad\nfn bad() -> Int raise Bad { raise Bad }\npub fn f() -> Int { let g = bad; let _ = g; 1 }\n", false),
    ("meth_val_alias", "priv suberror Bad\nstruct P { x : Int }\nfn P::bad(self : P) -> Int raise Bad { raise Bad }\npub fn f() -> Int { let g = P::bad; let _ = g; 1 }\n", false),
    ("failure_bind", "fn f() -> Int raise Failure { fail(\"x\") }\npub fn g() -> Int { try { f() } catch { Failure(m) => m.length() } }\n", false),
  ]
  for bc in bad_cases {
    let ds : Array[Diag] = []
    let _ = preprocess_controlled_errors([SourceFile::{ rel_path: bc.0 + ".mbt", content: bc.1, is_test: bc.2 }], ds)
    let mut hit = false
    for d in ds { if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { hit = true } }
    assert_true(hit, "case " + bc.0 + " MUST emit MBT2PION_UNSUPPORTED_SYNTAX")
  }
  let d_ok : Array[Diag] = []
  let out_ok = preprocess_controlled_errors([SourceFile::{ rel_path: "ok.mbt", content: "priv suberror Bad\nfn bad() -> Int raise Bad { raise Bad }\nfn f() -> Int raise Bad { let k = try { bad() } catch { Bad => 7 }; k + 1 }\n", is_test: false }], d_ok)
  assert_true(d_ok.length() == 0 && str_has(out_ok[0].content, "enum Bad { Bad }") && !str_has(out_ok[0].content, "Show") && str_has(out_ok[0].content, "Result[Int, Bad]"), "Cat-B lowered cleanly")
}
