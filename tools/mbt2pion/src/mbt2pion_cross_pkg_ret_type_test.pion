///| Cross-package return type inference, cross-package struct field inference,
///| tuple projection, `MbtJson` pure `==`, `opt_map` callback purity, and
///| narrowed `new_by` guard tests.

fn cprt_mk_dep_abi(
  pkg_name : String,
  structs : Option[Array[AbiStructSchema]],
  fms : Array[AbiFnMutationSummary],
) -> PackageAbi {
  PackageAbi::{
    package_name: pkg_name,
    enums: [],
    struct_val_fields: [],
    structs: structs,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: fms,
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
}

fn cprt_pure_fms(name : String) -> AbiFnMutationSummary {
  AbiFnMutationSummary::{
    name: name,
    mutates_any_array: false,
    reaches_shrink: false,
    unknown: false,
    mutated_elem_types: [],
  }
}

fn cprt_find_iter_dot(tokens : Array[Token]) -> Int {
  let mut i = 1
  while i + 2 < tokens.length() {
    if tokens[i].kind == TokenKind::Dot && tokens[i + 1].raw == "iter" && tokens[i + 2].kind == TokenKind::LParen {
      return i
    }
    i = i + 1
  }
  -1
}

fn cprt_find_search_by_cb(tokens : Array[Token]) -> (Int, Int, Int) {
  let mut i = 1
  while i + 2 < tokens.length() {
    if tokens[i].kind == TokenKind::Dot && tokens[i + 1].raw == "search_by" && tokens[i + 2].kind == TokenKind::LParen {
      let rp = find_matching_delim(tokens, i + 2)
      let bo = outermost_body_open(tokens, i)
      return (i + 3, rp, bo)
    }
    i = i + 1
  }
  (-1, -1, -1)
}

fn cprt_qt_json_for_file(rel_path : String, exprs_json : String) -> String {
  "{\"id\":1,\"ok\":true,\"diagnostics\":[],\"types\":[{\"file\":\"" + rel_path + "\",\"expr_tys\":[" + exprs_json + "],\"call_targets\":[]}]}"
}

fn cprt_qt_expr_entry(op_byte : Int, start_byte : Int, end_byte : Int, recv_ty : String) -> String {
  "{\"start_byte\":" + start_byte.to_string() +
  ",\"end_byte\":" + end_byte.to_string() +
  ",\"op_byte\":" + op_byte.to_string() +
  ",\"role\":\"method_call\",\"ty\":\"Option[Int]\",\"ty_canon\":\"Option[Int]\",\"receiver_ty\":\"" + recv_ty +
  "\",\"receiver_ty_canon\":\"" + recv_ty + "\",\"ambiguous\":false}"
}

test "cross_pkg_ret_type: dep::text, pkg_alias, using_values, dep methods pass pure == under custom_ops" {
  let dep_abi = cprt_mk_dep_abi(
    "jlib",
    None,
    [
      cprt_pure_fms("text"),
      cprt_pure_fms("Entry::label"),
    ],
  )
  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["jl"] = "jlib"
  let using_values : Map[String, String] = Map()
  using_values["text"] = "jlib::text"
  let ctx = CrossPkgMutationContext::{
    dep_abis: [("jlib", dep_abi)],
    using_values: using_values,
    using_types: Map(),
    pkg_aliases: pkg_aliases,
  }
  let dep_rets : Map[String, String] = Map()
  dep_rets["jlib::text"] = "String"
  dep_rets["jlib::Entry::label"] = "String"
  let dep_methods : Map[String, Bool] = Map()
  dep_methods["eq"] = true

  let src_direct = "pub fn f(rows : Array[mbt_compat::MbtJson], target : String) -> Option[mbt_compat::MbtJson] {\n" +
  "  rows.iter().find_first(fn(r) { jlib::text(Some(r), \"k\") == target })\n" +
  "}\n"
  let toks_direct = lex_moonbit(src_direct)
  let ms_direct = collect_pkg_mutation_summary_with_cross_pkg_and_rets(
    [toks_direct], ["a.pion"], [src_direct], empty_pkg_query_types(), dep_methods, Map(), ctx, dep_rets,
  )
  let dot_d = cprt_find_iter_dot(toks_direct)
  assert_true(dot_d > 0, "expected .iter() in src_direct")
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks_direct, dot_d, ms_direct, src_direct, None, "mbt_compat::MbtJson") != None,
    "jlib::text(Some(r), \"k\") == target must infer String and pass Gate C",
  )

  let src_alias = "pub fn f(rows : Array[mbt_compat::MbtJson], target : String) -> Option[mbt_compat::MbtJson] {\n" +
  "  rows.iter().find_first(fn(r) { jl::text(Some(r), \"k\") == target })\n" +
  "}\n"
  let toks_alias = lex_moonbit(src_alias)
  let ms_alias = collect_pkg_mutation_summary_with_cross_pkg_and_rets(
    [toks_alias], ["b.pion"], [src_alias], empty_pkg_query_types(), dep_methods, Map(), ctx, dep_rets,
  )
  let dot_a = cprt_find_iter_dot(toks_alias)
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks_alias, dot_a, ms_alias, src_alias, None, "mbt_compat::MbtJson") != None,
    "pkg alias jl::text(...) == target must infer String and pass Gate C",
  )

  let src_using = "pub fn f(rows : Array[mbt_compat::MbtJson], target : String) -> Option[mbt_compat::MbtJson] {\n" +
  "  rows.iter().find_first(fn(r) { text(Some(r), \"k\") == target })\n" +
  "}\n"
  let toks_using = lex_moonbit(src_using)
  let ms_using = collect_pkg_mutation_summary_with_cross_pkg_and_rets(
    [toks_using], ["c.pion"], [src_using], empty_pkg_query_types(), dep_methods, Map(), ctx, dep_rets,
  )
  let dot_u = cprt_find_iter_dot(toks_using)
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks_using, dot_u, ms_using, src_using, None, "mbt_compat::MbtJson") != None,
    "using_values bare text(...) == target must infer String and pass Gate C",
  )

  let src_meth = "pub fn f(rows : Array[jlib::Entry], target : String) -> Option[jlib::Entry] {\n" +
  "  rows.iter().find_first(fn(r) { r.label() == target })\n" +
  "}\n"
  let toks_meth = lex_moonbit(src_meth)
  let ms_meth = collect_pkg_mutation_summary_with_cross_pkg_and_rets(
    [toks_meth], ["d.pion"], [src_meth], empty_pkg_query_types(), dep_methods, Map(), ctx, dep_rets,
  )
  let dot_m = cprt_find_iter_dot(toks_meth)
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks_meth, dot_m, ms_meth, src_meth, None, "jlib::Entry") != None,
    "cross-pkg method r.label() == target must infer String and pass Gate C",
  )
}

test "cross_pkg_struct_fields_and_tuple_projection: search_by pure == under custom_ops" {
  let dep_structs = [
    AbiStructSchema::{
      pkg: "model",
      name: "Record",
      type_params: [],
      fields: [
        AbiStructField::{ src_name: "id", emit_name: "id", is_mut: false, visibility: "pub", ty: "String" },
      ],
      can_construct: true,
      can_update: true,
      complete: true,
    },
    AbiStructSchema::{
      pkg: "model",
      name: "State",
      type_params: [],
      fields: [
        AbiStructField::{ src_name: "current", emit_name: "current", is_mut: false, visibility: "pub", ty: "String" },
      ],
      can_construct: true,
      can_update: true,
      complete: true,
    },
    AbiStructSchema::{
      pkg: "model",
      name: "Boxed",
      type_params: ["T"],
      fields: [
        AbiStructField::{ src_name: "val", emit_name: "val", is_mut: false, visibility: "pub", ty: "T" },
      ],
      can_construct: true,
      can_update: true,
      complete: true,
    },
  ]
  let dep_abi = cprt_mk_dep_abi("model", Some(dep_structs), [])
  let ctx = CrossPkgMutationContext::{
    dep_abis: [("model", dep_abi)],
    using_values: Map(),
    using_types: Map(),
    pkg_aliases: Map(),
  }
  let dep_methods : Map[String, Bool] = Map()
  dep_methods["eq"] = true

  let src_field = "type LocalRec = model::Record\n" +
  "pub fn find_rec(recs : Array[LocalRec], st : model::State) -> Option[Int] {\n" +
  "  recs.search_by(fn(x) { x.id == st.current })\n" +
  "}\n"
  let toks_f = lex_moonbit(src_field)
  let ms_f = collect_pkg_mutation_summary_with_cross_pkg([toks_f], ["f.pion"], [src_field], empty_pkg_query_types(), dep_methods, Map(), ctx)
  let (sb_s, sb_e, sb_bo) = cprt_find_search_by_cb(toks_f)
  let sum_f = summarize_callback_arg(ms_f, toks_f, sb_s, sb_e, sb_bo, src_field, None, "LocalRec", Map())
  assert_true(!sum_f.unknown, "x.id == st.current across cross-pkg structs and local type alias must be pure")

  // Negative: generic dep struct field `val : T` must fail-closed.
  let src_gen = "pub fn find_box(xs : Array[model::Boxed[Int]], want : Int) -> Option[Int] {\n" +
  "  xs.search_by(fn(b) { b.val == want })\n" +
  "}\n"
  let toks_g = lex_moonbit(src_gen)
  let ms_g = collect_pkg_mutation_summary_with_cross_pkg([toks_g], ["g.pion"], [src_gen], empty_pkg_query_types(), dep_methods, Map(), ctx)
  let (gs, ge, gbo) = cprt_find_search_by_cb(toks_g)
  let sum_g = summarize_callback_arg(ms_g, toks_g, gs, ge, gbo, src_gen, None, "model::Boxed[Int]", Map())
  assert_true(sum_g.unknown, "generic dep struct field with formal T must fail-closed")

  // Tuple projection `h.0 == s` (both direct tuple and type alias to tuple).
  let src_tup = "type SpanPair = (Int, Int)\n" +
  "pub fn find_hit(hits : Array[SpanPair], s : Int) -> Option[Int] {\n" +
  "  hits.search_by(fn(h) { h.0 == s })\n" +
  "}\n"
  let toks_t = lex_moonbit(src_tup)
  let ms_t = collect_pkg_mutation_summary_with_cross_pkg([toks_t], ["t.pion"], [src_tup], empty_pkg_query_types(), dep_methods, Map(), ctx)
  let (ts, te, tbo) = cprt_find_search_by_cb(toks_t)
  let sum_t = summarize_callback_arg(ms_t, toks_t, ts, te, tbo, src_tup, None, "SpanPair", Map())
  assert_true(!sum_t.unknown, "tuple projection h.0 == s must infer Int and pass pure == check")
}

test "mbt_json_pure_eq_and_opt_map: MbtJson == and opt_map callback purity" {
  let dep_methods : Map[String, Bool] = Map()
  dep_methods["eq"] = true

  // Positive: `tags.iter().any(fn(t) { t == mbt_compat::MbtJson::string(want) })`
  let src_json = "pub fn has_tag(tags : Array[mbt_compat::MbtJson], want : String) -> Bool {\n" +
  "  tags.iter().any(fn(t) { t == mbt_compat::MbtJson::string(want) })\n" +
  "}\n"
  let toks_j = lex_moonbit(src_json)
  let ms_j = collect_pkg_mutation_summary([toks_j], ["j.pion"], [src_json], empty_pkg_query_types(), dep_methods, Map())
  let dot_j = cprt_find_iter_dot(toks_j)
  assert_true(dot_j > 0, "expected .iter() in src_json")
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks_j, dot_j, ms_j, src_json, None, "mbt_compat::MbtJson") != None,
    "MbtJson == mbt_compat::MbtJson::string(want) must pass Gate C",
  )

  // Negative: shadowed `mbt_compat` must fail-closed on `mbt_compat::MbtJson`.
  let src_shadow = "struct mbt_compat { v : Int }\n" +
  "pub fn has_tag(tags : Array[mbt_compat::MbtJson], want : String) -> Bool {\n" +
  "  tags.iter().any(fn(t) { t == mbt_compat::MbtJson::string(want) })\n" +
  "}\n"
  let toks_sh = lex_moonbit(src_shadow)
  let ms_sh = collect_pkg_mutation_summary([toks_sh], ["sh.pion"], [src_shadow], empty_pkg_query_types(), dep_methods, Map())
  let dot_sh = cprt_find_iter_dot(toks_sh)
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks_sh, dot_sh, ms_sh, src_shadow, None, "mbt_compat::MbtJson") == None,
    "shadowed mbt_compat must fail-closed for MbtJson ==",
  )

  // `mbt_compat::opt_map(opt, fn(x) { x == target })` extracts `T` from `Option[T]` and stays pure.
  let src_opt = "pub fn opt_eq(opt : Option[String], target : String) -> Option[Bool] {\n" +
  "  mbt_compat::opt_map(opt, fn(x) { x == target })\n" +
  "}\n" +
  "pub fn opt_mut(opt : Option[String], xs : Array[String]) -> Option[String] {\n" +
  "  mbt_compat::opt_map(opt, fn(x) { xs.push(x); x })\n" +
  "}\n"
  let toks_o = lex_moonbit(src_opt)
  let ms_o = collect_pkg_mutation_summary([toks_o], ["o.pion"], [src_opt], empty_pkg_query_types(), dep_methods, Map())
  match lookup_fn_mutation_summary(ms_o, "opt_eq") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "pure opt_map callback must be unknown=false")
    None => assert_true(false, "expected opt_eq summary")
  }
  match lookup_fn_mutation_summary(ms_o, "opt_mut") {
    Some(s) => assert_true(summary_may_mutate_array(s, "String"), "mutating opt_map callback must record Array[String] mutation")
    None => assert_true(false, "expected opt_mut summary")
  }
}

test "new_by_guard_narrowing: concrete struct/enum allowed; alias, unknown ext, OrderedMap fail-closed" {
  // Positive: local concrete `struct Cell` with `Cell::new_by` + concrete dep `dep::Record::new_by`
  // must NOT block pure MapKey lookup lowering.
  let ok_src = "pub struct Cell { v : Int }\n" +
  "pub fn Cell::new_by(f : () -> Int) -> Cell { Cell::{ v: f() } }\n" +
  "pub fn mk_cell() -> Cell {\n" +
  "  let _ = dep::Record::new_by(1)\n" +
  "  Cell::new_by(fn() { 42 })\n" +
  "}\n" +
  "pub fn get_it(m : mbt_compat::OrderedMap[String, Int], k : String) -> Option[Int] {\n" +
  "  m.get(k)\n" +
  "}\n"
  let dep_rec = cprt_mk_dep_abi(
    "dep",
    Some([
      AbiStructSchema::{
        pkg: "dep",
        name: "Record",
        type_params: [],
        fields: [AbiStructField::{ src_name: "x", emit_name: "x", is_mut: false, visibility: "pub", ty: "Int" }],
        can_construct: true,
        can_update: true,
        complete: true,
      },
    ]),
    [],
  )
  let ok_ctx = CrossPkgMutationContext::{
    dep_abis: [("dep", dep_rec)],
    using_values: Map(),
    using_types: Map(),
    pkg_aliases: Map(),
  }
  let g_idx = ok_src.index_of("m.get(k)")
  let ok_qt = parse_pkg_query_types_json(
    cprt_qt_json_for_file("ok.pion", cprt_qt_expr_entry(g_idx + 2, g_idx, g_idx + 8, "mbt_compat::OrderedMap[String, Int]")),
  )
  let (ok_out, ok_ch) = stage_b_lower_pure_mapkey_lookups(
    [GeneratedFile::{ rel_path: "ok.pion", content: ok_src, source_file: "ok.mbt", anchors: [] }],
    ok_qt,
    Map(),
    Map(),
    ok_ctx,
  )
  assert_true(ok_ch, "concrete local/dep struct::new_by must NOT block pure MapKey lowering")
  assert_true(str_has(ok_out[0].content, "mbt_compat::ordered_map_get_mapkey(m, k)"), "m.get(k) must be lowered")

  // Negative 1: `type AliasMap[K, V] = mbt_compat::OrderedMap[K, V]; AliasMap::new_by(...)` MUST fail-closed.
  let alias_src = "type AliasMap[K, V] = mbt_compat::OrderedMap[K, V]\n" +
  "pub fn mk() -> AliasMap[String, Int] {\n" +
  "  AliasMap::new_by(fn(s) { s.length() }, fn(a, b) { a == b })\n" +
  "}\n" +
  "pub fn get_it(m : mbt_compat::OrderedMap[String, Int], k : String) -> Option[Int] {\n" +
  "  m.get(k)\n" +
  "}\n"
  let ag_idx = alias_src.index_of("m.get(k)")
  let a_qt = parse_pkg_query_types_json(
    cprt_qt_json_for_file("a.pion", cprt_qt_expr_entry(ag_idx + 2, ag_idx, ag_idx + 8, "mbt_compat::OrderedMap[String, Int]")),
  )
  let (a_out, a_ch) = stage_b_lower_pure_mapkey_lookups(
    [GeneratedFile::{ rel_path: "a.pion", content: alias_src, source_file: "a.mbt", anchors: [] }],
    a_qt,
    Map(),
    Map(),
    CrossPkgMutationContext::empty(),
  )
  assert_true(!a_ch && !str_has(a_out[0].content, "ordered_map_get_mapkey"), "type AliasMap::new_by must fail-closed")

  // Negative 2: external unknown `ext::Unknown::new_by(...)` MUST fail-closed.
  let ext_src = "pub fn mk() -> Unit { let _ = ext::Unknown::new_by(1) }\n" +
  "pub fn get_it(m : mbt_compat::OrderedMap[String, Int], k : String) -> Option[Int] {\n" +
  "  m.get(k)\n" +
  "}\n"
  let eg_idx = ext_src.index_of("m.get(k)")
  let e_qt = parse_pkg_query_types_json(
    cprt_qt_json_for_file("e.pion", cprt_qt_expr_entry(eg_idx + 2, eg_idx, eg_idx + 8, "mbt_compat::OrderedMap[String, Int]")),
  )
  let (e_out, e_ch) = stage_b_lower_pure_mapkey_lookups(
    [GeneratedFile::{ rel_path: "e.pion", content: ext_src, source_file: "e.mbt", anchors: [] }],
    e_qt,
    Map(),
    Map(),
    CrossPkgMutationContext::empty(),
  )
  assert_true(!e_ch && !str_has(e_out[0].content, "ordered_map_get_mapkey"), "ext::Unknown::new_by must fail-closed")

  // Negative 3: bare `new_by(...)` and `ordered_map_new_by(...)` MUST fail-closed.
  let bare_src = "pub fn mk() -> Unit { let _ = new_by(1) }\n" +
  "pub fn get_it(m : mbt_compat::OrderedMap[String, Int], k : String) -> Option[Int] {\n" +
  "  m.get(k)\n" +
  "}\n"
  let bg_idx = bare_src.index_of("m.get(k)")
  let b_qt = parse_pkg_query_types_json(
    cprt_qt_json_for_file("b.pion", cprt_qt_expr_entry(bg_idx + 2, bg_idx, bg_idx + 8, "mbt_compat::OrderedMap[String, Int]")),
  )
  let (b_out, b_ch) = stage_b_lower_pure_mapkey_lookups(
    [GeneratedFile::{ rel_path: "b.pion", content: bare_src, source_file: "b.mbt", anchors: [] }],
    b_qt,
    Map(),
    Map(),
    CrossPkgMutationContext::empty(),
  )
  assert_true(!b_ch && !str_has(b_out[0].content, "ordered_map_get_mapkey"), "bare new_by must fail-closed")
}

test "pipeline_dep_doc_json_ret_types: concrete dep fn passes pure ==; generic dep fn fails closed" {
  let dep_doc_json = "{\"packages\":[{\"name\":\"jlib\",\"items\":[" +
  "{\"kind\":\"fn\",\"name\":\"text\",\"sig\":\"pub fn text(v : Option[mbt_compat::MbtJson], k : String) -> String\"}," +
  "{\"kind\":\"fn\",\"name\":\"identity\",\"sig\":\"pub fn identity[T](x : T) -> T\"}" +
  "]}]}"
  let dep_abi = PackageAbi::{
    package_name: "jlib",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [OpImplEntry::{ pkg: "jlib", type_name: "Tag", op: "eq", fn_name: "Tag::equal" }],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [cprt_pure_fms("text"), cprt_pure_fms("identity")],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let ok_src = "pub fn find_row(rows : Array[mbt_compat::MbtJson], target : String) -> Option[mbt_compat::MbtJson] {\n" +
  "  rows.iter().find_first(fn(r) { @jlib.text(Some(r), \"k\") == target })\n" +
  "}\n"
  let bad_src = "pub fn find_gen(rows : Array[String], target : String) -> Option[String] {\n" +
  "  rows.iter().find_first(fn(r) { @jlib.identity(r) == target })\n" +
  "}\n"
  let make_iter_check = fn(rty : String, batch : Array[(String, String)], with_types : Bool) -> String {
    if batch.length() == 0 { return "" }
    let rel = batch[0].0
    let body = batch[0].1
    let diags : Array[String] = []
    let lines = body.split("\n")
    let mut li = 0
    while li < lines.length() {
      let it_col = lines[li].index_of("rows.iter()")
      if it_col >= 0 {
        diags.push(
          "{\"file\":\"" + rel + "\",\"line\":" + (li + 1).to_string() + ",\"col\":" + (it_col + 6).to_string() +
          ",\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `iter` on type `" + rty + "`\"}",
        )
      }
      li = li + 1
    }
    if !with_types {
      return "{\"id\":1,\"ok\":" + (if diags.length() == 0 { "true" } else { "false" }) +
      ",\"diagnostics\":[" + diags.join(",") + "]}"
    }
    "{\"id\":1,\"ok\":true,\"diagnostics\":[" + diags.join(",") +
    "],\"types\":[{\"file\":\"" + rel + "\",\"expr_tys\":[],\"call_targets\":[]}]}"
  }

  let ok_res = transpile_package_with_query_types(
    [SourceFile::{ rel_path: "ok_doc.mbt", content: ok_src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [dep_doc_json],
    [("jlib", dep_abi)],
    [],
    [],
    default_options(),
    [],
    true,
    fn(b) { make_iter_check("Array[mbt_compat::MbtJson]", b, false) },
    fn(b) { make_iter_check("Array[mbt_compat::MbtJson]", b, true) },
  )
  assert_true(ok_res.blockers == 0, "concrete dep_doc_json fn jlib::text must pass Gate C with 0 blockers")
  assert_true(str_has(ok_res.files[0].content, "mbt_compat::arr_iter(rows)"), "concrete dep fn .iter() must rewrite")

  let bad_res = transpile_package_with_query_types(
    [SourceFile::{ rel_path: "bad_doc.mbt", content: bad_src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [dep_doc_json],
    [("jlib", dep_abi)],
    [],
    [],
    default_options(),
    [],
    true,
    fn(b) { make_iter_check("Array[String]", b, false) },
    fn(b) { make_iter_check("Array[String]", b, true) },
  )
  assert_true(bad_res.blockers > 0, "generic dep_doc_json fn returning formal T must fail-closed")
}
