///| Unit tests for method labeled/optional arg forwarding, expected-type constructor
///| disambiguation, exhaustive `as`-pattern lowering, reserved built-in `Scope` type
///| renaming, and stdlib/compat rewrites (`Iter`, `@cmp`, Stage B method mappings).

test "method_args: multiline chained/cross-pkg method calls lower arg~, arg?, arg?=expr" {
  let src = SourceFile::{
    rel_path: "calls.mbt",
    content: "pub fn run(v : Any, near_foot? : Bool, place : Int, reused : Int?, make_reused : (() -> Int)?) -> Unit {\n" +
    "  v.scrolls_window(\n" +
    "    near_foot?,\n" +
    "    place~,\n" +
    "    reused?=reused,\n" +
    "    make_reused?=make_reused,\n" +
    "    fn(s, item) { let _ = (s, item) },\n" +
    "  )\n" +
    "  v.chain().item(place~, near_foot?)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "near_foot?=near_foot"), "arg? lowered to arg?=arg in multiline method call: " + out)
  assert_true(str_has(out, "place=place"), "arg~ lowered to arg=arg in multiline method call: " + out)
  assert_true(str_has(out, "reused?=reused"), "arg?=expr preserved in multiline method call: " + out)
  assert_true(str_has(out, "make_reused?=make_reused"), "make_reused?=expr preserved: " + out)
  assert_true(!str_has(out, "place~"), "no residual place~ token")
  assert_true(!str_has(out, "near_foot?,"), "no residual near_foot? token")
}

test "ctor_expect B1: primitive/return types NEVER prefixed onto bare ctors; cross-pkg method param type resolves" {
  let dep_doc = "{\"packages\":[{\"name\":\"theme\",\"items\":[" +
  "{\"kind\":\"struct\",\"name\":\"Theme\",\"sig\":\"pub struct Theme { base : Double }\"}," +
  "{\"kind\":\"enum\",\"name\":\"Radius\",\"sig\":\"pub enum Radius { Sm; Md; Lg }\"}," +
  "{\"kind\":\"fn\",\"name\":\"get_theme\",\"sig\":\"pub fn get_theme() -> Theme\"}," +
  "{\"kind\":\"method\",\"name\":\"Theme::corner\",\"sig\":\"pub fn Theme::corner(self : Theme, r : Radius) -> Double\"}" +
  "]}]}"
  let dep_other = "{\"packages\":[{\"name\":\"other\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"Size\",\"sig\":\"pub enum Size { Sm; Lg }\"}" +
  "]}]}"
  let src = SourceFile::{
    rel_path: "b1.mbt",
    content: "pub fn calc() -> () -> Double {\n" +
    "  fn() { @theme.get_theme().corner(Lg) }\n" +
    "}\n" +
    "pub fn unknown_method_no_leak(u : Any) -> Double {\n" +
    "  u.unknown_m(Lg)\n" +
    "}\n" +
    "pub fn cmp_no_bool_prefix(x : Any) -> Bool {\n" +
    "  x == Lg\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [dep_doc, dep_other], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(!str_has(out, "Double::Lg"), "must NEVER emit Double::Lg: " + out)
  assert_true(!str_has(out, "Bool::Lg"), "must NEVER emit Bool::Lg: " + out)
  assert_true(str_has(out, "corner(.Lg)") || str_has(out, "corner(theme::Radius::Lg)"), "cross-pkg method param resolves Lg cleanly: " + out)
}

test "ctor_expect B2: cross-pkg expected enum overrides local same-name variant across Prop/Option/nested ctors" {
  let dep_axis = "{\"packages\":[{\"name\":\"axis\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"Align\",\"sig\":\"pub enum Align { Start; Center; End }\"}" +
  "]}]}"
  let dep_w = "{\"packages\":[{\"name\":\"w\",\"items\":[" +
  "{\"kind\":\"struct\",\"name\":\"Widget\",\"sig\":\"pub struct Widget { id : Int }\"}," +
  "{\"kind\":\"struct\",\"name\":\"Palette\",\"sig\":\"pub struct Palette { id : Int }\"}," +
  "{\"kind\":\"enum\",\"name\":\"Prop\",\"sig\":\"pub enum Prop[T] { Is(T); Bind(() -> T) }\"}," +
  "{\"kind\":\"enum\",\"name\":\"Level\",\"sig\":\"pub enum Level { L10; L50 }\"}," +
  "{\"kind\":\"enum\",\"name\":\"Tone\",\"sig\":\"pub enum Tone { Primary; Base; Surface; Border; Over(Tone, Tone); A(Tone, Level) }\"}," +
  "{\"kind\":\"method\",\"name\":\"Widget::align\",\"sig\":\"pub fn Widget::align(self : Widget, a : Prop[Option[axis::Align]]) -> Widget\"}," +
  "{\"kind\":\"method\",\"name\":\"Palette::swatch\",\"sig\":\"pub fn Palette::swatch(self : Palette, c : Tone) -> Int\"}" +
  "]}]}"
  let src = SourceFile::{
    rel_path: "b2.mbt",
    content: "enum LocalShadow {\n  Start\n  Surface\n  Border\n}\n\n" +
    "pub fn demo(v : @w.Widget, t : @w.Palette) -> Int {\n" +
    "  let _ = v.align(Is(Some(Start)))\n" +
    "  let a = t.swatch(Surface)\n" +
    "  let b = t.swatch(Border)\n" +
    "  let c = t.swatch(Over(Primary, A(Base, L10)))\n" +
    "  a + b + c\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [dep_axis, dep_w], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "axis::Align::Start"), "Is(Some(Start)) resolves to axis::Align::Start over LocalShadow::Start: " + out)
  assert_true(str_has(out, "w::Tone::Surface"), "t.swatch(Surface) resolves to w::Tone::Surface: " + out)
  assert_true(str_has(out, "w::Tone::Border"), "t.swatch(Border) resolves to w::Tone::Border: " + out)
  assert_true(str_has(out, "w::Tone::Over(w::Tone::Primary, w::Tone::A(w::Tone::Base, w::Level::L10))") ||
    str_has(out, ".Over(.Primary, .A(.Base, .L10))"),
    "nested Over(Primary, A(Base, L10)) resolves cleanly without LocalShadow: " + out)
  assert_true(!str_has(out, "LocalShadow::"), "must NEVER qualify with LocalShadow: " + out)
}

test "ctor_expect B3: is Some(Pat) and match opt Some(Pat) unwrap Option[E] for disambiguation" {
  let dep_lay = "{\"packages\":[{\"name\":\"lay\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"Len\",\"sig\":\"pub enum Len { Full; Cut; Grow(Int); Pct(Int); Within(Int) }\"}," +
  "{\"kind\":\"struct\",\"name\":\"Query\",\"sig\":\"pub struct Query { w : Option[Len] }\"}" +
  "]}]}"
  let src = SourceFile::{
    rel_path: "b3.mbt",
    content: "enum LocalKind {\n  Full\n  Cut\n  Grow(Int)\n  Pct(Int)\n  Within(Int)\n}\n\n" +
    "pub fn check_q(q : @lay.Query, l : @lay.Len?) -> Bool {\n" +
    "  let a = q.w is Some(Full | Grow(_))\n" +
    "  let b = q.w is Some(Cut)\n" +
    "  let c = q.w is Some(Within(_))\n" +
    "  let d = match l {\n" +
    "    Some(Pct(_) | Within(_)) => true\n" +
    "    _ => false\n" +
    "  }\n" +
    "  a || b || c || d\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [dep_lay], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "lay::Len::Full"), "is Some(Full | Grow(_)) qualifies Full: " + out)
  assert_true(str_has(out, "lay::Len::Grow(_)"), "is Some(Full | Grow(_)) qualifies Grow: " + out)
  assert_true(str_has(out, "lay::Len::Cut"), "is Some(Cut) qualifies Cut: " + out)
  assert_true(str_has(out, "lay::Len::Within(_)"), "is Some(Within(_)) qualifies Within: " + out)
  assert_true(str_has(out, "lay::Len::Pct(_)"), "match Some(Pct(_) | Within(_)) qualifies Pct: " + out)
}

test "as_pattern C: top-level Some(_) as hit and guarded Some(x) as hit lower exhaustively" {
  let src = SourceFile::{
    rel_path: "as_pat.mbt",
    content: "pub fn find_hit(f : () -> Int?) -> Int? {\n" +
    "  match f() {\n" +
    "    Some(_) as hit => return hit\n" +
    "    None => ()\n" +
    "  }\n" +
    "  None\n" +
    "}\n" +
    "pub fn guarded_hit(opt : Int?) -> Int? {\n" +
    "  match opt {\n" +
    "    Some(x) as hit if x > 0 => hit\n" +
    "    _ => None\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "let __mbt_scrut_") && str_has(out, "Option::Some(_) => { let hit = __mbt_scrut_"), "Some(_) as hit binds scrutinee once and preserves identity: " + out)
  assert_true(str_has(out, "Option::Some(x) if ({ let hit = __mbt_scrut_") && str_has(out, "; x > 0 })"), "guarded Some(x) as hit exposes hit and x in guard: " + out)
}

test "reserved_type D: priv enum/struct Scope renames consistently without touching pub Scope" {
  let src = SourceFile::{
    rel_path: "scope_priv.mbt",
    content: "priv enum Scope {\n  Text\n  Box(Int)\n}\n\n" +
    "fn Scope::tag(self : Scope) -> Int {\n" +
    "  match self {\n" +
    "    Scope::Text => 1\n" +
    "    Box(n) => n\n" +
    "  }\n" +
    "}\n\n" +
    "pub fn run() -> Int {\n" +
    "  let s : Scope = Scope::Text\n" +
    "  s.tag() + Scope::Box(5).tag()\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "enum __mbt_priv_Scope"), "priv enum Scope renamed: " + out)
  assert_true(str_has(out, "fn __mbt_priv_Scope::tag(self : __mbt_priv_Scope)"), "method receiver & param renamed: " + out)
  assert_true(str_has(out, "__mbt_priv_Scope::Text"), "qualified ctor path renamed: " + out)
  assert_true(str_has(out, "let s : __mbt_priv_Scope = __mbt_priv_Scope::Text"), "type annotation renamed: " + out)
  assert_true(!str_has(out, "enum Scope"), "no raw enum Scope emitted")
}

test "stdlib_compat E: Iter[T], Iter::new, @cmp.{maximum,minimum}, Stage B routes, and negative anti-hijack" {
  let opts = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "import {\n  \"moonbitlang/core/cmp\",\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let src = SourceFile::{
    rel_path: "std_e.mbt",
    content: "pub fn make_it() -> Iter[Int] {\n" +
    "  Iter::new(fn() { None })\n" +
    "}\n" +
    "pub fn pick(a : Int, b : Int) -> (Int, Int) {\n" +
    "  (@cmp.maximum(a, b), @cmp.minimum(a, b))\n" +
    "}\n" +
    "pub fn keep_qual(x : @other.Iter[Int]) -> @other.Iter[Int] { x }\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], opts, [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "-> mbt_compat::MbtIter[Int]"), "Iter[T] -> mbt_compat::MbtIter[T]: " + out)
  assert_true(str_has(out, "mbt_compat::mbt_iter_new("), "Iter::new -> mbt_compat::mbt_iter_new: " + out)
  assert_true(str_has(out, "mbt_compat::cmp_maximum(a, b)"), "@cmp.maximum lowered: " + out)
  assert_true(str_has(out, "mbt_compat::cmp_minimum(a, b)"), "@cmp.minimum lowered: " + out)
  assert_true(str_has(out, "other::Iter[Int]"), "qualified @other.Iter[Int] NOT hijacked: " + out)
  assert_true(!str_has(out, "import \"cmp\""), "moonbitlang/core/cmp stripped from imports")

  // Stage B routing + negative anti-hijack checks
  assert_true(lookup_missing_method_helper("Array[Int]", "iter2") == Some("mbt_compat::arr_iter2"), "Array::iter2")
  assert_true(lookup_missing_method_helper("Array[Int]", "rev_iter") == Some("mbt_compat::arr_rev_iter"), "Array::rev_iter")
  assert_true(lookup_missing_method_helper("Array[Array[Int]]", "flatten") == Some("mbt_compat::arr_flatten"), "Array::flatten")
  assert_true(lookup_missing_method_helper("OrderedMap[String, Int]", "iter2") == Some("mbt_compat::ordered_map_iter2"), "OrderedMap::iter2")
  assert_true(lookup_missing_method_helper("String", "is_empty") == Some("mbt_compat::str_is_empty"), "String::is_empty")
  assert_true(lookup_missing_method_helper("String", "rev") == Some("mbt_compat::str_rev"), "String::rev")
  assert_true(lookup_missing_method_helper("String", "rev_iter") == Some("mbt_compat::str_rev_iter"), "String::rev_iter")
  assert_true(lookup_missing_method_helper("String", "repeat") == Some("mbt_compat::str_repeat"), "String::repeat")
  assert_true(lookup_missing_method_helper("String", "contains_code_unit") == Some("mbt_compat::str_contains_code_unit"), "String::contains_code_unit")
  assert_true(lookup_missing_method_helper("Char", "compare") == Some("mbt_compat::char_compare"), "Char::compare")
  assert_true(lookup_missing_method_helper("UserBox", "max") is None, "user struct .max() MUST NOT be hijacked")
  assert_true(lookup_missing_method_helper("UserBox", "min") is None, "user struct .min() MUST NOT be hijacked")
}

test "stage_b tuple hash rewrite handles MbtHash diagnostics and rejects trait mismatch" {
  let ln2 = "  let h = mbt_compat::mbt_hash((1, \"a\"))"
  let msg2 = "type `(Int, String)` does not implement trait `mbt_compat::MbtHash` required by `mbt_hash`"
  assert_true(
    rewrite_tuple_mapkey_call_at(ln2, 11, msg2) == Some("  let h = mbt_compat::mbt_hash_pair((1, \"a\"))"),
    "MbtHash pair diagnostic rewrites mbt_hash -> mbt_hash_pair",
  )
  let ln3 = "  let h = mbt_compat::mbt_hash((1, \"a\", true))"
  let msg3 = "type `(Int, String, Bool)` does not implement trait `mbt_compat::MbtHash` required by `mbt_hash`"
  assert_true(
    rewrite_tuple_mapkey_call_at(ln3, 11, msg3) == Some("  let h = mbt_compat::mbt_hash_triple((1, \"a\", true))"),
    "MbtHash triple diagnostic rewrites mbt_hash -> mbt_hash_triple",
  )
  // Mismatched trait must not rewrite
  let wrong_hash = "type `(Int, String)` does not implement trait `mbt_compat::MapKey` required by `mbt_hash`"
  assert_true(rewrite_tuple_mapkey_call_at(ln2, 11, wrong_hash) is None, "MapKey diagnostic must not rewrite mbt_hash")
  let ln_map = "  let m = mbt_compat::ordered_map_new()"
  let wrong_map = "type `(Int, String)` does not implement trait `mbt_compat::MbtHash` required by `ordered_map_new`"
  assert_true(rewrite_tuple_mapkey_call_at(ln_map, 11, wrong_map) is None, "MbtHash diagnostic must not rewrite ordered_map_new")
}

test "gate D blocks kept Array::iter2 and Array::rev_iter when mutated by push+write or pop" {
  let src_i2 = "pub fn bad_iter2(xs : Array[Int]) -> Int {\n  let it = xs.iter2()\n  xs.push(99)\n  xs[0] = 0\n  it.to_array().length()\n}\n"
  let diags_i2 : Array[Diag] = []
  let ledger_i2 : Array[DriftEntry] = []
  let ms_i2 = collect_pkg_mutation_summary_tokens([lex_moonbit(src_i2)])
  let ft_i2 : Map[String, Array[Token]] = Map()
  let ok_i2 = stage_b_check_kept_iter_with_summary(ft_i2, ms_i2, "i2.pion", src_i2, None, Map(), "Int", 2, 15, diags_i2, ledger_i2)
  assert_true(!ok_i2, "kept xs.iter2() followed by xs.push + xs[0]=0 must be blocked")
  assert_true(diags_i2.length() > 0 && diags_i2[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "iter2 mutation emits MBT2PION_ARRAY_ITER_MUTATION")

  let src_ri = "pub fn bad_rev_iter(xs : Array[Int]) -> Int {\n  let it = xs.rev_iter()\n  let _ = xs.pop()\n  it.collect().length()\n}\n"
  let diags_ri : Array[Diag] = []
  let ledger_ri : Array[DriftEntry] = []
  let ms_ri = collect_pkg_mutation_summary_tokens([lex_moonbit(src_ri)])
  let ft_ri : Map[String, Array[Token]] = Map()
  let ok_ri = stage_b_check_kept_iter_with_summary(ft_ri, ms_ri, "ri.pion", src_ri, None, Map(), "Int", 2, 15, diags_ri, ledger_ri)
  assert_true(!ok_ri, "kept xs.rev_iter() followed by xs.pop must be blocked")
  assert_true(diags_ri.length() > 0 && diags_ri[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "rev_iter mutation emits MBT2PION_ARRAY_ITER_MUTATION")
}

test "as_pattern C2: None/Ok/Err as hit and untyped scrutinee bind __mbt_scrut_N cleanly" {
  let src = SourceFile::{
    rel_path: "as_typed.mbt",
    content: "pub fn match_none(opt : Option[Int]) -> Option[Int] {\n" +
    "  match opt {\n" +
    "    None as hit => hit\n" +
    "    Some(v) => Some(v)\n" +
    "  }\n" +
    "}\n" +
    "pub fn match_res(res : Result[Int, String], flag : Bool) -> Result[Int, String] {\n" +
    "  match res {\n" +
    "    Ok(v) as hit if flag && v > 0 => hit\n" +
    "    Err(e) as hit => hit\n" +
    "    Ok(_) => Err(\"neg\")\n" +
    "  }\n" +
    "}\n" +
    "pub fn match_untyped(f : () -> Any) -> Int {\n" +
    "  match f() {\n" +
    "    None as hit => { let _ = hit; 1 }\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "Option::None => { let hit = __mbt_scrut_"), "None as hit binds scrutinee temp (inherits Option[Int]): " + out)
  assert_true(str_has(out, "Result::Ok(v) if ({ let hit = __mbt_scrut_"), "Ok(v) as hit binds scrutinee temp in guard: " + out)
  assert_true(str_has(out, "Result::Err(e) => { let hit = __mbt_scrut_"), "Err(e) as hit binds scrutinee temp: " + out)
  assert_true(!str_has(out, "let hit = Option::None"), "must never reconstruct unannotated Option::None: " + out)
}

test "R3 regressions: transparent type Scope alias, read-only iter2/rev_iter, mutating cmp_maximum, Shadow Some, ext tilde method" {
  // P1-3: transparent type alias `type Scope = Int` must NOT be added to priv_type_renames
  let src_alias = SourceFile::{
    rel_path: "scope_alias.mbt",
    content: "type Scope = Int\n\npub fn run_alias() -> Int {\n  let x : Scope = 41\n  x\n}\n",
    is_test: false,
  }
  let res_alias = transpile_package([src_alias], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res_alias.blockers, 0)
  let out_alias = res_alias.files[0].content
  assert_true(str_has(out_alias, "let x : Int = 41"), "transparent type Scope = Int expands to Int: " + out_alias)
  assert_true(!str_has(out_alias, "__mbt_priv_Scope"), "transparent type Scope = Int must NOT emit __mbt_priv_Scope: " + out_alias)

  // P1-2: cmp_maximum with custom Compare mutating array must fail-closed in xs.iter().any(...)
  let src_cmp_mut = "struct MutCmp {\n  v : Int\n}\nimpl mbt_compat::MbtCompare for MutCmp {\n  fn mbt_compare(self : MutCmp, other : MutCmp) -> Int {\n    let _ = xs.pop()\n    self.v - other.v\n  }\n}\npub fn check_mut(xs : Array[Int]) -> Bool {\n  xs.iter().any(fn(x) { mbt_compat::cmp_maximum(MutCmp::{ v: x }, MutCmp::{ v: x }).v > 0 })\n}\n"
  let ms_cmp = collect_pkg_mutation_summary_tokens([lex_moonbit(src_cmp_mut)])
  let diags_cmp : Array[Diag] = []
  let ledger_cmp : Array[DriftEntry] = []
  let ft_cmp : Map[String, Array[Token]] = Map()
  let ok_cmp = stage_b_check_kept_iter_with_summary(ft_cmp, ms_cmp, "cmp_mut.pion", src_cmp_mut, None, Map(), "Int", 10, 6, diags_cmp, ledger_cmp)
  assert_true(!ok_cmp, "cmp_maximum in xs.iter().any must fail-closed when Compare may mutate array")

  // P2-1: read-only for-in iter2, for-in rev_iter, and rev_iter().any(...) must NOT false-positive
  let src_ro_i2 = "pub fn ro_i2(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for i, x in xs.iter2() {\n    s = s + i + x\n  }\n  s\n}\n"
  let diags_ro1 : Array[Diag] = []
  let ledger_ro1 : Array[DriftEntry] = []
  let ms_ro1 = collect_pkg_mutation_summary_tokens([lex_moonbit(src_ro_i2)])
  assert_true(
    stage_b_check_kept_iter_with_summary(Map(), ms_ro1, "ro1.pion", src_ro_i2, None, Map(), "Int", 3, 18, diags_ro1, ledger_ro1),
    "read-only for i, x in xs.iter2() must be allowed",
  )

  let src_ro_ri = "pub fn ro_ri(xs : Array[Int]) -> Bool {\n  xs.rev_iter().any(fn(v) { v > 3 })\n}\n"
  let diags_ro2 : Array[Diag] = []
  let ledger_ro2 : Array[DriftEntry] = []
  let ms_ro2 = collect_pkg_mutation_summary_tokens([lex_moonbit(src_ro_ri)])
  assert_true(
    stage_b_check_kept_iter_with_summary(Map(), ms_ro2, "ro2.pion", src_ro_ri, None, Map(), "Int", 2, 6, diags_ro2, ledger_ro2),
    "read-only xs.rev_iter().any(...) must be allowed",
  )

  // P2-3: local `enum Shadow { Some(Int) }` must NOT block `is Some(AA | BB)` payload disambiguation
  let dep_k = "{\"packages\":[{\"name\":\"kp\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"Kind\",\"sig\":\"pub enum Kind { AA; BB }\"}" +
  "]}]}"
  let src_sh = SourceFile::{
    rel_path: "sh_some.mbt",
    content: "enum Shadow {\n  Some(Int)\n}\n\n" +
    "enum LocalKind {\n  AA\n  BB\n}\n\n" +
    "pub fn check_opt(x : @kp.Kind?) -> Bool {\n" +
    "  (x is Some(AA | BB)) || (x is Option::Some(AA | BB))\n" +
    "}\n",
    is_test: false,
  }
  let res_sh = transpile_package_ex([src_sh], empty_api_map(), default_recipes(), [], [], [dep_k], [], default_options(), [], false, noop_check)
  assert_eq(res_sh.blockers, 0)
  let out_sh = res_sh.files[0].content
  assert_true(str_has(out_sh, "kp::Kind::AA") && str_has(out_sh, "kp::Kind::BB"), "local Shadow::Some must not block Option::Some(AA | BB) disambiguation: " + out_sh)

  // R7: local `Local::add(self, extra? : Int = 6)` coexisting with external dep `Widget::add(self, extra~: Int = 6)`:
  // - `Local::{ value: 4 }.add(extra?)` MUST lower cleanly with 0 blockers (no false positive from external_tilde_fns)
  // - `w.add()` / `w.add(extra=11)` MUST emit cleanly with zero `loc=`
  let dep_tilde = "{\"packages\":[{\"name\":\"dep\",\"items\":[" +
  "{\"kind\":\"struct\",\"name\":\"Widget\",\"sig\":\"pub struct Widget { base : Int }\"}," +
  "{\"kind\":\"fn\",\"name\":\"Widget::make\",\"sig\":\"pub fn Widget::make() -> Widget\"}," +
  "{\"kind\":\"method\",\"name\":\"Widget::add\",\"sig\":\"pub fn Widget::add(self : Widget, extra~: Int = 6) -> Int\"}" +
  "]}]}"
  let src_tilde = SourceFile::{
    rel_path: "ext_tilde.mbt",
    content: "struct Local {\n  value : Int\n}\n" +
    "fn Local::add(self : Local, extra? : Int = 6) -> Int {\n  self.value + extra\n}\n" +
    "pub fn run_add(w : @dep.Widget, extra? : Int) -> Int {\n" +
    "  Local::{ value: 4 }.add(extra?) + w.add() + w.add(extra=11)\n" +
    "}\n",
    is_test: false,
  }
  let res_tilde = transpile_package_ex([src_tilde], empty_api_map(), default_recipes(), [], [], [dep_tilde], [], default_options(), [], false, noop_check)
  assert_eq(res_tilde.blockers, 0)
  let out_tilde = res_tilde.files[0].content
  assert_true(!str_has(out_tilde, "loc="), "external dep tilde method MUST NOT inject loc=: " + out_tilde)
  assert_true(str_has(out_tilde, "Local::{ value: 4 }.add(extra?=extra)"), "local struct literal .add(extra?) lowers cleanly alongside same-name ext dep method: " + out_tilde)
  assert_true(str_has(out_tilde, "w.add()") && str_has(out_tilde, "w.add(extra=11)"), "plain/named external dep tilde calls stay clean: " + out_tilde)

  // R4 P1-1: user-defined bare `arr_iter2(xs)` and host-struct `h.rev_iter()` MUST stay blocked during kept iter!
  let src_user_fn = "fn arr_iter2(xs : Array[Int]) -> Unit { let _ = xs.pop() }\npub fn bad_fn(xs : Array[Int]) -> Int {\n  let it = xs.iter()\n  arr_iter2(xs)\n  it.count()\n}\n"
  let diags_uf : Array[Diag] = []
  let ms_uf = collect_pkg_mutation_summary_tokens([lex_moonbit(src_user_fn)])
  assert_true(
    !stage_b_check_kept_iter_with_summary(Map(), ms_uf, "uf.pion", src_user_fn, None, Map(), "Int", 3, 15, diags_uf, []),
    "user-defined bare fn arr_iter2(xs) during kept iter MUST be blocked",
  )
  assert_true(diags_uf.length() > 0 && diags_uf[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "bare fn arr_iter2 emits MBT2PION_ARRAY_ITER_MUTATION")

  let src_host_m = "struct Holder { xs : Array[Int] }\nfn Holder::rev_iter(self : Holder) -> Unit { let _ = self.xs.pop() }\npub fn bad_host(h : Holder) -> Int {\n  let it = h.xs.iter()\n  h.rev_iter()\n  it.count()\n}\n"
  let diags_hm : Array[Diag] = []
  let ms_hm = collect_pkg_mutation_summary_tokens([lex_moonbit(src_host_m)])
  assert_true(
    !stage_b_check_kept_iter_with_summary(Map(), ms_hm, "hm.pion", src_host_m, None, Map(), "Int", 4, 17, diags_hm, []),
    "host-struct h.rev_iter() during kept h.xs.iter() MUST be blocked",
  )
  assert_true(diags_hm.length() > 0 && diags_hm[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "host h.rev_iter() emits MBT2PION_ARRAY_ITER_MUTATION")
}

test "reserved_type D2: bare private enum Scope renames while pub enum Scope stays untouched" {
  let src_bare = SourceFile::{
    rel_path: "scope_bare.mbt",
    content: "enum Scope {\n  Leaf\n}\n\n" +
    "pub fn get_leaf() -> Int {\n" +
    "  let s : Scope = Scope::Leaf\n" +
    "  match s { Leaf => 1 }\n" +
    "}\n",
    is_test: false,
  }
  let res_bare = transpile_package([src_bare], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res_bare.blockers, 0)
  let out_bare = res_bare.files[0].content
  assert_true(str_has(out_bare, "enum __mbt_priv_Scope"), "bare private enum Scope renamed: " + out_bare)
  assert_true(str_has(out_bare, "let s : __mbt_priv_Scope = __mbt_priv_Scope::Leaf"), "bare private Scope usage renamed: " + out_bare)

  let src_pub = SourceFile::{
    rel_path: "scope_pub.mbt",
    content: "pub enum Scope {\n  Leaf\n}\n",
    is_test: false,
  }
  let res_pub = transpile_package([src_pub], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res_pub.blockers, 0)
  let out_pub = res_pub.files[0].content
  assert_true(str_has(out_pub, "pub enum Scope"), "pub enum Scope must NOT be renamed: " + out_pub)
  assert_true(!str_has(out_pub, "__mbt_priv_Scope"), "pub enum Scope must NOT produce __mbt_priv_Scope")
}

test "builtin Option/Result expected-type propagation is never hijacked by dep or local Ok/Err/Some enums" {
  // 1. External dependency declares `enum DepOutcome { Ok(Int); Err(String) }` and `enum DepMaybe { Some(Int); None }`.
  //    A raising function returning `Len raise ParseErr` (lowered to `Result[Len, ParseErr] { Ok({ ... }) }`) and
  //    an `Option[Len]` function MUST propagate `Len` through `Ok(...)`/`Some(...)` and disambiguate `Cut`/`Full`
  //    against competing local `enum Radius { Cut; Full }` with zero `MBT2PION_AMBIGUOUS_CTOR`.
  let dep_doc = "{\"packages\":[{\"name\":\"ext\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"DepOutcome\",\"sig\":\"pub enum DepOutcome { Ok(Int); Err(String) }\"}," +
  "{\"kind\":\"enum\",\"name\":\"DepMaybe\",\"sig\":\"pub enum DepMaybe { Some(Int); None }\"}" +
  "]}]}"
  let src = SourceFile::{
    rel_path: "res_ok.mbt",
    content: "pub enum Len {\n  Cut\n  Full\n}\n" +
    "pub enum Radius {\n  Cut\n  Full\n}\n" +
    "priv suberror ParseErr {\n  Bad(String)\n}\n" +
    "fn parse_len(s : String) -> Len raise ParseErr {\n" +
    "  match s {\n" +
    "    \"Cut\" => Cut\n" +
    "    \"Full\" => Full\n" +
    "    _ => raise ParseErr::Bad(s)\n" +
    "  }\n" +
    "}\n" +
    "pub fn opt_len(flag : Bool) -> Len? {\n" +
    "  if flag { Some(Cut) } else { None }\n" +
    "}\n" +
    "pub fn ext_outcome() -> @ext.DepOutcome {\n" +
    "  @ext.DepOutcome::Ok(1)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [dep_doc], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "Len::Cut") && str_has(out, "Len::Full"), "Ok/Some inner Len expected type disambiguates Cut/Full: " + out)
  assert_true(str_has(out, "ext::DepOutcome::Ok(1)"), "explicit @ext.DepOutcome::Ok stays intact: " + out)

  // 2. Local enum also shadows `Ok`: `Result[Len, String]` MUST emit `Result::Ok(Len::Cut)` cleanly.
  let src_local = SourceFile::{
    rel_path: "res_local_ok.mbt",
    content: "pub enum Len { Cut; Full }\n" +
    "pub enum Radius { Cut; Full }\n" +
    "enum LocalRes { Ok(Int) }\n" +
    "pub fn make_res() -> Result[Len, String] {\n" +
    "  Ok(Cut)\n" +
    "}\n",
    is_test: false,
  }
  let res_l = transpile_package_ex([src_local], empty_api_map(), default_recipes(), [], [], [dep_doc], [], default_options(), [], false, noop_check)
  assert_eq(res_l.blockers, 0)
  let out_l = res_l.files[0].content
  assert_true(str_has(out_l, "Result::Ok(Len::Cut)"), "local Ok shadow still qualifies Result::Ok and propagates Len: " + out_l)
}
