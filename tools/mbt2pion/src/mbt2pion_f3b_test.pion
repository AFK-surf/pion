///| Wave M2-F3b unit tests:
///| 1. Integer literals in a `Byte` array literal lower to `b'\xNN'` (top-level initializers included)
///| 2. A match arm whose body is a bare `.Ctor` is parenthesized before a `(`-led next arm
///| 3. Untyped `let name = fn(p) { ... }` closure parameters inferred from argument uses (fail-closed)
///| 4. `Show::to_string(x)` -> `mbt_compat::__mbt_show_trait(x)`, resolved per exact type (allowlist, fail-closed)
///| 5. `recv.m(..).unwrap_or(lit)` typing feeds the `if .. { float } else { 1.0 }` Float unification
///| 6. Dependency signatures qualify the dependency's own enums (`k: MaskType` -> `dep::MaskType`)
///| 7. Fresh-receiver borrowed slices are tagged for an exact `ArrayBuf` view
///| 8. `String::trim_end` routes to `mbt_compat::str_trim_end`
///| 9. Review regressions: user `.copy()` is never a fresh array; closure inference fails closed on shadowing,
///|    field receivers, named/labeled arguments and omitted labeled parameters

fn f3b_transpile(rel : String, src : String) -> (Int, String) {
  let res = transpile_package([SourceFile::{ rel_path: rel, content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  let sb = StringBuilder()
  for f in res.files {
    sb.write_string(f.content)
    sb.write_string("\n")
  }
  (res.blockers, sb.to_string())
}

test "F3b-1: Byte array literals lower integer literals to byte literals, out-of-range stays Int" {
  let src = "let table : FixedArray[Byte] = [0, 1, 255, 0x10]\n" +
  "pub fn local_tab() -> Int {\n" +
  "  let xs : Array[Byte] = [7, 128]\n" +
  "  let ys : Array[Int] = [7, 300]\n" +
  "  xs[0].to_int() + ys[1] + table[2].to_int()\n" +
  "}\n"
  let (blockers, out) = f3b_transpile("bytes.mbt", src)
  assert_true(blockers == 0, "byte literals transpile with 0 blockers")
  assert_true(str_has(out, "[b'\\x00', b'\\x01', b'\\xff', b'\\x10']"), "top-level FixedArray[Byte] literal uses byte literals")
  assert_true(str_has(out, "[b'\\x07', b'\\x80']"), "local Array[Byte] literal uses byte literals")
  assert_true(str_has(out, "[7, 300]"), "Array[Int] literal is untouched")
  assert_true(byte_lit_for_int_token(lex_moonbit("256"), 0, 1, "Byte") is None, "256 is not a Byte literal (pionc reports it)")
  assert_true(byte_lit_for_int_token(lex_moonbit("5L"), 0, 1, "Byte") is None, "suffixed literal is not rewritten")
  assert_true(byte_lit_for_int_token(lex_moonbit("5"), 0, 1, "Int") is None, "only Byte elements are rewritten")
}

test "F3b-2: bare .Ctor arm body before a tuple-pattern arm is parenthesized" {
  let src = "enum Kind {\n  KStroke\n  KFill\n  KMarkers\n}\n" +
  "enum Order {\n  FillFirst\n  StrokeFirst\n}\n" +
  "fn order_of(a : Kind, b : Kind) -> Order {\n" +
  "  match (a, b) {\n" +
  "    (KStroke, _) => StrokeFirst\n" +
  "    (KMarkers, KStroke) => StrokeFirst\n" +
  "    _ => FillFirst\n" +
  "  }\n" +
  "}\n"
  let (blockers, out) = f3b_transpile("arms.mbt", src)
  assert_true(blockers == 0, "arm guard transpiles with 0 blockers")
  assert_true(str_has(out, "(KStroke, _) => (.StrokeFirst)\n"), "arm followed by `(` pattern is parenthesized")
  assert_true(str_has(out, "(KMarkers, KStroke) => .StrokeFirst\n"), "arm followed by `_` stays bare")
  assert_true(str_has(out, "_ => .FillFirst"), "last arm stays bare")
  assert_true(guard_dot_variant_arm_tail(" .A", lex_moonbit("(x)"), 0, 3) == " (.A)", "keeps leading trivia")
  assert_true(guard_dot_variant_arm_tail(" .A(1)", lex_moonbit("(x)"), 0, 3) == " .A(1)", "a ctor call is not touched")
  assert_true(guard_dot_variant_arm_tail(" a.b", lex_moonbit("(x)"), 0, 3) == " a.b", "field access is not touched")
  assert_true(guard_dot_variant_arm_tail(" .A", lex_moonbit("_ =>"), 0, 2) == " .A", "next arm not `(`-led")
}

test "F3b-3: untyped let-bound closure params are inferred from unambiguous argument uses only" {
  let src = "struct Doc {\n  names : Array[String]\n  vals : Array[Float]\n}\n" +
  "fn Doc::attr(self : Doc, key : String) -> Float? {\n" +
  "  for i, n in self.names {\n    if n == key {\n      return Some(self.vals[i])\n    }\n  }\n  None\n}\n" +
  "fn twice(x : Int) -> Int {\n  x * 2\n}\n" +
  "fn use_doc(doc : Doc, xs : Array[Int]) -> Int {\n" +
  "  let n = fn(k) { doc.attr(k).unwrap_or(0.0) }\n" +
  "  let t = fn(v) { twice(v) }\n" +
  "  let opaque = fn(z) { z }\n" +
  "  let mixed = fn(q) { twice(q) + doc.attr(q).unwrap_or(0.0).to_int() }\n" +
  "  let ys = xs.map(fn(y) { twice(y) })\n" +
  "  n(\"a\").to_int() + t(1) + opaque(2) + mixed(3) + ys.length()\n" +
  "}\n"
  let (_, out) = f3b_transpile("clos.mbt", src)
  assert_true(str_has(out, "let n = fn(k : String) {"), "method-argument use infers String")
  assert_true(str_has(out, "let t = fn(v : Int) {"), "local-function argument use infers Int")
  assert_true(str_has(out, "let opaque = fn(z) {"), "no use: stays unannotated (fail-closed)")
  assert_true(str_has(out, "let mixed = fn(q) {"), "conflicting uses: stays unannotated (fail-closed)")
  assert_true(str_has(out, "fn(y) { twice(y) }"), "argument-position closure keeps expected-type inference")
}

test "F3b-4: Show::to_string(x) lowers to a show-trait probe resolved per exact type (fail-closed)" {
  let src = "enum Fam {\n  Serif\n  Named(String)\n}\n" +
  "impl Show for Fam with output(self, logger) {\n" +
  "  match self {\n    Serif => logger.write_string(\"Serif\")\n    Named(s) => logger.write_string(s)\n  }\n}\n" +
  "fn key(f : Fam, n : Int) -> String {\n  Show::to_string(f) + Show::to_string(n + 1)\n}\n"
  let (_, out) = f3b_transpile("show.mbt", src)
  assert_true(!str_has(out, "Show::to_string"), "no Show:: static call remains")
  assert_true(
    (str_has(out, "__mbt_show_trait(f, \"Fam\")") || str_has(out, "(f).mbt_show_trait_probe")) &&
    (str_has(out, "__mbt_show_trait(n + 1, \"Fam\")") || str_has(out, "(n + 1).mbt_show_trait_probe")),
    "Show::to_string(x) becomes the show-trait placeholder (allowlist: Fam), never a bare .to_string()",
  )
  // An inherent `fn Fam::to_string` next to `impl Show` removes Fam from the allowlist; `derive(Show)` never adds.
  let inh_src = src + "fn Fam::to_string(_self : Fam) -> String { \"inherent\" }\n" +
  "#derive(Show)\nstruct D {\n  x : Int\n}\nfn dkey(d : D) -> String {\n  Show::to_string(d)\n}\n"
  let (_, inh_out) = f3b_transpile("show_inh.mbt", inh_src)
  assert_true(!str_has(inh_out, "\"Fam\")") && !str_has(inh_out, "|D") && !str_has(inh_out, "\"D\")"),
    "inherent to_string / derive(Show) types are not in the allowlist")
  let mk = fn(ty : String) -> (Option[String], Int) {
    let site = ProbeSite::{
      probe_id: "",
      file: "a.pion",
      probe_kind: "mbt_show_trait_probe",
      start_byte: 0,
      end_byte: 0,
      op_byte: 0,
      line: 1,
      col: 1,
      lhs_expr: "x",
      rhs_expr: "Fam|font::FontStyle",
      assign_op: "",
      slice_hi: "",
      divisor_is_zero: false,
      rhs_has_lit: false,
      rhs_is_neg: false,
      rhs_u64: 0UL,
      rhs_overflow: false,
    }
    let diags : Array[Diag] = []
    let ledger : Array[DriftEntry] = []
    let r = rewrite_for_probe_hygienic(site, ty, default_recipes(), Map(), Map(), diags, ledger)
    (r, diags.length())
  }
  assert_true(mk("Double") == (Some("mbt_compat::double_to_string(x)"), 0), "Double -> MoonBit double formatter")
  assert_true(mk("Int") == (Some("(x).to_string()"), 0), "Int -> to_string")
  assert_true(mk("String") == (Some("(x).to_string()"), 0), "String -> to_string")
  assert_true(mk("Fam") == (Some("(x).to_string()"), 0), "user enum -> its transpiled Show")
  assert_true(mk("font::FontStyle") == (Some("(x).to_string()"), 0), "dependency enum -> its transpiled Show")
  assert_true(mk("Float") == (Some("mbt_compat::float_to_string(x)"), 0), "Float -> MoonBit float formatter")
  assert_true(mk("Bytes") == (Some("mbt_compat::bytes_to_string(x)"), 0), "Bytes -> MoonBit bytes formatter")
  assert_true(mk("Byte") == (Some("mbt_compat::byte_to_string(x)"), 0), "Byte -> MoonBit byte formatter")
  for bad in ["BytesView", "Array[Int]", "Option[Int]", "(Int, Int)", "mbt_compat::ArrayView[Int]", "dyn Show", "T", "H", "font::Other"] {
    let (_, nd) = mk(bad)
    assert_true(nd == 1, "Show::to_string on " + bad + " fails closed")
  }
}

test "F3b-5: unwrap_or of an Option[Float] method result types the let for Float if/else unification" {
  let src = "struct Doc {\n  v : Float\n}\n" +
  "fn Doc::num(self : Doc, key : String) -> Float? {\n  if key == \"e\" { Some(self.v) } else { None }\n}\n" +
  "fn spec(doc : Doc) -> Float {\n" +
  "  let e = doc.num(\"e\").unwrap_or(1.0)\n" +
  "  let e = if e >= 0.0 { e } else { 1.0 }\n" +
  "  e\n" +
  "}\n"
  let (_, out) = f3b_transpile("unwrap.mbt", src)
  assert_true(str_has(out, "else { Float::from_double(1.0) }"), "Double literal else-branch unified to Float")
}

test "F3b-6: dependency signatures qualify the dependency's own enum names" {
  let enums : Map[String, Bool] = Map()
  enums["MaskType"] = true
  enums["T"] = true
  let gens : Map[String, Bool] = Map()
  gens["T"] = true
  assert_true(qualify_dep_enum_names("MaskType", "skia", enums, gens) == "skia::MaskType", "bare enum qualified")
  assert_true(qualify_dep_enum_names("Array[MaskType]", "skia", enums, gens) == "Array[skia::MaskType]", "nested enum qualified")
  assert_true(qualify_dep_enum_names("other::MaskType", "skia", enums, gens) == "other::MaskType", "qualified path untouched")
  assert_true(qualify_dep_enum_names("MaskType::X", "skia", enums, gens) == "MaskType::X", "path head untouched")
  assert_true(qualify_dep_enum_names("MaskTypes", "skia", enums, gens) == "MaskTypes", "whole identifiers only")
  assert_true(qualify_dep_enum_names("Array[T]", "skia", enums, gens) == "Array[T]", "generic parameter shadows enum name")
  let st = empty_symbol_table()
  let doc = "{\"packages\":[{\"name\":\"skia\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"MaskType\",\"sig\":\"enum MaskType { Alpha; Luminance }\"}," +
  "{\"kind\":\"fn\",\"name\":\"Mask::from_kind\",\"sig\":\"fn Mask::from_kind(base: Int, k: MaskType) -> Mask\"}]}]}"
  symtab_load_pionc_doc_json(st, doc)
  match st.fn_param_types.get("skia::Mask::from_kind") {
    Some(pts) => {
      assert_true(pts.length() == 2 && pts[0].1 == "Int", "Int param unchanged")
      assert_true(pts[1].1 == "skia::MaskType", "dependency enum param qualified")
    }
    None => assert_true(false, "skia::Mask::from_kind signature loaded")
  }
}

test "F3b-7: borrowed slice of a fresh hygienic temp is recognized, aliased receivers are not" {
  let fresh = lex_moonbit("let __mbt_sl_3 = mbt_compat::arr_map(xs, f); mbt_compat::__mbt_slice_borrow(__mbt_sl_3, 0, 1)")
  let mut site = -1
  let mut k = 0
  while k < fresh.length() {
    if fresh[k].raw == "mbt_compat" && k + 2 < fresh.length() && fresh[k + 2].raw == "__mbt_slice_borrow" { site = k }
    k = k + 1
  }
  assert_true(site > 0 && slice_temp_bound_fresh(fresh, site, "__mbt_sl_3"), "arr_map temp is fresh")
  let alias = lex_moonbit("let __mbt_sl_3 = self.items; mbt_compat::__mbt_slice_borrow(__mbt_sl_3, 0, 1)")
  let mut site2 = -1
  k = 0
  while k < alias.length() {
    if alias[k].raw == "mbt_compat" && k + 2 < alias.length() && alias[k + 2].raw == "__mbt_slice_borrow" { site2 = k }
    k = k + 1
  }
  assert_true(site2 > 0 && !slice_temp_bound_fresh(alias, site2, "__mbt_sl_3"), "field receiver is not fresh")
  assert_true(!slice_temp_bound_fresh(fresh, site, "xs"), "only hygienic slice temps qualify")
  let site_fresh = ProbeSite::{
    probe_id: "",
    file: "a.pion",
    probe_kind: "mbt_slice_borrow_probe",
    start_byte: 0,
    end_byte: 0,
    op_byte: 0,
    line: 1,
    col: 1,
    lhs_expr: "__mbt_sl_3",
    rhs_expr: "0",
    assign_op: fresh_slice_recv_tag(),
    slice_hi: "__mbt_sl_3.length()",
    divisor_is_zero: false,
    rhs_has_lit: false,
    rhs_is_neg: false,
    rhs_u64: 0UL,
    rhs_overflow: false,
  }
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  match rewrite_for_probe_hygienic(site_fresh, "Array[Int]", default_recipes(), Map(), Map(), diags, ledger) {
    Some(s) => assert_true(s == "mbt_compat::ArrayBuf::from_array(__mbt_sl_3).view(0, __mbt_sl_3.length())", "fresh borrow -> ArrayBuf view")
    None => assert_true(false, "fresh borrow rewritten")
  }
  assert_true(diags.length() == 0, "fresh borrow emits no blocker")
  let site_alias = ProbeSite::{ ..site_fresh, assign_op: "" }
  let diags2 : Array[Diag] = []
  let _ = rewrite_for_probe_hygienic(site_alias, "Array[Int]", default_recipes(), Map(), Map(), diags2, ledger)
  assert_true(diags2.length() == 1 && diags2[0].code == "MBT2PION_BORROWED_ARRAY_SLICE", "untagged borrow still fails closed")
}

test "F3b-7b: a bounded borrowed slice of a call result binds the receiver to a hygienic temp" {
  let src = "fn total(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    s = s + x\n  }\n  s\n}\n" +
  "pub fn mid(xs : Array[Int]) -> Int {\n  total(xs.map(fn(x) { x + 1 })[1:3].to_array())\n}\n" +
  "pub fn take(xs : Array[Int]) -> ArrayView[Int] {\n  xs.map(fn(x) { x * 2 })[1:3]\n}\n"
  let (_, out) = f3b_transpile("slices.mbt", src)
  assert_true(str_has(out, "mbt_compat::__mbt_slice_owned(xs.map("), "owned consumer keeps the inline receiver")
  assert_true(str_has(out, "({ let __mbt_sl_"), "borrowed bounded slice binds a temp")
  assert_true(str_has(out, "mbt_compat::__mbt_slice_borrow(__mbt_sl_"), "borrow placeholder reads the temp")
}

test "F3b-8: String.trim_end routes to mbt_compat::str_trim_end" {
  match lookup_missing_method_helper("String", "trim_end") {
    Some(h) => assert_true(h == "mbt_compat::str_trim_end", "trim_end helper")
    None => assert_true(false, "trim_end mapped")
  }
}

test "F3b-9a: borrowed-slice freshness never trusts a user-defined .copy() or the identity arr_to_array" {
  let fresh = fn(src : String) -> Bool {
    let toks = lex_moonbit(src)
    let n = if toks.length() > 0 && toks[toks.length() - 1].kind == TokenKind::Eof { toks.length() - 1 } else { toks.length() }
    is_proven_fresh_array_alloc(toks, 0, n)
  }
  assert_true(fresh("[1, 2]"), "array literal is fresh")
  assert_true(fresh("mbt_compat::arr_copy(xs)"), "mbt_compat::arr_copy is fresh")
  assert_true(fresh("mbt_compat::arr_map(xs, f)"), "arr_map is fresh")
  assert_true(!fresh("bag.copy()"), "user Bag::copy may return an alias")
  assert_true(!fresh("mbt_compat::arr_to_array(xs)"), "arr_to_array is the identity")
  assert_true(!fresh("mbt_compat::arr_copy(xs).foo"), "only a whole helper call counts")
  let toks = lex_moonbit("let __mbt_sl_1 = bag.copy(); mbt_compat::__mbt_slice_borrow(__mbt_sl_1, 0, 2)")
  let mut site = -1
  let mut k = 0
  while k < toks.length() {
    if toks[k].raw == "mbt_compat" && k + 2 < toks.length() && toks[k + 2].raw == "__mbt_slice_borrow" { site = k }
    k = k + 1
  }
  assert_true(site > 0 && !slice_temp_bound_fresh(toks, site, "__mbt_sl_1"), "temp bound to bag.copy() is not fresh")
}

test "F3b-9b: closure param inference fails closed on shadowing, field receivers and named arguments" {
  let scope_src = "fn use_wide(_w : Int64) -> Unit { () }\n" +
  "pub fn f() -> Int {\n" +
  "  let g = fn(k) { let neg = (k + 1) < 0; { let k = 1L; use_wide(k) }; if neg { 1 } else { 0 } }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, scope_out) = f3b_transpile("scope.mbt", scope_src)
  assert_true(str_has(scope_out, "let g = fn(k) {") && !str_has(scope_out, "k : Int64"), "inner `let k` shadowing: no inference")

  let field_src = "struct Decoy {\n  n : Int\n}\n" +
  "fn Decoy::touch(self : Decoy, _v : Int64) -> Int { self.n }\n" +
  "struct Inner {\n  n : Int\n}\n" +
  "fn Inner::touch(self : Inner, v : Int) -> Int { self.n + v }\n" +
  "struct Parent {\n  b : Inner\n}\n" +
  "pub fn f() -> Int {\n" +
  "  let a : Parent = { b: { n: 0 } }\n" +
  "  let b : Decoy = { n: 0 }\n" +
  "  let g = fn(k) { let neg = (k + 1) < 0; let _ = a.b.touch(k); if neg { 1 } else { 0 } }\n" +
  "  g(2147483647) + b.n\n" +
  "}\n"
  let (_, field_out) = f3b_transpile("field.mbt", field_src)
  assert_true(str_has(field_out, "let g = fn(k) {") && !str_has(field_out, "k : Int64"), "a.b.touch(k) never consults local `b`")

  let named_src = "fn[X] consume(_v : X, wide~ : Int64) -> Unit { ignore(wide) }\n" +
  "pub fn f() -> Int {\n" +
  "  let g = fn(k) { let neg = (k + 1) < 0; consume(wide=0L, k); if neg { 1 } else { 0 } }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, named_out) = f3b_transpile("named.mbt", named_src)
  assert_true(str_has(named_out, "let g = fn(k) {") && !str_has(named_out, "k : Int64"), "named argument call: no inference")

  let omitted_src = "fn tw(x : Int64, scale~ : Int = 2) -> Int64 { x * scale.to_int64() }\n" +
  "pub fn f() -> Int64 {\n" +
  "  let g = fn(v) { tw(v) }\n" +
  "  g(3L)\n" +
  "}\n"
  let (_, omitted_out) = f3b_transpile("omitted.mbt", omitted_src)
  assert_true(str_has(omitted_out, "let g = fn(v) {"), "omitted labeled parameter: positions not proven, no inference")

  let arm_src = "fn twice(x : Int) -> Int {\n  x * 2\n}\n" +
  "pub fn f(o : Int64?) -> Int {\n" +
  "  let g = fn(k) {\n    match o {\n      Some(k) => k.to_int()\n      None => twice(k)\n    }\n  }\n" +
  "  g(1)\n" +
  "}\n"
  let (_, arm_out) = f3b_transpile("arm.mbt", arm_src)
  assert_true(str_has(arm_out, "let g = fn(k) {"), "match-arm rebinding: no inference")

  let ok_src = "fn twice(x : Int) -> Int {\n  x * 2\n}\n" +
  "pub fn f() -> Int {\n  let g = fn(k) { let neg = (k + 1) < 0; if neg { 1 } else { twice(k) } }\n  g(1)\n}\n"
  let (_, ok_out) = f3b_transpile("ok.mbt", ok_src)
  assert_true(str_has(ok_out, "let g = fn(k : Int) {"), "a plain positional use still infers")
}

test "F3b-9c: closure inference uses sibling params over outer names and reads past `for .. in`" {
  let sib_src = "struct Decoy {\n  n : Int\n}\n" +
  "fn Decoy::touch(self : Decoy, _v : Int64) -> Int { self.n }\n" +
  "struct Child {\n  n : Int\n}\n" +
  "fn Child::touch(self : Child, v : Int) -> Int { self.n + v }\n" +
  "pub fn f() -> Int {\n" +
  "  let r : Decoy = { n: 0 }\n" +
  "  let g = fn(k, r : Child) { let neg = (k + 1) < 0; let _ = r.touch(k); if neg { 1 } else { 0 } }\n" +
  "  let h = fn(k, r) { let _ = r.touch(k); 0 }\n" +
  "  g(2147483647, { n: 0 }) + h(1, r) + r.n\n" +
  "}\n"
  let (_, sib_out) = f3b_transpile("sibling.mbt", sib_src)
  assert_true(str_has(sib_out, "let g = fn(k : Int, r : Child) {"), "annotated sibling param types the receiver")
  assert_true(str_has(sib_out, "let h = fn(k, r) {"), "unannotated sibling receiver: no inference, never the outer `r`")
  assert_true(!str_has(sib_out, "k : Int64"), "outer `r : Decoy` is never consulted")

  let callee_src = "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn f() -> Int {\n  let g = fn(k, wide : (Int) -> Int) { wide(k) }\n  g(1, fn(x) { x })\n}\n"
  let (_, callee_out) = f3b_transpile("callee.mbt", callee_src)
  assert_true(!str_has(callee_out, "k : Int64"), "a sibling param shadows the local fn `wide`")

  let loop_src = "fn items(k : Int) -> Array[Int] {\n  [k, k + 1, k + 3]\n}\n" +
  "pub fn f() -> Int {\n" +
  "  let g = fn(k) { let mut n = 0; for x in items(k) { n = n + x }; n }\n" +
  "  g(1)\n" +
  "}\n"
  let (_, loop_out) = f3b_transpile("loop_arg.mbt", loop_src)
  assert_true(str_has(loop_out, "let g = fn(k : Int) {"), "`for x in items(k)` is a use, not a binder")
  let bind_src = "fn items(k : Int) -> Array[Int] {\n  [k]\n}\n" +
  "pub fn f(xs : Array[Int]) -> Int {\n" +
  "  let g = fn(k) { let mut n = 0; for k in xs { n = n + k }; n + items(k).length() }\n" +
  "  g(1)\n" +
  "}\n"
  let (_, bind_out) = f3b_transpile("loop_bind.mbt", bind_src)
  assert_true(str_has(bind_out, "let g = fn(k) {"), "`for k in` still rebinds `k`")
}

test "F3b-9d: rebinding across lines (`let\\n k`, `let (\\n a,\\n k)`, multi-line arm heads) blocks inference" {
  let loop_let_src = "fn items(v : Int64) -> Array[Int64] { [v] }\n" +
  "pub fn f() -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    {\n" +
  "      let\n" +
  "        k = 1L\n" +
  "      for x in items(k) { ignore(x) }\n" +
  "    }\n" +
  "    if neg { 1 } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, ll_out) = f3b_transpile("loop_let.mbt", loop_let_src)
  assert_true(str_has(ll_out, "let g = fn(k) {") && !str_has(ll_out, "k : Int64"), "multi-line `let\\n k` rebinding: no inference")

  let tuple_src = "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn f(p : (Int, Int64)) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    let (\n" +
  "      a,\n" +
  "      k\n" +
  "    ) = p\n" +
  "    let _ = wide(k)\n" +
  "    if neg { a } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, tu_out) = f3b_transpile("tuple_let.mbt", tuple_src)
  assert_true(str_has(tu_out, "let g = fn(k) {") && !str_has(tu_out, "k : Int64"), "multi-line tuple `let` rebinding: no inference")

  let arm_src = "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn f(o : Int64?) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    match o {\n" +
  "      Some(\n" +
  "        k\n" +
  "      ) => wide(k)\n" +
  "      None => if neg { 1 } else { 0 }\n" +
  "    }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, arm_out) = f3b_transpile("arm_multiline.mbt", arm_src)
  assert_true(str_has(arm_out, "let g = fn(k) {") && !str_has(arm_out, "k : Int64"), "multi-line arm pattern rebinding: no inference")

  let use_src = "fn twice(x : Int) -> Int {\n  x * 2\n}\n" +
  "pub fn f(c : Int?) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let _ = if c is Some(_) {\n" +
  "      0\n" +
  "    } else {\n" +
  "      1\n" +
  "    }\n" +
  "    twice(\n" +
  "      k,\n" +
  "    )\n" +
  "  }\n" +
  "  g(1)\n" +
  "}\n"
  let (_, use_out) = f3b_transpile("use_multiline.mbt", use_src)
  assert_true(str_has(use_out, "let g = fn(k : Int) {"), "a multi-line plain use after a block still infers")
}

test "F3b-9e: struct / is / arm-pattern destructuring that rebinds the closure param blocks inference" {
  let let_src = "struct H {\n  k : Int64\n}\n" +
  "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn eval() -> Int {\n" +
  "  let h : H = { k: 1L }\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    let { k } = h\n" +
  "    let _ = wide(k)\n" +
  "    if neg { 1 } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, let_out) = f3b_transpile("struct_let.mbt", let_src)
  assert_true(str_has(let_out, "let g = fn(k) {") && !str_has(let_out, "fn(k : Int64"), "`let { k } = h` rebinding: no inference")

  let arm_src = "struct H {\n  k : Int64\n}\n" +
  "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn eval(o : H?, h : H) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    let a = match o {\n      Some({ k }) => wide(k)\n      None => 0\n    }\n" +
  "    let b = match h {\n      { k } if k > 0L => wide(k)\n      _ => 0\n    }\n" +
  "    if neg { a + b + 1 } else { a + b }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, arm_out) = f3b_transpile("struct_arm.mbt", arm_src)
  assert_true(str_has(arm_out, "let g = fn(k) {") && !str_has(arm_out, "fn(k : Int64"), "struct pattern arms rebinding: no inference")

  let is_src = "struct H {\n  k : Int64\n}\n" +
  "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn eval(o : H?) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    if o is Some({ k }) && wide(k) == 0 { if neg { 1 } else { 0 } } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, is_out) = f3b_transpile("struct_is.mbt", is_src)
  assert_true(str_has(is_out, "let g = fn(k) {") && !str_has(is_out, "fn(k : Int64"), "`is` struct pattern rebinding: no inference")

  let infinite_src = "fn twice(x : Int) -> Int {\n  x * 2\n}\n" +
  "pub fn f() -> Int {\n  let g = fn(k) {\n    for {\n      break\n    }\n    twice(k)\n  }\n  g(1)\n}\n"
  let (_, inf_out) = f3b_transpile("for_infinite.mbt", infinite_src)
  assert_true(str_has(inf_out, "let g = fn(k : Int) {"), "`for { .. }` binds nothing; a later plain use still infers")
}

test "F3b-9f: arm heads continued across lines by a guard or `|` still count as rebinding" {
  let guard_src = "struct H {\n  k : Int64\n}\n" +
  "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn eval(o : H?, cond : Bool) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    match o {\n" +
  "      Some({ k })\n" +
  "      if cond => { let _ = wide(k) }\n" +
  "      _ => ()\n" +
  "    }\n" +
  "    if neg { 1 } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, guard_out) = f3b_transpile("guard_multiline.mbt", guard_src)
  assert_true(str_has(guard_out, "let g = fn(k) {") && !str_has(guard_out, "fn(k : Int64"), "multi-line guard arm rebinding: no inference")

  let or_src = "struct H {\n  k : Int64\n}\n" +
  "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn eval(o : H?) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    match o {\n" +
  "      Some({ k }) |\n" +
  "      None => ()\n" +
  "    }\n" +
  "    let _ = wide(1L)\n" +
  "    if neg { 1 } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, or_out) = f3b_transpile("or_multiline.mbt", or_src)
  assert_true(str_has(or_out, "let g = fn(k) {") && !str_has(or_out, "fn(k : Int64"), "trailing `|` or-pattern rebinding: no inference")

  let lead_src = "struct H {\n  k : Int64\n}\n" +
  "pub fn eval(o : H?) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    match o {\n" +
  "      Some({ k })\n" +
  "      | None => ()\n" +
  "    }\n" +
  "    if neg { 1 } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, lead_out) = f3b_transpile("or_leading.mbt", lead_src)
  assert_true(str_has(lead_out, "let g = fn(k) {"), "leading `|` or-pattern rebinding: no inference")

  let ok_src = "fn twice(x : Int) -> Int {\n  x * 2\n}\n" +
  "pub fn f(o : Int?) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    match o {\n" +
  "      Some(_) => twice(k)\n" +
  "      None => 0\n" +
  "    }\n" +
  "  }\n" +
  "  g(1)\n" +
  "}\n"
  let (_, ok_out) = f3b_transpile("arm_use.mbt", ok_src)
  assert_true(str_has(ok_out, "let g = fn(k) {"), "conservative: a use in a previous arm body is scanned with the next arm head")

  let gx_src = "struct H {\n  k : Int64\n}\n" +
  "fn wide(_v : Int64) -> Int { 0 }\n" +
  "pub fn eval(o : H?) -> Int {\n" +
  "  let g = fn(k) {\n" +
  "    let neg = (k + 1) < 0\n" +
  "    match o {\n" +
  "      Some({ k }) if 1 >\n" +
  "        0 => { let _ = wide(k) }\n" +
  "      _ => ()\n" +
  "    }\n" +
  "    if neg { 1 } else { 0 }\n" +
  "  }\n" +
  "  g(2147483647)\n" +
  "}\n"
  let (_, gx_out) = f3b_transpile("guard_expr_multiline.mbt", gx_src)
  assert_true(str_has(gx_out, "let g = fn(k) {") && !str_has(gx_out, "fn(k : Int64"), "guard expression across lines: no inference")
}

test "F3b-10: .to_string() / interpolation on Float, Bytes and Byte use MoonBit formatters" {
  let mk = fn(ty : String, interp : Bool) -> Option[String] {
    let site = ProbeSite::{
      probe_id: "",
      file: "a.pion",
      probe_kind: "mbt_show_probe",
      start_byte: 0,
      end_byte: 0,
      op_byte: 0,
      line: 1,
      col: 1,
      lhs_expr: "x",
      rhs_expr: if interp { "__INTERP_SHOW__" } else { "" },
      assign_op: "",
      slice_hi: "",
      divisor_is_zero: false,
      rhs_has_lit: false,
      rhs_is_neg: false,
      rhs_u64: 0UL,
      rhs_overflow: false,
    }
    let diags : Array[Diag] = []
    let ledger : Array[DriftEntry] = []
    rewrite_for_probe_hygienic(site, ty, default_recipes(), Map(), Map(), diags, ledger)
  }
  assert_true(mk("Float", false) == Some("mbt_compat::float_to_string(x)"), "Float .to_string()")
  assert_true(mk("Float", true) == Some("mbt_compat::float_to_string(x)"), "Float interpolation")
  assert_true(mk("Bytes", false) == Some("mbt_compat::bytes_to_string(x)"), "Bytes .to_string()")
  assert_true(mk("Byte", true) == Some("mbt_compat::byte_to_string(x)"), "Byte interpolation")
  assert_true(mk("Double", false) == Some("mbt_compat::double_to_string(x)"), "Double unchanged")
  assert_true(mk("Int", false) is None, "Int keeps native to_string")
  assert_true(mk("String", true) is None, "String keeps native to_string")
}

test "F3b-11: every interpolation hole is show-probed; compound holes are parenthesized; `$|` lines too" {
  let code = "pub fn f(x : Float, g : () -> Float) -> String {\n" +
  "  let a = \"\\{x}|\\{x + x}|\\{g()}|\\{-x}|\\{mbt_compat::float_to_string(x)}|\\{x.to_string()}\"\n" +
  "  let b =\n    $|m=\\{x + x}\n" +
  "  a + b\n" +
  "}\n"
  let (inst, sites) = instrument_probes_for_file("i.pion", code)
  assert_true(str_has(inst, "\\{x.mbt_show_probe()}"), "plain path probed as before")
  assert_true(str_has(inst, "\\{(x + x).mbt_show_probe()}"), "compound expression parenthesized")
  assert_true(str_has(inst, "\\{(g()).mbt_show_probe()}"), "call probed")
  assert_true(str_has(inst, "\\{(-x).mbt_show_probe()}"), "negation probed")
  assert_true(str_has(inst, "\\{mbt_compat::float_to_string(x)}"), "already-lowered formatter hole untouched")
  assert_true(str_has(inst, "$|m=\\{(x + x).mbt_show_probe()}"), "multiline interpolation hole probed")
  let mut show_sites = 0
  for s in sites {
    if s.probe_kind == "mbt_show_probe" && s.rhs_expr == "__INTERP_SHOW__" { show_sites = show_sites + 1 }
  }
  assert_true(show_sites == 5, "five interpolation show probes (plain, compound, call, negation, multiline)")
}
