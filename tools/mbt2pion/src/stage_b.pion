                  let open_hdr = if comma_idx >= 0 {
                    let k_v = vars_str.slice(0, comma_idx).trim()
                    let v_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    prefix + "{ let " + it_var + " = " + iter_expr + "; while true { match (" + it_var + ".next)() { Some((" + k_v + ", " + v_v + ")) => { "
                  } else {
                    prefix + "{ let " + it_var + " = " + iter_expr + "; while true { match (" + it_var + ".next)() { Some(" + vars_str + ") => { "
                  }
                  let close_tail = " }, None => break } } }"
                  if close_l == lidx {
                    let body_part = ln.slice(lb_idx + 2, close_c)
                    let after_part = ln.slice(close_c + 1, ln.length())
                    lines[lidx] = open_hdr + body_part + close_tail + after_part
                  } else {
                    let first_rest = ln.slice(lb_idx + 2, ln.length())
                    lines[lidx] = open_hdr + first_rest
                    let cln = lines[close_l]
                    lines[close_l] = cln.slice(0, close_c) + close_tail + cln.slice(close_c + 1, cln.length())
                  }
                  mutated_lines[close_l] = true
                  file_changed = true
                  line_mutated = true
                } else if close_l >= 0 && (d.found.starts_with("MbtIter[") || d.found.starts_with("mbt_compat::MbtIter[")) {
                  let used_idents = get_used_idents()
                  let it_var = fresh_stage_b_ident(used_idents, "__mbt_it_" + tag)
                  let ii_var = fresh_stage_b_ident(used_idents, "__mbt_ii_" + tag)
                  let open_hdr = if comma_idx >= 0 {
                    let idx_v = vars_str.slice(0, comma_idx).trim()
                    let el_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    prefix + "{ let " + it_var + " = " + iter_expr + "; let mut " + ii_var + " = 0; while true { match (" + it_var + ".next)() { Some(" + el_v + ") => { let " + idx_v + " = " + ii_var + "; " + ii_var + " = " + ii_var + " + 1; "
                  } else {
                    prefix + "{ let " + it_var + " = " + iter_expr + "; while true { match (" + it_var + ".next)() { Some(" + vars_str + ") => { "
                  }
                  let close_tail = " }, None => break } } }"
                  if close_l == lidx {
                    let body_part = ln.slice(lb_idx + 2, close_c)
                    let after_part = ln.slice(close_c + 1, ln.length())
                    lines[lidx] = open_hdr + body_part + close_tail + after_part
                  } else {
                    let first_rest = ln.slice(lb_idx + 2, ln.length())
                    lines[lidx] = open_hdr + first_rest
                    let cln = lines[close_l]
                    lines[close_l] = cln.slice(0, close_c) + close_tail + cln.slice(close_c + 1, cln.length())
                  }
                  mutated_lines[close_l] = true
                  file_changed = true
                  line_mutated = true
                } else if close_l >= 0 {
                  let found_base = strip_type_args_sym(d.found)
                  let mut has_custom_iter = false
                  let need_iter2 = comma_idx >= 0
                  if found_base.length() > 0 {
                    if str_has(found_base, "::") {
                      has_custom_iter = if need_iter2 {
                        dep_methods.contains(" iter2_type:" + found_base)
                      } else {
                        dep_methods.contains(" iter_type:" + found_base)
                      }
                    } else {
                      let m_nm = if need_iter2 { "iter2" } else { "iter" }
                      let needle_p = "fn " + found_base + "::" + m_nm + "("
                      let needle_g = "fn " + found_base + "::" + m_nm + "["
                      for cf in cur_files {
                        let cf_lines = cf.content.split("\n")
                        for cfl in cf_lines {
                          let tr = cfl.trim()
                          if !tr.starts_with("//") && (str_has(tr, needle_p) || str_has(tr, needle_g)) && str_has(tr, "->") {
                            let arr_i = tr.index_of("->")
                            let ret_part = tr.slice(arr_i + 2, tr.length()).trim()
                            let ret_ok = if need_iter2 {
                              str_has(ret_part, "MbtIter2[") || str_has(ret_part, "Iter2[")
                            } else {
                              str_has(ret_part, "MbtIter[") || str_has(ret_part, "Iter[")
                            }
                            if ret_ok {
                              has_custom_iter = true
                              break
                            }
                          }
                        }
                        if has_custom_iter {
                          break
                        }
                      }
                    }
                  }
                  if has_custom_iter {
                    let used_idents = get_used_idents()
                    let sit_var = fresh_stage_b_ident(used_idents, if need_iter2 { "__mbt_cit2_" + tag } else { "__mbt_cit_" + tag })
                    let open_hdr = if need_iter2 {
                      let k_v = vars_str.slice(0, comma_idx).trim()
                      let v_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                      prefix + "{ let " + sit_var + " = (" + iter_expr + ").iter2(); while true { match (" + sit_var + ".next)() { Some((" + k_v + ", " + v_v + ")) => { "
                    } else {
                      prefix + "{ let " + sit_var + " = (" + iter_expr + ").iter(); while true { match (" + sit_var + ".next)() { Some(" + vars_str + ") => { "
                    }
                    let close_tail = " }, None => break } } }"
                    if close_l == lidx {
                      let body_part = ln.slice(lb_idx + 2, close_c)
                      let after_part = ln.slice(close_c + 1, ln.length())
                      lines[lidx] = open_hdr + body_part + close_tail + after_part
                    } else {
                      let first_rest = ln.slice(lb_idx + 2, ln.length())
                      lines[lidx] = open_hdr + first_rest
                      let cln = lines[close_l]
                      lines[close_l] = cln.slice(0, close_c) + close_tail + cln.slice(close_c + 1, cln.length())
                    }
                    mutated_lines[close_l] = true
                    file_changed = true
                    line_mutated = true
                  }
                }
              }
            }
          }
          // 4. `operator '+' is not supported on 'Array[...]'` -> left-associative `mbt_compat::arr_concat(...)`
          //    (handles chained & multiline trailing `+` with comments, block/paren operands, and `for x in a + b`)
          //    and `operator '==' / '!=' is not supported on '<T>'` (Bytes, MbtJson, OrderedSet, Tuple, Option, Array)
          if !line_mutated && (str_has(d.message, "operator `+` is not supported on `Array[") ||
            str_has(d.message, "operator `==` is not supported on `") ||
            str_has(d.message, "operator `!=` is not supported on `")) {
            let cur_ln = lines[lidx]
            let is_arr_add = str_has(d.message, "operator `+`")
            let is_neq = str_has(d.message, "operator `!=`")
            let op_str = if is_arr_add { "+" } else if is_neq { "!=" } else { "==" }
            let on_idx = d.message.index_of("not supported on `")
            let eq_ty = if on_idx >= 0 {
              let r = d.message.slice(on_idx + 18, d.message.length())
              let bt = r.index_of("`")
              if bt > 0 { r.slice(0, bt) } else { "" }
            } else {
              ""
            }
            let custom_eq_fn = "__mbt_eq_" + ascii_to_lower(eq_ty)
            let has_custom_eq_fn = eq_ty.length() > 0 && !str_has(eq_ty, "[") && !str_has(eq_ty, "(") &&
            !str_has(eq_ty, ":") && str_has(f.content, "fn " + custom_eq_fn + "(")
            // Check if `eq_ty` is a generic type parameter constrained by `mbt_compat::MapKey` in the enclosing `fn`
            let mut is_mapkey_tparam = false
            if !has_custom_eq_fn && eq_ty.length() > 0 && !str_has(eq_ty, "[") && !str_has(eq_ty, "(") && !str_has(eq_ty, ":") {
              let mut scan_l = lidx
              while scan_l >= 0 {
                let sl = lines[scan_l].trim()
                if sl.starts_with("pub fn ") || sl.starts_with("fn ") {
                  if str_has(sl, eq_ty + " :") && str_has(sl, "mbt_compat::MapKey") {
                    is_mapkey_tparam = true
                  }
                  break
                }
                scan_l = scan_l - 1
              }
            }
            let can_structural_eq = has_custom_eq_fn || is_mapkey_tparam || eq_ty == "Bytes" ||
            eq_ty == "MbtJson" || eq_ty == "mbt_compat::MbtJson" ||
            eq_ty.starts_with("OrderedSet[") || eq_ty.starts_with("mbt_compat::OrderedSet[") ||
            (eq_ty.starts_with("(") && eq_ty.ends_with(")")) ||
            (eq_ty.starts_with("Option[") && eq_ty.ends_with("]")) ||
            ((eq_ty.starts_with("Array[") || eq_ty.starts_with("FixedArray[")) && eq_ty.ends_with("]"))
            if is_arr_add {
              // Gather multi-line continuation chunk both backward (for multiline LHS like `[...,\n ...] + rhs`)
              // and forward (for multiline RHS like `lhs +\n (if ... { ... })`), bounded and fail-closed.
              let first_toks = lex_moonbit(lines[lidx])
              let fn0 = first_toks.length() - 1
              let mut first_op_i = -1
              let mut first_best = 1000000
              let mut fi0 = 0
              while fi0 < fn0 {
                if first_toks[fi0].kind == TokenKind::Plus {
                  let dist = if first_toks[fi0].col >= d.col { first_toks[fi0].col - d.col } else { d.col - first_toks[fi0].col }
                  if dist < first_best { first_best = dist; first_op_i = fi0 }
                }
                fi0 = fi0 + 1
              }
              let mut start_l = lidx
              if first_op_i >= 0 {
                let mut need_open = 0
                let mut bi = first_op_i - 1
                while bi >= 0 {
                  let bk = first_toks[bi].kind
                  if bk == TokenKind::RParen || bk == TokenKind::RBracket || bk == TokenKind::RBrace {
                    need_open = need_open + 1
                  } else if bk == TokenKind::LParen || bk == TokenKind::LBracket || bk == TokenKind::LBrace {
                    if need_open == 0 { break }
                    need_open = need_open - 1
                  }
                  bi = bi - 1
                }
                let mut need_lhs = first_op_i == 0 ||
                (first_op_i > 0 && (first_toks[0].kind == TokenKind::Plus || first_toks[0].kind == TokenKind::Dot || first_toks[0].kind == TokenKind::PipeGt))
                while ((need_open > 0 && lidx - start_l < 512) || (need_lhs && lidx - start_l < 32)) && start_l > 0 && !mutated_lines.contains(start_l - 1) {
                  start_l = start_l - 1
                  let pt = lex_moonbit(lines[start_l])
                  let p_len = pt.length() - 1
                  if p_len > 0 {
                    let p0 = pt[0].kind
                    need_lhs = p0 == TokenKind::Plus || p0 == TokenKind::Dot || p0 == TokenKind::PipeGt
                  }
                  let mut pi = p_len - 1
                  while pi >= 0 {
                    let pk = pt[pi].kind
                    if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
                      need_open = need_open + 1
                    } else if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
                      if need_open == 0 { break }
                      need_open = need_open - 1
                      if need_open == 0 && !need_lhs {
                        // Stop once the opening delimiter matching the LHS on `lidx` is found,
                        // unless immediately preceded on the same line by a `+`/`.`/`::` continuation.
                        if pi == 0 || (pt[pi - 1].kind != TokenKind::Plus && pt[pi - 1].kind != TokenKind::Dot && pt[pi - 1].kind != TokenKind::ColonColon) {
                          break
                        }
                      }
                    }
                    pi = pi - 1
                  }
                }
              }
              let mut end_l = lidx
              let mut pb_depth = 0
              let mut last_tok_plus = false
              let mut fi1 = if first_op_i >= 0 { first_op_i + 1 } else { 0 }
              while fi1 < fn0 {
                let fk = first_toks[fi1].kind
                if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { pb_depth = pb_depth + 1 }
                else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { if pb_depth > 0 { pb_depth = pb_depth - 1 } }
                fi1 = fi1 + 1
              }
              if fn0 > 0 {
                last_tok_plus = first_toks[fn0 - 1].kind == TokenKind::Plus
              }
              while end_l + 1 < lines.length() && end_l - lidx < 512 && !mutated_lines.contains(end_l + 1) {
                let next_trimmed = lines[end_l + 1].trim()
                let next_starts_plus = next_trimmed.starts_with("+") && !next_trimmed.starts_with("+=")
                if pb_depth > 0 || last_tok_plus || next_starts_plus {
                  end_l = end_l + 1
                  let nt = lex_moonbit(lines[end_l])
                  let nn = nt.length() - 1
                  let mut ni = 0
                  while ni < nn {
                    let nk = nt[ni].kind
                    if nk == TokenKind::LParen || nk == TokenKind::LBracket || nk == TokenKind::LBrace { pb_depth = pb_depth + 1 }
                    else if nk == TokenKind::RParen || nk == TokenKind::RBracket || nk == TokenKind::RBrace { if pb_depth > 0 { pb_depth = pb_depth - 1 } }
                    ni = ni + 1
                  }
                  if nn > 0 {
                    last_tok_plus = nt[nn - 1].kind == TokenKind::Plus
                  }
                } else {
                  break
                }
              }
              let chunk_sb = StringBuilder()
              let mut ci = start_l
              let mut any_mutated = false
              while ci <= end_l {
                if mutated_lines.contains(ci) { any_mutated = true }
                if ci > start_l { chunk_sb.write_string("\n") }
                chunk_sb.write_string(lines[ci])
                ci = ci + 1
              }
              let chunk = chunk_sb.to_string()
              let toks = lex_moonbit(chunk)
              let tn = toks.length() - 1
              let target_line = lidx - start_l + 1
              let mut op_i = -1
              let mut best_dist = 1000000
              let mut ti = 0
              while ti < tn {
                if toks[ti].line == target_line && toks[ti].kind == TokenKind::Plus {
                  let dist = if toks[ti].col >= d.col { toks[ti].col - d.col } else { d.col - toks[ti].col }
                  if dist < best_dist { best_dist = dist; op_i = ti }
                }
                ti = ti + 1
              }
              if !any_mutated && op_i > 0 && op_i + 1 < tn {
                // Scan backward to start of entire contiguous `+` chain
                let mut ls = op_i - 1
                let mut ld = 0
                while ls >= 0 {
                  if ld == 0 && ls + 1 < op_i && toks[ls + 1].newline_before {
                    let nk = toks[ls + 1].kind
                    let ck = toks[ls].kind
                    if ck != TokenKind::Plus && ck != TokenKind::Dot && ck != TokenKind::ColonColon &&
                    nk != TokenKind::Plus && nk != TokenKind::Dot && nk != TokenKind::PipeGt {
                      ls = ls + 1
                      break
                    }
                  }
                  let lk = toks[ls].kind
                  if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { ld = ld + 1 }
                  else if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace {
                    if ld == 0 { ls = ls + 1; break }
                    ld = ld - 1
                  } else if ld == 0 && (lk == TokenKind::Eq || lk == TokenKind::Comma || lk == TokenKind::Semi ||
                    lk == TokenKind::Colon || lk == TokenKind::AmpAmp || lk == TokenKind::PipePipe || lk == TokenKind::PipeGt || lk == TokenKind::FatArrow ||
                    lk == TokenKind::EqEq || lk == TokenKind::BangEq || lk == TokenKind::Lt || lk == TokenKind::LtEq || lk == TokenKind::Gt || lk == TokenKind::GtEq ||
                    (lk == TokenKind::Keyword && (toks[ls].raw == "if" || toks[ls].raw == "else" || toks[ls].raw == "return" || toks[ls].raw == "while" || toks[ls].raw == "in" || toks[ls].raw == "match" || toks[ls].raw == "let"))) {
                    ls = ls + 1
                    break
                  }
                  ls = ls - 1
                }
                if ls < 0 { ls = 0 }
                // Scan forward across all contiguous top-level `+` operands
                let plus_positions : Array[Int] = []
                let mut re = ls
                let mut rd = 0
                let mut expect_operand = true
                while re < tn {
                  let rk = toks[re].kind
                  let is_dot_cont = rk == TokenKind::Dot && re + 1 < tn &&
                  (toks[re + 1].kind == TokenKind::Ident || toks[re + 1].kind == TokenKind::IntLit)
                  if rd == 0 && re > ls && toks[re].newline_before && !expect_operand && rk != TokenKind::Plus && !is_dot_cont {
                    break
                  }
                  if rd == 0 && (rk == TokenKind::Comma || rk == TokenKind::Semi ||
                    rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::PipeGt || rk == TokenKind::FatArrow ||
                    rk == TokenKind::EqEq || rk == TokenKind::BangEq || rk == TokenKind::Lt || rk == TokenKind::LtEq || rk == TokenKind::Gt || rk == TokenKind::GtEq ||
                    (rk == TokenKind::Keyword && toks[re].raw == "else")) {
                    break
                  }
                  if rd == 0 && rk == TokenKind::LBrace && !expect_operand && !(re > ls && toks[re - 1].kind == TokenKind::ColonColon) {
                    // Loop/match body `{ ... }` after `for x in a + b`
                    break
                  }
                  if rd == 0 && rk == TokenKind::Plus {
                    plus_positions.push(re)
                    expect_operand = true
                    re = re + 1
                    continue
                  }
                  if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
                    rd = rd + 1
                    expect_operand = false
                  } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                    if rd == 0 { break }
                    rd = rd - 1
                    expect_operand = false
                  } else {
                    expect_operand = false
                  }
                  re = re + 1
                }
                let ls_kind = toks[ls].kind
                let ls_valid = ls_kind != TokenKind::Plus && ls_kind != TokenKind::Dot && ls_kind != TokenKind::PipeGt
                if ld == 0 && rd == 0 && ls_valid && plus_positions.length() >= 1 && plus_positions[0] > ls && re > plus_positions[plus_positions.length() - 1] + 1 {
                  let operands : Array[String] = []
                  let mut seg_s = ls
                  for pp in plus_positions {
                    if pp > seg_s {
                      operands.push(chunk.slice(toks[seg_s].start_byte, toks[pp - 1].end_byte).trim())
                    }
                    seg_s = pp + 1
                  }
                  if re > seg_s {
                    operands.push(chunk.slice(toks[seg_s].start_byte, toks[re - 1].end_byte).trim())
                  }
                  if operands.length() == plus_positions.length() + 1 && operands.length() >= 2 {
                    let mut folded = "mbt_compat::arr_concat(" + operands[0] + ", " + operands[1] + ")"
                    let mut oi = 2
                    while oi < operands.length() {
                      folded = "mbt_compat::arr_concat(" + folded + ", " + operands[oi] + ")"
                      oi = oi + 1
                    }
                    let new_chunk = chunk.slice(0, toks[ls].start_byte) + folded + chunk.slice(toks[re - 1].end_byte, chunk.length())
                    lines[start_l] = new_chunk
                    mutated_lines[start_l] = true
                    let mut cl = start_l + 1
                    while cl <= end_l {
                      lines[cl] = ""
                      mutated_lines[cl] = true
                      cl = cl + 1
                    }
                    file_changed = true
                    line_mutated = true
                  }
                }
              }
            } else if can_structural_eq && !str_has(eq_ty, "<error>") {
              let toks = lex_moonbit(cur_ln)
              let mut op_i = -1
              let mut best_dist = 1000000
              let mut ti = 0
              while ti < toks.length() - 1 {
                if toks[ti].raw == op_str {
                  let dist = if toks[ti].col >= d.col { toks[ti].col - d.col } else { d.col - toks[ti].col }
                  if dist < best_dist { best_dist = dist; op_i = ti }
                }
                ti = ti + 1
              }
              if op_i > 0 && op_i + 1 < toks.length() - 1 {
                let mut ls = op_i - 1
                let mut ld = 0
                while ls >= 0 {
                  let lk = toks[ls].kind
                  if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { ld = ld + 1 }
                  else if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace {
                    if ld == 0 { ls = ls + 1; break }
                    ld = ld - 1
                  } else if ld == 0 && (lk == TokenKind::Eq || lk == TokenKind::Comma || lk == TokenKind::Semi ||
                    lk == TokenKind::Colon || lk == TokenKind::AmpAmp || lk == TokenKind::PipePipe || lk == TokenKind::FatArrow ||
                    (lk == TokenKind::Keyword && (toks[ls].raw == "if" || toks[ls].raw == "else" || toks[ls].raw == "return" || toks[ls].raw == "while" || toks[ls].raw == "in" || toks[ls].raw == "match" || toks[ls].raw == "let"))) {
                    ls = ls + 1
                    break
                  }
                  ls = ls - 1
                }
                if ls < 0 { ls = 0 }
                let mut re = op_i + 1
                let mut rd = 0
                while re < toks.length() - 1 {
                  let rk = toks[re].kind
                  if rd == 0 && (rk == TokenKind::Comma || rk == TokenKind::Semi ||
                    rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::FatArrow ||
                    rk == TokenKind::LBrace ||
                    (rk == TokenKind::Keyword && toks[re].raw == "else")) {
                    break
                  } else if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
                  else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                    if rd == 0 { break }
                    rd = rd - 1
                  }
                  re = re + 1
                }
                if ls < op_i && re > op_i + 1 {
                  let lhs_s = cur_ln.slice(toks[ls].start_byte, toks[op_i - 1].end_byte).trim()
                  let rhs_s = cur_ln.slice(toks[op_i + 1].start_byte, toks[re - 1].end_byte).trim()
                  let repl = if has_custom_eq_fn {
                    (if is_neq { "!" } else { "" }) + custom_eq_fn + "(" + lhs_s + ", " + rhs_s + ")"
                  } else if is_mapkey_tparam {
                    (if is_neq { "!" } else { "" }) + "(" + lhs_s + ").key_eq(" + rhs_s + ")"
                  } else if eq_ty == "Bytes" {
                    (if is_neq { "!mbt_compat::bytes_eq(" } else { "mbt_compat::bytes_eq(" }) + lhs_s + ", " + rhs_s + ")"
                  } else if eq_ty == "MbtJson" || eq_ty == "mbt_compat::MbtJson" {
                    (if is_neq { "!mbt_compat::mbt_json_eq(" } else { "mbt_compat::mbt_json_eq(" }) + lhs_s + ", " + rhs_s + ")"
                  } else if eq_ty.starts_with("OrderedSet[") || eq_ty.starts_with("mbt_compat::OrderedSet[") {
                    (if is_neq { "!mbt_compat::ordered_set_eq(" } else { "mbt_compat::ordered_set_eq(" }) + lhs_s + ", " + rhs_s + ")"
                  } else {
                    let used_idents = get_used_idents()
                    let la = fresh_stage_b_ident(used_idents, "__eq_l_" + lidx.to_string())
                    let rb = fresh_stage_b_ident(used_idents, "__eq_r_" + lidx.to_string())
                    let body = gen_eq_expr_hygienic(la, rb, eq_ty, used_idents)
                    let final_b = if is_neq { "!(" + body + ")" } else { body }
                    "{ let " + la + " : " + eq_ty + " = " + lhs_s + "; let " + rb + " : " + eq_ty + " = " + rhs_s + "; " + final_b + " }"
                  }
                  lines[lidx] = cur_ln.slice(0, toks[ls].start_byte) + repl + cur_ln.slice(toks[re - 1].end_byte, cur_ln.length())
                  file_changed = true
                  line_mutated = true
                }
              }
            }
          }
          // 4b. Custom operator trait lowering (`+`, `-`, `*`, `/`) + fail-closed compound assignment (`+=`, `-=`, `*=`, `/=`) (§D1-3)
          if !line_mutated && str_has(d.message, "operator `") &&
          (str_has(d.message, " is not supported on `") || str_has(d.message, " is not supported for type `")) {
            let op_start = d.message.index_of("operator `") + 10
            let op_rest = d.message.slice(op_start, d.message.length())
            let op_end = op_rest.index_of("`")
            let on_idx1 = d.message.index_of("not supported on `")
            let on_idx2 = d.message.index_of("not supported for type `")
            let ty_start = if on_idx1 >= 0 {
              on_idx1 + 18
            } else if on_idx2 >= 0 {
              on_idx2 + 24
            } else {
              -1
            }
            if op_end > 0 && ty_start >= 0 {
              let raw_op = op_rest.slice(0, op_end)
              let ty_rest = d.message.slice(ty_start, d.message.length())
              let ty_end = ty_rest.index_of("`")
              if ty_end > 0 {
                let op_ty = ty_rest.slice(0, ty_end)
                let cur_ln = lines[lidx]
                // Check for compound assignment (`+=`, `-=`, `*=`, `/=`) on this line near `d.col` FIRST (Opus P2-2 fail-closed!)
                let mut is_compound = raw_op == "+=" || raw_op == "-=" || raw_op == "*=" || raw_op == "/="
                let mut compound_sym = raw_op
                if !is_compound && (raw_op == "+" || raw_op == "-" || raw_op == "*" || raw_op == "/") {
                  let ctoks = lex_moonbit(cur_ln)
                  let target_assign = raw_op + "="
                  let mut has_assign = false
                  let mut has_exact_bin = false
                  let mut ci = 0
                  while ci < ctoks.length() - 1 {
                    if ctoks[ci].kind == TokenKind::AssignOp && ctoks[ci].raw == target_assign {
                      has_assign = true
                    } else if ctoks[ci].raw == raw_op {
                      let dist = if ctoks[ci].col >= d.col { ctoks[ci].col - d.col } else { d.col - ctoks[ci].col }
                      if dist <= 2 {
                        has_exact_bin = true
                      }
                    }
                    ci = ci + 1
                  }
                  if has_assign && !has_exact_bin {
                    is_compound = true
                    compound_sym = target_assign
                  }
                }
                let op_name = if is_compound && compound_sym.length() >= 2 {
                  op_symbol_to_name(compound_sym.slice(0, 1))
                } else {
                  op_symbol_to_name(raw_op)
                }
                if is_compound && op_name.length() > 0 && op_lookup.contains(op_ty + "|" + op_name) {
                  let mut dup = false
                  for existing in diags {
                    if existing.code == "MBT2PION_UNSUPPORTED_SYNTAX" && existing.file == f.rel_path && existing.line == d.line {
                      dup = true
                      break
                    }
                  }
                  if !dup {
                    diags.push(diag_error(
                      "MBT2PION_UNSUPPORTED_SYNTAX",
                      f.rel_path,
                      d.line,
                      d.col,
                      "compound assignment `" + compound_sym + "` on custom operator-overloaded type `" + op_ty + "` is not supported (fail-closed)",
                    ))
                  }
                } else if !is_compound && op_name.length() > 0 {
                  match op_lookup.get(op_ty + "|" + op_name) {
                    Some(helper_fn) =>
                    if rewrite_custom_binop_at(lines, lidx, d.col, raw_op, helper_fn, mutated_lines) {
                      file_changed = true
                      line_mutated = true
                    }
                    None => ()
                  }
                }
              }
            }
          }
          // 5. `string interpolation does not support type '<T>'` -> `\{(<expr>).to_string()}`
          if !line_mutated && str_has(d.message, "string interpolation does not support type `") {
            let cur_ln = lines[lidx]
            let target_0 = if d.col > 0 { d.col - 1 } else { 0 }
            let mut best = -1
            let mut best_end = -1
            let mut best_dist = 1000000
            let mut pos = 0
            while pos + 2 < cur_ln.length() {
              if cur_ln.code_unit_at(pos) == 92 && cur_ln.code_unit_at(pos + 1) == 123 {
                let mut j = pos + 2
                let mut d2 = 1
                while j < cur_ln.length() && d2 > 0 {
                  let ch = cur_ln.code_unit_at(j)
                  if ch == 123 { d2 = d2 + 1 }
                  else if ch == 125 { d2 = d2 - 1; if d2 == 0 { break } }
                  j = j + 1
                }
                if d2 == 0 {
                  let inner = cur_ln.slice(pos + 2, j).trim()
                  if !inner.ends_with(".to_string()") {
                    let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
                    if dist < best_dist { best_dist = dist; best = pos; best_end = j }
                  }
                }
              }
              pos = pos + 1
            }
            if best >= 0 && best_end > best + 2 {
              let inner = cur_ln.slice(best + 2, best_end).trim()
              lines[lidx] = cur_ln.slice(0, best + 2) + "(" + inner + ").to_string()" + cur_ln.slice(best_end, cur_ln.length())
              file_changed = true
              line_mutated = true
            }
          }
        }
        if line_mutated {
          mutated_lines[lidx] = true
        }
      }
      // Apply batched non-overlapping single-line interpolation hole edits in reverse byte order.
      if line_interp_edits.length() > 0 {
        let rw_idx = get_method_rw_idx()
        for elidx in line_interp_edits.keys() {
          if !mutated_lines.contains(elidx) {
            match line_interp_edits.get(elidx) {
              Some(eds) =>
              if eds.length() > 0 {
                // Sort descending by `abs_s` (insertion sort)
                let sorted : Array[(Int, Int, String)] = []
                for ed in eds {
                  sorted.push(ed)
                }
                let mut si = 1
                while si < sorted.length() {
                  let cur = sorted[si]
                  let mut sj = si - 1
                  while sj >= 0 && sorted[sj].0 < cur.0 {
                    sorted[sj + 1] = sorted[sj]
                    sj = sj - 1
                  }
                  sorted[sj + 1] = cur
                  si = si + 1
                }
                let lstart = rw_idx.line_starts[elidx]
                let mut cur_line = lines[elidx]
                for ed in sorted {
                  let rel_s = ed.0 - lstart
                  let rel_e = ed.1 - lstart
                  if rel_s >= 0 && rel_e >= rel_s && rel_e <= cur_line.length() {
                    cur_line = cur_line.slice(0, rel_s) + ed.2 + cur_line.slice(rel_e, cur_line.length())
                    file_changed = true
                  }
                }
                lines[elidx] = cur_line
              }
              None => ()
            }
          }
        }
      }
      if file_changed {
        changed = true
        changed_rels.push(f.rel_path)
        let sb = StringBuilder()
        let mut li = 0
        while li < lines.length() {
          if li > 0 {
            sb.write_string("\n")
          }
          sb.write_string(lines[li])
          li = li + 1
        }
        next_files.push(GeneratedFile::{
          rel_path: f.rel_path,
          content: sb.to_string(),
          source_file: f.source_file,
          anchors: f.anchors,
        })
      } else {
        next_files.push(f)
      }
    }
    if pending_bound_relax_reqs.length() > 0 {
      let pkg_fns = match round_pkg_fns {
        Some(m) => m
        None => {
          stage_b_perf_stats[3] = stage_b_perf_stats[3] + 1
          let _ = get_all_round_tokens()
          let m = collect_stage_b_pkg_fns_cached(cur_files, round_file_tokens)
          round_pkg_fns = Some(m)
          m
        }
      }
      let (relaxed_files, relaxed_rels) = relax_redundant_fn_tuple_bounds(next_files, pkg_fns, pending_bound_relax_reqs)
      if relaxed_rels.length() > 0 {
        cur_files = relaxed_files
        changed = true
        for rr in relaxed_rels {
          changed_rels.push(rr)
        }
      } else {
        cur_files = next_files
      }
    } else {
      cur_files = next_files
    }
    let changed_rel_set : Map[String, Bool] = Map()
    for rel in changed_rels {
      changed_rel_set[rel] = true
      let prev_ver = match file_vers.get(rel) {
        Some(v) => v
        None => 0
      }
      file_vers[rel] = prev_ver + 1
    }
    qt_used_prev_round = qt_used_this_round
    prev_round_changed_cap_file = false
    if changed {
      qt_snap_dirty = true
      need_qt_for_capacity = false
      for cf in cur_files {
        if file_has_capacity_marker(cf.content) {
          need_qt_for_capacity = true
          if changed_rel_set.contains(cf.rel_path) {
            prev_round_changed_cap_file = true
          }
        }
      }
    } else {
      break
    }
  }

  let out_qt = if qt_snap.ok && !qt_snap_dirty { qt_snap } else { empty_pkg_query_types() }
  (cur_files, iter, final_hist, out_qt)
}

///| Rewrite `<recv>.split(<sep>).next()` on `Array[String]` -> `mbt_compat::str_split_first(<recv>, <sep>)`.
///| Strictly fail-closed: only rewrites when the zero-arg `.next()` receiver lexically ends with `.split(<1 arg>)`.
fn split_next_receiver_start_token(toks : Array[Token], end_i : Int) -> Int {
  if end_i < 0 || end_i >= toks.length() {
    return -1
  }
  let ek = toks[end_i].kind
  if ek != TokenKind::Ident && ek != TokenKind::UpperIdent &&
  ek != TokenKind::RParen && ek != TokenKind::RBracket &&
  ek != TokenKind::StringLit && ek != TokenKind::InterpString &&
  ek != TokenKind::RawMultiline && ek != TokenKind::InterpMultiline {
    return -1
  }
  let mut cur = end_i
  while cur >= 0 {
    let ck = toks[cur].kind
    if ck == TokenKind::RParen || ck == TokenKind::RBracket {
      let op = find_open_before(toks, cur, 0)
      if op < 0 {
        return -1
      }
      cur = op
      if cur > 0 {
        let pk = toks[cur - 1].kind
        if pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
        pk == TokenKind::RParen || pk == TokenKind::RBracket {
          cur = cur - 1
          continue
        }
      }
      break
    }
    if cur >= 2 && toks[cur - 1].kind == TokenKind::ColonColon &&
    (toks[cur - 2].kind == TokenKind::UpperIdent || toks[cur - 2].kind == TokenKind::Ident) {
      cur = cur - 2
      continue
    }
    if cur >= 2 && toks[cur - 1].kind == TokenKind::Dot {
      let pk = toks[cur - 2].kind
      if pk == TokenKind::Ident || pk == TokenKind::UpperIdent || pk == TokenKind::IntLit ||
      pk == TokenKind::RParen || pk == TokenKind::RBracket ||
      pk == TokenKind::StringLit || pk == TokenKind::InterpString ||
      pk == TokenKind::RawMultiline || pk == TokenKind::InterpMultiline {
        cur = cur - 2
        continue
      }
    }
    break
  }
  cur
}

///| Rewrite 0-arg `Array::count()` (e.g. from `split(...).filter(...).count()`) to `.length()`.
///| Never rewrites `.count(pred)` with arguments.
fn rewrite_array_count_zero_arg_at(line_text : String, col : Int) -> Option[String] {
  let toks = lex_moonbit(line_text)
  let tn = toks.length() - 1
  let mut best_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 3 < tn {
    if toks[ti].kind == TokenKind::Dot && toks[ti + 1].kind == TokenKind::Ident &&
    toks[ti + 1].raw == "count" && toks[ti + 2].kind == TokenKind::LParen &&
    toks[ti + 3].kind == TokenKind::RParen {
      let dist = if toks[ti + 1].col >= col { toks[ti + 1].col - col } else { col - toks[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        best_i = ti + 1
      }
    }
    ti = ti + 1
  }
  if best_i < 0 {
    return None
  }
  let tok = toks[best_i]
  Some(line_text.slice(0, tok.start_byte) + "length" + line_text.slice(tok.end_byte, line_text.length()))
}

fn rewrite_split_next_at(line_text : String, col : Int) -> Option[String] {
  let toks = lex_moonbit(line_text)
  let tn = toks.length() - 1
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 3 < tn {
    if toks[ti].kind == TokenKind::Dot && toks[ti + 1].kind == TokenKind::Ident &&
    toks[ti + 1].raw == "next" && toks[ti + 2].kind == TokenKind::LParen &&
    toks[ti + 3].kind == TokenKind::RParen {
      let dist = if toks[ti + 1].col >= col { toks[ti + 1].col - col } else { col - toks[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i < 5 || toks[dot_i - 1].kind != TokenKind::RParen {
    return None
  }
  let split_lp = find_open_before(toks, dot_i - 1, 0)
  if split_lp < 3 || toks[split_lp - 1].kind != TokenKind::Ident ||
  toks[split_lp - 1].raw != "split" || toks[split_lp - 2].kind != TokenKind::Dot {
    return None
  }
  let sargs = ms_split_call_args(toks, split_lp, dot_i - 1)
  if sargs.length() != 1 || sargs[0].0 >= sargs[0].1 {
    return None
  }
  let recv_start = split_next_receiver_start_token(toks, split_lp - 3)
  if recv_start < 0 || recv_start > split_lp - 3 ||
  (recv_start > 0 && (toks[recv_start - 1].kind == TokenKind::ColonColon || toks[recv_start - 1].kind == TokenKind::Dot)) {
    return None
  }
  let recv_s = line_text.slice(toks[recv_start].start_byte, toks[split_lp - 3].end_byte).trim()
  let sep_s = line_text.slice(toks[sargs[0].0].start_byte, toks[sargs[0].1 - 1].end_byte).trim()
  if recv_s.length() == 0 || sep_s.length() == 0 || unsafe_index_arg_is_labelled(sep_s) {
    return None
  }
  Some(
    line_text.slice(0, toks[recv_start].start_byte) +
    "mbt_compat::str_split_first(" + recv_s + ", " + sep_s + ")" +
    line_text.slice(toks[dot_i + 3].end_byte, line_text.length()),
  )
}

///| Rewrite `<recv>.to_char()` on `Int` inline to MoonBit's exact Unicode scalar check
///| without modifying `mbt_compat`: returns `Some(ch)` iff `0 <= n <= 0x10FFFF` and not a surrogate.
fn rewrite_int_to_char_at(line_text : String, col : Int, used : Map[String, Bool]) -> Option[String] {
  let dot_idx = find_method_dot_at_col(line_text, "to_char", col)
  if dot_idx <= 0 {
    return None
  }
  let needle = ".to_char()"
  if dot_idx + needle.length() > line_text.length() || line_text.slice(dot_idx, dot_idx + needle.length()) != needle {
    return None
  }
  let mut recv_start = dot_idx - 1
  let mut paren_d = 0
  let mut brack_d = 0
  let mut brace_d = 0
  while recv_start >= 0 {
    let c = line_text.code_unit_at(recv_start)
    if (c == 34 || c == 39) && (paren_d > 0 || brack_d > 0 || brace_d > 0) {
      let quote = c
      recv_start = recv_start - 1
      while recv_start >= 0 {
        if line_text.code_unit_at(recv_start) == quote {
          let mut bs = 0
          let mut bi = recv_start - 1
          while bi >= 0 && line_text.code_unit_at(bi) == 92 {
            bs = bs + 1
            bi = bi - 1
          }
          if bs % 2 == 0 {
            recv_start = recv_start - 1
            break
          }
        }
        recv_start = recv_start - 1
      }
      continue
    }
    if c == 41 { paren_d = paren_d + 1; recv_start = recv_start - 1 }
    else if c == 40 { if paren_d == 0 { break }; paren_d = paren_d - 1; recv_start = recv_start - 1 }
    else if c == 93 { brack_d = brack_d + 1; recv_start = recv_start - 1 }
    else if c == 91 { if brack_d == 0 { break }; brack_d = brack_d - 1; recv_start = recv_start - 1 }
    else if c == 125 { brace_d = brace_d + 1; recv_start = recv_start - 1 }
    else if c == 123 { if brace_d == 0 { break }; brace_d = brace_d - 1; recv_start = recv_start - 1 }
    else if paren_d > 0 || brack_d > 0 || brace_d > 0 { recv_start = recv_start - 1 }
    else if is_alnum(c) || c == 95 || c == 46 || c == 58 { recv_start = recv_start - 1 }
    else { break }
  }
  recv_start = recv_start + 1
  let recv = line_text.slice(recv_start, dot_idx).trim()
  if recv.length() == 0 {
    return None
  }
  let mut tmp = "__mbt_ch"
  let mut k = 1
  while used.contains(tmp) {
    tmp = "__mbt_ch_" + k.to_string()
    k = k + 1
  }
  used[tmp] = true
  let repl = "({ let " + tmp + " = " + recv + "; if " + tmp + " >= 0 && " + tmp + " <= 0x10FFFF && !(" + tmp + " >= 0xD800 && " + tmp + " <= 0xDFFF) { Option::Some(" + tmp + ".unsafe_to_char()) } else { Option::None } })"
  Some(line_text.slice(0, recv_start) + repl + line_text.slice(dot_idx + needle.length(), line_text.length()))
}

fn stage_b_audit_final_push_iter_calls(cur_files : Array[GeneratedFile], diags : Array[Diag]) -> Unit {
  for f in cur_files {
    if !str_has(f.content, "arr_push_iter(") {
      continue
    }
    let tokens = lex_moonbit(f.content)
    let n = tokens.length() - 1
    let mut i = 0
    while i + 3 < n {
      if tokens[i].raw == "mbt_compat" && tokens[i + 1].kind == TokenKind::ColonColon &&
      tokens[i + 2].raw == "arr_push_iter" && tokens[i + 3].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i + 3)
        // Find depth-0 comma separating arg0 (`dst`) and arg1 (`it`)
        let mut comma_i = -1
        let mut d = 0
        let mut j = i + 4
        while j < cp {
          let jk = tokens[j].kind
          if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace { d = d + 1 }
          else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace { d = d - 1 }
          else if d == 0 && jk == TokenKind::Comma { comma_i = j; break }
          j = j + 1
        }
        let arg_s = comma_i + 1
        let arg_e = cp
        let is_proven_arr_iter = comma_i > 0 && arg_e >= arg_s + 5 &&
        tokens[arg_s].raw == "mbt_compat" && tokens[arg_s + 1].kind == TokenKind::ColonColon &&
        tokens[arg_s + 2].raw == "arr_iter" && tokens[arg_s + 3].kind == TokenKind::LParen &&
        find_matching_delim(tokens, arg_s + 3) == arg_e - 1
        if !is_proven_arr_iter {
          let line = tokens[i + 2].line
          let col = tokens[i + 2].col
          let mut dup = false
          for existing in diags {
            if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f.rel_path && existing.line == line && existing.col == col {
              dup = true
              break
            }
          }
          if !dup {
            diags.push(diag_error(
              "MBT2PION_ARRAY_ITER_MUTATION",
              f.rel_path,
              line,
              col,
              "`Array::push_iter(...)` only supports bare `Array::iter()` arguments (fail-closed against callback/custom-iterator mutation)",
            ))
          }
        }
      }
      i = i + 1
    }
  }
}

///| Stage B fail-closed guard for `Array::push_iter(arg)`:
///| Returns:
///|   1  -> `arg` is proven `mbt_compat::arr_iter(...)` (pure array iterator, zero user callbacks): allow rewrite.
///|   0  -> `arg` still ends with `.iter()` and an `arr_iter` rewrite is pending in this file/round: defer 1 round.
///|  -1  -> `arg` is non-array / custom `.iter()` / mapped iterator / opaque variable: emit `MBT2PION_ARRAY_ITER_MUTATION` and block rewrite.
///| `xs.shrink_to_fit()` on a Pion `Array` (`lower_capacity.pion`): true when no buffer snapshot can observe
///| it; otherwise records `MBT2PION_ARRAY_SHRINK_ITER` and returns false (the call is left unlowered).
fn stage_b_check_shrink_snapshot_cached(
  tokens : Array[Token],
  shrink_pkg : ShrinkPkg,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Bool {
  let mut name_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 1 < tokens.length() {
    if tokens[ti].raw == "shrink_to_fit" && tokens[ti - 1].kind == TokenKind::Dot && tokens[ti].line == line &&
    tokens[ti + 1].kind == TokenKind::LParen {
      let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      if dist < best {
        best = dist
        name_i = ti
      }
    }
    ti = ti + 1
  }
  if name_i < 0 {
    return false
  }
  let why = shrink_snapshot_hazard_with_qt(tokens, name_i, shrink_pkg, content, qfi_opt)
  if why.length() == 0 {
    return true
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_SHRINK_ITER" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_SHRINK_ITER",
    f_rel,
    line,
    col,
    "`Array::shrink_to_fit()` is not supported where a buffer snapshot may observe it: " + why +
    " (fail-closed: MoonBit moves the elements to a new buffer, a Pion `Array` keeps one storage)",
  ))
  false
}

///| `xs.iter()` kept past its expression (`lower_capacity.pion` `kept_iter_hazard`): true when `arr_iter` reads
///| what MoonBit's iterator would; otherwise records `MBT2PION_ARRAY_ITER_MUTATION` and returns false.
fn stage_b_check_kept_iter(
  file_tokens : Map[String, Array[Token]],
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  declared_types : Map[String, Bool],
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Bool {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let mut dot_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 2 < tokens.length() {
    if tokens[ti].kind == TokenKind::Dot &&
    (tokens[ti + 1].raw == "iter" || tokens[ti + 1].raw == "iter2" || tokens[ti + 1].raw == "rev_iter") &&
    tokens[ti + 2].kind == TokenKind::LParen &&
    tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best {
        best = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i < 0 {
    return false
  }
  let why = kept_iter_hazard_with_qt(tokens, dot_i, content, qfi_opt, declared_types)
  if why.length() == 0 {
    return true
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_ITER_MUTATION",
    f_rel,
    line,
    col,
    "a kept `Array::iter()` is not supported where its array changes in a way MoonBit's buffer snapshot would not see: " +
    why + " (fail-closed)",
  ))
  false
}

///| `xs.sort_by_key(key)`: the receiver-mutation gate can only see into a closure literal, so an opaque key (a
///| parameter, a variable, a function name) could push to `xs` while it is sorted -- MoonBit sorts a view of the
///| old buffer, `arr_sort_by` the live array. Only `fn(..) { .. }` keys are lowered; others record
///| `MBT2PION_ARRAY_ITER_MUTATION`.
fn stage_b_check_sort_key_closure_cached(
  tokens : Array[Token],
  env : SortKeyEnv,
  f_rel : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Bool {
  let mut open = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 1 < tokens.length() {
    if tokens[ti].raw == "sort_by_key" && tokens[ti - 1].kind == TokenKind::Dot && tokens[ti].line == line &&
    tokens[ti + 1].kind == TokenKind::LParen {
      let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      if dist < best {
        best = dist
        open = ti + 1
      }
    }
    ti = ti + 1
  }
  if open < 0 {
    return false
  }
  if open + 1 < tokens.length() && tokens[open + 1].raw == "fn" {
    // The closure body may not run code the receiver-mutation gate cannot see.
    let why = sort_key_closure_opacity(tokens, open, env)
    if why.length() == 0 {
      return true
    }
    for existing in diags {
      if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
        return false
      }
    }
    diags.push(diag_error(
      "MBT2PION_ARRAY_ITER_MUTATION",
      f_rel,
      line,
      col,
      "`Array::sort_by_key` key closure is not supported: " + why + " (fail-closed: it could change the array while it is sorted)",
    ))
    return false
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_ITER_MUTATION",
    f_rel,
    line,
    col,
    "`Array::sort_by_key` with a key that is not a closure literal is not supported (fail-closed: an opaque key could change the array while it is sorted)",
  ))
  false
}

///| After Stage B has converged: every `mbt_compat::arr_sort_by_key(xs, key)` must have a pure closure-literal key
///| (`sort_key_closure_purity_at`) as it reads now -- later rounds lower operators (`a + b` on a user type becomes
///| `mbt_op_add_T(a, b)`) and other calls the first check could not see.
pub fn stage_b_audit_final_sort_keys(cur_files : Array[GeneratedFile], diags : Array[Diag]) -> Unit {
  stage_b_audit_final_sort_keys_with_deps(cur_files, Map(), diags)
}

pub fn stage_b_audit_final_sort_keys_with_deps(
  cur_files : Array[GeneratedFile],
  dep_methods : Map[String, Bool],
  diags : Array[Diag],
) -> Unit {
  let all : Array[Array[Token]] = []
  let lexed : Array[(GeneratedFile, Array[Token])] = []
  for f in cur_files {
    let ts = lex_moonbit(f.content)
    all.push(ts)
    if str_has(f.content, "arr_sort_by_key(") {
      lexed.push((f, ts))
    }
  }
  if lexed.length() == 0 {
    return
  }
  let env = sort_key_env_of_with_deps(all, dep_methods)
  for fp in lexed {
    let f = fp.0
    let tokens = fp.1
    let n = tokens.length() - 1
    let mut i = 0
    while i + 3 < n {
      if tokens[i].raw == "mbt_compat" && tokens[i + 1].kind == TokenKind::ColonColon &&
      tokens[i + 2].raw == "arr_sort_by_key" && tokens[i + 3].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i + 3)
        let mut comma_i = -1
        let mut d = 0
        let mut j = i + 4
        while j < cp {
          let jk = tokens[j].kind
          if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace {
            d = d + 1
          } else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace {
            d = d - 1
          } else if d == 0 && jk == TokenKind::Comma {
            comma_i = j
            break
          }
          j = j + 1
        }
        let root = if comma_i == i + 5 && tokens[i + 4].kind == TokenKind::Ident { tokens[i + 4].raw } else { "" }
        let why = if comma_i < 0 {
          "the key is missing"
        } else {
          sort_key_closure_purity_at(tokens, comma_i + 1, root, env)
        }
        if why.length() > 0 {
          let line = tokens[i + 2].line
          let col = tokens[i + 2].col
          let mut dup = false
          for existing in diags {
            if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f.rel_path && existing.line == line {
              dup = true
              break
            }
          }
          if !dup {
            diags.push(diag_error(
              "MBT2PION_ARRAY_ITER_MUTATION",
              f.rel_path,
              line,
              col,
              "`Array::sort_by_key` key closure is not supported: " + why + " (fail-closed: it could change the array while it is sorted)",
            ))
          }
        }
        i = cp
      }
      i = i + 1
    }
  }
}

fn stage_b_check_push_iter_arg(
  file_tokens : Map[String, Array[Token]],
  f_rel : String,
  content : String,
  line : Int,
  col : Int,
  has_pending_arr_iter : Bool,
  diags : Array[Diag],
) -> Int {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let n = tokens.length() - 1
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 2 < n {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == "push_iter" &&
    tokens[ti + 2].kind == TokenKind::LParen && tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i <= 0 {
    return -1
  }
  let arg_s = dot_i + 3
  let arg_e = find_matching_delim(tokens, dot_i + 2)
  // Case A: exact `mbt_compat::arr_iter(...)` proven by `pionc check`
  if arg_e >= arg_s + 5 && tokens[arg_s].raw == "mbt_compat" &&
  tokens[arg_s + 1].kind == TokenKind::ColonColon && tokens[arg_s + 2].raw == "arr_iter" &&
  tokens[arg_s + 3].kind == TokenKind::LParen && find_matching_delim(tokens, arg_s + 3) == arg_e - 1 {
    return 1
  }
  // Case B: ends with `.iter()` — wait 1 round only if an `arr_iter` rewrite is pending in this file
  if arg_e >= arg_s + 4 && tokens[arg_e - 4].kind == TokenKind::Dot &&
  tokens[arg_e - 3].raw == "iter" && tokens[arg_e - 2].kind == TokenKind::LParen &&
  tokens[arg_e - 1].kind == TokenKind::RParen {
    if has_pending_arr_iter {
      return 0
    }
  }
  // Case B-fail / Case C: fail-closed with `MBT2PION_ARRAY_ITER_MUTATION`
  let mut dup = false
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line && existing.col == col {
      dup = true
      break
    }
  }
  if !dup {
    diags.push(diag_error(
      "MBT2PION_ARRAY_ITER_MUTATION",
      f_rel,
      line,
      col,
      "`Array::push_iter(...)` only supports bare `Array::iter()` arguments (fail-closed against callback/custom-iterator mutation)",
    ))
  }
  -1
}

// ---------------------------------------------------------------------------
// Wave F6-3a: Unified `mutation_summary` integration for Gates A, B, C, D
// ---------------------------------------------------------------------------

fn stage_b_record_mutation_allow(
  drift_ledger : Array[DriftEntry],
  category : String,
  file : String,
  line : Int,
  col : Int,
  expr : String,
  resolution : String,
  detail : String,
) -> Unit {
  for e in drift_ledger {
    if e.category == category && e.file == file && e.line == line && e.col == col {
      return
    }
  }
  drift_ledger.push(DriftEntry::{
    category,
    file,
    line,
    col,
    expr,
    resolution,
    status: "resolved",
    detail,
  })
}

///| Gate A: `Array::shrink_to_fit()` backed by `PkgMutationSummary` + allow ledger.
fn stage_b_check_shrink_snapshot_with_summary(
  tokens : Array[Token],
  shrink_pkg : ShrinkPkg,
  shrink_pkg_summary : ShrinkPkg,
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  line : Int,
  col : Int,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let mut name_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 1 < tokens.length() {
    if tokens[ti].raw == "shrink_to_fit" && tokens[ti - 1].kind == TokenKind::Dot && tokens[ti].line == line &&
    tokens[ti + 1].kind == TokenKind::LParen {
      let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      if dist < best {
        best = dist
        name_i = ti
      }
    }
    ti = ti + 1
  }
  if name_i < 0 {
    return false
  }
  let (why, allowed_by_ms) = shrink_snapshot_hazard_with_summary(
    tokens,
    name_i,
    shrink_pkg,
    shrink_pkg_summary,
    mut_summary,
    content,
    qfi_opt,
  )
  if why.length() == 0 {
    if allowed_by_ms {
      stage_b_record_mutation_allow(
        drift_ledger,
        "mutation_summary_allow_a",
        f_rel,
        line,
        col,
        "shrink_to_fit",
        "mbt_compat::arr_shrink_to_fit",
        "mutation_summary proved no live iterator/view can observe shrink_to_fit",
      )
    }
    return true
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_SHRINK_ITER" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_SHRINK_ITER",
    f_rel,
    line,
    col,
    "`Array::shrink_to_fit()` is not supported where a buffer snapshot may observe it: " + why +
    " (fail-closed: MoonBit moves the elements to a new buffer, a Pion `Array` keeps one storage)",
  ))
  false
}

///| Gate B: `Array::search_by(cb)` / `Array::filter_map(cb)` callback purity backed by
///| `PkgMutationSummary` + allow ledger.
fn stage_b_check_array_cb_with_summary(
  tokens : Array[Token],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  elem_ty : String,
  method_name : String,
  helper_name : String,
  line : Int,
  col : Int,
  record_allow : Bool,
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let n = tokens.length() - 1
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 2 < n {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == method_name &&
    tokens[ti + 2].kind == TokenKind::LParen && tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i <= 0 {
    return false
  }
  let arg_s = dot_i + 3
  let arg_e = find_matching_delim(tokens, dot_i + 2)
  if arg_s >= arg_e {
    return false
  }
  let body_open = outermost_body_open(tokens, dot_i)
  if body_open < 0 {
    return false
  }
  let active_gen = enclosing_fn_generic_params_at(tokens, body_open, dot_i)
  let sum = summarize_callback_arg(mut_summary, tokens, arg_s, arg_e, body_open, content, qfi_opt, elem_ty, active_gen)
  if !summary_may_mutate_array_in_ctx(mut_summary, sum, elem_ty, active_gen) {
    if record_allow {
      stage_b_record_mutation_allow(
        drift_ledger,
        "mutation_summary_allow_b",
        f_rel,
        line,
        col,
        method_name,
        helper_name,
        "mutation_summary proved " + method_name + " callback cannot mutate Array[" + elem_ty + "]",
      )
    }
    return true
  }
  false
}

///| Gate B wrapper for `Array::search_by(cb)`.
fn stage_b_check_search_by_with_summary(
  tokens : Array[Token],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  elem_ty : String,
  line : Int,
  col : Int,
  record_allow : Bool,
  drift_ledger : Array[DriftEntry],
) -> Bool {
  stage_b_check_array_cb_with_summary(
    tokens,
    mut_summary,
    f_rel,
    content,
    qfi_opt,
    elem_ty,
    "search_by",
    "mbt_compat::arr_search_by",
    line,
    col,
    record_allow,
    drift_ledger,
  )
}

struct MapKeyEdit {
  call_s : Int
  call_e : Int
  recv_s : Int
  recv_e : Int
  arg_s : Int
  arg_e : Int
  helper : String
}

fn stage_b_is_ident_shadowed_in_fn(tokens : Array[Token], body_open : Int, ident : String) -> Bool {
  if body_open < 0 || body_open >= tokens.length() {
    return false
  }
  let body_close = find_matching_delim(tokens, body_open)
  if body_close <= body_open {
    return false
  }
  // Check function parameter names before `body_open`.
  let mut h = body_open - 1
  let mut fn_kw = -1
  while h >= 0 {
    if tokens[h].raw == "fn" && (tokens[h].kind == TokenKind::Keyword || tokens[h].kind == TokenKind::Ident) {
      fn_kw = h
      break
    }
    if tokens[h].kind == TokenKind::RBrace {
      break
    }
    h = h - 1
  }
  if fn_kw >= 0 {
    let mut k = fn_kw + 1
    while k + 1 < body_open {
      if tokens[k].kind == TokenKind::Ident && tokens[k].raw == ident && tokens[k + 1].kind == TokenKind::Colon {
        return true
      }
      k = k + 1
    }
  }
  // Check local `let [mut] <ident>`, C-style `for <ident> =`, closure params, and pattern bindings.
  let mut i = body_open + 1
  while i + 1 < body_close {
    if tokens[i].raw == "let" {
      let mut ni = i + 1
      if ni < body_close && tokens[ni].raw == "mut" {
        ni = ni + 1
      }
      if ni < body_close && tokens[ni].kind == TokenKind::Ident && tokens[ni].raw == ident {
        return true
      }
    } else if tokens[i].raw == "for" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) {
      let mut fj = i + 1
      let mut fd = 0
      while fj < body_close {
        let fjk = tokens[fj].kind
        if fd == 0 && (fjk == TokenKind::Semi || fjk == TokenKind::LBrace || tokens[fj].raw == "in") {
          break
        }
        if fd == 0 && fjk == TokenKind::Ident && tokens[fj].raw == ident &&
        fj + 1 < body_close && tokens[fj + 1].kind == TokenKind::Eq {
          return true
        }
        if fjk == TokenKind::LParen || fjk == TokenKind::LBracket || fjk == TokenKind::LBrace { fd = fd + 1 }
        else if fjk == TokenKind::RParen || fjk == TokenKind::RBracket || fjk == TokenKind::RBrace { if fd > 0 { fd = fd - 1 } }
        fj = fj + 1
      }
    }
    i = i + 1
  }
  let pats : Map[String, Bool] = Map()
  ms_collect_pattern_bound_idents(tokens, body_open, pats)
  ms_collect_closure_param_names(tokens, body_open + 1, body_close, pats)
  pats.contains(ident)
}

fn stage_b_pkg_contains_new_by(all_tokens : Array[Array[Token]]) -> Bool {
  for toks in all_tokens {
    let n = toks.length() - 1
    let mut i = 0
    while i < n {
      if toks[i].raw == "new_by" {
        return true
      }
      i = i + 1
    }
  }
  false
}

fn apply_nested_mapkey_edits(
  src : String,
  s : Int,
  e : Int,
  edits : Array[MapKeyEdit],
  exclude_idx : Int,
) -> String {
  let top_idxs : Array[Int] = []
  let mut i = 0
  while i < edits.length() {
    if i != exclude_idx {
      let ed = edits[i]
      if ed.call_s >= s && ed.call_e <= e {
        let mut nested = false
        let mut j = 0
        while j < edits.length() {
          if j != i && j != exclude_idx {
            let other = edits[j]
            if other.call_s >= s && other.call_e <= e &&
            other.call_s <= ed.call_s && other.call_e >= ed.call_e &&
            (other.call_s < ed.call_s || other.call_e > ed.call_e) {
              nested = true
              break
            }
          }
          j = j + 1
        }
        if !nested {
          top_idxs.push(i)
        }
      }
    }
    i = i + 1
  }
  if top_idxs.length() == 0 {
    return src.slice(s, e)
  }
  let mut k = 1
  while k < top_idxs.length() {
    let cur = top_idxs[k]
    let mut m = k - 1
    while m >= 0 && edits[top_idxs[m]].call_s > edits[cur].call_s {
      top_idxs[m + 1] = top_idxs[m]
      m = m - 1
    }
    top_idxs[m + 1] = cur
    k = k + 1
  }
  let sb = StringBuilder()
  let mut pos = s
  for idx in top_idxs {
    let ed = edits[idx]
    if ed.call_s < pos {
      continue
    }
    if ed.call_s > pos {
      sb.write_string(src.slice(pos, ed.call_s))
    }
    let recv_rendered = apply_nested_mapkey_edits(src, ed.recv_s, ed.recv_e, edits, idx)
    let arg_rendered = apply_nested_mapkey_edits(src, ed.arg_s, ed.arg_e, edits, idx)
    sb.write_string(ed.helper)
    sb.write_string("(")
    sb.write_string(recv_rendered)
    sb.write_string(", ")
    sb.write_string(arg_rendered)
    sb.write_string(")")
    pos = ed.call_e
  }
  if pos < e {
    sb.write_string(src.slice(pos, e))
  }
  sb.to_string()
}

///| Lower `.get(k)` / `.contains(k)` on `mbt_compat::OrderedMap[K, V]` and `.contains(k)` on
///| `mbt_compat::OrderedSet[K]` to `mbt_compat::ordered_map_get_mapkey` /
///| `ordered_map_contains_mapkey` / `ordered_set_contains_mapkey` whenever `QtFileIndex` proves
///| the receiver is `mbt_compat::OrderedMap`/`OrderedSet`, canonicalized key `K` is a sealed
///| built-in `MapKey` type, `mbt_compat` is not shadowed, and no `new_by` construction taints the
///| enclosing function or package globals.
pub fn stage_b_lower_pure_mapkey_lookups(
  cur_files : Array[GeneratedFile],
  pkg_qt : PkgQueryTypes,
  dep_methods : Map[String, Bool],
  op_lookup : Map[String, String],
  cross_pkg : CrossPkgMutationContext,
) -> (Array[GeneratedFile], Bool) {
  if !pkg_qt.ok {
    return (cur_files, false)
  }
  let mut has_cand = false
  for f in cur_files {
    if str_has(f.content, ".get(") || str_has(f.content, ".contains(") {
      has_cand = true
      break
    }
  }
  if !has_cand {
    return (cur_files, false)
  }
  let all_tokens : Array[Array[Token]] = []
  let rels : Array[String] = []
  let contents : Array[String] = []
  for f in cur_files {
    all_tokens.push(lex_moonbit(f.content))
    rels.push(f.rel_path)
    contents.push(f.content)
  }
  let pkg_ms = collect_pkg_mutation_summary_with_cross_pkg(
    all_tokens,
    rels,
    contents,
    pkg_qt,
    dep_methods,
    op_lookup,
    cross_pkg,
  )
  let pkg_mbt_compat_shadowed = pkg_ms.declared_types.contains("mbt_compat") ||
  pkg_ms.top_level_value_bindings.contains("mbt_compat")
  if pkg_mbt_compat_shadowed {
    return (cur_files, false)
  }
  if stage_b_pkg_contains_new_by(all_tokens) {
    return (cur_files, false)
  }

  let out_files : Array[GeneratedFile] = []
  let mut any_changed = false
  let mut fi = 0
  while fi < cur_files.length() {
    let f = cur_files[fi]
    if !str_has(f.content, ".get(") && !str_has(f.content, ".contains(") {
      out_files.push(f)
      fi = fi + 1
      continue
    }
    let qfi = match pkg_qt.files.get(f.rel_path) {
      Some(q) => q
      None => {
        out_files.push(f)
        fi = fi + 1
        continue
      }
    }
    let tokens = all_tokens[fi]
    let n = tokens.length() - 1
    let edits : Array[MapKeyEdit] = []
    let mut ti = 1
    while ti + 2 < n {
      if tokens[ti].kind == TokenKind::Dot &&
      (tokens[ti + 1].raw == "get" || tokens[ti + 1].raw == "contains") &&
      tokens[ti + 2].kind == TokenKind::LParen {
        let mname = tokens[ti + 1].raw
        let rp_ti = find_matching_delim(tokens, ti + 2)
        if rp_ti > ti + 2 {
          let cargs = ms_split_call_args(tokens, ti + 2, rp_ti)
          if cargs.length() == 1 && cargs[0].0 < cargs[0].1 {
            let arg_s_b = tokens[cargs[0].0].start_byte
            let arg_e_b = tokens[cargs[0].1 - 1].end_byte
            let arg_src = f.content.slice(arg_s_b, arg_e_b)
            if !unsafe_index_arg_is_labelled(arg_src) {
              let recv_start_ti = find_receiver_start_token(tokens, ti)
              if recv_start_ti >= 0 && recv_start_ti < ti {
                let body_open = outermost_body_open(tokens, ti)
                let shadowed = if body_open >= 0 {
                  stage_b_is_ident_shadowed_in_fn(tokens, body_open, "mbt_compat")
                } else {
                  false
                }
                if !shadowed {
                  let active_gen = if body_open >= 0 {
                    enclosing_fn_generic_params_at(tokens, body_open, ti)
                  } else {
                    Map()
                  }
                  let recv_s_b = tokens[recv_start_ti].start_byte
                  let recv_e_b = tokens[ti - 1].end_byte
                  match qt_lookup_receiver_ty_at_op(qfi, f.content, tokens[ti + 1].start_byte, recv_s_b, tokens[rp_ti].end_byte, true) {
                    Some(raw_rty) => {
                      let rty_canon = qt_strip_pkg_hash(raw_rty).trim()
                      let mut raw_k = ""
                      let mut helper = ""
                      if rty_canon.starts_with("mbt_compat::OrderedMap[") && rty_canon.ends_with("]") {
                        let inner = rty_canon.slice(23, rty_canon.length() - 1).trim()
                        let parts = qt_split_top_level_type_args(inner)
                        if parts.length() == 2 {
                          raw_k = parts[0].trim()
                          helper = if mname == "get" {
                            "mbt_compat::ordered_map_get_mapkey"
                          } else {
                            "mbt_compat::ordered_map_contains_mapkey"
                          }
                        }
                      } else if mname == "contains" && rty_canon.starts_with("mbt_compat::OrderedSet[") && rty_canon.ends_with("]") {
                        let inner = rty_canon.slice(23, rty_canon.length() - 1).trim()
                        let parts = qt_split_top_level_type_args(inner)
                        if parts.length() == 1 {
                          raw_k = parts[0].trim()
                          helper = "mbt_compat::ordered_set_contains_mapkey"
                        }
                      }
                      if helper.length() > 0 && raw_k.length() > 0 && !active_gen.contains(raw_k) {
                        let canon_k = ms_canonicalize_type(pkg_ms, raw_k)
                        if canon_k.length() > 0 && !active_gen.contains(canon_k) && ms_is_sealed_builtin_map_key(canon_k) {
                          edits.push(MapKeyEdit::{
                            call_s: recv_s_b,
                            call_e: tokens[rp_ti].end_byte,
                            recv_s: recv_s_b,
                            recv_e: recv_e_b,
                            arg_s: arg_s_b,
                            arg_e: arg_e_b,
                            helper: helper,
                          })
                        }
                      }
                    }
                    None => ()
                  }
                }
              }
            }
          }
        }
      }
      ti = ti + 1
    }
    if edits.length() > 0 {
      let rewritten = apply_nested_mapkey_edits(f.content, 0, f.content.length(), edits, -1)
      if rewritten != f.content {
        any_changed = true
        out_files.push(GeneratedFile::{
          rel_path: f.rel_path,
          content: rewritten,
          source_file: f.source_file,
          anchors: f.anchors,
        })
      } else {
        out_files.push(f)
      }
    } else {
      out_files.push(f)
    }
    fi = fi + 1
  }
  (out_files, any_changed)
}

///| Gate C: Immediate `.iter().(any|all|find_first)(cb)` backed by `PkgMutationSummary` + allow ledger.
fn stage_b_check_kept_iter_with_summary(
  file_tokens : Map[String, Array[Token]],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  declared_types : Map[String, Bool],
  elem_ty : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let mut dot_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 2 < tokens.length() {
    if tokens[ti].kind == TokenKind::Dot &&
    (tokens[ti + 1].raw == "iter" || tokens[ti + 1].raw == "iter2" || tokens[ti + 1].raw == "rev_iter") &&
    tokens[ti + 2].kind == TokenKind::LParen &&
    tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best {
        best = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i < 0 {
    return false
  }
  let iter_m = tokens[dot_i + 1].raw
  let iter_helper = if iter_m == "iter2" {
    "mbt_compat::arr_iter2"
  } else if iter_m == "rev_iter" {
    "mbt_compat::arr_rev_iter"
  } else {
    "mbt_compat::arr_iter"
  }
  let mut why = kept_iter_hazard_with_qt(tokens, dot_i, content, qfi_opt, declared_types)
  if why.length() == 0 {
    // Soundness check: for immediate `.iter().(any|all|find_first)(cb)` on ANY named receiver
    // (including fresh locals, which can still be mutated via stored closures), always require
    // `mutation_summary` to rule out trait/operator/indirect-closure mutations.
    let close_p = find_matching_delim(tokens, dot_i + 2)
    let is_imm_pred = close_p == dot_i + 3 && close_p + 3 < tokens.length() &&
    tokens[close_p + 1].kind == TokenKind::Dot &&
    (tokens[close_p + 2].raw == "any" || tokens[close_p + 2].raw == "all" || tokens[close_p + 2].raw == "find_first") &&
    tokens[close_p + 3].kind == TokenKind::LParen
    if is_imm_pred && !is_array_literal_end(tokens, dot_i - 1) {
      match immediate_iter_consumer_allow_with_summary(tokens, dot_i, mut_summary, content, qfi_opt, elem_ty) {
        Some(_) => return true
        None => why = "callback in immediate `." + iter_m + "()." + tokens[close_p + 2].raw + "(...)` may mutate the array (trait/operator/opaque/mutating call)"
      }
    } else {
      return true
    }
  } else {
    match immediate_iter_consumer_allow_with_summary(tokens, dot_i, mut_summary, content, qfi_opt, elem_ty) {
      Some(detail) => {
        stage_b_record_mutation_allow(
          drift_ledger,
          "mutation_summary_allow_c",
          f_rel,
          line,
          col,
          "." + iter_m + "()",
          iter_helper,
          detail,
        )
        return true
      }
      None => ()
    }
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_ITER_MUTATION",
    f_rel,
    line,
    col,
    "a kept `Array::" + iter_m + "()` is not supported where its array changes in a way MoonBit's buffer snapshot would not see: " +
    why + " (fail-closed)",
  ))
  false
}

fn stage_b_is_simple_ident(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let c0 = s.code_unit_at(0)
  let ok0 = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95
  if !ok0 {
    return false
  }
  let mut k = 1
  while k < s.length() {
    let c = s.code_unit_at(k)
    let ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
    if !ok {
      return false
    }
    k = k + 1
  }
  true
}

///| Gate D: Rewrite provably read-only `for <vars> in <arr[lo:hi]> { <body> }` borrowed-slice loops
///| (emitted by Stage A as `mbt_compat::__mbt_slice_borrow(...)` or `({ let __mbt_sl_N = ...; mbt_compat::__mbt_slice_borrow(...) })`)
///| into MoonBit-exact clamped index `while` loops:
///|   1. Evaluate `recv` -> `lo` -> `hi` once in order;
///|   2. Take `len = recv.length()` AFTER `hi` finishes;
///|   3. Clamp `lo` and `hi` to `[0, len]`, with `hi_c = max(lo_c, hi_c0)`;
///|   4. Advance index before body so `break`/`continue` preserve exact control targets.
fn stage_b_rewrite_borrowed_slice_for_loops(
  lines : Array[String],
  tokens : Array[Token],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  used_idents : Map[String, Bool],
  mutated_lines : Map[Int, Bool],
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let n = tokens.length() - 1
  let mut any_changed = false
  let mut i = 0
  while i + 5 < n {
    if tokens[i].raw == "for" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) {
      let mut j = i + 1
      let mut in_i = -1
      let mut d = 0
      while j < n {
        let jk = tokens[j].kind
        if d == 0 && jk == TokenKind::LBrace {
          break
        }
        if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace { d = d + 1 }
        else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
        else if d == 0 && tokens[j].raw == "in" && in_i < 0 { in_i = j }
        j = j + 1
      }
      if in_i > i + 1 && j < n && tokens[j].kind == TokenKind::LBrace {
        let lb = j
        let rb = find_matching_delim(tokens, lb)
        let for_lidx = tokens[i].line - 1
        let lb_lidx = tokens[lb].line - 1
        let rb_lidx = if rb > lb { tokens[rb].line - 1 } else { -1 }
        let has_leading_label = i > 0 && tokens[i - 1].kind == TokenKind::Colon
        let has_trailing_else = rb > lb && rb + 1 < n && tokens[rb + 1].raw == "else"
        if rb > lb && for_lidx == lb_lidx && for_lidx >= 0 && rb_lidx < lines.length() &&
        !has_leading_label && !has_trailing_else &&
        !mutated_lines.contains(for_lidx) && !mutated_lines.contains(rb_lidx) {
          let is_s = in_i + 1
          let is_e = lb
          // Recognize Form 1: `mbt_compat::__mbt_slice_borrow(recv, lo, hi)`
          // or Form 2: `({ let <tmp> = <recv_init>; mbt_compat::__mbt_slice_borrow(<tmp>, lo, hi) })`
          let mut matched_form = 0
          let mut tmp_name = ""
          let mut recv_s = -1
          let mut recv_e = -1
          let mut lo_s = -1
          let mut lo_e = -1
          let mut hi_s = -1
          let mut hi_e = -1
          if is_s + 4 < is_e && tokens[is_s].raw == "mbt_compat" &&
          tokens[is_s + 1].kind == TokenKind::ColonColon &&
          tokens[is_s + 2].raw == "__mbt_slice_borrow" &&
          tokens[is_s + 3].kind == TokenKind::LParen &&
          find_matching_delim(tokens, is_s + 3) == is_e - 1 {
            let sargs = ms_split_call_args(tokens, is_s + 3, is_e - 1)
            if sargs.length() == 3 {
              matched_form = 1
              recv_s = sargs[0].0
              recv_e = sargs[0].1
              lo_s = sargs[1].0
              lo_e = sargs[1].1
              hi_s = sargs[2].0
              hi_e = sargs[2].1
            }
          } else if is_s + 10 < is_e && tokens[is_s].kind == TokenKind::LParen &&
          find_matching_delim(tokens, is_s) == is_e - 1 &&
          tokens[is_s + 1].kind == TokenKind::LBrace &&
          find_matching_delim(tokens, is_s + 1) == is_e - 2 &&
          tokens[is_s + 2].raw == "let" &&
          tokens[is_s + 3].kind == TokenKind::Ident &&
          tokens[is_s + 4].kind == TokenKind::Eq {
            let mut semi_i = -1
            let mut sd = 0
            let mut sk = is_s + 5
            while sk < is_e - 2 {
              let skk = tokens[sk].kind
              if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace { sd = sd + 1 }
              else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace { if sd > 0 { sd = sd - 1 } }
              else if sd == 0 && skk == TokenKind::Semi { semi_i = sk; break }
              sk = sk + 1
            }
            if semi_i > is_s + 5 && semi_i + 5 < is_e - 2 &&
            tokens[semi_i + 1].raw == "mbt_compat" &&
            tokens[semi_i + 2].kind == TokenKind::ColonColon &&
            tokens[semi_i + 3].raw == "__mbt_slice_borrow" &&
            tokens[semi_i + 4].kind == TokenKind::LParen &&
            find_matching_delim(tokens, semi_i + 4) == is_e - 3 {
              let sargs = ms_split_call_args(tokens, semi_i + 4, is_e - 3)
              if sargs.length() == 3 {
                matched_form = 2
                tmp_name = tokens[is_s + 3].raw
                recv_s = is_s + 5
                recv_e = semi_i
                lo_s = sargs[1].0
                lo_e = sargs[1].1
                hi_s = sargs[2].0
                hi_e = sargs[2].1
              }
            }
          }
          if matched_form > 0 && recv_s >= 0 && recv_e > recv_s {
            let fn_body_open = outermost_body_open(tokens, i)
            let active_gen = enclosing_fn_generic_params(tokens, fn_body_open)
            // Resolve receiver type (must be proven `Array[...]`, never `String`/`Bytes`/`FixedArray`/`ArrayView`/unknown)
            let mut recv_ty = match qfi_opt {
              Some(qfi) =>
              match qt_lookup_expr_span_ty(qfi, content, tokens[recv_s].start_byte, tokens[recv_e - 1].end_byte, true) {
                Some(t) => t
                None => ""
              }
              None => ""
            }
            if recv_ty.length() == 0 {
              // Fallback: infer from local parameter / `let` / struct field / function return types
              let vt_in : Map[String, String] = Map()
              if fn_body_open >= 0 {
                let fstart = fn_start_of(tokens, fn_body_open)
                if fstart >= 0 {
                  let mut p = fstart + 1
                  while p < fn_body_open && tokens[p].kind != TokenKind::LParen { p = p + 1 }
                  if p < fn_body_open && tokens[p].kind == TokenKind::LParen {
                    let rp = find_matching_delim(tokens, p)
                    if rp < fn_body_open {
                      ms_parse_fn_params(tokens, p, rp, vt_in)
                    }
                  }
                }
                let fbc = find_matching_delim(tokens, fn_body_open)
                ms_collect_local_var_types(mut_summary, tokens, fn_body_open + 1, fbc, content, qfi_opt, vt_in, Map(), Map(), enclosing_fn_generic_params(tokens, fn_body_open))
              }
              recv_ty = ms_infer_expr_ty(mut_summary, tokens, recv_e - 1, content, qfi_opt, vt_in)
            }
            let rt_clean = ms_strip_pkg_prefix(recv_ty)
            if rt_clean.starts_with("Array[") && rt_clean.ends_with("]") {
              let elem_ty = ms_extract_array_elem_ty(rt_clean)
              let vars_str = content.slice(tokens[i + 1].start_byte, tokens[in_i - 1].end_byte).trim()
              let comma_idx = vars_str.index_of(",")
              let mut vars_ok = false
              let loop_vt : Map[String, String] = Map()
              if comma_idx >= 0 {
                let iv_nm = vars_str.slice(0, comma_idx).trim()
                let ev_nm = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                if stage_b_is_simple_ident(iv_nm) && stage_b_is_simple_ident(ev_nm) {
                  vars_ok = true
                  loop_vt[iv_nm] = "Int"
                  if elem_ty.length() > 0 { loop_vt[ev_nm] = elem_ty }
                }
              } else if stage_b_is_simple_ident(vars_str) {
                vars_ok = true
                if elem_ty.length() > 0 { loop_vt[vars_str] = elem_ty }
              }
              let body_sum = if vars_ok {
                summarize_expr_span(mut_summary, tokens, lb + 1, rb, fn_body_open, content, qfi_opt, loop_vt, active_gen)
              } else {
                FnMutationSummary::empty()
              }
              if vars_ok && !summary_may_mutate_array_in_ctx(mut_summary, body_sum, elem_ty, active_gen) {
                let recv_str = content.slice(tokens[recv_s].start_byte, tokens[recv_e - 1].end_byte).trim()
                let lo_str = content.slice(tokens[lo_s].start_byte, tokens[lo_e - 1].end_byte).trim()
                let hi_str = content.slice(tokens[hi_s].start_byte, tokens[hi_e - 1].end_byte).trim()
                let tag = for_lidx.to_string()
                let rv_var = if matched_form == 2 { tmp_name } else { fresh_stage_b_ident(used_idents, "__mbt_slr_" + tag) }
                let lo_var = fresh_stage_b_ident(used_idents, "__mbt_slo_" + tag)
                let hi_var = fresh_stage_b_ident(used_idents, "__mbt_shi_" + tag)
                let len_var = fresh_stage_b_ident(used_idents, "__mbt_sln_" + tag)
                let loc_var = fresh_stage_b_ident(used_idents, "__mbt_slc_" + tag)
                let hic0_var = fresh_stage_b_ident(used_idents, "__mbt_sh0_" + tag)
                let hic_var = fresh_stage_b_ident(used_idents, "__mbt_shc_" + tag)
                let idx_var = fresh_stage_b_ident(used_idents, "__mbt_sli_" + tag)
                let bind_stmts = if comma_idx >= 0 {
                  let idx_v = vars_str.slice(0, comma_idx).trim()
                  let el_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                  "let " + idx_v + " = " + idx_var + " - " + loc_var + "; let " + el_v + " = " + rv_var + "[" + idx_var + "]"
                } else {
                  "let " + vars_str + " = " + rv_var + "[" + idx_var + "]"
                }
                let for_col0 = tokens[i].col - 1
                let lb_col0 = tokens[lb].col - 1
                let rb_col0 = tokens[rb].col - 1
                let cur_ln = lines[for_lidx]
                if for_col0 >= 0 && lb_col0 > for_col0 && lb_col0 < cur_ln.length() {
                  let prefix = cur_ln.slice(0, for_col0)
                  let open_hdr = prefix + "{ let " + rv_var + " = " + recv_str +
                  "; let " + lo_var + " = " + lo_str +
                  "; let " + hi_var + " = " + hi_str +
                  "; let " + len_var + " = " + rv_var + ".length()" +
                  "; let " + loc_var + " = if " + lo_var + " < 0 { 0 } else if " + lo_var + " > " + len_var + " { " + len_var + " } else { " + lo_var + " }" +
                  "; let " + hic0_var + " = if " + hi_var + " < 0 { 0 } else if " + hi_var + " > " + len_var + " { " + len_var + " } else { " + hi_var + " }" +
                  "; let " + hic_var + " = if " + hic0_var + " > " + loc_var + " { " + hic0_var + " } else { " + loc_var + " }" +
                  "; let mut " + idx_var + " = " + loc_var +
                  "; while " + idx_var + " < " + hic_var + " { " + bind_stmts + "; " + idx_var + " = " + idx_var + " + 1; "
                  if rb_lidx == for_lidx {
                    let body_part = cur_ln.slice(lb_col0 + 1, rb_col0)
                    let after_part = cur_ln.slice(rb_col0 + 1, cur_ln.length())
                    lines[for_lidx] = open_hdr + body_part + " } }" + after_part
                  } else {
                    let first_rest = cur_ln.slice(lb_col0 + 1, cur_ln.length())
                    lines[for_lidx] = open_hdr + first_rest
                    let cln = lines[rb_lidx]
                    lines[rb_lidx] = cln.slice(0, rb_col0) + " } }" + cln.slice(rb_col0 + 1, cln.length())
                  }
                  mutated_lines[for_lidx] = true
                  mutated_lines[rb_lidx] = true
                  any_changed = true
                  stage_b_record_mutation_allow(
                    drift_ledger,
                    "mutation_summary_allow_d",
                    f_rel,
                    tokens[i].line,
                    tokens[i].col,
                    recv_str + "[" + lo_str + ":" + hi_str + "]",
                    "clamped_index_while_loop",
                    "mutation_summary proved borrowed slice loop body cannot mutate Array[" + elem_ty + "]",
                  )
                  i = rb + 1
                  continue
                }
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  any_changed
}
