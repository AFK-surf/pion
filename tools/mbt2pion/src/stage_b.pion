///| Stage B: Type-Directed Fixpoint Pass (`pionc check --json` + Span Map).
///|
///| Applies deterministic, table-driven rewrites keyed by `(diagnostic_code, receiver_type, method_or_op)`
///| aligned 1:1 with `tools/mbt_compat` canonical symbol names:
///| 1. Missing builtin methods -> `mbt_compat::arr_*` / `opt_*` / `str_*` / `ordered_map_*`
///| 2. Token-precise numeric literal coercions using `d.col` + lexer tokens (never appends to EOL!)
///| 3. `for k, v in map` -> `.to_array()`, `for c in s` / `for i, c in s` -> `mbt_compat::str_scalars(s)`
///| 4. `api_map.json` 2-argument unit-annotated boundary conversions (`mbt_compat::utf16_to_utf8_off(s, off)`,
///|    `mbt_compat::utf16_to_scalar_off(s, off)`, hard-failing if `str_param` is missing!) &
///|    `OrderedMap` <-> `Map` boundary conversions (`ordered_map_to_map` / `ordered_map_from_map`).

///| Map `Array[T]::sort()` receiver types unsupported by builtin `Array::sort` to `mbt_compat::arr_sort_*`.
fn lookup_array_sort_helper(receiver_ty : String) -> Option[String] {
  if receiver_ty == "Array[Double]" { return Some("mbt_compat::arr_sort_double") }
  if receiver_ty == "Array[Float]" { return Some("mbt_compat::arr_sort_float") }
  if receiver_ty == "Array[UInt]" { return Some("mbt_compat::arr_sort_uint") }
  if receiver_ty == "Array[UInt64]" { return Some("mbt_compat::arr_sort_uint64") }
  if receiver_ty == "Array[Byte]" { return Some("mbt_compat::arr_sort_byte") }
  if receiver_ty == "Array[Char]" { return Some("mbt_compat::arr_sort_char") }
  None
}

///| Map `(receiver_type_prefix, method_name)` to canonical `mbt_compat::*` helper names.
pub fn lookup_missing_method_helper(receiver_ty : String, method_name : String) -> Option[String] {
  if receiver_ty.starts_with("Array[") {
    if method_name == "map" { return Some("mbt_compat::arr_map") }
    if method_name == "filter" { return Some("mbt_compat::arr_filter") }
    if method_name == "retain" { return Some("mbt_compat::arr_retain") }
    if method_name == "filter_map" { return Some("mbt_compat::arr_filter_map") }
    if method_name == "each" { return Some("mbt_compat::arr_each") }
    if method_name == "eachi" { return Some("mbt_compat::arr_eachi") }
    if method_name == "fold" { return Some("mbt_compat::arr_fold") }
    if method_name == "mapi" { return Some("mbt_compat::arr_mapi") }
    if method_name == "last" { return Some("mbt_compat::arr_last") }
    if method_name == "insert" { return Some("mbt_compat::arr_insert") }
    if method_name == "remove" { return Some("mbt_compat::arr_remove") }
    if method_name == "sort_by" { return Some("mbt_compat::arr_sort_by") }
    if method_name == "sort_by_key" { return Some("mbt_compat::arr_sort_by_key") }
    if method_name == "shrink_to_fit" { return Some("mbt_compat::arr_shrink_to_fit") }
    if method_name == "append" { return Some("mbt_compat::arr_append") }
    if method_name == "to_array" { return Some("mbt_compat::arr_to_array") }
    if method_name == "search" { return Some("mbt_compat::arr_search") }
    if method_name == "contains" { return Some("mbt_compat::arr_contains") }
    if method_name == "is_empty" { return Some("mbt_compat::arr_is_empty") }
    if method_name == "truncate" { return Some("mbt_compat::arr_truncate") }
    if method_name == "blit_to" { return Some("mbt_compat::fixed_array_blit_to") }
    if method_name == "unsafe_get" { return Some("mbt_compat::arr_unsafe_get") }
    if method_name == "unsafe_set" { return Some("mbt_compat::arr_unsafe_set") }
    if method_name == "rev_in_place" { return Some("mbt_compat::arr_rev_in_place") }
    if method_name == "copy" { return Some("mbt_compat::arr_copy") }
    if method_name == "any" { return Some("mbt_compat::arr_any") }
    if method_name == "all" { return Some("mbt_compat::arr_all") }
    if method_name == "collect" { return Some("mbt_compat::arr_to_array") }
    if method_name == "get" { return Some("mbt_compat::arr_get") }
    if method_name == "release_unused" { return Some("mbt_compat::arr_release_unused") }
    if method_name == "iter" { return Some("mbt_compat::arr_iter") }
    if method_name == "search_by" { return Some("mbt_compat::arr_search_by") }
    if method_name == "push_iter" { return Some("mbt_compat::arr_push_iter") }
    if method_name == "rev" { return Some("mbt_compat::arr_rev") }
    if method_name == "drain" { return Some("mbt_compat::arr_drain") }
  }
  if receiver_ty.starts_with("FixedArray[") {
    if method_name == "unsafe_get" { return Some("mbt_compat::fixed_array_unsafe_get") }
    if method_name == "unsafe_set" { return Some("mbt_compat::fixed_array_unsafe_set") }
    if method_name == "copy" { return Some("mbt_compat::fixed_array_copy") }
    if method_name == "blit_to" { return Some("mbt_compat::fixed_array_blit_to_fa") }
    if method_name == "sort_by" { return Some("mbt_compat::fixed_array_sort_by") }
    if method_name == "sort" && receiver_ty == "FixedArray[Int64]" { return Some("mbt_compat::fixed_array_sort_i64") }
    if method_name == "sort" && receiver_ty == "FixedArray[Int]" { return Some("mbt_compat::fixed_array_sort_int") }
    if method_name == "sort" && receiver_ty == "FixedArray[Double]" { return Some("mbt_compat::fixed_array_sort_double") }
    if method_name == "sort" && receiver_ty == "FixedArray[Float]" { return Some("mbt_compat::fixed_array_sort_float") }
    if method_name == "sort" && receiver_ty == "FixedArray[UInt]" { return Some("mbt_compat::fixed_array_sort_uint") }
    if method_name == "sort" && receiver_ty == "FixedArray[UInt64]" { return Some("mbt_compat::fixed_array_sort_uint64") }
    if method_name == "sort" && receiver_ty == "FixedArray[Byte]" { return Some("mbt_compat::fixed_array_sort_byte") }
    if method_name == "sort" && receiver_ty == "FixedArray[Char]" { return Some("mbt_compat::fixed_array_sort_char") }
    if method_name == "iter" { return Some("mbt_compat::fixed_array_iter") }
  }
  if receiver_ty.starts_with("ArrayView[") || receiver_ty.starts_with("mbt_compat::ArrayView[") {
    if method_name == "iter" { return Some("mbt_compat::array_view_iter") }
  }
  if receiver_ty == "Double" {
    if method_name == "is_nan" { return Some("mbt_compat::double_is_nan") }
    if method_name == "is_inf" { return Some("mbt_compat::double_is_inf") }
    if method_name == "compare" { return Some("mbt_compat::double_compare") }
    if method_name == "min" { return Some("mbt_compat::double_min") }
    if method_name == "max" { return Some("mbt_compat::double_max") }
    if method_name == "reinterpret_as_int64" { return Some("mbt_compat::double_reinterpret_as_int64") }
  }
  if receiver_ty == "Float" {
    if method_name == "is_nan" { return Some("mbt_compat::float_is_nan") }
    if method_name == "compare" { return Some("mbt_compat::float_compare") }
  }
  if receiver_ty.starts_with("Option[") {
    if method_name == "map" { return Some("mbt_compat::opt_map") }
    if method_name == "map_or" { return Some("mbt_compat::opt_map_or") }
    if method_name == "bind" { return Some("mbt_compat::opt_bind") }
    if method_name == "unwrap" { return Some("mbt_compat::opt_unwrap") }
    if method_name == "or" { return Some("mbt_compat::opt_or") }
    if method_name == "is_empty" { return Some("mbt_compat::opt_is_empty") }
  }
  if receiver_ty == "String" {
    if method_name == "has_prefix" { return Some("mbt_compat::str_has_prefix") }
    if method_name == "has_suffix" { return Some("mbt_compat::str_has_suffix") }
    if method_name == "to_lower" { return Some("mbt_compat::str_to_lower") }
    if method_name == "to_upper" { return Some("mbt_compat::str_to_upper") }
    if method_name == "compare" { return Some("mbt_compat::str_compare") }
    if method_name == "lexical_compare" { return Some("mbt_compat::str_lexical_compare") }
    if method_name == "rev_find" { return Some("mbt_compat::str_rev_find") }
    if method_name == "to_owned" { return Some("mbt_compat::str_to_owned") }
    if method_name == "iter" { return Some("mbt_compat::str_iter") }
    if method_name == "to_array" { return Some("mbt_compat::str_scalars") }
    if method_name == "at" || method_name == "unsafe_get" { return Some("mbt_compat::utf16_code_unit_at") }
    if method_name == "exact_view" { return Some("mbt_compat::str_exact_view") }
    if method_name == "clamped_view" { return Some("mbt_compat::str_clamped_view") }
    if method_name == "view" { return Some("mbt_compat::str_view") }
    if method_name == "find" { return Some("mbt_compat::str_find") }
    if method_name == "contains_char" { return Some("mbt_compat::str_contains_char") }
    if method_name == "get_char" { return Some("mbt_compat::str_get_char") }
    if method_name == "trim_end" { return Some("mbt_compat::str_trim_end") }
  }
  if receiver_ty == "Char" {
    if method_name == "is_ascii_digit" { return Some("mbt_compat::char_is_ascii_digit") }
    if method_name == "is_ascii_alphabetic" { return Some("mbt_compat::char_is_ascii_alphabetic") }
    if method_name == "to_ascii_lowercase" { return Some("mbt_compat::char_to_ascii_lowercase") }
  }
  if receiver_ty == "Byte" {
    if method_name == "to_uint" { return Some("mbt_compat::byte_to_uint") }
  }
  if receiver_ty == "Double" {
    if method_name == "to_uint" { return Some("mbt_compat::double_to_uint") }
  }
  if receiver_ty == "Int" {
    if method_name == "unsafe_to_char" { return Some("mbt_compat::int_unsafe_to_char") }
    if method_name == "lnot" { return Some("mbt_compat::int_lnot") }
    if method_name == "popcnt" { return Some("mbt_compat::int_popcnt") }
    if method_name == "ctz" { return Some("mbt_compat::int_ctz") }
    if method_name == "clz" { return Some("mbt_compat::int_clz") }
    if method_name == "to_uint64" { return Some("mbt_compat::int_to_uint64") }
    if method_name == "compare" { return Some("mbt_compat::int_compare") }
    if method_name == "min" { return Some("mbt_compat::int_min") }
    if method_name == "max" { return Some("mbt_compat::int_max") }
  }
  if receiver_ty == "UInt" {
    if method_name == "compare" { return Some("mbt_compat::uint_compare") }
  }
  if receiver_ty == "Bool" {
    if method_name == "compare" { return Some("mbt_compat::bool_compare") }
  }
  if receiver_ty == "Bytes" {
    if method_name == "to_array" || method_name == "to_fixedarray" { return Some("mbt_compat::bytes_to_array") }
    if method_name == "clamped_view" || method_name == "view" { return Some("mbt_compat::bytes_clamped_view") }
  }
  if receiver_ty == "Int64" {
    if method_name == "to_byte" { return Some("mbt_compat::int64_to_byte") }
  }
  if receiver_ty == "UInt64" {
    if method_name == "lnot" { return Some("mbt_compat::uint64_lnot") }
  }
  if receiver_ty.starts_with("OrderedMap[") || receiver_ty.starts_with("mbt_compat::OrderedMap[") {
    if method_name == "size" || method_name == "length" { return Some("mbt_compat::ordered_map_size") }
    if method_name == "each" { return Some("mbt_compat::ordered_map_each") }
    if method_name == "iter" { return Some("mbt_compat::ordered_map_iter_lazy") }
  }
  if receiver_ty.starts_with("OrderedSet[") || receiver_ty.starts_with("mbt_compat::OrderedSet[") {
    if method_name == "iter" { return Some("mbt_compat::ordered_set_iter") }
  }
  None
}

///| `cannot access field `N` on `T`` with `T` a scalar / `String` / `Unit` / `<error>`: never a tuple struct.
fn field_access_on_scalar_or_error(msg : String) -> Bool {
  let p = "cannot access field `"
  let i = msg.index_of(p)
  if i < 0 {
    return false
  }
  let rest = msg.slice(i + p.length(), msg.length())
  let on = rest.index_of("` on `")
  if on < 0 {
    return false
  }
  let t0 = rest.slice(on + 6, rest.length())
  let te = t0.index_of("`")
  if te < 0 {
    return false
  }
  let t = t0.slice(0, te)
  t == "<error>" || t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Double" || t == "Float" ||
  t == "Bool" || t == "Byte" || t == "Char" || t == "String" || t == "Unit" || t == "Int16" || t == "Int8"
}

///| Arity of the tuple type `(T1, ..., Tn)` written at the start of `ty` (depth-0 commas + 1), or 0.
fn tuple_type_arity(ty : String) -> Int {
  if !ty.starts_with("(") || !ty.ends_with(")") {
    return 0
  }
  let mut d = 0
  let mut n = 1
  let mut i = 0
  while i < ty.length() {
    let ch = ty.code_unit_at(i)
    if ch == 40 || ch == 91 {
      d = d + 1
      if d == 1 && i != 0 && ch == 40 {
        ()
      }
    } else if ch == 41 || ch == 93 {
      d = d - 1
      if d == 0 && i != ty.length() - 1 {
        return 0
      }
    } else if ch == 44 && d == 1 {
      n = n + 1
    }
    i = i + 1
  }
  if n >= 2 { n } else { 0 }
}

///| `type `(A, B)` does not implement trait `mbt_compat::MapKey` required by `F`` with `F` one of the
///| `MapKey`-bound constructors: rewrite the `mbt_compat::F(` call nearest to `col` to `F_pair(` / `F_triple(`.
fn rewrite_tuple_mapkey_call_at(ln : String, col : Int, msg : String) -> Option[String] {
  let tp = "type `"
  let ti = msg.index_of(tp)
  if ti < 0 {
    return None
  }
  let rest = msg.slice(ti + tp.length(), msg.length())
  let te = rest.index_of("` does not implement")
  if te < 0 {
    return None
  }
  let arity = tuple_type_arity(rest.slice(0, te))
  let suffix = if arity == 2 { "_pair" } else if arity == 3 { "_triple" } else { "" }
  if suffix.length() == 0 {
    return None
  }
  let rp = "required by `"
  let ri = msg.index_of(rp)
  if ri < 0 {
    return None
  }
  let r2 = msg.slice(ri + rp.length(), msg.length())
  let re = r2.index_of("`")
  if re < 0 {
    return None
  }
  let f = r2.slice(0, re)
  if !(f == "ordered_map_new" || f == "ordered_map_from_array" || f == "ordered_map_new_cap" ||
    f == "ordered_map_from_array_cap") {
    return None
  }
  let needle = "mbt_compat::" + f + "("
  let target_0 = if col > 0 { col - 1 } else { 0 }
  let mut best = -1
  let mut best_dist = 1000000
  let mut pos = 0
  while pos + needle.length() <= ln.length() {
    if ln.slice(pos, pos + needle.length()) == needle {
      let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
      if dist < best_dist {
        best_dist = dist
        best = pos
      }
    }
    pos = pos + 1
  }
  if best < 0 {
    return None
  }
  let name_end = best + needle.length() - 1
  Some(ln.slice(0, name_end) + suffix + ln.slice(name_end, ln.length()))
}

///| Extract `(method_name, receiver_type)` from `unknown method `<m>` on type `<T>``.
fn parse_unknown_method_msg(msg : String) -> Option[(String, String)] {
  let p = "unknown method `"
  let idx = msg.index_of(p)
  if idx < 0 {
    return None
  }
  let rest = msg.slice(idx + p.length(), msg.length())
  let t1 = rest.index_of("`")
  if t1 < 0 {
    return None
  }
  let mname = rest.slice(0, t1)
  let on_ty = " on type `"
  let idx2 = rest.index_of(on_ty)
  if idx2 < 0 {
    return None
  }
  let rest2 = rest.slice(idx2 + on_ty.length(), rest.length())
  let t2 = rest2.index_of("`")
  if t2 < 0 {
    return None
  }
  Some((mname, rest2.slice(0, t2)))
}

///| Find the `.method_name(` offset on `line_text` closest to 1-based column `col` (P1-5).
fn find_method_dot_at_col(line_text : String, method_name : String, col : Int) -> Int {
  let needle = "." + method_name + "("
  let n = line_text.length()
  let m = needle.length()
  let target_0 = if col > 0 { col - 1 } else { 0 }
  let mut best = -1
  let mut best_dist = 1000000
  let mut pos = 0
  while pos <= n - m {
    if line_text.slice(pos, pos + m) == needle {
      let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
      if dist < best_dist {
        best_dist = dist
        best = pos
      }
      pos = pos + 1
    } else {
      pos = pos + 1
    }
  }
  best
}

///| Index of the `"` closing the string literal opened at `q` on `s`, skipping escapes and `\{...}`
///| interpolations (whose code may hold quotes, parens and commas); `-1` if it does not close on `s`.
fn skip_string_lit(s : String, q : Int) -> Int {
  let mut i = q + 1
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 92 {
      if i + 1 < s.length() && s.code_unit_at(i + 1) == 123 {
        let k = skip_string_interp(s, i + 1)
        if k < 0 {
          return -1
        }
        i = k + 1
      } else {
        i = i + 2
      }
    } else if c == 34 {
      return i
    } else {
      i = i + 1
    }
  }
  -1
}

///| Index of the `}` closing the interpolation whose `{` is at `b` on `s`; `-1` if it does not close on `s`.
fn skip_string_interp(s : String, b : Int) -> Int {
  let mut depth = 1
  let mut i = b + 1
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 34 {
      let k = skip_string_lit(s, i)
      if k < 0 {
        return -1
      }
      i = k
    } else if c == 39 {
      let mut k = i + 1
      if k < s.length() && s.code_unit_at(k) == 92 {
        k = k + 2
      } else {
        k = k + 1
      }
      while k < s.length() && s.code_unit_at(k) != 39 {
        k = k + 1
      }
      if k >= s.length() {
        return -1
      }
      i = k
    } else if c == 123 {
      depth = depth + 1
    } else if c == 125 {
      depth = depth - 1
      if depth == 0 {
        return i
      }
    }
    i = i + 1
  }
  -1
}

///| Rewrite a missing method call at `(lidx, col)` -> `helper(recv, args)`.
///| Supports:
///| - Column-precise disambiguation when multiple `.m(...)` calls share one line
///| - Multiline / newline-leading method chains (`xs\n  .map(...)\n  .filter(...)`)
///| - Complex/chained receivers (`pkg::fn(a, b).m()`, `arr[i].m()`).
fn rewrite_method_call_at(
  lines : Array[String],
  lidx : Int,
  col : Int,
  method_name : String,
  helper : String,
) -> Bool {
  let line_text = lines[lidx]
  let needle = "." + method_name + "("
  let dot_idx = find_method_dot_at_col(line_text, method_name, col)
  if dot_idx < 0 {
    return false
  }
  let arg_start = dot_idx + needle.length()
  let mut depth = 1
  let mut arg_end_l = lidx
  let mut j = arg_start
  let mut in_s = false
  let mut esc = false
  while arg_end_l < lines.length() && depth > 0 {
    let aln = lines[arg_end_l]
    while j < aln.length() && depth > 0 {
      let c = aln.code_unit_at(j)
      if in_s {
        if esc { esc = false }
        else if c == 92 { esc = true }
        else if c == 34 { in_s = false }
      } else if c == 34 {
        // Skip the whole literal so quotes / parens inside `\{...}` interpolations are not call syntax.
        let k = skip_string_lit(aln, j)
        if k < 0 {
          in_s = true
        } else {
          j = k
        }
      } else if c == 47 && j + 1 < aln.length() && aln.code_unit_at(j + 1) == 47 {
        break
      } else if c == 40 {
        depth = depth + 1
      } else if c == 41 {
        depth = depth - 1
        if depth == 0 {
          break
        }
      }
      j = j + 1
    }
    if depth == 0 {
      break
    }
    arg_end_l = arg_end_l + 1
    j = 0
  }
  if depth != 0 {
    return false
  }
  if arg_end_l > lidx {
    // Multi-line argument list spanning `[lidx .. arg_end_l]`
    let mut recv_start = dot_idx - 1
    let mut paren_d = 0
    let mut brack_d = 0
    while recv_start >= 0 {
      let c = line_text.code_unit_at(recv_start)
      if c == 41 { paren_d = paren_d + 1; recv_start = recv_start - 1 }
      else if c == 40 { if paren_d == 0 { break }; paren_d = paren_d - 1; recv_start = recv_start - 1 }
      else if c == 93 { brack_d = brack_d + 1; recv_start = recv_start - 1 }
      else if c == 91 { if brack_d == 0 { break }; brack_d = brack_d - 1; recv_start = recv_start - 1 }
      else if paren_d > 0 || brack_d > 0 { recv_start = recv_start - 1 }
      else if is_alnum(c) || c == 95 || c == 46 || c == 58 { recv_start = recv_start - 1 }
      else { break }
    }
    recv_start = recv_start + 1
    if paren_d != 0 || brack_d != 0 || recv_start >= dot_idx {
      return false
    }
    let recv = line_text.slice(recv_start, dot_idx)
    let first_arg_rest = line_text.slice(arg_start, line_text.length())
    let clean_rest = if helper == "mbt_compat::arr_fold" && first_arg_rest.trim().starts_with("init=") {
      let idx_eq = first_arg_rest.index_of("init=")
      first_arg_rest.slice(0, idx_eq) + first_arg_rest.slice(idx_eq + 5, first_arg_rest.length())
    } else {
      first_arg_rest
    }
    if helper == "mbt_compat::arr_release_unused" {
      // Preserve `placeholder=<expr>` side effects via `mbt_compat::arr_release_unused_with(recv, <expr>)`!
      let mut cleaned_first = first_arg_rest
      let idx_ph = cleaned_first.index_of("placeholder=")
      if idx_ph >= 0 {
        cleaned_first = cleaned_first.slice(0, idx_ph) + cleaned_first.slice(idx_ph + 12, cleaned_first.length())
      } else {
        // Check next line for `placeholder=`
        let mut nl = lidx + 1
        while nl <= arg_end_l {
          let ph2 = lines[nl].index_of("placeholder=")
          if ph2 >= 0 {
            lines[nl] = lines[nl].slice(0, ph2) + lines[nl].slice(ph2 + 12, lines[nl].length())
            break
          }
          nl = nl + 1
        }
      }
      lines[lidx] = line_text.slice(0, recv_start) + "mbt_compat::arr_release_unused_with(" + recv + ", " + cleaned_first
      return true
    }
    lines[lidx] = line_text.slice(0, recv_start) + helper + "(" + recv + ", " + clean_rest
    return true
  }
  let raw_args = line_text.slice(arg_start, j).trim()
  let mut eff_helper = helper
  let args = if helper == "mbt_compat::arr_fold" && raw_args.starts_with("init=") {
    raw_args.slice(5, raw_args.length()).trim()
  } else if helper == "mbt_compat::arr_release_unused" && raw_args.length() > 0 {
    eff_helper = "mbt_compat::arr_release_unused_with"
    if raw_args.starts_with("placeholder=") {
      raw_args.slice(12, raw_args.length()).trim()
    } else {
      raw_args
    }
  } else {
    raw_args
  }
  let tail = line_text.slice(j + 1, line_text.length())
  let before_dot = line_text.slice(0, dot_idx)

  // Newline-leading chain (`  .map(...)` where only whitespace precedes `.` on this line)
  if before_dot.trim().length() == 0 && lidx > 0 {
    let mut prev_l = lidx - 1
    while prev_l >= 0 && lines[prev_l].trim().length() == 0 {
      prev_l = prev_l - 1
    }
    if prev_l < 0 {
      return false
    }
    let prev_line = lines[prev_l]
    // Find receiver expression ending at `prev_line` (supporting multi-line `[ ... ]` or `( ... )` receivers!)
    let mut r_end = prev_line.length() - 1
    while r_end >= 0 && (prev_line.code_unit_at(r_end) == 32 || prev_line.code_unit_at(r_end) == 9) {
      r_end = r_end - 1
    }
    if r_end < 0 {
      return false
    }
    let mut cur_l = prev_l
    let mut r_start = r_end
    let mut pd = 0
    let mut bd = 0
    while cur_l >= 0 {
      let cln = lines[cur_l]
      while r_start >= 0 {
        let c = cln.code_unit_at(r_start)
        if c == 41 {
          pd = pd + 1
          r_start = r_start - 1
        } else if c == 40 {
          if pd == 0 { break }
          pd = pd - 1
          r_start = r_start - 1
        } else if c == 93 {
          bd = bd + 1
          r_start = r_start - 1
        } else if c == 91 {
          if bd == 0 { break }
          bd = bd - 1
          r_start = r_start - 1
        } else if pd > 0 || bd > 0 {
          r_start = r_start - 1
        } else if is_alnum(c) || c == 95 || c == 46 || c == 58 {
          r_start = r_start - 1
        } else {
          break
        }
      }
      if pd == 0 && bd == 0 {
        break
      }
      cur_l = cur_l - 1
      if cur_l >= 0 {
        r_start = lines[cur_l].length() - 1
      }
    }
    if cur_l < 0 || pd != 0 || bd != 0 {
      return false
    }
    r_start = r_start + 1
    if cur_l == prev_l {
      if r_start > r_end {
        return false
      }
      let recv = prev_line.slice(r_start, r_end + 1)
      let call = if args.length() > 0 {
        eff_helper + "(" + recv + ", " + args + ")"
      } else {
        eff_helper + "(" + recv + ")"
      }
      lines[prev_l] = prev_line.slice(0, r_start) + call + tail
      lines[lidx] = ""
      // Pull any immediately following single-line chained `.method(...)` lines onto `lines[prev_l]`
      // so blanking `lines[lidx]` never severs a multi-line method chain (e.g. `.exact_view(...)\n.to_owned()\n.split(",")`).
      if tail.trim().length() == 0 {
        let mut nxt_l = lidx + 1
        while nxt_l < lines.length() {
          let nt = lines[nxt_l].trim()
          if nt.length() == 0 {
            nxt_l = nxt_l + 1
            continue
          }
          if !nt.starts_with(".") {
            break
          }
          // Only pull if `nt` is balanced on parens/brackets/braces on its own line
          let mut nd = 0
          let mut nin_s = false
          let mut nesc = false
          let mut ni = 0
          while ni < nt.length() {
            let ch = nt.code_unit_at(ni)
            if nin_s {
              if nesc { nesc = false }
              else if ch == 92 { nesc = true }
              else if ch == 34 { nin_s = false }
            } else if ch == 34 {
              nin_s = true
            } else if ch == 47 && ni + 1 < nt.length() && nt.code_unit_at(ni + 1) == 47 {
              break
            } else if ch == 40 || ch == 91 || ch == 123 {
              nd = nd + 1
            } else if ch == 41 || ch == 93 || ch == 125 {
              nd = nd - 1
            }
            ni = ni + 1
          }
          if nd != 0 || nin_s {
            break
          }
          lines[prev_l] = lines[prev_l] + nt
          lines[nxt_l] = ""
          nxt_l = nxt_l + 1
        }
      }
      return true
    } else {
      // Multi-line receiver spanning lines `[cur_l .. prev_l]`
      let first_ln = lines[cur_l]
      let close_call = if args.length() > 0 { ", " + args + ")" } else { ")" }
      lines[cur_l] = first_ln.slice(0, r_start) + eff_helper + "(" + first_ln.slice(r_start, first_ln.length())
      lines[prev_l] = prev_line.slice(0, r_end + 1) + close_call + tail
      lines[lidx] = ""
      return true
    }
  }

  let mut cur_l = lidx
  let mut recv_start = dot_idx - 1
  let mut paren_d = 0
  let mut brack_d = 0
  while cur_l >= 0 {
    let cln = lines[cur_l]
    while recv_start >= 0 {
      let c = cln.code_unit_at(recv_start)
      if c == 41 {
        paren_d = paren_d + 1
        recv_start = recv_start - 1
      } else if c == 40 {
        if paren_d == 0 {
          break
        }
        paren_d = paren_d - 1
        recv_start = recv_start - 1
      } else if c == 93 {
        brack_d = brack_d + 1
        recv_start = recv_start - 1
      } else if c == 91 {
        if brack_d == 0 {
          break
        }
        brack_d = brack_d - 1
        recv_start = recv_start - 1
      } else if paren_d > 0 || brack_d > 0 {
        recv_start = recv_start - 1
      } else if c == 34 {
        // Walk backwards over string literal `"..."`
        recv_start = recv_start - 1
        while recv_start >= 0 {
          if cln.code_unit_at(recv_start) == 34 && !(recv_start > 0 && cln.code_unit_at(recv_start - 1) == 92) {
            recv_start = recv_start - 1
            break
          }
          recv_start = recv_start - 1
        }
      } else if c == 39 {
        // Walk backwards over char literal `'...'`
        recv_start = recv_start - 1
        while recv_start >= 0 {
          if cln.code_unit_at(recv_start) == 39 && !(recv_start > 0 && cln.code_unit_at(recv_start - 1) == 92) {
            recv_start = recv_start - 1
            break
          }
          recv_start = recv_start - 1
        }
      } else if is_alnum(c) || c == 95 || c == 46 || c == 58 {
        recv_start = recv_start - 1
      } else {
        break
      }
    }
    if paren_d == 0 && brack_d == 0 {
      break
    }
    cur_l = cur_l - 1
    if cur_l >= 0 {
      recv_start = lines[cur_l].length() - 1
    }
  }
  if cur_l < 0 || paren_d != 0 || brack_d != 0 {
    return false
  }
  recv_start = recv_start + 1
  if cur_l == lidx {
    if recv_start >= dot_idx {
      return false
    }
    let recv = line_text.slice(recv_start, dot_idx)
    let call = if args.length() > 0 {
      eff_helper + "(" + recv + ", " + args + ")"
    } else {
      eff_helper + "(" + recv + ")"
    }
    lines[lidx] = line_text.slice(0, recv_start) + call + tail
    return true
  }
  // Multi-line receiver spanning `[cur_l .. lidx]` ending at `dot_idx` on `lidx`
  let first_ln = lines[cur_l]
  let close_call = if args.length() > 0 { ", " + args + ")" } else { ")" }
  lines[cur_l] = first_ln.slice(0, recv_start) + eff_helper + "(" + first_ln.slice(recv_start, first_ln.length())
  lines[lidx] = line_text.slice(0, dot_idx) + close_call + tail
  true
}

///| True iff the trimmed argument `piece` is a labelled / punned argument (`x=v`, `x?=v`, `x~`).
fn unsafe_index_arg_is_labelled(piece : String) -> Bool {
  let t = piece.trim()
  if t.length() == 0 {
    return false
  }
  if t.code_unit_at(t.length() - 1) == 126 {
    return true
  }
  if !is_alpha(t.code_unit_at(0)) {
    return false
  }
  let mut k = 1
  while k < t.length() && is_alnum(t.code_unit_at(k)) {
    k = k + 1
  }
  while k < t.length() && (t.code_unit_at(k) == 32 || t.code_unit_at(k) == 9) {
    k = k + 1
  }
  if k < t.length() && t.code_unit_at(k) == 63 {
    k = k + 1
  }
  k < t.length() && t.code_unit_at(k) == 61 && !(k + 1 < t.length() && t.code_unit_at(k + 1) == 61)
}

///| Wave M2-F3e: lower `Array[T]` / `FixedArray[T]` `recv.unsafe_get(i)` to native `recv[i]` and
///| `recv.unsafe_set(i, v)` to `{ recv[i] = v }` instead of a cross-package generic helper call.
///| Pion evaluates `recv`, then `i`, then `v` (left to right) for both `recv[i]` and `recv[i] = v`, accepts
///| any receiver expression (`get_arr()[i] = v`), and a `{ ... }` block is valid in statement and expression
///| position, so this preserves MoonBit semantics exactly. Fails closed (returns `-1`; the caller falls back
///| to the `mbt_compat` helper) on anything else: a receiver not wholly on the diagnostic line, a wrong
///| positional argument count, labelled arguments, `/*` or multi-line strings inside the argument list.
///| `//` line comments inside the arguments are kept, each commented argument ending with a newline.
///| Returns the last source line the rewritten call spanned.
fn rewrite_unsafe_index_at(lines : Array[String], lidx : Int, col : Int, method_name : String) -> Int {
  let want_args = if method_name == "unsafe_get" { 1 } else if method_name == "unsafe_set" { 2 } else { 0 }
  if want_args == 0 {
    return -1
  }
  let line_text = lines[lidx]
  let dot_idx = find_method_dot_at_col(line_text, method_name, col)
  if dot_idx < 0 {
    return -1
  }
  // 1. Argument list up to the matching `)` (may span lines), split at depth-0 commas.
  let pieces : Array[String] = []
  let commented : Array[Bool] = []
  let mut cur = ""
  let mut cur_comment = false
  let mut depth = 0
  let mut in_c = false
  let mut esc = false
  let mut end_l = lidx
  let mut j = dot_idx + method_name.length() + 2
  let mut seg_start = j
  let mut close_j = -1
  while end_l < lines.length() {
    let ln = lines[end_l]
    while j < ln.length() {
      let c = ln.code_unit_at(j)
      if in_c {
        if esc {
          esc = false
        } else if c == 92 {
          esc = true
        } else if c == 39 {
          in_c = false
        }
      } else if c == 34 {
        // A whole literal, interpolations included; one that does not close on this line fails closed.
        let k = skip_string_lit(ln, j)
        if k < 0 {
          return -1
        }
        j = k
      } else if c == 39 {
        in_c = true
      } else if c == 47 && j + 1 < ln.length() && ln.code_unit_at(j + 1) == 42 {
        return -1
      } else if c == 47 && j + 1 < ln.length() && ln.code_unit_at(j + 1) == 47 {
        cur_comment = true
        j = ln.length()
        break
      } else if c == 35 && j + 1 < ln.length() && ln.code_unit_at(j + 1) == 124 {
        return -1
      } else if c == 40 || c == 91 || c == 123 {
        depth = depth + 1
      } else if c == 41 || c == 93 || c == 125 {
        if depth == 0 {
          if c != 41 {
            return -1
          }
          close_j = j
          break
        }
        depth = depth - 1
      } else if c == 44 && depth == 0 {
        pieces.push(cur + ln.slice(seg_start, j))
        commented.push(cur_comment)
        cur = ""
        cur_comment = false
        seg_start = j + 1
      }
      j = j + 1
    }
    if close_j >= 0 {
      break
    }
    if in_c {
      return -1
    }
    cur = cur + ln.slice(seg_start, ln.length()) + "\n"
    end_l = end_l + 1
    j = 0
    seg_start = 0
  }
  if close_j < 0 {
    return -1
  }
  pieces.push(cur + lines[end_l].slice(seg_start, close_j))
  commented.push(cur_comment)
  if pieces.length() > 1 && pieces[pieces.length() - 1].trim().length() == 0 {
    let _ = pieces.pop()
    let _ = commented.pop()
  }
  if pieces.length() != want_args {
    return -1
  }
  let args : Array[String] = []
  let mut ai = 0
  while ai < pieces.length() {
    // Label check on the code lines only (a whole-line `//` comment may precede `name=`).
    let mut code = ""
    for pl in pieces[ai].split("\n") {
      if !pl.trim().starts_with("//") {
        code = code + pl + "\n"
      }
    }
    if code.trim().length() == 0 || unsafe_index_arg_is_labelled(code) {
      return -1
    }
    // A commented argument keeps a trailing newline so the comment never swallows `]` / `}`.
    args.push(if commented[ai] { pieces[ai].trim() + "\n" } else { pieces[ai].trim() })
    ai = ai + 1
  }
  // 2. Receiver: a postfix expression ending at `dot_idx`, wholly on line `lidx`.
  let mut rs = dot_idx - 1
  let mut paren_d = 0
  let mut brack_d = 0
  while rs >= 0 {
    let c = line_text.code_unit_at(rs)
    if c == 41 {
      paren_d = paren_d + 1
    } else if c == 40 {
      if paren_d == 0 {
        break
      }
      paren_d = paren_d - 1
    } else if c == 93 {
      brack_d = brack_d + 1
    } else if c == 91 {
      if brack_d == 0 {
        break
      }
      brack_d = brack_d - 1
    } else if paren_d > 0 || brack_d > 0 {
      if c == 34 || c == 39 {
        return -1
      }
    } else if c == 58 {
      // Only a path separator `::` belongs to the receiver; a lone `:` (`{key:a.unsafe_get(0)}`) ends it.
      if !(rs > 0 && line_text.code_unit_at(rs - 1) == 58) {
        break
      }
      rs = rs - 1
    } else if !(is_alnum(c) || c == 46) {
      break
    }
    rs = rs - 1
  }
  if paren_d != 0 || brack_d != 0 {
    return -1
  }
  rs = rs + 1
  if rs >= dot_idx {
    return -1
  }
  let recv = line_text.slice(rs, dot_idx)
  let rc0 = recv.code_unit_at(0)
  if !(is_alpha(rc0) || rc0 == 40 || rc0 == 91) || recv.code_unit_at(recv.length() - 1) == 58 {
    return -1
  }
  let repl = if want_args == 1 {
    recv + "[" + args[0] + "]"
  } else {
    "{ " + recv + "[" + args[0] + "] = " + args[1] + " }"
  }
  let last = lines[end_l]
  lines[lidx] = line_text.slice(0, rs) + repl + last.slice(close_j + 1, last.length())
  let mut bl = lidx + 1
  while bl <= end_l {
    lines[bl] = ""
    bl = bl + 1
  }
  end_l
}

///| Extract the argument value for a labeled argument `name=<val>` in a call line.
fn extract_labeled_arg(ln : String, name : String) -> Option[(Int, Int, String)] {
  let lbl = name + "="
  let li = ln.index_of(lbl)
  if li < 0 {
    return None
  }
  let val_start = li + lbl.length()
  let mut val_end = val_start
  let mut depth = 0
  while val_end < ln.length() {
    let c = ln.code_unit_at(val_end)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      if depth == 0 {
        break
      }
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      break
    }
    val_end = val_end + 1
  }
  Some((val_start, val_end, ln.slice(val_start, val_end).trim()))
}

///| Check whether `expr` is a pure simple identifier or string literal (safe to duplicate without side effects).
fn is_pure_str_atom(expr : String) -> Bool {
  let t = expr.trim()
  if t.length() == 0 {
    return true
  }
  if t.starts_with("\"") && t.ends_with("\"") {
    return true
  }
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    if !(is_alnum(c) || c == 95) {
      return false
    }
    i = i + 1
  }
  true
}

///| Token-based `api_map.json` boundary conversion (Astra P0-5):
///| - Uses `lex_moonbit` so string literals (e.g. `"acme::caret(text=s, offset=1)"`) are NEVER modified!
///| - Evaluates ALL arguments strictly left-to-right into hygienic temp bindings before calling,
///|   so `caret(offset=off(), text=txt())` preserves `off()` -> `txt()` order and evaluates each arg ONCE!
///| - Handles nested calls and multiple calls on the same line.
///| - Hard-fails (`MBT2PION_MISSING_STR_PARAM`) when `utf8`/`scalar` conversion lacks `str_param`.
pub fn apply_api_boundary_conversions(
  content : String,
  api_map : ApiMap,
  file : String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> String {
  if api_map.symbols.length() == 0 {
    return content
  }
  let mut cur = content
  let mut tmp_seq = 0
  for sym in api_map.symbols {
    let mut needs_conv = false
    for p in sym.params {
      if p.unit == "utf8" || p.unit == "scalar" ||
      p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
        needs_conv = true
      }
    }
    if !needs_conv {
      continue
    }
    let call_name = if sym.target_pkg.length() > 0 {
      sym.target_pkg + "::" + sym.target_name
    } else {
      sym.target_name
    }
    // Iterate up to 4 passes to support nested calls of the same symbol bottom-up
    let mut pass = 0
    while pass < 4 {
      let toks = lex_moonbit(cur)
      let n = toks.length() - 1
      let edits : Array[(Int, Int, String)] = []
      let mut covered_end = 0
      let mut i = 0
      while i < n {
        if toks[i].start_byte < covered_end {
          i = i + 1
          continue
        }
        let mut call_start_tok = -1
        let mut open_p = -1
        if sym.target_pkg.length() > 0 {
          if i + 3 < n && toks[i].kind == TokenKind::Ident && toks[i].raw == sym.target_pkg &&
          toks[i + 1].kind == TokenKind::ColonColon &&
          toks[i + 2].kind == TokenKind::Ident && toks[i + 2].raw == sym.target_name &&
          toks[i + 3].kind == TokenKind::LParen {
            call_start_tok = i
            open_p = i + 3
          }
        } else {
          let prev_dot_cc = i > 0 && (toks[i - 1].kind == TokenKind::Dot || toks[i - 1].kind == TokenKind::ColonColon)
          if !prev_dot_cc && i + 1 < n && toks[i].kind == TokenKind::Ident && toks[i].raw == sym.target_name &&
          toks[i + 1].kind == TokenKind::LParen {
            call_start_tok = i
            open_p = i + 1
          }
        }
        if call_start_tok < 0 {
          i = i + 1
          continue
        }
        let close_p = find_matching_delim(toks, open_p)
        // Parse depth-0 arguments `(label, val_expr)`
        let arg_labels : Array[String] = []
        let arg_vals : Array[String] = []
        let mut ai = open_p + 1
        while ai < close_p {
          if toks[ai].kind == TokenKind::Comma {
            ai = ai + 1
            continue
          }
          let mut ae = ai
          let mut ad = 0
          while ae < close_p {
            let ak = toks[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace {
              ad = ad + 1
            } else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace {
              ad = ad - 1
            } else if ad == 0 && ak == TokenKind::Comma {
              break
            }
            ae = ae + 1
          }
          if ae > ai {
            if ae - ai >= 3 && toks[ai].kind == TokenKind::Ident && toks[ai + 1].kind == TokenKind::Eq {
              arg_labels.push(toks[ai].raw)
              arg_vals.push(cur.slice(toks[ai + 2].start_byte, toks[ae - 1].end_byte).trim())
            } else {
              arg_labels.push("")
              arg_vals.push(cur.slice(toks[ai].start_byte, toks[ae - 1].end_byte).trim())
            }
          }
          ai = ae + 1
        }

        // Astra Round 3 P0-4: Bind BOTH named and positional arguments to `sym.params` in signature order!
        let bound_params : Array[String] = []
        let used_param : Map[String, Bool] = Map()
        for lbl in arg_labels {
          if lbl.length() > 0 {
            used_param[lbl] = true
          }
        }
        let mut next_pos_p = 0
        let mut bk = 0
        while bk < arg_labels.length() {
          if arg_labels[bk].length() > 0 {
            bound_params.push(arg_labels[bk])
          } else {
            // Astra Round 4 P0-4: optional/default params (`flag? : T = d`) are label-only in MoonBit
            // and must NEVER consume positional arguments!
            while next_pos_p < sym.params.length() &&
            (used_param.contains(sym.params[next_pos_p].name) ||
              sym.params[next_pos_p].is_optional ||
              sym.params[next_pos_p].has_default) {
              next_pos_p = next_pos_p + 1
            }
            if next_pos_p < sym.params.length() {
              let pname = sym.params[next_pos_p].name
              bound_params.push(pname)
              used_param[pname] = true
              next_pos_p = next_pos_p + 1
            } else {
              bound_params.push("")
            }
          }
          bk = bk + 1
        }

        // Check if any param of this call still needs conversion
        let mut call_needs_edit = false
        for p in sym.params {
          let mut idx_p = -1
          let mut k = 0
          while k < bound_params.length() {
            if bound_params[k] == p.name { idx_p = k; break }
            k = k + 1
          }
          if idx_p < 0 { continue }
          if p.unit == "utf8" || p.unit == "scalar" {
            let helper = if p.unit == "utf8" { "mbt_compat::utf16_to_utf8_off" } else { "mbt_compat::utf16_to_scalar_off" }
            if !str_has(arg_vals[idx_p], helper + "(") {
              if p.str_param.length() == 0 {
                diags.push(diag_error(
                  "MBT2PION_MISSING_STR_PARAM",
                  file,
                  toks[call_start_tok].line,
                  toks[call_start_tok].col,
                  "api_map boundary conversion for `" + call_name + "(" + p.name + ")` requires `str_param` to supply string argument to `" + helper + "(s, off)`",
                ))
              } else {
                // Verify str_param is actually bound at this call site!
                let mut found_sp = false
                let mut sk = 0
                while sk < bound_params.length() {
                  if bound_params[sk] == p.str_param {
                    found_sp = true
                    break
                  }
                  sk = sk + 1
                }
                if !found_sp {
                  diags.push(diag_error(
                    "MBT2PION_MISSING_STR_PARAM",
                    file,
                    toks[call_start_tok].line,
                    toks[call_start_tok].col,
                    "api_map boundary conversion for `" + call_name + "(" + p.name + ")` requires bound string argument `" + p.str_param + "`",
                  ))
                } else {
                  call_needs_edit = true
                }
              }
            }
          } else if p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
            let helper = if p.map_boundary == "ordered_to_map" { "mbt_compat::ordered_map_to_map" } else { "mbt_compat::ordered_map_from_map" }
            if !str_has(arg_vals[idx_p], helper + "(") {
              call_needs_edit = true
            }
          }
        }

        if call_needs_edit {
          // Bind EVERY argument strictly left-to-right in source order into a temp!
          let temps : Array[String] = []
          let mut needs_block = false
          let mut k = 0
          while k < arg_vals.length() {
            if !is_pure_str_atom(arg_vals[k]) {
              needs_block = true
            }
            k = k + 1
          }
          let sb = StringBuilder()
          if needs_block {
            sb.write_string("{ ")
            k = 0
            while k < arg_vals.length() {
              let tname = "__mbt_s_" + tmp_seq.to_string()
              tmp_seq = tmp_seq + 1
              temps.push(tname)
              sb.write_string("let " + tname + " = " + arg_vals[k] + "; ")
              k = k + 1
            }
          } else {
            k = 0
            while k < arg_vals.length() {
              temps.push(arg_vals[k])
              k = k + 1
            }
          }

          // Build converted argument list using temp bindings, matching by `bound_params[k]`
          let final_args : Array[String] = []
          k = 0
          while k < arg_labels.length() {
            let orig_lbl = arg_labels[k]
            let bname = bound_params[k]
            let mut val_expr = temps[k]
            for p in sym.params {
              if p.name == bname {
                if p.unit == "utf8" || p.unit == "scalar" {
                  let helper = if p.unit == "utf8" { "mbt_compat::utf16_to_utf8_off" } else { "mbt_compat::utf16_to_scalar_off" }
                  if p.str_param.length() > 0 && !str_has(arg_vals[k], helper + "(") {
                    let mut str_ref = p.str_param
                    let mut sk = 0
                    while sk < bound_params.length() {
                      if bound_params[sk] == p.str_param {
                        str_ref = temps[sk]
                        break
                      }
                      sk = sk + 1
                    }
                    val_expr = helper + "(" + str_ref + ", " + val_expr + ")"
                    drift_ledger.push(DriftEntry::{
                      category: "string_unit_boundary",
                      file: file,
                      line: toks[call_start_tok].line,
                      col: toks[call_start_tok].col,
                      expr: call_name + "(" + p.name + "=" + arg_vals[k] + ")",
                      resolution: helper,
                      status: "resolved",
                      detail: "converted UTF-16 offset to " + p.unit + " at api_map boundary with string arg `" + str_ref + "`",
                    })
                  }
                } else if p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
                  let helper = if p.map_boundary == "ordered_to_map" { "mbt_compat::ordered_map_to_map" } else { "mbt_compat::ordered_map_from_map" }
                  if !str_has(arg_vals[k], helper + "(") {
                    val_expr = helper + "(" + val_expr + ")"
                    drift_ledger.push(DriftEntry::{
                      category: "ordered_map_boundary",
                      file: file,
                      line: toks[call_start_tok].line,
                      col: toks[call_start_tok].col,
                      expr: call_name + "(" + p.name + "=" + arg_vals[k] + ")",
                      resolution: helper,
                      status: "resolved",
                      detail: "converted map boundary with " + helper,
                    })
                  }
                }
              }
            }
            if orig_lbl.length() > 0 {
              final_args.push(orig_lbl + "=" + val_expr)
            } else {
              final_args.push(val_expr)
            }
            k = k + 1
          }

          sb.write_string(call_name + "(")
          k = 0
          while k < final_args.length() {
            if k > 0 { sb.write_string(", ") }
            sb.write_string(final_args[k])
            k = k + 1
          }
          sb.write_string(")")
          if needs_block {
            sb.write_string(" }")
          }
          let start_b = toks[call_start_tok].start_byte
          let end_b = toks[close_p].end_byte
          edits.push((start_b, end_b, sb.to_string()))
          covered_end = end_b
          i = close_p + 1
          continue
        }
        i = i + 1
      }
      if edits.length() == 0 {
        break
      }
      cur = apply_byte_edits(cur, edits)
      pass = pass + 1
    }
  }
  cur
}

///| Format a coerced `IntLit` token cleanly without 32-bit truncation:
///| - `Int -> Double`: decimal `4294967296` -> `4294967296.0` (never `.to_double()`!)
///| - `Int -> Int64`: `4294967296` -> `4294967296L` (never `.to_int64()`!)
///| - `Int -> Byte`: `0` -> `0.to_byte()`
fn format_coerced_int_lit(tok : Token, suffix_method : String) -> Option[String] {
  let raw = tok.raw
  if suffix_method == "to_double" {
    if raw.starts_with("0x") || raw.starts_with("0X") || raw.starts_with("0b") || raw.starts_with("0B") || raw.starts_with("0o") || raw.starts_with("0O") {
      match parse_int_literal_u64(tok) {
        Some((u, ovf)) => if !ovf { return Some(u.to_string() + ".0") } else { return None }
        None => return None
      }
    }
    // Strip underscores and any integer suffix
    let sb = StringBuilder()
    let mut i = 0
    while i < raw.length() {
      let c = raw.code_unit_at(i)
      if c >= 48 && c <= 57 { sb.write_char(c.unsafe_to_char()) }
      i = i + 1
    }
    let clean = sb.to_string()
    if clean.length() == 0 { return None }
    return Some(clean + ".0")
  }
  if suffix_method == "to_int64" {
    if raw.ends_with("L") || raw.ends_with("l") || raw.ends_with("U") || raw.ends_with("u") {
      return None
    }
    return Some(raw + "L")
  }
  if suffix_method == "to_byte" {
    return Some(raw + ".to_byte()")
  }
  Some(raw + "." + suffix_method + "()")
}

///| Token-precise numeric literal coercion at 1-based column `col` on a single line.
///| Only rewrites `TokenKind::IntLit` (never `Ident` variables!) and never crosses statement boundaries.
pub fn coerce_numeric_token_at_col(ln : String, col : Int, suffix_method : String) -> Option[String] {
  let toks = lex_moonbit(ln)
  let mut i = 0
  while i < toks.length() - 1 {
    let t = toks[i]
    let tok_end_col = t.col + (t.end_byte - t.start_byte)
    if t.kind == TokenKind::IntLit && col >= t.col && col <= tok_end_col {
      if i + 2 < toks.length() - 1 && toks[i + 1].kind == TokenKind::Dot && toks[i + 2].raw == suffix_method {
        return None
      }
      match format_coerced_int_lit(t, suffix_method) {
        Some(repl) => return Some(ln.slice(0, t.start_byte) + repl + ln.slice(t.end_byte, ln.length()))
        None => return None
      }
    }
    i = i + 1
  }
  // Fallback for `let x : Double = 0`, `if x > 0`, `if c { 3 } else { 4 }` where `d.col` points to `let`/`>`/`if`.
  // Strictly stops at statement/clause boundaries (`;`, depth-0 `}`, `&&`, `||`) so sibling expressions are NEVER touched!
  if suffix_method == "to_double" || suffix_method == "to_int64" {
    let mut k = 0
    let mut depth = 0
    while k < toks.length() - 1 {
      let tk = toks[k]
      if tk.col < col {
        k = k + 1
        continue
      }
      if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace {
        depth = depth + 1
        k = k + 1
        continue
      }
      if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace {
        if depth == 0 && tk.kind == TokenKind::RBrace {
          break
        }
        if depth > 0 { depth = depth - 1 }
        k = k + 1
        continue
      }
      if depth == 0 && (tk.kind == TokenKind::Semi || tk.kind == TokenKind::AmpAmp || tk.kind == TokenKind::PipePipe) {
        break
      }
      if tk.kind == TokenKind::IntLit {
        if !(k + 2 < toks.length() - 1 && toks[k + 1].kind == TokenKind::Dot && toks[k + 2].raw == suffix_method) {
          let prev_ok = k > 0 && (toks[k - 1].kind == TokenKind::Eq || toks[k - 1].kind == TokenKind::Lt ||
            toks[k - 1].kind == TokenKind::Gt || toks[k - 1].kind == TokenKind::LtEq ||
            toks[k - 1].kind == TokenKind::GtEq || toks[k - 1].kind == TokenKind::EqEq ||
            toks[k - 1].kind == TokenKind::BangEq || toks[k - 1].kind == TokenKind::Minus ||
            toks[k - 1].kind == TokenKind::Plus || toks[k - 1].kind == TokenKind::Star ||
            toks[k - 1].kind == TokenKind::Slash || toks[k - 1].kind == TokenKind::Comma ||
            toks[k - 1].kind == TokenKind::LParen || toks[k - 1].kind == TokenKind::LBrace ||
            toks[k - 1].kind == TokenKind::FatArrow ||
            (toks[k - 1].kind == TokenKind::Keyword && toks[k - 1].raw == "else"))
          if prev_ok {
            match format_coerced_int_lit(tk, suffix_method) {
              Some(repl) => return Some(ln.slice(0, tk.start_byte) + repl + ln.slice(tk.end_byte, ln.length()))
              None => ()
            }
          }
        }
      }
      k = k + 1
    }
  }
  None
}

///| Collect every identifier occurring anywhere in `content` so Stage B temporary bindings
///| can never shadow or capture a user variable (Round 2 P0-3).
fn collect_used_idents(content : String) -> Map[String, Bool] {
  collect_used_idents_from_tokens(lex_moonbit(content))
}

fn collect_used_idents_from_tokens(toks : Array[Token]) -> Map[String, Bool] {
  let used : Map[String, Bool] = Map()
  let mut i = 0
  while i < toks.length() - 1 {
    if toks[i].kind == TokenKind::Ident {
      used[toks[i].raw] = true
    }
    i = i + 1
  }
  used
}

///| Stage B content-versioned cache toggle (default ON) & perf counters.
///| Counters: [0]=lex_calls, [1]=shrink_pkg_builds, [2]=sort_key_env_builds, [3]=pkg_fns_builds, [4]=rounds.
let stage_b_cache_flag : Array[Bool] = [true]
let stage_b_perf_stats : Array[Int] = [0, 0, 0, 0, 0]

pub fn stage_b_set_cache_enabled(enabled : Bool) -> Unit {
  stage_b_cache_flag[0] = enabled
}

pub fn stage_b_cache_is_enabled() -> Bool {
  stage_b_cache_flag[0]
}

pub fn stage_b_reset_perf_counters() -> Unit {
  stage_b_perf_stats[0] = 0
  stage_b_perf_stats[1] = 0
  stage_b_perf_stats[2] = 0
  stage_b_perf_stats[3] = 0
  stage_b_perf_stats[4] = 0
}

pub fn stage_b_get_perf_counters() -> (Int, Int, Int, Int, Int) {
  (stage_b_perf_stats[0], stage_b_perf_stats[1], stage_b_perf_stats[2], stage_b_perf_stats[3], stage_b_perf_stats[4])
}

///| Fetch tokens for `f_rel`, reusing cross-round content-versioned cache when enabled.
fn stage_b_get_file_tokens(
  round_file_tokens : Map[String, Array[Token]],
  token_cache : Map[String, (Int, Array[Token])],
  file_vers : Map[String, Int],
  f_rel : String,
  content : String,
) -> Array[Token] {
  if stage_b_cache_flag[0] {
    match round_file_tokens.get(f_rel) {
      Some(ts) => return ts
      None => ()
    }
    let ver = match file_vers.get(f_rel) {
      Some(v) => v
      None => 0
    }
    match token_cache.get(f_rel) {
      Some((cver, cts)) =>
      if cver == ver {
        round_file_tokens[f_rel] = cts
        return cts
      }
      None => ()
    }
    stage_b_perf_stats[0] = stage_b_perf_stats[0] + 1
    let ts = lex_moonbit(content)
    round_file_tokens[f_rel] = ts
    token_cache[f_rel] = (ver, ts)
    ts
  } else {
    stage_b_perf_stats[0] = stage_b_perf_stats[0] + 1
    let ts = lex_moonbit(content)
    round_file_tokens[f_rel] = ts
    ts
  }
}

///| Allocate a guaranteed collision-free identifier not present in `used`, then record it.
fn fresh_stage_b_ident(used : Map[String, Bool], base : String) -> String {
  if !used.contains(base) {
    used[base] = true
    return base
  }
  let mut n = 1
  while true {
    let cand = base + "_" + n.to_string()
    if !used.contains(cand) {
      used[cand] = true
      return cand
    }
    n = n + 1
  }
  base
}

///| Hygienic recursive structural equality generator for Stage B (uses `fresh_stage_b_ident`).
fn gen_eq_expr_hygienic(a : String, b : String, ty : String, used : Map[String, Bool]) -> String {
  let t = ty.trim()
  if t == "Bytes" {
    return "mbt_compat::bytes_eq(" + a + ", " + b + ")"
  }
  if t == "MbtJson" || t == "mbt_compat::MbtJson" {
    return "mbt_compat::mbt_json_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("OrderedSet[") || t.starts_with("mbt_compat::OrderedSet[") {
    return "mbt_compat::ordered_set_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let sb = StringBuilder()
      let mut k = 0
      while k < elems.length() {
        if k > 0 { sb.write_string(" && ") }
        let ak = "(" + a + ")." + k.to_string()
        let bk = "(" + b + ")." + k.to_string()
        sb.write_string("(" + gen_eq_expr_hygienic(ak, bk, elems[k], used) + ")")
        k = k + 1
      }
      return sb.to_string()
    }
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let ax = fresh_stage_b_ident(used, "__oa")
    let bx = fresh_stage_b_ident(used, "__ob")
    let inner_eq = gen_eq_expr_hygienic(ax, bx, inner, used)
    return "match (" + a + ", " + b + ") { (Some(" + ax + "), Some(" + bx + ")) => " + inner_eq + ", (None, None) => true, _ => false }"
  }
  if (t.starts_with("Array[") || t.starts_with("FixedArray[")) && t.ends_with("]") {
    let pref_len = if t.starts_with("FixedArray[") { 11 } else { 6 }
    let inner = t.slice(pref_len, t.length() - 1).trim()
    let idx = fresh_stage_b_ident(used, "__ai")
    let eqv = fresh_stage_b_ident(used, "__aeq")
    let elem_eq = gen_eq_expr_hygienic(a + "[" + idx + "]", b + "[" + idx + "]", inner, used)
    return "{ let mut " + eqv + " = " + a + ".length() == " + b + ".length(); if " + eqv + " { let mut " + idx + " = 0; while " + idx + " < " + a + ".length() { if !(" + elem_eq + ") { " + eqv + " = false; break }; " + idx + " = " + idx + " + 1 } }; " + eqv + " }"
  }
  a + " == " + b
}

///| Token-precise rewrite of unsupported static compat calls (`Float::is_nan`, `Float::from_uint`,
///| `Float::reinterpret_from_uint`, `Bytes::make`) at 1-based column `col` on a single line.
fn rewrite_static_compat_call_at(ln : String, col : Int) -> Option[String] {
  let toks = lex_moonbit(ln)
  let tn = toks.length() - 1
  let mut best_i = -1
  let mut best_dist = 1000000
  let mut best_repl = ""
  let mut i = 0
  while i + 3 < tn {
    if toks[i].kind == TokenKind::UpperIdent && toks[i + 1].kind == TokenKind::ColonColon &&
    toks[i + 2].kind == TokenKind::Ident && toks[i + 3].kind == TokenKind::LParen {
      let qual = toks[i].raw
      let mem = toks[i + 2].raw
      let repl = if qual == "Float" && mem == "is_nan" {
        "mbt_compat::float_is_nan"
      } else if qual == "Float" && mem == "from_uint" {
        "mbt_compat::float_from_uint"
      } else if qual == "Float" && mem == "reinterpret_from_uint" {
        "mbt_compat::float_reinterpret_from_uint"
      } else if qual == "Bytes" && mem == "make" {
        "mbt_compat::bytes_make"
      } else {
        ""
      }
      if repl.length() > 0 {
        let dist = if toks[i].col >= col { toks[i].col - col } else { col - toks[i].col }
        if dist < best_dist {
          best_dist = dist
          best_i = i
          best_repl = repl
        }
      }
    }
    i = i + 1
  }
  if best_i >= 0 {
    return Some(ln.slice(0, toks[best_i].start_byte) + best_repl + ln.slice(toks[best_i + 2].end_byte, ln.length()))
  }
  None
}

fn op_token_prec(k : TokenKind) -> Int {
  if k == TokenKind::Star || k == TokenKind::Slash || k == TokenKind::Percent {
    return 2
  }
  if k == TokenKind::Plus || k == TokenKind::Minus {
    return 1
  }
  0
}

fn op_symbol_to_name(sym : String) -> String {
  if sym == "+" { return "add" }
  if sym == "-" { return "sub" }
  if sym == "*" { return "mul" }
  if sym == "/" { return "div" }
  ""
}

///| Rewrite ONE custom binary operator (`+`, `-`, `*`, `/`) at `(lidx, d.col)` into `helper(lhs, rhs)`,
///| strictly respecting MoonBit precedence (`*`/`/` > `+`/`-`, unary `-` > `*`/`/`), left-associativity,
///| and left-to-right operand evaluation. Returns `true` if rewritten.
fn rewrite_custom_binop_at(
  lines : Array[String],
  lidx : Int,
  col : Int,
  op_str : String,
  helper_fn : String,
  mutated_lines : Map[Int, Bool],
) -> Bool {
  let target_kind = if op_str == "+" {
    TokenKind::Plus
  } else if op_str == "-" {
    TokenKind::Minus
  } else if op_str == "*" {
    TokenKind::Star
  } else if op_str == "/" {
    TokenKind::Slash
  } else {
    return false
  }
  let op_prec = op_token_prec(target_kind)
  // Gather bounded multiline continuation chunk (only on trailing binary op or unclosed `(`/ `[`, max 8 lines)
  let mut end_l = lidx
  let chunk_sb = StringBuilder()
  chunk_sb.write_string(lines[lidx])
  let mut cont_lines = 0
  while end_l + 1 < lines.length() && cont_lines < 8 {
    let cur_t = lines[end_l].trim()
    let ends_with_op = cur_t.ends_with("+") || cur_t.ends_with("-") || cur_t.ends_with("*") || cur_t.ends_with("/")
    if ends_with_op {
      end_l = end_l + 1
      cont_lines = cont_lines + 1
      chunk_sb.write_string("\n")
      chunk_sb.write_string(lines[end_l])
    } else {
      break
    }
  }
  let chunk = chunk_sb.to_string()
  let toks = lex_moonbit(chunk)
  let tn = toks.length() - 1
  let mut op_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti < tn {
    if toks[ti].line == 1 && toks[ti].kind == target_kind {
      // For `-`, ensure it is binary (preceded by a value-ending token!)
      let is_bin = if target_kind == TokenKind::Minus {
        ti > 0 && !toks[ti].newline_before && is_value_ending_tok(toks[ti - 1])
      } else {
        ti > 0
      }
      if is_bin {
        let dist = if toks[ti].col >= col { toks[ti].col - col } else { col - toks[ti].col }
        if dist < best_dist {
          best_dist = dist
          op_i = ti
        }
      }
    }
    ti = ti + 1
  }
  if op_i <= 0 || op_i + 1 >= tn {
    return false
  }
  // Scan backward for LHS operand (left-associative: stop only at strictly lower precedence or delimiters)
  let mut ls = op_i - 1
  let mut ld = 0
  while ls >= 0 {
    let lk = toks[ls].kind
    if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace {
      ld = ld + 1
    } else if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace {
      if ld == 0 {
        ls = ls + 1
        break
      }
      ld = ld - 1
    } else if ld == 0 {
      let is_low_op = op_prec == 2 && (lk == TokenKind::Plus ||
        (lk == TokenKind::Minus && ls > 0 && !toks[ls].newline_before && is_value_ending_tok(toks[ls - 1])))
      let is_stop = is_low_op || lk == TokenKind::Eq || lk == TokenKind::AssignOp ||
      lk == TokenKind::Comma || lk == TokenKind::Semi || lk == TokenKind::Colon ||
      lk == TokenKind::AmpAmp || lk == TokenKind::PipePipe || lk == TokenKind::FatArrow ||
      lk == TokenKind::EqEq || lk == TokenKind::BangEq || lk == TokenKind::Lt ||
      lk == TokenKind::LtEq || lk == TokenKind::Gt || lk == TokenKind::GtEq ||
      lk == TokenKind::Pipe || lk == TokenKind::Amp || lk == TokenKind::Caret ||
      lk == TokenKind::Shl || lk == TokenKind::Shr ||
      (lk == TokenKind::Keyword && (toks[ls].raw == "if" || toks[ls].raw == "else" ||
        toks[ls].raw == "return" || toks[ls].raw == "while" || toks[ls].raw == "in" ||
        toks[ls].raw == "match" || toks[ls].raw == "let" || toks[ls].raw == "for"))
      if is_stop {
        ls = ls + 1
        break
      }
      if ls < op_i - 1 && toks[ls + 1].newline_before && !is_value_ending_tok(toks[ls]) {
        // Don't cross onto previous statement line
        let prev_is_op = lk == TokenKind::Plus || lk == TokenKind::Minus || lk == TokenKind::Star || lk == TokenKind::Slash
        if !prev_is_op {
          ls = ls + 1
          break
        }
      }
    }
    ls = ls - 1
  }
  if ls < 0 { ls = 0 }

  // Scan forward for RHS operand (left-associative: stop at EQUAL OR LOWER precedence binary op!)
  let mut re = op_i + 1
  let mut rd = 0
  let mut expect_operand = true
  while re < tn {
    let rk = toks[re].kind
    if rd == 0 && re > op_i + 1 && toks[re].newline_before && !expect_operand {
      let cont_op = op_prec == 1 && (rk == TokenKind::Star || rk == TokenKind::Slash || rk == TokenKind::Percent)
      if !cont_op {
        break
      }
    }
    if rd == 0 {
      if rk == TokenKind::Comma || rk == TokenKind::Semi || rk == TokenKind::Eq || rk == TokenKind::AssignOp ||
      rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::FatArrow ||
      rk == TokenKind::EqEq || rk == TokenKind::BangEq || rk == TokenKind::Lt ||
      rk == TokenKind::LtEq || rk == TokenKind::Gt || rk == TokenKind::GtEq ||
      rk == TokenKind::Pipe || rk == TokenKind::Amp || rk == TokenKind::Caret ||
      rk == TokenKind::Shl || rk == TokenKind::Shr ||
      (rk == TokenKind::Keyword && toks[re].raw == "else") {
        break
      }
      if rk == TokenKind::LBrace && !expect_operand && !(re > op_i + 1 && toks[re - 1].kind == TokenKind::ColonColon) {
        break
      }
      let rp = op_token_prec(rk)
      if rp > 0 {
        if expect_operand && rk == TokenKind::Minus {
          // Unary `-` on RHS (e.g. `a + -b`) — keep going!
          re = re + 1
          continue
        }
        if rp <= op_prec {
          // Equal or lower precedence binary op stops RHS (preserves left-associativity & `*` > `+`!)
          break
        }
        // Higher precedence op (`*`/`/` inside `+`/`-` RHS): include it and expect its RHS operand!
        expect_operand = true
        re = re + 1
        continue
      }
    }
    if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
      rd = rd + 1
      expect_operand = false
    } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
      if rd == 0 { break }
      rd = rd - 1
      expect_operand = false
    } else if rk == TokenKind::Bang && expect_operand {
      // Unary `!`
      expect_operand = true
    } else {
      expect_operand = false
    }
    re = re + 1
  }
  if ls >= op_i || re <= op_i + 1 {
    return false
  }
  let lhs_s = chunk.slice(toks[ls].start_byte, toks[op_i - 1].end_byte).trim()
  let rhs_s = chunk.slice(toks[op_i + 1].start_byte, toks[re - 1].end_byte).trim()
  if lhs_s.length() == 0 || rhs_s.length() == 0 {
    return false
  }
  let repl = helper_fn + "(" + lhs_s + ", " + rhs_s + ")"
  let new_chunk = chunk.slice(0, toks[ls].start_byte) + repl + chunk.slice(toks[re - 1].end_byte, chunk.length())
  lines[lidx] = new_chunk
  let mut cl = lidx + 1
  while cl <= end_l {
    lines[cl] = ""
    mutated_lines[cl] = true
    cl = cl + 1
  }
  true
}

///| Run Stage B type-directed fixpoint loop using `pionc check --json` callback.
///| Returns `(updated_files, iterations, final_diagnostic_histogram)`.
pub fn run_stage_b(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)]) {
  run_stage_b_with_ops(files, api_map, Map(), check_fn, diags, drift_ledger)
}

pub fn run_stage_b_with_ops(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  op_lookup : Map[String, String],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)]) {
  run_stage_b_with_ops_and_deps(files, api_map, op_lookup, Map(), check_fn, diags, drift_ledger)
}

pub fn run_stage_b_with_ops_and_deps(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  op_lookup : Map[String, String],
  dep_methods : Map[String, Bool],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)]) {
  let (out_files, iters, hist, _) = run_stage_b_with_ops_deps_and_qt(
    files,
    api_map,
    op_lookup,
    dep_methods,
    check_fn,
    None,
    empty_pkg_query_types(),
    diags,
    drift_ledger,
  )
  (out_files, iters, hist)
}

pub fn run_stage_b_with_ops_deps_and_qt(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  op_lookup : Map[String, String],
  dep_methods : Map[String, Bool],
  check_fn : (Array[(String, String)]) -> String,
  query_types_cb : Option[(Array[(String, String)]) -> String],
  initial_qt : PkgQueryTypes,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)], PkgQueryTypes) {
  let mut cur_files : Array[GeneratedFile] = []
  let file_vers : Map[String, Int] = Map()
  let token_cache : Map[String, (Int, Array[Token])] = Map()
  let mut any_boundary_changed = false
  for f in files {
    let with_bounds = apply_api_boundary_conversions(f.content, api_map, f.rel_path, diags, drift_ledger)
    if with_bounds != f.content {
      any_boundary_changed = true
    }
    file_vers[f.rel_path] = 0
    cur_files.push(GeneratedFile::{
      rel_path: f.rel_path,
      content: with_bounds,
      source_file: f.source_file,
      anchors: f.anchors,
    })
  }

  let mut iter = 0
  let mut final_hist : Array[(String, Int)] = []
  let mut qt_snap : PkgQueryTypes = if !any_boundary_changed && initial_qt.ok {
    initial_qt
  } else {
    empty_pkg_query_types()
  }
  let qt_snap_vers : Map[String, Int] = Map()
  if qt_snap.ok {
    for cf in cur_files {
      qt_snap_vers[cf.rel_path] = 0
    }
  }
  // Invariant: per-file `QtFileIndex` reuse for unchanged files relies on Stage B rewrites
  // never altering cross-file visible signatures or types; any future rewrite that changes
  // exported signatures/types must invalidate the whole package snapshot (`qt_snap_dirty = true`).
  let mut qt_snap_dirty = !qt_snap.ok
  let mut has_unknown_pkg_diag = false
  let mut qt_used_prev_round = false
  let mut prev_round_changed_cap_file = false

  let file_has_capacity_marker = fn(content : String) -> Bool {
    str_has(content, "shrink_to_fit") || str_has(content, ".iter(") ||
    str_has(content, "__mbt_slice_borrow") || str_has(content, ".search_by(")
  }
  let update_qt_snap = fn(parsed_qt : PkgQueryTypes) -> Unit {
    qt_snap = parsed_qt
    for cf in cur_files {
      let v = match file_vers.get(cf.rel_path) {
        Some(n) => n
        None => 0
      }
      qt_snap_vers[cf.rel_path] = v
    }
    qt_snap_dirty = false
  }

  let mut need_qt_for_capacity = false
  for f in cur_files {
    if file_has_capacity_marker(f.content) {
      need_qt_for_capacity = true
      break
    }
  }
  while iter < 16 {
    stage_b_perf_stats[4] = stage_b_perf_stats[4] + 1
    let batch : Array[(String, String)] = []
    for f in cur_files {
      batch.push((f.rel_path, f.content))
    }
    let should_top_qt = if iter == 0 {
      !qt_snap.ok && need_qt_for_capacity
    } else {
      need_qt_for_capacity && qt_snap_dirty && !has_unknown_pkg_diag &&
      (qt_used_prev_round || prev_round_changed_cap_file)
    }
    let raw_json = if should_top_qt {
      match query_types_cb {
        Some(qt_cb) => {
          let r = qt_cb(batch)
          if r.length() > 0 {
            let parsed_qt = parse_pkg_query_types_json(r)
            if parsed_qt.ok {
              update_qt_snap(parsed_qt)
            }
            r
          } else {
            check_fn(batch)
          }
        }
        None => check_fn(batch)
      }
    } else {
      check_fn(batch)
    }
    let pdiags = parse_pionc_diagnostics(raw_json)
    for d in pdiags {
      if d.code == "E_UNKNOWN_PACKAGE" {
        has_unknown_pkg_diag = true
        break
      }
    }

    let counts : Map[String, Int] = Map()
    for d in pdiags {
      let c = match counts.get(d.code) {
        Some(n) => n + 1
        None => 1
      }
      counts[d.code] = c
    }
    let hist_pairs : Array[(String, Int)] = []
    let keys = sorted_map_keys(counts)
    for k in keys {
      match counts.get(k) {
        Some(v) => hist_pairs.push((k, v))
        None => ()
      }
    }
    final_hist = sort_histogram(hist_pairs)
    iter = iter + 1

    if pdiags.length() == 0 || has_unknown_pkg_diag {
      break
    }

    // Hoisted per-round lazy caches backed by cross-round content-versioned `token_cache`
    let mut round_pkg_fns : Option[Map[String, StageBPkgFn]] = None
    let round_file_tokens : Map[String, Array[Token]] = Map()
    let mut round_qt : Option[PkgQueryTypes] = None
    let mut qt_used_this_round = false
    let mut round_shrink_pkg : Option[ShrinkPkg] = None
    let mut round_shrink_pkg_summary : Option[ShrinkPkg] = None
    let mut round_mut_summary : Option[PkgMutationSummary] = None
    let mut round_sort_key_env : Option[SortKeyEnv] = None
    let get_round_qt = fn() -> PkgQueryTypes {
      qt_used_this_round = true
      if qt_snap.ok && !qt_snap_dirty {
        return qt_snap
      }
      if has_unknown_pkg_diag {
        return empty_pkg_query_types()
      }
      match round_qt {
        Some(qt) => qt
        None => {
          let qt = match query_types_cb {
            Some(qt_cb) => {
              let r = qt_cb(batch)
              if r.length() > 0 {
                let parsed_qt = parse_pkg_query_types_json(r)
                if parsed_qt.ok {
                  update_qt_snap(parsed_qt)
                  parsed_qt
                } else {
                  empty_pkg_query_types()
                }
              } else {
                empty_pkg_query_types()
              }
            }
            None => empty_pkg_query_types()
          }
          round_qt = Some(qt)
          qt
        }
      }
    }
    let get_all_round_tokens = fn() -> Array[Array[Token]] {
      let out : Array[Array[Token]] = []
      for cf in cur_files {
        out.push(stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, cf.rel_path, cf.content))
      }
      out
    }
    let get_mut_summary = fn() -> PkgMutationSummary {
      match round_mut_summary {
        Some(ms) => ms
        None => {
          let toks = get_all_round_tokens()
          let rels : Array[String] = []
          let contents : Array[String] = []
          for cf in cur_files {
            rels.push(cf.rel_path)
            contents.push(cf.content)
          }
          let qt_use = get_round_qt()
          let ms = collect_pkg_mutation_summary(toks, rels, contents, qt_use, dep_methods, op_lookup)
          round_mut_summary = Some(ms)
          ms
        }
      }
    }
    let get_shrink_pkg_summary = fn() -> ShrinkPkg {
      match round_shrink_pkg_summary {
        Some(sp) => sp
        None => {
          let toks = get_all_round_tokens()
          let rels : Array[String] = []
          let contents : Array[String] = []
          for cf in cur_files {
            rels.push(cf.rel_path)
            contents.push(cf.content)
          }
          let qt_use = get_round_qt()
          let sp = collect_shrink_pkg_tokens_with_summary(toks, rels, contents, qt_use, get_mut_summary())
          round_shrink_pkg_summary = Some(sp)
          sp
        }
      }
    }
    let build_shrink_pkg = fn() -> ShrinkPkg {
      let toks = get_all_round_tokens()
      let qt_use = get_round_qt()
      if qt_use.ok {
        let rels : Array[String] = []
        let contents : Array[String] = []
        for cf in cur_files {
          rels.push(cf.rel_path)
          contents.push(cf.content)
        }
        collect_shrink_pkg_tokens_with_qt(toks, rels, contents, qt_use)
      } else {
        collect_shrink_pkg_tokens(toks)
      }
    }
    let get_shrink_pkg = fn() -> ShrinkPkg {
      if stage_b_cache_flag[0] {
        match round_shrink_pkg {
          Some(sp) => sp
          None => {
            stage_b_perf_stats[1] = stage_b_perf_stats[1] + 1
            let sp = build_shrink_pkg()
            round_shrink_pkg = Some(sp)
            sp
          }
        }
      } else {
        stage_b_perf_stats[1] = stage_b_perf_stats[1] + 1
        build_shrink_pkg()
      }
    }
    let get_sort_key_env = fn() -> SortKeyEnv {
      if stage_b_cache_flag[0] {
        match round_sort_key_env {
          Some(env) => env
          None => {
            stage_b_perf_stats[2] = stage_b_perf_stats[2] + 1
            let env = sort_key_env_of_with_deps(get_all_round_tokens(), dep_methods)
            round_sort_key_env = Some(env)
            env
          }
        }
      } else {
        stage_b_perf_stats[2] = stage_b_perf_stats[2] + 1
        sort_key_env_of_with_deps(get_all_round_tokens(), dep_methods)
      }
    }

    let mut changed = false
    let changed_rels : Array[String] = []
    let next_files : Array[GeneratedFile] = []
    for f in cur_files {
      let lines = f.content.split("\n")
      let mut used_idents_opt : Option[Map[String, Bool]] = None
      let get_used_idents = fn() -> Map[String, Bool] {
        match used_idents_opt {
          Some(m) => m
          None => {
            let ts = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
            let m = collect_used_idents_from_tokens(ts)
            used_idents_opt = Some(m)
            m
          }
        }
      }
      let mutated_lines : Map[Int, Bool] = Map()
      let mut file_changed = false
      let get_file_qfi = fn() -> Option[QtFileIndex] {
        qt_used_this_round = true
        if qt_snap.ok {
          let cur_v = match file_vers.get(f.rel_path) {
            Some(v) => v
            None => 0
          }
          let snap_v = match qt_snap_vers.get(f.rel_path) {
            Some(v) => v
            None => -1
          }
          if cur_v == snap_v {
            return qt_snap.files.get(f.rel_path)
          }
        }
        let rqt = get_round_qt()
        if rqt.ok {
          rqt.files.get(f.rel_path)
        } else {
          None
        }
      }
      // Gate D: Rewrite provably read-only `for x in arr[lo:hi]` borrowed-slice loops into
      // MoonBit-exact clamped index `while` loops before Stage A.5 sees `__mbt_slice_borrow`.
      if str_has(f.content, "__mbt_slice_borrow") {
        let ftoks_d = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
        let file_qfi_d = get_file_qfi()
        if stage_b_rewrite_borrowed_slice_for_loops(
          lines,
          ftoks_d,
          get_mut_summary(),
          f.rel_path,
          f.content,
          file_qfi_d,
          get_used_idents(),
          mutated_lines,
          drift_ledger,
        ) {
          file_changed = true
        }
      }
      for d in pdiags {
        if !(d.file == f.rel_path || d.file.ends_with("/" + f.rel_path)) {
          continue
        }
        let lidx = d.line - 1
        if lidx < 0 || lidx >= lines.length() || mutated_lines.contains(lidx) {
          continue
        }
        let ln = lines[lidx]
        let mut line_mutated = false

        // 0. Static compat calls (`Float::is_nan`, `Float::from_uint`, `Float::reinterpret_from_uint`, `Bytes::make`)
        if d.code == "E_TYPE_MISMATCH" && str_has(d.message, "unknown static function") &&
        (str_has(d.message, "Float::is_nan") || str_has(d.message, "Float::from_uint") ||
          str_has(d.message, "Float::reinterpret_from_uint") || str_has(d.message, "Bytes::make")) {
          match rewrite_static_compat_call_at(ln, d.col) {
            Some(new_ln) => {
              lines[lidx] = new_ln
              file_changed = true
              line_mutated = true
            }
            None => ()
          }
        }

        // 0b. Tuple keys (`Map[(A, B), V]`): Pion has no trait impls on tuple types, so a `MapKey`-bound
        //     constructor called with a pair / triple key becomes its `_pair` / `_triple` form (component-wise
        //     `MapKey`; components without one still fail here).
        if !line_mutated && str_has(d.message, "does not implement trait `mbt_compat::MapKey` required by `") {
          match rewrite_tuple_mapkey_call_at(ln, d.col, d.message) {
            Some(new_ln) => {
              lines[lidx] = new_ln
              file_changed = true
              line_mutated = true
            }
            None => ()
          }
        }

        if !line_mutated && d.code == "E_TYPE_MISMATCH" {
          // 1. Missing builtin method -> canonical `mbt_compat::*` (or inline lowering for `Int::to_char`)
          match parse_unknown_method_msg(d.message) {
            Some((mname, rty)) =>
            if rty == "Int" && mname == "to_char" {
              match rewrite_int_to_char_at(lines[lidx], d.col, get_used_idents()) {
                Some(new_ln) => {
                  lines[lidx] = new_ln
                  file_changed = true
                  line_mutated = true
                }
                None => ()
              }
            } else if rty == "Array[String]" && mname == "next" {
              match rewrite_split_next_at(lines[lidx], d.col) {
                Some(new_ln) => {
                  lines[lidx] = new_ln
                  file_changed = true
                  line_mutated = true
                }
                None => ()
              }
            } else {
              match lookup_missing_method_helper(rty, mname) {
                Some(helper) => {
                  if helper == "mbt_compat::arr_retain" || helper == "mbt_compat::arr_filter_map" ||
                  helper == "mbt_compat::arr_search_by" || helper == "mbt_compat::arr_sort_by_key" {
                    let pkg_fns = match round_pkg_fns {
                      Some(m) => m
                      None => {
                        stage_b_perf_stats[3] = stage_b_perf_stats[3] + 1
                        let _ = get_all_round_tokens()
                        let m = collect_stage_b_pkg_fns_cached(cur_files, round_file_tokens)
                        round_pkg_fns = Some(m)
                        m
                      }
                    }
                    if helper == "mbt_compat::arr_search_by" {
                      let probe_diags : Array[Diag] = []
                      stage_b_check_array_retain_mutation_cached(round_file_tokens, pkg_fns, f.rel_path, f.content, d.line, d.col, mname, probe_diags)
                      let ftoks_b = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                      let elem_ty_b = ms_extract_array_elem_ty(rty)
                      let ms_safe = stage_b_check_hof_ro_with_summary(ftoks_b, get_mut_summary(), f.rel_path, f.content, get_file_qfi(), elem_ty_b, d.line, d.col, mname, helper, probe_diags.length() > 0, drift_ledger)
                      if !ms_safe {
                        if probe_diags.length() > 0 {
                          for pd in probe_diags {
                            let mut dup = false
                            for existing in diags {
                              if existing.code == pd.code && existing.file == pd.file && existing.line == pd.line && existing.col == pd.col {
                                dup = true
                                break
                              }
                            }
                            if !dup {
                              diags.push(pd)
                            }
                          }
                        } else {
                          let mut dup = false
                          for existing in diags {
                            if existing.code == "MBT2PION_UNSUPPORTED_SYNTAX" && existing.file == f.rel_path && existing.line == d.line && existing.col == d.col {
                              dup = true
                              break
                            }
                          }
                          if !dup {
                            diags.push(diag_error(
                              "MBT2PION_UNSUPPORTED_SYNTAX",
                              f.rel_path,
                              d.line,
                              d.col,
                              "callback in `Array::search_by(...)` may mutate receiver or aliased array (fail-closed by mutation_summary)",
                            ))
                          }
                        }
                      }
                    } else if helper == "mbt_compat::arr_filter_map" {
                      let probe_diags : Array[Diag] = []
                      stage_b_check_array_retain_mutation_cached(round_file_tokens, pkg_fns, f.rel_path, f.content, d.line, d.col, mname, probe_diags)
                      if probe_diags.length() > 0 {
                        let ftoks_b = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                        let elem_ty_b = ms_extract_array_elem_ty(rty)
                        let ms_safe = stage_b_check_hof_ro_with_summary(ftoks_b, get_mut_summary(), f.rel_path, f.content, get_file_qfi(), elem_ty_b, d.line, d.col, mname, helper, true, drift_ledger)
                        if !ms_safe {
                          for pd in probe_diags {
                            let mut dup = false
                            for existing in diags {
                              if existing.code == pd.code && existing.file == pd.file && existing.line == pd.line && existing.col == pd.col {
                                dup = true
                                break
                              }
                            }
                            if !dup {
                              diags.push(pd)
                            }
                          }
                        }
                      }
                    } else {
                      stage_b_check_array_retain_mutation_cached(round_file_tokens, pkg_fns, f.rel_path, f.content, d.line, d.col, mname, diags)
                    }
                  }
                  let mut skip_rewrite = false
                  if helper == "mbt_compat::arr_shrink_to_fit" {
                    let ftoks = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    if !stage_b_check_shrink_snapshot_with_summary(ftoks, get_shrink_pkg(), get_shrink_pkg_summary(), get_mut_summary(), f.rel_path, f.content, get_file_qfi(), d.line, d.col, diags, drift_ledger) {
                      skip_rewrite = true
                    }
                  }
                  if helper == "mbt_compat::arr_sort_by_key" {
                    let ftoks = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    let probe_sk_diags : Array[Diag] = []
                    let base_sort_ok = stage_b_check_sort_key_closure_cached(ftoks, get_sort_key_env(), f.rel_path, d.line, d.col, probe_sk_diags)
                    if !base_sort_ok {
                      let elem_ty_sk = ms_extract_array_elem_ty(rty)
                      let qfi_sk = get_file_qfi()
                      let has_qfi_sk = match qfi_sk {
                        Some(_) => true
                        None => false
                      }
                      let sk_safe = if dep_methods.length() == 0 || has_qfi_sk {
                        stage_b_check_hof_ro_with_summary(ftoks, get_mut_summary(), f.rel_path, f.content, qfi_sk, elem_ty_sk, d.line, d.col, mname, helper, true, drift_ledger)
                      } else {
                        false
                      }
                      if !sk_safe {
                        for pd in probe_sk_diags {
                          let mut dup = false
                          for existing in diags {
                            if existing.code == pd.code && existing.file == pd.file && existing.line == pd.line && existing.col == pd.col {
                              dup = true
                              break
                            }
                          }
                          if !dup {
                            diags.push(pd)
                          }
                        }
                        skip_rewrite = true
                      }
                    }
                  }
                  if helper == "mbt_compat::arr_iter" {
                    let _ = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    let decl_tys = if get_round_qt().ok { get_shrink_pkg().declared_types } else { Map() }
                    let elem_ty_c = ms_extract_array_elem_ty(rty)
                    if !stage_b_check_kept_iter_with_summary(round_file_tokens, get_mut_summary(), f.rel_path, f.content, get_file_qfi(), decl_tys, elem_ty_c, d.line, d.col, diags, drift_ledger) {
                      skip_rewrite = true
                    }
                  }
                  if helper == "mbt_compat::arr_push_iter" {
                    let _ = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    let pi_status = stage_b_check_push_iter_arg(round_file_tokens, f.rel_path, f.content, d.line, d.col, true, diags)
                    if pi_status < 0 {
                      skip_rewrite = true
                    }
                  }
                  let direct_end = if !skip_rewrite && (mname == "unsafe_get" || mname == "unsafe_set") &&
                  (rty.starts_with("Array[") || rty.starts_with("FixedArray[")) {
                    rewrite_unsafe_index_at(lines, lidx, d.col, mname)
                  } else {
                    -1
                  }
                  if skip_rewrite {
                    ()
                  } else if direct_end >= 0 {
                    let mut ml = lidx + 1
                    while ml <= direct_end {
                      mutated_lines[ml] = true
                      ml = ml + 1
                    }
                    file_changed = true
                    line_mutated = true
                  } else if rewrite_method_call_at(lines, lidx, d.col, mname, helper) {
                    file_changed = true
                    line_mutated = true
                    if helper == "mbt_compat::str_compare" {
                      drift_ledger.push(DriftEntry::{
                        category: "string_compare",
                        file: f.rel_path,
                        line: d.line,
                        col: d.col,
                        expr: mname,
                        resolution: helper,
                        status: "resolved",
                        detail: "String::compare routed to MoonBit UTF-16 length-first comparison",
                      })
                    }
                  }
                }
                None => ()
              }
            }
            None => ()
          }
          // 1a. `Array[Double/Float/UInt/UInt64/Byte/Char]::sort()` -> `mbt_compat::arr_sort_*`
          if !line_mutated && str_has(d.message, "`Array::sort` is only supported on") {
            let ftoks_s = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
            let mut exact_ti = -1
            let mut best_ge_ti = -1
            let mut best_ge_dist = 1000000
            let mut best_any_ti = -1
            let mut best_any_dist = 1000000
            let mut ti_s = 0
            while ti_s + 1 < ftoks_s.length() {
              if ftoks_s[ti_s].line == d.line && ftoks_s[ti_s].kind == TokenKind::Dot &&
              ftoks_s[ti_s + 1].kind == TokenKind::Ident && ftoks_s[ti_s + 1].raw == "sort" {
                let rs_s = receiver_path_start_token(ftoks_s, ti_s - 1)
                if rs_s >= 0 && ftoks_s[rs_s].line == d.line && ftoks_s[rs_s].col == d.col {
                  exact_ti = ti_s
                  break
                }
                let scol = ftoks_s[ti_s + 1].col
                if scol >= d.col {
                  let dist = scol - d.col
                  if dist < best_ge_dist {
                    best_ge_dist = dist
                    best_ge_ti = ti_s
                  }
                }
                let adist = if scol >= d.col { scol - d.col } else { d.col - scol }
                if adist < best_any_dist {
                  best_any_dist = adist
                  best_any_ti = ti_s
                }
              }
              ti_s = ti_s + 1
            }
            let chosen_ti = if exact_ti >= 0 {
              exact_ti
            } else if best_ge_ti >= 0 {
              best_ge_ti
            } else {
              best_any_ti
            }
            let mut sort_rty = d.found.trim()
            if sort_rty.length() == 0 && chosen_ti >= 0 {
              let rs_s = receiver_path_start_token(ftoks_s, chosen_ti - 1)
              let rsb_s = if rs_s >= 0 { ftoks_s[rs_s].start_byte } else { -1 }
              match get_file_qfi() {
                Some(qfi) =>
                match qt_lookup_receiver_ty_at_op(qfi, f.content, ftoks_s[chosen_ti + 1].start_byte, rsb_s, -1, true) {
                  Some(rt) => sort_rty = rt
                  None => ()
                }
                None => ()
              }
            }
            let rewrite_col = if chosen_ti >= 0 { ftoks_s[chosen_ti + 1].col } else { d.col }
            match lookup_array_sort_helper(sort_rty) {
              Some(helper) =>
              if rewrite_method_call_at(lines, lidx, rewrite_col, "sort", helper) {
                file_changed = true
                line_mutated = true
              }
              None => ()
            }
          }
          // 1b. Strip `init=` label on `MbtIter::fold(init=x, f)` using lexer tokens closest to `d.col` (never touches string literals)
          if !line_mutated && str_has(d.message, "unknown named argument `init`") && str_has(d.message, "fold") {
            let cur_ln = lines[lidx]
            let itoks = lex_moonbit(cur_ln)
            let itn = itoks.length() - 1
            let mut best_ti = -1
            let mut best_dist = 1000000
            let mut ti = 0
            while ti + 1 < itn {
              if itoks[ti].kind == TokenKind::Ident && itoks[ti].raw == "init" && itoks[ti + 1].kind == TokenKind::Eq {
                let dist = if itoks[ti].col >= d.col { itoks[ti].col - d.col } else { d.col - itoks[ti].col }
                if dist < best_dist {
                  best_dist = dist
                  best_ti = ti
                }
              }
              ti = ti + 1
            }
            if best_ti >= 0 {
              lines[lidx] = cur_ln.slice(0, itoks[best_ti].start_byte) + cur_ln.slice(itoks[best_ti + 1].end_byte, cur_ln.length())
              file_changed = true
              line_mutated = true
            }
          }
          // 1b. MoonBit `String::view(start_offset=..., end_offset=...)`: Pion `String` has a built-in `.view`
          //     that rejects named `start_offset`/`end_offset` args; rewrite ONLY a real code `.view(` (never inside string/char/comment)
          //     closest at/left of `d.col` to `mbt_compat::str_view(recv, ...)`.
          if !line_mutated && (str_has(d.message, "named argument `start_offset`") || str_has(d.message, "named argument `end_offset`")) {
            let mut best_v = -1
            let mut si = 0
            let sn = ln.length()
            let mut in_str = false
            let mut in_chr = false
            let mut esc = false
            while si < sn {
              let ch = ln.code_unit_at(si)
              if in_str {
                if esc { esc = false }
                else if ch == 92 { esc = true }
                else if ch == 34 { in_str = false }
              } else if in_chr {
                if esc { esc = false }
                else if ch == 92 { esc = true }
                else if ch == 39 { in_chr = false }
              } else if ch == 34 {
                in_str = true
              } else if ch == 39 {
                in_chr = true
              } else if ch == 47 && si + 1 < sn && ln.code_unit_at(si + 1) == 47 {
                break
              } else if ch == 46 && si + 6 <= sn && ln.slice(si, si + 6) == ".view(" {
                if si + 1 <= d.col {
                  best_v = si
                } else if best_v < 0 {
                  best_v = si
                }
              }
              si = si + 1
            }
            if best_v >= 0 {
              if rewrite_method_call_at(lines, lidx, best_v + 2, "view", "mbt_compat::str_view") {
                file_changed = true
                line_mutated = true
              }
            }
          }
          // 2. Token-precise numeric literal coercion at `d.col` (never appends to EOL!)
          if !line_mutated && d.found == "Int" && d.expected == "Int64" {
            match coerce_numeric_token_at_col(ln, d.col, "to_int64") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
                line_mutated = true
              }
              None => ()
            }
          } else if !line_mutated && d.found == "Int" && d.expected == "Double" {
            match coerce_numeric_token_at_col(ln, d.col, "to_double") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
                line_mutated = true
              }
              None => ()
            }
          } else if !line_mutated && d.found == "Int" && d.expected == "Byte" {
            match coerce_numeric_token_at_col(ln, d.col, "to_byte") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
                line_mutated = true
              }
              None => ()
            }
          }
          // 2b. Tuple struct numeric field access `<expr>.0` -> `<expr>._0` (lexer-backed; never touches string literals; handles `.0.1`)
          // (not on a scalar or `<error>` receiver: that type is a stale guess of this round -- e.g. the tuple key of
          //  a `for k, v in map` not lowered yet types as the `Int` index -- and `.0` there is a real tuple element;
          //  a tuple struct is reported as `struct `S` has no field `0`` once it types.)
          if !line_mutated && (str_has(d.message, "unknown field `") || str_has(d.message, "cannot access field `") || str_has(d.message, "has no field `")) &&
          !field_access_on_scalar_or_error(d.message) {
            let mut fstart = d.message.index_of("field `")
            if fstart >= 0 {
              fstart = fstart + 7
              let rest_m = d.message.slice(fstart, d.message.length())
              let ftick = rest_m.index_of("`")
              if ftick > 0 {
                let fld = rest_m.slice(0, ftick)
                let mut all_dig = true
                let mut di = 0
                while di < fld.length() {
                  let dc = fld.code_unit_at(di)
                  if dc < 48 || dc > 57 { all_dig = false; break }
                  di = di + 1
                }
                if all_dig {
                  let cur_ln = lines[lidx]
                  let ltoks = lex_moonbit(cur_ln)
                  let mut best_ti = -1
                  let mut best_dist = 1000000
                  let mut ti = 0
                  while ti + 1 < ltoks.length() - 1 {
                    if ltoks[ti].kind == TokenKind::Dot {
                      let nxt = ltoks[ti + 1]
                      let is_exact_int = nxt.kind == TokenKind::IntLit && nxt.raw == fld
                      let is_chained_flt = nxt.kind == TokenKind::FloatLit && nxt.raw.starts_with(fld + ".")
                      if is_exact_int || is_chained_flt {
                        let dist = if ltoks[ti].col >= d.col { ltoks[ti].col - d.col } else { d.col - ltoks[ti].col }
                        if dist < best_dist {
                          best_dist = dist
                          best_ti = ti
                        }
                      }
                    }
                    ti = ti + 1
                  }
                  if best_ti >= 0 {
                    let dot_t = ltoks[best_ti]
                    let nxt = ltoks[best_ti + 1]
                    let mut prefix_end = dot_t.start_byte
                    // Collapse Stage A's `.0 .1` spacing back to `._0._1` cleanly when rewriting the second index
                    if prefix_end > 0 && cur_ln.code_unit_at(prefix_end - 1) == 32 && best_ti > 0 &&
                    (ltoks[best_ti - 1].kind == TokenKind::Ident || ltoks[best_ti - 1].kind == TokenKind::IntLit ||
                      ltoks[best_ti - 1].kind == TokenKind::RParen || ltoks[best_ti - 1].kind == TokenKind::RBracket) {
                      prefix_end = ltoks[best_ti - 1].end_byte
                    }
                    if nxt.kind == TokenKind::IntLit {
                      lines[lidx] = cur_ln.slice(0, prefix_end) + "._" + fld + cur_ln.slice(nxt.end_byte, cur_ln.length())
                    } else {
                      // Chained `.0.1` lexed as `.` + `FloatLit("0.1")` -> `._0.1` (next round handles `.1` if also tuple struct)
                      let rest_flt = nxt.raw.slice(fld.length(), nxt.raw.length())
                      lines[lidx] = cur_ln.slice(0, prefix_end) + "._" + fld + rest_flt + cur_ln.slice(nxt.end_byte, cur_ln.length())
                    }
                    file_changed = true
                    line_mutated = true
                  }
                }
              }
            }
          }
          // 2c. OrderedMap/ArrayView index assignment `<recv>[<k>] = <v>` -> `<recv>.set(<k>, <v>)` (supports multiline `<v>`)
          if !line_mutated && (str_has(d.message, "cannot assign to indexed type `") || str_has(d.message, "cannot index into type `")) &&
          (str_has(d.message, "OrderedMap[") || str_has(d.message, "ArrayView[") || str_has(d.message, "ArrayBuf[")) {
            let cur_ln = lines[lidx]
            let target_0 = if d.col > 0 { d.col - 1 } else { 0 }
            // Find `[` near target_0 that is followed by matching `] = `
            let mut best_lb = -1
            let mut best_rb = -1
            let mut best_eq = -1
            let mut best_dist = 1000000
            let mut pos = 0
            while pos < cur_ln.length() {
              if cur_ln.code_unit_at(pos) == 91 {
                let mut depth = 1
                let mut j = pos + 1
                while j < cur_ln.length() && depth > 0 {
                  let ch = cur_ln.code_unit_at(j)
                  if ch == 91 { depth = depth + 1 }
                  else if ch == 93 { depth = depth - 1 }
                  j = j + 1
                }
                if depth == 0 {
                  let rb = j - 1
                  let mut eq_p = rb + 1
                  while eq_p < cur_ln.length() && (cur_ln.code_unit_at(eq_p) == 32 || cur_ln.code_unit_at(eq_p) == 9) {
                    eq_p = eq_p + 1
                  }
                  if eq_p < cur_ln.length() && cur_ln.code_unit_at(eq_p) == 61 &&
                  !(eq_p + 1 < cur_ln.length() && cur_ln.code_unit_at(eq_p + 1) == 61) {
                    let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
                    if dist < best_dist {
                      best_dist = dist
                      best_lb = pos
                      best_rb = rb
                      best_eq = eq_p
                    }
                  }
                }
              }
              pos = pos + 1
            }
            if best_lb > 0 && best_rb > best_lb && best_eq > best_rb {
              let k_expr = cur_ln.slice(best_lb + 1, best_rb).trim()
              let mut v_end = cur_ln.length()
              // Strip trailing comment or `;`, and track bracket/brace/paren depth across lines
              let mut vi = best_eq + 1
              let mut vd = 0
              let mut in_s = false
              let mut esc = false
              while vi < cur_ln.length() {
                let ch = cur_ln.code_unit_at(vi)
                if in_s {
                  if esc { esc = false }
                  else if ch == 92 { esc = true }
                  else if ch == 34 { in_s = false }
                } else if ch == 34 {
                  in_s = true
                } else if ch == 40 || ch == 91 || ch == 123 {
                  vd = vd + 1
                } else if ch == 41 || ch == 93 || ch == 125 {
                  if vd == 0 { v_end = vi; break }
                  vd = vd - 1
                } else if vd == 0 && ch == 59 {
                  v_end = vi
                  break
                } else if vd == 0 && ch == 47 && vi + 1 < cur_ln.length() && cur_ln.code_unit_at(vi + 1) == 47 {
                  v_end = vi
                  break
                }
                vi = vi + 1
              }
              if vd == 0 {
                let v_expr = cur_ln.slice(best_eq + 1, v_end).trim()
                let tail = cur_ln.slice(v_end, cur_ln.length())
                lines[lidx] = cur_ln.slice(0, best_lb) + ".set(" + k_expr + ", " + v_expr + ")" + tail
                file_changed = true
                line_mutated = true
              } else {
                // Multiline RHS (e.g. `self.groups[id] = Group::{\n ... \n}` or `m[0] = ({\n let x = 5\n x\n}) + // next term\n 2`):
                // scan forward until `vd == 0`, then continue to end of the statement on that line (and any trailing-operator continuation lines)!
                // Distinguish true statement terminators (`;` or unbalanced `)`/`]`/`}`) from line comments (`//`), so trailing `//` after `+` still continues!
                let mut end_l = lidx + 1
                let mut end_c = -1
                while end_l < lines.length() {
                  let sl = lines[end_l]
                  let mut sc = 0
                  let mut sin_s = false
                  let mut sesc = false
                  let mut stopped_stmt = false
                  let mut raw_end = sl.length()
                  while sc < sl.length() {
                    let ch = sl.code_unit_at(sc)
                    if sin_s {
                      if sesc { sesc = false }
                      else if ch == 92 { sesc = true }
                      else if ch == 34 { sin_s = false }
                    } else if ch == 34 {
                      sin_s = true
                    } else if ch == 47 && sc + 1 < sl.length() && sl.code_unit_at(sc + 1) == 47 {
                      raw_end = sc
                      break
                    } else if ch == 40 || ch == 91 || ch == 123 {
                      vd = vd + 1
                    } else if ch == 41 || ch == 93 || ch == 125 {
                      if vd == 0 {
                        raw_end = sc
                        stopped_stmt = true
                        break
                      }
                      vd = vd - 1
                    } else if vd == 0 && ch == 59 {
                      raw_end = sc
                      stopped_stmt = true
                      break
                    }
                    sc = sc + 1
                  }
                  if vd == 0 {
                    let mut trim_end = raw_end
                    while trim_end > 0 && (sl.code_unit_at(trim_end - 1) == 32 || sl.code_unit_at(trim_end - 1) == 9) {
                      trim_end = trim_end - 1
                    }
                    let prefix_t = sl.slice(0, trim_end).trim()
                    let continues = !stopped_stmt && (
                      prefix_t.ends_with("+") || prefix_t.ends_with("-") || prefix_t.ends_with("*") ||
                      prefix_t.ends_with("/") || prefix_t.ends_with("%") || prefix_t.ends_with("&&") ||
                      prefix_t.ends_with("||") || prefix_t.ends_with("|") || prefix_t.ends_with("&") ||
                      prefix_t.ends_with("^")
                    )
                    if !continues {
                      end_c = trim_end
                      break
                    }
                  }
                  end_l = end_l + 1
                }
                if vd == 0 && end_l < lines.length() && end_c > 0 {
                  let first_v = cur_ln.slice(best_eq + 1, cur_ln.length()).trim()
                  lines[lidx] = cur_ln.slice(0, best_lb) + ".set(" + k_expr + ", " + first_v
                  let eln = lines[end_l]
                  lines[end_l] = eln.slice(0, end_c) + ")" + eln.slice(end_c, eln.length())
                  let mut ml = lidx
                  while ml <= end_l {
                    mutated_lines[ml] = true
                    ml = ml + 1
                  }
                  file_changed = true
                  line_mutated = true
                }
              }
            }
          }
          // 3. Live order-preserving cursor `while` loop for `OrderedMap`, `String`, `ArrayView`, & `Bytes` `for ... in` (Wave M1.2 A.6):
          //    NEVER snapshot via `.to_array()` / `str_scalars`! Advance cursor BEFORE body so `continue`/`break`/`return` work!
          if !line_mutated && str_has(d.message, "`for ... in` requires an `Array[T]`") {
            let in_idx = ln.index_of(" in ")
            let lb_rel = if in_idx > 0 { ln.slice(in_idx + 4, ln.length()).index_of(" {") } else { -1 }
            let lb_idx = if lb_rel >= 0 { in_idx + 4 + lb_rel } else { -1 }
            if in_idx > 0 && lb_idx > in_idx {
              let iter_expr = ln.slice(in_idx + 4, lb_idx).trim()
              let binders = ln.slice(0, in_idx)
              let for_idx = binders.index_of("for ")
              if for_idx >= 0 {
                let prefix = binders.slice(0, for_idx)
                let vars_str = binders.slice(for_idx + 4, binders.length()).trim()
                let comma_idx = vars_str.index_of(",")
                // Find the matching closing `}` line for the `{` at `(lidx, lb_idx + 1)`
                // Skipping string literals `"..."`, char literals `'...'` (`'}'`, `'\''`, `'\\'`),
                // line comments `// ...`, and block comments `/* ... */` (Red-team P2-2)!
                let mut close_l = -1
                let mut close_c = -1
                let mut bdepth = 0
                let mut scan_l = lidx
                let mut in_blk_comment = false
                while scan_l < lines.length() && close_l < 0 {
                  let sl = lines[scan_l]
                  let mut sc = if scan_l == lidx { lb_idx + 1 } else { 0 }
                  let mut in_s = false
                  let mut in_c = false
                  let mut esc = false
                  while sc < sl.length() {
                    let ch = sl.code_unit_at(sc)
                    if in_blk_comment {
                      if ch == 42 && sc + 1 < sl.length() && sl.code_unit_at(sc + 1) == 47 {
                        in_blk_comment = false
                        sc = sc + 2
                        continue
                      }
                      sc = sc + 1
                      continue
                    }
                    if in_s {
                      if esc { esc = false }
                      else if ch == 92 { esc = true }
                      else if ch == 34 { in_s = false }
                    } else if in_c {
                      if esc { esc = false }
                      else if ch == 92 { esc = true }
                      else if ch == 39 { in_c = false }
                    } else if ch == 34 {
                      in_s = true
                    } else if ch == 39 {
                      in_c = true
                    } else if ch == 47 && sc + 1 < sl.length() && sl.code_unit_at(sc + 1) == 47 {
                      break
                    } else if ch == 47 && sc + 1 < sl.length() && sl.code_unit_at(sc + 1) == 42 {
                      in_blk_comment = true
                      sc = sc + 2
                      continue
                    } else if ch == 123 {
                      bdepth = bdepth + 1
                    } else if ch == 125 {
                      bdepth = bdepth - 1
                      if bdepth == 0 {
                        close_l = scan_l
                        close_c = sc
                        break
                      }
                    }
                    sc = sc + 1
                  }
                  scan_l = scan_l + 1
                }
                let tag = lidx.to_string()
                if close_l >= 0 && (d.found.starts_with("Map[") || d.found.starts_with("OrderedMap[") || d.found.starts_with("mbt_compat::OrderedMap[")) {
                  let used_idents = get_used_idents()
                  let m_var = fresh_stage_b_ident(used_idents, "__mbt_m_" + tag)
                  let i_var = fresh_stage_b_ident(used_idents, "__mbt_i_" + tag)
                  let s_var = fresh_stage_b_ident(used_idents, "__mbt_slot_" + tag)
                  let bind_stmts = if comma_idx >= 0 {
                    let k_var = vars_str.slice(0, comma_idx).trim()
                    let v_var = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    "let " + k_var + " = " + m_var + ".slot_key(" + s_var + "); let " + v_var + " = " + m_var + ".slot_val(" + s_var + ")"
                  } else {
                    "let " + vars_str + " = " + m_var + ".slot_key(" + s_var + ")"
                  }
                  let open_hdr = prefix + "{ let " + m_var + " = " + iter_expr + "; let mut " + i_var + " = 0; while " + i_var + " < " + m_var + ".slot_len() { let " + s_var + " = " + i_var + "; " + i_var + " = " + i_var + " + 1; if " + m_var + ".slot_live(" + s_var + ") { " + bind_stmts + "; "
                  if close_l == lidx {
                    let body_part = ln.slice(lb_idx + 2, close_c)
                    let after_part = ln.slice(close_c + 1, ln.length())
                    lines[lidx] = open_hdr + body_part + " } } }" + after_part
                  } else {
                    let first_rest = ln.slice(lb_idx + 2, ln.length())
                    lines[lidx] = open_hdr + first_rest
                    let cln = lines[close_l]
                    lines[close_l] = cln.slice(0, close_c) + " } } }" + cln.slice(close_c + 1, cln.length())
                  }
                  mutated_lines[close_l] = true
                  file_changed = true
                  line_mutated = true
                } else if close_l >= 0 && d.found == "String" {
                  let used_idents = get_used_idents()
                  let s_var = fresh_stage_b_ident(used_idents, "__mbt_s_" + tag)
                  let sn_var = fresh_stage_b_ident(used_idents, "__mbt_sn_" + tag)
                  let sp_var = fresh_stage_b_ident(used_idents, "__mbt_sp_" + tag)
                  let spn_var = fresh_stage_b_ident(used_idents, "__mbt_spn_" + tag)
                  let ch_var = fresh_stage_b_ident(used_idents, "__mbt_ch_" + tag)
                  let si_var = fresh_stage_b_ident(used_idents, "__mbt_si_" + tag)
                  let open_hdr = if comma_idx >= 0 {
                    let idx_v = vars_str.slice(0, comma_idx).trim()
                    let c_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    prefix + "{ let " + s_var + " = " + iter_expr + "; let " + sn_var + " = mbt_compat::str_byte_len(" + s_var + "); let mut " + sp_var + " = 0; let mut " + si_var + " = 0; while " + sp_var + " < " + sn_var + " { let (" + ch_var + ", " + spn_var + ") = mbt_compat::str_cursor_step(" + s_var + ", " + sp_var + "); let " + idx_v + " = " + si_var + "; " + sp_var + " = " + spn_var + "; " + si_var + " = " + si_var + " + 1; let " + c_v + " = " + ch_var + "; "
                  } else {
                    prefix + "{ let " + s_var + " = " + iter_expr + "; let " + sn_var + " = mbt_compat::str_byte_len(" + s_var + "); let mut " + sp_var + " = 0; while " + sp_var + " < " + sn_var + " { let (" + ch_var + ", " + spn_var + ") = mbt_compat::str_cursor_step(" + s_var + ", " + sp_var + "); " + sp_var + " = " + spn_var + "; let " + vars_str + " = " + ch_var + "; "
                  }
                  if close_l == lidx {
                    let body_part = ln.slice(lb_idx + 2, close_c)
                    let after_part = ln.slice(close_c + 1, ln.length())
                    lines[lidx] = open_hdr + body_part + " } }" + after_part
                  } else {
                    let first_rest = ln.slice(lb_idx + 2, ln.length())
                    lines[lidx] = open_hdr + first_rest
                    let cln = lines[close_l]
                    lines[close_l] = cln.slice(0, close_c) + " } }" + cln.slice(close_c + 1, cln.length())
                  }
                  mutated_lines[close_l] = true
                  file_changed = true
                  line_mutated = true
                } else if close_l >= 0 && (d.found.starts_with("ArrayView[") || d.found.starts_with("mbt_compat::ArrayView[")) {
                  let used_idents = get_used_idents()
                  let v_var = fresh_stage_b_ident(used_idents, "__mbt_av_" + tag)
                  let i_var = fresh_stage_b_ident(used_idents, "__mbt_ai_" + tag)
                  let bind_stmts = if comma_idx >= 0 {
                    let idx_v = vars_str.slice(0, comma_idx).trim()
                    let el_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    "let " + idx_v + " = " + i_var + "; let " + el_v + " = " + v_var + ".get(" + i_var + ")"
                  } else {
                    "let " + vars_str + " = " + v_var + ".get(" + i_var + ")"
                  }
                  let open_hdr = prefix + "{ let " + v_var + " = " + iter_expr + "; let mut " + i_var + " = 0; while " + i_var + " < " + v_var + ".length() { " + bind_stmts + "; " + i_var + " = " + i_var + " + 1; "
                  if close_l == lidx {
                    let body_part = ln.slice(lb_idx + 2, close_c)
                    let after_part = ln.slice(close_c + 1, ln.length())
                    lines[lidx] = open_hdr + body_part + " } }" + after_part
                  } else {
                    let first_rest = ln.slice(lb_idx + 2, ln.length())
                    lines[lidx] = open_hdr + first_rest
                    let cln = lines[close_l]
                    lines[close_l] = cln.slice(0, close_c) + " } }" + cln.slice(close_c + 1, cln.length())
                  }
                  file_changed = true
                  line_mutated = true
                } else if close_l >= 0 && d.found == "Bytes" {
                  let used_idents = get_used_idents()
                  let b_var = fresh_stage_b_ident(used_idents, "__mbt_b_" + tag)
                  let i_var = fresh_stage_b_ident(used_idents, "__mbt_bi_" + tag)
                  let c_var = fresh_stage_b_ident(used_idents, "__mbt_bk_" + tag)
                  let bind_stmts = if comma_idx >= 0 {
                    let idx_v = vars_str.slice(0, comma_idx).trim()
                    let el_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    "let " + idx_v + " = " + c_var + "; let " + el_v + " = " + b_var + "[" + c_var + "]"
                  } else {
                    "let " + vars_str + " = " + b_var + "[" + c_var + "]"
                  }
                  let open_hdr = prefix + "{ let " + b_var + " = " + iter_expr + "; let mut " + i_var + " = 0; while " + i_var + " < " + b_var + ".length() { let " + c_var + " = " + i_var + "; " + i_var + " = " + i_var + " + 1; " + bind_stmts + "; "
                  if close_l == lidx {
                    let body_part = ln.slice(lb_idx + 2, close_c)
                    let after_part = ln.slice(close_c + 1, ln.length())
                    lines[lidx] = open_hdr + body_part + " } }" + after_part
                  } else {
                    let first_rest = ln.slice(lb_idx + 2, ln.length())
                    lines[lidx] = open_hdr + first_rest
                    let cln = lines[close_l]
                    lines[close_l] = cln.slice(0, close_c) + " } }" + cln.slice(close_c + 1, cln.length())
                  }
                  mutated_lines[close_l] = true
                  file_changed = true
                  line_mutated = true
                } else if close_l >= 0 && (d.found.starts_with("OrderedSet[") || d.found.starts_with("mbt_compat::OrderedSet[")) {
                  let used_idents = get_used_idents()
                  let sit_var = fresh_stage_b_ident(used_idents, "__mbt_sit_" + tag)
                  let si_var = fresh_stage_b_ident(used_idents, "__mbt_si_" + tag)
                  let open_hdr = if comma_idx >= 0 {
                    let idx_v = vars_str.slice(0, comma_idx).trim()
                    let el_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    prefix + "{ let " + sit_var + " = (" + iter_expr + ").iter(); let mut " + si_var + " = 0; while true { match (" + sit_var + ".next)() { Some(" + el_v + ") => { let " + idx_v + " = " + si_var + "; " + si_var + " = " + si_var + " + 1; "
                  } else {
                    prefix + "{ let " + sit_var + " = (" + iter_expr + ").iter(); while true { match (" + sit_var + ".next)() { Some(" + vars_str + ") => { "
                  }
                  let close_tail = " }, None => break } } }"
                  if close_l == lidx {
                    let body_part = ln.slice(lb_idx + 2, close_c)
                    let after_part = ln.slice(close_c + 1, ln.length())
                    lines[lidx] = open_hdr + body_part + close_tail + after_part
                  } else {
                    let first_rest = ln.slice(lb_idx + 2, ln.length())
                    lines[lidx] = open_hdr + first_rest
                    let cln = lines[close_l]
                    lines[close_l] = cln.slice(0, close_c) + close_tail + cln.slice(close_c + 1, cln.length())
                  }
                  mutated_lines[close_l] = true
                  file_changed = true
                  line_mutated = true
                }
              }
            }
          }
          // 4. `operator '+' is not supported on 'Array[...]'` -> left-associative `mbt_compat::arr_concat(...)`
          //    (handles chained & multiline trailing `+` with comments, block/paren operands, and `for x in a + b`)
          //    and `operator '==' / '!=' is not supported on '<T>'` (Bytes, MbtJson, OrderedSet, Tuple, Option, Array)
          if !line_mutated && (str_has(d.message, "operator `+` is not supported on `Array[") ||
            str_has(d.message, "operator `==` is not supported on `") ||
            str_has(d.message, "operator `!=` is not supported on `")) {
            let cur_ln = lines[lidx]
            let is_arr_add = str_has(d.message, "operator `+`")
            let is_neq = str_has(d.message, "operator `!=`")
            let op_str = if is_arr_add { "+" } else if is_neq { "!=" } else { "==" }
            let on_idx = d.message.index_of("not supported on `")
            let eq_ty = if on_idx >= 0 {
              let r = d.message.slice(on_idx + 18, d.message.length())
              let bt = r.index_of("`")
              if bt > 0 { r.slice(0, bt) } else { "" }
            } else {
              ""
            }
            let custom_eq_fn = "__mbt_eq_" + ascii_to_lower(eq_ty)
            let has_custom_eq_fn = eq_ty.length() > 0 && !str_has(eq_ty, "[") && !str_has(eq_ty, "(") &&
            !str_has(eq_ty, ":") && str_has(f.content, "fn " + custom_eq_fn + "(")
            // Check if `eq_ty` is a generic type parameter constrained by `mbt_compat::MapKey` in the enclosing `fn`
            let mut is_mapkey_tparam = false
            if !has_custom_eq_fn && eq_ty.length() > 0 && !str_has(eq_ty, "[") && !str_has(eq_ty, "(") && !str_has(eq_ty, ":") {
              let mut scan_l = lidx
              while scan_l >= 0 {
                let sl = lines[scan_l].trim()
                if sl.starts_with("pub fn ") || sl.starts_with("fn ") {
                  if str_has(sl, eq_ty + " :") && str_has(sl, "mbt_compat::MapKey") {
                    is_mapkey_tparam = true
                  }
                  break
                }
                scan_l = scan_l - 1
              }
            }
            let can_structural_eq = has_custom_eq_fn || is_mapkey_tparam || eq_ty == "Bytes" ||
            eq_ty == "MbtJson" || eq_ty == "mbt_compat::MbtJson" ||
            eq_ty.starts_with("OrderedSet[") || eq_ty.starts_with("mbt_compat::OrderedSet[") ||
            (eq_ty.starts_with("(") && eq_ty.ends_with(")")) ||
            (eq_ty.starts_with("Option[") && eq_ty.ends_with("]")) ||
            ((eq_ty.starts_with("Array[") || eq_ty.starts_with("FixedArray[")) && eq_ty.ends_with("]"))
            if is_arr_add {
              // Gather multi-line continuation chunk incrementally (lexing only the newly-added line, bounded)
              let mut end_l = lidx
              let chunk_sb = StringBuilder()
              chunk_sb.write_string(lines[lidx])
              let mut pb_depth = 0
              let mut last_tok_plus = false
              let first_toks = lex_moonbit(lines[lidx])
              let fn0 = first_toks.length() - 1
              let mut fi0 = 0
              while fi0 < fn0 {
                let fk = first_toks[fi0].kind
                if fk == TokenKind::LParen || fk == TokenKind::LBracket { pb_depth = pb_depth + 1 }
                else if fk == TokenKind::RParen || fk == TokenKind::RBracket { if pb_depth > 0 { pb_depth = pb_depth - 1 } }
                fi0 = fi0 + 1
              }
              if fn0 > 0 {
                last_tok_plus = first_toks[fn0 - 1].kind == TokenKind::Plus
              }
              while end_l + 1 < lines.length() && end_l - lidx < 32 {
                let next_trimmed = lines[end_l + 1].trim()
                let next_starts_plus = next_trimmed.starts_with("+") && !next_trimmed.starts_with("+=")
                if pb_depth > 0 || last_tok_plus || next_starts_plus {
                  end_l = end_l + 1
                  chunk_sb.write_string("\n")
                  chunk_sb.write_string(lines[end_l])
                  let nt = lex_moonbit(lines[end_l])
                  let nn = nt.length() - 1
                  let mut ni = 0
                  while ni < nn {
                    let nk = nt[ni].kind
                    if nk == TokenKind::LParen || nk == TokenKind::LBracket { pb_depth = pb_depth + 1 }
                    else if nk == TokenKind::RParen || nk == TokenKind::RBracket { if pb_depth > 0 { pb_depth = pb_depth - 1 } }
                    ni = ni + 1
                  }
                  if nn > 0 {
                    last_tok_plus = nt[nn - 1].kind == TokenKind::Plus
                  }
                } else {
                  break
                }
              }
              let chunk = chunk_sb.to_string()
              let toks = lex_moonbit(chunk)
              let tn = toks.length() - 1
              let mut op_i = -1
              let mut best_dist = 1000000
              let mut ti = 0
              while ti < tn {
                if toks[ti].line == 1 && toks[ti].kind == TokenKind::Plus {
                  let dist = if toks[ti].col >= d.col { toks[ti].col - d.col } else { d.col - toks[ti].col }
                  if dist < best_dist { best_dist = dist; op_i = ti }
                }
                ti = ti + 1
              }
              if op_i > 0 && op_i + 1 < tn {
                // Scan backward to start of entire contiguous `+` chain
                let mut ls = op_i - 1
                let mut ld = 0
                while ls >= 0 {
                  let lk = toks[ls].kind
                  if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { ld = ld + 1 }
                  else if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace {
                    if ld == 0 { ls = ls + 1; break }
                    ld = ld - 1
                  } else if ld == 0 && (lk == TokenKind::Eq || lk == TokenKind::Comma || lk == TokenKind::Semi ||
                    lk == TokenKind::Colon || lk == TokenKind::AmpAmp || lk == TokenKind::PipePipe || lk == TokenKind::FatArrow ||
                    lk == TokenKind::EqEq || lk == TokenKind::BangEq || lk == TokenKind::Lt || lk == TokenKind::LtEq || lk == TokenKind::Gt || lk == TokenKind::GtEq ||
                    (lk == TokenKind::Keyword && (toks[ls].raw == "if" || toks[ls].raw == "else" || toks[ls].raw == "return" || toks[ls].raw == "while" || toks[ls].raw == "in" || toks[ls].raw == "match" || toks[ls].raw == "let"))) {
                    ls = ls + 1
                    break
                  }
                  ls = ls - 1
                }
                if ls < 0 { ls = 0 }
                // Scan forward across all contiguous top-level `+` operands
                let plus_positions : Array[Int] = []
                let mut re = ls
                let mut rd = 0
                let mut expect_operand = true
                while re < tn {
                  let rk = toks[re].kind
                  if rd == 0 && re > ls && toks[re].newline_before && !expect_operand && rk != TokenKind::Plus {
                    break
                  }
                  if rd == 0 && (rk == TokenKind::Comma || rk == TokenKind::Semi ||
                    rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::FatArrow ||
                    rk == TokenKind::EqEq || rk == TokenKind::BangEq || rk == TokenKind::Lt || rk == TokenKind::LtEq || rk == TokenKind::Gt || rk == TokenKind::GtEq ||
                    (rk == TokenKind::Keyword && toks[re].raw == "else")) {
                    break
                  }
                  if rd == 0 && rk == TokenKind::LBrace && !expect_operand && !(re > ls && toks[re - 1].kind == TokenKind::ColonColon) {
                    // Loop/match body `{ ... }` after `for x in a + b`
                    break
                  }
                  if rd == 0 && rk == TokenKind::Plus {
                    plus_positions.push(re)
                    expect_operand = true
                    re = re + 1
                    continue
                  }
                  if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
                    rd = rd + 1
                    expect_operand = false
                  } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                    if rd == 0 { break }
                    rd = rd - 1
                    expect_operand = false
                  } else {
                    expect_operand = false
                  }
                  re = re + 1
                }
                if plus_positions.length() >= 1 && re > plus_positions[plus_positions.length() - 1] + 1 {
                  let operands : Array[String] = []
                  let mut seg_s = ls
                  for pp in plus_positions {
                    if pp > seg_s {
                      operands.push(chunk.slice(toks[seg_s].start_byte, toks[pp - 1].end_byte).trim())
                    }
                    seg_s = pp + 1
                  }
                  if re > seg_s {
                    operands.push(chunk.slice(toks[seg_s].start_byte, toks[re - 1].end_byte).trim())
                  }
                  if operands.length() >= 2 {
                    let mut folded = "mbt_compat::arr_concat(" + operands[0] + ", " + operands[1] + ")"
                    let mut oi = 2
                    while oi < operands.length() {
                      folded = "mbt_compat::arr_concat(" + folded + ", " + operands[oi] + ")"
                      oi = oi + 1
                    }
                    let new_chunk = chunk.slice(0, toks[ls].start_byte) + folded + chunk.slice(toks[re - 1].end_byte, chunk.length())
                    lines[lidx] = new_chunk
                    let mut cl = lidx + 1
                    while cl <= end_l {
                      lines[cl] = ""
                      mutated_lines[cl] = true
                      cl = cl + 1
                    }
                    file_changed = true
                    line_mutated = true
                  }
                }
              }
            } else if can_structural_eq && !str_has(eq_ty, "<error>") {
              let toks = lex_moonbit(cur_ln)
              let mut op_i = -1
              let mut best_dist = 1000000
              let mut ti = 0
              while ti < toks.length() - 1 {
                if toks[ti].raw == op_str {
                  let dist = if toks[ti].col >= d.col { toks[ti].col - d.col } else { d.col - toks[ti].col }
                  if dist < best_dist { best_dist = dist; op_i = ti }
                }
                ti = ti + 1
              }
              if op_i > 0 && op_i + 1 < toks.length() - 1 {
                let mut ls = op_i - 1
                let mut ld = 0
                while ls >= 0 {
                  let lk = toks[ls].kind
                  if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { ld = ld + 1 }
                  else if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace {
                    if ld == 0 { ls = ls + 1; break }
                    ld = ld - 1
                  } else if ld == 0 && (lk == TokenKind::Eq || lk == TokenKind::Comma || lk == TokenKind::Semi ||
                    lk == TokenKind::Colon || lk == TokenKind::AmpAmp || lk == TokenKind::PipePipe || lk == TokenKind::FatArrow ||
                    (lk == TokenKind::Keyword && (toks[ls].raw == "if" || toks[ls].raw == "else" || toks[ls].raw == "return" || toks[ls].raw == "while" || toks[ls].raw == "in" || toks[ls].raw == "match" || toks[ls].raw == "let"))) {
                    ls = ls + 1
                    break
                  }
                  ls = ls - 1
                }
                if ls < 0 { ls = 0 }
                let mut re = op_i + 1
                let mut rd = 0
                while re < toks.length() - 1 {
                  let rk = toks[re].kind
                  if rd == 0 && (rk == TokenKind::Comma || rk == TokenKind::Semi ||
                    rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::FatArrow ||
                    rk == TokenKind::LBrace ||
                    (rk == TokenKind::Keyword && toks[re].raw == "else")) {
                    break
                  } else if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
                  else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                    if rd == 0 { break }
                    rd = rd - 1
                  }
                  re = re + 1
                }
                if ls < op_i && re > op_i + 1 {
                  let lhs_s = cur_ln.slice(toks[ls].start_byte, toks[op_i - 1].end_byte).trim()
                  let rhs_s = cur_ln.slice(toks[op_i + 1].start_byte, toks[re - 1].end_byte).trim()
                  let repl = if has_custom_eq_fn {
                    (if is_neq { "!" } else { "" }) + custom_eq_fn + "(" + lhs_s + ", " + rhs_s + ")"
                  } else if is_mapkey_tparam {
                    (if is_neq { "!" } else { "" }) + "(" + lhs_s + ").key_eq(" + rhs_s + ")"
                  } else if eq_ty == "Bytes" {
                    (if is_neq { "!mbt_compat::bytes_eq(" } else { "mbt_compat::bytes_eq(" }) + lhs_s + ", " + rhs_s + ")"
                  } else if eq_ty == "MbtJson" || eq_ty == "mbt_compat::MbtJson" {
                    (if is_neq { "!mbt_compat::mbt_json_eq(" } else { "mbt_compat::mbt_json_eq(" }) + lhs_s + ", " + rhs_s + ")"
                  } else if eq_ty.starts_with("OrderedSet[") || eq_ty.starts_with("mbt_compat::OrderedSet[") {
                    (if is_neq { "!mbt_compat::ordered_set_eq(" } else { "mbt_compat::ordered_set_eq(" }) + lhs_s + ", " + rhs_s + ")"
                  } else {
                    let used_idents = get_used_idents()
                    let la = fresh_stage_b_ident(used_idents, "__eq_l_" + lidx.to_string())
                    let rb = fresh_stage_b_ident(used_idents, "__eq_r_" + lidx.to_string())
                    let body = gen_eq_expr_hygienic(la, rb, eq_ty, used_idents)
                    let final_b = if is_neq { "!(" + body + ")" } else { body }
                    "{ let " + la + " : " + eq_ty + " = " + lhs_s + "; let " + rb + " : " + eq_ty + " = " + rhs_s + "; " + final_b + " }"
                  }
                  lines[lidx] = cur_ln.slice(0, toks[ls].start_byte) + repl + cur_ln.slice(toks[re - 1].end_byte, cur_ln.length())
                  file_changed = true
                  line_mutated = true
                }
              }
            }
          }
          // 4b. Custom operator trait lowering (`+`, `-`, `*`, `/`) + fail-closed compound assignment (`+=`, `-=`, `*=`, `/=`) (§D1-3)
          if !line_mutated && str_has(d.message, "operator `") &&
          (str_has(d.message, " is not supported on `") || str_has(d.message, " is not supported for type `")) {
            let op_start = d.message.index_of("operator `") + 10
            let op_rest = d.message.slice(op_start, d.message.length())
            let op_end = op_rest.index_of("`")
            let on_idx1 = d.message.index_of("not supported on `")
            let on_idx2 = d.message.index_of("not supported for type `")
            let ty_start = if on_idx1 >= 0 {
              on_idx1 + 18
            } else if on_idx2 >= 0 {
              on_idx2 + 24
            } else {
              -1
            }
            if op_end > 0 && ty_start >= 0 {
              let raw_op = op_rest.slice(0, op_end)
              let ty_rest = d.message.slice(ty_start, d.message.length())
              let ty_end = ty_rest.index_of("`")
              if ty_end > 0 {
                let op_ty = ty_rest.slice(0, ty_end)
                let cur_ln = lines[lidx]
                // Check for compound assignment (`+=`, `-=`, `*=`, `/=`) on this line near `d.col` FIRST (Opus P2-2 fail-closed!)
                let mut is_compound = raw_op == "+=" || raw_op == "-=" || raw_op == "*=" || raw_op == "/="
                let mut compound_sym = raw_op
                if !is_compound && (raw_op == "+" || raw_op == "-" || raw_op == "*" || raw_op == "/") {
                  let ctoks = lex_moonbit(cur_ln)
                  let target_assign = raw_op + "="
                  let mut has_assign = false
                  let mut has_exact_bin = false
                  let mut ci = 0
                  while ci < ctoks.length() - 1 {
                    if ctoks[ci].kind == TokenKind::AssignOp && ctoks[ci].raw == target_assign {
                      has_assign = true
                    } else if ctoks[ci].raw == raw_op {
                      let dist = if ctoks[ci].col >= d.col { ctoks[ci].col - d.col } else { d.col - ctoks[ci].col }
                      if dist <= 2 {
                        has_exact_bin = true
                      }
                    }
                    ci = ci + 1
                  }
                  if has_assign && !has_exact_bin {
                    is_compound = true
                    compound_sym = target_assign
                  }
                }
                let op_name = if is_compound && compound_sym.length() >= 2 {
                  op_symbol_to_name(compound_sym.slice(0, 1))
                } else {
                  op_symbol_to_name(raw_op)
                }
                if is_compound && op_name.length() > 0 && op_lookup.contains(op_ty + "|" + op_name) {
                  let mut dup = false
                  for existing in diags {
                    if existing.code == "MBT2PION_UNSUPPORTED_SYNTAX" && existing.file == f.rel_path && existing.line == d.line {
                      dup = true
                      break
                    }
                  }
                  if !dup {
                    diags.push(diag_error(
                      "MBT2PION_UNSUPPORTED_SYNTAX",
                      f.rel_path,
                      d.line,
                      d.col,
                      "compound assignment `" + compound_sym + "` on custom operator-overloaded type `" + op_ty + "` is not supported (fail-closed)",
                    ))
                  }
                } else if !is_compound && op_name.length() > 0 {
                  match op_lookup.get(op_ty + "|" + op_name) {
                    Some(helper_fn) =>
                    if rewrite_custom_binop_at(lines, lidx, d.col, raw_op, helper_fn, mutated_lines) {
                      file_changed = true
                      line_mutated = true
                    }
                    None => ()
                  }
                }
              }
            }
          }
          // 5. `string interpolation does not support type '<T>'` -> `\{(<expr>).to_string()}`
          if !line_mutated && str_has(d.message, "string interpolation does not support type `") {
            let cur_ln = lines[lidx]
            let target_0 = if d.col > 0 { d.col - 1 } else { 0 }
            let mut best = -1
            let mut best_end = -1
            let mut best_dist = 1000000
            let mut pos = 0
            while pos + 2 < cur_ln.length() {
              if cur_ln.code_unit_at(pos) == 92 && cur_ln.code_unit_at(pos + 1) == 123 {
                let mut j = pos + 2
                let mut d2 = 1
                while j < cur_ln.length() && d2 > 0 {
                  let ch = cur_ln.code_unit_at(j)
                  if ch == 123 { d2 = d2 + 1 }
                  else if ch == 125 { d2 = d2 - 1; if d2 == 0 { break } }
                  j = j + 1
                }
                if d2 == 0 {
                  let inner = cur_ln.slice(pos + 2, j).trim()
                  if !inner.ends_with(".to_string()") {
                    let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
                    if dist < best_dist { best_dist = dist; best = pos; best_end = j }
                  }
                }
              }
              pos = pos + 1
            }
            if best >= 0 && best_end > best + 2 {
              let inner = cur_ln.slice(best + 2, best_end).trim()
              lines[lidx] = cur_ln.slice(0, best + 2) + "(" + inner + ").to_string()" + cur_ln.slice(best_end, cur_ln.length())
              file_changed = true
              line_mutated = true
            }
          }
        }
        if line_mutated {
          mutated_lines[lidx] = true
        }
      }
      if file_changed {
        changed = true
        changed_rels.push(f.rel_path)
        let sb = StringBuilder()
        let mut li = 0
        while li < lines.length() {
          if li > 0 {
            sb.write_string("\n")
          }
          sb.write_string(lines[li])
          li = li + 1
        }
        next_files.push(GeneratedFile::{
          rel_path: f.rel_path,
          content: sb.to_string(),
          source_file: f.source_file,
          anchors: f.anchors,
        })
      } else {
        next_files.push(f)
      }
    }
    cur_files = next_files
    let changed_rel_set : Map[String, Bool] = Map()
    for rel in changed_rels {
      changed_rel_set[rel] = true
      let prev_ver = match file_vers.get(rel) {
        Some(v) => v
        None => 0
      }
      file_vers[rel] = prev_ver + 1
    }
    qt_used_prev_round = qt_used_this_round
    prev_round_changed_cap_file = false
    if changed {
      qt_snap_dirty = true
      need_qt_for_capacity = false
      for cf in cur_files {
        if file_has_capacity_marker(cf.content) {
          need_qt_for_capacity = true
          if changed_rel_set.contains(cf.rel_path) {
            prev_round_changed_cap_file = true
          }
        }
      }
    } else {
      break
    }
  }

  let out_qt = if qt_snap.ok && !qt_snap_dirty { qt_snap } else { empty_pkg_query_types() }
  (cur_files, iter, final_hist, out_qt)
}

///| Rewrite `<recv>.split(<sep>).next()` on `Array[String]` -> `mbt_compat::str_split_first(<recv>, <sep>)`.
///| Strictly fail-closed: only rewrites when the zero-arg `.next()` receiver lexically ends with `.split(<1 arg>)`.
fn split_next_receiver_start_token(toks : Array[Token], end_i : Int) -> Int {
  if end_i < 0 || end_i >= toks.length() {
    return -1
  }
  let ek = toks[end_i].kind
  if ek != TokenKind::Ident && ek != TokenKind::UpperIdent &&
  ek != TokenKind::RParen && ek != TokenKind::RBracket &&
  ek != TokenKind::StringLit && ek != TokenKind::InterpString &&
  ek != TokenKind::RawMultiline && ek != TokenKind::InterpMultiline {
    return -1
  }
  let mut cur = end_i
  while cur >= 0 {
    let ck = toks[cur].kind
    if ck == TokenKind::RParen || ck == TokenKind::RBracket {
      let op = find_open_before(toks, cur, 0)
      if op < 0 {
        return -1
      }
      cur = op
      if cur > 0 {
        let pk = toks[cur - 1].kind
        if pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
        pk == TokenKind::RParen || pk == TokenKind::RBracket {
          cur = cur - 1
          continue
        }
      }
      break
    }
    if cur >= 2 && toks[cur - 1].kind == TokenKind::ColonColon &&
    (toks[cur - 2].kind == TokenKind::UpperIdent || toks[cur - 2].kind == TokenKind::Ident) {
      cur = cur - 2
      continue
    }
    if cur >= 2 && toks[cur - 1].kind == TokenKind::Dot {
      let pk = toks[cur - 2].kind
      if pk == TokenKind::Ident || pk == TokenKind::UpperIdent || pk == TokenKind::IntLit ||
      pk == TokenKind::RParen || pk == TokenKind::RBracket ||
      pk == TokenKind::StringLit || pk == TokenKind::InterpString ||
      pk == TokenKind::RawMultiline || pk == TokenKind::InterpMultiline {
        cur = cur - 2
        continue
      }
    }
    break
  }
  cur
}

fn rewrite_split_next_at(line_text : String, col : Int) -> Option[String] {
  let toks = lex_moonbit(line_text)
  let tn = toks.length() - 1
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 3 < tn {
    if toks[ti].kind == TokenKind::Dot && toks[ti + 1].kind == TokenKind::Ident &&
    toks[ti + 1].raw == "next" && toks[ti + 2].kind == TokenKind::LParen &&
    toks[ti + 3].kind == TokenKind::RParen {
      let dist = if toks[ti + 1].col >= col { toks[ti + 1].col - col } else { col - toks[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i < 5 || toks[dot_i - 1].kind != TokenKind::RParen {
    return None
  }
  let split_lp = find_open_before(toks, dot_i - 1, 0)
  if split_lp < 3 || toks[split_lp - 1].kind != TokenKind::Ident ||
  toks[split_lp - 1].raw != "split" || toks[split_lp - 2].kind != TokenKind::Dot {
    return None
  }
  let sargs = ms_split_call_args(toks, split_lp, dot_i - 1)
  if sargs.length() != 1 || sargs[0].0 >= sargs[0].1 {
    return None
  }
  let recv_start = split_next_receiver_start_token(toks, split_lp - 3)
  if recv_start < 0 || recv_start > split_lp - 3 ||
  (recv_start > 0 && (toks[recv_start - 1].kind == TokenKind::ColonColon || toks[recv_start - 1].kind == TokenKind::Dot)) {
    return None
  }
  let recv_s = line_text.slice(toks[recv_start].start_byte, toks[split_lp - 3].end_byte).trim()
  let sep_s = line_text.slice(toks[sargs[0].0].start_byte, toks[sargs[0].1 - 1].end_byte).trim()
  if recv_s.length() == 0 || sep_s.length() == 0 || unsafe_index_arg_is_labelled(sep_s) {
    return None
  }
  Some(
    line_text.slice(0, toks[recv_start].start_byte) +
    "mbt_compat::str_split_first(" + recv_s + ", " + sep_s + ")" +
    line_text.slice(toks[dot_i + 3].end_byte, line_text.length()),
  )
}

///| Rewrite `<recv>.to_char()` on `Int` inline to MoonBit's exact Unicode scalar check
///| without modifying `mbt_compat`: returns `Some(ch)` iff `0 <= n <= 0x10FFFF` and not a surrogate.
fn rewrite_int_to_char_at(line_text : String, col : Int, used : Map[String, Bool]) -> Option[String] {
  let dot_idx = find_method_dot_at_col(line_text, "to_char", col)
  if dot_idx <= 0 {
    return None
  }
  let needle = ".to_char()"
  if dot_idx + needle.length() > line_text.length() || line_text.slice(dot_idx, dot_idx + needle.length()) != needle {
    return None
  }
  let mut recv_start = dot_idx - 1
  let mut paren_d = 0
  let mut brack_d = 0
  let mut brace_d = 0
  while recv_start >= 0 {
    let c = line_text.code_unit_at(recv_start)
    if (c == 34 || c == 39) && (paren_d > 0 || brack_d > 0 || brace_d > 0) {
      let quote = c
      recv_start = recv_start - 1
      while recv_start >= 0 {
        if line_text.code_unit_at(recv_start) == quote {
          let mut bs = 0
          let mut bi = recv_start - 1
          while bi >= 0 && line_text.code_unit_at(bi) == 92 {
            bs = bs + 1
            bi = bi - 1
          }
          if bs % 2 == 0 {
            recv_start = recv_start - 1
            break
          }
        }
        recv_start = recv_start - 1
      }
      continue
    }
    if c == 41 { paren_d = paren_d + 1; recv_start = recv_start - 1 }
    else if c == 40 { if paren_d == 0 { break }; paren_d = paren_d - 1; recv_start = recv_start - 1 }
    else if c == 93 { brack_d = brack_d + 1; recv_start = recv_start - 1 }
    else if c == 91 { if brack_d == 0 { break }; brack_d = brack_d - 1; recv_start = recv_start - 1 }
    else if c == 125 { brace_d = brace_d + 1; recv_start = recv_start - 1 }
    else if c == 123 { if brace_d == 0 { break }; brace_d = brace_d - 1; recv_start = recv_start - 1 }
    else if paren_d > 0 || brack_d > 0 || brace_d > 0 { recv_start = recv_start - 1 }
    else if is_alnum(c) || c == 95 || c == 46 || c == 58 { recv_start = recv_start - 1 }
    else { break }
  }
  recv_start = recv_start + 1
  let recv = line_text.slice(recv_start, dot_idx).trim()
  if recv.length() == 0 {
    return None
  }
  let mut tmp = "__mbt_ch"
  let mut k = 1
  while used.contains(tmp) {
    tmp = "__mbt_ch_" + k.to_string()
    k = k + 1
  }
  used[tmp] = true
  let repl = "({ let " + tmp + " = " + recv + "; if " + tmp + " >= 0 && " + tmp + " <= 0x10FFFF && !(" + tmp + " >= 0xD800 && " + tmp + " <= 0xDFFF) { Option::Some(" + tmp + ".unsafe_to_char()) } else { Option::None } })"
  Some(line_text.slice(0, recv_start) + repl + line_text.slice(dot_idx + needle.length(), line_text.length()))
}

fn stage_b_audit_final_push_iter_calls(cur_files : Array[GeneratedFile], diags : Array[Diag]) -> Unit {
  for f in cur_files {
    if !str_has(f.content, "arr_push_iter(") {
      continue
    }
    let tokens = lex_moonbit(f.content)
    let n = tokens.length() - 1
    let mut i = 0
    while i + 3 < n {
      if tokens[i].raw == "mbt_compat" && tokens[i + 1].kind == TokenKind::ColonColon &&
      tokens[i + 2].raw == "arr_push_iter" && tokens[i + 3].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i + 3)
        // Find depth-0 comma separating arg0 (`dst`) and arg1 (`it`)
        let mut comma_i = -1
        let mut d = 0
        let mut j = i + 4
        while j < cp {
          let jk = tokens[j].kind
          if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace { d = d + 1 }
          else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace { d = d - 1 }
          else if d == 0 && jk == TokenKind::Comma { comma_i = j; break }
          j = j + 1
        }
        let arg_s = comma_i + 1
        let arg_e = cp
        let is_proven_arr_iter = comma_i > 0 && arg_e >= arg_s + 5 &&
        tokens[arg_s].raw == "mbt_compat" && tokens[arg_s + 1].kind == TokenKind::ColonColon &&
        tokens[arg_s + 2].raw == "arr_iter" && tokens[arg_s + 3].kind == TokenKind::LParen &&
        find_matching_delim(tokens, arg_s + 3) == arg_e - 1
        if !is_proven_arr_iter {
          let line = tokens[i + 2].line
          let col = tokens[i + 2].col
          let mut dup = false
          for existing in diags {
            if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f.rel_path && existing.line == line && existing.col == col {
              dup = true
              break
            }
          }
          if !dup {
            diags.push(diag_error(
              "MBT2PION_ARRAY_ITER_MUTATION",
              f.rel_path,
              line,
              col,
              "`Array::push_iter(...)` only supports bare `Array::iter()` arguments (fail-closed against callback/custom-iterator mutation)",
            ))
          }
        }
      }
      i = i + 1
    }
  }
}

///| Stage B fail-closed guard for `Array::push_iter(arg)`:
///| Returns:
///|   1  -> `arg` is proven `mbt_compat::arr_iter(...)` (pure array iterator, zero user callbacks): allow rewrite.
///|   0  -> `arg` still ends with `.iter()` and an `arr_iter` rewrite is pending in this file/round: defer 1 round.
///|  -1  -> `arg` is non-array / custom `.iter()` / mapped iterator / opaque variable: emit `MBT2PION_ARRAY_ITER_MUTATION` and block rewrite.
///| `xs.shrink_to_fit()` on a Pion `Array` (`lower_capacity.pion`): true when no buffer snapshot can observe
///| it; otherwise records `MBT2PION_ARRAY_SHRINK_ITER` and returns false (the call is left unlowered).
fn stage_b_check_shrink_snapshot_cached(
  tokens : Array[Token],
  shrink_pkg : ShrinkPkg,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Bool {
  let mut name_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 1 < tokens.length() {
    if tokens[ti].raw == "shrink_to_fit" && tokens[ti - 1].kind == TokenKind::Dot && tokens[ti].line == line &&
    tokens[ti + 1].kind == TokenKind::LParen {
      let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      if dist < best {
        best = dist
        name_i = ti
      }
    }
    ti = ti + 1
  }
  if name_i < 0 {
    return false
  }
  let why = shrink_snapshot_hazard_with_qt(tokens, name_i, shrink_pkg, content, qfi_opt)
  if why.length() == 0 {
    return true
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_SHRINK_ITER" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_SHRINK_ITER",
    f_rel,
    line,
    col,
    "`Array::shrink_to_fit()` is not supported where a buffer snapshot may observe it: " + why +
    " (fail-closed: MoonBit moves the elements to a new buffer, a Pion `Array` keeps one storage)",
  ))
  false
}

///| `xs.iter()` kept past its expression (`lower_capacity.pion` `kept_iter_hazard`): true when `arr_iter` reads
///| what MoonBit's iterator would; otherwise records `MBT2PION_ARRAY_ITER_MUTATION` and returns false.
fn stage_b_check_kept_iter(
  file_tokens : Map[String, Array[Token]],
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  declared_types : Map[String, Bool],
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Bool {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let mut dot_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 2 < tokens.length() {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == "iter" && tokens[ti + 2].kind == TokenKind::LParen &&
    tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best {
        best = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i < 0 {
    return false
  }
  let why = kept_iter_hazard_with_qt(tokens, dot_i, content, qfi_opt, declared_types)
  if why.length() == 0 {
    return true
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_ITER_MUTATION",
    f_rel,
    line,
    col,
    "a kept `Array::iter()` is not supported where its array changes in a way MoonBit's buffer snapshot would not see: " +
    why + " (fail-closed)",
  ))
  false
}

///| `xs.sort_by_key(key)`: the receiver-mutation gate can only see into a closure literal, so an opaque key (a
///| parameter, a variable, a function name) could push to `xs` while it is sorted -- MoonBit sorts a view of the
///| old buffer, `arr_sort_by` the live array. Only `fn(..) { .. }` keys are lowered; others record
///| `MBT2PION_ARRAY_ITER_MUTATION`.
fn stage_b_check_sort_key_closure_cached(
  tokens : Array[Token],
  env : SortKeyEnv,
  f_rel : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Bool {
  let mut open = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 1 < tokens.length() {
    if tokens[ti].raw == "sort_by_key" && tokens[ti - 1].kind == TokenKind::Dot && tokens[ti].line == line &&
    tokens[ti + 1].kind == TokenKind::LParen {
      let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      if dist < best {
        best = dist
        open = ti + 1
      }
    }
    ti = ti + 1
  }
  if open < 0 {
    return false
  }
  if open + 1 < tokens.length() && tokens[open + 1].raw == "fn" {
    // The closure body may not run code the receiver-mutation gate cannot see.
    let why = sort_key_closure_opacity(tokens, open, env)
    if why.length() == 0 {
      return true
    }
    for existing in diags {
      if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
        return false
      }
    }
    diags.push(diag_error(
      "MBT2PION_ARRAY_ITER_MUTATION",
      f_rel,
      line,
      col,
      "`Array::sort_by_key` key closure is not supported: " + why + " (fail-closed: it could change the array while it is sorted)",
    ))
    return false
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_ITER_MUTATION",
    f_rel,
    line,
    col,
    "`Array::sort_by_key` with a key that is not a closure literal is not supported (fail-closed: an opaque key could change the array while it is sorted)",
  ))
  false
}

///| After Stage B has converged: every `mbt_compat::arr_sort_by_key(xs, key)` must have a pure closure-literal key
///| (`sort_key_closure_purity_at`) as it reads now -- later rounds lower operators (`a + b` on a user type becomes
///| `mbt_op_add_T(a, b)`) and other calls the first check could not see.
pub fn stage_b_audit_final_sort_keys(cur_files : Array[GeneratedFile], diags : Array[Diag]) -> Unit {
  stage_b_audit_final_sort_keys_with_deps(cur_files, Map(), diags)
}

pub fn stage_b_audit_final_sort_keys_with_deps(
  cur_files : Array[GeneratedFile],
  dep_methods : Map[String, Bool],
  diags : Array[Diag],
) -> Unit {
  let all : Array[Array[Token]] = []
  let lexed : Array[(GeneratedFile, Array[Token])] = []
  for f in cur_files {
    let ts = lex_moonbit(f.content)
    all.push(ts)
    if str_has(f.content, "arr_sort_by_key(") {
      lexed.push((f, ts))
    }
  }
  if lexed.length() == 0 {
    return
  }
  let env = sort_key_env_of_with_deps(all, dep_methods)
  for fp in lexed {
    let f = fp.0
    let tokens = fp.1
    let n = tokens.length() - 1
    let mut i = 0
    while i + 3 < n {
      if tokens[i].raw == "mbt_compat" && tokens[i + 1].kind == TokenKind::ColonColon &&
      tokens[i + 2].raw == "arr_sort_by_key" && tokens[i + 3].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i + 3)
        let mut comma_i = -1
        let mut d = 0
        let mut j = i + 4
        while j < cp {
          let jk = tokens[j].kind
          if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace {
            d = d + 1
          } else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace {
            d = d - 1
          } else if d == 0 && jk == TokenKind::Comma {
            comma_i = j
            break
          }
          j = j + 1
        }
        let root = if comma_i == i + 5 && tokens[i + 4].kind == TokenKind::Ident { tokens[i + 4].raw } else { "" }
        let why = if comma_i < 0 {
          "the key is missing"
        } else {
          sort_key_closure_purity_at(tokens, comma_i + 1, root, env)
        }
        if why.length() > 0 {
          let line = tokens[i + 2].line
          let col = tokens[i + 2].col
          let mut dup = false
          for existing in diags {
            if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f.rel_path && existing.line == line {
              dup = true
              break
            }
          }
          if !dup {
            diags.push(diag_error(
              "MBT2PION_ARRAY_ITER_MUTATION",
              f.rel_path,
              line,
              col,
              "`Array::sort_by_key` key closure is not supported: " + why + " (fail-closed: it could change the array while it is sorted)",
            ))
          }
        }
        i = cp
      }
      i = i + 1
    }
  }
}

fn stage_b_check_push_iter_arg(
  file_tokens : Map[String, Array[Token]],
  f_rel : String,
  content : String,
  line : Int,
  col : Int,
  has_pending_arr_iter : Bool,
  diags : Array[Diag],
) -> Int {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let n = tokens.length() - 1
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 2 < n {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == "push_iter" &&
    tokens[ti + 2].kind == TokenKind::LParen && tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i <= 0 {
    return -1
  }
  let arg_s = dot_i + 3
  let arg_e = find_matching_delim(tokens, dot_i + 2)
  // Case A: exact `mbt_compat::arr_iter(...)` proven by `pionc check`
  if arg_e >= arg_s + 5 && tokens[arg_s].raw == "mbt_compat" &&
  tokens[arg_s + 1].kind == TokenKind::ColonColon && tokens[arg_s + 2].raw == "arr_iter" &&
  tokens[arg_s + 3].kind == TokenKind::LParen && find_matching_delim(tokens, arg_s + 3) == arg_e - 1 {
    return 1
  }
  // Case B: ends with `.iter()` — wait 1 round only if an `arr_iter` rewrite is pending in this file
  if arg_e >= arg_s + 4 && tokens[arg_e - 4].kind == TokenKind::Dot &&
  tokens[arg_e - 3].raw == "iter" && tokens[arg_e - 2].kind == TokenKind::LParen &&
  tokens[arg_e - 1].kind == TokenKind::RParen {
    if has_pending_arr_iter {
      return 0
    }
  }
  // Case B-fail / Case C: fail-closed with `MBT2PION_ARRAY_ITER_MUTATION`
  let mut dup = false
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line && existing.col == col {
      dup = true
      break
    }
  }
  if !dup {
    diags.push(diag_error(
      "MBT2PION_ARRAY_ITER_MUTATION",
      f_rel,
      line,
      col,
      "`Array::push_iter(...)` only supports bare `Array::iter()` arguments (fail-closed against callback/custom-iterator mutation)",
    ))
  }
  -1
}

// ---------------------------------------------------------------------------
// Wave F6-3a: Unified `mutation_summary` integration for Gates A, B, C, D
// ---------------------------------------------------------------------------

fn stage_b_record_mutation_allow(
  drift_ledger : Array[DriftEntry],
  category : String,
  file : String,
  line : Int,
  col : Int,
  expr : String,
  resolution : String,
  detail : String,
) -> Unit {
  for e in drift_ledger {
    if e.category == category && e.file == file && e.line == line && e.col == col {
      return
    }
  }
  drift_ledger.push(DriftEntry::{
    category,
    file,
    line,
    col,
    expr,
    resolution,
    status: "resolved",
    detail,
  })
}

///| Gate A: `Array::shrink_to_fit()` backed by `PkgMutationSummary` + allow ledger.
fn stage_b_check_shrink_snapshot_with_summary(
  tokens : Array[Token],
  shrink_pkg : ShrinkPkg,
  shrink_pkg_summary : ShrinkPkg,
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  line : Int,
  col : Int,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let mut name_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 1 < tokens.length() {
    if tokens[ti].raw == "shrink_to_fit" && tokens[ti - 1].kind == TokenKind::Dot && tokens[ti].line == line &&
    tokens[ti + 1].kind == TokenKind::LParen {
      let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      if dist < best {
        best = dist
        name_i = ti
      }
    }
    ti = ti + 1
  }
  if name_i < 0 {
    return false
  }
  let (why, allowed_by_ms) = shrink_snapshot_hazard_with_summary(
    tokens,
    name_i,
    shrink_pkg,
    shrink_pkg_summary,
    mut_summary,
    content,
    qfi_opt,
  )
  if why.length() == 0 {
    if allowed_by_ms {
      stage_b_record_mutation_allow(
        drift_ledger,
        "mutation_summary_allow_a",
        f_rel,
        line,
        col,
        "shrink_to_fit",
        "mbt_compat::arr_shrink_to_fit",
        "mutation_summary proved no live iterator/view can observe shrink_to_fit",
      )
    }
    return true
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_SHRINK_ITER" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_SHRINK_ITER",
    f_rel,
    line,
    col,
    "`Array::shrink_to_fit()` is not supported where a buffer snapshot may observe it: " + why +
    " (fail-closed: MoonBit moves the elements to a new buffer, a Pion `Array` keeps one storage)",
  ))
  false
}

///| Gate B: `Array::search_by` / `filter_map` / `sort_by_key` callback purity backed by `PkgMutationSummary` + allow ledger.
fn stage_b_check_hof_ro_with_summary(
  tokens : Array[Token],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  elem_ty : String,
  line : Int,
  col : Int,
  mname : String,
  helper : String,
  record_allow : Bool,
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let n = tokens.length() - 1
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 2 < n {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == mname &&
    tokens[ti + 2].kind == TokenKind::LParen && tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i <= 0 {
    return false
  }
  let arg_s = dot_i + 3
  let arg_e = find_matching_delim(tokens, dot_i + 2)
  if arg_s >= arg_e {
    return false
  }
  let body_open = outermost_body_open(tokens, dot_i)
  if body_open < 0 {
    return false
  }
  let active_gen = enclosing_fn_generic_params(tokens, body_open)
  let sum = summarize_callback_arg(mut_summary, tokens, arg_s, arg_e, body_open, content, qfi_opt, elem_ty, active_gen)
  let is_safe = if mname == "sort_by_key" {
    !sum.unknown && !sum.mutates_any_array && sum.mutated_elem_types.length() == 0
  } else {
    !summary_may_mutate_array(sum, elem_ty)
  }
  if is_safe {
    if record_allow {
      stage_b_record_mutation_allow(
        drift_ledger,
        "mutation_summary_allow_b",
        f_rel,
        line,
        col,
        mname,
        helper,
        "mutation_summary proved " + mname + " callback cannot mutate Array[" + elem_ty + "]",
      )
    }
    return true
  }
  false
}

///| Gate B wrapper for `Array::search_by(cb)`.
fn stage_b_check_search_by_with_summary(
  tokens : Array[Token],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  elem_ty : String,
  line : Int,
  col : Int,
  record_allow : Bool,
  drift_ledger : Array[DriftEntry],
) -> Bool {
  stage_b_check_hof_ro_with_summary(
    tokens,
    mut_summary,
    f_rel,
    content,
    qfi_opt,
    elem_ty,
    line,
    col,
    "search_by",
    "mbt_compat::arr_search_by",
    record_allow,
    drift_ledger,
  )
}

///| Gate C: Immediate `.iter().(any|all|find_first)(cb)` backed by `PkgMutationSummary` + allow ledger.
fn stage_b_check_kept_iter_with_summary(
  file_tokens : Map[String, Array[Token]],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  declared_types : Map[String, Bool],
  elem_ty : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let mut dot_i = -1
  let mut best = 1000000
  let mut ti = 1
  while ti + 2 < tokens.length() {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == "iter" && tokens[ti + 2].kind == TokenKind::LParen &&
    tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best {
        best = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i < 0 {
    return false
  }
  let mut why = kept_iter_hazard_with_qt(tokens, dot_i, content, qfi_opt, declared_types)
  if why.length() == 0 {
    // Soundness check: for immediate `.iter().(any|all|find_first)(cb)` on ANY named receiver
    // (including fresh locals, which can still be mutated via stored closures), always require
    // `mutation_summary` to rule out trait/operator/indirect-closure mutations.
    let close_p = find_matching_delim(tokens, dot_i + 2)
    let is_imm_pred = close_p == dot_i + 3 && close_p + 3 < tokens.length() &&
    tokens[close_p + 1].kind == TokenKind::Dot &&
    (tokens[close_p + 2].raw == "any" || tokens[close_p + 2].raw == "all" || tokens[close_p + 2].raw == "find_first") &&
    tokens[close_p + 3].kind == TokenKind::LParen
    if is_imm_pred && !is_array_literal_end(tokens, dot_i - 1) {
      match immediate_iter_consumer_allow_with_summary(tokens, dot_i, mut_summary, content, qfi_opt, elem_ty) {
        Some(_) => return true
        None => why = "callback in immediate `.iter()." + tokens[close_p + 2].raw + "(...)` may mutate the array (trait/operator/opaque/mutating call)"
      }
    } else {
      return true
    }
  } else {
    match immediate_iter_consumer_allow_with_summary(tokens, dot_i, mut_summary, content, qfi_opt, elem_ty) {
      Some(detail) => {
        stage_b_record_mutation_allow(
          drift_ledger,
          "mutation_summary_allow_c",
          f_rel,
          line,
          col,
          ".iter()",
          "mbt_compat::arr_iter",
          detail,
        )
        return true
      }
      None => ()
    }
  }
  for existing in diags {
    if existing.code == "MBT2PION_ARRAY_ITER_MUTATION" && existing.file == f_rel && existing.line == line {
      return false
    }
  }
  diags.push(diag_error(
    "MBT2PION_ARRAY_ITER_MUTATION",
    f_rel,
    line,
    col,
    "a kept `Array::iter()` is not supported where its array changes in a way MoonBit's buffer snapshot would not see: " +
    why + " (fail-closed)",
  ))
  false
}

fn stage_b_is_simple_ident(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let c0 = s.code_unit_at(0)
  let ok0 = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95
  if !ok0 {
    return false
  }
  let mut k = 1
  while k < s.length() {
    let c = s.code_unit_at(k)
    let ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
    if !ok {
      return false
    }
    k = k + 1
  }
  true
}

///| Gate D: Rewrite provably read-only `for <vars> in <arr[lo:hi]> { <body> }` borrowed-slice loops
///| (emitted by Stage A as `mbt_compat::__mbt_slice_borrow(...)` or `({ let __mbt_sl_N = ...; mbt_compat::__mbt_slice_borrow(...) })`)
///| into MoonBit-exact clamped index `while` loops:
///|   1. Evaluate `recv` -> `lo` -> `hi` once in order;
///|   2. Take `len = recv.length()` AFTER `hi` finishes;
///|   3. Clamp `lo` and `hi` to `[0, len]`, with `hi_c = max(lo_c, hi_c0)`;
///|   4. Advance index before body so `break`/`continue` preserve exact control targets.
fn stage_b_rewrite_borrowed_slice_for_loops(
  lines : Array[String],
  tokens : Array[Token],
  mut_summary : PkgMutationSummary,
  f_rel : String,
  content : String,
  qfi_opt : Option[QtFileIndex],
  used_idents : Map[String, Bool],
  mutated_lines : Map[Int, Bool],
  drift_ledger : Array[DriftEntry],
) -> Bool {
  let n = tokens.length() - 1
  let mut any_changed = false
  let mut i = 0
  while i + 5 < n {
    if tokens[i].raw == "for" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) {
      let mut j = i + 1
      let mut in_i = -1
      let mut d = 0
      while j < n {
        let jk = tokens[j].kind
        if d == 0 && jk == TokenKind::LBrace {
          break
        }
        if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace { d = d + 1 }
        else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
        else if d == 0 && tokens[j].raw == "in" && in_i < 0 { in_i = j }
        j = j + 1
      }
      if in_i > i + 1 && j < n && tokens[j].kind == TokenKind::LBrace {
        let lb = j
        let rb = find_matching_delim(tokens, lb)
        let for_lidx = tokens[i].line - 1
        let lb_lidx = tokens[lb].line - 1
        let rb_lidx = if rb > lb { tokens[rb].line - 1 } else { -1 }
        let has_leading_label = i > 0 && tokens[i - 1].kind == TokenKind::Colon
        let has_trailing_else = rb > lb && rb + 1 < n && tokens[rb + 1].raw == "else"
        if rb > lb && for_lidx == lb_lidx && for_lidx >= 0 && rb_lidx < lines.length() &&
        !has_leading_label && !has_trailing_else &&
        !mutated_lines.contains(for_lidx) && !mutated_lines.contains(rb_lidx) {
          let is_s = in_i + 1
          let is_e = lb
          // Recognize Form 1: `mbt_compat::__mbt_slice_borrow(recv, lo, hi)`
          // or Form 2: `({ let <tmp> = <recv_init>; mbt_compat::__mbt_slice_borrow(<tmp>, lo, hi) })`
          let mut matched_form = 0
          let mut tmp_name = ""
          let mut recv_s = -1
          let mut recv_e = -1
          let mut lo_s = -1
          let mut lo_e = -1
          let mut hi_s = -1
          let mut hi_e = -1
          if is_s + 4 < is_e && tokens[is_s].raw == "mbt_compat" &&
          tokens[is_s + 1].kind == TokenKind::ColonColon &&
          tokens[is_s + 2].raw == "__mbt_slice_borrow" &&
          tokens[is_s + 3].kind == TokenKind::LParen &&
          find_matching_delim(tokens, is_s + 3) == is_e - 1 {
            let sargs = ms_split_call_args(tokens, is_s + 3, is_e - 1)
            if sargs.length() == 3 {
              matched_form = 1
              recv_s = sargs[0].0
              recv_e = sargs[0].1
              lo_s = sargs[1].0
              lo_e = sargs[1].1
              hi_s = sargs[2].0
              hi_e = sargs[2].1
            }
          } else if is_s + 10 < is_e && tokens[is_s].kind == TokenKind::LParen &&
          find_matching_delim(tokens, is_s) == is_e - 1 &&
          tokens[is_s + 1].kind == TokenKind::LBrace &&
          find_matching_delim(tokens, is_s + 1) == is_e - 2 &&
          tokens[is_s + 2].raw == "let" &&
          tokens[is_s + 3].kind == TokenKind::Ident &&
          tokens[is_s + 4].kind == TokenKind::Eq {
            let mut semi_i = -1
            let mut sd = 0
            let mut sk = is_s + 5
            while sk < is_e - 2 {
              let skk = tokens[sk].kind
              if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace { sd = sd + 1 }
              else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace { if sd > 0 { sd = sd - 1 } }
              else if sd == 0 && skk == TokenKind::Semi { semi_i = sk; break }
              sk = sk + 1
            }
            if semi_i > is_s + 5 && semi_i + 5 < is_e - 2 &&
            tokens[semi_i + 1].raw == "mbt_compat" &&
            tokens[semi_i + 2].kind == TokenKind::ColonColon &&
            tokens[semi_i + 3].raw == "__mbt_slice_borrow" &&
            tokens[semi_i + 4].kind == TokenKind::LParen &&
            find_matching_delim(tokens, semi_i + 4) == is_e - 3 {
              let sargs = ms_split_call_args(tokens, semi_i + 4, is_e - 3)
              if sargs.length() == 3 {
                matched_form = 2
                tmp_name = tokens[is_s + 3].raw
                recv_s = is_s + 5
                recv_e = semi_i
                lo_s = sargs[1].0
                lo_e = sargs[1].1
                hi_s = sargs[2].0
                hi_e = sargs[2].1
              }
            }
          }
          if matched_form > 0 && recv_s >= 0 && recv_e > recv_s {
            let fn_body_open = outermost_body_open(tokens, i)
            let active_gen = enclosing_fn_generic_params(tokens, fn_body_open)
            // Resolve receiver type (must be proven `Array[...]`, never `String`/`Bytes`/`FixedArray`/`ArrayView`/unknown)
            let mut recv_ty = match qfi_opt {
              Some(qfi) =>
              match qt_lookup_expr_span_ty(qfi, content, tokens[recv_s].start_byte, tokens[recv_e - 1].end_byte, true) {
                Some(t) => t
                None => ""
              }
              None => ""
            }
            if recv_ty.length() == 0 {
              // Fallback: infer from local parameter / `let` / struct field / function return types
              let vt_in : Map[String, String] = Map()
              if fn_body_open >= 0 {
                let fstart = fn_start_of(tokens, fn_body_open)
                if fstart >= 0 {
                  let mut p = fstart + 1
                  while p < fn_body_open && tokens[p].kind != TokenKind::LParen { p = p + 1 }
                  if p < fn_body_open && tokens[p].kind == TokenKind::LParen {
                    let rp = find_matching_delim(tokens, p)
                    if rp < fn_body_open {
                      ms_parse_fn_params(tokens, p, rp, vt_in)
                    }
                  }
                }
                let fbc = find_matching_delim(tokens, fn_body_open)
                ms_collect_local_var_types(mut_summary, tokens, fn_body_open + 1, fbc, content, qfi_opt, vt_in, Map(), Map(), enclosing_fn_generic_params(tokens, fn_body_open))
              }
              recv_ty = ms_infer_expr_ty(mut_summary, tokens, recv_e - 1, content, qfi_opt, vt_in)
            }
            let rt_clean = ms_strip_pkg_prefix(recv_ty)
            if rt_clean.starts_with("Array[") && rt_clean.ends_with("]") {
              let elem_ty = ms_extract_array_elem_ty(rt_clean)
              let vars_str = content.slice(tokens[i + 1].start_byte, tokens[in_i - 1].end_byte).trim()
              let comma_idx = vars_str.index_of(",")
              let mut vars_ok = false
              let loop_vt : Map[String, String] = Map()
              if comma_idx >= 0 {
                let iv_nm = vars_str.slice(0, comma_idx).trim()
                let ev_nm = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                if stage_b_is_simple_ident(iv_nm) && stage_b_is_simple_ident(ev_nm) {
                  vars_ok = true
                  loop_vt[iv_nm] = "Int"
                  if elem_ty.length() > 0 { loop_vt[ev_nm] = elem_ty }
                }
              } else if stage_b_is_simple_ident(vars_str) {
                vars_ok = true
                if elem_ty.length() > 0 { loop_vt[vars_str] = elem_ty }
              }
              let body_sum = if vars_ok {
                summarize_expr_span(mut_summary, tokens, lb + 1, rb, fn_body_open, content, qfi_opt, loop_vt, active_gen)
              } else {
                FnMutationSummary::empty()
              }
              let elem_check = if ms_ty_contains_generic(elem_ty, active_gen) { "" } else { elem_ty }
              if vars_ok && !summary_may_mutate_array(body_sum, elem_check) {
                let recv_str = content.slice(tokens[recv_s].start_byte, tokens[recv_e - 1].end_byte).trim()
                let lo_str = content.slice(tokens[lo_s].start_byte, tokens[lo_e - 1].end_byte).trim()
                let hi_str = content.slice(tokens[hi_s].start_byte, tokens[hi_e - 1].end_byte).trim()
                let tag = for_lidx.to_string()
                let rv_var = if matched_form == 2 { tmp_name } else { fresh_stage_b_ident(used_idents, "__mbt_slr_" + tag) }
                let lo_var = fresh_stage_b_ident(used_idents, "__mbt_slo_" + tag)
                let hi_var = fresh_stage_b_ident(used_idents, "__mbt_shi_" + tag)
                let len_var = fresh_stage_b_ident(used_idents, "__mbt_sln_" + tag)
                let loc_var = fresh_stage_b_ident(used_idents, "__mbt_slc_" + tag)
                let hic0_var = fresh_stage_b_ident(used_idents, "__mbt_sh0_" + tag)
                let hic_var = fresh_stage_b_ident(used_idents, "__mbt_shc_" + tag)
                let idx_var = fresh_stage_b_ident(used_idents, "__mbt_sli_" + tag)
                let bind_stmts = if comma_idx >= 0 {
                  let idx_v = vars_str.slice(0, comma_idx).trim()
                  let el_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                  "let " + idx_v + " = " + idx_var + " - " + loc_var + "; let " + el_v + " = " + rv_var + "[" + idx_var + "]"
                } else {
                  "let " + vars_str + " = " + rv_var + "[" + idx_var + "]"
                }
                let for_col0 = tokens[i].col - 1
                let lb_col0 = tokens[lb].col - 1
                let rb_col0 = tokens[rb].col - 1
                let cur_ln = lines[for_lidx]
                if for_col0 >= 0 && lb_col0 > for_col0 && lb_col0 < cur_ln.length() {
                  let prefix = cur_ln.slice(0, for_col0)
                  let open_hdr = prefix + "{ let " + rv_var + " = " + recv_str +
                  "; let " + lo_var + " = " + lo_str +
                  "; let " + hi_var + " = " + hi_str +
                  "; let " + len_var + " = " + rv_var + ".length()" +
                  "; let " + loc_var + " = if " + lo_var + " < 0 { 0 } else if " + lo_var + " > " + len_var + " { " + len_var + " } else { " + lo_var + " }" +
                  "; let " + hic0_var + " = if " + hi_var + " < 0 { 0 } else if " + hi_var + " > " + len_var + " { " + len_var + " } else { " + hi_var + " }" +
                  "; let " + hic_var + " = if " + hic0_var + " > " + loc_var + " { " + hic0_var + " } else { " + loc_var + " }" +
                  "; let mut " + idx_var + " = " + loc_var +
                  "; while " + idx_var + " < " + hic_var + " { " + bind_stmts + "; " + idx_var + " = " + idx_var + " + 1; "
                  if rb_lidx == for_lidx {
                    let body_part = cur_ln.slice(lb_col0 + 1, rb_col0)
                    let after_part = cur_ln.slice(rb_col0 + 1, cur_ln.length())
                    lines[for_lidx] = open_hdr + body_part + " } }" + after_part
                  } else {
                    let first_rest = cur_ln.slice(lb_col0 + 1, cur_ln.length())
                    lines[for_lidx] = open_hdr + first_rest
                    let cln = lines[rb_lidx]
                    lines[rb_lidx] = cln.slice(0, rb_col0) + " } }" + cln.slice(rb_col0 + 1, cln.length())
                  }
                  mutated_lines[for_lidx] = true
                  mutated_lines[rb_lidx] = true
                  any_changed = true
                  stage_b_record_mutation_allow(
                    drift_ledger,
                    "mutation_summary_allow_d",
                    f_rel,
                    tokens[i].line,
                    tokens[i].col,
                    recv_str + "[" + lo_str + ":" + hi_str + "]",
                    "clamped_index_while_loop",
                    "mutation_summary proved borrowed slice loop body cannot mutate Array[" + elem_ty + "]",
                  )
                  i = rb + 1
                  continue
                }
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  any_changed
}
