                  let v_var = fresh_stage_b_ident(used_idents, "__mbt_av_" + tag)
                  let i_var = fresh_stage_b_ident(used_idents, "__mbt_ai_" + tag)
                  let bind_stmts = if comma_idx >= 0 {
