                    let el_v = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    "let " + idx_v + " = " + i_var + "; let " + el_v + " = " + v_var + ".get(" + i_var + ")"
                  } else {
                    "let " + vars_str + " = " + v_var + ".get(" + i_var + ")"
