                  let open_hdr = prefix + "{ let " + v_var + " = " + iter_expr + "; let mut " + i_var + " = 0; while " + i_var + " < " + v_var + ".length() { " + bind_stmts + "; " + i_var + " = " + i_var + " + 1; "
                  if close_l == lidx {
