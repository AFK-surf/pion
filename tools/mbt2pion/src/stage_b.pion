///| Stage B: Type-Directed Fixpoint Pass (`pionc check --json` + Span Map).
///|
///| Applies deterministic, table-driven rewrites keyed by `(diagnostic_code, receiver_type, method_or_op)`
///| aligned 1:1 with `tools/mbt_compat` canonical symbol names:
///| 1. Missing builtin methods -> `mbt_compat::arr_*` / `opt_*` / `str_*` / `ordered_map_*`
///| 2. Token-precise numeric literal coercions using `d.col` + lexer tokens (never appends to EOL!)
///| 3. `for k, v in map` -> `.to_array()`, `for c in s` / `for i, c in s` -> `mbt_compat::str_scalars(s)`
///| 4. `api_map.json` 2-argument unit-annotated boundary conversions (`mbt_compat::utf16_to_utf8_off(s, off)`,
///|    `mbt_compat::utf16_to_scalar_off(s, off)`, hard-failing if `str_param` is missing!) &
///|    `OrderedMap` <-> `Map` boundary conversions (`ordered_map_to_map` / `ordered_map_from_map`).

///| Map `Array[T]::sort()` receiver types unsupported by builtin `Array::sort` to `mbt_compat::arr_sort_*`.
fn lookup_array_sort_helper(receiver_ty : String) -> Option[String] {
  if receiver_ty == "Array[Double]" { return Some("mbt_compat::arr_sort_double") }
  if receiver_ty == "Array[Float]" { return Some("mbt_compat::arr_sort_float") }
  if receiver_ty == "Array[UInt]" { return Some("mbt_compat::arr_sort_uint") }
  if receiver_ty == "Array[UInt64]" { return Some("mbt_compat::arr_sort_uint64") }
  if receiver_ty == "Array[Byte]" { return Some("mbt_compat::arr_sort_byte") }
  if receiver_ty == "Array[Char]" { return Some("mbt_compat::arr_sort_char") }
  None
}

///| Map `(receiver_type_prefix, method_name)` to canonical `mbt_compat::*` helper names.
pub fn lookup_missing_method_helper(receiver_ty : String, method_name : String) -> Option[String] {
  if receiver_ty.starts_with("Array[") {
    if method_name == "map" { return Some("mbt_compat::arr_map") }
    if method_name == "filter" { return Some("mbt_compat::arr_filter") }
    if method_name == "retain" { return Some("mbt_compat::arr_retain") }
    if method_name == "filter_map" { return Some("mbt_compat::arr_filter_map") }
    if method_name == "each" { return Some("mbt_compat::arr_each") }
    if method_name == "eachi" { return Some("mbt_compat::arr_eachi") }
    if method_name == "fold" { return Some("mbt_compat::arr_fold") }
    if method_name == "mapi" { return Some("mbt_compat::arr_mapi") }
    if method_name == "last" { return Some("mbt_compat::arr_last") }
    if method_name == "insert" { return Some("mbt_compat::arr_insert") }
    if method_name == "remove" { return Some("mbt_compat::arr_remove") }
    if method_name == "sort_by" { return Some("mbt_compat::arr_sort_by") }
    if method_name == "sort_by_key" { return Some("mbt_compat::arr_sort_by_key") }
    if method_name == "shrink_to_fit" { return Some("mbt_compat::arr_shrink_to_fit") }
    if method_name == "append" { return Some("mbt_compat::arr_append") }
    if method_name == "to_array" { return Some("mbt_compat::arr_to_array") }
    if method_name == "search" { return Some("mbt_compat::arr_search") }
    if method_name == "contains" { return Some("mbt_compat::arr_contains") }
    if method_name == "is_empty" { return Some("mbt_compat::arr_is_empty") }
    if method_name == "truncate" { return Some("mbt_compat::arr_truncate") }
    if method_name == "blit_to" { return Some("mbt_compat::fixed_array_blit_to") }
    if method_name == "unsafe_get" { return Some("mbt_compat::arr_unsafe_get") }
    if method_name == "unsafe_set" { return Some("mbt_compat::arr_unsafe_set") }
    if method_name == "rev_in_place" { return Some("mbt_compat::arr_rev_in_place") }
    if method_name == "copy" { return Some("mbt_compat::arr_copy") }
    if method_name == "any" { return Some("mbt_compat::arr_any") }
    if method_name == "all" { return Some("mbt_compat::arr_all") }
    if method_name == "collect" { return Some("mbt_compat::arr_to_array") }
    if method_name == "get" { return Some("mbt_compat::arr_get") }
    if method_name == "release_unused" { return Some("mbt_compat::arr_release_unused") }
    if method_name == "iter" { return Some("mbt_compat::arr_iter") }
    if method_name == "iter2" { return Some("mbt_compat::arr_iter2") }
    if method_name == "rev_iter" { return Some("mbt_compat::arr_rev_iter") }
    if method_name == "flatten" { return Some("mbt_compat::arr_flatten") }
    if method_name == "search_by" { return Some("mbt_compat::arr_search_by") }
    if method_name == "push_iter" { return Some("mbt_compat::arr_push_iter") }
    if method_name == "rev" { return Some("mbt_compat::arr_rev") }
    if method_name == "drain" { return Some("mbt_compat::arr_drain") }
    if method_name == "resize" { return Some("mbt_compat::arr_resize") }
    if method_name == "unsafe_blit_fixed" { return Some("mbt_compat::arr_unsafe_blit_fixed") }
    if method_name == "unsafe_pop" { return Some("mbt_compat::arr_unsafe_pop") }
    if method_name == "rev_each" { return Some("mbt_compat::arr_rev_each") }
    if method_name == "find_first" { return Some("mbt_compat::arr_find_first") }
    if method_name == "exact_view" { return Some("mbt_compat::arr_exact_view") }
    if method_name == "to_owned" { return Some("mbt_compat::arr_copy") }
  }
  if receiver_ty.starts_with("FixedArray[") {
    if method_name == "unsafe_get" { return Some("mbt_compat::fixed_array_unsafe_get") }
    if method_name == "unsafe_set" { return Some("mbt_compat::fixed_array_unsafe_set") }
    if method_name == "copy" { return Some("mbt_compat::fixed_array_copy") }
    if method_name == "blit_to" { return Some("mbt_compat::fixed_array_blit_to_fa") }
    if method_name == "sort_by" { return Some("mbt_compat::fixed_array_sort_by") }
    if method_name == "sort" && receiver_ty == "FixedArray[Int64]" { return Some("mbt_compat::fixed_array_sort_i64") }
    if method_name == "sort" && receiver_ty == "FixedArray[Int]" { return Some("mbt_compat::fixed_array_sort_int") }
    if method_name == "sort" && receiver_ty == "FixedArray[Double]" { return Some("mbt_compat::fixed_array_sort_double") }
    if method_name == "sort" && receiver_ty == "FixedArray[Float]" { return Some("mbt_compat::fixed_array_sort_float") }
    if method_name == "sort" && receiver_ty == "FixedArray[UInt]" { return Some("mbt_compat::fixed_array_sort_uint") }
    if method_name == "sort" && receiver_ty == "FixedArray[UInt64]" { return Some("mbt_compat::fixed_array_sort_uint64") }
    if method_name == "sort" && receiver_ty == "FixedArray[Byte]" { return Some("mbt_compat::fixed_array_sort_byte") }
    if method_name == "sort" && receiver_ty == "FixedArray[Char]" { return Some("mbt_compat::fixed_array_sort_char") }
    if method_name == "iter" { return Some("mbt_compat::fixed_array_iter") }
    if method_name == "map" { return Some("mbt_compat::fixed_array_map") }
    if method_name == "fold" { return Some("mbt_compat::fixed_array_fold") }
    if method_name == "join" && receiver_ty == "FixedArray[String]" { return Some("mbt_compat::fixed_array_join") }
  }
  if receiver_ty.starts_with("ArrayView[") || receiver_ty.starts_with("mbt_compat::ArrayView[") {
    if method_name == "iter" { return Some("mbt_compat::array_view_iter") }
  }
  if receiver_ty == "Double" {
    if method_name == "is_nan" { return Some("mbt_compat::double_is_nan") }
    if method_name == "is_inf" { return Some("mbt_compat::double_is_inf") }
    if method_name == "compare" { return Some("mbt_compat::double_compare") }
    if method_name == "min" { return Some("mbt_compat::double_min") }
    if method_name == "max" { return Some("mbt_compat::double_max") }
    if method_name == "clamp" { return Some("mbt_compat::double_clamp") }
    if method_name == "reinterpret_as_int64" { return Some("mbt_compat::double_reinterpret_as_int64") }
  }
  if receiver_ty == "Float" {
    if method_name == "is_nan" { return Some("mbt_compat::float_is_nan") }
    if method_name == "compare" { return Some("mbt_compat::float_compare") }
  }
  if receiver_ty.starts_with("Option[") {
    if method_name == "map" { return Some("mbt_compat::opt_map") }
    if method_name == "map_or" { return Some("mbt_compat::opt_map_or") }
    if method_name == "bind" { return Some("mbt_compat::opt_bind") }
    if method_name == "unwrap" { return Some("mbt_compat::opt_unwrap") }
    if method_name == "or" { return Some("mbt_compat::opt_or") }
    if method_name == "is_empty" { return Some("mbt_compat::opt_is_empty") }
    if method_name == "filter" { return Some("mbt_compat::opt_filter") }
    if method_name == "unwrap_or_else" { return Some("mbt_compat::opt_unwrap_or_else") }
  }
  if receiver_ty.starts_with("Result[") {
    if method_name == "map" { return Some("mbt_compat::result_map") }
  }
  if receiver_ty == "String" {
    if method_name == "has_prefix" { return Some("mbt_compat::str_has_prefix") }
    if method_name == "has_suffix" { return Some("mbt_compat::str_has_suffix") }
    if method_name == "to_lower" { return Some("mbt_compat::str_to_lower") }
    if method_name == "to_upper" { return Some("mbt_compat::str_to_upper") }
    if method_name == "compare" { return Some("mbt_compat::str_compare") }
    if method_name == "lexical_compare" { return Some("mbt_compat::str_lexical_compare") }
    if method_name == "rev_find" { return Some("mbt_compat::str_rev_find") }
    if method_name == "to_owned" { return Some("mbt_compat::str_to_owned") }
    if method_name == "iter" { return Some("mbt_compat::str_iter") }
    if method_name == "rev_iter" { return Some("mbt_compat::str_rev_iter") }
    if method_name == "is_empty" { return Some("mbt_compat::str_is_empty") }
    if method_name == "rev" { return Some("mbt_compat::str_rev") }
    if method_name == "repeat" { return Some("mbt_compat::str_repeat") }
    if method_name == "contains_code_unit" { return Some("mbt_compat::str_contains_code_unit") }
    if method_name == "to_array" { return Some("mbt_compat::str_scalars") }
    if method_name == "at" || method_name == "unsafe_get" { return Some("mbt_compat::utf16_code_unit_at") }
    if method_name == "exact_view" { return Some("mbt_compat::str_exact_view") }
    if method_name == "clamped_view" { return Some("mbt_compat::str_clamped_view") }
    if method_name == "view" { return Some("mbt_compat::str_view") }
    if method_name == "find" { return Some("mbt_compat::str_find") }
    if method_name == "contains_char" { return Some("mbt_compat::str_contains_char") }
    if method_name == "get_char" { return Some("mbt_compat::str_get_char") }
    if method_name == "trim_end" { return Some("mbt_compat::str_trim_end") }
    if method_name == "trim_start" { return Some("mbt_compat::str_trim_start") }
    if method_name == "strip_prefix" { return Some("mbt_compat::str_strip_prefix") }
    if method_name == "trim" || method_name == "__mbt_str_trim" { return Some("mbt_compat::str_trim") }
    if method_name == "unsafe_substring" { return Some("mbt_compat::str_unsafe_substring") }
    if method_name == "escape" { return Some("mbt_compat::str_escape") }
    if method_name == "replace" || method_name == "__mbt_str_replace" { return Some("mbt_compat::str_replace") }
  }
  if receiver_ty == "Char" {
    if method_name == "is_ascii_digit" { return Some("mbt_compat::char_is_ascii_digit") }
    if method_name == "is_ascii_alphabetic" { return Some("mbt_compat::char_is_ascii_alphabetic") }
    if method_name == "to_ascii_lowercase" { return Some("mbt_compat::char_to_ascii_lowercase") }
    if method_name == "compare" { return Some("mbt_compat::char_compare") }
  }
  if receiver_ty == "Byte" {
    if method_name == "to_uint" { return Some("mbt_compat::byte_to_uint") }
    if method_name == "to_int64" { return Some("mbt_compat::byte_to_int64") }
  }
  if receiver_ty == "Double" {
    if method_name == "to_uint" { return Some("mbt_compat::double_to_uint") }
  }
  if receiver_ty == "Int" {
    if method_name == "unsafe_to_char" { return Some("mbt_compat::int_unsafe_to_char") }
    if method_name == "lnot" { return Some("mbt_compat::int_lnot") }
    if method_name == "popcnt" { return Some("mbt_compat::int_popcnt") }
    if method_name == "ctz" { return Some("mbt_compat::int_ctz") }
    if method_name == "clz" { return Some("mbt_compat::int_clz") }
    if method_name == "to_uint64" { return Some("mbt_compat::int_to_uint64") }
    if method_name == "compare" { return Some("mbt_compat::int_compare") }
    if method_name == "min" { return Some("mbt_compat::int_min") }
    if method_name == "max" { return Some("mbt_compat::int_max") }
    if method_name == "clamp" { return Some("mbt_compat::int_clamp") }
    if method_name == "until" { return Some("mbt_compat::int_until") }
  }
  if receiver_ty == "UInt" {
    if method_name == "compare" { return Some("mbt_compat::uint_compare") }
  }
  if receiver_ty == "Bool" {
    if method_name == "compare" { return Some("mbt_compat::bool_compare") }
  }
  if receiver_ty == "Bytes" {
    if method_name == "to_array" || method_name == "to_fixedarray" { return Some("mbt_compat::bytes_to_array") }
    if method_name == "clamped_view" || method_name == "view" { return Some("mbt_compat::bytes_clamped_view") }
  }
  if receiver_ty == "Int64" {
    if method_name == "to_byte" { return Some("mbt_compat::int64_to_byte") }
    if method_name == "compare" { return Some("mbt_compat::i64_compare") }
    if method_name == "min" { return Some("mbt_compat::int64_min") }
    if method_name == "max" { return Some("mbt_compat::int64_max") }
    if method_name == "clamp" { return Some("mbt_compat::int64_clamp") }
    if method_name == "reinterpret_as_double" { return Some("mbt_compat::int64_reinterpret_as_double") }
  }
  if receiver_ty == "UInt64" {
    if method_name == "lnot" { return Some("mbt_compat::uint64_lnot") }
  }
  if receiver_ty.starts_with("OrderedMap[") || receiver_ty.starts_with("mbt_compat::OrderedMap[") {
    if method_name == "size" || method_name == "length" { return Some("mbt_compat::ordered_map_size") }
    if method_name == "each" { return Some("mbt_compat::ordered_map_each") }
    if method_name == "iter" { return Some("mbt_compat::ordered_map_iter_lazy") }
    if method_name == "iter2" { return Some("mbt_compat::ordered_map_iter2") }
    if method_name == "map" { return Some("mbt_compat::ordered_map_map") }
  }
  if receiver_ty.starts_with("OrderedSet[") || receiver_ty.starts_with("mbt_compat::OrderedSet[") {
    if method_name == "iter" { return Some("mbt_compat::ordered_set_iter") }
  }
  if receiver_ty == "StringBuilder" {
    if method_name == "is_empty" { return Some("mbt_compat::sb_is_empty") }
  }
  None
}

///| `cannot access field `N` on `T`` with `T` a scalar / `String` / `Unit` / `<error>`: never a tuple struct.
fn field_access_on_scalar_or_error(msg : String) -> Bool {
  let p = "cannot access field `"
  let i = msg.index_of(p)
  if i < 0 {
    return false
  }
  let rest = msg.slice(i + p.length(), msg.length())
  let on = rest.index_of("` on `")
  if on < 0 {
    return false
  }
  let t0 = rest.slice(on + 6, rest.length())
  let te = t0.index_of("`")
  if te < 0 {
    return false
  }
  let t = t0.slice(0, te)
  t == "<error>" || t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Double" || t == "Float" ||
  t == "Bool" || t == "Byte" || t == "Char" || t == "String" || t == "Unit" || t == "Int16" || t == "Int8"
}

///| Arity of the tuple type `(T1, ..., Tn)` written at the start of `ty` (depth-0 commas + 1), or 0.
fn tuple_type_arity(ty : String) -> Int {
  if !ty.starts_with("(") || !ty.ends_with(")") {
    return 0
  }
  let mut d = 0
  let mut n = 1
  let mut i = 0
  while i < ty.length() {
    let ch = ty.code_unit_at(i)
    if ch == 40 || ch == 91 {
      d = d + 1
      if d == 1 && i != 0 && ch == 40 {
        ()
      }
    } else if ch == 41 || ch == 93 {
      d = d - 1
      if d == 0 && i != ty.length() - 1 {
        return 0
      }
    } else if ch == 44 && d == 1 {
      n = n + 1
    }
    i = i + 1
  }
  if n >= 2 { n } else { 0 }
}

///| `type `(A, B)` does not implement trait `mbt_compat::MapKey` required by `F`` with `F` one of the
///| `MapKey`-bound constructors: rewrite the `mbt_compat::F(` call nearest to `col` to `F_pair(` / `F_triple(`.
fn rewrite_tuple_mapkey_call_at(ln : String, col : Int, msg : String) -> Option[String] {
  let tp = "type `"
  let ti = msg.index_of(tp)
  if ti < 0 {
    return None
  }
  let rest = msg.slice(ti + tp.length(), msg.length())
  let te = rest.index_of("` does not implement")
  if te < 0 {
    return None
  }
  let arity = tuple_type_arity(rest.slice(0, te))
  let suffix = if arity == 2 { "_pair" } else if arity == 3 { "_triple" } else { "" }
  if suffix.length() == 0 {
    return None
  }
  let rp = "required by `"
  let ri = msg.index_of(rp)
  if ri < 0 {
    return None
  }
  let r2 = msg.slice(ri + rp.length(), msg.length())
  let re = r2.index_of("`")
  if re < 0 {
    return None
  }
  let is_map_key = str_has(msg, "does not implement trait `mbt_compat::MapKey` required by `")
  let is_mbt_hash = str_has(msg, "does not implement trait `mbt_compat::MbtHash` required by `")
  if !is_map_key && !is_mbt_hash {
    return None
  }
  let f = r2.slice(0, re)
  let ok_fn = if is_mbt_hash {
    f == "mbt_hash"
  } else {
    f == "ordered_map_new" || f == "ordered_map_from_array" || f == "ordered_map_new_cap" ||
    f == "ordered_map_from_array_cap" || f == "ordered_map_from_iter" ||
    f == "ordered_set_new" || f == "ordered_set_from_array" ||
    f == "ordered_set_from_iter"
  }
  if !ok_fn {
    return None
  }
  let needle = "mbt_compat::" + f + "("
  let target_0 = if col > 0 { col - 1 } else { 0 }
  let mut best = -1
  let mut best_dist = 1000000
  let mut pos = 0
  while pos + needle.length() <= ln.length() {
    if ln.slice(pos, pos + needle.length()) == needle {
      let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
      if dist < best_dist {
        best_dist = dist
        best = pos
      }
    }
    pos = pos + 1
  }
  if best < 0 {
    return None
  }
  let name_end = best + needle.length() - 1
  Some(ln.slice(0, name_end) + suffix + ln.slice(name_end, ln.length()))
}

///| Extract `(method_name, receiver_type)` from `unknown method `<m>` on type `<T>``.
fn parse_unknown_method_msg(msg : String) -> Option[(String, String)] {
  let p = "unknown method `"
  let idx = msg.index_of(p)
  if idx < 0 {
    return None
  }
  let rest = msg.slice(idx + p.length(), msg.length())
  let t1 = rest.index_of("`")
  if t1 < 0 {
    return None
  }
  let mname = rest.slice(0, t1)
  let on_ty = " on type `"
  let idx2 = rest.index_of(on_ty)
  if idx2 < 0 {
    return None
  }
  let rest2 = rest.slice(idx2 + on_ty.length(), rest.length())
  let t2 = rest2.index_of("`")
  if t2 < 0 {
    return None
  }
  Some((mname, rest2.slice(0, t2)))
}

///| Find the `.method_name` (followed by optional spaces/tabs and `(`) offset on `line_text`
///| closest to 1-based column `col` (P1-5).
fn find_method_dot_at_col(line_text : String, method_name : String, col : Int) -> Int {
  let prefix = "." + method_name
  let n = line_text.length()
  let m = prefix.length()
  let target_0 = if col > 0 { col - 1 } else { 0 }
  let mut best = -1
  let mut best_dist = 1000000
  let mut pos = 0
  while pos + m < n {
    if line_text.slice(pos, pos + m) == prefix {
      let mut k = pos + m
      while k < n && (line_text.code_unit_at(k) == 32 || line_text.code_unit_at(k) == 9) {
        k = k + 1
      }
      if k < n && line_text.code_unit_at(k) == 40 {
        let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
        if dist < best_dist {
          best_dist = dist
          best = pos
        }
      }
    }
    pos = pos + 1
  }
  best
}

///| Index of the `"` closing the string literal opened at `q` on `s`, skipping escapes and `\{...}`
///| interpolations (whose code may hold quotes, parens and commas); `-1` if it does not close on `s`.
fn skip_string_lit(s : String, q : Int) -> Int {
  let mut i = q + 1
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 92 {
      if i + 1 < s.length() && s.code_unit_at(i + 1) == 123 {
        let k = skip_string_interp(s, i + 1)
        if k < 0 {
          return -1
        }
        i = k + 1
      } else {
        i = i + 2
      }
    } else if c == 34 {
      return i
    } else {
      i = i + 1
    }
  }
  -1
}

///| Index of the `}` closing the interpolation whose `{` is at `b` on `s`; `-1` if it does not close on `s`.
fn skip_string_interp(s : String, b : Int) -> Int {
  let mut depth = 1
  let mut i = b + 1
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 34 {
      let k = skip_string_lit(s, i)
      if k < 0 {
        return -1
      }
      i = k
    } else if c == 39 {
      let mut k = i + 1
      if k < s.length() && s.code_unit_at(k) == 92 {
        k = k + 2
      } else {
        k = k + 1
      }
      while k < s.length() && s.code_unit_at(k) != 39 {
        k = k + 1
      }
      if k >= s.length() {
        return -1
      }
      i = k
    } else if c == 123 {
      depth = depth + 1
    } else if c == 125 {
      depth = depth - 1
      if depth == 0 {
        return i
      }
    }
    i = i + 1
  }
  -1
}

///| True iff a single argument starts with top-level named label `<label>=` (ignoring spaces before `=`,
///| never matching `==` or string literals like `"old="`).
fn arg_has_top_level_label(arg : String, label : String) -> Bool {
  let tr = arg.trim()
  if !tr.starts_with(label) {
    return false
  }
  let mut k = label.length()
  while k < tr.length() && (tr.code_unit_at(k) == 32 || tr.code_unit_at(k) == 9) {
    k = k + 1
  }
  k < tr.length() && tr.code_unit_at(k) == 61 && !(k + 1 < tr.length() && tr.code_unit_at(k + 1) == 61)
}

///| Rewrite a placeholder method name `.<placeholder>` closest to `col` back to `.<real_name>`
///| without assuming `(` immediately follows (preserves trivia such as `foo.trim (x)`).
fn restore_placeholder_method_at(ln : String, col : Int, placeholder : String, real_name : String) -> Option[String] {
  let needle = "." + placeholder
  let target_0 = if col > 0 { col - 1 } else { 0 }
  let mut best = -1
  let mut best_dist = 1000000
  let mut pos = 0
  while pos + needle.length() <= ln.length() {
    if ln.slice(pos, pos + needle.length()) == needle {
      let after = pos + needle.length()
      let boundary_ok = after >= ln.length() || !(is_alnum(ln.code_unit_at(after)) || ln.code_unit_at(after) == 95)
      if boundary_ok {
        let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
        if dist < best_dist {
          best_dist = dist
          best = pos
        }
      }
    }
    pos = pos + 1
  }
  if best < 0 {
    return None
  }
  Some(ln.slice(0, best) + "." + real_name + ln.slice(best + needle.length(), ln.length()))
}

///| Strip a leading `init=` (or `init =`) label from `s` when present.
fn strip_leading_init_label(s : String) -> String {
  let tr = s.trim()
  if !tr.starts_with("init") {
    return s
  }
  let idx_init = s.index_of("init")
  let mut k = idx_init + 4
  while k < s.length() && (s.code_unit_at(k) == 32 || s.code_unit_at(k) == 9) {
    k = k + 1
  }
  if k < s.length() && s.code_unit_at(k) == 61 && !(k + 1 < s.length() && s.code_unit_at(k + 1) == 61) {
    s.slice(0, idx_init) + s.slice(k + 1, s.length())
  } else {
    s
  }
}

///| Find the matching opening delimiter token index (`(`, `[`, `{`) for a closing delimiter at `close_idx`.
fn find_matching_open_delim(tokens : Array[Token], close_idx : Int) -> Int {
  let mut depth = 0
  let mut i = close_idx
  while i >= 0 {
    match tokens[i].kind {
      TokenKind::RParen | TokenKind::RBracket | TokenKind::RBrace => depth = depth + 1
      TokenKind::LParen | TokenKind::LBracket | TokenKind::LBrace => {
        depth = depth - 1
        if depth == 0 {
          return i
        }
      }
      _ => ()
    }
    i = i - 1
  }
  -1
}

///| True iff token `t` can precede `(` or `[` as a callee or indexable expression (excludes control keywords).
fn is_receiver_prefix_before_delim(t : Token) -> Bool {
  match t.kind {
    TokenKind::Ident | TokenKind::UpperIdent | TokenKind::RParen | TokenKind::RBracket |
    TokenKind::StringLit | TokenKind::InterpString | TokenKind::PkgRef => true
    TokenKind::Keyword => t.raw == "self"
    _ => false
  }
}

///| Walk backwards across `lex_moonbit` tokens from `dot_ti - 1` to find the receiver's first token index.
///| Because `lex_moonbit` already strips comments/whitespace into trivia and tokenizes string/interpolation/char
///| literals atomically, line-end comments (`xs // comment\n.fold(...)`), `'('`, and `"\{")"}"` are handled cleanly.
fn find_receiver_start_token(tokens : Array[Token], dot_ti : Int) -> Int {
  if dot_ti <= 0 {
    return -1
  }
  let mut cur = dot_ti - 1
  let mut start_ti = -1
  while cur >= 0 {
    match tokens[cur].kind {
      TokenKind::RParen => {
        let open_ti = find_matching_open_delim(tokens, cur)
        if open_ti < 0 || tokens[open_ti].kind != TokenKind::LParen {
          return -1
        }
        start_ti = open_ti
        if open_ti > 0 && !tokens[open_ti].newline_before && is_receiver_prefix_before_delim(tokens[open_ti - 1]) {
          cur = open_ti - 1
          continue
        }
        break
      }
      TokenKind::RBracket => {
        let open_ti = find_matching_open_delim(tokens, cur)
        if open_ti < 0 || tokens[open_ti].kind != TokenKind::LBracket {
          return -1
        }
        start_ti = open_ti
        if open_ti > 0 && !tokens[open_ti].newline_before && is_receiver_prefix_before_delim(tokens[open_ti - 1]) {
          cur = open_ti - 1
          continue
        }
        break
      }
      TokenKind::RBrace => {
        let open_ti = find_matching_open_delim(tokens, cur)
        if open_ti < 0 || tokens[open_ti].kind != TokenKind::LBrace {
          return -1
        }
        start_ti = open_ti
        if open_ti > 1 && tokens[open_ti - 1].kind == TokenKind::ColonColon {
          cur = open_ti - 2
          continue
        }
        break
      }
      TokenKind::Ident | TokenKind::UpperIdent | TokenKind::PkgRef |
      TokenKind::IntLit | TokenKind::FloatLit | TokenKind::StringLit | TokenKind::InterpString |
      TokenKind::RawMultiline | TokenKind::InterpMultiline | TokenKind::ByteStringLit |
      TokenKind::CharLit | TokenKind::ByteCharLit => {
        start_ti = cur
        if cur > 1 && (tokens[cur - 1].kind == TokenKind::Dot || tokens[cur - 1].kind == TokenKind::ColonColon) {
          cur = cur - 2
          continue
        }
        break
      }
      TokenKind::Keyword => {
        if tokens[cur].raw == "self" || tokens[cur].raw == "true" || tokens[cur].raw == "false" {
          start_ti = cur
          if cur > 1 && (tokens[cur - 1].kind == TokenKind::Dot || tokens[cur - 1].kind == TokenKind::ColonColon) {
            cur = cur - 2
            continue
          }
        }
        break
      }
      _ => break
    }
  }
  start_ti
}

///| Inspect a token-bounded argument `[s_ti ..= e_ti]`, returning `(label, value_code, full_code, is_shorthand)`.
///| Because `s_ti`..`e_ti` are exact token bounds, leading/trailing comments and whitespace are excluded.
fn inspect_token_arg(src : String, tokens : Array[Token], s_ti : Int, e_ti : Int) -> (String, String, String, Bool) {
  let full = src.slice(tokens[s_ti].start_byte, tokens[e_ti].end_byte)
  let first_is_name = match tokens[s_ti].kind {
    TokenKind::Ident | TokenKind::Keyword => true
    _ => false
  }
  if first_is_name && s_ti + 1 == e_ti && tokens[e_ti].kind == TokenKind::Tilde {
    let nm = tokens[s_ti].raw
    return (nm, nm, nm + "=" + nm, true)
  }
  if first_is_name && s_ti + 1 < e_ti && tokens[s_ti + 1].kind == TokenKind::Eq {
    let nm = tokens[s_ti].raw
    let aval = src.slice(tokens[s_ti + 2].start_byte, tokens[e_ti].end_byte)
    return (nm, aval, full, false)
  }
  ("", full, full, false)
}

///| Unified token-based argument normalizer for both single-line and multi-line helper rewrites.
fn normalize_helper_args_tokens(
  src : String,
  tokens : Array[Token],
  arg_spans : Array[(Int, Int)],
  helper : String,
) -> (String, String) {
  if arg_spans.length() == 0 {
    return (helper, "")
  }
  let is_fold_helper = helper == "mbt_compat::arr_fold" || helper == "mbt_compat::fixed_array_fold"
  if is_fold_helper {
    if arg_spans.length() == 2 {
      let (l0, v0, f0, _) = inspect_token_arg(src, tokens, arg_spans[0].0, arg_spans[0].1)
      let (l1, v1, f1, _) = inspect_token_arg(src, tokens, arg_spans[1].0, arg_spans[1].1)
      if l1 == "init" {
        return (helper, v1 + ", " + f0)
      }
      if l0 == "init" {
        return (helper, v0 + ", " + f1)
      }
      return (helper, f0 + ", " + f1)
    }
    let (l0, v0, f0, _) = inspect_token_arg(src, tokens, arg_spans[0].0, arg_spans[0].1)
    return (helper, if l0 == "init" { v0 } else { f0 })
  }
  if helper == "mbt_compat::str_replace" {
    let labels : Array[String] = []
    let rendered : Array[String] = []
    for sp in arg_spans {
      let (lb, aval, full, is_sh) = inspect_token_arg(src, tokens, sp.0, sp.1)
      labels.push(lb)
      rendered.push(if is_sh { lb + "=" + aval } else { full })
    }
    if rendered.length() == 2 &&
    labels[0] != "old" && labels[0] != "new" && labels[1] != "old" && labels[1] != "new" {
      return (helper, "old=" + rendered[0] + ", new=" + rendered[1])
    }
    return (helper, rendered.join(", "))
  }
  if helper == "mbt_compat::str_trim" || helper == "mbt_compat::str_trim_start" || helper == "mbt_compat::str_trim_end" {
    let labels : Array[String] = []
    let rendered : Array[String] = []
    for sp in arg_spans {
      let (lb, aval, full, is_sh) = inspect_token_arg(src, tokens, sp.0, sp.1)
      if lb == "char_set" {
        labels.push("chars")
        rendered.push("chars=" + aval)
      } else if is_sh {
        labels.push(lb)
        rendered.push(lb + "=" + aval)
      } else {
        labels.push(lb)
        rendered.push(full)
      }
    }
    if rendered.length() == 1 && labels[0] != "chars" {
      return (helper, "chars=" + rendered[0])
    }
    return (helper, rendered.join(", "))
  }
  if helper == "mbt_compat::arr_release_unused" {
    let rendered : Array[String] = []
    for sp in arg_spans {
      let (lb, aval, full, is_sh) = inspect_token_arg(src, tokens, sp.0, sp.1)
      if lb == "placeholder" {
        rendered.push(aval)
      } else if is_sh {
        rendered.push(lb + "=" + aval)
      } else {
        rendered.push(full)
      }
    }
    return ("mbt_compat::arr_release_unused_with", rendered.join(", "))
  }
  let rendered : Array[String] = []
  for sp in arg_spans {
    let (lb, aval, full, is_sh) = inspect_token_arg(src, tokens, sp.0, sp.1)
    rendered.push(if is_sh { lb + "=" + aval } else { full })
  }
  (helper, rendered.join(", "))
}

///| Mark lines `[s_line ..= e_line]` as mutated in `mutated_lines`.
fn mark_mutated_span(mutated_lines : Map[Int, Bool], s_line : Int, e_line : Int) -> Unit {
  let mut ml = if s_line < 0 { 0 } else { s_line }
  while ml <= e_line {
    mutated_lines[ml] = true
    ml = ml + 1
  }
}

///| Per-file O(N) cached token & line-offset index for Stage B method-call rewrites.
struct MethodRewriteIndex {
  src : String
  tokens : Array[Token]
  line_starts : Array[Int]
  line_first_tok : Array[Int]
}

fn build_method_rewrite_index(src : String, tokens : Array[Token], num_lines : Int) -> MethodRewriteIndex {
  let line_starts : Array[Int] = []
  let line_first_tok : Array[Int] = []
  line_starts.push(0)
  let slen = src.length()
  let mut bi = 0
  while bi < slen {
    if src.code_unit_at(bi) == 10 {
      line_starts.push(bi + 1)
    }
    bi = bi + 1
  }
  let mut li = 0
  while li < num_lines {
    line_first_tok.push(-1)
    li = li + 1
  }
  let mut ti = 0
  let n_tok = tokens.length()
  while ti < n_tok {
    let tl = tokens[ti].line - 1
    if tl >= 0 && tl < num_lines && line_first_tok[tl] < 0 {
      line_first_tok[tl] = ti
    }
    ti = ti + 1
  }
  MethodRewriteIndex::{ src, tokens, line_starts, line_first_tok }
}

///| Scan a `TokenKind::InterpString` token text (`"..."`) and return byte ranges `(expr_start, expr_end)`
///| relative to `tok_text` for each top-level `\{ ... }` interpolation expression.
///| Handles nested `{...}`, nested string literals `"..."` (with `\"`, `\\`, and nested `\{...}`),
///| char literals `'...'`, and `//` comments.
fn find_interp_expr_spans(tok_text : String) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  let n = tok_text.length()
  if n < 2 || tok_text.code_unit_at(0) != 34 {
    return out
  }
  let mut i = 1
  while i < n - 1 {
    let ch = tok_text.code_unit_at(i)
    if ch == 92 {
      if i + 1 < n - 1 && tok_text.code_unit_at(i + 1) == 123 {
        let expr_start = i + 2
        let mut j = expr_start
        // Track nested string/interp stack: 0 = code brace depth, 1 = inside nested string
        let str_depths : Array[Int] = []
        let mut brace_depth = 1
        let mut in_str = false
        let mut in_chr = false
        let mut esc = false
        while j < n - 1 && brace_depth > 0 {
          let c = tok_text.code_unit_at(j)
          if in_str {
            if esc {
              esc = false
              j = j + 1
            } else if c == 92 {
              if j + 1 < n - 1 && tok_text.code_unit_at(j + 1) == 123 {
                // Nested interpolation `\{` inside nested string literal
                str_depths.push(brace_depth)
                in_str = false
                brace_depth = brace_depth + 1
                j = j + 2
              } else {
                esc = true
                j = j + 1
              }
            } else if c == 34 {
              in_str = false
              j = j + 1
            } else {
              j = j + 1
            }
          } else if in_chr {
            if esc {
              esc = false
            } else if c == 92 {
              esc = true
            } else if c == 39 {
              in_chr = false
            }
            j = j + 1
          } else if c == 47 && j + 1 < n - 1 && tok_text.code_unit_at(j + 1) == 47 {
            j = j + 2
            while j < n - 1 && tok_text.code_unit_at(j) != 10 {
              j = j + 1
            }
          } else if c == 34 {
            in_str = true
            esc = false
            j = j + 1
          } else if c == 39 {
            in_chr = true
            esc = false
            j = j + 1
          } else if c == 123 {
            brace_depth = brace_depth + 1
            j = j + 1
          } else if c == 125 {
            brace_depth = brace_depth - 1
            if brace_depth > 0 && str_depths.length() > 0 && str_depths[str_depths.length() - 1] == brace_depth {
              let _ = str_depths.pop()
              in_str = true
              esc = false
            }
            if brace_depth == 0 {
              break
            }
            j = j + 1
          } else {
            j = j + 1
          }
        }
        if brace_depth == 0 {
          out.push((expr_start, j))
          i = j + 1
        } else {
          break
        }
      } else {
        i = i + 2
      }
    } else {
      i = i + 1
    }
  }
  out
}

///| Convert a byte offset in `idx.src` to `(0-based line_idx, 1-based col)`.
fn line_starts_to_line_col(line_starts : Array[Int], byte_off : Int) -> (Int, Int) {
  let n = line_starts.length()
  if n == 0 {
    return (0, 1)
  }
  let mut lo = 0
  let mut hi = n - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if line_starts[mid] <= byte_off {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  (lo, byte_off - line_starts[lo] + 1)
}

///| Find the `TokenKind::InterpString` token covering byte offset `target_b` on line `lidx`
///| in O(1) amortized time using `idx.line_first_tok` (never scans from token 0).
fn find_covering_interp_token(idx : MethodRewriteIndex, lidx : Int, target_b : Int) -> Int {
  let tokens = idx.tokens
  let n_tok = tokens.length()
  if lidx < 0 || lidx >= idx.line_first_tok.length() {
    return -1
  }
  let mut ti = idx.line_first_tok[lidx]
  if ti < 0 {
    // Line is inside a multiline token starting on an earlier line; walk back to nearest prior line with a token.
    let mut pl = lidx - 1
    while pl >= 0 && idx.line_first_tok[pl] < 0 {
      pl = pl - 1
    }
    if pl < 0 {
      return -1
    }
    ti = idx.line_first_tok[pl]
  } else if ti > 0 && tokens[ti - 1].kind == TokenKind::InterpString &&
  tokens[ti - 1].start_byte <= target_b && target_b < tokens[ti - 1].end_byte {
    return ti - 1
  }
  while ti < n_tok {
    let tk = tokens[ti]
    if tk.start_byte > target_b {
      break
    }
    if tk.kind == TokenKind::InterpString && tk.start_byte <= target_b && target_b < tk.end_byte {
      return ti
    }
    ti = ti + 1
  }
  -1
}

///| Compute a single interpolation-hole byte edit `(abs_s, abs_e, new_sub)` for a missing method call
///| inside `tokens[interp_ti]` without mutating `lines` (enables same-round batching of disjoint holes).
fn compute_interp_hole_edit(
  idx : MethodRewriteIndex,
  lines : Array[String],
  lidx : Int,
  col : Int,
  interp_ti : Int,
  method_name : String,
  helper : String,
) -> Option[(Int, Int, String)] {
  if lidx < 0 || lidx >= lines.length() || lidx >= idx.line_starts.length() ||
  interp_ti < 0 || interp_ti >= idx.tokens.length() {
    return None
  }
  let src = idx.src
  let line_start_b = idx.line_starts[lidx]
  let line_end_b = if lidx + 1 < idx.line_starts.length() {
    idx.line_starts[lidx + 1] - 1
  } else {
    src.length()
  }
  let raw_target_b = line_start_b + (if col > 0 { col - 1 } else { 0 })
  let target_b = if raw_target_b > line_end_b { line_end_b } else { raw_target_b }
  let itok = idx.tokens[interp_ti]
  if itok.kind != TokenKind::InterpString || target_b < itok.start_byte || target_b >= itok.end_byte {
    return None
  }
  let tok_text = src.slice(itok.start_byte, itok.end_byte)
  let spans = find_interp_expr_spans(tok_text)
  if spans.length() == 0 {
    return None
  }
  let rel_target = target_b - itok.start_byte
  let mut chosen_s = -1
  let mut chosen_e = -1
  for sp in spans {
    let (es, ee) = sp
    if es <= rel_target && rel_target <= ee {
      chosen_s = es
      chosen_e = ee
      break
    }
  }
  if chosen_s < 0 || chosen_e <= chosen_s {
    return None
  }
  let abs_s = itok.start_byte + chosen_s
  let abs_e = itok.start_byte + chosen_e
  let (sub_base_line, sub_base_col) = line_starts_to_line_col(idx.line_starts, abs_s)
  let (sub_last_line, _sub_last_col) = line_starts_to_line_col(idx.line_starts, abs_e)
  if sub_base_line < 0 || sub_last_line >= lines.length() || lidx < sub_base_line || lidx > sub_last_line {
    return None
  }
  let sub_src = src.slice(abs_s, abs_e)
  let sub_lines = sub_src.split("\n")
  let sub_toks = lex_moonbit(sub_src)
  let sub_idx = build_method_rewrite_index(sub_src, sub_toks, sub_lines.length())
  let sub_mut : Map[Int, Bool] = Map()
  let sub_lidx = lidx - sub_base_line
  let sub_col = if sub_lidx == 0 {
    let c = col - sub_base_col + 1
    if c > 0 { c } else { 1 }
  } else {
    col
  }
  let (rw_s, _rw_e) = rewrite_method_call_with_index(sub_idx, sub_lines, sub_mut, sub_lidx, sub_col, method_name, helper)
  if rw_s < 0 {
    return None
  }
  let new_sub = sub_lines.join("\n")
  if new_sub == sub_src {
    return None
  }
  // Shrink to the minimal changed byte span so multiple disjoint calls inside ONE interpolation
  // hole (e.g. `\{x.escape() + x.escape() + ...}`) batch cleanly in a single Stage B round.
  let min_len = if sub_src.length() < new_sub.length() { sub_src.length() } else { new_sub.length() }
  let mut pfx = 0
  while pfx < min_len && sub_src.code_unit_at(pfx) == new_sub.code_unit_at(pfx) {
    pfx = pfx + 1
  }
  let mut sfx = 0
  while pfx + sfx < min_len &&
  sub_src.code_unit_at(sub_src.length() - 1 - sfx) == new_sub.code_unit_at(new_sub.length() - 1 - sfx) {
    sfx = sfx + 1
  }
  Some((abs_s + pfx, abs_e - sfx, new_sub.slice(pfx, new_sub.length() - sfx)))
}

///| Rewrite a missing method call inside a known `TokenKind::InterpString` token `interp_ti`.
fn rewrite_method_call_in_interp_string_tok(
  idx : MethodRewriteIndex,
  lines : Array[String],
  mutated_lines : Map[Int, Bool],
  lidx : Int,
  col : Int,
  interp_ti : Int,
  method_name : String,
  helper : String,
) -> (Int, Int) {
  match compute_interp_hole_edit(idx, lines, lidx, col, interp_ti, method_name, helper) {
    None => (-1, -1)
    Some((abs_s, abs_e, new_sub)) => {
      let (sub_base_line, _sub_base_col) = line_starts_to_line_col(idx.line_starts, abs_s)
      let (sub_last_line, _sub_last_col) = line_starts_to_line_col(idx.line_starts, abs_e)
      let mut chk_l = sub_base_line
      while chk_l <= sub_last_line {
        if mutated_lines.contains(chk_l) {
          return (-1, -1)
        }
        chk_l = chk_l + 1
      }
      let src = idx.src
      let first_line_start_b = idx.line_starts[sub_base_line]
      let last_line_end_b = if sub_last_line + 1 < idx.line_starts.length() {
        idx.line_starts[sub_last_line + 1] - 1
      } else {
        src.length()
      }
      let prefix = src.slice(first_line_start_b, abs_s)
      let suffix = src.slice(abs_e, last_line_end_b)
      let replacement = prefix + new_sub + suffix
      let rep_lines = replacement.split("\n")
      let orig_span = sub_last_line - sub_base_line + 1
      let mut cl = sub_base_line
      while cl <= sub_last_line {
        lines[cl] = ""
        cl = cl + 1
      }
      if rep_lines.length() <= orig_span {
        let mut ri = 0
        while ri < rep_lines.length() {
          lines[sub_base_line + ri] = rep_lines[ri]
          ri = ri + 1
        }
      } else {
        lines[sub_base_line] = replacement
      }
      mark_mutated_span(mutated_lines, sub_base_line, sub_last_line)
      (sub_base_line, sub_last_line)
    }
  }
}

///| Find enclosing top-level `fn` header start and body token range `(fn_kw_ti, body_s, body_e)` containing `pos_ti`,
///| or `(-1, -1, -1)`.
fn find_enclosing_top_fn_header_and_body(tokens : Array[Token], pos_ti : Int) -> (Int, Int, Int) {
  let n = tokens.length() - 1
  let mut i = 0
  let mut depth = 0
  let mut last_top_fn = -1
  while i < n {
    let tk = tokens[i]
    if depth == 0 && tk.kind == TokenKind::Keyword && tk.raw == "fn" {
      last_top_fn = i
    }
    if tk.kind == TokenKind::LBrace {
      if depth == 0 {
        let rb = find_matching_delim(tokens, i)
        if rb > i && pos_ti > i && pos_ti < rb {
          return (last_top_fn, i + 1, rb)
        }
        if rb > i {
          last_top_fn = -1
          i = rb + 1
          continue
        }
      }
      depth = depth + 1
    } else if tk.kind == TokenKind::RBrace {
      if depth > 0 { depth = depth - 1 }
    }
    i = i + 1
  }
  (-1, -1, -1)
}

///| True iff `tokens[s_in ..= e_in]` (stripping balanced outer parens) is a directly constructed fresh array:
///| bare `[...]` literal, or direct call to `Array::new`/`Array::make`/`Array::makei` or
///| `mbt_compat::arr_make`/`mbt_compat::arr_makei`. Never allows arbitrary user calls like `pass(xs)`.
fn is_fresh_array_expr(tokens : Array[Token], s_in : Int, e_in : Int) -> Bool {
  let mut s = s_in
  let mut e = e_in
  while s < e && tokens[s].kind == TokenKind::LParen && find_matching_delim(tokens, s) == e {
    s = s + 1
    e = e - 1
  }
  if s > e {
    return false
  }
  if tokens[s].kind == TokenKind::LBracket && find_matching_delim(tokens, s) == e {
    return true
  }
  if s + 3 <= e && tokens[e].kind == TokenKind::RParen && tokens[s + 1].kind == TokenKind::ColonColon {
    let is_std_arr = tokens[s].kind == TokenKind::UpperIdent && tokens[s].raw == "Array" &&
    (tokens[s + 2].raw == "new" || tokens[s + 2].raw == "make" || tokens[s + 2].raw == "makei")
    let is_compat_arr = tokens[s].kind == TokenKind::Ident && tokens[s].raw == "mbt_compat" &&
    (tokens[s + 2].raw == "arr_make" || tokens[s + 2].raw == "arr_makei")
    if is_std_arr || is_compat_arr {
      let mut lp = s + 3
      if lp < e && tokens[lp].kind == TokenKind::LBracket {
        let rb = find_matching_delim(tokens, lp)
        if rb > lp && rb < e {
          lp = rb + 1
        }
      }
      if lp < e && tokens[lp].kind == TokenKind::LParen && find_matching_delim(tokens, lp) == e {
        return true
      }
    }
  }
  false
}

///| Strict read-only / view-returning `Array` methods that cannot structurally mutate or alias `self` as `Array[T]`.
fn is_array_view_safe_read_method(name : String) -> Bool {
  name == "length" || name == "is_empty" || name == "get" || name == "first" ||
  name == "last" || name == "contains" || name == "as_view" || name == "view"
}

///| Mathematically sound fresh-non-escaping local/rvalue allowlist for implicit `Array[T]` -> `mbt_compat::arr_view(<expr>)`:
///| 1. Direct fresh array rvalue: `[...]` or `Array::{new,make,makei}(...)` / `mbt_compat::arr_make{,i}(...)`.
///| 2. Local immutable `let xs` (not `let mut`, not param/global/field) in the enclosing top-level `fn` where:
///|    (a) `xs` is declared once with a fresh array initializer (no external `Array[T]` alias possible);
///|    (b) every occurrence of `xs` in the function body is outside any closure/nested `fn` and outside `InterpString`;
///|    (c) every non-declaration use of `xs` is strictly one of: the target argument token itself,
///|        `mbt_compat::arr_view(xs)`, indexing `xs[...]`, a read-only method in `is_array_view_safe_read_method`,
///|        or `for ... in xs`. Any aliasing (`let ys = xs`), escape (`pass(xs)`, `read_after(xs, xs)`, `return xs`),
///|        closure capture, or structural mutation (`push`/`pop`/...) is rejected fail-closed.
fn array_view_arg_is_safe(
  tokens : Array[Token],
  lp_ti : Int,
  _rp_ti : Int,
  val_s_ti : Int,
  ae_ti : Int,
) -> Bool {
  let mut s = val_s_ti
  let mut e = ae_ti
  while s < e && tokens[s].kind == TokenKind::LParen && find_matching_delim(tokens, s) == e {
    s = s + 1
    e = e - 1
  }
  if s > e {
    return false
  }
  // 1. Direct fresh rvalue expression
  if is_fresh_array_expr(tokens, s, e) {
    return true
  }
  // 2. Local immutable `let` identifier with fresh initializer, zero aliasing/escaping, zero structural mutation
  if !(s == e && tokens[s].kind == TokenKind::Ident) {
    return false
  }
  let var_name = tokens[s].raw
  let (fn_kw_ti, fn_s, fn_e) = find_enclosing_top_fn_header_and_body(tokens, lp_ti)
  if fn_kw_ti < 0 || fn_s < 0 || fn_e <= fn_s {
    return false
  }
  // Reject if `var_name` is a function parameter
  let mut hi = fn_kw_ti + 1
  while hi < fn_s - 1 {
    if tokens[hi].kind == TokenKind::Ident && tokens[hi].raw == var_name &&
    hi + 1 < fn_s - 1 && (tokens[hi + 1].kind == TokenKind::Colon || tokens[hi + 1].kind == TokenKind::Tilde) {
      return false
    }
    hi = hi + 1
  }
  // Single pass over enclosing fn body: locate unique `let xs = <fresh>` and validate every use of `xs`
  let mut decl_name_ti = -1
  let mut decl_depth = -1
  let mut decl_in_scope = false
  let mut brace_depth = 0
  let mut in_closure_until = -1
  let mut bi = fn_s
  while bi < fn_e {
    let tk = tokens[bi]
    if tk.kind == TokenKind::LBrace {
      brace_depth = brace_depth + 1
    } else if tk.kind == TokenKind::RBrace {
      if brace_depth > 0 { brace_depth = brace_depth - 1 }
      if decl_name_ti >= 0 && bi < s && brace_depth < decl_depth {
        decl_in_scope = false
      }
    }
    // Track closure / nested fn bodies
    if tk.kind == TokenKind::Keyword && tk.raw == "fn" {
      let mut ci = bi + 1
      let mut cd = 0
      while ci < fn_e {
        let ck = tokens[ci].kind
        if ck == TokenKind::LParen || ck == TokenKind::LBracket { cd = cd + 1 }
        else if ck == TokenKind::RParen || ck == TokenKind::RBracket { if cd > 0 { cd = cd - 1 } }
        else if cd == 0 && ck == TokenKind::LBrace {
          let crb = find_matching_delim(tokens, ci)
          if crb > in_closure_until {
            in_closure_until = crb
          }
          break
        }
        ci = ci + 1
      }
    }
    // Reject if `var_name` appears inside any interpolation string in the function
    if (tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline) &&
    type_mentions_ident(tk.raw, var_name) {
      return false
    }
    if tk.kind == TokenKind::Ident && tk.raw == var_name {
      // Skip field access `.xs` and qualified path `::xs`
      if bi > fn_s && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon) {
        bi = bi + 1
        continue
      }
      // Skip named argument label `xs=...` inside a call
      if bi > fn_s && bi + 1 < fn_e && tokens[bi + 1].kind == TokenKind::Eq &&
      (tokens[bi - 1].kind == TokenKind::LParen || tokens[bi - 1].kind == TokenKind::Comma) {
        bi = bi + 1
        continue
      }
      // Check if this is a `let [mut] xs` declaration
      let is_let_mut = bi >= fn_s + 2 && tokens[bi - 1].kind == TokenKind::Keyword && tokens[bi - 1].raw == "mut" &&
      tokens[bi - 2].kind == TokenKind::Keyword && tokens[bi - 2].raw == "let"
      let is_let_immut = bi >= fn_s + 1 && tokens[bi - 1].kind == TokenKind::Keyword && tokens[bi - 1].raw == "let"
      if is_let_mut {
        return false
      }
      if is_let_immut {
        if decl_name_ti >= 0 || bi <= in_closure_until || bi >= s {
          return false
        }
        // Scan optional `: <Type>` to `=`
        let mut eq_ti = bi + 1
        let mut td = 0
        while eq_ti < fn_e {
          let ek = tokens[eq_ti].kind
          if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { td = td + 1 }
          else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { if td > 0 { td = td - 1 } }
          else if td == 0 && ek == TokenKind::Eq { break }
          else if td == 0 && (ek == TokenKind::Semi || (eq_ti > bi + 1 && tokens[eq_ti].newline_before)) {
            return false
          }
          eq_ti = eq_ti + 1
        }
        if eq_ti >= fn_e || tokens[eq_ti].kind != TokenKind::Eq || eq_ti + 1 >= fn_e {
          return false
        }
        let init_s = eq_ti + 1
        let mut init_e = init_s
        let mut id = 0
        let mut ii = init_s
        while ii < fn_e {
          let ik = tokens[ii].kind
          if id == 0 && ii > init_s && (tokens[ii].newline_before || ik == TokenKind::Semi || ik == TokenKind::RBrace) {
            break
          }
          if ik == TokenKind::LParen || ik == TokenKind::LBracket || ik == TokenKind::LBrace { id = id + 1 }
          else if ik == TokenKind::RParen || ik == TokenKind::RBracket || ik == TokenKind::RBrace {
            if id == 0 { break }
            id = id - 1
          }
          init_e = ii
          ii = ii + 1
        }
        if id != 0 || !is_fresh_array_expr(tokens, init_s, init_e) {
          return false
        }
        decl_name_ti = bi
        decl_depth = brace_depth
        decl_in_scope = true
        bi = bi + 1
        continue
      }
      // Every non-declaration use of `xs` MUST be outside closures and strictly in the safe allowlist!
      if bi <= in_closure_until {
        return false
      }
      let is_target_arg = bi == s
      let is_arr_view_wrap = bi >= fn_s + 4 && bi + 1 < fn_e &&
      tokens[bi - 4].raw == "mbt_compat" && tokens[bi - 3].kind == TokenKind::ColonColon &&
      tokens[bi - 2].raw == "arr_view" && tokens[bi - 1].kind == TokenKind::LParen &&
      tokens[bi + 1].kind == TokenKind::RParen
      let is_indexing = bi + 1 < fn_e && tokens[bi + 1].kind == TokenKind::LBracket
      let is_safe_method = bi + 3 < fn_e && tokens[bi + 1].kind == TokenKind::Dot &&
      tokens[bi + 3].kind == TokenKind::LParen && is_array_view_safe_read_method(tokens[bi + 2].raw)
      let is_for_in_source = bi > fn_s && bi + 1 < fn_e &&
      tokens[bi - 1].kind == TokenKind::Keyword && tokens[bi - 1].raw == "in" &&
      tokens[bi + 1].kind == TokenKind::LBrace
      if !is_target_arg && !is_arr_view_wrap && !is_indexing && !is_safe_method && !is_for_in_source {
        return false
      }
    }
    bi = bi + 1
  }
  decl_name_ti >= 0 && decl_in_scope
}

///| True iff token immediately before `(` can end a callee expression (excludes grouping `(xs)`).
fn prev_tok_is_callable_head(tokens : Array[Token], lp_ti : Int) -> Bool {
  if lp_ti <= 0 {
    return false
  }
  let pk = tokens[lp_ti - 1].kind
  pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
  pk == TokenKind::RParen || pk == TokenKind::RBracket
}

///| Extract the short callee identifier from `... in call to `<callee>`` (last segment after `.` / `::`).
fn extract_call_mismatch_callee(msg : String) -> String {
  let needle = "in call to `"
  let idx = msg.index_of(needle)
  if idx < 0 {
    return ""
  }
  let rest = msg.slice(idx + needle.length(), msg.length())
  let bt = rest.index_of("`")
  if bt <= 0 {
    return ""
  }
  let full = rest.slice(0, bt)
  let mut start = 0
  let mut k = 0
  while k < full.length() {
    let c = full.code_unit_at(k)
    if c == 46 {
      start = k + 1
    } else if c == 58 && k + 1 < full.length() && full.code_unit_at(k + 1) == 58 {
      start = k + 2
      k = k + 1
    }
    k = k + 1
  }
  full.slice(start, full.length())
}

///| Rewrite an `Array[T]` argument to `mbt_compat::arr_view(<arg>)` when a call expects `ArrayView[T]`.
fn rewrite_array_to_view_arg_with_index(
  idx : MethodRewriteIndex,
  lines : Array[String],
  mutated_lines : Map[Int, Bool],
  lidx : Int,
  col : Int,
  msg : String,
) -> (Int, Int) {
  if lidx < 0 || lidx >= lines.length() || lidx >= idx.line_starts.length() {
    return (-1, -1)
  }
  let mut arg_num = 0
  if msg.starts_with("argument ") {
    let rest = msg.slice(9, msg.length())
    let sp = rest.index_of(" ")
    if sp > 0 {
      let ns = rest.slice(0, sp)
      let mut parsed_n = 0
      let mut ok = true
      let mut k = 0
      while k < ns.length() {
        let c = ns.code_unit_at(k)
        if c >= 48 && c <= 57 {
          parsed_n = parsed_n * 10 + (c - 48)
        } else {
          ok = false
          break
        }
        k = k + 1
      }
      if ok && parsed_n >= 1 {
        arg_num = parsed_n
      }
    }
  }
  let want_callee = extract_call_mismatch_callee(msg)
  let src = idx.src
  let tokens = idx.tokens
  let n_tok = tokens.length()
  let line_start_b = idx.line_starts[lidx]
  let target_b = line_start_b + (if col > 0 { col - 1 } else { 0 })
  // Find the innermost enclosing callable `(` with STRICT containment (`ti.start < target_b < rp.start`),
  // preferring a call whose preceding token matches `want_callee` (skipping `take((xs))` and inner `make(7)`).
  let mut match_lp = -1
  let mut match_rp = -1
  let mut match_span = 100000000
  let mut any_lp = -1
  let mut any_rp = -1
  let mut any_span = 100000000
  let mut ti = 0
  while ti < n_tok {
    if tokens[ti].start_byte >= target_b {
      break
    }
    if tokens[ti].kind == TokenKind::LParen && prev_tok_is_callable_head(tokens, ti) {
      let rp = find_matching_delim(tokens, ti)
      if rp > ti && rp < n_tok && tokens[rp].kind == TokenKind::RParen &&
      tokens[ti].start_byte < target_b && target_b < tokens[rp].start_byte {
        let span = tokens[rp].end_byte - tokens[ti].start_byte
        if want_callee.length() > 0 && tokens[ti - 1].raw == want_callee {
          if span < match_span {
            match_span = span
            match_lp = ti
            match_rp = rp
          }
        }
        if span < any_span {
          any_span = span
          any_lp = ti
          any_rp = rp
        }
      }
    }
    ti = ti + 1
  }
  let mut lp_ti = if match_lp >= 0 { match_lp } else { any_lp }
  let mut rp_ti = if match_lp >= 0 { match_rp } else { any_rp }
  if lp_ti < 0 {
    // Fallback when `col` points at the callee name before `(` on `lidx`: prefer matching `want_callee`.
    let target_line = lidx + 1
    let mut best_m_dist = 1000000
    let mut best_a_dist = 1000000
    let mut ti2 = if idx.line_first_tok[lidx] >= 0 { idx.line_first_tok[lidx] } else { 0 }
    while ti2 < n_tok && tokens[ti2].line == target_line {
      if tokens[ti2].kind == TokenKind::LParen && prev_tok_is_callable_head(tokens, ti2) {
        let rp = find_matching_delim(tokens, ti2)
        if rp > ti2 && rp < n_tok && tokens[rp].kind == TokenKind::RParen {
          let dist = if tokens[ti2].col >= col { tokens[ti2].col - col } else { col - tokens[ti2].col }
          if want_callee.length() > 0 && tokens[ti2 - 1].raw == want_callee && dist < best_m_dist {
            best_m_dist = dist
            match_lp = ti2
            match_rp = rp
          }
          if dist < best_a_dist {
            best_a_dist = dist
            any_lp = ti2
            any_rp = rp
          }
        }
      }
      ti2 = ti2 + 1
    }
    lp_ti = if match_lp >= 0 { match_lp } else { any_lp }
    rp_ti = if match_lp >= 0 { match_rp } else { any_rp }
  }
  if lp_ti < 0 || rp_ti <= lp_ti {
    return (-1, -1)
  }
  // Split top-level arguments inside `(lp_ti + 1 .. rp_ti)` by depth-0 Comma.
  let arg_spans : Array[(Int, Int)] = []
  let mut depth = 0
  let mut seg_start = lp_ti + 1
  let mut ai = lp_ti + 1
  while ai < rp_ti {
    match tokens[ai].kind {
      TokenKind::LParen | TokenKind::LBracket | TokenKind::LBrace => depth = depth + 1
      TokenKind::RParen | TokenKind::RBracket | TokenKind::RBrace =>
      if depth > 0 { depth = depth - 1 }
      TokenKind::Comma =>
      if depth == 0 {
        if seg_start < ai {
          arg_spans.push((seg_start, ai - 1))
        }
        seg_start = ai + 1
      }
      _ => ()
    }
    ai = ai + 1
  }
  if seg_start < rp_ti {
    arg_spans.push((seg_start, rp_ti - 1))
  }
  // Prefer the argument span containing `target_b` (handles reordered named args `foo(b=1, a=xs)` and `take(xs~, a=8)`),
  // falling back to 1-based `arg_num` only when `target_b` is outside all argument spans (e.g. pointing at callee).
  let mut chosen_idx = -1
  let mut si = 0
  while si < arg_spans.length() {
    let (s_ti, e_ti) = arg_spans[si]
    if tokens[s_ti].start_byte <= target_b && target_b <= tokens[e_ti].end_byte {
      chosen_idx = si
      break
    }
    si = si + 1
  }
  if chosen_idx < 0 && arg_num >= 1 && arg_num <= arg_spans.length() {
    chosen_idx = arg_num - 1
  }
  if chosen_idx < 0 || chosen_idx >= arg_spans.length() {
    return (-1, -1)
  }
  let (as_ti, ae_ti) = arg_spans[chosen_idx]
  // Handle labeled `name=val` or punned `name~` arguments.
  let mut val_s_ti = as_ti
  let mut is_pun = false
  if as_ti + 1 <= ae_ti && tokens[as_ti].kind == TokenKind::Ident && tokens[as_ti + 1].kind == TokenKind::Eq {
    val_s_ti = as_ti + 2
  } else if as_ti + 1 == ae_ti && tokens[as_ti].kind == TokenKind::Ident && tokens[as_ti + 1].kind == TokenKind::Tilde {
    is_pun = true
  }
  if val_s_ti > ae_ti {
    return (-1, -1)
  }
  // P1-2: Fail-closed if the underlying array may undergo structural mutation (push/pop/resize/...)
  if !array_view_arg_is_safe(tokens, lp_ti, rp_ti, val_s_ti, if is_pun { as_ti } else { ae_ti }) {
    return (-1, -1)
  }
  let start_line = tokens[val_s_ti].line - 1
  let end_line = tokens[ae_ti].line - 1
  if start_line < 0 || end_line < start_line || end_line >= lines.length() {
    return (-1, -1)
  }
  let mut chk_l = start_line
  while chk_l <= end_line {
    if mutated_lines.contains(chk_l) {
      return (-1, -1)
    }
    chk_l = chk_l + 1
  }
  let rep_expr = if is_pun {
    tokens[as_ti].raw + "=mbt_compat::arr_view(" + tokens[as_ti].raw + ")"
  } else {
    let raw_arg = src.slice(tokens[val_s_ti].start_byte, tokens[ae_ti].end_byte)
    if raw_arg.starts_with("mbt_compat::arr_view(") {
      return (-1, -1)
    }
    "mbt_compat::arr_view(" + raw_arg + ")"
  }
  let first_line_start_b = idx.line_starts[start_line]
  let last_line_end_b = if end_line + 1 < idx.line_starts.length() {
    idx.line_starts[end_line + 1] - 1
  } else {
    src.length()
  }
  let prefix = src.slice(first_line_start_b, tokens[val_s_ti].start_byte)
  let suffix = src.slice(tokens[ae_ti].end_byte, last_line_end_b)
  let replacement = prefix + rep_expr + suffix
  let rep_lines = replacement.split("\n")
  let orig_span = end_line - start_line + 1
  let mut cl = start_line
  while cl <= end_line {
    lines[cl] = ""
    cl = cl + 1
  }
  if rep_lines.length() <= orig_span {
    let mut ri = 0
    while ri < rep_lines.length() {
      lines[start_line + ri] = rep_lines[ri]
      ri = ri + 1
    }
  } else {
    lines[start_line] = replacement
  }
  mark_mutated_span(mutated_lines, start_line, end_line)
  (start_line, end_line)
}

///| True iff the last line of `s` contains an unquoted `//` line comment (so appending `, ` or `)` requires `\n`).
fn ends_with_line_comment(s : String) -> Bool {
  let n = s.length()
  let mut start = n
  while start > 0 && s.code_unit_at(start - 1) != 10 {
    start = start - 1
  }
  let mut i = start
  let mut in_s = false
  let mut in_c = false
  let mut esc = false
  while i < n {
    let ch = s.code_unit_at(i)
    if in_s {
      if esc { esc = false }
      else if ch == 92 { esc = true }
      else if ch == 34 { in_s = false }
    } else if in_c {
      if esc { esc = false }
      else if ch == 92 { esc = true }
      else if ch == 39 { in_c = false }
    } else if ch == 34 {
      in_s = true
    } else if ch == 39 {
      in_c = true
    } else if ch == 47 && i + 1 < n && s.code_unit_at(i + 1) == 47 {
      return true
    }
    i = i + 1
  }
  false
}

///| Token-based index assignment / read rewriter supporting multiline index keys `m[k1 +\n k2] = v`,
///| multiline RHS values, and `#alias("_[_]=_")` / `#alias("_[_]")` / `op_set` / `op_get`.
fn rewrite_index_op_with_index(
  idx : MethodRewriteIndex,
  lines : Array[String],
  mutated_lines : Map[Int, Bool],
  lidx : Int,
  col : Int,
  idx_set_method : String,
  idx_get_method : String,
) -> (Int, Int) {
  if lidx < 0 || lidx >= lines.length() || lidx >= idx.line_first_tok.length() {
    return (-1, -1)
  }
  let start_ti = idx.line_first_tok[lidx]
  if start_ti < 0 {
    return (-1, -1)
  }
  let src = idx.src
  let tokens = idx.tokens
  let n_tok = tokens.length()
  let target_line = lidx + 1
  // Pick the `[` on `target_line` nearest to `col` that matches either `[...] = ...` (if `idx_set_method` non-empty)
  // or `[...]` (if `idx_get_method` non-empty).
  let mut best_lb_ti = -1
  let mut best_rb_ti = -1
  let mut best_is_assign = false
  let mut best_dist = 1000000
  let mut ti = start_ti
  while ti < n_tok && tokens[ti].line == target_line {
    if tokens[ti].kind == TokenKind::LBracket {
      let rb = find_matching_delim(tokens, ti)
      if rb > ti && rb < n_tok && tokens[rb].kind == TokenKind::RBracket {
        let is_assign = rb + 1 < n_tok && tokens[rb + 1].kind == TokenKind::Eq
        let eligible = (is_assign && idx_set_method.length() > 0) || (!is_assign && idx_get_method.length() > 0)
        if eligible {
          let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
          if dist < best_dist {
            best_dist = dist
            best_lb_ti = ti
            best_rb_ti = rb
            best_is_assign = is_assign
          }
        }
      }
    }
    ti = ti + 1
  }
  if best_lb_ti < 0 || best_rb_ti <= best_lb_ti {
    return (-1, -1)
  }
  let k_expr = src.slice(tokens[best_lb_ti].end_byte, tokens[best_rb_ti].start_byte).trim()
  let k_sep = if ends_with_line_comment(k_expr) { "\n" } else { "" }
  if !best_is_assign {
    let start_line = tokens[best_lb_ti].line - 1
    let end_line = tokens[best_rb_ti].line - 1
    if start_line < 0 || end_line < start_line || end_line >= lines.length() {
      return (-1, -1)
    }
    let mut chk_l = start_line
    while chk_l <= end_line {
      if mutated_lines.contains(chk_l) {
        return (-1, -1)
      }
      chk_l = chk_l + 1
    }
    let first_line_start_b = idx.line_starts[start_line]
    let last_line_end_b = if end_line + 1 < idx.line_starts.length() {
      idx.line_starts[end_line + 1] - 1
    } else {
      src.length()
    }
    let prefix = src.slice(first_line_start_b, tokens[best_lb_ti].start_byte)
    let suffix = src.slice(tokens[best_rb_ti].end_byte, last_line_end_b)
    let replacement = prefix + "." + idx_get_method + "(" + k_expr + k_sep + ")" + suffix
    let rep_lines = replacement.split("\n")
    let orig_span = end_line - start_line + 1
    let mut cl = start_line
    while cl <= end_line {
      lines[cl] = ""
      cl = cl + 1
    }
    if rep_lines.length() <= orig_span {
      let mut ri = 0
      while ri < rep_lines.length() {
        lines[start_line + ri] = rep_lines[ri]
        ri = ri + 1
      }
    } else {
      lines[start_line] = replacement
    }
    mark_mutated_span(mutated_lines, start_line, end_line)
    return (start_line, end_line)
  }
  // Index assignment `<recv>[<k>] = <rhs>`: find end of `<rhs>` across lines using tokens.
  let eq_ti = best_rb_ti + 1
  if eq_ti + 1 >= n_tok {
    return (-1, -1)
  }
  let mut rhs_end_ti = eq_ti
  let mut depth = 0
  let mut ri = eq_ti + 1
  while ri < n_tok {
    let tk = tokens[ri]
    if tk.kind == TokenKind::Eof {
      break
    }
    if depth == 0 && ri > eq_ti + 1 && tk.newline_before {
      let pk = tokens[ri - 1].kind
      let same_multiline_str = (pk == TokenKind::RawMultiline || pk == TokenKind::InterpMultiline) &&
      (tk.kind == TokenKind::RawMultiline || tk.kind == TokenKind::InterpMultiline)
      let prev_cont = pk == TokenKind::Plus || pk == TokenKind::Minus || pk == TokenKind::Star ||
      pk == TokenKind::Slash || pk == TokenKind::Percent || pk == TokenKind::AmpAmp ||
      pk == TokenKind::PipePipe || pk == TokenKind::Pipe || pk == TokenKind::Amp ||
      pk == TokenKind::Caret || pk == TokenKind::Eq || pk == TokenKind::EqEq ||
      pk == TokenKind::BangEq || pk == TokenKind::Lt || pk == TokenKind::LtEq ||
      pk == TokenKind::Gt || pk == TokenKind::GtEq || pk == TokenKind::Dot ||
      pk == TokenKind::ColonColon || pk == TokenKind::FatArrow || pk == TokenKind::Arrow ||
      pk == TokenKind::PipeGt
      // Never treat a newline-leading `-` as binary continuation (could be unary `-2` on the next statement),
      // and never treat a newline-leading `.UpperIdent` enum pattern (e.g. match arm `.Named(n) => ...`) as method chaining.
      let dot_cont = tk.kind == TokenKind::Dot && ri + 1 < n_tok &&
      (tokens[ri + 1].kind == TokenKind::Ident || tokens[ri + 1].kind == TokenKind::IntLit)
      let cur_cont = dot_cont || tk.kind == TokenKind::Plus ||
      tk.kind == TokenKind::Star || tk.kind == TokenKind::Slash || tk.kind == TokenKind::Percent ||
      tk.kind == TokenKind::AmpAmp || tk.kind == TokenKind::PipePipe || tk.kind == TokenKind::PipeGt ||
      (tk.kind == TokenKind::Keyword && tk.raw == "else")
      if !same_multiline_str && !prev_cont && !cur_cont {
        break
      }
    }
    match tk.kind {
      TokenKind::LParen | TokenKind::LBracket | TokenKind::LBrace => {
        depth = depth + 1
        rhs_end_ti = ri
      }
      TokenKind::RParen | TokenKind::RBracket | TokenKind::RBrace => {
        if depth == 0 {
          break
        }
        depth = depth - 1
        rhs_end_ti = ri
      }
      TokenKind::Semi | TokenKind::Comma => {
        if depth == 0 {
          break
        }
        rhs_end_ti = ri
      }
      _ => rhs_end_ti = ri
    }
    ri = ri + 1
  }
  if depth != 0 || rhs_end_ti <= eq_ti {
    return (-1, -1)
  }
  let start_line = tokens[best_lb_ti].line - 1
  let end_line = tokens[rhs_end_ti].line - 1
  if start_line < 0 || end_line < start_line || end_line >= lines.length() {
    return (-1, -1)
  }
  let mut chk_l = start_line
  while chk_l <= end_line {
    if mutated_lines.contains(chk_l) {
      return (-1, -1)
    }
    chk_l = chk_l + 1
  }
  let rhs_is_multiline_lit = tokens[rhs_end_ti].kind == TokenKind::RawMultiline ||
  tokens[rhs_end_ti].kind == TokenKind::InterpMultiline
  let mut all_multiline_str = rhs_is_multiline_lit
  if all_multiline_str {
    let mut mk = eq_ti + 1
    while mk <= rhs_end_ti {
      if tokens[mk].kind != TokenKind::RawMultiline && tokens[mk].kind != TokenKind::InterpMultiline {
        all_multiline_str = false
        break
      }
      mk = mk + 1
    }
  }
  let v_expr = if all_multiline_str {
    let ml_parts : Array[String] = []
    let mut mk = eq_ti + 1
    while mk <= rhs_end_ti {
      ml_parts.push(tokens[mk].raw)
      mk = mk + 1
    }
    ml_parts.join("\n")
  } else if rhs_is_multiline_lit {
    src.slice(tokens[eq_ti + 1].start_byte, tokens[rhs_end_ti].end_byte)
  } else {
    src.slice(tokens[eq_ti + 1].start_byte, tokens[rhs_end_ti].end_byte).trim()
  }
  let v_sep = if ends_with_line_comment(v_expr) || rhs_is_multiline_lit { "\n" } else { "" }
  let first_line_start_b = idx.line_starts[start_line]
  let last_line_end_b = if end_line + 1 < idx.line_starts.length() {
    idx.line_starts[end_line + 1] - 1
  } else {
    src.length()
  }
  let prefix = src.slice(first_line_start_b, tokens[best_lb_ti].start_byte)
  let suffix = src.slice(tokens[rhs_end_ti].end_byte, last_line_end_b)
  let replacement = prefix + "." + idx_set_method + "(" + k_expr + k_sep + ", " + v_expr + v_sep + ")" + suffix
  let rep_lines = replacement.split("\n")
  let orig_span = end_line - start_line + 1
  let mut cl = start_line
  while cl <= end_line {
    lines[cl] = ""
    cl = cl + 1
  }
  if rep_lines.length() <= orig_span {
    let mut rli = 0
    while rli < rep_lines.length() {
      lines[start_line + rli] = rep_lines[rli]
      rli = rli + 1
    }
  } else {
    lines[start_line] = replacement
  }
  mark_mutated_span(mutated_lines, start_line, end_line)
  (start_line, end_line)
}

///| A tuple-typed argument observed at a call site: either named (`label != ""`) or positional (`pos`).
struct CallTupleArg {
  pos : Int
  label : String
}

///| Request to relax redundant `MbtHash`/`MapKey` bounds on a local generic function `fn_name`,
///| scoped strictly to pure `OrderedMap`/`OrderedSet` key type parameters matched by exact label/position.
struct BoundRelaxReq {
  fn_name : String
  tuple_args : Array[CallTupleArg]
}

///| Inspect the call to `req_fn(...)` near `(lidx, col)` and return all arguments that are visibly
///| tuple literals `(a, b)` or expressions whose queried type mentions a tuple, preserving named labels.
fn find_tuple_args_at_call(
  idx : MethodRewriteIndex,
  lidx : Int,
  col : Int,
  req_fn : String,
  qfi_opt : Option[QtFileIndex],
) -> Array[CallTupleArg] {
  let out : Array[CallTupleArg] = []
  if lidx < 0 || lidx >= idx.line_first_tok.length() {
    return out
  }
  let short_fn = {
    let cc = req_fn.index_of("::")
    if cc >= 0 { req_fn.slice(cc + 2, req_fn.length()) } else { req_fn }
  }
  let tokens = idx.tokens
  let n_tok = tokens.length()
  let target_line = lidx + 1
  let mut lp_ti = -1
  let mut best_dist = 1000000
  let mut ti = if idx.line_first_tok[lidx] >= 0 { idx.line_first_tok[lidx] } else { 0 }
  while ti + 1 < n_tok && tokens[ti].line == target_line {
    if tokens[ti].raw == short_fn && tokens[ti + 1].kind == TokenKind::LParen {
      let dist = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      if dist < best_dist {
        best_dist = dist
        lp_ti = ti + 1
      }
    }
    ti = ti + 1
  }
  if lp_ti < 0 {
    return out
  }
  let rp_ti = find_matching_delim(tokens, lp_ti)
  if rp_ti <= lp_ti || rp_ti >= n_tok {
    return out
  }
  let arg_spans : Array[(Int, Int)] = []
  let mut depth = 0
  let mut seg_s = lp_ti + 1
  let mut ai = lp_ti + 1
  while ai < rp_ti {
    match tokens[ai].kind {
      TokenKind::LParen | TokenKind::LBracket | TokenKind::LBrace => depth = depth + 1
      TokenKind::RParen | TokenKind::RBracket | TokenKind::RBrace =>
      if depth > 0 { depth = depth - 1 }
      TokenKind::Comma =>
      if depth == 0 {
        if seg_s < ai { arg_spans.push((seg_s, ai - 1)) }
        seg_s = ai + 1
      }
      _ => ()
    }
    ai = ai + 1
  }
  if seg_s < rp_ti {
    arg_spans.push((seg_s, rp_ti - 1))
  }
  let mut pos_idx = 0
  let mut idx_a = 0
  while idx_a < arg_spans.length() {
    let (raw_s, raw_e) = arg_spans[idx_a]
    let mut lbl = ""
    let mut s_ti = raw_s
    let mut e_ti = raw_e
    if raw_s + 2 <= raw_e && tokens[raw_s].kind == TokenKind::Ident && tokens[raw_s + 1].kind == TokenKind::Eq {
      lbl = tokens[raw_s].raw
      s_ti = raw_s + 2
    } else if raw_s + 1 == raw_e && tokens[raw_s].kind == TokenKind::Ident && tokens[raw_s + 1].kind == TokenKind::Tilde {
      lbl = tokens[raw_s].raw
      e_ti = raw_s
    }
    let mut is_tuple_arg = false
    // 1. Direct tuple literal `(a, b, ...)`
    if tokens[s_ti].kind == TokenKind::LParen && find_matching_delim(tokens, s_ti) == e_ti {
      let mut k = s_ti + 1
      let mut d = 0
      while k < e_ti {
        let kk = tokens[k].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
        else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
        else if d == 0 && kk == TokenKind::Comma { is_tuple_arg = true; break }
        k = k + 1
      }
    }
    // 2. Queried type from `qfi` is a direct tuple or an OrderedMap/OrderedSet with a tuple KEY (never tuple value)
    if !is_tuple_arg {
      match qfi_opt {
        Some(qfi) =>
        match qt_lookup_expr_span_ty(qfi, idx.src, tokens[s_ti].start_byte, tokens[e_ti].end_byte, false) {
          Some(ty) =>
          if queried_ty_has_tuple_key(ty) {
            is_tuple_arg = true
          }
          None => ()
        }
        None => ()
      }
    }
    if is_tuple_arg {
      out.push(CallTupleArg::{ pos: if lbl.length() == 0 { pos_idx } else { -1 }, label: lbl })
    }
    if lbl.length() == 0 {
      pos_idx = pos_idx + 1
    }
    idx_a = idx_a + 1
  }
  out
}

///| True iff `ty` is a direct tuple `(A, B, ...)` or an `OrderedMap[K, V]` / `OrderedSet[K]`
///| whose FIRST type argument (key `K`) is a tuple `(A, B, ...)` — never fooled by tuple values `OrderedMap[String, (Int, Int)]`.
fn queried_ty_has_tuple_key(ty : String) -> Bool {
  let t = ty.trim()
  if t.starts_with("(") && t.ends_with(")") && str_has(t, ",") {
    return true
  }
  let mut rest = ""
  let mut is_map = false
  let om_idx = t.index_of("OrderedMap[")
  let os_idx = t.index_of("OrderedSet[")
  if om_idx >= 0 && t.ends_with("]") {
    rest = t.slice(om_idx + 11, t.length() - 1)
    is_map = true
  } else if os_idx >= 0 && t.ends_with("]") {
    rest = t.slice(os_idx + 11, t.length() - 1)
  } else {
    return false
  }
  let key_ty = if !is_map {
    rest.trim()
  } else {
    let mut d = 0
    let mut comma = -1
    let mut i = 0
    while i < rest.length() {
      let c = rest.code_unit_at(i)
      if c == 40 || c == 91 || c == 123 { d = d + 1 }
      else if c == 41 || c == 93 || c == 125 { if d > 0 { d = d - 1 } }
      else if d == 0 && c == 44 { comma = i; break }
      i = i + 1
    }
    if comma <= 0 { "" } else { rest.slice(0, comma).trim() }
  }
  key_ty.starts_with("(") && key_ty.ends_with(")") && str_has(key_ty, ",")
}

///| True iff `pty` is `OrderedMap[tp, V]` (with `tp` NOT appearing in `V`) or `OrderedSet[tp]`.
fn type_is_ordered_collection_keyed_by(pty : String, tp : String) -> Bool {
  let t = pty.trim()
  let mut rest = ""
  let mut is_map = false
  if t.starts_with("mbt_compat::OrderedMap[") && t.ends_with("]") {
    rest = t.slice(23, t.length() - 1)
    is_map = true
  } else if t.starts_with("OrderedMap[") && t.ends_with("]") {
    rest = t.slice(11, t.length() - 1)
    is_map = true
  } else if t.starts_with("mbt_compat::OrderedSet[") && t.ends_with("]") {
    rest = t.slice(23, t.length() - 1)
  } else if t.starts_with("OrderedSet[") && t.ends_with("]") {
    rest = t.slice(11, t.length() - 1)
  } else {
    return false
  }
  if !is_map {
    return rest.trim() == tp
  }
  // Split `K, V` at depth 0
  let mut d = 0
  let mut comma = -1
  let mut i = 0
  while i < rest.length() {
    let c = rest.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 { d = d + 1 }
    else if c == 41 || c == 93 || c == 125 { if d > 0 { d = d - 1 } }
    else if d == 0 && c == 44 { comma = i; break }
    i = i + 1
  }
  if comma <= 0 {
    return false
  }
  let k_ty = rest.slice(0, comma).trim()
  let v_ty = rest.slice(comma + 1, rest.length()).trim()
  k_ty == tp && !type_mentions_ident(v_ty, tp)
}

///| Strip redundant `mbt_compat::MbtHash` / `mbt_compat::MapKey` bounds from a single generic param string
///| (e.g. `K : mbt_compat::MbtHash + Eq + mbt_compat::MapKey` -> `K : Eq`, or `K : mbt_compat::MapKey` -> `K`).
fn strip_hash_mapkey_bounds_from_param(param : String) -> String {
  let cidx = param.index_of(":")
  if cidx < 0 {
    return param.trim()
  }
  let lhs = param.slice(0, cidx).trim()
  let rhs = param.slice(cidx + 1, param.length()).trim()
  let parts = rhs.split("+")
  let kept : Array[String] = []
  for p in parts {
    let pt = p.trim()
    if pt.length() > 0 && pt != "mbt_compat::MbtHash" && pt != "mbt_compat::MapKey" &&
    pt != "MbtHash" && pt != "MapKey" {
      kept.push(pt)
    }
  }
  if kept.length() == 0 {
    lhs
  } else {
    lhs + " : " + kept.join(" + ")
  }
}

///| Extract the bare generic parameter name before `:` from `K : Bound1 + Bound2`.
fn generic_param_name_of(param : String) -> String {
  let cidx = param.index_of(":")
  if cidx < 0 { param.trim() } else { param.slice(0, cidx).trim() }
}

///| True iff `ty_str` contains identifier `ident` as a whole word.
fn type_mentions_ident(ty_str : String, ident : String) -> Bool {
  let n = ty_str.length()
  let m = ident.length()
  if m == 0 || m > n {
    return false
  }
  let mut i = 0
  while i + m <= n {
    if ty_str.slice(i, i + m) == ident {
      let left_ok = i == 0 || !is_alnum(ty_str.code_unit_at(i - 1))
      let right_ok = i + m == n || !is_alnum(ty_str.code_unit_at(i + m))
      if left_ok && right_ok {
        return true
      }
    }
    i = i + 1
  }
  false
}

///| Recursively scan `toks[s_idx .. e_idx)` (including `InterpString` / `InterpMultiline` `\{...}` holes)
///| for hash-collection ctors, `.hash()` / `Hash::hash` / `mbt_hash`, or calls to bounded local fns/methods.
fn body_tokens_block_bound_relax(
  toks : Array[Token],
  s_idx : Int,
  e_idx : Int,
  fn_name : String,
  all_bounded_fns : Map[String, Bool],
  all_bounded_methods : Map[String, Bool],
) -> Bool {
  let mut ti = s_idx
  while ti < e_idx {
    let tk = toks[ti]
    let r = tk.raw
    if tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline {
      for hole in extract_interp_holes_with_pos(r, 1, 1) {
        let htoks = lex_moonbit(hole.0)
        if body_tokens_block_bound_relax(htoks, 0, htoks.length() - 1, fn_name, all_bounded_fns, all_bounded_methods) {
          return true
        }
      }
      ti = ti + 1
      continue
    }
    if r == "ordered_map_new" || r == "ordered_map_new_cap" ||
    r == "ordered_map_from_array" || r == "ordered_map_from_array_cap" ||
    r == "ordered_map_from_iter" || r == "ordered_set_new" ||
    r == "ordered_set_from_array" || r == "ordered_set_from_iter" ||
    r == "hash_combine" || r == "key_hash" || r == "key_eq" || r == "mbt_hash" {
      return true
    }
    if (r == "OrderedMap" || r == "OrderedSet") && ti + 2 < e_idx &&
    toks[ti + 1].kind == TokenKind::ColonColon {
      let m = toks[ti + 2].raw
      if m == "new" || m == "new_cap" || m == "from_array" || m == "from_iter" {
        return true
      }
    }
    // Reject any `.hash(` or `Hash::hash` in body
    if tk.kind == TokenKind::Dot && ti + 2 < e_idx &&
    toks[ti + 2].kind == TokenKind::LParen {
      let dm = toks[ti + 1].raw
      if dm == "hash" || dm == "hash_combine" || dm == "key_hash" || dm == "key_eq" ||
      dm == "mbt_hash" || all_bounded_methods.contains(dm) {
        return true
      }
    }
    if r == "Hash" && ti + 2 < e_idx && toks[ti + 1].kind == TokenKind::ColonColon &&
    toks[ti + 2].raw == "hash" {
      return true
    }
    // Transitive call to another local `MbtHash`/`MapKey`-bounded free fn or `Type::method`
    if tk.kind == TokenKind::Ident && r != fn_name && all_bounded_fns.contains(r) &&
    ti + 1 < e_idx && toks[ti + 1].kind == TokenKind::LParen &&
    !(ti > s_idx && toks[ti - 1].kind == TokenKind::Dot) {
      return true
    }
    if tk.kind == TokenKind::UpperIdent && ti + 3 < e_idx &&
    toks[ti + 1].kind == TokenKind::ColonColon && toks[ti + 2].kind == TokenKind::Ident &&
    toks[ti + 3].kind == TokenKind::LParen {
      let qual = r + "::" + toks[ti + 2].raw
      if qual != fn_name && all_bounded_fns.contains(qual) {
        return true
      }
    }
    ti = ti + 1
  }
  false
}

///| Relax redundant `mbt_compat::MbtHash` / `mbt_compat::MapKey` bounds strictly for local generic
///| functions whose matched type parameter `tp` appears ONLY as the key type of `OrderedMap[tp, ...]`
///| or `OrderedSet[tp]` (never as a bare value parameter), matched by exact named label or positional-only index,
///| and whose body (including interpolation holes) never constructs a hash collection, hashes keys, or calls another bounded local fn/method.
fn relax_redundant_fn_tuple_bounds(
  files : Array[GeneratedFile],
  pkg_fns : Map[String, StageBPkgFn],
  reqs : Array[BoundRelaxReq],
) -> (Array[GeneratedFile], Array[String]) {
  if reqs.length() == 0 {
    return (files, [])
  }
  let all_bounded_fns : Map[String, Bool] = Map()
  let all_bounded_methods : Map[String, Bool] = Map()
  let fn_bounded_tps : Map[String, Array[String]] = Map()
  let fn_param_pairs : Map[String, Array[(String, String, Bool)]] = Map()
  for f in files {
    let toks = lex_moonbit(f.content)
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let tk = toks[i]
      if tk.kind == TokenKind::LBrace { depth = depth + 1 }
      else if tk.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 } }
      else if depth == 0 && tk.kind == TokenKind::Keyword && tk.raw == "fn" {
        let mut ni = i + 1
        let mut gen_lb = -1
        let mut gen_rb = -1
        if ni < n && toks[ni].kind == TokenKind::LBracket {
          gen_lb = ni
          gen_rb = find_matching_delim(toks, ni)
          ni = gen_rb + 1
        }
        let mut fname = ""
        let mut short_m = ""
        let mut after_name = ni + 1
        if ni < n && toks[ni].kind == TokenKind::Ident {
          fname = toks[ni].raw
        } else if ni + 2 < n && toks[ni].kind == TokenKind::UpperIdent &&
        toks[ni + 1].kind == TokenKind::ColonColon && toks[ni + 2].kind == TokenKind::Ident {
          fname = toks[ni].raw + "::" + toks[ni + 2].raw
          short_m = toks[ni + 2].raw
          after_name = ni + 3
        }
        if gen_lb < 0 && after_name < n && toks[after_name].kind == TokenKind::LBracket {
          gen_lb = after_name
          gen_rb = find_matching_delim(toks, after_name)
          after_name = gen_rb + 1
        }
        if fname.length() > 0 && gen_lb >= 0 && gen_rb > gen_lb {
          let inner = f.content.slice(toks[gen_lb].end_byte, toks[gen_rb].start_byte)
          if str_has(inner, "MbtHash") || str_has(inner, "MapKey") {
            all_bounded_fns[fname] = true
            if short_m.length() > 0 {
              all_bounded_methods[short_m] = true
            }
            let btps : Array[String] = []
            for p in inner.split(",") {
              if str_has(p, "MbtHash") || str_has(p, "MapKey") {
                btps.push(generic_param_name_of(p))
              }
            }
            fn_bounded_tps[fname] = btps
            if after_name < n && toks[after_name].kind == TokenKind::LParen {
              let cp = find_matching_delim(toks, after_name)
              let pairs : Array[(String, String, Bool)] = []
              let mut pi = after_name + 1
              let mut pd = 0
              let mut seg_s = pi
              while pi <= cp {
                let is_end = pi == cp || (pd == 0 && toks[pi].kind == TokenKind::Comma)
                if !is_end {
                  let pk = toks[pi].kind
                  if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
                  else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
                } else {
                  if seg_s < pi {
                    let seg_str = f.content.slice(toks[seg_s].start_byte, toks[pi - 1].end_byte).trim()
                    let cpos = seg_str.index_of(":")
                    if cpos > 0 {
                      let pn = seg_str.slice(0, cpos).trim()
                      let is_lbl = pn.ends_with("~")
                      let pn_clean = if is_lbl { pn.slice(0, pn.length() - 1).trim() } else { pn }
                      let pt = seg_str.slice(cpos + 1, seg_str.length()).trim()
                      pairs.push((pn_clean, pt, is_lbl))
                    }
                  }
                  seg_s = pi + 1
                }
                pi = pi + 1
              }
              fn_param_pairs[fname] = pairs
            }
          }
        }
      }
      i = i + 1
    }
  }

  let safe_fn_tps : Map[String, Map[String, Bool]] = Map()
  for req in reqs {
    let fn_name = req.fn_name
    let btps = match fn_bounded_tps.get(fn_name) {
      Some(xs) => xs
      None => continue
    }
    let pfn = match pkg_fns.get(fn_name) {
      Some(p) => p
      None => continue
    }
    let ppairs = match fn_param_pairs.get(fn_name) {
      Some(ps) => ps
      None => []
    }
    let pos_params : Array[(String, String)] = []
    for pp in ppairs {
      if !pp.2 {
        pos_params.push((pp.0, pp.1))
      }
    }
    // 1. Strictly match call-site tuple args by exact named label or positional-only index (skipping labeled `a~` params).
    let cand_tps : Map[String, Bool] = Map()
    for ta in req.tuple_args {
      if ta.label.length() > 0 {
        for pp in ppairs {
          if pp.0 == ta.label {
            for tp in btps {
              if type_mentions_ident(pp.1, tp) {
                cand_tps[tp] = true
              }
            }
          }
        }
      } else if ta.pos >= 0 && ta.pos < pos_params.length() {
        let pty = pos_params[ta.pos].1
        for tp in btps {
          if type_mentions_ident(pty, tp) {
            cand_tps[tp] = true
          }
        }
      }
    }
    if cand_tps.length() == 0 {
      continue
    }
    // 2. Scan body (including `InterpString` / `InterpMultiline` holes) for hash ctors, `.hash()` / `Hash::hash`, or bounded calls.
    if body_tokens_block_bound_relax(pfn.tokens, pfn.body_s, pfn.body_e, fn_name, all_bounded_fns, all_bounded_methods) {
      continue
    }
    // 3. Strictly allow relaxing `tp` ONLY when `tp` appears exclusively as the key type of
    //    `OrderedMap[tp, ...]` or `OrderedSet[tp]` in the function signature (never a bare `k : tp`).
    let approved : Map[String, Bool] = match safe_fn_tps.get(fn_name) {
      Some(m) => m
      None => Map()
    }
    for tp in cand_tps.keys() {
      let mut saw_ordered_key = false
      let mut only_ordered_key = true
      for pp in ppairs {
        if type_mentions_ident(pp.1, tp) {
          if type_is_ordered_collection_keyed_by(pp.1, tp) {
            saw_ordered_key = true
          } else {
            only_ordered_key = false
            break
          }
        }
      }
      if saw_ordered_key && only_ordered_key {
        approved[tp] = true
      }
    }
    if approved.length() > 0 {
      safe_fn_tps[fn_name] = approved
    }
  }
  if safe_fn_tps.length() == 0 {
    return (files, [])
  }
  let out_files : Array[GeneratedFile] = []
  let changed_rels : Array[String] = []
  for f in files {
    let toks = lex_moonbit(f.content)
    let n = toks.length() - 1
    let edits : Array[(Int, Int, String)] = []
    let mut i = 0
    let mut depth = 0
    while i < n {
      let tk = toks[i]
      if tk.kind == TokenKind::LBrace {
        depth = depth + 1
      } else if tk.kind == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
      } else if depth == 0 && tk.kind == TokenKind::Keyword && tk.raw == "fn" {
        let mut ni = i + 1
        let mut gen_lb = -1
        let mut gen_rb = -1
        if ni < n && toks[ni].kind == TokenKind::LBracket {
          gen_lb = ni
          gen_rb = find_matching_delim(toks, ni)
          ni = gen_rb + 1
        }
        let mut fname = ""
        let mut after_name = ni + 1
        if ni < n && toks[ni].kind == TokenKind::Ident {
          fname = toks[ni].raw
        } else if ni + 2 < n && toks[ni].kind == TokenKind::UpperIdent &&
        toks[ni + 1].kind == TokenKind::ColonColon && toks[ni + 2].kind == TokenKind::Ident {
          fname = toks[ni].raw + "::" + toks[ni + 2].raw
          after_name = ni + 3
        }
        if gen_lb < 0 && after_name < n && toks[after_name].kind == TokenKind::LBracket {
          gen_lb = after_name
          gen_rb = find_matching_delim(toks, after_name)
        }
        if fname.length() > 0 && gen_lb >= 0 && gen_rb > gen_lb {
          match safe_fn_tps.get(fname) {
            Some(target_tps) => {
              let inner = f.content.slice(toks[gen_lb].end_byte, toks[gen_rb].start_byte)
              if str_has(inner, "MbtHash") || str_has(inner, "MapKey") {
                let parts = inner.split(",")
                let new_parts : Array[String] = []
                for p in parts {
                  let pname = generic_param_name_of(p)
                  if target_tps.contains(pname) {
                    new_parts.push(strip_hash_mapkey_bounds_from_param(p))
                  } else {
                    new_parts.push(p.trim())
                  }
                }
                let new_inner = new_parts.join(", ")
                if new_inner != inner {
                  edits.push((toks[gen_lb].end_byte, toks[gen_rb].start_byte, new_inner))
                }
              }
            }
            None => ()
          }
        }
      }
      i = i + 1
    }
    if edits.length() > 0 {
      let sb = StringBuilder()
      let mut last = 0
      for ed in edits {
        sb.write_string(f.content.slice(last, ed.0))
        sb.write_string(ed.2)
        last = ed.1
      }
      sb.write_string(f.content.slice(last, f.content.length()))
      out_files.push(GeneratedFile::{
        rel_path: f.rel_path,
        content: sb.to_string(),
        source_file: f.source_file,
        anchors: f.anchors,
      })
      changed_rels.push(f.rel_path)
    } else {
      out_files.push(f)
    }
  }
  (out_files, changed_rels)
}

///| Rewrite a missing method call at `(lidx, col)` -> `helper(recv, args)` using a cached
///| `MethodRewriteIndex` (O(1) per call instead of re-lexing the file).
///| Skips rewriting (returning `(-1, -1)`) if any line in `[recv_start_line ..= close_end_line]`
///| was already mutated earlier in the same Stage B round.
fn rewrite_method_call_with_index(
  idx : MethodRewriteIndex,
  lines : Array[String],
  mutated_lines : Map[Int, Bool],
  lidx : Int,
  col : Int,
  method_name : String,
  helper : String,
) -> (Int, Int) {
  if lidx < 0 || lidx >= lines.length() || lidx >= idx.line_first_tok.length() {
    return (-1, -1)
  }
  let src = idx.src
  let line_start_b = idx.line_starts[lidx]
  let line_end_b = if lidx + 1 < idx.line_starts.length() {
    idx.line_starts[lidx + 1] - 1
  } else {
    src.length()
  }
  let raw_target_b = line_start_b + (if col > 0 { col - 1 } else { 0 })
  let target_b = if raw_target_b > line_end_b { line_end_b } else { raw_target_b }
  // If `target_b` falls strictly inside a `TokenKind::InterpString`, dispatch ONLY to that interpolation
  // string (never touching outside tokens on the same line); otherwise NEVER fall back to an unrelated interp.
  let interp_ti = find_covering_interp_token(idx, lidx, target_b)
  if interp_ti >= 0 {
    return rewrite_method_call_in_interp_string_tok(idx, lines, mutated_lines, lidx, col, interp_ti, method_name, helper)
  }
  let start_ti = idx.line_first_tok[lidx]
  if start_ti < 0 {
    return (-1, -1)
  }
  let tokens = idx.tokens
  let n_tok = tokens.length()
  let target_line = lidx + 1
  let mut dot_ti = -1
  let mut best_dist = 1000000
  let mut ti = start_ti
  while ti + 2 < n_tok && tokens[ti].line == target_line {
    if tokens[ti].kind == TokenKind::Dot &&
    tokens[ti + 1].raw == method_name && tokens[ti + 2].kind == TokenKind::LParen {
      let d1 = if tokens[ti].col >= col { tokens[ti].col - col } else { col - tokens[ti].col }
      let d2 = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      let dist = if d1 < d2 { d1 } else { d2 }
      if dist < best_dist {
        best_dist = dist
        dot_ti = ti
      }
    }
    ti = ti + 1
  }
  if dot_ti < 0 {
    return (-1, -1)
  }
  let lp_ti = dot_ti + 2
  let rp_ti = find_matching_delim(tokens, lp_ti)
  if rp_ti <= lp_ti || rp_ti >= n_tok || tokens[rp_ti].kind != TokenKind::RParen {
    return (-1, -1)
  }
  let recv_start_ti = find_receiver_start_token(tokens, dot_ti)
  if recv_start_ti < 0 || recv_start_ti >= dot_ti {
    return (-1, -1)
  }
  let recv_start_line = tokens[recv_start_ti].line - 1
  let close_end_line = tokens[rp_ti].line - 1
  if recv_start_line < 0 || close_end_line < recv_start_line || close_end_line >= lines.length() {
    return (-1, -1)
  }
  // Never overlap an already-mutated line in the same Stage B round (deferred cleanly to next round).
  let mut chk_l = recv_start_line
  while chk_l <= close_end_line {
    if mutated_lines.contains(chk_l) {
      return (-1, -1)
    }
    chk_l = chk_l + 1
  }
  let recv_end_ti = dot_ti - 1
  let recv_code = src.slice(tokens[recv_start_ti].start_byte, tokens[recv_end_ti].end_byte)

  // Split top-level arguments inside `(lp_ti + 1 .. rp_ti)` by depth-0 Comma tokens.
  let arg_spans : Array[(Int, Int)] = []
  let mut depth = 0
  let mut seg_start = lp_ti + 1
  let mut ai = lp_ti + 1
  while ai < rp_ti {
    match tokens[ai].kind {
      TokenKind::LParen | TokenKind::LBracket | TokenKind::LBrace => depth = depth + 1
      TokenKind::RParen | TokenKind::RBracket | TokenKind::RBrace =>
      if depth > 0 { depth = depth - 1 }
      TokenKind::Comma =>
      if depth == 0 {
        if seg_start < ai {
          arg_spans.push((seg_start, ai - 1))
        }
        seg_start = ai + 1
      }
      _ => ()
    }
    ai = ai + 1
  }
  if seg_start < rp_ti {
    arg_spans.push((seg_start, rp_ti - 1))
  }
  let (eff_helper, args) = normalize_helper_args_tokens(src, tokens, arg_spans, helper)

  let first_line_start_b = idx.line_starts[recv_start_line]
  let last_line_end_b = if close_end_line + 1 < idx.line_starts.length() {
    idx.line_starts[close_end_line + 1] - 1
  } else {
    src.length()
  }
  let prefix = src.slice(first_line_start_b, tokens[recv_start_ti].start_byte)
  let suffix = src.slice(tokens[rp_ti].end_byte, last_line_end_b)
  let call = if args.length() > 0 {
    eff_helper + "(" + recv_code + ", " + args + ")"
  } else {
    eff_helper + "(" + recv_code + ")"
  }
  let replacement = prefix + call + suffix
  let rep_lines = replacement.split("\n")
  let orig_span = close_end_line - recv_start_line + 1

  // If `suffix` is empty and the next non-empty line starts with `.` (chained call), align the
  // replacement to the bottom of `[recv_start_line ..= close_end_line]` so no blank line separates
  // the rewritten expression from the following `.method(...)`.
  let mut chain_follows = false
  if suffix.trim().length() == 0 {
    let mut nxt = close_end_line + 1
    while nxt < lines.length() {
      let nt = lines[nxt].trim()
      if nt.length() > 0 {
        chain_follows = nt.starts_with(".")
        break
      }
      nxt = nxt + 1
    }
  }

  let mut cl = recv_start_line
  while cl <= close_end_line {
    lines[cl] = ""
    cl = cl + 1
  }
  if rep_lines.length() <= orig_span {
    let base_l = if chain_follows {
      close_end_line - rep_lines.length() + 1
    } else {
      recv_start_line
    }
    let mut ri = 0
    while ri < rep_lines.length() {
      lines[base_l + ri] = rep_lines[ri]
      ri = ri + 1
    }
  } else {
    let target = if chain_follows { close_end_line } else { recv_start_line }
    lines[target] = replacement
  }
  mark_mutated_span(mutated_lines, recv_start_line, close_end_line)
  (recv_start_line, close_end_line)
}

///| Standalone boolean wrapper for unit tests (lexes `lines` once).
fn rewrite_method_call_at(
  lines : Array[String],
  lidx : Int,
  col : Int,
  method_name : String,
  helper : String,
) -> Bool {
  let src = lines.join("\n")
  let tokens = lex_moonbit(src)
  let idx = build_method_rewrite_index(src, tokens, lines.length())
  let empty_mut : Map[Int, Bool] = Map()
  let (s, _e) = rewrite_method_call_with_index(idx, lines, empty_mut, lidx, col, method_name, helper)
  s >= 0
}

///| True iff the trimmed argument `piece` is a labelled / punned argument (`x=v`, `x?=v`, `x~`).
fn unsafe_index_arg_is_labelled(piece : String) -> Bool {
  let t = piece.trim()
  if t.length() == 0 {
    return false
  }
  if t.code_unit_at(t.length() - 1) == 126 {
    return true
  }
  if !is_alpha(t.code_unit_at(0)) {
    return false
  }
  let mut k = 1
  while k < t.length() && is_alnum(t.code_unit_at(k)) {
    k = k + 1
  }
  while k < t.length() && (t.code_unit_at(k) == 32 || t.code_unit_at(k) == 9) {
    k = k + 1
  }
  if k < t.length() && t.code_unit_at(k) == 63 {
    k = k + 1
  }
  k < t.length() && t.code_unit_at(k) == 61 && !(k + 1 < t.length() && t.code_unit_at(k + 1) == 61)
}

///| Wave M2-F3e: lower `Array[T]` / `FixedArray[T]` `recv.unsafe_get(i)` to native `recv[i]` and
///| `recv.unsafe_set(i, v)` to `{ recv[i] = v }` instead of a cross-package generic helper call.
///| Pion evaluates `recv`, then `i`, then `v` (left to right) for both `recv[i]` and `recv[i] = v`, accepts
///| any receiver expression (`get_arr()[i] = v`), and a `{ ... }` block is valid in statement and expression
///| position, so this preserves MoonBit semantics exactly. Fails closed (returns `-1`; the caller falls back
///| to the `mbt_compat` helper) on anything else: a receiver not wholly on the diagnostic line, a wrong
///| positional argument count, labelled arguments, `/*` or multi-line strings inside the argument list.
///| `//` line comments inside the arguments are kept, each commented argument ending with a newline.
///| Returns the last source line the rewritten call spanned.
fn rewrite_unsafe_index_at(lines : Array[String], lidx : Int, col : Int, method_name : String) -> Int {
  let want_args = if method_name == "unsafe_get" { 1 } else if method_name == "unsafe_set" { 2 } else { 0 }
  if want_args == 0 {
    return -1
  }
  let line_text = lines[lidx]
  let dot_idx = find_method_dot_at_col(line_text, method_name, col)
  if dot_idx < 0 {
    return -1
  }
  // 1. Argument list up to the matching `)` (may span lines), split at depth-0 commas.
  let pieces : Array[String] = []
  let commented : Array[Bool] = []
  let mut cur = ""
  let mut cur_comment = false
  let mut depth = 0
  let mut in_c = false
  let mut esc = false
  let mut end_l = lidx
  let mut j = dot_idx + method_name.length() + 2
  let mut seg_start = j
  let mut close_j = -1
  while end_l < lines.length() {
    let ln = lines[end_l]
    while j < ln.length() {
      let c = ln.code_unit_at(j)
      if in_c {
        if esc {
          esc = false
        } else if c == 92 {
          esc = true
        } else if c == 39 {
          in_c = false
        }
      } else if c == 34 {
        // A whole literal, interpolations included; one that does not close on this line fails closed.
        let k = skip_string_lit(ln, j)
        if k < 0 {
          return -1
        }
        j = k
      } else if c == 39 {
        in_c = true
      } else if c == 47 && j + 1 < ln.length() && ln.code_unit_at(j + 1) == 42 {
        return -1
      } else if c == 47 && j + 1 < ln.length() && ln.code_unit_at(j + 1) == 47 {
        cur_comment = true
        j = ln.length()
        break
      } else if c == 35 && j + 1 < ln.length() && ln.code_unit_at(j + 1) == 124 {
        return -1
      } else if c == 40 || c == 91 || c == 123 {
        depth = depth + 1
      } else if c == 41 || c == 93 || c == 125 {
        if depth == 0 {
          if c != 41 {
            return -1
          }
          close_j = j
          break
        }
        depth = depth - 1
      } else if c == 44 && depth == 0 {
        pieces.push(cur + ln.slice(seg_start, j))
        commented.push(cur_comment)
        cur = ""
        cur_comment = false
        seg_start = j + 1
      }
      j = j + 1
    }
    if close_j >= 0 {
      break
    }
    if in_c {
      return -1
    }
    cur = cur + ln.slice(seg_start, ln.length()) + "\n"
    end_l = end_l + 1
    j = 0
    seg_start = 0
  }
  if close_j < 0 {
    return -1
  }
  pieces.push(cur + lines[end_l].slice(seg_start, close_j))
  commented.push(cur_comment)
  if pieces.length() > 1 && pieces[pieces.length() - 1].trim().length() == 0 {
    let _ = pieces.pop()
    let _ = commented.pop()
  }
  if pieces.length() != want_args {
    return -1
  }
  let args : Array[String] = []
  let mut ai = 0
  while ai < pieces.length() {
    // Label check on the code lines only (a whole-line `//` comment may precede `name=`).
    let mut code = ""
    for pl in pieces[ai].split("\n") {
      if !pl.trim().starts_with("//") {
        code = code + pl + "\n"
      }
    }
    if code.trim().length() == 0 || unsafe_index_arg_is_labelled(code) {
      return -1
    }
    // A commented argument keeps a trailing newline so the comment never swallows `]` / `}`.
    args.push(if commented[ai] { pieces[ai].trim() + "\n" } else { pieces[ai].trim() })
    ai = ai + 1
  }
  // 2. Receiver: a postfix expression ending at `dot_idx`, wholly on line `lidx`.
  let mut rs = dot_idx - 1
  let mut paren_d = 0
  let mut brack_d = 0
  while rs >= 0 {
    let c = line_text.code_unit_at(rs)
    if c == 41 {
      paren_d = paren_d + 1
    } else if c == 40 {
      if paren_d == 0 {
        break
      }
      paren_d = paren_d - 1
    } else if c == 93 {
      brack_d = brack_d + 1
    } else if c == 91 {
      if brack_d == 0 {
        break
      }
      brack_d = brack_d - 1
    } else if paren_d > 0 || brack_d > 0 {
      if c == 34 || c == 39 {
        return -1
      }
    } else if c == 58 {
      // Only a path separator `::` belongs to the receiver; a lone `:` (`{key:a.unsafe_get(0)}`) ends it.
      if !(rs > 0 && line_text.code_unit_at(rs - 1) == 58) {
        break
      }
      rs = rs - 1
    } else if !(is_alnum(c) || c == 46) {
      break
    }
    rs = rs - 1
  }
  if paren_d != 0 || brack_d != 0 {
    return -1
  }
  rs = rs + 1
  if rs >= dot_idx {
    return -1
  }
  let recv = line_text.slice(rs, dot_idx)
  let rc0 = recv.code_unit_at(0)
  if !(is_alpha(rc0) || rc0 == 40 || rc0 == 91) || recv.code_unit_at(recv.length() - 1) == 58 {
    return -1
  }
  let repl = if want_args == 1 {
    recv + "[" + args[0] + "]"
  } else {
    "{ " + recv + "[" + args[0] + "] = " + args[1] + " }"
  }
  let last = lines[end_l]
  lines[lidx] = line_text.slice(0, rs) + repl + last.slice(close_j + 1, last.length())
  let mut bl = lidx + 1
  while bl <= end_l {
    lines[bl] = ""
    bl = bl + 1
  }
  end_l
}

///| Extract the argument value for a labeled argument `name=<val>` in a call line.
fn extract_labeled_arg(ln : String, name : String) -> Option[(Int, Int, String)] {
  let lbl = name + "="
  let li = ln.index_of(lbl)
  if li < 0 {
    return None
  }
  let val_start = li + lbl.length()
  let mut val_end = val_start
  let mut depth = 0
  while val_end < ln.length() {
    let c = ln.code_unit_at(val_end)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      if depth == 0 {
        break
      }
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      break
    }
    val_end = val_end + 1
  }
  Some((val_start, val_end, ln.slice(val_start, val_end).trim()))
}

///| Check whether `expr` is a pure simple identifier or string literal (safe to duplicate without side effects).
fn is_pure_str_atom(expr : String) -> Bool {
  let t = expr.trim()
  if t.length() == 0 {
    return true
  }
  if t.starts_with("\"") && t.ends_with("\"") {
    return true
  }
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    if !(is_alnum(c) || c == 95) {
      return false
    }
    i = i + 1
  }
  true
}

///| Token-based `api_map.json` boundary conversion (Astra P0-5):
///| - Uses `lex_moonbit` so string literals (e.g. `"acme::caret(text=s, offset=1)"`) are NEVER modified!
///| - Evaluates ALL arguments strictly left-to-right into hygienic temp bindings before calling,
///|   so `caret(offset=off(), text=txt())` preserves `off()` -> `txt()` order and evaluates each arg ONCE!
///| - Handles nested calls and multiple calls on the same line.
///| - Hard-fails (`MBT2PION_MISSING_STR_PARAM`) when `utf8`/`scalar` conversion lacks `str_param`.
pub fn apply_api_boundary_conversions(
  content : String,
  api_map : ApiMap,
  file : String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> String {
  if api_map.symbols.length() == 0 {
    return content
  }
  let mut cur = content
  let mut tmp_seq = 0
  for sym in api_map.symbols {
    let mut needs_conv = false
    for p in sym.params {
      if p.unit == "utf8" || p.unit == "scalar" ||
      p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
        needs_conv = true
      }
    }
    if !needs_conv {
      continue
    }
    let call_name = if sym.target_pkg.length() > 0 {
      sym.target_pkg + "::" + sym.target_name
    } else {
      sym.target_name
    }
    // Iterate up to 4 passes to support nested calls of the same symbol bottom-up
    let mut pass = 0
    while pass < 4 {
      let toks = lex_moonbit(cur)
      let n = toks.length() - 1
      let edits : Array[(Int, Int, String)] = []
      let mut covered_end = 0
      let mut i = 0
      while i < n {
        if toks[i].start_byte < covered_end {
          i = i + 1
          continue
        }
        let mut call_start_tok = -1
        let mut open_p = -1
        if sym.target_pkg.length() > 0 {
          if i + 3 < n && toks[i].kind == TokenKind::Ident && toks[i].raw == sym.target_pkg &&
          toks[i + 1].kind == TokenKind::ColonColon &&
          toks[i + 2].kind == TokenKind::Ident && toks[i + 2].raw == sym.target_name &&
          toks[i + 3].kind == TokenKind::LParen {
            call_start_tok = i
            open_p = i + 3
          }
        } else {
          let prev_dot_cc = i > 0 && (toks[i - 1].kind == TokenKind::Dot || toks[i - 1].kind == TokenKind::ColonColon)
          if !prev_dot_cc && i + 1 < n && toks[i].kind == TokenKind::Ident && toks[i].raw == sym.target_name &&
          toks[i + 1].kind == TokenKind::LParen {
            call_start_tok = i
            open_p = i + 1
          }
        }
        if call_start_tok < 0 {
          i = i + 1
          continue
        }
        let close_p = find_matching_delim(toks, open_p)
        // Parse depth-0 arguments `(label, val_expr)`
        let arg_labels : Array[String] = []
        let arg_vals : Array[String] = []
        let mut ai = open_p + 1
        while ai < close_p {
          if toks[ai].kind == TokenKind::Comma {
            ai = ai + 1
            continue
          }
          let mut ae = ai
          let mut ad = 0
          while ae < close_p {
            let ak = toks[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace {
              ad = ad + 1
            } else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace {
              ad = ad - 1
            } else if ad == 0 && ak == TokenKind::Comma {
              break
            }
            ae = ae + 1
          }
          if ae > ai {
            if ae - ai >= 3 && toks[ai].kind == TokenKind::Ident && toks[ai + 1].kind == TokenKind::Eq {
              arg_labels.push(toks[ai].raw)
              arg_vals.push(cur.slice(toks[ai + 2].start_byte, toks[ae - 1].end_byte).trim())
            } else {
              arg_labels.push("")
              arg_vals.push(cur.slice(toks[ai].start_byte, toks[ae - 1].end_byte).trim())
            }
          }
          ai = ae + 1
        }

        // Astra Round 3 P0-4: Bind BOTH named and positional arguments to `sym.params` in signature order!
        let bound_params : Array[String] = []
        let used_param : Map[String, Bool] = Map()
        for lbl in arg_labels {
          if lbl.length() > 0 {
            used_param[lbl] = true
          }
        }
        let mut next_pos_p = 0
        let mut bk = 0
        while bk < arg_labels.length() {
          if arg_labels[bk].length() > 0 {
            bound_params.push(arg_labels[bk])
          } else {
            // Astra Round 4 P0-4: optional/default params (`flag? : T = d`) are label-only in MoonBit
            // and must NEVER consume positional arguments!
            while next_pos_p < sym.params.length() &&
            (used_param.contains(sym.params[next_pos_p].name) ||
              sym.params[next_pos_p].is_optional ||
              sym.params[next_pos_p].has_default) {
              next_pos_p = next_pos_p + 1
            }
            if next_pos_p < sym.params.length() {
              let pname = sym.params[next_pos_p].name
              bound_params.push(pname)
              used_param[pname] = true
              next_pos_p = next_pos_p + 1
            } else {
              bound_params.push("")
            }
          }
          bk = bk + 1
        }

        // Check if any param of this call still needs conversion
        let mut call_needs_edit = false
        for p in sym.params {
          let mut idx_p = -1
          let mut k = 0
          while k < bound_params.length() {
            if bound_params[k] == p.name { idx_p = k; break }
            k = k + 1
          }
          if idx_p < 0 { continue }
          if p.unit == "utf8" || p.unit == "scalar" {
            let helper = if p.unit == "utf8" { "mbt_compat::utf16_to_utf8_off" } else { "mbt_compat::utf16_to_scalar_off" }
            if !str_has(arg_vals[idx_p], helper + "(") {
              if p.str_param.length() == 0 {
                diags.push(diag_error(
                  "MBT2PION_MISSING_STR_PARAM",
                  file,
                  toks[call_start_tok].line,
                  toks[call_start_tok].col,
                  "api_map boundary conversion for `" + call_name + "(" + p.name + ")` requires `str_param` to supply string argument to `" + helper + "(s, off)`",
                ))
              } else {
                // Verify str_param is actually bound at this call site!
                let mut found_sp = false
                let mut sk = 0
                while sk < bound_params.length() {
                  if bound_params[sk] == p.str_param {
                    found_sp = true
                    break
                  }
                  sk = sk + 1
                }
                if !found_sp {
                  diags.push(diag_error(
                    "MBT2PION_MISSING_STR_PARAM",
                    file,
                    toks[call_start_tok].line,
                    toks[call_start_tok].col,
                    "api_map boundary conversion for `" + call_name + "(" + p.name + ")` requires bound string argument `" + p.str_param + "`",
                  ))
                } else {
                  call_needs_edit = true
                }
              }
            }
          } else if p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
            let helper = if p.map_boundary == "ordered_to_map" { "mbt_compat::ordered_map_to_map" } else { "mbt_compat::ordered_map_from_map" }
            if !str_has(arg_vals[idx_p], helper + "(") {
              call_needs_edit = true
            }
          }
        }

        if call_needs_edit {
          // Bind EVERY argument strictly left-to-right in source order into a temp!
          let temps : Array[String] = []
          let mut needs_block = false
          let mut k = 0
          while k < arg_vals.length() {
            if !is_pure_str_atom(arg_vals[k]) {
              needs_block = true
            }
            k = k + 1
          }
          let sb = StringBuilder()
          if needs_block {
            sb.write_string("{ ")
            k = 0
            while k < arg_vals.length() {
              let tname = "__mbt_s_" + tmp_seq.to_string()
              tmp_seq = tmp_seq + 1
              temps.push(tname)
              sb.write_string("let " + tname + " = " + arg_vals[k] + "; ")
              k = k + 1
            }
          } else {
            k = 0
            while k < arg_vals.length() {
              temps.push(arg_vals[k])
              k = k + 1
            }
          }

          // Build converted argument list using temp bindings, matching by `bound_params[k]`
          let final_args : Array[String] = []
          k = 0
          while k < arg_labels.length() {
            let orig_lbl = arg_labels[k]
            let bname = bound_params[k]
            let mut val_expr = temps[k]
            for p in sym.params {
              if p.name == bname {
                if p.unit == "utf8" || p.unit == "scalar" {
                  let helper = if p.unit == "utf8" { "mbt_compat::utf16_to_utf8_off" } else { "mbt_compat::utf16_to_scalar_off" }
                  if p.str_param.length() > 0 && !str_has(arg_vals[k], helper + "(") {
                    let mut str_ref = p.str_param
                    let mut sk = 0
                    while sk < bound_params.length() {
                      if bound_params[sk] == p.str_param {
                        str_ref = temps[sk]
                        break
                      }
                      sk = sk + 1
                    }
                    val_expr = helper + "(" + str_ref + ", " + val_expr + ")"
                    drift_ledger.push(DriftEntry::{
                      category: "string_unit_boundary",
                      file: file,
                      line: toks[call_start_tok].line,
                      col: toks[call_start_tok].col,
                      expr: call_name + "(" + p.name + "=" + arg_vals[k] + ")",
                      resolution: helper,
                      status: "resolved",
                      detail: "converted UTF-16 offset to " + p.unit + " at api_map boundary with string arg `" + str_ref + "`",
                    })
                  }
                } else if p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
                  let helper = if p.map_boundary == "ordered_to_map" { "mbt_compat::ordered_map_to_map" } else { "mbt_compat::ordered_map_from_map" }
                  if !str_has(arg_vals[k], helper + "(") {
                    val_expr = helper + "(" + val_expr + ")"
                    drift_ledger.push(DriftEntry::{
                      category: "ordered_map_boundary",
                      file: file,
                      line: toks[call_start_tok].line,
                      col: toks[call_start_tok].col,
                      expr: call_name + "(" + p.name + "=" + arg_vals[k] + ")",
                      resolution: helper,
                      status: "resolved",
                      detail: "converted map boundary with " + helper,
                    })
                  }
                }
              }
            }
            if orig_lbl.length() > 0 {
              final_args.push(orig_lbl + "=" + val_expr)
            } else {
              final_args.push(val_expr)
            }
            k = k + 1
          }

          sb.write_string(call_name + "(")
          k = 0
          while k < final_args.length() {
            if k > 0 { sb.write_string(", ") }
            sb.write_string(final_args[k])
            k = k + 1
          }
          sb.write_string(")")
          if needs_block {
            sb.write_string(" }")
          }
          let start_b = toks[call_start_tok].start_byte
          let end_b = toks[close_p].end_byte
          edits.push((start_b, end_b, sb.to_string()))
          covered_end = end_b
          i = close_p + 1
          continue
        }
        i = i + 1
      }
      if edits.length() == 0 {
        break
      }
      cur = apply_byte_edits(cur, edits)
      pass = pass + 1
    }
  }
  cur
}

///| Format a coerced `IntLit` token cleanly without 32-bit truncation:
///| - `Int -> Double`: decimal `4294967296` -> `4294967296.0` (never `.to_double()`!)
///| - `Int -> Int64`: `4294967296` -> `4294967296L` (never `.to_int64()`!)
///| - `Int -> Byte`: `0` -> `0.to_byte()`
fn format_coerced_int_lit(tok : Token, suffix_method : String) -> Option[String] {
  let raw = tok.raw
  if suffix_method == "to_double" {
    if raw.starts_with("0x") || raw.starts_with("0X") || raw.starts_with("0b") || raw.starts_with("0B") || raw.starts_with("0o") || raw.starts_with("0O") {
      match parse_int_literal_u64(tok) {
        Some((u, ovf)) => if !ovf { return Some(u.to_string() + ".0") } else { return None }
        None => return None
      }
    }
    // Strip underscores and any integer suffix
    let sb = StringBuilder()
    let mut i = 0
    while i < raw.length() {
      let c = raw.code_unit_at(i)
      if c >= 48 && c <= 57 { sb.write_char(c.unsafe_to_char()) }
      i = i + 1
    }
    let clean = sb.to_string()
    if clean.length() == 0 { return None }
    return Some(clean + ".0")
  }
  if suffix_method == "to_int64" {
    if raw.ends_with("L") || raw.ends_with("l") || raw.ends_with("U") || raw.ends_with("u") {
      return None
    }
    return Some(raw + "L")
  }
  if suffix_method == "to_byte" {
    return Some(raw + ".to_byte()")
  }
  Some(raw + "." + suffix_method + "()")
}

///| Token-precise numeric literal coercion at 1-based column `col` on a single line.
///| Only rewrites `TokenKind::IntLit` (never `Ident` variables!) and never crosses statement boundaries.
pub fn coerce_numeric_token_at_col(ln : String, col : Int, suffix_method : String) -> Option[String] {
  let toks = lex_moonbit(ln)
  let mut i = 0
  while i < toks.length() - 1 {
    let t = toks[i]
    let tok_end_col = t.col + (t.end_byte - t.start_byte)
    if t.kind == TokenKind::IntLit && col >= t.col && col <= tok_end_col {
      if i + 2 < toks.length() - 1 && toks[i + 1].kind == TokenKind::Dot && toks[i + 2].raw == suffix_method {
        return None
      }
      match format_coerced_int_lit(t, suffix_method) {
        Some(repl) => return Some(ln.slice(0, t.start_byte) + repl + ln.slice(t.end_byte, ln.length()))
        None => return None
      }
    }
    i = i + 1
  }
  // Fallback for `let x : Double = 0`, `if x > 0`, `if c { 3 } else { 4 }` where `d.col` points to `let`/`>`/`if`.
  // Strictly stops at statement/clause boundaries (`;`, depth-0 `}`, `&&`, `||`) so sibling expressions are NEVER touched!
  if suffix_method == "to_double" || suffix_method == "to_int64" {
    let mut k = 0
    let mut depth = 0
    while k < toks.length() - 1 {
      let tk = toks[k]
      if tk.col < col {
        k = k + 1
        continue
      }
      if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace {
        depth = depth + 1
        k = k + 1
        continue
      }
      if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace {
        if depth == 0 && tk.kind == TokenKind::RBrace {
          break
        }
        if depth > 0 { depth = depth - 1 }
        k = k + 1
        continue
      }
      if depth == 0 && (tk.kind == TokenKind::Semi || tk.kind == TokenKind::AmpAmp || tk.kind == TokenKind::PipePipe) {
        break
      }
      if tk.kind == TokenKind::IntLit {
        if !(k + 2 < toks.length() - 1 && toks[k + 1].kind == TokenKind::Dot && toks[k + 2].raw == suffix_method) {
          let prev_ok = k > 0 && (toks[k - 1].kind == TokenKind::Eq || toks[k - 1].kind == TokenKind::Lt ||
            toks[k - 1].kind == TokenKind::Gt || toks[k - 1].kind == TokenKind::LtEq ||
            toks[k - 1].kind == TokenKind::GtEq || toks[k - 1].kind == TokenKind::EqEq ||
            toks[k - 1].kind == TokenKind::BangEq || toks[k - 1].kind == TokenKind::Minus ||
            toks[k - 1].kind == TokenKind::Plus || toks[k - 1].kind == TokenKind::Star ||
            toks[k - 1].kind == TokenKind::Slash || toks[k - 1].kind == TokenKind::Comma ||
            toks[k - 1].kind == TokenKind::LParen || toks[k - 1].kind == TokenKind::LBrace ||
            toks[k - 1].kind == TokenKind::FatArrow ||
            (toks[k - 1].kind == TokenKind::Keyword && toks[k - 1].raw == "else"))
          if prev_ok {
            match format_coerced_int_lit(tk, suffix_method) {
              Some(repl) => return Some(ln.slice(0, tk.start_byte) + repl + ln.slice(tk.end_byte, ln.length()))
              None => ()
            }
          }
        }
      }
      k = k + 1
    }
  }
  None
}

///| Collect every identifier occurring anywhere in `content` so Stage B temporary bindings
///| can never shadow or capture a user variable (Round 2 P0-3).
fn collect_used_idents(content : String) -> Map[String, Bool] {
  collect_used_idents_from_tokens(lex_moonbit(content))
}

fn collect_used_idents_from_tokens(toks : Array[Token]) -> Map[String, Bool] {
  let used : Map[String, Bool] = Map()
  let mut i = 0
  while i < toks.length() - 1 {
    if toks[i].kind == TokenKind::Ident {
      used[toks[i].raw] = true
    }
    i = i + 1
  }
  used
}

///| Stage B content-versioned cache toggle (default ON) & perf counters.
///| Counters: [0]=lex_calls, [1]=shrink_pkg_builds, [2]=sort_key_env_builds, [3]=pkg_fns_builds, [4]=rounds.
let stage_b_cache_flag : Array[Bool] = [true]
let stage_b_perf_stats : Array[Int] = [0, 0, 0, 0, 0]

pub fn stage_b_set_cache_enabled(enabled : Bool) -> Unit {
  stage_b_cache_flag[0] = enabled
}

pub fn stage_b_cache_is_enabled() -> Bool {
  stage_b_cache_flag[0]
}

pub fn stage_b_reset_perf_counters() -> Unit {
  stage_b_perf_stats[0] = 0
  stage_b_perf_stats[1] = 0
  stage_b_perf_stats[2] = 0
  stage_b_perf_stats[3] = 0
  stage_b_perf_stats[4] = 0
}

pub fn stage_b_get_perf_counters() -> (Int, Int, Int, Int, Int) {
  (stage_b_perf_stats[0], stage_b_perf_stats[1], stage_b_perf_stats[2], stage_b_perf_stats[3], stage_b_perf_stats[4])
}

///| Fetch tokens for `f_rel`, reusing cross-round content-versioned cache when enabled.
fn stage_b_get_file_tokens(
  round_file_tokens : Map[String, Array[Token]],
  token_cache : Map[String, (Int, Array[Token])],
  file_vers : Map[String, Int],
  f_rel : String,
  content : String,
) -> Array[Token] {
  if stage_b_cache_flag[0] {
    match round_file_tokens.get(f_rel) {
      Some(ts) => return ts
      None => ()
    }
    let ver = match file_vers.get(f_rel) {
      Some(v) => v
      None => 0
    }
    match token_cache.get(f_rel) {
      Some((cver, cts)) =>
      if cver == ver {
        round_file_tokens[f_rel] = cts
        return cts
      }
      None => ()
    }
    stage_b_perf_stats[0] = stage_b_perf_stats[0] + 1
    let ts = lex_moonbit(content)
    round_file_tokens[f_rel] = ts
    token_cache[f_rel] = (ver, ts)
    ts
  } else {
    stage_b_perf_stats[0] = stage_b_perf_stats[0] + 1
    let ts = lex_moonbit(content)
    round_file_tokens[f_rel] = ts
    ts
  }
}

///| Allocate a guaranteed collision-free identifier not present in `used`, then record it.
fn fresh_stage_b_ident(used : Map[String, Bool], base : String) -> String {
  if !used.contains(base) {
    used[base] = true
    return base
  }
  let mut n = 1
  while true {
    let cand = base + "_" + n.to_string()
    if !used.contains(cand) {
      used[cand] = true
      return cand
    }
    n = n + 1
  }
  base
}

///| Hygienic recursive structural equality generator for Stage B (uses `fresh_stage_b_ident`).
fn gen_eq_expr_hygienic(a : String, b : String, ty : String, used : Map[String, Bool]) -> String {
  let t = ty.trim()
  if t == "Bytes" {
    return "mbt_compat::bytes_eq(" + a + ", " + b + ")"
  }
  if t == "MbtJson" || t == "mbt_compat::MbtJson" {
    return "mbt_compat::mbt_json_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("OrderedSet[") || t.starts_with("mbt_compat::OrderedSet[") {
    return "mbt_compat::ordered_set_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let sb = StringBuilder()
      let mut k = 0
      while k < elems.length() {
        if k > 0 { sb.write_string(" && ") }
        let ak = "(" + a + ")." + k.to_string()
        let bk = "(" + b + ")." + k.to_string()
        sb.write_string("(" + gen_eq_expr_hygienic(ak, bk, elems[k], used) + ")")
        k = k + 1
      }
      return sb.to_string()
    }
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let ax = fresh_stage_b_ident(used, "__oa")
    let bx = fresh_stage_b_ident(used, "__ob")
    let inner_eq = gen_eq_expr_hygienic(ax, bx, inner, used)
    return "match (" + a + ", " + b + ") { (Some(" + ax + "), Some(" + bx + ")) => " + inner_eq + ", (None, None) => true, _ => false }"
  }
  if (t.starts_with("Array[") || t.starts_with("FixedArray[")) && t.ends_with("]") {
    let pref_len = if t.starts_with("FixedArray[") { 11 } else { 6 }
    let inner = t.slice(pref_len, t.length() - 1).trim()
    let idx = fresh_stage_b_ident(used, "__ai")
    let eqv = fresh_stage_b_ident(used, "__aeq")
    let elem_eq = gen_eq_expr_hygienic(a + "[" + idx + "]", b + "[" + idx + "]", inner, used)
    return "{ let mut " + eqv + " = " + a + ".length() == " + b + ".length(); if " + eqv + " { let mut " + idx + " = 0; while " + idx + " < " + a + ".length() { if !(" + elem_eq + ") { " + eqv + " = false; break }; " + idx + " = " + idx + " + 1 } }; " + eqv + " }"
  }
  a + " == " + b
}

///| Token-precise rewrite of unsupported static compat calls (`Float::is_nan`, `Float::from_uint`,
///| `Float::reinterpret_from_uint`, `Bytes::make`) at 1-based column `col` on a single line.
fn rewrite_static_compat_call_at(ln : String, col : Int) -> Option[String] {
  let toks = lex_moonbit(ln)
  let tn = toks.length() - 1
  let mut best_i = -1
  let mut best_dist = 1000000
  let mut best_repl = ""
  let mut i = 0
  while i + 3 < tn {
    if toks[i].kind == TokenKind::UpperIdent && toks[i + 1].kind == TokenKind::ColonColon &&
    toks[i + 2].kind == TokenKind::Ident && toks[i + 3].kind == TokenKind::LParen {
      let qual = toks[i].raw
      let mem = toks[i + 2].raw
      let repl = if qual == "Float" && mem == "is_nan" {
        "mbt_compat::float_is_nan"
      } else if qual == "Float" && mem == "from_uint" {
        "mbt_compat::float_from_uint"
      } else if qual == "Float" && mem == "reinterpret_from_uint" {
        "mbt_compat::float_reinterpret_from_uint"
      } else if qual == "Bytes" && mem == "make" {
        "mbt_compat::bytes_make"
      } else {
        ""
      }
      if repl.length() > 0 {
        let dist = if toks[i].col >= col { toks[i].col - col } else { col - toks[i].col }
        if dist < best_dist {
          best_dist = dist
          best_i = i
          best_repl = repl
        }
      }
    }
    i = i + 1
  }
  if best_i >= 0 {
    return Some(ln.slice(0, toks[best_i].start_byte) + best_repl + ln.slice(toks[best_i + 2].end_byte, ln.length()))
  }
  None
}

fn op_token_prec(k : TokenKind) -> Int {
  if k == TokenKind::Star || k == TokenKind::Slash || k == TokenKind::Percent {
    return 2
  }
  if k == TokenKind::Plus || k == TokenKind::Minus {
    return 1
  }
  0
}

fn op_symbol_to_name(sym : String) -> String {
  if sym == "+" { return "add" }
  if sym == "-" { return "sub" }
  if sym == "*" { return "mul" }
  if sym == "/" { return "div" }
  ""
}

///| Rewrite ONE custom binary operator (`+`, `-`, `*`, `/`) at `(lidx, d.col)` into `helper(lhs, rhs)`,
///| strictly respecting MoonBit precedence (`*`/`/` > `+`/`-`, unary `-` > `*`/`/`), left-associativity,
///| and left-to-right operand evaluation. Returns `true` if rewritten.
fn rewrite_custom_binop_at(
  lines : Array[String],
  lidx : Int,
  col : Int,
  op_str : String,
  helper_fn : String,
  mutated_lines : Map[Int, Bool],
) -> Bool {
  let target_kind = if op_str == "+" {
    TokenKind::Plus
  } else if op_str == "-" {
    TokenKind::Minus
  } else if op_str == "*" {
    TokenKind::Star
  } else if op_str == "/" {
    TokenKind::Slash
  } else {
    return false
  }
  let op_prec = op_token_prec(target_kind)
  // Gather bounded multiline continuation chunk (only on trailing binary op or unclosed `(`/ `[`, max 8 lines)
  let mut end_l = lidx
  let chunk_sb = StringBuilder()
  chunk_sb.write_string(lines[lidx])
  let mut cont_lines = 0
  while end_l + 1 < lines.length() && cont_lines < 8 {
    let cur_t = lines[end_l].trim()
    let ends_with_op = cur_t.ends_with("+") || cur_t.ends_with("-") || cur_t.ends_with("*") || cur_t.ends_with("/")
    if ends_with_op {
      end_l = end_l + 1
      cont_lines = cont_lines + 1
      chunk_sb.write_string("\n")
      chunk_sb.write_string(lines[end_l])
    } else {
      break
    }
  }
  let chunk = chunk_sb.to_string()
  let toks = lex_moonbit(chunk)
  let tn = toks.length() - 1
  let mut op_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti < tn {
    if toks[ti].line == 1 && toks[ti].kind == target_kind {
      // For `-`, ensure it is binary (preceded by a value-ending token!)
      let is_bin = if target_kind == TokenKind::Minus {
        ti > 0 && !toks[ti].newline_before && is_value_ending_tok(toks[ti - 1])
      } else {
        ti > 0
      }
      if is_bin {
        let dist = if toks[ti].col >= col { toks[ti].col - col } else { col - toks[ti].col }
        if dist < best_dist {
          best_dist = dist
          op_i = ti
        }
      }
    }
    ti = ti + 1
  }
  if op_i <= 0 || op_i + 1 >= tn {
    return false
  }
  // Scan backward for LHS operand (left-associative: stop only at strictly lower precedence or delimiters)
  let mut ls = op_i - 1
  let mut ld = 0
  while ls >= 0 {
    let lk = toks[ls].kind
    if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace {
      ld = ld + 1
    } else if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace {
      if ld == 0 {
        ls = ls + 1
        break
      }
      ld = ld - 1
    } else if ld == 0 {
      let is_low_op = op_prec == 2 && (lk == TokenKind::Plus ||
        (lk == TokenKind::Minus && ls > 0 && !toks[ls].newline_before && is_value_ending_tok(toks[ls - 1])))
      let is_stop = is_low_op || lk == TokenKind::Eq || lk == TokenKind::AssignOp ||
      lk == TokenKind::Comma || lk == TokenKind::Semi || lk == TokenKind::Colon ||
      lk == TokenKind::AmpAmp || lk == TokenKind::PipePipe || lk == TokenKind::FatArrow ||
      lk == TokenKind::EqEq || lk == TokenKind::BangEq || lk == TokenKind::Lt ||
      lk == TokenKind::LtEq || lk == TokenKind::Gt || lk == TokenKind::GtEq ||
      lk == TokenKind::Pipe || lk == TokenKind::Amp || lk == TokenKind::Caret ||
      lk == TokenKind::Shl || lk == TokenKind::Shr ||
      (lk == TokenKind::Keyword && (toks[ls].raw == "if" || toks[ls].raw == "else" ||
        toks[ls].raw == "return" || toks[ls].raw == "while" || toks[ls].raw == "in" ||
        toks[ls].raw == "match" || toks[ls].raw == "let" || toks[ls].raw == "for"))
      if is_stop {
        ls = ls + 1
        break
      }
      if ls < op_i - 1 && toks[ls + 1].newline_before && !is_value_ending_tok(toks[ls]) {
        // Don't cross onto previous statement line
        let prev_is_op = lk == TokenKind::Plus || lk == TokenKind::Minus || lk == TokenKind::Star || lk == TokenKind::Slash
        if !prev_is_op {
          ls = ls + 1
          break
        }
      }
    }
    ls = ls - 1
  }
  if ls < 0 { ls = 0 }

  // Scan forward for RHS operand (left-associative: stop at EQUAL OR LOWER precedence binary op!)
  let mut re = op_i + 1
  let mut rd = 0
  let mut expect_operand = true
  while re < tn {
    let rk = toks[re].kind
    if rd == 0 && re > op_i + 1 && toks[re].newline_before && !expect_operand {
      let cont_op = op_prec == 1 && (rk == TokenKind::Star || rk == TokenKind::Slash || rk == TokenKind::Percent)
      if !cont_op {
        break
      }
    }
    if rd == 0 {
      if rk == TokenKind::Comma || rk == TokenKind::Semi || rk == TokenKind::Eq || rk == TokenKind::AssignOp ||
      rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::FatArrow ||
      rk == TokenKind::EqEq || rk == TokenKind::BangEq || rk == TokenKind::Lt ||
      rk == TokenKind::LtEq || rk == TokenKind::Gt || rk == TokenKind::GtEq ||
      rk == TokenKind::Pipe || rk == TokenKind::Amp || rk == TokenKind::Caret ||
      rk == TokenKind::Shl || rk == TokenKind::Shr ||
      (rk == TokenKind::Keyword && toks[re].raw == "else") {
        break
      }
      if rk == TokenKind::LBrace && !expect_operand && !(re > op_i + 1 && toks[re - 1].kind == TokenKind::ColonColon) {
        break
      }
      let rp = op_token_prec(rk)
      if rp > 0 {
        if expect_operand && rk == TokenKind::Minus {
          // Unary `-` on RHS (e.g. `a + -b`) — keep going!
          re = re + 1
          continue
        }
        if rp <= op_prec {
          // Equal or lower precedence binary op stops RHS (preserves left-associativity & `*` > `+`!)
          break
        }
        // Higher precedence op (`*`/`/` inside `+`/`-` RHS): include it and expect its RHS operand!
        expect_operand = true
        re = re + 1
        continue
      }
    }
    if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
      rd = rd + 1
      expect_operand = false
    } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
      if rd == 0 { break }
      rd = rd - 1
      expect_operand = false
    } else if rk == TokenKind::Bang && expect_operand {
      // Unary `!`
      expect_operand = true
    } else {
      expect_operand = false
    }
    re = re + 1
  }
  if ls >= op_i || re <= op_i + 1 {
    return false
  }
  let lhs_s = chunk.slice(toks[ls].start_byte, toks[op_i - 1].end_byte).trim()
  let rhs_s = chunk.slice(toks[op_i + 1].start_byte, toks[re - 1].end_byte).trim()
  if lhs_s.length() == 0 || rhs_s.length() == 0 {
    return false
  }
  let repl = helper_fn + "(" + lhs_s + ", " + rhs_s + ")"
  let new_chunk = chunk.slice(0, toks[ls].start_byte) + repl + chunk.slice(toks[re - 1].end_byte, chunk.length())
  lines[lidx] = new_chunk
  let mut cl = lidx + 1
  while cl <= end_l {
    lines[cl] = ""
    mutated_lines[cl] = true
    cl = cl + 1
  }
  true
}

///| Run Stage B type-directed fixpoint loop using `pionc check --json` callback.
///| Returns `(updated_files, iterations, final_diagnostic_histogram)`.
pub fn run_stage_b(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)]) {
  run_stage_b_with_ops(files, api_map, Map(), check_fn, diags, drift_ledger)
}

pub fn run_stage_b_with_ops(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  op_lookup : Map[String, String],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)]) {
  run_stage_b_with_ops_and_deps(files, api_map, op_lookup, Map(), check_fn, diags, drift_ledger)
}

pub fn run_stage_b_with_ops_and_deps(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  op_lookup : Map[String, String],
  dep_methods : Map[String, Bool],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)]) {
  let (out_files, iters, hist, _) = run_stage_b_with_ops_deps_and_qt(
    files,
    api_map,
    op_lookup,
    dep_methods,
    check_fn,
    None,
    empty_pkg_query_types(),
    diags,
    drift_ledger,
  )
  (out_files, iters, hist)
}

pub fn run_stage_b_with_ops_deps_and_qt(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  op_lookup : Map[String, String],
  dep_methods : Map[String, Bool],
  check_fn : (Array[(String, String)]) -> String,
  query_types_cb : Option[(Array[(String, String)]) -> String],
  initial_qt : PkgQueryTypes,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)], PkgQueryTypes) {
  run_stage_b_with_ops_deps_qt_and_cross_pkg(
    files,
    api_map,
    op_lookup,
    dep_methods,
    check_fn,
    query_types_cb,
    initial_qt,
    CrossPkgMutationContext::empty(),
    diags,
    drift_ledger,
  )
}

pub fn run_stage_b_with_ops_deps_qt_and_cross_pkg(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  op_lookup : Map[String, String],
  dep_methods : Map[String, Bool],
  check_fn : (Array[(String, String)]) -> String,
  query_types_cb : Option[(Array[(String, String)]) -> String],
  initial_qt : PkgQueryTypes,
  cross_pkg : CrossPkgMutationContext,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)], PkgQueryTypes) {
  let mut cur_files : Array[GeneratedFile] = []
  let file_vers : Map[String, Int] = Map()
  let token_cache : Map[String, (Int, Array[Token])] = Map()
  let mut any_boundary_changed = false
  for f in files {
    let with_bounds = apply_api_boundary_conversions(f.content, api_map, f.rel_path, diags, drift_ledger)
    if with_bounds != f.content {
      any_boundary_changed = true
    }
    file_vers[f.rel_path] = 0
    cur_files.push(GeneratedFile::{
      rel_path: f.rel_path,
      content: with_bounds,
      source_file: f.source_file,
      anchors: f.anchors,
    })
  }

  let mut iter = 0
  let mut final_hist : Array[(String, Int)] = []
  let mut qt_snap : PkgQueryTypes = if !any_boundary_changed && initial_qt.ok {
    initial_qt
  } else {
    empty_pkg_query_types()
  }
  let qt_snap_vers : Map[String, Int] = Map()
  if qt_snap.ok {
    for cf in cur_files {
      qt_snap_vers[cf.rel_path] = 0
    }
  }
  // Invariant: per-file `QtFileIndex` reuse for unchanged files relies on Stage B rewrites
  // never altering cross-file visible signatures or types; any future rewrite that changes
  // exported signatures/types must invalidate the whole package snapshot (`qt_snap_dirty = true`).
  let mut qt_snap_dirty = !qt_snap.ok
  let mut has_unknown_pkg_diag = false
  let mut qt_used_prev_round = false
  let mut prev_round_changed_cap_file = false

  let file_has_capacity_marker = fn(content : String) -> Bool {
    str_has(content, "shrink_to_fit") || str_has(content, ".iter(") ||
    str_has(content, "__mbt_slice_borrow") || str_has(content, ".search_by(") ||
    str_has(content, ".filter_map(")
  }
  let update_qt_snap = fn(parsed_qt : PkgQueryTypes) -> Unit {
    qt_snap = parsed_qt
    for cf in cur_files {
      let v = match file_vers.get(cf.rel_path) {
        Some(n) => n
        None => 0
      }
      qt_snap_vers[cf.rel_path] = v
    }
    qt_snap_dirty = false
  }

  let mut need_qt_for_capacity = false
  for f in cur_files {
    if file_has_capacity_marker(f.content) {
      need_qt_for_capacity = true
      break
    }
  }
  while iter < 16 {
    stage_b_perf_stats[4] = stage_b_perf_stats[4] + 1
    let batch : Array[(String, String)] = []
    for f in cur_files {
      batch.push((f.rel_path, f.content))
    }
    let should_top_qt = if iter == 0 {
      !qt_snap.ok && need_qt_for_capacity
    } else {
      need_qt_for_capacity && qt_snap_dirty && !has_unknown_pkg_diag &&
      (qt_used_prev_round || prev_round_changed_cap_file)
    }
    let raw_json = if should_top_qt {
      match query_types_cb {
        Some(qt_cb) => {
          let r = qt_cb(batch)
          if r.length() > 0 {
            let parsed_qt = parse_pkg_query_types_json(r)
            if parsed_qt.ok {
              update_qt_snap(parsed_qt)
            }
            r
          } else {
            check_fn(batch)
          }
        }
        None => check_fn(batch)
      }
    } else {
      check_fn(batch)
    }
    let pdiags = parse_pionc_diagnostics(raw_json)
    for d in pdiags {
      if d.code == "E_UNKNOWN_PACKAGE" {
        has_unknown_pkg_diag = true
        break
      }
    }

    let counts : Map[String, Int] = Map()
    for d in pdiags {
      let c = match counts.get(d.code) {
        Some(n) => n + 1
        None => 1
      }
      counts[d.code] = c
    }
    let hist_pairs : Array[(String, Int)] = []
    let keys = sorted_map_keys(counts)
    for k in keys {
      match counts.get(k) {
        Some(v) => hist_pairs.push((k, v))
        None => ()
      }
    }
    final_hist = sort_histogram(hist_pairs)
    iter = iter + 1

    if pdiags.length() == 0 || has_unknown_pkg_diag {
      break
    }

    // Hoisted per-round lazy caches backed by cross-round content-versioned `token_cache`
    let mut round_pkg_fns : Option[Map[String, StageBPkgFn]] = None
    let round_file_tokens : Map[String, Array[Token]] = Map()
    let mut round_qt : Option[PkgQueryTypes] = None
    let mut qt_used_this_round = false
    let mut round_shrink_pkg : Option[ShrinkPkg] = None
    let mut round_shrink_pkg_summary : Option[ShrinkPkg] = None
    let mut round_mut_summary : Option[PkgMutationSummary] = None
    let mut round_sort_key_env : Option[SortKeyEnv] = None
    let get_round_qt = fn() -> PkgQueryTypes {
      qt_used_this_round = true
      if qt_snap.ok && !qt_snap_dirty {
        return qt_snap
      }
      if has_unknown_pkg_diag {
        return empty_pkg_query_types()
      }
      match round_qt {
        Some(qt) => qt
        None => {
          let qt = match query_types_cb {
            Some(qt_cb) => {
              let r = qt_cb(batch)
              if r.length() > 0 {
                let parsed_qt = parse_pkg_query_types_json(r)
                if parsed_qt.ok {
                  update_qt_snap(parsed_qt)
                  parsed_qt
                } else {
                  empty_pkg_query_types()
                }
              } else {
                empty_pkg_query_types()
              }
            }
            None => empty_pkg_query_types()
          }
          round_qt = Some(qt)
          qt
        }
      }
    }
    let get_all_round_tokens = fn() -> Array[Array[Token]] {
      let out : Array[Array[Token]] = []
      for cf in cur_files {
        out.push(stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, cf.rel_path, cf.content))
      }
      out
    }
    let get_mut_summary = fn() -> PkgMutationSummary {
      match round_mut_summary {
        Some(ms) => ms
        None => {
          let toks = get_all_round_tokens()
          let rels : Array[String] = []
          let contents : Array[String] = []
          for cf in cur_files {
            rels.push(cf.rel_path)
            contents.push(cf.content)
          }
          let qt_use = get_round_qt()
          let ms = collect_pkg_mutation_summary_with_cross_pkg(toks, rels, contents, qt_use, dep_methods, op_lookup, cross_pkg)
          round_mut_summary = Some(ms)
          ms
        }
      }
    }
    let get_shrink_pkg_summary = fn() -> ShrinkPkg {
      match round_shrink_pkg_summary {
        Some(sp) => sp
        None => {
          let toks = get_all_round_tokens()
          let rels : Array[String] = []
          let contents : Array[String] = []
          for cf in cur_files {
            rels.push(cf.rel_path)
            contents.push(cf.content)
          }
          let qt_use = get_round_qt()
          let sp = collect_shrink_pkg_tokens_with_summary(toks, rels, contents, qt_use, get_mut_summary())
          round_shrink_pkg_summary = Some(sp)
          sp
        }
      }
    }
    let build_shrink_pkg = fn() -> ShrinkPkg {
      let toks = get_all_round_tokens()
      let qt_use = get_round_qt()
      if qt_use.ok {
        let rels : Array[String] = []
        let contents : Array[String] = []
        for cf in cur_files {
          rels.push(cf.rel_path)
          contents.push(cf.content)
        }
        collect_shrink_pkg_tokens_with_qt(toks, rels, contents, qt_use)
      } else {
        collect_shrink_pkg_tokens(toks)
      }
    }
    let get_shrink_pkg = fn() -> ShrinkPkg {
      if stage_b_cache_flag[0] {
        match round_shrink_pkg {
          Some(sp) => sp
          None => {
            stage_b_perf_stats[1] = stage_b_perf_stats[1] + 1
            let sp = build_shrink_pkg()
            round_shrink_pkg = Some(sp)
            sp
          }
        }
      } else {
        stage_b_perf_stats[1] = stage_b_perf_stats[1] + 1
        build_shrink_pkg()
      }
    }
    let get_sort_key_env = fn() -> SortKeyEnv {
      if stage_b_cache_flag[0] {
        match round_sort_key_env {
          Some(env) => env
          None => {
            stage_b_perf_stats[2] = stage_b_perf_stats[2] + 1
            let env = sort_key_env_of_with_deps(get_all_round_tokens(), dep_methods)
            round_sort_key_env = Some(env)
            env
          }
        }
      } else {
        stage_b_perf_stats[2] = stage_b_perf_stats[2] + 1
        sort_key_env_of_with_deps(get_all_round_tokens(), dep_methods)
      }
    }

    let mut changed = false
    let changed_rels : Array[String] = []
    let next_files : Array[GeneratedFile] = []
    let pending_bound_relax_reqs : Array[BoundRelaxReq] = []
    for f in cur_files {
      let lines = f.content.split("\n")
      let mut used_idents_opt : Option[Map[String, Bool]] = None
      let get_used_idents = fn() -> Map[String, Bool] {
        match used_idents_opt {
          Some(m) => m
          None => {
            let ts = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
            let m = collect_used_idents_from_tokens(ts)
            used_idents_opt = Some(m)
            m
          }
        }
      }
      let mutated_lines : Map[Int, Bool] = Map()
      let line_interp_edits : Map[Int, Array[(Int, Int, String)]] = Map()
      let mut method_rw_idx_opt : Option[MethodRewriteIndex] = None
      let get_method_rw_idx = fn() -> MethodRewriteIndex {
        match method_rw_idx_opt {
          Some(idx) => idx
          None => {
            let ts = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
            let idx = build_method_rewrite_index(f.content, ts, lines.length())
            method_rw_idx_opt = Some(idx)
            idx
          }
        }
      }
      let mut file_changed = false
      let get_file_qfi = fn() -> Option[QtFileIndex] {
        qt_used_this_round = true
        if qt_snap.ok {
          let cur_v = match file_vers.get(f.rel_path) {
            Some(v) => v
            None => 0
          }
          let snap_v = match qt_snap_vers.get(f.rel_path) {
            Some(v) => v
            None => -1
          }
          if cur_v == snap_v {
            return qt_snap.files.get(f.rel_path)
          }
        }
        let rqt = get_round_qt()
        if rqt.ok {
          rqt.files.get(f.rel_path)
        } else {
          None
        }
      }
      // Gate D: Rewrite provably read-only `for x in arr[lo:hi]` borrowed-slice loops into
      // MoonBit-exact clamped index `while` loops before Stage A.5 sees `__mbt_slice_borrow`.
      if str_has(f.content, "__mbt_slice_borrow") {
        let ftoks_d = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
        let file_qfi_d = get_file_qfi()
        if stage_b_rewrite_borrowed_slice_for_loops(
          lines,
          ftoks_d,
          get_mut_summary(),
          f.rel_path,
          f.content,
          file_qfi_d,
          get_used_idents(),
          mutated_lines,
          drift_ledger,
        ) {
          file_changed = true
        }
      }
      for d in pdiags {
        if !(d.file == f.rel_path || d.file.ends_with("/" + f.rel_path)) {
          continue
        }
        let lidx = d.line - 1
        if lidx < 0 || lidx >= lines.length() || mutated_lines.contains(lidx) {
          continue
        }
        let ln = lines[lidx]
        let mut line_mutated = false

        // 0. Static compat calls (`Float::is_nan`, `Float::from_uint`, `Float::reinterpret_from_uint`, `Bytes::make`)
        if d.code == "E_TYPE_MISMATCH" && str_has(d.message, "unknown static function") &&
        (str_has(d.message, "Float::is_nan") || str_has(d.message, "Float::from_uint") ||
          str_has(d.message, "Float::reinterpret_from_uint") || str_has(d.message, "Bytes::make")) {
          match rewrite_static_compat_call_at(ln, d.col) {
            Some(new_ln) => {
              lines[lidx] = new_ln
              file_changed = true
              line_mutated = true
            }
            None => ()
          }
        }

        // 0b. Tuple keys (`Map[(A, B), V]` / `Set[(A, B)]`): Pion has no trait impls on tuple types, so a
        //     `MapKey`-bound constructor called with a pair / triple key becomes its `_pair` / `_triple` form
        //     (component-wise `MapKey`; components without one still fail here).
        //     Also relax redundant `MbtHash`/`MapKey` bounds on local generic functions whose body never
        //     constructs a new `OrderedMap`/`OrderedSet` or calls hash/key_eq directly.
        if !line_mutated && (str_has(d.message, "does not implement trait `mbt_compat::MapKey` required by `") ||
          str_has(d.message, "does not implement trait `mbt_compat::MbtHash` required by `")) {
          let mut handled_tuple_key = false
          match rewrite_tuple_mapkey_call_at(ln, d.col, d.message) {
            Some(new_ln) => {
              lines[lidx] = new_ln
              file_changed = true
              line_mutated = true
              handled_tuple_key = true
            }
            None => ()
          }
          if !handled_tuple_key {
            let tp = "type `"
            let ti = d.message.index_of(tp)
            if ti >= 0 {
              let rest_t = d.message.slice(ti + tp.length(), d.message.length())
              let te = rest_t.index_of("` does not implement")
              if te > 0 && tuple_type_arity(rest_t.slice(0, te)) >= 2 {
                let rp = "required by `"
                let ri = d.message.index_of(rp)
                if ri >= 0 {
                  let r2 = d.message.slice(ri + rp.length(), d.message.length())
                  let re = r2.index_of("`")
                  if re > 0 {
                    let req_fn = r2.slice(0, re)
                    let targs = find_tuple_args_at_call(get_method_rw_idx(), lidx, d.col, req_fn, get_file_qfi())
                    pending_bound_relax_reqs.push(BoundRelaxReq::{ fn_name: req_fn, tuple_args: targs })
                  }
                }
              }
            }
          }
        }

        if !line_mutated && d.code == "E_TYPE_MISMATCH" {
          // 1. Missing builtin method -> canonical `mbt_compat::*` (or inline lowering for `Int::to_char`)
          match parse_unknown_method_msg(d.message) {
            Some((mname, rty)) =>
            if rty == "Int" && mname == "to_char" {
              match rewrite_int_to_char_at(lines[lidx], d.col, get_used_idents()) {
                Some(new_ln) => {
                  lines[lidx] = new_ln
                  file_changed = true
                  line_mutated = true
                }
                None => ()
              }
            } else if rty == "Array[String]" && mname == "next" {
              match rewrite_split_next_at(lines[lidx], d.col) {
                Some(new_ln) => {
                  lines[lidx] = new_ln
                  file_changed = true
                  line_mutated = true
                }
                None => ()
              }
            } else if rty.starts_with("Array[") && mname == "count" {
              match rewrite_array_count_zero_arg_at(lines[lidx], d.col) {
                Some(new_ln) => {
                  lines[lidx] = new_ln
                  file_changed = true
                  line_mutated = true
                }
                None => ()
              }
            } else if rty != "String" && mname == "__mbt_str_trim" {
              match restore_placeholder_method_at(lines[lidx], d.col, "__mbt_str_trim", "trim") {
                Some(new_ln) => {
                  lines[lidx] = new_ln
                  file_changed = true
                  line_mutated = true
                }
                None => ()
              }
            } else if rty != "String" && mname == "__mbt_str_replace" {
              match restore_placeholder_method_at(lines[lidx], d.col, "__mbt_str_replace", "replace") {
                Some(new_ln) => {
                  lines[lidx] = new_ln
                  file_changed = true
                  line_mutated = true
                }
                None => ()
              }
            } else {
              let resolved_helper = match lookup_missing_method_helper(rty, mname) {
                Some(h) => Some(h)
                None =>
                if mname == "compare" && (str_has(f.content, rty + " : ") || str_has(f.content, rty + ":")) && str_has(f.content, "mbt_compat::MbtCompare") {
                  Some("mbt_compat::mbt_compare")
                } else {
                  None
                }
              }
              match resolved_helper {
                Some(helper) => {
                  if helper == "mbt_compat::arr_retain" || helper == "mbt_compat::arr_filter_map" ||
                  helper == "mbt_compat::arr_search_by" || helper == "mbt_compat::arr_find_first" || helper == "mbt_compat::arr_sort_by_key" {
                    let pkg_fns = match round_pkg_fns {
                      Some(m) => m
                      None => {
                        stage_b_perf_stats[3] = stage_b_perf_stats[3] + 1
                        let _ = get_all_round_tokens()
                        let m = collect_stage_b_pkg_fns_cached(cur_files, round_file_tokens)
                        round_pkg_fns = Some(m)
                        m
                      }
                    }
                    if helper == "mbt_compat::arr_search_by" {
                      let probe_diags : Array[Diag] = []
                      stage_b_check_array_retain_mutation_cached(round_file_tokens, pkg_fns, f.rel_path, f.content, d.line, d.col, mname, probe_diags)
                      let ftoks_b = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                      let elem_ty_b = ms_extract_array_elem_ty(rty)
                      let ms_safe = stage_b_check_array_cb_with_summary(ftoks_b, get_mut_summary(), f.rel_path, f.content, get_file_qfi(), elem_ty_b, mname, helper, d.line, d.col, probe_diags.length() > 0, drift_ledger)
                      if !ms_safe {
                        if probe_diags.length() > 0 {
                          for pd in probe_diags {
                            let mut dup = false
                            for existing in diags {
                              if existing.code == pd.code && existing.file == pd.file && existing.line == pd.line && existing.col == pd.col {
                                dup = true
                                break
                              }
                            }
                            if !dup {
                              diags.push(pd)
                            }
                          }
                        } else {
                          let mut dup = false
                          for existing in diags {
                            if existing.code == "MBT2PION_UNSUPPORTED_SYNTAX" && existing.file == f.rel_path && existing.line == d.line && existing.col == d.col {
                              dup = true
                              break
                            }
                          }
                          if !dup {
                            diags.push(diag_error(
                              "MBT2PION_UNSUPPORTED_SYNTAX",
                              f.rel_path,
                              d.line,
                              d.col,
                              "callback in `Array::search_by(...)` may mutate receiver or aliased array (fail-closed by mutation_summary)",
                            ))
                          }
                        }
                      }
                    } else if helper == "mbt_compat::arr_filter_map" {
                      let probe_diags : Array[Diag] = []
                      stage_b_check_array_retain_mutation_cached(round_file_tokens, pkg_fns, f.rel_path, f.content, d.line, d.col, mname, probe_diags)
                      if probe_diags.length() > 0 {
                        let ftoks_b = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                        let elem_ty_b = ms_extract_array_elem_ty(rty)
                        let ms_safe = stage_b_check_array_cb_with_summary(ftoks_b, get_mut_summary(), f.rel_path, f.content, get_file_qfi(), elem_ty_b, mname, helper, d.line, d.col, true, drift_ledger)
                        if !ms_safe {
                          for pd in probe_diags {
                            let mut dup = false
                            for existing in diags {
                              if existing.code == pd.code && existing.file == pd.file && existing.line == pd.line && existing.col == pd.col {
                                dup = true
                                break
                              }
                            }
                            if !dup {
                              diags.push(pd)
                            }
                          }
                        }
                      }
                    } else {
                      stage_b_check_array_retain_mutation_cached(round_file_tokens, pkg_fns, f.rel_path, f.content, d.line, d.col, mname, diags)
                    }
                  }
                  let mut skip_rewrite = false
                  if helper == "mbt_compat::arr_shrink_to_fit" {
                    let ftoks = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    if !stage_b_check_shrink_snapshot_with_summary(ftoks, get_shrink_pkg(), get_shrink_pkg_summary(), get_mut_summary(), f.rel_path, f.content, get_file_qfi(), d.line, d.col, diags, drift_ledger) {
                      skip_rewrite = true
                    }
                  }
                  if helper == "mbt_compat::arr_sort_by_key" {
                    let ftoks = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    if !stage_b_check_sort_key_closure_cached(ftoks, get_sort_key_env(), f.rel_path, d.line, d.col, diags) {
                      skip_rewrite = true
                    }
                  }
                  if helper == "mbt_compat::arr_iter" || helper == "mbt_compat::arr_iter2" || helper == "mbt_compat::arr_rev_iter" {
                    let _ = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    let decl_tys = if get_round_qt().ok { get_shrink_pkg().declared_types } else { Map() }
                    let elem_ty_c = ms_extract_array_elem_ty(rty)
                    if !stage_b_check_kept_iter_with_summary(round_file_tokens, get_mut_summary(), f.rel_path, f.content, get_file_qfi(), decl_tys, elem_ty_c, d.line, d.col, diags, drift_ledger) {
                      skip_rewrite = true
                    }
                  }
                  if helper == "mbt_compat::arr_push_iter" {
                    let _ = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
                    let pi_status = stage_b_check_push_iter_arg(round_file_tokens, f.rel_path, f.content, d.line, d.col, true, diags)
                    if pi_status < 0 {
                      skip_rewrite = true
                    }
                  }
                  let direct_end = if !skip_rewrite && (mname == "unsafe_get" || mname == "unsafe_set") &&
                  (rty.starts_with("Array[") || rty.starts_with("FixedArray[")) {
                    rewrite_unsafe_index_at(lines, lidx, d.col, mname)
                  } else {
                    -1
                  }
                  if skip_rewrite {
                    ()
                  } else if direct_end >= 0 {
                    let mut ml = lidx + 1
                    while ml <= direct_end {
                      mutated_lines[ml] = true
                      ml = ml + 1
                    }
                    file_changed = true
                    line_mutated = true
                  } else {
                    let rw_idx = get_method_rw_idx()
                    let lstart_b = rw_idx.line_starts[lidx]
                    let lend_b = if lidx + 1 < rw_idx.line_starts.length() { rw_idx.line_starts[lidx + 1] - 1 } else { rw_idx.src.length() }
                    let raw_tb = lstart_b + (if d.col > 0 { d.col - 1 } else { 0 })
                    let tb = if raw_tb > lend_b { lend_b } else { raw_tb }
                    let cov_interp = find_covering_interp_token(rw_idx, lidx, tb)
                    let mut batched_interp = false
                    if cov_interp >= 0 {
                      match compute_interp_hole_edit(rw_idx, lines, lidx, d.col, cov_interp, mname, helper) {
                        Some((abs_s, abs_e, new_sub)) => {
                          let (sbl, _sbc) = line_starts_to_line_col(rw_idx.line_starts, abs_s)
                          let (sll, _slc) = line_starts_to_line_col(rw_idx.line_starts, abs_e)
                          if sbl == lidx && sll == lidx {
                            let existing = match line_interp_edits.get(lidx) {
                              Some(arr) => arr
                              None => []
                            }
                            let mut overlaps = false
                            for prev_ed in existing {
                              if !(abs_e <= prev_ed.0 || abs_s >= prev_ed.1) {
                                overlaps = true
                                break
                              }
                            }
                            if !overlaps {
                              existing.push((abs_s, abs_e, new_sub))
                              line_interp_edits[lidx] = existing
                              batched_interp = true
                              if helper == "mbt_compat::str_compare" {
                                drift_ledger.push(DriftEntry::{
                                  category: "string_compare",
                                  file: f.rel_path,
                                  line: d.line,
                                  col: d.col,
                                  expr: mname,
                                  resolution: helper,
                                  status: "resolved",
                                  detail: "String::compare routed to MoonBit UTF-16 length-first comparison",
                                })
                              }
                            }
                          }
                        }
                        None => ()
                      }
                    }
                    if !batched_interp {
                      let (rw_s, _rw_e) = rewrite_method_call_with_index(rw_idx, lines, mutated_lines, lidx, d.col, mname, helper)
                      if rw_s >= 0 {
                        file_changed = true
                        line_mutated = true
                        if helper == "mbt_compat::str_compare" {
                          drift_ledger.push(DriftEntry::{
                            category: "string_compare",
                            file: f.rel_path,
                            line: d.line,
                            col: d.col,
                            expr: mname,
                            resolution: helper,
                            status: "resolved",
                            detail: "String::compare routed to MoonBit UTF-16 length-first comparison",
                          })
                        }
                      }
                    }
                  }
                }
                None => ()
              }
            }
            None => ()
          }
          // 1a. `Array[Double/Float/UInt/UInt64/Byte/Char]::sort()` -> `mbt_compat::arr_sort_*`
          if !line_mutated && str_has(d.message, "`Array::sort` is only supported on") {
            let ftoks_s = stage_b_get_file_tokens(round_file_tokens, token_cache, file_vers, f.rel_path, f.content)
            let mut exact_ti = -1
            let mut best_ge_ti = -1
            let mut best_ge_dist = 1000000
            let mut best_any_ti = -1
            let mut best_any_dist = 1000000
            let mut ti_s = 0
            while ti_s + 1 < ftoks_s.length() {
              if ftoks_s[ti_s].line == d.line && ftoks_s[ti_s].kind == TokenKind::Dot &&
              ftoks_s[ti_s + 1].kind == TokenKind::Ident && ftoks_s[ti_s + 1].raw == "sort" {
                let rs_s = receiver_path_start_token(ftoks_s, ti_s - 1)
                if rs_s >= 0 && ftoks_s[rs_s].line == d.line && ftoks_s[rs_s].col == d.col {
                  exact_ti = ti_s
                  break
                }
                let scol = ftoks_s[ti_s + 1].col
                if scol >= d.col {
                  let dist = scol - d.col
                  if dist < best_ge_dist {
                    best_ge_dist = dist
                    best_ge_ti = ti_s
                  }
                }
                let adist = if scol >= d.col { scol - d.col } else { d.col - scol }
                if adist < best_any_dist {
                  best_any_dist = adist
                  best_any_ti = ti_s
                }
              }
              ti_s = ti_s + 1
            }
            let chosen_ti = if exact_ti >= 0 {
              exact_ti
            } else if best_ge_ti >= 0 {
              best_ge_ti
            } else {
              best_any_ti
            }
            let mut sort_rty = d.found.trim()
            if sort_rty.length() == 0 && chosen_ti >= 0 {
              let rs_s = receiver_path_start_token(ftoks_s, chosen_ti - 1)
              let rsb_s = if rs_s >= 0 { ftoks_s[rs_s].start_byte } else { -1 }
              match get_file_qfi() {
                Some(qfi) =>
                match qt_lookup_receiver_ty_at_op(qfi, f.content, ftoks_s[chosen_ti + 1].start_byte, rsb_s, -1, true) {
                  Some(rt) => sort_rty = rt
                  None => ()
                }
                None => ()
              }
            }
            let rewrite_col = if chosen_ti >= 0 { ftoks_s[chosen_ti + 1].col } else { d.col }
            match lookup_array_sort_helper(sort_rty) {
              Some(helper) => {
                let (rw_s, _rw_e) = rewrite_method_call_with_index(get_method_rw_idx(), lines, mutated_lines, lidx, rewrite_col, "sort", helper)
                if rw_s >= 0 {
                  file_changed = true
                  line_mutated = true
                }
              }
              None => ()
            }
          }
          // 1b. Strip `init=` label on `MbtIter::fold(init=x, f)` using lexer tokens closest to `d.col` (never touches string literals)
          if !line_mutated && str_has(d.message, "unknown named argument `init`") && str_has(d.message, "fold") {
            let cur_ln = lines[lidx]
            let itoks = lex_moonbit(cur_ln)
            let itn = itoks.length() - 1
            let mut best_ti = -1
            let mut best_dist = 1000000
            let mut ti = 0
            while ti + 1 < itn {
              if itoks[ti].kind == TokenKind::Ident && itoks[ti].raw == "init" && itoks[ti + 1].kind == TokenKind::Eq {
                let dist = if itoks[ti].col >= d.col { itoks[ti].col - d.col } else { d.col - itoks[ti].col }
                if dist < best_dist {
                  best_dist = dist
                  best_ti = ti
                }
              }
              ti = ti + 1
            }
            if best_ti >= 0 {
              lines[lidx] = cur_ln.slice(0, itoks[best_ti].start_byte) + cur_ln.slice(itoks[best_ti + 1].end_byte, cur_ln.length())
              file_changed = true
              line_mutated = true
            }
          }
          // 1b. MoonBit `String::view(start_offset=..., end_offset=...)`: Pion `String` has a built-in `.view`
          //     that rejects named `start_offset`/`end_offset` args; rewrite ONLY a real code `.view(` (never inside string/char/comment)
          //     closest at/left of `d.col` to `mbt_compat::str_view(recv, ...)`.
          if !line_mutated && (str_has(d.message, "named argument `start_offset`") || str_has(d.message, "named argument `end_offset`")) {
            let mut best_v = -1
            let mut si = 0
            let sn = ln.length()
            let mut in_str = false
            let mut in_chr = false
            let mut esc = false
            while si < sn {
              let ch = ln.code_unit_at(si)
              if in_str {
                if esc { esc = false }
                else if ch == 92 { esc = true }
                else if ch == 34 { in_str = false }
              } else if in_chr {
                if esc { esc = false }
                else if ch == 92 { esc = true }
                else if ch == 39 { in_chr = false }
              } else if ch == 34 {
                in_str = true
              } else if ch == 39 {
                in_chr = true
              } else if ch == 47 && si + 1 < sn && ln.code_unit_at(si + 1) == 47 {
                break
              } else if ch == 46 && si + 6 <= sn && ln.slice(si, si + 6) == ".view(" {
                if si + 1 <= d.col {
                  best_v = si
                } else if best_v < 0 {
                  best_v = si
                }
              }
              si = si + 1
            }
            if best_v >= 0 {
              let (rw_s, _rw_e) = rewrite_method_call_with_index(get_method_rw_idx(), lines, mutated_lines, lidx, best_v + 2, "view", "mbt_compat::str_view")
              if rw_s >= 0 {
                file_changed = true
                line_mutated = true
              }
            }
          }
          // 1c. MoonBit `String::replace(old=..., new=...)` & `String::trim(chars=...)`:
          //     Strictly guarded on `String::replace` / `String::trim` (fail-closed: never touches user-defined methods).
          if !line_mutated && (str_has(d.message, "named argument `old`") || str_has(d.message, "named argument `new`")) &&
          str_has(d.message, "`String::replace`") {
            let rdot = find_method_dot_at_col(ln, "replace", d.col)
            if rdot >= 0 {
              let (rw_s, _rw_e) = rewrite_method_call_with_index(get_method_rw_idx(), lines, mutated_lines, lidx, rdot + 2, "replace", "mbt_compat::str_replace")
              if rw_s >= 0 {
                file_changed = true
                line_mutated = true
              }
            }
          }
          if !line_mutated && str_has(d.message, "named argument `chars`") &&
          str_has(d.message, "`String::trim`") {
            let tdot = find_method_dot_at_col(ln, "trim", d.col)
            if tdot >= 0 {
              let (rw_s, _rw_e) = rewrite_method_call_with_index(get_method_rw_idx(), lines, mutated_lines, lidx, tdot + 2, "trim", "mbt_compat::str_trim")
              if rw_s >= 0 {
                file_changed = true
                line_mutated = true
              }
            }
          }
          // 2. Token-precise numeric literal coercion at `d.col` (never appends to EOL!)
          if !line_mutated && d.found == "Int" && d.expected == "Int64" {
            match coerce_numeric_token_at_col(ln, d.col, "to_int64") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
                line_mutated = true
              }
              None => ()
            }
          } else if !line_mutated && d.found == "Int" && d.expected == "Double" {
            match coerce_numeric_token_at_col(ln, d.col, "to_double") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
                line_mutated = true
              }
              None => ()
            }
          } else if !line_mutated && d.found == "Int" && d.expected == "Byte" {
            match coerce_numeric_token_at_col(ln, d.col, "to_byte") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
                line_mutated = true
              }
              None => ()
            }
          } else if !line_mutated && d.found == "Unit" &&
          (d.expected.starts_with("OrderedMap[") || d.expected.starts_with("mbt_compat::OrderedMap[")) {
            let cur_ln = lines[lidx]
            let ltoks = lex_moonbit(cur_ln)
            let mut match_ti = -1
            let mut ti = 0
            while ti + 1 < ltoks.length() - 1 {
              if ltoks[ti].kind == TokenKind::LBrace && ltoks[ti + 1].kind == TokenKind::RBrace &&
              (ltoks[ti].col == d.col || ltoks[ti + 1].col == d.col) {
                let expr_pos_ok = ti == 0 || {
                  let pk = ltoks[ti - 1].kind
                  pk == TokenKind::Eq || pk == TokenKind::FatArrow || pk == TokenKind::LParen ||
                  pk == TokenKind::LBracket || pk == TokenKind::LBrace || pk == TokenKind::Comma ||
                  pk == TokenKind::Semi || pk == TokenKind::Colon || pk == TokenKind::PipeGt ||
                  (pk == TokenKind::Keyword && (ltoks[ti - 1].raw == "return" || ltoks[ti - 1].raw == "else"))
                }
                if expr_pos_ok {
                  match_ti = ti
                }
                break
              }
              ti = ti + 1
            }
            if match_ti >= 0 {
              let mut sfx = ""
              let om_idx = d.expected.index_of("OrderedMap[")
              if om_idx >= 0 && d.expected.ends_with("]") {
                let inner = d.expected.slice(om_idx + 11, d.expected.length() - 1)
                let mut kd = 0
                let mut ki = 0
                while ki < inner.length() {
                  let ch = inner.code_unit_at(ki)
                  if ch == 40 || ch == 91 { kd = kd + 1 }
                  else if ch == 41 || ch == 93 { kd = kd - 1 }
                  else if ch == 44 && kd == 0 { break }
                  ki = ki + 1
                }
                let key_ty = inner.slice(0, ki).trim()
                if key_ty.starts_with("Array[") && key_ty.ends_with("]") {
                  sfx = "_array"
                } else {
                  let arity = tuple_type_arity(key_ty)
                  if arity == 2 { sfx = "_pair" }
                  else if arity == 3 { sfx = "_triple" }
                }
              }
              let sb_b = ltoks[match_ti].start_byte
              let eb_b = ltoks[match_ti + 1].end_byte
              lines[lidx] = cur_ln.slice(0, sb_b) + "mbt_compat::ordered_map_new" + sfx + "()" + cur_ln.slice(eb_b, cur_ln.length())
              file_changed = true
              line_mutated = true
            }
          } else if !line_mutated && str_has(d.message, "`match` arm type mismatch") &&
          (d.expected.length() == 0 || str_has(d.expected, "OrderedMap")) {
            let cur_ln = lines[lidx]
            let ltoks = lex_moonbit(cur_ln)
            let mut match_ti = -1
            let mut ti = 0
            while ti + 1 < ltoks.length() - 1 {
              if ltoks[ti].kind == TokenKind::LBrace && ltoks[ti + 1].kind == TokenKind::RBrace &&
              (ltoks[ti].col == d.col || ltoks[ti + 1].col == d.col) &&
              ti > 0 && ltoks[ti - 1].kind == TokenKind::FatArrow {
                match_ti = ti
                break
              }
              ti = ti + 1
            }
            if match_ti >= 0 {
              // Confirm OrderedMap-specific evidence in the enclosing `match` or `MbtJson::Object`/`object` use.
              let mut has_map_evidence = str_has(d.expected, "OrderedMap[")
              let mut bound_var = ""
              let mut scan_up = lidx
              let up_limit = if lidx > 20 { lidx - 20 } else { 0 }
              while scan_up >= up_limit {
                let sln = lines[scan_up]
                if scan_up != lidx && (str_has(sln, "ordered_map_new") || str_has(sln, "ordered_map_from_array")) {
                  has_map_evidence = true
                }
                if str_has(sln, "match ") {
                  let ml = lex_moonbit(sln)
                  let mut mi = 0
                  while mi + 3 < ml.length() {
                    if ml[mi].kind == TokenKind::Keyword && ml[mi].raw == "let" {
                      let ni = if ml[mi + 1].kind == TokenKind::Keyword && ml[mi + 1].raw == "mut" { mi + 2 } else { mi + 1 }
                      if ni + 2 < ml.length() && ml[ni].kind == TokenKind::Ident && ml[ni + 1].kind == TokenKind::Eq &&
                      ml[ni + 2].kind == TokenKind::Keyword && ml[ni + 2].raw == "match" {
                        bound_var = ml[ni].raw
                      }
                    }
                    mi = mi + 1
                  }
                  break
                }
                if scan_up == 0 { break }
                scan_up = scan_up - 1
              }
              let down_limit = if lidx + 20 < lines.length() { lidx + 20 } else { lines.length() }
              let mut scan_dn = lidx + 1
              while !has_map_evidence && scan_dn < down_limit {
                let dln = lines[scan_dn]
                if bound_var.length() > 0 && (str_has(dln, "MbtJson::Object(" + bound_var + ")") ||
                  str_has(dln, "MbtJson::object(" + bound_var + ")")) {
                  has_map_evidence = true
                  break
                }
                scan_dn = scan_dn + 1
              }
              if has_map_evidence {
                let mut sfx = ""
                let om_idx = d.expected.index_of("OrderedMap[")
                if om_idx >= 0 && d.expected.ends_with("]") {
                  let inner = d.expected.slice(om_idx + 11, d.expected.length() - 1)
                  let mut kd = 0
                  let mut ki = 0
                  while ki < inner.length() {
                    let ch = inner.code_unit_at(ki)
                    if ch == 40 || ch == 91 { kd = kd + 1 }
                    else if ch == 41 || ch == 93 { kd = kd - 1 }
                    else if ch == 44 && kd == 0 { break }
                    ki = ki + 1
                  }
                  let key_ty = inner.slice(0, ki).trim()
                  if key_ty.starts_with("Array[") && key_ty.ends_with("]") {
                    sfx = "_array"
                  } else {
                    let arity = tuple_type_arity(key_ty)
                    if arity == 2 { sfx = "_pair" }
                    else if arity == 3 { sfx = "_triple" }
                  }
                }
                let sb_b = ltoks[match_ti].start_byte
                let eb_b = ltoks[match_ti + 1].end_byte
                lines[lidx] = cur_ln.slice(0, sb_b) + "mbt_compat::ordered_map_new" + sfx + "()" + cur_ln.slice(eb_b, cur_ln.length())
                file_changed = true
                line_mutated = true
              }
            }
          }
          // 2a-view. Implicit `Array[T]` -> `ArrayView[T]` call argument wrapping (`mbt_compat::arr_view(arg)`).
          if !line_mutated && str_has(d.message, "type mismatch in call to `") &&
          d.found.starts_with("Array[") &&
          (d.expected.starts_with("ArrayView[") || d.expected.starts_with("mbt_compat::ArrayView[")) {
            let (rw_s, _rw_e) = rewrite_array_to_view_arg_with_index(get_method_rw_idx(), lines, mutated_lines, lidx, d.col, d.message)
            if rw_s >= 0 {
              file_changed = true
              line_mutated = true
            }
          }
          // 2b. Tuple struct numeric field access `<expr>.0` -> `<expr>._0` (lexer-backed; never touches string literals; handles `.0.1`)
          // Only trigger on `struct \`S\` has no field \`N\`` / `unknown field \`N\` on struct \`S\``, NEVER on
          // `cannot access field \`N\` on \`T\`` (which is emitted for non-struct / tuple / stale-typed receivers!).
          if !line_mutated && (str_has(d.message, "unknown field `") || str_has(d.message, "has no field `")) &&
          !field_access_on_scalar_or_error(d.message) {
            let mut fstart = d.message.index_of("field `")
            if fstart >= 0 {
              fstart = fstart + 7
              let rest_m = d.message.slice(fstart, d.message.length())
              let ftick = rest_m.index_of("`")
              if ftick > 0 {
                let fld = rest_m.slice(0, ftick)
                let mut all_dig = true
                let mut di = 0
                while di < fld.length() {
                  let dc = fld.code_unit_at(di)
                  if dc < 48 || dc > 57 { all_dig = false; break }
                  di = di + 1
                }
                if all_dig {
                  let cur_ln = lines[lidx]
                  let ltoks = lex_moonbit(cur_ln)
                  let mut best_ti = -1
                  let mut best_dist = 1000000
                  let mut ti = 0
                  while ti + 1 < ltoks.length() - 1 {
                    if ltoks[ti].kind == TokenKind::Dot {
                      let nxt = ltoks[ti + 1]
                      let is_exact_int = nxt.kind == TokenKind::IntLit && nxt.raw == fld
                      let is_chained_flt = nxt.kind == TokenKind::FloatLit && nxt.raw.starts_with(fld + ".")
                      if is_exact_int || is_chained_flt {
                        let dist = if ltoks[ti].col >= d.col { ltoks[ti].col - d.col } else { d.col - ltoks[ti].col }
                        if dist < best_dist {
                          best_dist = dist
                          best_ti = ti
                        }
                      }
                    }
                    ti = ti + 1
                  }
                  if best_ti >= 0 {
                    let dot_t = ltoks[best_ti]
                    let nxt = ltoks[best_ti + 1]
                    let mut prefix_end = dot_t.start_byte
                    // Collapse Stage A's `.0 .1` spacing back to `._0._1` cleanly when rewriting the second index
                    if prefix_end > 0 && cur_ln.code_unit_at(prefix_end - 1) == 32 && best_ti > 0 &&
                    (ltoks[best_ti - 1].kind == TokenKind::Ident || ltoks[best_ti - 1].kind == TokenKind::IntLit ||
                      ltoks[best_ti - 1].kind == TokenKind::RParen || ltoks[best_ti - 1].kind == TokenKind::RBracket) {
                      prefix_end = ltoks[best_ti - 1].end_byte
                    }
                    if nxt.kind == TokenKind::IntLit {
                      lines[lidx] = cur_ln.slice(0, prefix_end) + "._" + fld + cur_ln.slice(nxt.end_byte, cur_ln.length())
                    } else {
                      // Chained `.0.1` lexed as `.` + `FloatLit("0.1")` -> `._0.1` (next round handles `.1` if also tuple struct)
                      let rest_flt = nxt.raw.slice(fld.length(), nxt.raw.length())
                      lines[lidx] = cur_ln.slice(0, prefix_end) + "._" + fld + rest_flt + cur_ln.slice(nxt.end_byte, cur_ln.length())
                    }
                    file_changed = true
                    line_mutated = true
                  }
                }
              }
            }
          }
          // 2c. OrderedMap/ArrayView/ArrayBuf index assignment `<recv>[<k>] = <v>` -> `<recv>.set(<k>, <v>)`,
          //     or custom user type defining `#alias("_[_]=_")` / `op_set` / `#alias("_[_]")` / `op_get`
          //     (supports multiline `<k>` and multiline `<v>`, fail-closed otherwise).
          let mut idx_set_method = ""
          let mut idx_get_method = ""
          if !line_mutated && (str_has(d.message, "cannot assign to indexed type `") || str_has(d.message, "cannot index into type `")) {
            if str_has(d.message, "OrderedMap[") || str_has(d.message, "ArrayView[") || str_has(d.message, "ArrayBuf[") {
              idx_set_method = "set"
            } else {
              let is_assign_diag = str_has(d.message, "cannot assign to indexed type `")
              let p_idx = if is_assign_diag {
                d.message.index_of("cannot assign to indexed type `")
              } else {
                d.message.index_of("cannot index into type `")
              }
              let p_len = if is_assign_diag { 31 } else { 24 }
              if p_idx >= 0 {
                let r_ty = d.message.slice(p_idx + p_len, d.message.length())
                let end_bt = r_ty.index_of("`")
                if end_bt > 0 {
                  let raw_t = r_ty.slice(0, end_bt)
                  let base_t = strip_type_args_sym(raw_t)
                  let is_qualified = base_t.index_of("::") >= 0
                  let pkg_fns = match round_pkg_fns {
                    Some(m) => m
                    None => {
                      stage_b_perf_stats[3] = stage_b_perf_stats[3] + 1
                      let _ = get_all_round_tokens()
                      let m = collect_stage_b_pkg_fns_cached(cur_files, round_file_tokens)
                      round_pkg_fns = Some(m)
                      m
                    }
                  }
                  // Never fall back to short type name for cross-package qualified types (`ext::Grid`):
                  // a local `Grid`'s `#alias` / `op_set` / `op_get` must never pollute another package's type.
                  if is_assign_diag {
                    match op_lookup.get(base_t + "|#alias_op_set") {
                      Some(m) => idx_set_method = m
                      None =>
                      if !is_qualified && pkg_fns.contains(base_t + "::op_set") {
                        idx_set_method = "op_set"
                      }
                    }
                  } else {
                    match op_lookup.get(base_t + "|#alias_op_get") {
                      Some(m) => idx_get_method = m
                      None =>
                      if !is_qualified && pkg_fns.contains(base_t + "::op_get") {
                        idx_get_method = "op_get"
                      }
                    }
                  }
                }
              }
            }
          }
          if !line_mutated && (idx_set_method.length() > 0 || idx_get_method.length() > 0) {
            let (rw_s, _rw_e) = rewrite_index_op_with_index(
              get_method_rw_idx(),
              lines,
              mutated_lines,
              lidx,
              d.col,
              idx_set_method,
              idx_get_method,
            )
            if rw_s >= 0 {
              file_changed = true
              line_mutated = true
            }
          }
          // 3. Live order-preserving cursor `while` loop for `OrderedMap`, `String`, `ArrayView`, & `Bytes` `for ... in` (Wave M1.2 A.6):
          //    NEVER snapshot via `.to_array()` / `str_scalars`! Advance cursor BEFORE body so `continue`/`break`/`return` work!
          if !line_mutated && str_has(d.message, "`for ... in` requires an `Array[T]`") {
            let in_idx = ln.index_of(" in ")
            let lb_rel = if in_idx > 0 { ln.slice(in_idx + 4, ln.length()).index_of(" {") } else { -1 }
            let lb_idx = if lb_rel >= 0 { in_idx + 4 + lb_rel } else { -1 }
            if in_idx > 0 && lb_idx > in_idx {
              let iter_expr = ln.slice(in_idx + 4, lb_idx).trim()
              let binders = ln.slice(0, in_idx)
              let for_idx = binders.index_of("for ")
              if for_idx >= 0 {
                let prefix = binders.slice(0, for_idx)
                let vars_str = binders.slice(for_idx + 4, binders.length()).trim()
                let comma_idx = vars_str.index_of(",")
                // Find the matching closing `}` line for the `{` at `(lidx, lb_idx + 1)`
                // Skipping string literals `"..."`, char literals `'...'` (`'}'`, `'\''`, `'\\'`),
                // line comments `// ...`, and block comments `/* ... */` (Red-team P2-2)!
                let mut close_l = -1
                let mut close_c = -1
                let mut bdepth = 0
                let mut scan_l = lidx
                let mut in_blk_comment = false
                while scan_l < lines.length() && close_l < 0 {
                  let sl = lines[scan_l]
                  let mut sc = if scan_l == lidx { lb_idx + 1 } else { 0 }
                  let mut in_s = false
                  let mut in_c = false
                  let mut esc = false
                  while sc < sl.length() {
                    let ch = sl.code_unit_at(sc)
                    if in_blk_comment {
                      if ch == 42 && sc + 1 < sl.length() && sl.code_unit_at(sc + 1) == 47 {
                        in_blk_comment = false
                        sc = sc + 2
                        continue
                      }
                      sc = sc + 1
                      continue
                    }
                    if in_s {
                      if esc { esc = false }
                      else if ch == 92 { esc = true }
                      else if ch == 34 { in_s = false }
                    } else if in_c {
                      if esc { esc = false }
                      else if ch == 92 { esc = true }
                      else if ch == 39 { in_c = false }
                    } else if ch == 34 {
                      in_s = true
                    } else if ch == 39 {
                      in_c = true
                    } else if ch == 47 && sc + 1 < sl.length() && sl.code_unit_at(sc + 1) == 47 {
                      break
                    } else if ch == 47 && sc + 1 < sl.length() && sl.code_unit_at(sc + 1) == 42 {
                      in_blk_comment = true
                      sc = sc + 2
