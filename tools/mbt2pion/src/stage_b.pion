///| Stage B: Type-Directed Fixpoint Pass (`pionc check --json` + Span Map).
///|
///| Applies deterministic, table-driven rewrites keyed by `(diagnostic_code, receiver_type, method_or_op)`
///| aligned 1:1 with `tools/mbt_compat` canonical symbol names:
///| 1. Missing builtin methods -> `mbt_compat::arr_*` / `opt_*` / `str_*` / `ordered_map_*`
///| 2. Token-precise numeric literal coercions using `d.col` + lexer tokens (never appends to EOL!)
///| 3. `for k, v in map` -> `.to_array()`, `for c in s` / `for i, c in s` -> `mbt_compat::str_scalars(s)`
///| 4. `api_map.json` 2-argument unit-annotated boundary conversions (`mbt_compat::utf16_to_utf8_off(s, off)`,
///|    `mbt_compat::utf16_to_scalar_off(s, off)`, hard-failing if `str_param` is missing!) &
///|    `OrderedMap` <-> `Map` boundary conversions (`ordered_map_to_map` / `ordered_map_from_map`).

///| Map `(receiver_type_prefix, method_name)` to canonical `mbt_compat::*` helper names.
pub fn lookup_missing_method_helper(receiver_ty : String, method_name : String) -> Option[String] {
  if receiver_ty.starts_with("Array[") {
    if method_name == "map" { return Some("mbt_compat::arr_map") }
    if method_name == "filter" { return Some("mbt_compat::arr_filter") }
    if method_name == "each" { return Some("mbt_compat::arr_each") }
    if method_name == "eachi" { return Some("mbt_compat::arr_eachi") }
    if method_name == "fold" { return Some("mbt_compat::arr_fold") }
    if method_name == "mapi" { return Some("mbt_compat::arr_mapi") }
    if method_name == "last" { return Some("mbt_compat::arr_last") }
    if method_name == "insert" { return Some("mbt_compat::arr_insert") }
    if method_name == "remove" { return Some("mbt_compat::arr_remove") }
    if method_name == "sort_by" { return Some("mbt_compat::arr_sort_by") }
    if method_name == "append" { return Some("mbt_compat::arr_append") }
    if method_name == "to_array" { return Some("mbt_compat::arr_to_array") }
  }
  if receiver_ty.starts_with("Option[") {
    if method_name == "map" { return Some("mbt_compat::opt_map") }
    if method_name == "unwrap" { return Some("mbt_compat::opt_unwrap") }
    if method_name == "or" { return Some("mbt_compat::opt_or") }
    if method_name == "is_empty" { return Some("mbt_compat::opt_is_empty") }
  }
  if receiver_ty == "String" {
    if method_name == "has_prefix" { return Some("mbt_compat::str_has_prefix") }
    if method_name == "has_suffix" { return Some("mbt_compat::str_has_suffix") }
    if method_name == "to_lower" { return Some("mbt_compat::str_to_lower") }
    if method_name == "to_upper" { return Some("mbt_compat::str_to_upper") }
    if method_name == "compare" { return Some("mbt_compat::str_compare") }
    if method_name == "to_owned" { return Some("mbt_compat::str_to_owned") }
    if method_name == "iter" { return Some("mbt_compat::str_scalars") }
  }
  if receiver_ty.starts_with("OrderedMap[") || receiver_ty.starts_with("mbt_compat::OrderedMap[") {
    if method_name == "size" { return Some("mbt_compat::ordered_map_size") }
    if method_name == "each" { return Some("mbt_compat::ordered_map_each") }
    if method_name == "iter" { return Some("mbt_compat::ordered_map_iter") }
  }
  None
}

///| Extract `(method_name, receiver_type)` from `unknown method `<m>` on type `<T>``.
fn parse_unknown_method_msg(msg : String) -> Option[(String, String)] {
  let p = "unknown method `"
  let idx = msg.index_of(p)
  if idx < 0 {
    return None
  }
  let rest = msg.slice(idx + p.length(), msg.length())
  let t1 = rest.index_of("`")
  if t1 < 0 {
    return None
  }
  let mname = rest.slice(0, t1)
  let on_ty = " on type `"
  let idx2 = rest.index_of(on_ty)
  if idx2 < 0 {
    return None
  }
  let rest2 = rest.slice(idx2 + on_ty.length(), rest.length())
  let t2 = rest2.index_of("`")
  if t2 < 0 {
    return None
  }
  Some((mname, rest2.slice(0, t2)))
}

///| Find the `.method_name(` offset on `line_text` closest to 1-based column `col` (P1-5).
fn find_method_dot_at_col(line_text : String, method_name : String, col : Int) -> Int {
  let needle = "." + method_name + "("
  let n = line_text.length()
  let m = needle.length()
  let target_0 = if col > 0 { col - 1 } else { 0 }
  let mut best = -1
  let mut best_dist = 1000000
  let mut pos = 0
  while pos <= n - m {
    if line_text.slice(pos, pos + m) == needle {
      let dist = if pos >= target_0 { pos - target_0 } else { target_0 - pos }
      if dist < best_dist {
        best_dist = dist
        best = pos
      }
      pos = pos + 1
    } else {
      pos = pos + 1
    }
  }
  best
}

///| Rewrite a missing method call at `(lidx, col)` -> `helper(recv, args)`.
///| Supports:
///| - Column-precise disambiguation when multiple `.m(...)` calls share one line
///| - Multiline / newline-leading method chains (`xs\n  .map(...)\n  .filter(...)`)
///| - Complex/chained receivers (`pkg::fn(a, b).m()`, `arr[i].m()`).
fn rewrite_method_call_at(
  lines : Array[String],
  lidx : Int,
  col : Int,
  method_name : String,
  helper : String,
) -> Bool {
  let line_text = lines[lidx]
  let needle = "." + method_name + "("
  let dot_idx = find_method_dot_at_col(line_text, method_name, col)
  if dot_idx < 0 {
    return false
  }
  let arg_start = dot_idx + needle.length()
  let mut depth = 1
  let mut j = arg_start
  while j < line_text.length() && depth > 0 {
    let c = line_text.code_unit_at(j)
    if c == 40 {
      depth = depth + 1
    } else if c == 41 {
      depth = depth - 1
      if depth == 0 {
        break
      }
    }
    j = j + 1
  }
  if depth != 0 {
    return false
  }
  let args = line_text.slice(arg_start, j).trim()
  let tail = line_text.slice(j + 1, line_text.length())
  let before_dot = line_text.slice(0, dot_idx)

  // Newline-leading chain (`  .map(...)` where only whitespace precedes `.` on this line)
  if before_dot.trim().length() == 0 && lidx > 0 {
    let mut prev_l = lidx - 1
    while prev_l >= 0 && lines[prev_l].trim().length() == 0 {
      prev_l = prev_l - 1
    }
    if prev_l < 0 {
      return false
    }
    let prev_line = lines[prev_l]
    // Find receiver expression at the end of `prev_line`
    let mut r_end = prev_line.length() - 1
    while r_end >= 0 && (prev_line.code_unit_at(r_end) == 32 || prev_line.code_unit_at(r_end) == 9) {
      r_end = r_end - 1
    }
    if r_end < 0 {
      return false
    }
    let mut r_start = r_end
    let mut pd = 0
    let mut bd = 0
    while r_start >= 0 {
      let c = prev_line.code_unit_at(r_start)
      if c == 41 {
        pd = pd + 1
        r_start = r_start - 1
      } else if c == 40 {
        if pd == 0 { break }
        pd = pd - 1
        r_start = r_start - 1
      } else if c == 93 {
        bd = bd + 1
        r_start = r_start - 1
      } else if c == 91 {
        if bd == 0 { break }
        bd = bd - 1
        r_start = r_start - 1
      } else if pd > 0 || bd > 0 {
        r_start = r_start - 1
      } else if is_alnum(c) || c == 95 || c == 46 || c == 58 {
        r_start = r_start - 1
      } else {
        break
      }
    }
    r_start = r_start + 1
    if r_start > r_end {
      return false
    }
    let recv = prev_line.slice(r_start, r_end + 1)
    let call = if args.length() > 0 {
      helper + "(" + recv + ", " + args + ")"
    } else {
      helper + "(" + recv + ")"
    }
    lines[prev_l] = prev_line.slice(0, r_start) + call + tail
    lines[lidx] = ""
    return true
  }

  let mut recv_start = dot_idx - 1
  let mut paren_d = 0
  let mut brack_d = 0
  while recv_start >= 0 {
    let c = line_text.code_unit_at(recv_start)
    if c == 41 {
      paren_d = paren_d + 1
      recv_start = recv_start - 1
    } else if c == 40 {
      if paren_d == 0 {
        break
      }
      paren_d = paren_d - 1
      recv_start = recv_start - 1
    } else if c == 93 {
      brack_d = brack_d + 1
      recv_start = recv_start - 1
    } else if c == 91 {
      if brack_d == 0 {
        break
      }
      brack_d = brack_d - 1
      recv_start = recv_start - 1
    } else if paren_d > 0 || brack_d > 0 {
      recv_start = recv_start - 1
    } else if is_alnum(c) || c == 95 || c == 46 || c == 58 {
      recv_start = recv_start - 1
    } else {
      break
    }
  }
  recv_start = recv_start + 1
  if recv_start >= dot_idx {
    return false
  }
  let recv = line_text.slice(recv_start, dot_idx)
  let call = if args.length() > 0 {
    helper + "(" + recv + ", " + args + ")"
  } else {
    helper + "(" + recv + ")"
  }
  lines[lidx] = line_text.slice(0, recv_start) + call + tail
  true
}

///| Extract the argument value for a labeled argument `name=<val>` in a call line.
fn extract_labeled_arg(ln : String, name : String) -> Option[(Int, Int, String)] {
  let lbl = name + "="
  let li = ln.index_of(lbl)
  if li < 0 {
    return None
  }
  let val_start = li + lbl.length()
  let mut val_end = val_start
  let mut depth = 0
  while val_end < ln.length() {
    let c = ln.code_unit_at(val_end)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      if depth == 0 {
        break
      }
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      break
    }
    val_end = val_end + 1
  }
  Some((val_start, val_end, ln.slice(val_start, val_end).trim()))
}

///| Check whether `expr` is a pure simple identifier or string literal (safe to duplicate without side effects).
fn is_pure_str_atom(expr : String) -> Bool {
  let t = expr.trim()
  if t.length() == 0 {
    return true
  }
  if t.starts_with("\"") && t.ends_with("\"") {
    return true
  }
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    if !(is_alnum(c) || c == 95) {
      return false
    }
    i = i + 1
  }
  true
}

///| Apply `api_map.json` unit-annotated 2-arg boundary conversions (`utf16_to_utf8_off(s, off)`,
///| `utf16_to_scalar_off(s, off)`) and `OrderedMap` <-> `Map` boundary conversions.
///| Handles MULTIPLE calls on the same line and binds impure `str_param` expressions once!
///| Hard-fails (`MBT2PION_MISSING_STR_PARAM`) when `utf8`/`scalar` conversion is needed without `str_param`!
pub fn apply_api_boundary_conversions(
  content : String,
  api_map : ApiMap,
  file : String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> String {
  if api_map.symbols.length() == 0 {
    return content
  }
  let mut cur = content
  let mut tmp_seq = 0
  for sym in api_map.symbols {
    let mut needs_conv = false
    for p in sym.params {
      if p.unit == "utf8" || p.unit == "scalar" ||
      p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
        needs_conv = true
      }
    }
    if !needs_conv {
      continue
    }
    let call_name = if sym.target_pkg.length() > 0 {
      sym.target_pkg + "::" + sym.target_name
    } else {
      sym.target_name
    }
    let needle = call_name + "("
    if !str_has(cur, needle) {
      continue
    }
    let lines = cur.split("\n")
    let out_lines : Array[String] = []
    let mut lno = 0
    for ln in lines {
      lno = lno + 1
      if !str_has(ln, needle) {
        out_lines.push(ln)
        continue
      }
      // Iterate EVERY call occurrence of `call_name(...)` on this line!
      let line_sb = StringBuilder()
      let mut scan = 0
      while scan < ln.length() {
        let rest = ln.slice(scan, ln.length())
        let rel_idx = rest.index_of(needle)
        if rel_idx < 0 {
          line_sb.write_string(rest)
          break
        }
        let call_start = scan + rel_idx
        line_sb.write_string(ln.slice(scan, call_start))
        let open_p = call_start + call_name.length()
        let mut close_p = open_p + 1
        let mut depth = 1
        while close_p < ln.length() && depth > 0 {
          let c = ln.code_unit_at(close_p)
          if c == 40 {
            depth = depth + 1
          } else if c == 41 {
            depth = depth - 1
            if depth == 0 {
              break
            }
          }
          close_p = close_p + 1
        }
        if depth != 0 {
          line_sb.write_string(ln.slice(call_start, ln.length()))
          break
        }
        let mut call_text = ln.slice(call_start, close_p + 1)
        let mut pre_bind = ""
        for p in sym.params {
          if p.unit == "utf8" || p.unit == "scalar" {
            let helper = if p.unit == "utf8" { "mbt_compat::utf16_to_utf8_off" } else { "mbt_compat::utf16_to_scalar_off" }
            match extract_labeled_arg(call_text, p.name) {
              Some((val_start, val_end, raw_arg)) =>
              if !str_has(raw_arg, helper + "(") {
                if p.str_param.length() == 0 {
                  diags.push(diag_error(
                    "MBT2PION_MISSING_STR_PARAM",
                    file,
                    lno,
                    call_start + val_start + 1,
                    "api_map boundary conversion for `" + call_name + "(" + p.name + ")` requires `str_param` to supply string argument to `" + helper + "(s, off)`",
                  ))
                } else {
                  let mut str_arg = p.str_param
                  match extract_labeled_arg(call_text, p.str_param) {
                    Some((sv_start, sv_end, sv)) =>
                    if is_pure_str_atom(sv) {
                      str_arg = sv
                    } else {
                      let tname = "__mbt_s_" + tmp_seq.to_string()
                      tmp_seq = tmp_seq + 1
                      pre_bind = pre_bind + "let " + tname + " = " + sv + "; "
                      call_text = call_text.slice(0, sv_start) + tname + call_text.slice(sv_end, call_text.length())
                      str_arg = tname
                    }
                    None => ()
                  }
                  match extract_labeled_arg(call_text, p.name) {
                    Some((n_start, n_end, n_raw)) => {
                      call_text = call_text.slice(0, n_start) + helper + "(" + str_arg + ", " + n_raw + ")" + call_text.slice(n_end, call_text.length())
                      drift_ledger.push(DriftEntry::{
                        category: "string_unit_boundary",
                        file: file,
                        line: lno,
                        col: call_start + n_start + 1,
                        expr: call_name + "(" + p.name + "=" + n_raw + ")",
                        resolution: helper,
                        status: "resolved",
                        detail: "converted UTF-16 offset to " + p.unit + " at api_map boundary with string arg `" + str_arg + "`",
                      })
                    }
                    None => ()
                  }
                }
              }
              None => ()
            }
          } else if p.map_boundary == "ordered_to_map" || p.map_boundary == "map_to_ordered" {
            let helper = if p.map_boundary == "ordered_to_map" { "mbt_compat::ordered_map_to_map" } else { "mbt_compat::ordered_map_from_map" }
            match extract_labeled_arg(call_text, p.name) {
              Some((val_start, val_end, raw_arg)) =>
              if !str_has(raw_arg, helper + "(") {
                call_text = call_text.slice(0, val_start) + helper + "(" + raw_arg + ")" + call_text.slice(val_end, call_text.length())
                drift_ledger.push(DriftEntry::{
                  category: "ordered_map_boundary",
                  file: file,
                  line: lno,
                  col: call_start + val_start + 1,
                  expr: call_name + "(" + p.name + "=" + raw_arg + ")",
                  resolution: helper,
                  status: "resolved",
                  detail: "converted map boundary with " + helper,
                })
              }
              None => ()
            }
          }
        }
        if pre_bind.length() > 0 {
          line_sb.write_string("{ " + pre_bind + call_text + " }")
        } else {
          line_sb.write_string(call_text)
        }
        scan = close_p + 1
      }
      out_lines.push(line_sb.to_string())
    }
    let sb = StringBuilder()
    let mut k = 0
    while k < out_lines.length() {
      if k > 0 {
        sb.write_string("\n")
      }
      sb.write_string(out_lines[k])
      k = k + 1
    }
    cur = sb.to_string()
  }
  cur
}

///| Token-precise numeric literal coercion at 1-based column `col` on a single line.
///| Never appends to end-of-line (safe with trailing comments, parens, commas, semicolons)!
pub fn coerce_numeric_token_at_col(ln : String, col : Int, suffix_method : String) -> Option[String] {
  let toks = lex_moonbit(ln)
  let mut i = 0
  while i < toks.length() - 1 {
    let t = toks[i]
    let tok_end_col = t.col + (t.end_byte - t.start_byte)
    if (t.kind == TokenKind::IntLit || t.kind == TokenKind::Ident) && col >= t.col && col <= tok_end_col {
      // Avoid double coercion
      if i + 2 < toks.length() - 1 && toks[i + 1].kind == TokenKind::Dot && toks[i + 2].raw == suffix_method {
        return None
      }
      return Some(ln.slice(0, t.start_byte) + t.raw + "." + suffix_method + "()" + ln.slice(t.end_byte, ln.length()))
    }
    i = i + 1
  }
  None
}

///| Run Stage B type-directed fixpoint loop using `pionc check --json` callback.
///| Returns `(updated_files, iterations, final_diagnostic_histogram)`.
pub fn run_stage_b(
  files : Array[GeneratedFile],
  api_map : ApiMap,
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Array[(String, Int)]) {
  let mut cur_files : Array[GeneratedFile] = []
  for f in files {
    let with_bounds = apply_api_boundary_conversions(f.content, api_map, f.rel_path, diags, drift_ledger)
    cur_files.push(GeneratedFile::{
      rel_path: f.rel_path,
      content: with_bounds,
      source_file: f.source_file,
      anchors: f.anchors,
    })
  }

  let mut iter = 0
  let mut final_hist : Array[(String, Int)] = []

  while iter < 4 {
    let batch : Array[(String, String)] = []
    for f in cur_files {
      batch.push((f.rel_path, f.content))
    }
    let raw_json = check_fn(batch)
    let pdiags = parse_pionc_diagnostics(raw_json)

    let counts : Map[String, Int] = Map()
    for d in pdiags {
      let c = match counts.get(d.code) {
        Some(n) => n + 1
        None => 1
      }
      counts[d.code] = c
    }
    let hist_pairs : Array[(String, Int)] = []
    let keys = sorted_map_keys(counts)
    for k in keys {
      match counts.get(k) {
        Some(v) => hist_pairs.push((k, v))
        None => ()
      }
    }
    final_hist = sort_histogram(hist_pairs)
    iter = iter + 1

    if pdiags.length() == 0 {
      break
    }

    let mut changed = false
    let next_files : Array[GeneratedFile] = []
    for f in cur_files {
      let lines = f.content.split("\n")
      let mut file_changed = false
      for d in pdiags {
        if !(d.file == f.rel_path || d.file.ends_with("/" + f.rel_path)) {
          continue
        }
        let lidx = d.line - 1
        if lidx < 0 || lidx >= lines.length() {
          continue
        }
        let ln = lines[lidx]

        if d.code == "E_TYPE_MISMATCH" {
          // 1. Missing builtin method -> canonical `mbt_compat::*`
          match parse_unknown_method_msg(d.message) {
            Some((mname, rty)) =>
            match lookup_missing_method_helper(rty, mname) {
              Some(helper) =>
              if rewrite_method_call_at(lines, lidx, d.col, mname, helper) {
                file_changed = true
                if helper == "mbt_compat::str_compare" {
                  drift_ledger.push(DriftEntry::{
                    category: "string_compare",
                    file: f.rel_path,
                    line: d.line,
                    col: d.col,
                    expr: mname,
                    resolution: helper,
                    status: "resolved",
                    detail: "String::compare routed to MoonBit UTF-16 length-first comparison",
                  })
                }
              }
              None => ()
            }
            None => ()
          }
          // 2. Token-precise numeric literal coercion at `d.col` (never appends to EOL!)
          if d.found == "Int" && d.expected == "Int64" {
            match coerce_numeric_token_at_col(ln, d.col, "to_int64") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
              }
              None => ()
            }
          } else if d.found == "Int" && d.expected == "Double" {
            match coerce_numeric_token_at_col(ln, d.col, "to_double") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
              }
              None => ()
            }
          } else if d.found == "Int" && d.expected == "Byte" {
            match coerce_numeric_token_at_col(ln, d.col, "to_byte") {
              Some(new_ln) => {
                lines[lidx] = new_ln
                file_changed = true
              }
              None => ()
            }
          }
          // 4. Stage A lowered `s[a:b]` to `mbt_compat::array_slice_clamp(s, a, b)`; when `s` is `String`, route to `mbt_compat::utf16_slice`
          //    and resolve any matching `unresolved` `array_view_slice` drift entry for this file!
          if d.found == "String" && str_has(ln, "mbt_compat::array_slice_clamp(") {
            lines[lidx] = str_replace_all(ln, "mbt_compat::array_slice_clamp(", "mbt_compat::utf16_slice(")
            file_changed = true
            let mut di = 0
            while di < drift_ledger.length() {
              let de = drift_ledger[di]
              if de.category == "array_view_slice" && de.status == "unresolved" &&
              (f.rel_path == de.file || f.source_file == de.file) {
                drift_ledger[di] = DriftEntry::{
                  category: "string_utf16_slice",
                  file: de.file,
                  line: de.line,
                  col: de.col,
                  expr: de.expr,
                  resolution: "mbt_compat::utf16_slice",
                  status: "resolved",
                  detail: "String slice routed to UTF-16 clamped slice",
                }
              }
              di = di + 1
            }
          }
          // 3. `for ... in` on `OrderedMap` -> `.to_array()`, or `String` -> `str_scalars`
          if str_has(d.message, "`for ... in` requires an `Array[T]`") {
            let in_idx = ln.index_of(" in ")
            let lb_idx = ln.index_of(" {")
            if in_idx > 0 && lb_idx > in_idx {
              let iter_expr = ln.slice(in_idx + 4, lb_idx).trim()
              let binders = ln.slice(0, in_idx)
              if d.found.starts_with("Map[") || d.found.starts_with("OrderedMap[") || d.found.starts_with("mbt_compat::OrderedMap[") {
                let for_idx = binders.index_of("for ")
                if for_idx >= 0 {
                  let prefix = binders.slice(0, for_idx)
                  let vars_str = binders.slice(for_idx + 4, binders.length()).trim()
                  let comma_idx = vars_str.index_of(",")
                  if comma_idx >= 0 {
                    let k_var = vars_str.slice(0, comma_idx).trim()
                    let v_var = vars_str.slice(comma_idx + 1, vars_str.length()).trim()
                    lines[lidx] = prefix + "for __mbt_kv in " + iter_expr + ".to_array() { let " + k_var + " = __mbt_kv.0; let " + v_var + " = __mbt_kv.1" + ln.slice(lb_idx + 2, ln.length())
                  } else {
                    lines[lidx] = prefix + "for __mbt_kv in " + iter_expr + ".to_array() { let " + vars_str + " = __mbt_kv.0" + ln.slice(lb_idx + 2, ln.length())
                  }
                } else {
                  lines[lidx] = ln.slice(0, in_idx + 4) + iter_expr + ".to_array()" + ln.slice(lb_idx, ln.length())
                }
                file_changed = true
              } else if d.found == "String" {
                let helper = "mbt_compat::str_scalars"
                lines[lidx] = ln.slice(0, in_idx + 4) + helper + "(" + iter_expr + ")" + ln.slice(lb_idx, ln.length())
                file_changed = true
              }
            }
          }
        }
      }
      if file_changed {
        changed = true
        let sb = StringBuilder()
        let mut li = 0
        while li < lines.length() {
          if li > 0 {
            sb.write_string("\n")
          }
          sb.write_string(lines[li])
          li = li + 1
        }
        next_files.push(GeneratedFile::{
          rel_path: f.rel_path,
          content: sb.to_string(),
          source_file: f.source_file,
          anchors: f.anchors,
        })
      } else {
        next_files.push(f)
      }
    }
    cur_files = next_files
    if !changed {
      break
    }
  }

  (cur_files, iter, final_hist)
}
