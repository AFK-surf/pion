///| Top-level `let` + `fn init` dependency graph & deterministic topological sorter.
///|
///| Pion evaluates top-level `let` bindings strictly in file/declaration order,
///| whereas MoonBit allows forward and indirect reads through functions.
///| This module:
///| 1. Collects all top-level `let` bindings and `fn init` blocks across all files.
///| 2. Collects all top-level `fn` bodies to trace indirect reads (`let a = f()` where `f` reads `b`).
///| 3. Builds the transitive dependency graph over init items (`let` + `fn init`).
///| 4. Hard-fails with `MBT2PION_INIT_CYCLE` on any cycle.
///| 5. Emits items in deterministic topological order (tie-breaking by original MoonBit order)
///|    into a single `00_init_order.pion`, lowering `fn init` to `let __mbt_init_<file>_<n> : Unit = { ... }`.

import "json" as json

pub struct InitItem {
  id : String
  name : String
  is_fn_init : Bool
  source_file : String
  order_index : Int
  line : Int
  col : Int
  rhs_orig_col : Int
  rhs_gen_col : Int
  probe_origins : String
  code : String
  referenced_idents : Array[String]
  called_fns : Array[String]
  arg_closure_refs : Array[(String, Array[String])]
}

pub struct FnBodyRefs {
  name : String
  referenced_idents : Array[String]
  called_fns : Array[String]
  arg_closure_refs : Array[(String, Array[String])]
}

///| Sanitize a relative filename into a valid Pion identifier segment for `__mbt_init_<file>_<n>`.
pub fn sanitize_file_id(rel_path : String) -> String {
  let sb = StringBuilder()
  let n = rel_path.length()
  let mut i = 0
  while i < n {
    let c = rel_path.code_unit_at(i)
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      sb.write_string(rel_path.slice(i, i + 1))
    } else {
      sb.write_string("_")
    }
    i = i + 1
  }
  sb.to_string()
}

///| Find matching closing delimiter starting at `open_i` within `[open_i, end)`.
fn init_find_matching(tokens : Array[Token], open_i : Int, end : Int) -> Int {
  let open_k = tokens[open_i].kind
  let close_k = if open_k == TokenKind::LParen {
    TokenKind::RParen
  } else if open_k == TokenKind::LBracket {
    TokenKind::RBracket
  } else {
    TokenKind::RBrace
  }
  let mut depth = 0
  let mut i = open_i
  while i < end && i < tokens.length() {
    let k = tokens[i].kind
    if k == open_k {
      depth = depth + 1
    } else if k == close_k {
      depth = depth - 1
      if depth == 0 {
        return i
      }
    }
    i = i + 1
  }
  if end > open_i { end - 1 } else { open_i }
}

///| Collect ALL identifiers (including inside closures) from a token slice `[start, end)`.
///| Used when a closure is immediately invoked `(fn() { z })()` or passed as a call argument
///| `invoke(fn() { z })` where the callee may invoke the callback during initialization (P1-1).
fn collect_all_idents_flat(tokens : Array[Token], start : Int, end : Int) -> Array[String] {
  let seen : Map[String, Bool] = Map()
  let out : Array[String] = []
  let lim = if end < tokens.length() { end } else { tokens.length() }
  let mut i = start
  while i < lim {
    let t = tokens[i]
    if t.kind == TokenKind::Ident {
      let prev_dot_or_cc = i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      if !prev_dot_or_cc && !seen.contains(t.raw) {
        seen[t.raw] = true
        out.push(t.raw)
      }
    }
    i = i + 1
  }
  out
}

///| Collect immediate initialization-time identifier references, called functions, and
///| closures passed as arguments to calls (`callee(fn() { z })`) from `[start, end)`.
///| - Stored closures (`let f = fn() { z }`) are skipped (not executed during init).
///| - Immediately invoked closures (`(fn() { z })()`) are collected as immediate dependencies.
///| - Closures passed as call arguments (`invoke(fn() { z })`) are recorded in `arg_closure_refs`
///|   so `topo_sort_init_items` includes their captured deps when `invoke` calls its callback!
pub fn collect_init_refs_full(
  tokens : Array[Token],
  start : Int,
  end : Int,
) -> (Array[String], Array[String], Array[(String, Array[String])]) {
  let seen_val : Map[String, Bool] = Map()
  let seen_call : Map[String, Bool] = Map()
  let val_out : Array[String] = []
  let call_out : Array[String] = []
  let arg_closures : Array[(String, Array[String])] = []
  let lim = if end < tokens.length() { end } else { tokens.length() }
  let mut i = start
  while i < lim {
    let t = tokens[i]
    // Check immediately-invoked parenthesized closure `(fn(...) { ... })(...)` or `((...) => ...)(...)` (Astra P1-1)
    if t.kind == TokenKind::LParen {
      let rp = init_find_matching(tokens, i, lim)
      if rp + 1 < lim && tokens[rp + 1].kind == TokenKind::LParen {
        let mut is_iife = false
        let mut body_start = i + 1
        let mut body_end = rp
        if i + 1 < rp && tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "fn" {
          is_iife = true
          // Advance past `fn(...) [-> Ret]` to `{ ... }` body if present
          let mut scan = i + 2
          if scan < rp && tokens[scan].kind == TokenKind::LParen {
            scan = init_find_matching(tokens, scan, rp) + 1
          }
          while scan < rp && tokens[scan].kind != TokenKind::LBrace {
            scan = scan + 1
          }
          if scan < rp && tokens[scan].kind == TokenKind::LBrace {
            body_start = scan + 1
            body_end = init_find_matching(tokens, scan, rp)
          }
        } else {
          // Check arrow closure `((...) => ...)(...)` at depth 0 inside outer parens
          let mut scan = i + 1
          let mut sd = 0
          while scan < rp {
            let sk = tokens[scan].kind
            if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace {
              sd = sd + 1
            } else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace {
              sd = sd - 1
            } else if sd == 0 && sk == TokenKind::FatArrow {
              is_iife = true
              body_start = scan + 1
              body_end = rp
              break
            }
            scan = scan + 1
          }
        }
        if is_iife {
          // Immediately invoked! Recursively collect vals, calls, AND arg_closures from the body!
          let (sub_vals, sub_calls, sub_arg_clos) = collect_init_refs_full(tokens, body_start, body_end)
          for r in sub_vals {
            if !seen_val.contains(r) {
              seen_val[r] = true
              val_out.push(r)
            }
          }
          for c in sub_calls {
            if !seen_call.contains(c) {
              seen_call[c] = true
              call_out.push(c)
            }
          }
          for ac in sub_arg_clos {
            arg_closures.push(ac)
          }
          i = rp + 1
          continue
        }
      }
    }
    // Check function call `callee(...)`: if any argument is a closure, record it in `arg_closures`!
    if t.kind == TokenKind::Ident && i + 1 < lim && tokens[i + 1].kind == TokenKind::LParen {
      let prev_dot_or_cc = i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      let callee_name = t.raw
      if !prev_dot_or_cc {
        if !seen_val.contains(callee_name) {
          seen_val[callee_name] = true
          val_out.push(callee_name)
        }
        if !seen_call.contains(callee_name) {
          seen_call[callee_name] = true
          call_out.push(callee_name)
        }
      }
      let rp = init_find_matching(tokens, i + 1, lim)
      // Scan arguments for closure literals `fn(...) { ... }` or `(...) => ...`
      let mut ai = i + 2
      while ai < rp {
        let at = tokens[ai]
        if at.kind == TokenKind::Keyword && at.raw == "fn" && ai + 1 < rp && tokens[ai + 1].kind == TokenKind::LParen {
          let arp = init_find_matching(tokens, ai + 1, rp)
          let mut alb = arp + 1
          let mut ad = 0
          while alb < rp {
            let ak = tokens[alb].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket {
              ad = ad + 1
            } else if ak == TokenKind::RParen || ak == TokenKind::RBracket {
              ad = ad - 1
            } else if ak == TokenKind::LBrace && ad == 0 {
              break
            }
            alb = alb + 1
          }
          if alb < rp && tokens[alb].kind == TokenKind::LBrace {
            let arb = init_find_matching(tokens, alb, rp)
            let caps = collect_all_idents_flat(tokens, alb + 1, arb)
            if caps.length() > 0 {
              arg_closures.push((callee_name, caps))
            }
            ai = arb + 1
            continue
          }
        }
        if at.kind == TokenKind::LParen {
          let arp = init_find_matching(tokens, ai, rp)
          if arp + 1 < rp && tokens[arp + 1].kind == TokenKind::FatArrow {
            let bstart = arp + 2
            let mut bend = bstart
            if bstart < rp && tokens[bstart].kind == TokenKind::LBrace {
              bend = init_find_matching(tokens, bstart, rp) + 1
            } else {
              let mut bd = 0
              while bend < rp {
                let bk = tokens[bend].kind
                if bk == TokenKind::LParen || bk == TokenKind::LBracket || bk == TokenKind::LBrace {
                  bd = bd + 1
                } else if bk == TokenKind::RParen || bk == TokenKind::RBracket || bk == TokenKind::RBrace {
                  if bd == 0 { break }
                  bd = bd - 1
                } else if bd == 0 && bk == TokenKind::Comma {
                  break
                }
                bend = bend + 1
              }
            }
            let caps = collect_all_idents_flat(tokens, bstart, bend)
            if caps.length() > 0 {
              arg_closures.push((callee_name, caps))
            }
            ai = bend
            continue
          }
        }
        ai = ai + 1
      }
      i = i + 2
      continue
    }
    // Skip stored anonymous closure literal `fn(...) [-> Ret] { ... }`
    if t.kind == TokenKind::Keyword && t.raw == "fn" && i + 1 < lim && tokens[i + 1].kind == TokenKind::LParen {
      let rp = init_find_matching(tokens, i + 1, lim)
      let mut lb = rp + 1
      let mut d = 0
      while lb < lim {
        let bk = tokens[lb].kind
        if bk == TokenKind::LParen || bk == TokenKind::LBracket {
          d = d + 1
        } else if bk == TokenKind::RParen || bk == TokenKind::RBracket {
          d = d - 1
        } else if bk == TokenKind::LBrace && d == 0 {
          break
        }
        lb = lb + 1
      }
      if lb < lim && tokens[lb].kind == TokenKind::LBrace {
        let rb = init_find_matching(tokens, lb, lim)
        i = rb + 1
        continue
      }
    }
    // Skip stored arrow closure literal `(...) => { ... }` or `(...) => <expr>`
    if t.kind == TokenKind::LParen {
      let rp = init_find_matching(tokens, i, lim)
      if rp + 1 < lim && tokens[rp + 1].kind == TokenKind::FatArrow {
        let body_start = rp + 2
        if body_start < lim && tokens[body_start].kind == TokenKind::LBrace {
          let rb = init_find_matching(tokens, body_start, lim)
          i = rb + 1
          continue
        }
        let mut be = body_start
        let mut bd = 0
        while be < lim {
          if be > body_start && bd == 0 && tokens[be].newline_before {
            break
          }
          let bk = tokens[be].kind
          if bk == TokenKind::LParen || bk == TokenKind::LBracket || bk == TokenKind::LBrace {
            bd = bd + 1
          } else if bk == TokenKind::RParen || bk == TokenKind::RBracket || bk == TokenKind::RBrace {
            if bd == 0 {
              break
            }
            bd = bd - 1
          } else if bd == 0 && (bk == TokenKind::Comma || bk == TokenKind::Semi) {
            break
          }
          be = be + 1
        }
        i = be
        continue
      }
    }
    if t.kind == TokenKind::Ident {
      let prev_dot_or_cc = i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      if !prev_dot_or_cc {
        if !seen_val.contains(t.raw) {
          seen_val[t.raw] = true
          val_out.push(t.raw)
        }
        if i + 1 < lim && tokens[i + 1].kind == TokenKind::LParen {
          if !seen_call.contains(t.raw) {
            seen_call[t.raw] = true
            call_out.push(t.raw)
          }
        }
      }
    }
    i = i + 1
  }
  (val_out, call_out, arg_closures)
}

///| Collect immediate initialization-time identifier references and called functions from `[start, end)`.
pub fn collect_init_refs(tokens : Array[Token], start : Int, end : Int) -> (Array[String], Array[String]) {
  let (v, c, _) = collect_init_refs_full(tokens, start, end)
  (v, c)
}

///| Collect unique immediate identifier references from `[start, end)` (skipping closure bodies).
pub fn collect_ident_refs(tokens : Array[Token], start : Int, end : Int) -> Array[String] {
  let (vals, _) = collect_init_refs(tokens, start, end)
  vals
}

///| Compute transitive top-level `let` dependencies of an init item, traversing ONLY called `fn`s.
fn compute_transitive_deps(
  item_val_refs : Array[String],
  item_call_refs : Array[String],
  let_id_by_name : Map[String, Int],
  fn_val_refs_by_name : Map[String, Array[String]],
  fn_call_refs_by_name : Map[String, Array[String]],
  fn_arg_closures_by_name : Map[String, Array[(String, Array[String])]],
  self_idx : Int,
) -> Array[Int] {
  let dep_set : Map[Int, Bool] = Map()
  let visited_fns : Map[String, Bool] = Map()
  for r in item_val_refs {
    match let_id_by_name.get(r) {
      Some(target_idx) =>
      if target_idx != self_idx {
        dep_set[target_idx] = true
      }
      None => ()
    }
  }
  let work : Array[String] = []
  for c in item_call_refs {
    work.push(c)
  }
  let mut wi = 0
  while wi < work.length() {
    let fn_name = work[wi]
    wi = wi + 1
    if visited_fns.contains(fn_name) {
      continue
    }
    visited_fns[fn_name] = true
    match fn_val_refs_by_name.get(fn_name) {
      Some(vrefs) => {
        for vr in vrefs {
          match let_id_by_name.get(vr) {
            Some(target_idx) =>
            if target_idx != self_idx {
              dep_set[target_idx] = true
            }
            None => ()
          }
        }
      }
      None => ()
    }
    match fn_call_refs_by_name.get(fn_name) {
      Some(crefs) => {
        for cr in crefs {
          if !visited_fns.contains(cr) {
            work.push(cr)
          }
        }
      }
      None => ()
    }
    // Astra P1-1: propagate immediately-invoked closure deps inside called helper `fn`s!
    match fn_arg_closures_by_name.get(fn_name) {
      Some(ac_list) => {
        for pair in ac_list {
          let inner_callee = pair.0
          let caps = pair.1
          let may_invoke = match fn_call_refs_by_name.get(inner_callee) {
            Some(cc) => cc.length() > 0
            None => true
          }
          if may_invoke {
            for cap in caps {
              match let_id_by_name.get(cap) {
                Some(target_idx) =>
                if target_idx != self_idx {
                  dep_set[target_idx] = true
                }
                None => ()
              }
              if !visited_fns.contains(cap) {
                work.push(cap)
              }
            }
          }
        }
      }
      None => ()
    }
  }
  let out : Array[Int] = []
  for d in dep_set.keys() {
    out.push(d)
  }
  // Sort ints ascending
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 && out[j] > key {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

///| Topologically sort `InitItem`s (tie-breaking by `order_index`).
///| Hard-fails with `MBT2PION_INIT_CYCLE` if any cycle exists.
pub fn topo_sort_init_items(
  items : Array[InitItem],
  fn_bodies : Array[FnBodyRefs],
  diags : Array[Diag],
) -> Array[InitItem] {
  let n = items.length()
  if n == 0 {
    return []
  }
  let let_id_by_name : Map[String, Int] = Map()
  let mut i = 0
  while i < n {
    if !items[i].is_fn_init && items[i].name.length() > 0 {
      let_id_by_name[items[i].name] = i
    }
    i = i + 1
  }
  let fn_val_refs_by_name : Map[String, Array[String]] = Map()
  let fn_call_refs_by_name : Map[String, Array[String]] = Map()
  let fn_arg_closures_by_name : Map[String, Array[(String, Array[String])]] = Map()
  for fb in fn_bodies {
    fn_val_refs_by_name[fb.name] = fb.referenced_idents
    fn_call_refs_by_name[fb.name] = fb.called_fns
    fn_arg_closures_by_name[fb.name] = fb.arg_closure_refs
  }

  // Adjacency: edge dep -> item (dep must initialize before item)
  let adj : Array[Array[Int]] = []
  let indeg : Array[Int] = []
  i = 0
  while i < n {
    adj.push([])
    indeg.push(0)
    i = i + 1
  }
  i = 0
  while i < n {
    // Merge captured identifiers from closures passed to calls during init (P1-1):
    // if the callee is external/unknown OR calls a function/parameter, include its captured deps!
    let eff_vals : Array[String] = []
    for vr in items[i].referenced_idents {
      eff_vals.push(vr)
    }
    let eff_calls : Array[String] = []
    for cr in items[i].called_fns {
      eff_calls.push(cr)
    }
    for pair in items[i].arg_closure_refs {
      let callee = pair.0
      let caps = pair.1
      let may_invoke = match fn_call_refs_by_name.get(callee) {
        Some(cc) => cc.length() > 0
        None => true
      }
      if may_invoke {
        for cap in caps {
          eff_vals.push(cap)
          eff_calls.push(cap)
        }
      }
    }
    let deps = compute_transitive_deps(
      eff_vals,
      eff_calls,
      let_id_by_name,
      fn_val_refs_by_name,
      fn_call_refs_by_name,
      fn_arg_closures_by_name,
      i,
    )
    for d in deps {
      adj[d].push(i)
      indeg[i] = indeg[i] + 1
    }
    i = i + 1
  }

  // Kahn's algorithm picking minimum `order_index` among ready nodes (deterministic tie-break)
  let emitted : Array[Bool] = []
  i = 0
  while i < n {
    emitted.push(false)
    i = i + 1
  }
  let sorted : Array[InitItem] = []
  let mut step = 0
  while step < n {
    let mut best = -1
    let mut j = 0
    while j < n {
      if !emitted[j] && indeg[j] == 0 {
        if best < 0 || items[j].order_index < items[best].order_index {
          best = j
        }
      }
      j = j + 1
    }
    if best < 0 {
      // Cycle detected: report all remaining nodes deterministically
      let cyc_names = StringBuilder()
      let mut first = true
      let mut first_idx = -1
      let mut k = 0
      while k < n {
        if !emitted[k] {
          if first_idx < 0 {
            first_idx = k
          }
          if !first {
            cyc_names.write_string(" -> ")
          }
          cyc_names.write_string(items[k].id)
          first = false
        }
        k = k + 1
      }
      let blame = if first_idx >= 0 { items[first_idx] } else { items[0] }
      diags.push(diag_error(
        "MBT2PION_INIT_CYCLE",
        blame.source_file,
        blame.line,
        blame.col,
        "cyclic top-level initialization dependency detected: " + cyc_names.to_string(),
      ))
      return []
    }
    emitted[best] = true
    sorted.push(items[best])
    for nxt in adj[best] {
      indeg[nxt] = indeg[nxt] - 1
    }
    step = step + 1
  }
  sorted
}

///| Render `00_init_order.pion` body from topologically sorted `InitItem`s.
pub fn render_init_order_file(sorted : Array[InitItem]) -> String {
  let sb = StringBuilder()
  sb.write_string("///| Topologically ordered top-level initializers (`let` and `fn init`).\n")
  sb.write_string("///| Emitted in deterministic dependency order to guarantee initialization safety.\n\n")
  for it in sorted {
    sb.write_string(
      "// origin: " +
      it.source_file +
      ":" +
      it.line.to_string() +
      ":" +
      it.col.to_string() +
      ":" +
      it.rhs_orig_col.to_string() +
      ":" +
      it.rhs_gen_col.to_string() +
      "\n",
    )
    if it.probe_origins.length() > 0 {
      sb.write_string("// origin-probes: " + it.probe_origins + "\n")
    }
    sb.write_string(it.code)
    if !it.code.ends_with("\n") {
      sb.write_string("\n")
    }
    sb.write_string("\n")
  }
  sb.to_string()
}

///| Collect top-level symbol names defined in a MoonBit source file for symbol-graph closure analysis.
fn collect_file_defined_symbols(content : String) -> Array[String] {
  let toks = lex_moonbit(content)
  let n = toks.length() - 1
  let seen : Map[String, Bool] = Map()
  let out : Array[String] = []
  let mut i = 0
  let mut depth = 0
  while i < n {
    let t = toks[i]
    if depth == 0 && t.kind == TokenKind::Keyword {
      if t.raw == "fn" && i + 1 < n {
        let mut ni = i + 1
        if toks[ni].kind == TokenKind::LBracket {
          ni = init_find_matching(toks, ni, n) + 1
        }
        if ni < n && (toks[ni].kind == TokenKind::Ident || toks[ni].kind == TokenKind::UpperIdent) && toks[ni].raw != "init" {
          let nm = toks[ni].raw
          if !seen.contains(nm) { seen[nm] = true; out.push(nm) }
        }
      } else if (t.raw == "let" || t.raw == "const") && i + 1 < n {
        let mut ni = i + 1
        if toks[ni].kind == TokenKind::Keyword && toks[ni].raw == "mut" && ni + 1 < n {
          ni = ni + 1
        }
        if ni < n && (toks[ni].kind == TokenKind::Ident || toks[ni].kind == TokenKind::UpperIdent) {
          let nm = toks[ni].raw
          if !seen.contains(nm) { seen[nm] = true; out.push(nm) }
        }
      } else if (t.raw == "struct" || t.raw == "type" || t.raw == "typealias" || t.raw == "trait") && i + 1 < n {
        if toks[i + 1].kind == TokenKind::UpperIdent || toks[i + 1].kind == TokenKind::Ident {
          let nm = toks[i + 1].raw
          if !seen.contains(nm) { seen[nm] = true; out.push(nm) }
        }
      } else if t.raw == "enum" && i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        let ename = toks[i + 1].raw
        if !seen.contains(ename) { seen[ename] = true; out.push(ename) }
        let mut lb = i + 2
        if lb < n && toks[lb].kind == TokenKind::LBracket {
          lb = init_find_matching(toks, lb, n) + 1
        }
        if lb < n && toks[lb].kind == TokenKind::LBrace {
          let rb = init_find_matching(toks, lb, n)
          let mut k = lb + 1
          let mut ed = 0
          while k < rb {
            let kk = toks[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { ed = ed + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { ed = ed - 1 }
            else if ed == 0 && kk == TokenKind::UpperIdent {
              let prev_c = k > lb + 1 && (toks[k - 1].kind == TokenKind::Colon || toks[k - 1].kind == TokenKind::ColonColon)
              if !prev_c && !seen.contains(toks[k].raw) {
                seen[toks[k].raw] = true
                out.push(toks[k].raw)
              }
            }
            k = k + 1
          }
          i = rb + 1
          continue
        }
      }
    }
    if t.kind == TokenKind::LParen || t.kind == TokenKind::LBracket || t.kind == TokenKind::LBrace {
      depth = depth + 1
    } else if t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket || t.kind == TokenKind::RBrace {
      if depth > 0 { depth = depth - 1 }
    }
    i = i + 1
  }
  out
}

fn closure_is_shadowed(scopes : Array[Map[String, Bool]], name : String) -> Bool {
  let mut k = scopes.length() - 1
  while k >= 0 {
    if scopes[k].contains(name) {
      return true
    }
    k = k - 1
  }
  false
}

///| Extract parameter names from a `(...)` parameter list into `target_scope`.
fn closure_collect_params(toks : Array[Token], open_p : Int, close_p : Int, target : Map[String, Bool]) -> Unit {
  let mut i = open_p + 1
  let mut d = 0
  let mut at_param_start = true
  while i < close_p {
    let k = toks[i].kind
    if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
      d = d + 1
      at_param_start = false
    } else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    } else if d == 0 && k == TokenKind::Comma {
      at_param_start = true
    } else if d == 0 && at_param_start {
      if k == TokenKind::Ident {
        target[toks[i].raw] = true
        at_param_start = false
      } else if k == TokenKind::Keyword && (toks[i].raw == "mut") {
        // skip `mut`
        let _ = 0
      } else {
        at_param_start = false
      }
    }
    i = i + 1
  }
}

fn is_expr_continuation(prev_tok : Token, cur_tok : Token) -> Bool {
  let pk = prev_tok.kind
  let rk = cur_tok.kind
  let prev_cont =
  pk == TokenKind::PipePipe || pk == TokenKind::AmpAmp ||
  pk == TokenKind::Plus || pk == TokenKind::Minus ||
  pk == TokenKind::Star || pk == TokenKind::Slash || pk == TokenKind::Percent ||
  pk == TokenKind::EqEq || pk == TokenKind::BangEq ||
  pk == TokenKind::Lt || pk == TokenKind::LtEq || pk == TokenKind::Gt || pk == TokenKind::GtEq ||
  pk == TokenKind::Pipe || pk == TokenKind::Amp || pk == TokenKind::Caret ||
  pk == TokenKind::Shl || pk == TokenKind::Shr || pk == TokenKind::PipeGt ||
  pk == TokenKind::Eq || pk == TokenKind::AssignOp || pk == TokenKind::QuestionEq ||
  pk == TokenKind::Dot || pk == TokenKind::Comma || pk == TokenKind::Colon ||
  pk == TokenKind::Arrow || pk == TokenKind::FatArrow || pk == TokenKind::Question ||
  pk == TokenKind::DotDot || pk == TokenKind::DotDotLt || pk == TokenKind::DotDotEq ||
  (pk == TokenKind::Keyword && (
    prev_tok.raw == "if" || prev_tok.raw == "else" || prev_tok.raw == "match" ||
    prev_tok.raw == "try" || prev_tok.raw == "as" || prev_tok.raw == "is" ||
    prev_tok.raw == "in" || prev_tok.raw == "return" || prev_tok.raw == "raise"
  ))
  if prev_cont {
    return true
  }
  rk == TokenKind::Dot || rk == TokenKind::PipeGt ||
  rk == TokenKind::PipePipe || rk == TokenKind::AmpAmp ||
  rk == TokenKind::Plus || rk == TokenKind::Minus ||
  rk == TokenKind::Star || rk == TokenKind::Slash || rk == TokenKind::Percent ||
  rk == TokenKind::EqEq || rk == TokenKind::BangEq ||
  rk == TokenKind::Lt || rk == TokenKind::LtEq || rk == TokenKind::Gt || rk == TokenKind::GtEq ||
  rk == TokenKind::Pipe || rk == TokenKind::Amp || rk == TokenKind::Caret ||
  rk == TokenKind::Shl || rk == TokenKind::Shr || rk == TokenKind::Question ||
  rk == TokenKind::DotDot || rk == TokenKind::DotDotLt || rk == TokenKind::DotDotEq ||
  (rk == TokenKind::Keyword && (
    cur_tok.raw == "else" || cur_tok.raw == "catch" || cur_tok.raw == "as" || cur_tok.raw == "is"
  ))
}

///| Compute deterministic per-file symbol-graph dependency closures and render JSON (`--closure-report`, Wave M1.2 A.4).
///| Lexically scope-aware: skips function parameters, `let`/`for` locals, and closure bindings so shadowed names
///| never create false cross-file dependency edges!
pub fn render_closure_report_json(sources : Array[SourceFile]) -> String {
  let sorted = sort_source_files(sources)
  let sym_owners : Map[String, Array[String]] = Map()
  for sf in sorted {
    let defs = collect_file_defined_symbols(sf.content)
    for d in defs {
      match sym_owners.get(d) {
        Some(xs) => xs.push(sf.rel_path)
        None => sym_owners[d] = [sf.rel_path]
      }
    }
  }
  let direct_deps_by_file : Map[String, Array[String]] = Map()
  let mut total_edges = 0
  for sf in sorted {
    let toks = lex_moonbit(sf.content)
    let n = toks.length() - 1
    let dep_set : Map[String, Bool] = Map()
    let scopes : Array[Map[String, Bool]] = []
    let mut pending_scope : Map[String, Bool] = Map()
    // Deferred local `let` bindings `(bind_at_tok, var_name)` so RHS of `let x = x()` sees OLD scope!
    let deferred_lets : Array[(Int, String)] = []
    let mut i = 0
    while i < n {
      let mut di = 0
      while di < deferred_lets.length() {
        if deferred_lets[di].0 == i && scopes.length() > 0 {
          scopes[scopes.length() - 1][deferred_lets[di].1] = true
        }
        di = di + 1
      }
      let t = toks[i]
      if t.kind == TokenKind::LBrace {
        scopes.push(pending_scope)
        pending_scope = Map()
        i = i + 1
        continue
      }
      if t.kind == TokenKind::RBrace {
        if scopes.length() > 0 {
          let _ = scopes.pop()
        }
        i = i + 1
        continue
      }
      // `fn [name](params)` -> bind params in the upcoming `{` scope
      if t.kind == TokenKind::Keyword && t.raw == "fn" {
        let mut p = i + 1
        if p < n && toks[p].kind == TokenKind::LBracket {
          p = init_find_matching(toks, p, n) + 1
        }
        // Skip optional `Type::` or method/fn name
        while p < n && (toks[p].kind == TokenKind::Ident || toks[p].kind == TokenKind::UpperIdent || toks[p].kind == TokenKind::ColonColon) {
          p = p + 1
        }
        if p < n && toks[p].kind == TokenKind::LParen {
          let cp = init_find_matching(toks, p, n)
          closure_collect_params(toks, p, cp, pending_scope)
          // Advance past `fn ... (` params only for parameter names (still scan parameter type annotations!)
          i = p + 1
          continue
        }
      }
      // Local `let [mut] x [: T] = <rhs>` inside a block -> scan `<rhs>` with OLD scope, bind `x` AFTER `<rhs>`!
      if scopes.length() > 0 && t.kind == TokenKind::Keyword && t.raw == "let" {
        let mut p = i + 1
        if p < n && toks[p].kind == TokenKind::Keyword && toks[p].raw == "mut" {
          p = p + 1
        }
        if p < n && toks[p].kind == TokenKind::Ident {
          let vname = toks[p].raw
          // Find `=` at depth 0, then find end of `<rhs>` at depth 0
          let mut eq_i = p + 1
          let mut td = 0
          while eq_i < n {
            let ek = toks[eq_i].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { td = td + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { if td > 0 { td = td - 1 } else { break } }
            else if td == 0 && ek == TokenKind::Eq { break }
            eq_i = eq_i + 1
          }
          if eq_i < n && toks[eq_i].kind == TokenKind::Eq {
            let mut rhs_end = eq_i + 1
            let mut rd = 0
            while rhs_end < n {
              let rk = toks[rhs_end].kind
              if rd == 0 && rhs_end > eq_i + 1 && toks[rhs_end].newline_before {
                if !is_expr_continuation(toks[rhs_end - 1], toks[rhs_end]) { break }
              }
              if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
              else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                if rd == 0 { break }
                rd = rd - 1
              } else if rd == 0 && rk == TokenKind::Semi {
                break
              }
              rhs_end = rhs_end + 1
            }
            deferred_lets.push((rhs_end, vname))
          } else {
            scopes[scopes.length() - 1][vname] = true
          }
          i = p + 1
          continue
        }
      }
      // `for x [, y] in` -> bind loop vars in upcoming `{` scope
      if t.kind == TokenKind::Keyword && t.raw == "for" {
        let mut p = i + 1
        while p < n && !(toks[p].kind == TokenKind::Keyword && toks[p].raw == "in") && toks[p].kind != TokenKind::Eq && toks[p].kind != TokenKind::LBrace {
          if toks[p].kind == TokenKind::Ident {
            pending_scope[toks[p].raw] = true
          }
          p = p + 1
        }
        i = p + 1
        continue
      }
      if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent {
        let prev_dot_cc = i > 0 && (toks[i - 1].kind == TokenKind::Dot || toks[i - 1].kind == TokenKind::ColonColon)
        let is_param_decl = i + 1 < n && toks[i + 1].kind == TokenKind::Colon && scopes.length() == 0
        if !prev_dot_cc && !is_param_decl && !closure_is_shadowed(scopes, t.raw) {
          match sym_owners.get(t.raw) {
            Some(owners) => {
              for ow in owners {
                if ow != sf.rel_path {
                  dep_set[ow] = true
                }
              }
            }
            None => ()
          }
        }
      }
      i = i + 1
    }
    let deps = sorted_map_keys(dep_set)
    total_edges = total_edges + deps.length()
    direct_deps_by_file[sf.rel_path] = deps
  }

  let file_entries : Array[json::JsonValue] = []
  let closure_sizes : Array[Int] = []
  let leaf_files : Array[json::JsonValue] = []
  for sf in sorted {
    // BFS transitive closure
    let visited : Map[String, Bool] = Map()
    let queue : Array[String] = [sf.rel_path]
    visited[sf.rel_path] = true
    let mut qi = 0
    while qi < queue.length() {
      let cur = queue[qi]
      qi = qi + 1
      match direct_deps_by_file.get(cur) {
        Some(ds) => {
          for d in ds {
            if !visited.contains(d) {
              visited[d] = true
              queue.push(d)
            }
          }
        }
        None => ()
      }
    }
    let closure_list = sorted_map_keys(visited)
    let csize = closure_list.length()
    closure_sizes.push(csize)
    if csize == 1 {
      leaf_files.push(json_str(sf.rel_path))
    }
    let ddeps = match direct_deps_by_file.get(sf.rel_path) {
      Some(xs) => xs
      None => []
    }
    let d_json : Array[json::JsonValue] = []
    for d in ddeps { d_json.push(json_str(d)) }
    let c_json : Array[json::JsonValue] = []
    for c in closure_list { c_json.push(json_str(c)) }
    file_entries.push(json_obj([
      json_field("file", json_str(sf.rel_path)),
      json_field("direct_dep_count", json_int(ddeps.length())),
      json_field("closure_size", json_int(csize)),
      json_field("direct_deps", json_arr(d_json)),
      json_field("closure", json_arr(c_json)),
    ]))
  }

  // Sort closure_sizes ascending for min/median/max
  let mut si = 1
  while si < closure_sizes.length() {
    let key = closure_sizes[si]
    let mut sj = si - 1
    while sj >= 0 && closure_sizes[sj] > key {
      closure_sizes[sj + 1] = closure_sizes[sj]
      sj = sj - 1
    }
    closure_sizes[sj + 1] = key
    si = si + 1
  }
  let n_files = closure_sizes.length()
  let min_c = if n_files > 0 { closure_sizes[0] } else { 0 }
  let max_c = if n_files > 0 { closure_sizes[n_files - 1] } else { 0 }
  let med_c = if n_files > 0 { closure_sizes[n_files / 2] } else { 0 }

  let root = json_obj([
    json_field("schema_version", json_int(1)),
    json_field("file_count", json_int(n_files)),
    json_field("direct_edge_count", json_int(total_edges)),
    json_field("min_closure_size", json_int(min_c)),
    json_field("median_closure_size", json_int(med_c)),
    json_field("max_closure_size", json_int(max_c)),
    json_field("leaf_file_count", json_int(leaf_files.length())),
    json_field("leaf_files", json_arr(leaf_files)),
    json_field("files", json_arr(file_entries)),
  ])
  json::stringify(root) + "\n"
}
