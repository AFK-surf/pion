///| Package interface & symbol table loader:
///| - Parses `api_map.json` with strict `unit` validation on offset-like Int params/returns
///| - Parses `recipes.toml` (declarative, zero hardcoded project identifiers)
///| - Parses `.mbti` (`pkg.generated.mbti`) and `pionc doc --json` symbol tables
///| - Resolves cross-package enum constructors & detects ambiguities with source spans

import "json" as json

///| Valid string unit annotations in `api_map.json`.
pub fn is_valid_unit(u : String) -> Bool {
  u == "utf8" || u == "utf16" || u == "scalar" || u == "none"
}

///| Heuristic check for string offset/length-like parameter/field names that MUST carry
///| an explicit `unit` annotation (`utf8`/`utf16`/`scalar`/`none`) in `api_map.json`.
pub fn is_offset_like_name(name : String) -> Bool {
  let s = ascii_to_lower(name)
  s == "offset" ||
  s == "byte_offset" ||
  s == "char_offset" ||
  s == "utf8_offset" ||
  s == "utf16_offset" ||
  s == "index" ||
  s == "idx" ||
  s == "pos" ||
  s == "start" ||
  s == "end" ||
  s == "len" ||
  s == "length" ||
  s == "cursor" ||
  s == "caret" ||
  s == "selection_start" ||
  s == "selection_end" ||
  s.ends_with("_offset") ||
  s.ends_with("_idx") ||
  s.ends_with("_index") ||
  s.ends_with("_len") ||
  s.ends_with("_length") ||
  s.ends_with("_pos")
}

fn j_str(v : json::JsonValue, key : String, def : String) -> String {
  match json::obj_get(v, key) {
    Some(x) =>
    match json::as_str(x) {
      Some(s) => s
      None => def
    }
    None => def
  }
}

fn j_bool(v : json::JsonValue, key : String, def : Bool) -> Bool {
  match json::obj_get(v, key) {
    Some(x) =>
    match json::as_bool(x) {
      Some(b) => b
      None => def
    }
    None => def
  }
}

fn j_int(v : json::JsonValue, key : String, def : Int) -> Int {
  match json::obj_get(v, key) {
    Some(x) =>
    match json::as_int(x) {
      Some(n) => n.to_int()
      None => def
    }
    None => def
  }
}

///| Parse `api_map.json` and validate all string-offset unit annotations.
///| Hard-fails (emits error diagnostics) if any offset-like `Int` param/return lacks a valid `unit`.
pub fn parse_api_map(content : String, path : String, diags : Array[Diag]) -> ApiMap {
  let out = empty_api_map()
  if content.trim().length() == 0 {
    return out
  }
  let root = match json::parse(content) {
    Ok(v) => v
    Err(e) => {
      diags.push(diag_error("MBT2PION_APIMAP_PARSE", path, 1, 1, "failed to parse api_map.json: " + e))
      return out
    }
  }
  match json::obj_get(root, "pkg_aliases") {
    Some(json::JsonValue::JObj(fields)) => {
      for f in fields {
        match json::as_str(f.value) {
          Some(v) => out.pkg_aliases[f.key] = v
          None => ()
        }
      }
    }
    _ => ()
  }
  match json::obj_get(root, "symbols") {
    Some(arr_v) =>
    match json::as_arr(arr_v) {
      Some(items) => {
        for item in items {
          let src_pkg = j_str(item, "src_pkg", "")
          let src_name = j_str(item, "src_name", "")
          let kind = j_str(item, "kind", "fn")
          let target_pkg = j_str(item, "target_pkg", src_pkg)
          let target_name = j_str(item, "target_name", src_name)
          let target_enum = j_str(item, "target_enum", "")
          let explicit_arity = j_int(item, "arity", -1)
          let ret_ty = j_str(item, "ret_ty", "")
          let ret_unit = j_str(item, "ret_unit", "")
          let ret_map_boundary = j_str(item, "ret_map_boundary", "none")
          let autofill_loc = j_bool(item, "autofill_loc", false)
          let external_tilde_default = j_bool(item, "external_tilde_default", false)
          let params : Array[ApiParam] = []
          match json::obj_get(item, "params") {
            Some(pv) =>
            match json::as_arr(pv) {
              Some(pitems) => {
                for pi in pitems {
                  let pname = j_str(pi, "name", "")
                  let pty = {
                    let t1 = j_str(pi, "ty", "")
                    if t1.length() > 0 { t1 } else { j_str(pi, "type", "") }
                  }
                  let punit = j_str(pi, "unit", "")
                  let pstr_param = j_str(pi, "str_param", "")
                  let pmb = j_str(pi, "map_boundary", "none")
                  let is_opt = j_bool(pi, "is_optional", false) || j_bool(pi, "is_labeled", false)
                  let has_def = j_bool(pi, "has_default", false)
                  if pty == "Int" && is_offset_like_name(pname) {
                    if !is_valid_unit(punit) {
                      diags.push(diag_error(
                        "MBT2PION_UNTAGGED_UNIT",
                        path,
                        1,
                        1,
                        "api_map symbol `" + src_pkg + "::" + src_name + "` offset-like Int param `" + pname + "` must declare explicit `unit` (`utf8`|`utf16`|`scalar`|`none`), got `" + punit + "`",
                      ))
                    }
                  } else if punit.length() > 0 && !is_valid_unit(punit) {
                    diags.push(diag_error(
                      "MBT2PION_INVALID_UNIT",
                      path,
                      1,
                      1,
                      "api_map symbol `" + src_pkg + "::" + src_name + "` param `" + pname + "` has invalid unit `" + punit + "`",
                    ))
                  }
                  params.push(ApiParam::{
                    name: pname,
                    ty: pty,
                    is_optional: is_opt,
                    has_default: has_def,
                    unit: if punit.length() == 0 { "none" } else { punit },
                    str_param: pstr_param,
                    map_boundary: pmb,
                  })
                }
              }
              None => ()
            }
            None => ()
          }
          if ret_ty == "Int" && is_offset_like_name(src_name) && !is_valid_unit(ret_unit) {
            diags.push(diag_error(
              "MBT2PION_UNTAGGED_UNIT",
              path,
              1,
              1,
              "api_map symbol `" + src_pkg + "::" + src_name + "` offset-like Int return must declare explicit `ret_unit` (`utf8`|`utf16`|`scalar`|`none`)",
            ))
          }
          out.symbols.push(ApiSymbol::{
            src_pkg: src_pkg,
            src_name: src_name,
            kind: kind,
            target_pkg: target_pkg,
            target_name: target_name,
            target_enum: target_enum,
            arity: explicit_arity,
            params: params,
            ret_ty: ret_ty,
            ret_unit: if ret_unit.length() == 0 { "none" } else { ret_unit },
            ret_map_boundary: ret_map_boundary,
            autofill_loc: autofill_loc,
            external_tilde_default: external_tilde_default,
          })
        }
      }
      None => ()
    }
    None => ()
  }
  out
}

///| Strip surrounding double quotes from a TOML string scalar.
fn unquote_toml(s : String) -> String {
  let t = s.trim()
  if t.length() >= 2 && t.starts_with("\"") && t.ends_with("\"") {
    return t.slice(1, t.length() - 1)
  }
  t
}

///| Decode a TOML double-quoted string literal (including `\n`, `\r`, `\t`, `\"`, `\\`, `\uHHHH`).
fn decode_toml_string_lit(raw : String) -> Result[String, String] {
  decode_mbt_string_lit(raw)
}

///| Parse `[comments]` `replace = [{ from = "...", to = "..." }, ...]` array via `lex_moonbit`.
fn parse_comments_replace_array(
  raw_arr : String,
  path : String,
  line_no : Int,
  out : Array[CommentReplaceRule],
  seen_from : Map[String, Bool],
  diags : Array[Diag],
) -> Unit {
  let toks = lex_moonbit(raw_arr)
  let n = toks.length() - 1
  if n < 2 || toks[0].kind != TokenKind::LBracket {
    diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "[comments] `replace` must be an array of `{ from = \"...\", to = \"...\" }` tables"))
    return
  }
  let rb = find_matching_delim(toks, 0)
  if rb >= n || toks[rb].kind != TokenKind::RBracket {
    diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "unclosed `[` in [comments] `replace`"))
    return
  }
  let mut k = 1
  while k < rb {
    if toks[k].kind == TokenKind::Comma {
      k = k + 1
      continue
    }
    if toks[k].kind != TokenKind::LBrace {
      diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "expected `{ from = \"...\", to = \"...\" }` in [comments] `replace` near `" + toks[k].raw + "`"))
      return
    }
    let cb = find_matching_delim(toks, k)
    if cb >= rb || toks[cb].kind != TokenKind::RBrace {
      diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "unclosed `{` in [comments] `replace`"))
      return
    }
    let mut has_from = false
    let mut has_to = false
    let mut from_val = ""
    let mut to_val = ""
    let mut j = k + 1
    while j < cb {
      if toks[j].kind == TokenKind::Comma {
        j = j + 1
        continue
      }
      if (toks[j].kind == TokenKind::Ident || toks[j].kind == TokenKind::Keyword) &&
      j + 2 < cb && toks[j + 1].kind == TokenKind::Eq && toks[j + 2].kind == TokenKind::StringLit {
        let kname = toks[j].raw
        match decode_toml_string_lit(toks[j + 2].raw) {
          Ok(decoded) =>
          if kname == "from" {
            has_from = true
            from_val = decoded
          } else if kname == "to" {
            has_to = true
            to_val = decoded
          } else {
            diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "unknown key `" + kname + "` in [comments] `replace` entry"))
          }
          Err(e) =>
          diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "invalid string in [comments] `replace`: " + e))
        }
        j = j + 3
        continue
      }
      diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "malformed key/value in [comments] `replace` near `" + toks[j].raw + "`"))
      j = j + 1
    }
    if !has_from || !has_to {
      diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "[comments] `replace` entry requires both `from` and `to`"))
    } else if from_val.length() == 0 {
      diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "[comments] `replace` entry has empty `from`"))
    } else if seen_from.contains(from_val) {
      diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "duplicate `from` key `" + from_val + "` in [comments] `replace`"))
    } else {
      let mut has_nl = false
      let mut ti = 0
      while ti < to_val.length() {
        let tc = to_val.code_unit_at(ti)
        if tc == 10 || tc == 13 {
          has_nl = true
          break
        }
        ti = ti + 1
      }
      if has_nl {
        diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "[comments] `replace` `to` value for `" + from_val + "` must not contain newline (`\\n` or `\\r`)"))
      } else {
        seen_from[from_val] = true
        out.push(CommentReplaceRule::{ from: from_val, to: to_val })
      }
    }
    k = cb + 1
  }
}

///| Count net `[` minus `]` outside string literals on a line.
fn net_bracket_delta(s : String) -> Int {
  let mut delta = 0
  let mut in_str = false
  let mut esc = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if in_str {
      if esc { esc = false }
      else if c == 92 { esc = true }
      else if c == 34 { in_str = false }
    } else if c == 34 {
      in_str = true
    } else if c == 35 {
      // TOML `#` comment to EOL
      break
    } else if c == 91 {
      delta = delta + 1
    } else if c == 93 {
      delta = delta - 1
    }
    i = i + 1
  }
  delta
}

///| Parse declarative `recipes.toml` (supports `[ref]`, `[eq]`, `[derives]`, `[comments]`, `[[trait_impl]]`).
pub fn parse_recipes_toml(content : String, path : String, diags : Array[Diag]) -> Recipes {
  let mut ref_enabled = false
  let mut ref_ctor = ""
  let mut ref_field = "v"
  let mut ref_type = ""
  let mut eq_wrapper = ""
  let mut eq_prefix = "__mbt_eq_"
  let allowed_derives : Array[String] = ["Eq"]
  let ignored_derives : Array[String] = []
  let trait_recipes : Array[TraitRecipe] = []
  let asset_bypass : Array[AssetBypassRule] = []
  let comment_replaces : Array[CommentReplaceRule] = []
  let seen_comment_from : Map[String, Bool] = Map()
  let mut collecting_comments_arr = false
  let mut comments_arr_buf = StringBuilder()
  let mut comments_arr_depth = 0
  let mut comments_arr_line = 0

  let mut section = ""
  let mut cur_derive = ""
  let mut cur_trait = ""
  let mut cur_method = ""
  let mut cur_kind = "eq"
  let mut in_trait_item = false
  let mut in_asset_item = false
  let mut cur_asset_path = ""
  let mut cur_asset_sha = ""
  let mut cur_asset_reason = ""
  let mut cur_asset_decls : Array[String] = []

  let lines = content.split("\n")
  let mut line_no = 0
  for raw_line in lines {
    line_no = line_no + 1
    let line = raw_line.trim()
    if collecting_comments_arr {
      if line.length() == 0 || line.starts_with("#") {
        continue
      }
      comments_arr_buf.write_string("\n")
      comments_arr_buf.write_string(line)
      comments_arr_depth = comments_arr_depth + net_bracket_delta(line)
      if comments_arr_depth <= 0 {
        collecting_comments_arr = false
        parse_comments_replace_array(comments_arr_buf.to_string(), path, comments_arr_line, comment_replaces, seen_comment_from, diags)
      }
      continue
    }
    if line.length() == 0 || line.starts_with("#") {
      continue
    }
    if line.starts_with("[[") && line.ends_with("]]") {
      if in_trait_item && cur_derive.length() > 0 && cur_trait.length() > 0 {
        trait_recipes.push(TraitRecipe::{
          derive_name: cur_derive,
          target_trait: cur_trait,
          method_name: cur_method,
          kind: cur_kind,
        })
      }
      if in_asset_item && cur_asset_path.length() > 0 {
        asset_bypass.push(AssetBypassRule::{
          path: cur_asset_path,
          sha256: cur_asset_sha,
          reason: if cur_asset_reason.length() > 0 { cur_asset_reason } else { "manifest_asset_bypass" },
          allowed_decls: cur_asset_decls,
        })
      }
      section = line.slice(2, line.length() - 2).trim()
      in_trait_item = section == "trait_impl"
      in_asset_item = section == "asset_bypass" || section == "assets.bypass"
      cur_derive = ""
      cur_trait = ""
      cur_method = ""
      cur_kind = "eq"
      cur_asset_path = ""
      cur_asset_sha = ""
      cur_asset_reason = ""
      cur_asset_decls = []
      continue
    }
    if line.starts_with("[") && line.ends_with("]") {
      if in_trait_item && cur_derive.length() > 0 && cur_trait.length() > 0 {
        trait_recipes.push(TraitRecipe::{
          derive_name: cur_derive,
          target_trait: cur_trait,
          method_name: cur_method,
          kind: cur_kind,
        })
      }
      if in_asset_item && cur_asset_path.length() > 0 {
        asset_bypass.push(AssetBypassRule::{
          path: cur_asset_path,
          sha256: cur_asset_sha,
          reason: if cur_asset_reason.length() > 0 { cur_asset_reason } else { "manifest_asset_bypass" },
          allowed_decls: cur_asset_decls,
        })
      }
      in_trait_item = false
      in_asset_item = false
      section = line.slice(1, line.length() - 1).trim()
      continue
    }
    let eq_idx = line.index_of("=")
    if eq_idx < 0 {
      diags.push(diag_error("MBT2PION_RECIPE_PARSE", path, line_no, 1, "invalid recipes.toml line: " + line))
      continue
    }
    let key = line.slice(0, eq_idx).trim()
    let val_s = line.slice(eq_idx + 1, line.length()).trim()
    if section == "ref" {
      if key == "enabled" {
        ref_enabled = val_s == "true"
      } else if key == "ctor_call" {
        ref_ctor = unquote_toml(val_s)
        if ref_ctor.length() > 0 {
          ref_enabled = true
        }
      } else if key == "field_name" {
        ref_field = unquote_toml(val_s)
      } else if key == "type_name" {
        ref_type = unquote_toml(val_s)
      }
    } else if section == "eq" {
      if key == "wrapper_call" {
        eq_wrapper = unquote_toml(val_s)
      } else if key == "helper_prefix" {
        eq_prefix = unquote_toml(val_s)
      }
    } else if section == "derives" {
      if (key == "allow" || key == "ignore") && val_s.starts_with("[") && val_s.ends_with("]") {
        let target_list = if key == "ignore" { ignored_derives } else { allowed_derives }
        let inner = val_s.slice(1, val_s.length() - 1)
        let items = inner.split(",")
        for it in items {
          let d = unquote_toml(it)
          if d.length() > 0 {
            let mut found = false
            for e in target_list {
              if e == d {
                found = true
              }
            }
            if !found {
              target_list.push(d)
            }
          }
        }
      }
    } else if section == "comments" {
      if key == "replace" {
        let d0 = net_bracket_delta(val_s)
        if d0 <= 0 {
          parse_comments_replace_array(val_s, path, line_no, comment_replaces, seen_comment_from, diags)
        } else {
          collecting_comments_arr = true
          comments_arr_buf = StringBuilder()
          comments_arr_buf.write_string(val_s)
          comments_arr_depth = d0
          comments_arr_line = line_no
        }
      } else {
        diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, line_no, 1, "unknown key `" + key + "` in [comments] section"))
      }
    } else if section == "assets.bypass" && !in_asset_item {
      if key == "files" && val_s.starts_with("[") && val_s.ends_with("]") {
        let inner = val_s.slice(1, val_s.length() - 1)
        let items = inner.split(",")
        for it in items {
          let p = unquote_toml(it)
          if p.length() > 0 {
            asset_bypass.push(AssetBypassRule::{
              path: p,
              sha256: "",
              reason: "recipes_assets_bypass",
              allowed_decls: [],
            })
          }
        }
      }
    } else if in_asset_item {
      if key == "path" {
        cur_asset_path = unquote_toml(val_s)
      } else if key == "sha256" {
        cur_asset_sha = unquote_toml(val_s)
      } else if key == "reason" {
        cur_asset_reason = unquote_toml(val_s)
      } else if key == "allowed_decls" && val_s.starts_with("[") && val_s.ends_with("]") {
        let inner = val_s.slice(1, val_s.length() - 1)
        for it in inner.split(",") {
          let d = unquote_toml(it)
          if d.length() > 0 {
            cur_asset_decls.push(d)
          }
        }
      }
    } else if in_trait_item {
      if key == "derive" {
        cur_derive = unquote_toml(val_s)
      } else if key == "target_trait" || key == "trait" {
        cur_trait = unquote_toml(val_s)
      } else if key == "method" {
        cur_method = unquote_toml(val_s)
      } else if key == "kind" {
        cur_kind = unquote_toml(val_s)
      }
    }
  }
  if in_trait_item && cur_derive.length() > 0 && cur_trait.length() > 0 {
    trait_recipes.push(TraitRecipe::{
      derive_name: cur_derive,
      target_trait: cur_trait,
      method_name: cur_method,
      kind: cur_kind,
    })
  }
  if in_asset_item && cur_asset_path.length() > 0 {
    asset_bypass.push(AssetBypassRule::{
      path: cur_asset_path,
      sha256: cur_asset_sha,
      reason: if cur_asset_reason.length() > 0 { cur_asset_reason } else { "manifest_asset_bypass" },
      allowed_decls: cur_asset_decls,
    })
  }
  if collecting_comments_arr {
    diags.push(diag_error("MBT2PION_RECIPE_ERROR", path, comments_arr_line, 1, "unterminated [comments] `replace` array"))
  }
  Recipes::{
    ref_recipe: RefRecipe::{ enabled: ref_enabled, ctor_call: ref_ctor, field_name: ref_field, type_name: ref_type },
    trait_recipes: trait_recipes,
    eq_recipe: EqRecipe::{ wrapper_call: eq_wrapper, helper_prefix: eq_prefix },
    allowed_derives: allowed_derives,
    ignored_derives: ignored_derives,
    asset_bypass: asset_bypass,
    comment_replaces: comment_replaces,
  }
}

///| Parse `--asset-manifest` (JSON `{"assets":[...]}` or TOML `[[asset_bypass]]`).
pub fn parse_asset_manifest(content : String, path : String, diags : Array[Diag]) -> Array[AssetBypassRule] {
  let trimmed = content.trim()
  if trimmed.length() == 0 {
    return []
  }
  if trimmed.starts_with("{") {
    let out : Array[AssetBypassRule] = []
    match json::parse(trimmed) {
      Err(e) => {
        diags.push(diag_error("MBT2PION_ASSET_MANIFEST_ERROR", path, 1, 1, "failed to parse asset manifest JSON: " + e))
        return out
      }
      Ok(root) => {
        let arr_opt = match json::obj_get(root, "assets") {
          Some(v) => Some(v)
          None => json::obj_get(root, "asset_bypass")
        }
        match arr_opt {
          Some(av) =>
          match json::as_arr(av) {
            Some(items) => {
              for it in items {
                let p = j_str(it, "path", "")
                let sha = j_str(it, "sha256", "")
                let reason = j_str(it, "reason", "asset_manifest")
                let decls : Array[String] = []
                match json::obj_get(it, "allowed_decls") {
                  Some(dv) =>
                  match json::as_arr(dv) {
                    Some(ds) => {
                      for d in ds {
                        match json::as_str(d) {
                          Some(s) => if s.length() > 0 { decls.push(s) }
                          None => ()
                        }
                      }
                    }
                    None => ()
                  }
                  None => ()
                }
                if p.length() == 0 {
                  diags.push(diag_error("MBT2PION_ASSET_MANIFEST_INVALID", path, 1, 1, "asset manifest entry missing non-empty `path`"))
                } else {
                  out.push(AssetBypassRule::{ path: p, sha256: sha, reason: reason, allowed_decls: decls })
                }
              }
            }
            None => diags.push(diag_error("MBT2PION_ASSET_MANIFEST_INVALID", path, 1, 1, "asset manifest `assets` field must be a JSON array"))
          }
          None => diags.push(diag_error("MBT2PION_ASSET_MANIFEST_INVALID", path, 1, 1, "asset manifest JSON missing `assets` array"))
        }
      }
    }
    return out
  }
  let r = parse_recipes_toml(content, path, diags)
  r.asset_bypass
}

///| Symbol table combining intra-package declarations, `.mbti`, `pionc doc --json`, and `api_map.json`.
pub struct CtorTarget {
  pkg : String
  enum_name : String
  ctor_name : String
  is_local : Bool
  arity : Int
}

///| Count top-level comma-separated items inside `(...)` starting at `open_paren` in a string.
pub fn count_paren_arity(s : String, open_paren : Int) -> Int {
  let n = s.length()
  if open_paren < 0 || open_paren >= n || s.code_unit_at(open_paren) != 40 {
    return 0
  }
  let mut depth = 0
  let mut count = 0
  let mut has_content = false
  let mut i = open_paren + 1
  while i < n {
    let c = s.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
      has_content = true
    } else if c == 41 {
      if depth == 0 {
        if has_content {
          count = count + 1
        }
        return count
      }
      depth = depth - 1
    } else if c == 93 || c == 125 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      count = count + 1
      has_content = false
    } else if c != 32 && c != 9 && c != 10 && c != 13 {
      has_content = true
    }
    i = i + 1
  }
  if has_content { count + 1 } else { count }
}

pub struct ConstDef {
  is_literal : Bool
  literal_pion : String
}

pub struct SymbolTable {
  ctors : Map[String, Array[CtorTarget]]
  autofill_loc_fns : Map[String, Bool]
  external_tilde_fns : Map[String, Bool]
  api_by_key : Map[String, ApiSymbol]
  pkg_aliases : Map[String, String]
  fn_param_types : Map[String, Array[(String, String)]]
  fn_ret_types : Map[String, String]
  struct_field_types : Map[String, Map[String, String]]
  local_value_names : Map[String, Bool]
  prod_pub_decls : Map[String, Bool]
  type_aliases : Map[String, String]
  using_types : Map[String, String]
  using_values : Map[String, String]
  const_defs : Map[String, ConstDef]
  blackbox_decls : Map[String, Bool]
  blackbox_autofill_loc_fns : Map[String, Bool]
  blackbox_fn_param_types : Map[String, Array[(String, String)]]
  blackbox_fn_ret_types : Map[String, String]
  tuple_structs : Map[String, Int]
  custom_eq_types : Map[String, String]
  custom_impl_eq_types : Map[String, Bool]
  recursive_derive_eq_types : Map[String, Bool]
  // Types whose `to_string` is a transpiled MoonBit `impl Show ... with output` (local: bare name; dependency:
  // `pkg::Name`), and local types that also declare an inherent `fn T::to_string`.
  show_impl_types : Map[String, Bool]
  inherent_to_string_types : Map[String, Bool]
  pub_sig_referenced_types : Map[String, Bool]
  blackbox_colliding_privs : Map[String, String]
  hashable_types : Map[String, Bool]
  method_unique_param_types : Map[String, Array[(String, String)]]
  local_types : Map[String, Bool]
  active_generics : Map[String, Bool]
  moon_import_paths : Map[String, String]
  dep_pkg_names : Map[String, Bool]
  enum_schemas : Map[String, AbiEnumSchema]
  enum_schemas_by_ctor : Map[String, Array[(AbiEnumSchema, AbiEnumVariant)]]
  verified_abi_deps : Map[String, Bool]
  dep_struct_val_fields : Map[String, String]
  local_raising_fns : Map[String, Bool]
  local_fn_names : Map[String, Bool]
  fn_param_renames : Map[String, Map[String, String]]
  method_unique_param_renames : Map[String, Map[String, String]]
  val_types : Map[String, String]
  enum_type_params : Map[String, Array[String]]
  fn_type_params : Map[String, Array[String]]
  fn_labeled_params : Map[String, Map[String, Bool]]
  fn_raw_param_types : Map[String, Array[(String, String)]]
}

pub fn empty_symbol_table() -> SymbolTable {
  SymbolTable::{
    ctors: Map(),
    autofill_loc_fns: Map(),
    external_tilde_fns: Map(),
    api_by_key: Map(),
    pkg_aliases: Map(),
    fn_param_types: Map(),
    fn_ret_types: Map(),
    struct_field_types: Map(),
    local_value_names: Map(),
    prod_pub_decls: Map(),
    type_aliases: Map(),
    using_types: Map(),
    using_values: Map(),
    const_defs: Map(),
    blackbox_decls: Map(),
    blackbox_autofill_loc_fns: Map(),
    blackbox_fn_param_types: Map(),
    blackbox_fn_ret_types: Map(),
    tuple_structs: Map(),
    custom_eq_types: Map(),
    custom_impl_eq_types: Map(),
    recursive_derive_eq_types: Map(),
    show_impl_types: Map(),
    inherent_to_string_types: Map(),
    pub_sig_referenced_types: Map(),
    blackbox_colliding_privs: Map(),
    hashable_types: Map(),
    method_unique_param_types: Map(),
    local_types: Map(),
    active_generics: Map(),
    moon_import_paths: Map(),
    dep_pkg_names: Map(),
    enum_schemas: Map(),
    enum_schemas_by_ctor: Map(),
    verified_abi_deps: Map(),
    dep_struct_val_fields: Map(),
    local_raising_fns: Map(),
    local_fn_names: Map(),
    fn_param_renames: Map(),
    method_unique_param_renames: Map(),
    val_types: Map(),
    enum_type_params: Map(),
    fn_type_params: Map(),
    fn_labeled_params: Map(),
    fn_raw_param_types: Map(),
  }
}

///| Register an enum schema (local or verified external dep) into `SymbolTable`.
pub fn symtab_register_enum_schema(st : SymbolTable, schema : AbiEnumSchema) -> Unit {
  let key = if schema.pkg.length() > 0 { schema.pkg + "::" + schema.name } else { schema.name }
  st.enum_schemas[key] = schema
  let is_local = schema.pkg.length() == 0
  for v in schema.variants {
    let list = match st.enum_schemas_by_ctor.get(v.name) {
      Some(xs) => xs
      None => {
        let xs : Array[(AbiEnumSchema, AbiEnumVariant)] = []
        st.enum_schemas_by_ctor[v.name] = xs
        xs
      }
    }
    let mut dup = false
    for existing in list {
      if existing.0.pkg == schema.pkg && existing.0.name == schema.name && existing.1.name == v.name {
        dup = true
        break
      }
    }
    if !dup {
      list.push((schema, v))
    }
    symtab_add_ctor(st, v.name, CtorTarget::{
      pkg: schema.pkg,
      enum_name: schema.name,
      ctor_name: v.name,
      is_local: is_local,
      arity: v.fields.length(),
    })
  }
}

///| Load a bidirectionally verified `--dep` `PackageAbi` into `SymbolTable`.
pub fn symtab_load_dep_abi(st : SymbolTable, dep_name : String, abi : PackageAbi) -> Unit {
  st.verified_abi_deps[dep_name] = true
  if abi.package_name.length() > 0 {
    st.verified_abi_deps[abi.package_name] = true
  }
  st.dep_pkg_names[dep_name] = true
  for en in abi.enums {
    let norm_en = AbiEnumSchema::{
      pkg: dep_name,
      name: en.name,
      can_match: en.can_match,
      can_construct: en.can_construct,
      variants: en.variants,
    }
    symtab_register_enum_schema(st, norm_en)
  }
  for sv in abi.struct_val_fields {
    st.dep_struct_val_fields[dep_name + "::" + sv.struct_name] = sv.renamed_field
    if abi.package_name.length() > 0 && abi.package_name != dep_name {
      st.dep_struct_val_fields[abi.package_name + "::" + sv.struct_name] = sv.renamed_field
    }
  }
}

///| Extract the default alias (last `/`-separated segment) from a MoonBit import path.
fn moon_import_default_alias(path : String) -> String {
  let mut ls = -1
  let mut i = 0
  while i < path.length() {
    if path.code_unit_at(i) == 47 { ls = i }
    i = i + 1
  }
  if ls >= 0 && ls + 1 < path.length() {
    path.slice(ls + 1, path.length())
  } else {
    path
  }
}

///| Parse `import { ... }` (MoonBit `moon.pkg` DSL) or `"import": [...]` (`moon.pkg.json`)
///| into `alias -> full_import_path` so stdlib recognition uses true import identity.
pub fn parse_moon_pkg_imports(content : String, out : Map[String, String]) -> Unit {
  let trimmed = content.trim()
  if trimmed.length() == 0 {
    return
  }
  if trimmed.starts_with("{") {
    match json::parse(trimmed) {
      Ok(root) =>
      match json::obj_get(root, "import") {
        Some(iv) =>
        match json::as_arr(iv) {
          Some(items) => {
            for item in items {
              match json::as_str(item) {
                Some(p) => out[moon_import_default_alias(p)] = p
                None => {
                  let p = j_str(item, "path", "")
                  if p.length() > 0 {
                    let al = j_str(item, "alias", "")
                    let key = if al.length() > 0 { al } else { moon_import_default_alias(p) }
                    out[key] = p
                  }
                }
              }
            }
          }
          None => ()
        }
        None => ()
      }
      Err(_) => ()
    }
    return
  }
  // MoonBit DSL `moon.pkg`: `import { "pkg/path" @alias, "pkg/path" }`
  let tokens = lex_moonbit(content)
  let n = tokens.length() - 1
  let mut i = 0
  while i < n {
    if (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
    tokens[i].raw == "import" && i + 1 < n && tokens[i + 1].kind == TokenKind::LBrace {
      let lb = i + 1
      let mut rb = lb + 1
      let mut d = 1
      while rb < n && d > 0 {
        if tokens[rb].kind == TokenKind::LBrace { d = d + 1 }
        else if tokens[rb].kind == TokenKind::RBrace { d = d - 1 }
        if d > 0 { rb = rb + 1 }
      }
      let mut k = lb + 1
      while k < rb {
        if tokens[k].kind == TokenKind::StringLit && tokens[k].raw.length() >= 2 {
          let p = tokens[k].raw.slice(1, tokens[k].raw.length() - 1)
          let mut al = moon_import_default_alias(p)
          if k + 1 < rb && tokens[k + 1].kind == TokenKind::PkgRef && tokens[k + 1].raw.length() > 1 {
            al = tokens[k + 1].raw.slice(1, tokens[k + 1].raw.length())
            k = k + 2
          } else if k + 2 < rb && (tokens[k + 1].kind == TokenKind::Keyword || tokens[k + 1].kind == TokenKind::Ident) &&
          tokens[k + 1].raw == "as" && (tokens[k + 2].kind == TokenKind::Ident || tokens[k + 2].kind == TokenKind::PkgRef) {
            let ar = tokens[k + 2].raw
            al = if ar.starts_with("@") { ar.slice(1, ar.length()) } else { ar }
            k = k + 3
          } else {
            k = k + 1
          }
          if al.length() > 0 {
            out[al] = p
          }
          continue
        }
        k = k + 1
      }
      i = rb + 1
      continue
    }
    i = i + 1
  }
}

///| True iff `@<raw_pkg>` refers to MoonBit's standard library `moonbitlang/core/<core_subpkg>`,
///| strictly respecting `moon.pkg` import paths, `api_map.pkg_aliases`, and loaded `--dep` packages.
pub fn is_moonbit_core_pkg(st : SymbolTable, raw_pkg : String, core_subpkg : String) -> Bool {
  match st.moon_import_paths.get(raw_pkg) {
    Some(full_path) => return full_path == "moonbitlang/core/" + core_subpkg
    None => ()
  }
  match st.pkg_aliases.get(raw_pkg) {
    Some(mapped) =>
    if mapped != raw_pkg && !mapped.starts_with("moonbitlang/core/") {
      return false
    }
    None => ()
  }
  if st.dep_pkg_names.contains(raw_pkg) {
    return false
  }
  raw_pkg == core_subpkg || (core_subpkg == "encoding/utf8" && raw_pkg == "utf8")
}

pub fn symtab_add_ctor(st : SymbolTable, ctor_name : String, target : CtorTarget) -> Unit {
  let list = match st.ctors.get(ctor_name) {
    Some(xs) => xs
    None => {
      let xs : Array[CtorTarget] = []
      st.ctors[ctor_name] = xs
      xs
    }
  }
  for existing in list {
    if existing.pkg == target.pkg && existing.enum_name == target.enum_name && existing.is_local == target.is_local {
      return
    }
  }
  list.push(target)
}

///| Load symbols from `ApiMap` into `SymbolTable`.
pub fn symtab_load_api_map(st : SymbolTable, am : ApiMap) -> Unit {
  let alias_keys = sorted_map_keys(am.pkg_aliases)
  for k in alias_keys {
    match am.pkg_aliases.get(k) {
      Some(v) => st.pkg_aliases[k] = v
      None => ()
    }
  }
  for sym in am.symbols {
    let key = if sym.src_pkg.length() > 0 { sym.src_pkg + "::" + sym.src_name } else { sym.src_name }
    st.api_by_key[key] = sym
    if sym.autofill_loc {
      st.autofill_loc_fns[sym.src_name] = true
      st.autofill_loc_fns[key] = true
    }
    if sym.external_tilde_default {
      st.external_tilde_fns[sym.src_name] = true
      st.external_tilde_fns[key] = true
    }
    if sym.kind == "fn" {
      let pts : Array[(String, String)] = []
      let lmap : Map[String, Bool] = Map()
      for p in sym.params {
        pts.push((p.name, p.ty))
        if p.is_optional {
          lmap[p.name] = true
        }
      }
      if pts.length() > 0 {
        st.fn_param_types[key] = pts
        st.fn_raw_param_types[key] = pts
        let tkey = if sym.target_pkg.length() > 0 { sym.target_pkg + "::" + sym.target_name } else { sym.target_name }
        st.fn_param_types[tkey] = pts
        st.fn_raw_param_types[tkey] = pts
        if lmap.length() > 0 {
          st.fn_labeled_params[key] = lmap
          st.fn_labeled_params[tkey] = lmap
        }
      }
      if sym.ret_ty.length() > 0 {
        st.fn_ret_types[key] = sym.ret_ty
        let tkey = if sym.target_pkg.length() > 0 { sym.target_pkg + "::" + sym.target_name } else { sym.target_name }
        st.fn_ret_types[tkey] = sym.ret_ty
      }
    }
    if sym.kind == "ctor" {
      let ctor_arity = if sym.arity >= 0 { sym.arity } else { sym.params.length() }
      symtab_add_ctor(st, sym.src_name, CtorTarget::{
        pkg: sym.target_pkg,
        enum_name: sym.target_enum,
        ctor_name: sym.target_name,
        is_local: false,
        arity: ctor_arity,
      })
    }
  }
}

///| Extract the clean Pion package name from a `.mbti` file's `package "a/b/pkg"` header
///| or from its relative path (`<dir>/pkg.generated.mbti` -> `<dir>`, `foo/bar.mbti` -> `bar`).
pub fn extract_mbti_pkg_name(rel_path : String, content : String) -> String {
  let lines = content.split("\n")
  for raw in lines {
    let line = raw.trim()
    if line.length() == 0 || line.starts_with("//") {
      continue
    }
    if line.starts_with("package ") {
      let q1 = line.index_of("\"")
      if q1 >= 0 {
        let rest = line.slice(q1 + 1, line.length())
        let q2 = rest.index_of("\"")
        if q2 > 0 {
          let pkg_path = rest.slice(0, q2)
          let mut last_slash = -1
          let mut k = 0
          while k < pkg_path.length() {
            if pkg_path.code_unit_at(k) == 47 {
              last_slash = k
            }
            k = k + 1
          }
          if last_slash >= 0 {
            return pkg_path.slice(last_slash + 1, pkg_path.length())
          }
          return pkg_path
        }
      }
    }
    break
  }
  // Fallback: derive package name from rel_path
  let mut p = rel_path.trim()
  if p.ends_with("/pkg.generated.mbti") {
    p = p.slice(0, p.length() - 19)
  } else if p == "pkg.generated.mbti" {
    return ""
  } else {
    let mut last_slash = -1
    let mut k = 0
    while k < p.length() {
      if p.code_unit_at(k) == 47 {
        last_slash = k
      }
      k = k + 1
    }
    if last_slash >= 0 {
      p = p.slice(last_slash + 1, p.length())
    }
    if p.ends_with(".generated.mbti") {
      p = p.slice(0, p.length() - 15)
    } else if p.ends_with(".mbti") {
      p = p.slice(0, p.length() - 5)
    }
    return p
  }
  let mut last_slash = -1
  let mut k = 0
  while k < p.length() {
    if p.code_unit_at(k) == 47 {
      last_slash = k
    }
    k = k + 1
  }
  if last_slash >= 0 {
    p.slice(last_slash + 1, p.length())
  } else {
    p
  }
}

///| Load enum constructors and `#callsite(autofill(loc))` signatures from a `.mbti` file.
pub fn symtab_load_mbti(st : SymbolTable, pkg_hint : String, content : String) -> Unit {
  let raw_pkg = extract_mbti_pkg_name(pkg_hint, content)
  let pkg_name = match st.pkg_aliases.get(raw_pkg) {
    Some(aliased) => aliased
    None => raw_pkg
  }
  if pkg_name.length() > 0 && pkg_name != "mbt_compat" {
    st.dep_pkg_names[pkg_name] = true
  }
  let lines = content.split("\n")
  let mut in_enum = ""
  let mut next_autofill = false
  for raw in lines {
    let line = raw.trim()
    if line.starts_with("#callsite") && str_has(line, "autofill(loc)") {
      next_autofill = true
      continue
    }
    if next_autofill && line.length() > 0 {
      if line.starts_with("#") {
        continue
      }
      let fn_rest_opt : Option[String] = if line.starts_with("pub fn ") {
        Some(line.slice(7, line.length()))
      } else if line.starts_with("fn ") {
        Some(line.slice(3, line.length()))
      } else if line.starts_with("pub fn[") || line.starts_with("fn[") {
        let lb = line.index_of("[")
        let mut bd = 0
        let mut bi = lb
        let mut rb = -1
        while bi >= 0 && bi < line.length() {
          let ch = line.code_unit_at(bi)
          if ch == 91 { bd = bd + 1 }
          else if ch == 93 {
            bd = bd - 1
            if bd == 0 {
              rb = bi
              break
            }
          }
          bi = bi + 1
        }
        if rb >= 0 && rb + 1 < line.length() {
          Some(line.slice(rb + 1, line.length()).trim())
        } else {
          None
        }
      } else {
        None
      }
      match fn_rest_opt {
        Some(rest) => {
          let mut fi = 0
          while fi < rest.length() && (is_alnum(rest.code_unit_at(fi)) || rest.code_unit_at(fi) == 58) {
            fi = fi + 1
          }
          let fname = rest.slice(0, fi)
          if fname.length() > 0 {
            st.autofill_loc_fns[fname] = true
            if pkg_name.length() > 0 {
              st.autofill_loc_fns[pkg_name + "::" + fname] = true
            }
          }
        }
        None => ()
      }
      next_autofill = false
    }
    if line.starts_with("pub(all) enum ") || line.starts_with("pub enum ") || line.starts_with("enum ") {
      let rest = if line.starts_with("pub(all) enum ") {
        line.slice(14, line.length())
      } else if line.starts_with("pub enum ") {
        line.slice(9, line.length())
      } else {
        line.slice(5, line.length())
      }
      let mut end_i = 0
      while end_i < rest.length() && is_alnum(rest.code_unit_at(end_i)) {
        end_i = end_i + 1
      }
      in_enum = rest.slice(0, end_i)
      continue
    }
    if in_enum.length() > 0 {
      if line == "}" {
        in_enum = ""
        continue
      }
      if line.length() > 0 && is_upper(line.code_unit_at(0)) {
        let mut ci = 0
        while ci < line.length() && is_alnum(line.code_unit_at(ci)) {
          ci = ci + 1
        }
        let cname = line.slice(0, ci)
        let arity = if ci < line.length() && line.code_unit_at(ci) == 40 {
          count_paren_arity(line, ci)
        } else {
          0
        }
        symtab_add_ctor(st, cname, CtorTarget::{
          pkg: pkg_name,
          enum_name: in_enum,
          ctor_name: cname,
          is_local: false,
          arity: arity,
        })
      }
    }
  }
}

///| Load enum constructors and function signatures from `pionc doc --json` output.
pub fn symtab_load_pionc_doc_json(st : SymbolTable, json_text : String) -> Unit {
  if json_text.trim().length() == 0 {
    return
  }
  let root = match json::parse(json_text) {
    Ok(v) => v
    Err(_) => return
  }
  match json::obj_get(root, "packages") {
    Some(pv) =>
    match json::as_arr(pv) {
      Some(pkgs) => {
        for pkg in pkgs {
          let pkg_name = j_str(pkg, "name", "")
          if pkg_name.length() > 0 && pkg_name != "mbt_compat" {
            st.dep_pkg_names[pkg_name] = true
          }
          match json::obj_get(pkg, "items") {
            Some(iv) =>
            match json::as_arr(iv) {
              Some(items) => {
                // Enum names this dependency declares: a bare `MaskType` in its signatures means `pkg::MaskType`
                // to the package being transpiled (which may declare a private enum of the same name).
                let dep_enums : Map[String, Bool] = Map()
                for it0 in items {
                  if j_str(it0, "kind", "") == "enum" {
                    let en = j_str(it0, "name", "")
                    if en.length() > 0 { dep_enums[en] = true }
                  }
                }
                for it in items {
                  let kind = j_str(it, "kind", "")
                  let name = j_str(it, "name", "")
                  let sig = j_str(it, "sig", "")
                  if kind == "mbt_show_impl" && name.length() > 0 && pkg_name.length() > 0 {
                    st.show_impl_types[pkg_name + "::" + name] = true
                  }
                  if kind == "enum" && name.length() > 0 {
                    let lb = sig.index_of("{")
                    let rb = sig.index_of("}")
                    let lb_g = sig.index_of("[")
                    if lb_g > 0 && (lb < 0 || lb_g < lb) {
                      let rb_g = sig.index_of("]")
                      if rb_g > lb_g && (lb < 0 || rb_g < lb) {
                        let gbody = sig.slice(lb_g + 1, rb_g)
                        let tps : Array[String] = []
                        let mut gs = 0
                        let mut gi = 0
                        while gi <= gbody.length() {
                          let at_ge = gi == gbody.length()
                          let gch = if at_ge { 44 } else { gbody.code_unit_at(gi) }
                          if gch == 44 {
                            let gp = gbody.slice(gs, gi).trim()
                            let gcol = gp.index_of(":")
                            let gnm = if gcol > 0 { gp.slice(0, gcol).trim() } else { gp }
                            if gnm.length() > 0 { tps.push(gnm) }
                            gs = gi + 1
                          }
                          gi = gi + 1
                        }
                        if tps.length() > 0 {
                          let ekey = if pkg_name.length() > 0 { pkg_name + "::" + name } else { name }
                          st.enum_type_params[ekey] = tps
                        }
                      }
                    }
                    if lb >= 0 && rb > lb {
                      let body = sig.slice(lb + 1, rb)
                      let parts = body.split(";")
                      for p in parts {
                        let t = p.trim()
                        if t.length() > 0 && is_upper(t.code_unit_at(0)) {
                          let mut ci = 0
                          while ci < t.length() && is_alnum(t.code_unit_at(ci)) {
                            ci = ci + 1
                          }
                          let cname = t.slice(0, ci)
                          let arity = if ci < t.length() && t.code_unit_at(ci) == 40 {
                            count_paren_arity(t, ci)
                          } else {
                            0
                          }
                          symtab_add_ctor(st, cname, CtorTarget::{
                            pkg: pkg_name,
                            enum_name: name,
                            ctor_name: cname,
                            is_local: false,
                            arity: arity,
                          })
                        }
                      }
                    }
                  } else if (kind == "let" || kind == "const" || kind == "var" || kind == "val" || kind == "global") && name.length() > 0 {
                    let ci = sig.index_of(":")
                    if ci >= 0 {
                      let mut vty = sig.slice(ci + 1, sig.length()).trim()
                      let eqi = vty.index_of("=")
                      if eqi >= 0 { vty = vty.slice(0, eqi).trim() }
                      if vty.length() > 0 {
                        let vkey = if pkg_name.length() > 0 { pkg_name + "::" + name } else { name }
                        st.val_types[vkey] = vty
                      }
                    }
                  } else if kind == "struct" && name.length() > 0 {
                    let lb = sig.index_of("{")
                    let rb = sig.index_of("}")
                    if lb >= 0 && rb > lb {
                      let fmap : Map[String, String] = Map()
                      let body = sig.slice(lb + 1, rb)
                      let parts = body.split(";")
                      for p in parts {
                        let pt = p.trim()
                        let ci = pt.index_of(":")
                        if ci > 0 {
                          let mut fname = pt.slice(0, ci).trim()
                          if fname.starts_with("pub ") { fname = fname.slice(4, fname.length()).trim() }
                          if fname.starts_with("mut ") { fname = fname.slice(4, fname.length()).trim() }
                          let fty = pt.slice(ci + 1, pt.length()).trim()
                          if fname.length() > 0 && fty.length() > 0 {
                            fmap[fname] = fty
                          }
                        }
                      }
                      if fmap.length() > 0 {
                        let skey = if pkg_name.length() > 0 { pkg_name + "::" + name } else { name }
                        st.struct_field_types[skey] = fmap
                      }
                    }
                  } else if kind == "fn" {
                    if str_has(sig, "~ :") && str_has(sig, "=") {
                      st.external_tilde_fns[name] = true
                      if pkg_name.length() > 0 {
                        st.external_tilde_fns[pkg_name + "::" + name] = true
                      }
                    }
                    // Parse parameter & return types from `pionc doc --json` fn signature for expected-type guidance
                    let lp = sig.index_of("(")
                    if lp >= 0 {
                      let mut rp = -1
                      let mut pd = 0
                      let mut si = lp
                      while si < sig.length() {
                        let c = sig.code_unit_at(si)
                        if c == 40 { pd = pd + 1 }
                        else if c == 41 {
                          pd = pd - 1
                          if pd == 0 { rp = si; break }
                        }
                        si = si + 1
                      }
                      if rp > lp {
                        let gen_params : Map[String, Bool] = Map()
                        let gen_params_list : Array[String] = []
                        let lb_g = sig.index_of("[")
                        if lb_g > 0 && lb_g < lp {
                          let rb_g = sig.index_of("]")
                          if rb_g > lb_g && rb_g < lp {
                            let gbody = sig.slice(lb_g + 1, rb_g)
                            let mut gs = 0
                            let mut gi = 0
                            while gi <= gbody.length() {
                              let at_ge = gi == gbody.length()
                              let gch = if at_ge { 44 } else { gbody.code_unit_at(gi) }
                              if gch == 44 {
                                let gp = gbody.slice(gs, gi).trim()
                                let gcol = gp.index_of(":")
                                let gnm = if gcol > 0 { gp.slice(0, gcol).trim() } else { gp }
                                if gnm.length() > 0 {
                                  gen_params[gnm] = true
                                  gen_params_list.push(gnm)
                                }
                                gs = gi + 1
                              }
                              gi = gi + 1
                            }
                          }
                        }
                        let pbody = sig.slice(lp + 1, rp)
                        let pts : Array[(String, String)] = []
                        let raw_pts : Array[(String, String)] = []
                        let lmap : Map[String, Bool] = Map()
                        let mut has_dep_autofill_loc = false
                        let mut ps = 0
                        let mut d = 0
                        let mut pi = 0
                        while pi <= pbody.length() {
                          let at_e = pi == pbody.length()
                          let ch = if at_e { 44 } else { pbody.code_unit_at(pi) }
                          if !at_e && (ch == 40 || ch == 91 || ch == 123) { d = d + 1 }
                          else if !at_e && (ch == 41 || ch == 93 || ch == 125) { if d > 0 { d = d - 1 } }
                          else if d == 0 && ch == 44 {
                            let part = pbody.slice(ps, pi).trim()
                            let ci = part.index_of(":")
                            if ci > 0 {
                              let raw_pname = part.slice(0, ci).trim()
                              let mut pname = raw_pname
                              let mut is_lbl = false
                              if pname.ends_with("?") || pname.ends_with("~") {
                                is_lbl = true
                                pname = pname.slice(0, pname.length() - 1).trim()
                              }
                              let mut pty = part.slice(ci + 1, part.length()).trim()
                              let eqi = pty.index_of("=")
                              if eqi > 0 {
                                let def_val = pty.slice(eqi + 1, pty.length()).trim()
                                is_lbl = true
                                pty = pty.slice(0, eqi).trim()
                                if raw_pname == "loc~" && pty == "String" && def_val == "\"\"" {
                                  has_dep_autofill_loc = true
                                }
                              }
                              if is_lbl {
                                lmap[pname] = true
                              }
                              let mut raw_pty = pty
                              if pkg_name.length() > 0 && pkg_name != "mbt_compat" {
                                raw_pty = qualify_dep_enum_names(raw_pty, pkg_name, dep_enums, gen_params)
                              }
                              raw_pts.push((pname, raw_pty))
                              if gen_params.contains(strip_type_args_sym(pty)) {
                                pty = ""
                              }
                              if pkg_name.length() > 0 && pkg_name != "mbt_compat" {
                                pty = qualify_dep_enum_names(pty, pkg_name, dep_enums, gen_params)
                              }
                              pts.push((pname, pty))
                            }
                            ps = pi + 1
                          }
                          pi = pi + 1
                        }
                        if pts.length() > 0 {
                          let fkey = if pkg_name.length() > 0 { pkg_name + "::" + name } else { name }
                          st.fn_param_types[fkey] = pts
                          st.fn_raw_param_types[fkey] = raw_pts
                          if lmap.length() > 0 {
                            st.fn_labeled_params[fkey] = lmap
                          }
                          if gen_params_list.length() > 0 {
                            st.fn_type_params[fkey] = gen_params_list
                          }
                          if has_dep_autofill_loc && pkg_name.length() > 0 {
                            st.autofill_loc_fns[fkey] = true
                          }
                        }
                        let after_rp = sig.slice(rp + 1, sig.length()).trim()
                        if after_rp.starts_with("->") {
                          let mut rty = after_rp.slice(2, after_rp.length()).trim()
                          if pkg_name.length() > 0 && pkg_name != "mbt_compat" {
                            rty = qualify_dep_enum_names(rty, pkg_name, dep_enums, gen_params)
                          }
                          let fkey = if pkg_name.length() > 0 { pkg_name + "::" + name } else { name }
                          st.fn_ret_types[fkey] = rty
                        }
                      }
                    }
                  }
                }
              }
              None => ()
            }
            None => ()
          }
        }
      }
      None => ()
    }
    None => ()
  }
}

///| Qualify every bare identifier of `ty` naming an enum declared by dependency `pkg` (and not shadowed by one of
///| the signature's generic parameters) as `pkg::Name`; already-qualified paths (`a::B`) are left unchanged.
fn qualify_dep_enum_names(ty : String, pkg : String, enums : Map[String, Bool], generics : Map[String, Bool]) -> String {
  if enums.length() == 0 {
    return ty
  }
  let sb = StringBuilder()
  let mut i = 0
  let n = ty.length()
  while i < n {
    let c = ty.code_unit_at(i)
    if is_alnum(c) {
      let s = i
      while i < n && is_alnum(ty.code_unit_at(i)) {
        i = i + 1
      }
      let word = ty.slice(s, i)
      let qualified_before = s >= 2 && ty.code_unit_at(s - 1) == 58 && ty.code_unit_at(s - 2) == 58
      let path_after = i + 1 < n && ty.code_unit_at(i) == 58 && ty.code_unit_at(i + 1) == 58
      if !qualified_before && !path_after && enums.contains(word) && !generics.contains(word) {
        sb.write_string(pkg + "::" + word)
      } else {
        sb.write_string(word)
      }
    } else {
      sb.write_string(ty.slice(i, i + 1))
      i = i + 1
    }
  }
  sb.to_string()
}

///| Return true iff a local enum in the current package defines constructor `ctor_name`.
pub fn has_local_ctor(st : SymbolTable, ctor_name : String) -> Bool {
  match st.ctors.get(ctor_name) {
    None => false
    Some(targets) => {
      for t in targets {
        if t.is_local {
          return true
        }
      }
      false
    }
  }
}

///| Look up known constructor arity (`-1` if unknown or ambiguous).
pub fn lookup_ctor_arity(st : SymbolTable, ctor_name : String) -> Int {
  match st.ctors.get(ctor_name) {
    None => -1
    Some(targets) => {
      for t in targets {
        if t.is_local && t.arity >= 0 {
          return t.arity
        }
      }
      if targets.length() == 1 {
        return targets[0].arity
      }
      -1
    }
  }
}

fn strip_type_args_sym(ty : String) -> String {
  let t = ty.trim()
  let br = t.index_of("[")
  if br > 0 { t.slice(0, br).trim() } else { t }
}

///| Per-use-site source-bound bare enum variant resolver (Wave M1.2 A.5):
///| 1. Respects lexical value/generic shadowing (never rewrites shadowed names).
///| 2. At type-guided use sites (`expected_ty != ""`), resolves source owner from `expected_ty`
///|    (so `Some(17)` passed to `Option[Int]` resolves to `Option::Some` even when `enum Local { Some(Int) }`
///|    exists in the same file!).
///| 3. At unguided use sites, resolves by lexical scope (`Local::Some` shadows builtin `Option::Some`),
///|    then builtin `Option`/`Result`, then external `--dep` / `.mbti` / `api_map` enums.
///| 4. Emits `MBT2PION_AMBIGUOUS_CTOR` on any ambiguous pattern or unresolved conflict.
pub fn resolve_ctor_at_site(
  st : SymbolTable,
  name : String,
  expected_ty : String,
  in_pattern : Bool,
  active_generics : Map[String, Bool],
  file : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Option[String] {
  // 0. Shadowed by active generic type param or local const/let value
  if active_generics.contains(name) || st.local_value_names.contains(name) {
    return None
  }
  let force_qual = expected_ty.starts_with("__qual__::")
  let eff_expected = if force_qual { expected_ty.slice(10, expected_ty.length()) } else { expected_ty }
  let exp_base = strip_type_args_sym(eff_expected)
  // 1. Type-guided resolution: expected type wins over file-wide local enum shadowing!
  if exp_base.length() > 0 {
    if exp_base == "Option" && (name == "Some" || name == "None") {
      return Some("Option::" + name)
    }
    if exp_base == "Result" && (name == "Ok" || name == "Err") {
      return Some("Result::" + name)
    }
    match st.ctors.get(name) {
      Some(targets) => {
        let exp_has_pkg = str_has(exp_base, "::")
        let matched : Array[CtorTarget] = []
        let local_matched : Array[CtorTarget] = []
        for t in targets {
          let full_e = if t.pkg.length() > 0 { t.pkg + "::" + t.enum_name } else { t.enum_name }
          if exp_has_pkg {
            if full_e == exp_base {
              matched.push(t)
            }
          } else if t.enum_name == exp_base {
            matched.push(t)
            if t.is_local {
              local_matched.push(t)
            }
          }
        }
        // When expected type is unqualified (`Tone`), a unique local enum with that name wins over external deps!
        let best = if !exp_has_pkg && local_matched.length() == 1 { local_matched } else { matched }
        if best.length() == 1 {
          let t = best[0]
          if force_qual && !in_pattern {
            if !t.is_local && t.pkg.length() > 0 && t.enum_name.length() > 0 {
              return Some(t.pkg + "::" + t.enum_name + "::" + t.ctor_name)
            }
            if t.enum_name.length() > 0 {
              return Some(t.enum_name + "::" + t.ctor_name)
            }
          }
          if t.is_local && (targets.length() > 1 || name == "Some" || name == "None" || name == "Ok" || name == "Err") {
            return Some(t.enum_name + "::" + t.ctor_name)
          }
          if in_pattern && targets.length() > 1 && !t.is_local && t.pkg.length() > 0 && t.enum_name.length() > 0 {
            return Some(t.pkg + "::" + t.enum_name + "::" + t.ctor_name)
          }
          return Some("." + t.ctor_name)
        }
        if best.length() > 1 {
          if !in_pattern {
            return Some("." + name)
          }
          diags.push(diag_error(
            "MBT2PION_AMBIGUOUS_CTOR",
            file,
            line,
            col,
            "ambiguous constructor `" + name + "` for expected type `" + exp_base + "`",
          ))
          return None
        }
      }
      None => ()
    }
  }
  // 2. Unguided resolution: lexical scope (local enums) -> builtins -> external enums
  match st.ctors.get(name) {
    None => None
    Some(targets) => {
      let local_targets : Array[CtorTarget] = []
      for t in targets {
        if t.is_local {
          local_targets.push(t)
        }
      }
      if local_targets.length() == 1 {
        let lt = local_targets[0]
        if !in_pattern && (name == "Some" || name == "None" || name == "Ok" || name == "Err") {
          return Some(lt.enum_name + "::" + lt.ctor_name)
        }
        return None
      }
      if local_targets.length() > 1 {
        diags.push(diag_error(
          "MBT2PION_AMBIGUOUS_CTOR",
          file,
          line,
          col,
          "ambiguous local constructor `" + name + "` matches " + local_targets.length().to_string() + " local enums without expected type",
        ))
        return None
      }
      // Never let external enum variants (e.g. `mbt_compat::MbtJson::Array`/`String`) hijack builtin type names unguided!
      if name == "Array" || name == "String" || name == "Bytes" || name == "Map" ||
      name == "FixedArray" || name == "StringBuilder" {
        return None
      }
      // No local enum defines `name`: builtin Option/Result stay unqualified
      if name == "Some" || name == "None" || name == "Ok" || name == "Err" {
        return None
      }
      if targets.length() == 1 {
        let t = targets[0]
        if in_pattern {
          return Some("." + t.ctor_name)
        }
        if t.pkg.length() > 0 && t.enum_name.length() > 0 {
          return Some(t.pkg + "::" + t.enum_name + "::" + t.ctor_name)
        }
        if t.enum_name.length() > 0 {
          return Some(t.enum_name + "::" + t.ctor_name)
        }
        return Some("." + t.ctor_name)
      }
      if targets.length() > 1 {
        if !in_pattern {
          return Some("." + name)
        }
        diags.push(diag_error(
          "MBT2PION_AMBIGUOUS_CTOR",
          file,
          line,
          col,
          "ambiguous cross-package constructor `" + name + "` matches " + targets.length().to_string() + " enum variants",
        ))
      }
      None
    }
  }
}

///| E1-2: Return true iff all non-core `moon.pkg` imports have loaded metadata (`--dep` or `api_map`).
pub fn symtab_sources_complete(st : SymbolTable) -> Bool {
  for alias in st.moon_import_paths.keys() {
    match st.moon_import_paths.get(alias) {
      Some(fp) => {
        if fp.starts_with("moonbitlang/core/") || fp == "moonbitlang/core" ||
        fp.starts_with("moonbitlang/x/") {
          continue
        }
        let def_al = moon_import_default_alias(fp)
        if !st.dep_pkg_names.contains(alias) &&
        !st.dep_pkg_names.contains(def_al) &&
        !st.pkg_aliases.contains(alias) {
          return false
        }
      }
      None => ()
    }
  }
  true
}

///| E1-2: Compute the intersection of candidate enum keys across bare constructors `ctors`,
///| plus whether any constructor in `ctors` has >= 2 distinct candidate enums.
pub fn symtab_intersect_ctor_enums(st : SymbolTable, ctors : Array[String]) -> (Array[String], Bool) {
  let mut any_ambig = false
  let mut has_init = false
  let mut inter : Array[String] = []
  for cname in ctors {
    match st.ctors.get(cname) {
      None => {
        has_init = true
        inter = []
      }
      Some(targets) => {
        let cur : Array[String] = []
        let seen : Map[String, Bool] = Map()
        for t in targets {
          if t.enum_name.length() == 0 {
            continue
          }
          let ek = if t.pkg.length() > 0 { t.pkg + "::" + t.enum_name } else { t.enum_name }
          if !seen.contains(ek) {
            seen[ek] = true
            cur.push(ek)
          }
        }
        if cur.length() >= 2 {
          any_ambig = true
        }
        if !has_init {
          has_init = true
          inter = cur
        } else {
          let next_inter : Array[String] = []
          for ek in inter {
            if seen.contains(ek) {
              next_inter.push(ek)
            }
          }
          inter = next_inter
        }
      }
    }
  }
  (inter, any_ambig)
}

///| Resolve an unqualified enum constructor name (compat wrapper around `resolve_ctor_at_site`).
pub fn resolve_ctor(
  st : SymbolTable,
  name : String,
  in_pattern : Bool,
  file : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Option[String] {
  resolve_ctor_at_site(st, name, "", in_pattern, Map(), file, line, col, diags)
}
