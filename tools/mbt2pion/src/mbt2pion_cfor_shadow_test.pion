///| C-style `for v = init; cond; step` scoping: MoonBit always declares a fresh loop-scoped mutable `v` that
///| shadows any outer `v` (with `init` evaluated in the enclosing scope), so a single-binder header must lower to
///| Pion's `for let mut v = init; ...` instead of an assignment that clobbers (or fails on) the outer binding.

fn cfor_transpile(name : String, src : String) -> String {
  let res = transpile_package([SourceFile::{ rel_path: name, content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, name + " should transpile with 0 blockers")
  res.files[0].content
}

test "cfor-shadow-a: nested same-name `for ai = 0` declares a fresh inner counter (with continue / break)" {
  let src = "pub fn nested(n : Int) -> Int {\n" +
  "  let mut total = 0\n" +
  "  for ai = 0; ai < n; ai = ai + 1 {\n" +
  "    for ai = 0; ai < 3; ai = ai + 1 {\n" +
  "      if ai == 1 { continue }\n" +
  "      total = total + ai\n" +
  "    }\n" +
  "    for ai = 0; ai < 10; ai = ai + 1 {\n" +
  "      if ai == 2 { break }\n" +
  "      total = total + ai\n" +
  "    }\n" +
  "    total = total + ai * 100\n" +
  "  }\n" +
  "  total\n" +
  "}\n"
  let out = cfor_transpile("cfor_nested.mbt", src)
  assert_true(str_has(out, "for let mut ai = 0; ai < n; ai = ai + 1 {"), "outer C-style for declares `let mut ai`")
  assert_true(str_has(out, "for let mut ai = 0; ai < 3; ai = ai + 1 {"), "inner C-style for declares its own `let mut ai`")
  assert_true(str_has(out, "for let mut ai = 0; ai < 10; ai = ai + 1 {"), "second inner C-style for declares its own `let mut ai`")
  assert_true(!str_has(out, "for ai = 0;"), "no C-style for may assign to an existing `ai`")
  assert_true(str_has(out, "total = total + ai * 100"), "outer body after the inner loops still reads the outer counter")
}

test "cfor-shadow-b: outer `let mut x` survives `for x = x + 1` whose init reads the outer `x`" {
  let src = "pub fn outer_mut() -> (Int, Int) {\n" +
  "  let mut x = 10\n" +
  "  let mut seen = 0\n" +
  "  for x = x + 1; x < 14; x = x + 1 {\n" +
  "    seen = seen * 100 + x\n" +
  "  }\n" +
  "  x = x + 1\n" +
  "  (x, seen)\n" +
  "}\n"
  let out = cfor_transpile("cfor_outer_mut.mbt", src)
  assert_true(str_has(out, "let mut x = 10"), "outer `let mut x` stays")
  assert_true(str_has(out, "for let mut x = x + 1; x < 14; x = x + 1 {"), "loop declares a fresh `x` initialized from the outer `x`")
}

test "cfor-shadow-c: outer immutable `let i` is shadowed, never assigned" {
  let src = "pub fn outer_immut() -> (Int, Int) {\n" +
  "  let i = 99\n" +
  "  let mut s = 0\n" +
  "  for i = 0; i < 3; i = i + 1 {\n" +
  "    s = s + i\n" +
  "  }\n" +
  "  (i, s)\n" +
  "}\n"
  let out = cfor_transpile("cfor_outer_immut.mbt", src)
  assert_true(str_has(out, "let i = 99"), "outer `let i` stays immutable")
  assert_true(str_has(out, "for let mut i = 0; i < 3; i = i + 1 {"), "loop declares a fresh `let mut i`")
}

test "cfor-shadow-d: boxed outer `let mut x` (MbtCell) feeds `for x = x + 1` while the loop counter stays unboxed" {
  let src = "pub fn boxed_outer() -> (Int, Int) {\n" +
  "  let mut x = 1\n" +
  "  fn bump(n : Int) -> Unit {\n" +
  "    if n > 0 {\n" +
  "      x = x + 10\n" +
  "      bump(n - 1)\n" +
  "    }\n" +
  "  }\n" +
  "  let mut acc = 0\n" +
  "  for x = x + 1; x < 5; x = x + 1 {\n" +
  "    acc = acc * 10 + x\n" +
  "  }\n" +
  "  bump(2)\n" +
  "  (x, acc)\n" +
  "}\n"
  let out = cfor_transpile("cfor_boxed_outer.mbt", src)
  assert_true(str_has(out, "mbt_compat::MbtCell::{ v: 1 }"), "outer `x` captured by a recursive local fn is boxed")
  assert_true(str_has(out, "for let mut x = x.v + 1; x < 5; x = x + 1 {"), "init reads the outer cell; the fresh counter is a plain Int")
  assert_true(str_has(out, "acc = acc * 10 + x\n"), "loop body reads the unboxed counter")
}
