///| Wave M2-F3e unit tests: Stage B lowers `Array[T]` / `FixedArray[T]` `.unsafe_get(i)` / `.unsafe_set(i, v)`
///| to native `recv[i]` / `{ recv[i] = v }` (no cross-package generic helper call), keeps every other receiver
///| type on its existing path, and falls back to the `mbt_compat` helper on anything it cannot prove.

///| Receiver type the mock `pionc check` reports for the identifier (or call) before `.unsafe_*(`.
fn f3e_mock_recv_type(line : String, dot : Int) -> String {
  if dot == 0 {
    return ""
  }
  if line.code_unit_at(dot - 1) == 41 {
    return "Array[Int]"
  }
  let mut s = dot
  while s > 0 && is_alnum(line.code_unit_at(s - 1)) {
    s = s - 1
  }
  let name = line.slice(s, dot)
  if name == "fa" {
    "FixedArray[Double]"
  } else if name == "s" {
    "String"
  } else if name == "b" {
    "Bytes"
  } else if name == "p" {
    ""
  } else {
    "Array[Int]"
  }
}

///| Mock `pionc check --json`: one `unknown method` diagnostic per remaining `.unsafe_get(` / `.unsafe_set(`
///| whose receiver type lacks the method (custom struct `P` defines it, so it is never reported).
fn f3e_mock_check(batch : Array[(String, String)]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"ok\":false,\"diagnostics\":[")
  let mut first = true
  for f in batch {
    let lines = f.1.split("\n")
    let mut li = 0
    while li < lines.length() {
      let ln = lines[li]
      let mut pos = 0
      while pos + 12 <= ln.length() {
        let cand = ln.slice(pos, pos + 12)
        if cand == ".unsafe_get(" || cand == ".unsafe_set(" {
          let ty = f3e_mock_recv_type(ln, pos)
          if ty.length() > 0 {
            if !first {
              sb.write_string(",")
            }
            first = false
            sb.write_string(
              "{\"file\":\"" + f.0 + "\",\"line\":" + (li + 1).to_string() + ",\"col\":" + (pos + 2).to_string() +
              ",\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `" + ln.slice(pos + 1, pos + 11) +
              "` on type `" + ty + "`\"}",
            )
          }
        }
        pos = pos + 1
      }
      li = li + 1
    }
  }
  sb.write_string("]}")
  sb.to_string()
}

fn f3e_run(src : String) -> String {
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  let (out, _, _) = run_stage_b(
    [GeneratedFile::{ rel_path: "f3e.pion", content: src, source_file: "f3e.mbt", anchors: [] }],
    empty_api_map(),
    f3e_mock_check,
    diags,
    ledger,
  )
  out[0].content
}

test "F3e-1: Array/FixedArray unsafe_get/unsafe_set lower to native indexing in every position" {
  let src = "pub fn f(a : Array[Int], fa : FixedArray[Double]) -> Double {\n" +
  "  a.unsafe_set(0, a.unsafe_get(1) + 1)\n" +
  "  let x = if a.length() > 0 { fa.unsafe_get(0) } else { 0.0 }\n" +
  "  match a.length() {\n" +
  "    0 => fa.unsafe_set(1, 2.0)\n" +
  "    _ => ()\n" +
  "  }\n" +
  "  let _ = a.unsafe_set(2, 3)\n" +
  "  fa.unsafe_set(\n" +
  "    a.unsafe_get(0),\n" +
  "    if x > 1.0 { 4.0 } else { 5.0 },\n" +
  "  )\n" +
  "  get_arr().unsafe_set(0, 7)\n" +
  "  let y = get_arr().unsafe_get(0).to_string().length()\n" +
  "  let c = cells.unsafe_get(\"a,b\".length()) + cells.unsafe_get(','.to_int())\n" +
  "  x + y.to_double() + fa.unsafe_get(a.unsafe_get(a.unsafe_get(0)))\n" +
  "}\n"
  let out = f3e_run(src)
  assert_true(str_has(out, "  { a[0] = a[1] + 1 }\n"), "statement unsafe_set with nested unsafe_get: " + out)
  assert_true(str_has(out, "let x = if a.length() > 0 { fa[0] } else { 0.0 }"), "FixedArray get in if branch")
  assert_true(str_has(out, "0 => { fa[1] = 2.0 }"), "unsafe_set in match arm is a block expression")
  assert_true(str_has(out, "let _ = { a[2] = 3 }"), "unsafe_set in let position")
  assert_true(str_has(out, "{ fa[a[0]] = if x > 1.0 { 4.0 } else { 5.0 } }"), "multi-line unsafe_set with trailing comma")
  assert_true(str_has(out, "{ get_arr()[0] = 7 }"), "non-lvalue receiver keeps the call")
  assert_true(str_has(out, "let y = get_arr()[0].to_string().length()"), "chained call after unsafe_get")
  assert_true(str_has(out, "cells[\"a,b\".length()] + cells[','.to_int()]"), "commas inside string / char literals are not separators")
  assert_true(str_has(out, "fa[a[a[0]]]"), "nested gets in index position")
  assert_true(!str_has(out, "unsafe_"), "no unsafe_* call or mbt_compat helper left: " + out)
}

test "F3e-2: String / Bytes / custom struct receivers keep their existing paths" {
  let src = "pub fn g(s : String, p : P, b : Bytes) -> Int {\n" +
  "  s.unsafe_get(0) + p.unsafe_get(0) + b.unsafe_get(0).to_int()\n" +
  "}\n"
  let out = f3e_run(src)
  assert_true(str_has(out, "mbt_compat::utf16_code_unit_at(s, 0)"), "String::unsafe_get stays a UTF-16 code unit read: " + out)
  assert_true(str_has(out, "p.unsafe_get(0)"), "custom struct method untouched")
  assert_true(str_has(out, "b.unsafe_get(0).to_int()"), "Bytes untouched")
  assert_true(!str_has(out, "s[0]") && !str_has(out, "p[0]") && !str_has(out, "b[0]"), "no indexing for non-array receivers")
}

test "F3e-3: unprovable shapes fall back to the mbt_compat helpers" {
  let src = "pub fn h(a : Array[Int], fa : FixedArray[Double]) -> Unit {\n" +
  "  let _ = a.unsafe_get(i=0)\n" +
  "  a.unsafe_set(0, 1, 2)\n" +
  "  a.unsafe_set(\n" +
  "    // a leading comment line\n" +
  "    i=0, 1)\n" +
  "}\n"
  let out = f3e_run(src)
  assert_true(str_has(out, "mbt_compat::arr_unsafe_get(a, i=0)"), "labelled argument falls back: " + out)
  assert_true(str_has(out, "mbt_compat::arr_unsafe_set(a, 0, 1, 2)"), "wrong arity falls back")
  assert_true(str_has(out, "mbt_compat::arr_unsafe_set(a, "), "label after a comment line falls back")
}

test "F3e-3b: line comments inside arguments are kept and never swallow the closing bracket" {
  let src = "pub fn k(a : Array[Int], f : Array[Double], row : Bool) -> Unit {\n" +
  "  f.unsafe_set(0, // keep\n" +
  "    9.0)\n" +
  "  f.unsafe_set(a.unsafe_get(1), if row {\n" +
  "    // (a row kept no narrower than it holds, or -1.0: see `fit`)\n" +
  "    1.0\n" +
  "  } else {\n" +
  "    2.0 // trailing ) , ]\n" +
  "  })\n" +
  "  let x = a.unsafe_get(0 // first\n" +
  "  )\n" +
  "}\n"
  let out = f3e_run(src)
  assert_true(str_has(out, "{ f[0] = // keep\n    9.0\n }"), "commented value keeps its newline: " + out)
  assert_true(
    str_has(out, "{ f[a[1]] = if row {\n    // (a row kept no narrower than it holds, or -1.0: see `fit`)\n    1.0\n  } else {\n    2.0 // trailing ) , ]\n  }\n }"),
    "parens / commas inside comments are not argument syntax",
  )
  assert_true(str_has(out, "let x = a[0 // first\n]"), "commented index keeps its newline")
  assert_true(!str_has(out, "unsafe_"), "no helper left")
}

test "F3e-4: rewrite_unsafe_index_at fails closed on receivers it cannot see whole" {
  let chain = ["  let v = xs", "    .unsafe_get(0)"]
  assert_eq(rewrite_unsafe_index_at(chain, 1, 6, "unsafe_get"), -1)
  assert_true(chain[1] == "    .unsafe_get(0)", "newline-leading chain untouched")
  let multi = ["  let v = f(", "    1).unsafe_get(0)"]
  assert_eq(rewrite_unsafe_index_at(multi, 1, 8, "unsafe_get"), -1)
  let named = ["  a.unsafe_set(i, v?=x)"]
  assert_eq(rewrite_unsafe_index_at(named, 0, 4, "unsafe_set"), -1)
  let punned = ["  a.unsafe_get(i~)"]
  assert_eq(rewrite_unsafe_index_at(punned, 0, 4, "unsafe_get"), -1)
  let eqeq = ["  a.unsafe_get(i == 0)"]
  assert_eq(rewrite_unsafe_index_at(eqeq, 0, 4, "unsafe_get"), 0)
  assert_true(eqeq[0] == "  a[i == 0]", "`==` is not a label")
  let two = ["  a.unsafe_set(", "    i,", "    v", "  ) + 0"]
  assert_eq(rewrite_unsafe_index_at(two, 0, 4, "unsafe_set"), 3)
  assert_true(two[0] == "  { a[i] = v } + 0" && two[1] == "" && two[2] == "" && two[3] == "", "multi-line call collapsed")
}

test "F3e-5: string interpolations and lone colons never cut the call or the receiver" {
  // `"\{f(")")}"`: quotes, parens and commas inside an interpolation are not call syntax.
  let i1 = ["  a.unsafe_set(0, \"\\{f(\")\")}\")"]
  assert_eq(rewrite_unsafe_index_at(i1, 0, 4, "unsafe_set"), 0)
  assert_true(i1[0] == "  { a[0] = \"\\{f(\")\")}\" }", "interpolated value kept whole: " + i1[0])
  let i2 = ["  a.unsafe_set(0, \"\\{f(\"a,b\")}\")"]
  assert_eq(rewrite_unsafe_index_at(i2, 0, 4, "unsafe_set"), 0)
  assert_true(i2[0] == "  { a[0] = \"\\{f(\"a,b\")}\" }", "comma inside interpolation is not a separator: " + i2[0])
  let i3 = ["  a.unsafe_get(\"\\{g('}')}\".length())"]
  assert_eq(rewrite_unsafe_index_at(i3, 0, 4, "unsafe_get"), 0)
  assert_true(i3[0] == "  a[\"\\{g('}')}\".length()]", "char literal inside interpolation: " + i3[0])
  let unclosed = ["  a.unsafe_set(0, \"\\{f(", "  )}\")"]
  assert_eq(rewrite_unsafe_index_at(unclosed, 0, 4, "unsafe_set"), -1)
  // Receivers cross `::` but stop at a lone `:`.
  let c1 = ["  let r = Foo::{key:a.unsafe_get(0)}"]
  assert_eq(rewrite_unsafe_index_at(c1, 0, 22, "unsafe_get"), 0)
  assert_true(c1[0] == "  let r = Foo::{key:a[0]}", "lone colon ends the receiver: " + c1[0])
  let c2 = ["  pkg::xs.unsafe_get(1)"]
  assert_eq(rewrite_unsafe_index_at(c2, 0, 12, "unsafe_get"), 0)
  assert_true(c2[0] == "  pkg::xs[1]", "path receiver keeps `pkg::`: " + c2[0])
  // The helper fallback (String receiver) skips interpolations too.
  let src = "pub fn sfn(s : String) -> Int {\n  s.unsafe_get(\"\\{f(\")\")}\".length())\n}\n"
  let out = f3e_run(src)
  assert_true(str_has(out, "mbt_compat::utf16_code_unit_at(s, \"\\{f(\")\")}\".length())"), "fallback call kept whole: " + out)
}
