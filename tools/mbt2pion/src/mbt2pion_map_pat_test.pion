///| Tests for string-keyed Map / JSON object pattern lowering (`Special case B3m`)
///| and fail-closed diagnostics for invalid struct/map pattern fields.

fn map_pat_transpile_ok(name : String, src : String) -> String {
  let res = transpile_package(
    [SourceFile::{ rel_path: name, content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_true(res.blockers == 0, name + " should transpile with 0 blockers")
  res.files[0].content
}

fn map_pat_transpile_raw(name : String, src : String) -> TranspileResult {
  transpile_package(
    [SourceFile::{ rel_path: name, content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
}

fn map_pat_has_unsupported_diag(res : TranspileResult) -> Bool {
  for d in res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" {
      return true
    }
  }
  false
}

test "map-pat-json-as: Json object pattern with Object(_) as input lowers cleanly and registers binder type" {
  let src = "pub fn extract_input(j : Json) -> String {\n" +
  "  match j {\n" +
  "    { \"input\": Object(_) as input, .. } => input.stringify()\n" +
  "    _ => \"none\"\n" +
  "  }\n" +
  "}\n"
  let out = map_pat_transpile_ok("json_as.mbt", src)
  assert_true(
    str_has(out, "mbt_compat::MbtJson::Object("),
    "outer match must check MbtJson::Object",
  )
  assert_true(
    str_has(out, ".get(\"input\")"),
    "must look up key \"input\" via .get(\"input\")",
  )
  assert_true(
    str_has(out, "mbt_compat::MbtJson::Object(_)"),
    "inner Object(_) must resolve to MbtJson::Object(_)",
  )
  assert_true(
    str_has(out, "input.stringify()"),
    "body must call input.stringify()",
  )
  assert_true(
    str_has(out, "_ => \"none\""),
    "fallback arm must remain reachable",
  )
}

test "map-pat-json-lit: pure literal { \"ok\": true, .. } lowers with guard and never degenerates to catchall" {
  let src = "pub fn check_ok(j : Json) -> Int {\n" +
  "  match j {\n" +
  "    { \"ok\": true, .. } => 1\n" +
  "    { \"ok\": false, .. } => 2\n" +
  "    _ => 0\n" +
  "  }\n" +
  "}\n"
  let out = map_pat_transpile_ok("json_lit.mbt", src)
  assert_true(
    str_has(out, "mbt_compat::MbtJson::Object("),
    "must match MbtJson::Object",
  )
  assert_true(
    str_has(out, ".get(\"ok\")"),
    "must look up key \"ok\"",
  )
  assert_true(
    str_has(out, "Some(mbt_compat::MbtJson::True)"),
    "true literal must lower to MbtJson::True",
  )
  assert_true(
    str_has(out, "Some(mbt_compat::MbtJson::False)"),
    "false literal must lower to MbtJson::False",
  )
  assert_true(
    !str_has(out, "__mbt_sp_"),
    "must not fall through to struct pattern lowering",
  )
}

test "map-pat-multi-opt-guard: multi-key + optional key + pure guard lowers with fallthrough" {
  let src = "pub fn route_req(j : Json) -> String {\n" +
  "  match j {\n" +
  "    { \"kind\": String(k), \"tag\"?: Some(String(t)), .. } if k == \"run\" => k + \":\" + t\n" +
  "    { \"kind\": String(k), \"tag\"?: None, .. } => k + \":none\"\n" +
  "    _ => \"other\"\n" +
  "  }\n" +
  "}\n"
  let out = map_pat_transpile_ok("json_multi_opt.mbt", src)
  assert_true(str_has(out, ".get(\"kind\")"), "must check required key kind")
  assert_true(str_has(out, ".get(\"tag\")"), "must check optional key tag")
  assert_true(str_has(out, "mbt_compat::MbtJson::String(k)"), "String(k) must resolve to MbtJson::String")
  assert_true(str_has(out, "Some(mbt_compat::MbtJson::String(t))"), "optional Some(String(t)) must resolve to MbtJson::String")
  assert_true(str_has(out, "k == \"run\""), "guard must see bound variable k")
}

test "map-pat-string-map: Map[String, Int] pattern with bindings, literal, and outer as" {
  let src = "pub fn match_map(m : Map[String, Int]) -> Int {\n" +
  "  match m {\n" +
  "    { \"a\": x, \"b\": 2, .. } if x > 0 => x + 2\n" +
  "    { \"a\": x } as whole => x + whole.length()\n" +
  "    _ => -1\n" +
  "  }\n" +
  "}\n"
  let out = map_pat_transpile_ok("string_map.mbt", src)
  assert_true(str_has(out, ".get(\"a\")"), "must look up key a")
  assert_true(str_has(out, ".get(\"b\")"), "must look up key b")
  assert_true(str_has(out, "Some(2)"), "literal 2 in Map[String, Int] stays 2")
  assert_true(str_has(out, "x > 0"), "guard must see bound variable x")
  assert_true(str_has(out, "whole.length()"), "outer as binding must be visible in body")
}

test "map-pat-fail-closed: invalid and unsupported map/struct patterns emit MBT2PION_UNSUPPORTED_SYNTAX" {
  // 1. Standalone `expr is { "k": v, .. }`
  let r1 = map_pat_transpile_raw(
    "is_map_bind.mbt",
    "pub fn f(j : Json) -> Bool { j is { \"k\": v, .. } }\n",
  )
  assert_true(r1.blockers > 0 && map_pat_has_unsupported_diag(r1), "standalone is with map binder must fail closed")

  // 2. Standalone `expr is { "k": true, .. }`
  let r2 = map_pat_transpile_raw(
    "is_map_lit.mbt",
    "pub fn f(j : Json) -> Bool { j is { \"k\": true, .. } }\n",
  )
  assert_true(r2.blockers > 0 && map_pat_has_unsupported_diag(r2), "standalone is with map literal must fail closed")

  // 3. Non-string key `{ 1: x }`
  let r3 = map_pat_transpile_raw(
    "int_key.mbt",
    "pub fn f(m : Map[Int, Int]) -> Int { match m { { 1: x, .. } => x, _ => 0 } }\n",
  )
  assert_true(r3.blockers > 0 && map_pat_has_unsupported_diag(r3), "non-string key map pattern must fail closed")

  // 4. Duplicate key `{ "a": x, "a": y }`
  let r4 = map_pat_transpile_raw(
    "dup_key.mbt",
    "pub fn f(m : Map[String, Int]) -> Int { match m { { \"a\": x, \"a\": y, .. } => x + y, _ => 0 } }\n",
  )
  assert_true(r4.blockers > 0 && map_pat_has_unsupported_diag(r4), "duplicate key map pattern must fail closed")

  // 5. Unknown scrutinee type
  let r5 = map_pat_transpile_raw(
    "unknown_scrut.mbt",
    "pub fn f[T](x : T) -> Int { match x { { \"a\": _, .. } => 1, _ => 0 } }\n",
  )
  assert_true(r5.blockers > 0 && map_pat_has_unsupported_diag(r5), "unknown scrutinee type must fail closed")

  // 6. Nested map/object pattern `{ "a": { "b": x } }`
  let r6 = map_pat_transpile_raw(
    "nested_map.mbt",
    "pub fn f(j : Json) -> Int { match j { { \"a\": { \"b\": _, .. }, .. } => 1, _ => 0 } }\n",
  )
  assert_true(r6.blockers > 0 && map_pat_has_unsupported_diag(r6), "nested map pattern must fail closed")

  // 7. Or-pattern combined with map pattern
  let r7 = map_pat_transpile_raw(
    "or_map.mbt",
    "pub fn f(j : Json) -> Int { match j { { \"a\": true } | { \"b\": false } => 1, _ => 0 } }\n",
  )
  assert_true(r7.blockers > 0 && map_pat_has_unsupported_diag(r7), "or-pattern with map pattern must fail closed")

  // 8. Empty `{}` and `{ .. }` on Json
  let r8 = map_pat_transpile_raw(
    "empty_json.mbt",
    "pub fn f(j : Json) -> Int { match j { {} => 1, _ => 0 } }\n",
  )
  assert_true(r8.blockers > 0 && map_pat_has_unsupported_diag(r8), "empty {} on Json must fail closed")

  // 9. Impure guard with bindings
  let r9 = map_pat_transpile_raw(
    "impure_guard.mbt",
    "fn side_effect(x : Int) -> Bool { x > 0 }\npub fn f(m : Map[String, Int]) -> Int { match m { { \"a\": x, .. } if side_effect(x) => x, _ => 0 } }\n",
  )
  assert_true(r9.blockers > 0 && map_pat_has_unsupported_diag(r9), "impure guard with map binders must fail closed")

  // 10. Invalid field inside struct pattern
  let r10 = map_pat_transpile_raw(
    "bad_struct_field.mbt",
    "struct Pt { x : Int }\npub fn f(p : Pt) -> Int { match p { { 1: _ } => 1, _ => 0 } }\n",
  )
  assert_true(r10.blockers > 0 && map_pat_has_unsupported_diag(r10), "invalid field in struct pattern must fail closed")

  // 11. Empty `{ .. }` / `({})` / `Some({ .. })` on Json/Map/Option[Json] must fail closed
  let r11a = map_pat_transpile_raw(
    "is_empty_json.mbt",
    "pub fn f(j : Json) -> Bool { j is { .. } }\n",
  )
  assert_true(r11a.blockers > 0 && map_pat_has_unsupported_diag(r11a), "j is { .. } must fail closed")

  let r11b = map_pat_transpile_raw(
    "paren_empty_json.mbt",
    "pub fn f(j : Json) -> Int { match j { ({}) => 1, _ => 0 } }\n",
  )
  assert_true(r11b.blockers > 0 && map_pat_has_unsupported_diag(r11b), "parenthesized ({}) on Json must fail closed")

  let r11c = map_pat_transpile_raw(
    "opt_empty_json.mbt",
    "pub fn f(opt : Option[Json]) -> Int { match opt { Some({ .. }) => 1, _ => 0 } }\n",
  )
  assert_true(r11c.blockers > 0 && map_pat_has_unsupported_diag(r11c), "Some({ .. }) on Option[Json] must fail closed")

  // 12. Nested map pattern inside struct field pattern must fail closed
  let r12 = map_pat_transpile_raw(
    "struct_nested_map.mbt",
    "struct Wrap { j : Json }\npub fn f(w : Wrap) -> Int { match w { { j: { \"k\": true, .. } } => 1, _ => 0 } }\n",
  )
  assert_true(r12.blockers > 0 && map_pat_has_unsupported_diag(r12), "struct field containing map pattern must fail closed")

  // 13. `is` pattern inside B3m guard must fail closed (prevents binder scope leak)
  let r13 = map_pat_transpile_raw(
    "guard_is_leak.mbt",
    "pub fn f(j : Json, maybe : Option[Int]) -> Int {\n  let x = 99\n  match j {\n    { \"ok\": true, .. } if maybe is Some(x) => x\n    _ => x\n  }\n}\n",
  )
  assert_true(r13.blockers > 0 && map_pat_has_unsupported_diag(r13), "`is` inside B3m guard must fail closed")

  // 14. Custom Eq / non-primitive operator in B3m guard with bindings must fail closed
  let r14 = map_pat_transpile_raw(
    "guard_custom_eq.mbt",
    "struct Item { id : Int }\npub fn f(m : Map[String, Item], rhs : Item) -> Int {\n  match m {\n    { \"a\": x, .. } if x == rhs => 1\n    _ => 0\n  }\n}\n",
  )
  assert_true(r14.blockers > 0 && map_pat_has_unsupported_diag(r14), "non-primitive == in B3m guard with bindings must fail closed")

  // 15. Decoded duplicate key `"\u0061"` vs `"a"` and unknown escape `"\q"` must fail closed
  let r15a = map_pat_transpile_raw(
    "decoded_dup_key.mbt",
    "pub fn f(m : Map[String, Int]) -> Int { match m { { \"a\": x, \"\\u0061\": y, .. } => x + y, _ => 0 } }\n",
  )
  assert_true(r15a.blockers > 0 && map_pat_has_unsupported_diag(r15a), "decoded duplicate key \\u0061 vs a must fail closed")

  let r15b = map_pat_transpile_raw(
    "unknown_escape_key.mbt",
    "pub fn f(m : Map[String, Int]) -> Int { match m { { \"\\q\": x, .. } => x, _ => 0 } }\n",
  )
  assert_true(r15b.blockers > 0 && map_pat_has_unsupported_diag(r15b), "unknown escape in string key must fail closed")

  // 16. Or-pattern `|`, bare numeric `as`, and nested `as` inside value patterns must fail closed
  let r16a = map_pat_transpile_raw(
    "val_or_pat.mbt",
    "pub fn f(j : Json) -> Int { match j { { \"ok\": true | false, .. } => 1, _ => 0 } }\n",
  )
  assert_true(r16a.blockers > 0 && map_pat_has_unsupported_diag(r16a), "or-pattern inside value pattern must fail closed")

  let r16b = map_pat_transpile_raw(
    "val_num_as.mbt",
    "pub fn f(j : Json) -> Int { match j { { \"n\": 1 as n, .. } => 1, _ => 0 } }\n",
  )
  assert_true(r16b.blockers > 0 && map_pat_has_unsupported_diag(r16b), "bare numeric literal as-pattern in Json must fail closed")

  let r16c = map_pat_transpile_raw(
    "val_nested_as.mbt",
    "pub fn f(j : Json) -> String { match j { { \"s\": String(\"hi\" as s), .. } => s, _ => \"\" } }\n",
  )
  assert_true(r16c.blockers > 0 && map_pat_has_unsupported_diag(r16c), "nested String(\"hi\" as s) must fail closed")
}

test "map-pat-r2-positive: escaped key \\b, Map[String, Json], parenthesized arm, and shadowed Object enum" {
  let src = "enum Foo { Object(Int) }\n" +
  "pub fn match_bs(j : Json) -> Bool {\n" +
  "  match j {\n" +
  "    ({ \"\\b\": true, .. }) => true\n" +
  "    _ => false\n" +
  "  }\n" +
  "}\n" +
  "pub fn match_map_json(m : Map[String, Json]) -> String {\n" +
  "  match m {\n" +
  "    { \"ok\": true, \"k\"?: Some(Object(_) as v), .. } => v.stringify()\n" +
  "    { \"msg\"?: Some(\"yes\") as opt, .. } => match opt { Some(v) => v.stringify(), None => \"\" }\n" +
  "    _ => \"none\"\n" +
  "  }\n" +
  "}\n"
  let out = map_pat_transpile_ok("r2_positive.mbt", src)
  assert_true(str_has(out, ".get(\"\\u{8}\")"), "\\b key must re-encode to Pion \\u{8}")
  assert_true(str_has(out, "Some(mbt_compat::MbtJson::True)"), "Map[String, Json] must normalize true to MbtJson::True")
  assert_true(str_has(out, "mbt_compat::MbtJson::Object(_)"), "Some(Object(_) as v) must not be hijacked by local enum Foo::Object")
  assert_true(str_has(out, "Some(mbt_compat::MbtJson::String(\"yes\"))"), "Some(\"yes\") as opt must normalize inner String literal")
}

test "lower-struct-pat-guards-fail-closed: invalid field returns false and emits diagnostic" {
  let ctx = stage_a_context_new(
    empty_symbol_table(),
    default_recipes(),
    default_options(),
  )
  let toks = lex_moonbit("{ \"k\": true, .. }")
  let close_b = find_matching_delim(toks, 0)
  let g = lower_struct_pat_guards(ctx, "v", toks, 0, close_b, "test.mbt")
  assert_true(g == "false", "invalid field in lower_struct_pat_guards must return false, never empty")
  let mut found = false
  for d in ctx.diags {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" {
      found = true
    }
  }
  assert_true(found, "lower_struct_pat_guards must emit MBT2PION_UNSUPPORTED_SYNTAX")
}
