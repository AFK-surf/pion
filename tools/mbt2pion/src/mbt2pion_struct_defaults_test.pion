///| Unit tests for declarative `[struct_defaults]` recipes, `MbtJson` equality literal wrapping,
///| and single-arg `.set(v)` expected-type propagation with trailing `SourceLoc` / optional params.

test "recipes struct_defaults parse quoted, bare, trailing comments, fail-closed errors, and canonical sha256" {
  let toml_a =
  "[struct_defaults.\"cfg::BoxCfg\"] # trailing section comment\n" +
  "pad = \"Option::None\" # trailing value comment\n" +
  "compact = \"false\"\n\n" +
  "[struct_defaults.Cell] # bare target comment\n" +
  "active = \"true\"\n" +
  "count = \"0\"\n"
  let diags_a : Array[Diag] = []
  let rec_a = parse_recipes_toml(toml_a, "recipes.toml", diags_a)
  assert_eq(diags_a.length(), 0)
  assert_eq(rec_a.struct_defaults.length(), 2)
  assert_true(rec_a.struct_defaults[0].target_type == "Cell", "sorted target 0")
  assert_eq(rec_a.struct_defaults[0].fields.length(), 2)
  assert_true(rec_a.struct_defaults[0].fields[0].field == "active", "sorted field 0")
  assert_true(rec_a.struct_defaults[0].fields[0].expr == "true", "field 0 expr")
  assert_true(rec_a.struct_defaults[0].fields[1].field == "count", "sorted field 1")
  assert_true(rec_a.struct_defaults[0].fields[1].expr == "0", "field 1 expr")
  assert_true(rec_a.struct_defaults[1].target_type == "cfg::BoxCfg", "sorted target 1")
  assert_true(rec_a.struct_defaults[1].fields[0].field == "compact", "sorted field 0")
  assert_true(rec_a.struct_defaults[1].fields[0].expr == "false", "field 0 expr")
  assert_true(rec_a.struct_defaults[1].fields[1].field == "pad", "sorted field 1")
  assert_true(rec_a.struct_defaults[1].fields[1].expr == "Option::None", "field 1 expr")

  // Reordered sections and keys must produce the exact same canonical hash.
  let toml_reordered =
  "[struct_defaults.Cell]\n" +
  "count = \"0\"\n" +
  "active = \"true\"\n\n" +
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "compact = \"false\"\n" +
  "pad = \"Option::None\"\n"
  let diags_r : Array[Diag] = []
  let rec_r = parse_recipes_toml(toml_reordered, "recipes.toml", diags_r)
  assert_eq(diags_r.length(), 0)
  assert_true(
    recipes_canonical_sha256(rec_a) == recipes_canonical_sha256(rec_r),
    "reordered recipes must share identical canonical sha256",
  )

  // Changing any default value must change recipes_canonical_sha256.
  let toml_changed =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n" +
  "compact = \"true\"\n\n" +
  "[struct_defaults.Cell]\n" +
  "active = \"true\"\n" +
  "count = \"0\"\n"
  let diags_c : Array[Diag] = []
  let rec_c = parse_recipes_toml(toml_changed, "recipes.toml", diags_c)
  assert_eq(diags_c.length(), 0)
  assert_true(
    recipes_canonical_sha256(rec_a) != recipes_canonical_sha256(rec_c),
    "changed struct_defaults value must change canonical sha256",
  )
  assert_true(
    recipes_canonical_sha256(rec_a) != recipes_canonical_sha256(default_recipes()),
    "non-empty struct_defaults must differ from default_recipes sha256",
  )

  // Fail-closed validation: empty field, empty expr, duplicate field, empty target.
  let bad_toml =
  "[struct_defaults.\"\"]\n" +
  "a = \"1\"\n" +
  "[struct_defaults.Box]\n" +
  " = \"1\"\n" +
  "a = \"\"\n" +
  "b = \"1\"\n" +
  "b = \"2\"\n"
  let bad_diags : Array[Diag] = []
  let _ = parse_recipes_toml(bad_toml, "bad.toml", bad_diags)
  assert_true(bad_diags.length() >= 4, "bad struct_defaults entries must fail closed")
}

test "struct_defaults fills named qualified, anonymous expected, empty, shorthand, and skips spread/patterns" {
  let rec_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n" +
  "compact = \"false\"\n\n" +
  "[struct_defaults.Cell]\n" +
  "val = \"0\"\n" +
  "flag = \"false\"\n"
  let rdiags : Array[Diag] = []
  let recipes = parse_recipes_toml(rec_toml, "recipes.toml", rdiags)
  assert_eq(rdiags.length(), 0)

  let src =
  "pub struct Cell {\n" +
  "  val : Int\n" +
  "  flag : Bool\n" +
  "}\n\n" +
  "pub fn make_named() -> @cfg.BoxCfg {\n" +
  "  @cfg.BoxCfg::{ size: 14.0 }\n" +
  "}\n\n" +
  "pub fn make_qualified_direct() -> cfg::BoxCfg {\n" +
  "  cfg::BoxCfg::{ size: 12.0, compact: true }\n" +
  "}\n\n" +
  "pub fn make_anon_expected() -> @cfg.BoxCfg {\n" +
  "  { size: 16.0 }\n" +
  "}\n\n" +
  "pub fn make_shorthand(pad : Option[Bool]) -> @cfg.BoxCfg {\n" +
  "  @cfg.BoxCfg::{ pad, size: 18.0 }\n" +
  "}\n\n" +
  "pub fn make_anon_shorthand(pad : Option[Bool]) -> @cfg.BoxCfg {\n" +
  "  { pad, size: 19.0 }\n" +
  "}\n\n" +
  "pub fn make_empty_local() -> Cell {\n" +
  "  Cell::{}\n" +
  "}\n\n" +
  "pub fn make_local_with_renamed_field() -> Cell {\n" +
  "  { val: 7 }\n" +
  "}\n\n" +
  "pub fn make_spread(base : Cell) -> Cell {\n" +
  "  Cell::{ ..base, flag: true }\n" +
  "}\n\n" +
  "pub fn match_pattern(c : Cell) -> Int {\n" +
  "  match c {\n" +
  "    { val, .. } => val\n" +
  "  }\n" +
  "}\n"

  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["cfg"] = "cfg"
  let api = ApiMap::{
    symbols: [],
    pkg_aliases: pkg_aliases,
  }
  let res = transpile_package(
    [SourceFile::{ rel_path: "box_cfg.mbt", content: src, is_test: false }],
    api,
    recipes,
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  assert_eq(res.files.length(), 1)
  let out = res.files[0].content

  // 1. `@cfg.BoxCfg::{ size: 14.0 }` gets both defaults in deterministic order.
  assert_true(
    str_has(out, "cfg::BoxCfg::{ size: 14.0, compact: false, pad: Option::None }"),
    "named @cfg.BoxCfg should fill missing defaults: " + out,
  )
  // 2. Explicit `compact: true` is NOT overwritten or duplicated; only `pad` is appended.
  assert_true(
    str_has(out, "cfg::BoxCfg::{ size: 12.0, compact: true, pad: Option::None }"),
    "explicit field must not be overwritten or duplicated: " + out,
  )
  // 3. Anonymous `{ size: 16.0 }` under expected `cfg::BoxCfg` gets both defaults.
  assert_true(
    str_has(out, "cfg::BoxCfg::{ size: 16.0, compact: false, pad: Option::None }"),
    "anonymous expected BoxCfg should fill missing defaults: " + out,
  )
  // 4. Named shorthand `{ pad, size: 18.0 }` does NOT duplicate `pad`.
  assert_true(
    str_has(out, "cfg::BoxCfg::{ pad, size: 18.0, compact: false }"),
    "named shorthand field must not be duplicated: " + out,
  )
  // 5. Anonymous shorthand `{ pad, size: 19.0 }` does NOT duplicate `pad`.
  assert_true(
    str_has(out, "cfg::BoxCfg::{ pad: pad, size: 19.0, compact: false }"),
    "anonymous shorthand field must not be duplicated: " + out,
  )
  // 6. Empty `Cell::{}` fills all defaults (with keyword-renamed `val_`).
  assert_true(
    str_has(out, "Cell::{ flag: false, val_: 0 }"),
    "empty Cell::{} should fill all defaults: " + out,
  )
  // 7. Anonymous `{ val: 7 }` recognizes renamed `val_` as already present and only appends `flag: false`.
  assert_true(
    str_has(out, "Cell::{ val_: 7, flag: false }"),
    "anonymous local Cell with renamed field should not duplicate val_: " + out,
  )
  // 8. Spread `Cell::{ ..base, flag: true }` does NOT append `val_: 0`.
  assert_true(
    str_has(out, "Cell::{ ..base, flag: true }"),
    "spread literal must remain intact: " + out,
  )
  assert_true(
    !str_has(out, "..base, flag: true, val_"),
    "spread literal must not append defaults: " + out,
  )
  // 9. Pattern `{ val, .. }` is NOT mutated with defaults.
  assert_true(
    !str_has(out, "flag: false =>"),
    "struct pattern must not be modified: " + out,
  )
}

test "mbt_json equality comparison wraps literals, parens with parens-in-strings, and compound json values" {
  let src =
  "pub fn cmp_json(r : Json, s : String, n : Int, other : Json) -> Bool {\n" +
  "  let a = r == \"alpha\"\n" +
  "  let b = \"alpha\" == r\n" +
  "  let c = r != 42\n" +
  "  let d = true == r\n" +
  "  let e = r == s\n" +
  "  let f = n != r\n" +
  "  let g = r == \"x\" && \"y\" != r\n" +
  "  let h = (r) == (\"z\")\n" +
  "  let p1 = r == (\"a)\")\n" +
  "  let p2 = r == (\"(a\")\n" +
  "  let same = r == other\n" +
  "  let plain = s == \"alpha\"\n" +
  "  a && b && c && d && e && f && g && h && p1 && p2 && same && plain\n" +
  "}\n\n" +
  "pub fn build_obj(r : Json) -> Json {\n" +
  "  {\n" +
  "    \"ok\": true && r == \"alpha\",\n" +
  "    \"any\": false || r == \"alpha\"\n" +
  "  }\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "json_cmp.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  let out = res.files[0].content
  assert_true(str_has(out, "let a = r == mbt_compat::MbtJson::String(\"alpha\")"), "r == string: " + out)
  assert_true(str_has(out, "let b = mbt_compat::MbtJson::String(\"alpha\") == r"), "string == r: " + out)
  assert_true(str_has(out, "let c = r != mbt_compat::MbtJson::Number("), "r != int: " + out)
  assert_true(str_has(out, "let d = mbt_compat::MbtJson::True == r"), "bool == r: " + out)
  assert_true(str_has(out, "let e = r == mbt_compat::MbtJson::String(s)"), "r == String var: " + out)
  assert_true(str_has(out, "let f = mbt_compat::MbtJson::number((n).to_double()) != r"), "Int var != r: " + out)
  assert_true(
    str_has(out, "let g = r == mbt_compat::MbtJson::String(\"x\") && mbt_compat::MbtJson::String(\"y\") != r"),
    "compound && json eq: " + out,
  )
  assert_true(str_has(out, "let h = (r) == (mbt_compat::MbtJson::String(\"z\"))"), "parenthesized json eq: " + out)
  assert_true(str_has(out, "let p1 = r == (mbt_compat::MbtJson::String(\"a)\"))"), "paren string with ')' must not double-wrap: " + out)
  assert_true(str_has(out, "let p2 = r == (mbt_compat::MbtJson::String(\"(a\"))"), "paren string with '(' must not double-wrap: " + out)
  assert_true(str_has(out, "let same = r == other"), "json == json unchanged: " + out)
  assert_true(str_has(out, "let plain = s == \"alpha\""), "string == string unchanged: " + out)
  assert_true(
    str_has(out, "(\"ok\", true && r == mbt_compat::MbtJson::String(\"alpha\"))") ||
    str_has(out, "(\"ok\", mbt_compat::MbtJson::boolean(true && r == mbt_compat::MbtJson::String(\"alpha\")))"),
    "true && r == alpha must not wrap true as MbtJson::True: " + out,
  )
  assert_true(
    !str_has(out, "mbt_compat::MbtJson::True &&"),
    "must not emit MbtJson::True &&: " + out,
  )
  assert_true(
    !str_has(out, "mbt_compat::MbtJson::False ||"),
    "must not emit MbtJson::False ||: " + out,
  )
}

test "mbt_json equality comparison does not wrap when local struct Json shadows built-in Json" {
  let src =
  "pub struct Json {\n" +
  "  tag : String\n" +
  "}\n\n" +
  "pub fn cmp_local(r : Json, other : Json) -> Bool {\n" +
  "  let a = r == other\n" +
  "  let b = r == \"alpha\"\n" +
  "  a && b\n" +
  "}\n\n" +
  "pub fn cmp_generic[Json](r : Json) -> Bool {\n" +
  "  r == \"beta\"\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "shadow_json.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  let out = res.files[0].content
  assert_true(!str_has(out, "MbtJson::"), "shadowed Json must not emit MbtJson: " + out)
  assert_true(str_has(out, "r == other"), "local Json == local Json: " + out)
  assert_true(str_has(out, "r == \"alpha\""), "local Json == string unchanged: " + out)
  assert_true(str_has(out, "r == \"beta\""), "generic Json == string unchanged: " + out)
}

test "resolve_single_arg_set_param_ty supports trailing SourceLoc in cross-pkg mbti and rejects 2-arg set" {
  let dep_mbti =
  "package \"store\"\n\n" +
  "pub(all) struct Cell[T] {\n" +
  "  mut value : T\n" +
  "}\n" +
  "#callsite(autofill(loc))\n" +
  "pub fn[T] Cell::set(Self[T], T, loc~ : SourceLoc) -> Unit\n" +
  "pub fn[K, V] Table::set(Self[K, V], K, V) -> Unit\n"
  let src =
  "pub fn update(cell : @store.Cell[Json?], tbl : @store.Table[String, Int]) -> Unit {\n" +
  "  cell.set(Some({ \"k\": \"v\", \"arr\": [\"a\"] }))\n" +
  "  tbl.set(\"x\", 1)\n" +
  "}\n"
  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["store"] = "store"
  let api = ApiMap::{
    symbols: [],
    pkg_aliases: pkg_aliases,
  }
  let res = transpile_package_ex(
    [SourceFile::{ rel_path: "use_store.mbt", content: src, is_test: false }],
    api,
    default_recipes(),
    [],
    [("store.mbti", dep_mbti)],
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  let out = res.files[0].content
  assert_true(
    str_has(out, "cell.set(Some(mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([(\"k\", mbt_compat::MbtJson::String(\"v\")), (\"arr\", mbt_compat::MbtJson::Array([mbt_compat::MbtJson::String(\"a\")]))]))))"),
    "Cell::set with trailing SourceLoc must propagate Option[MbtJson]: " + out,
  )
  assert_true(
    str_has(out, "tbl.set(\"x\", 1)"),
    "2-required-arg Table::set must remain untouched: " + out,
  )
}
