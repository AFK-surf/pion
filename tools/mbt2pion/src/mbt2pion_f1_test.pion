///| Wave M2-F1 unit tests:
///| - container indexing type inference (`let pool = pools[d]`) + `.unsafe_set`/`.set`/`.push` enum disambiguation
///| - `mbt_compat::Ref[T]` in enum variant payloads (never probed as indexing)
///| - E1-4 pure immediate read-only `.iter()` slice consumption + fail-closed escaping/mutating `.iter()`
///| - `match` arms followed by `{ ... }` struct literal (with direct `for` arm bodies and `signals` pattern)
///| - `Float::to_double`, `Float::reinterpret_from_int`, `Double::to_uint`
///| - array literal & `is Some(...)` / `is (Some(...) | ...)` expected-type enum disambiguation
///| - `&Trait` -> `dyn Trait`, `as &Trait` -> `as dyn Trait`, split `impl Trait for T with ...` merging & UFCS calls.

test "f1-1: pool = pools[d] infers Pool and disambiguates unsafe_set/set/push" {
  let src = SourceFile::{
    rel_path: "f11.mbt",
    content: "pub(all) enum AlignA { Auto; Start }\npub(all) enum AlignB { Auto; End }\npub struct Pool { aligns : FixedArray[AlignA] }\nlet pools : Array[Pool] = []\npub fn set_auto(d : Int, k : Int) -> Unit {\n  let pool = pools[d]\n  pool.aligns.unsafe_set(k, Auto)\n  let local_arr : Array[AlignB] = []\n  local_arr.push(Auto)\n  local_arr.set(0, Auto)\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let mut out = ""
  for f in res.files { out = out + "\n" + f.content }
  assert_true(str_has(out, "pool.aligns.unsafe_set(k, AlignA::Auto)"), "pool.aligns.unsafe_set must disambiguate AlignA::Auto")
  assert_true(str_has(out, "local_arr.push(AlignB::Auto)"), "local_arr.push must disambiguate AlignB::Auto")
  assert_true(str_has(out, "local_arr.set(0, AlignB::Auto)"), "local_arr.set must disambiguate AlignB::Auto")
}

test "f1-2: pure immediate read-only slice .iter() lowers to __mbt_slice_owned(__ITER__), escaping/mutating/external/indirect/shadowed stays borrow" {
  let src = SourceFile::{
    rel_path: "f12.mbt",
    content: "pub struct Log { seen : Array[Int] }\nfn mutate(_l : Log) -> Unit { () }\nfn bump() -> Unit { () }\npub fn ok_iter(self : Log) -> String {\n  let n = self.seen.length()\n  self.seen[0:if n > 6 { 6 } else { n }].iter().map(fn(x) { x.to_string() }).collect().join(\"; \")\n}\npub fn bad_escape(self : Log) -> Int {\n  let it = self.seen[0:2].iter()\n  it.count()\n}\npub fn bad_mut(self : Log) -> Array[Int] {\n  self.seen[0:2].iter().map(fn(x) { self.seen[0] = x; x }).collect()\n}\npub fn bad_mutate_call(self : Log) -> Array[Int] {\n  self.seen[0:2].iter().map(fn(x) { mutate(self); x }).collect()\n}\npub fn bad_cb_var(self : Log, cb : (Int) -> Int) -> Array[Int] {\n  self.seen[0:2].iter().map(cb).collect()\n}\npub fn bad_free_call(self : Log) -> Array[Int] {\n  self.seen[0:2].iter().map(fn(x) { bump(); x }).collect()\n}\npub fn bad_indirect_call(self : Log, cb : () -> Int) -> Array[Int] {\n  self.seen[0:2].iter().map(fn(x) { x + (cb)() }).collect()\n}\npub fn bad_alias_method(self : Log, alias_arr : Array[Int]) -> Array[Int] {\n  self.seen[0:2].iter().map(fn(x) { x + alias_arr.length() }).collect()\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  let out = res.files[0].content
  assert_true(str_has(out, "__mbt_slice_owned(self.seen, 0, if n > 6 { 6 } else { n }, \"__ITER__\").map("), "pure immediate .iter() uses __mbt_slice_owned with __ITER__")
  assert_true(str_has(out, "__mbt_slice_borrow(self.seen, 0, 2).iter()"), "escaping and mutating .iter() stay __mbt_slice_borrow")
  let mut borrow_hits = 0
  let needle = "__mbt_slice_borrow(self.seen, 0, 2)"
  let mut pos = 0
  while pos + needle.length() <= out.length() {
    if out.slice(pos, pos + needle.length()) == needle {
      borrow_hits = borrow_hits + 1
      pos = pos + needle.length()
    } else {
      pos = pos + 1
    }
  }
  assert_eq(borrow_hits, 7)
  // Also verify local `Holder::length` blocks even `x.length()` on `Array[Holder]`
  let src2 = SourceFile::{
    rel_path: "f12_shadow.mbt",
    content: "pub struct Holder { xs : Array[Int] }\nfn Holder::length(self : Holder) -> Int { self.xs[0] = 99; 0 }\npub fn bad_local_len(hs : Array[Holder]) -> Array[Int] {\n  hs[0:2].iter().map(fn(x) { x.length() }).collect()\n}\n",
    is_test: false,
  }
  let res2 = transpile_package([src2], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(str_has(res2.files[0].content, "__mbt_slice_borrow(hs, 0, 2).iter()"), "local Holder::length must force __mbt_slice_borrow")
}

test "f1-3: match followed by struct literal wraps direct for arms and preserves trailing struct" {
  let src = SourceFile::{
    rel_path: "f13.mbt",
    content: "pub(all) enum Kind { A; B }\npub struct Out { data : FixedArray[Int]; n : Int }\npub fn build(k : Kind, n : Int) -> Out {\n  let data = FixedArray::make(n, 0)\n  match k {\n    A => for i in 0..<n { data[i] = i }\n    B =>\n      for i in 0..<n {\n        data[i] = i * 2\n      }\n  }\n  { data, n }\n}\npub struct Pair { node : Int; own : Int }\npub fn mk_pair(o : Int?) -> Pair {\n  let mut own = 0\n  match o {\n    Some(p) => own = p\n    None => ()\n  }\n  { node: 1, own }\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "{ for i in 0..<n"), "direct for arm body must be wrapped in braces")
  assert_true(str_has(out, "Out::{ data: data, n: n }"), "trailing struct literal after match must remain separate return expr")
  assert_true(str_has(out, "Pair::{ node: 1, own: own }"), "trailing shorthand struct literal after match must remain separate return expr")
}

test "f1-4: Float::to_double, Float::reinterpret_from_int, array lit & is Some(Ctor) disambiguation" {
  let src = SourceFile::{
    rel_path: "f14.mbt",
    content: "pub(all) enum Verb { Move; Line; Close }\npub(all) enum Seg { Close; Other }\npub struct Path { verbs : Array[Verb] }\nlet eps : Float = 1.0\npub let eps_d : Double = Float::to_double(eps * eps)\npub fn from_bits(x : Int) -> Float { Float::reinterpret_from_int(x) }\npub fn mk_path() -> Path { { verbs: [Move, Line, Close] } }\npub fn check_last(p : Path, next : Verb?) -> Bool {\n  !(p.verbs.last() is Some(Close)) && (next is (Some(Move) | Some(Close) | None))\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let mut out = ""
  for f in res.files { out = out + "\n" + f.content }
  assert_true(str_has(out, "Float::from_bits(x)"), "Float::reinterpret_from_int lowers to Float::from_bits")
  assert_true(str_has(out, "(eps * eps).to_double()"), "Float::to_double lowers to (x).to_double()")
  assert_true(str_has(out, "Verb::Close]"), "array literal propagates element expected type")
  assert_true(str_has(out, "Some(Verb::Close)"), "is Some(Close) and is (Some(Move) | Some(Close) | None) disambiguate Verb::Close")
}

test "f1-5: trait object &Trait -> dyn Trait, split impl merging, targeted Self/unnamed param rewrite & UFCS dyn dispatch" {
  let src = SourceFile::{
    rel_path: "f15.mbt",
    content: "priv trait Sink {\n  put(Self, x : Int) -> Unit\n  put2(Self, x : Int, y : Int) -> Unit\n  name(Self, Int) -> String\n  pair(Self, f : (Self) -> Int) -> (Self, Self)\n  from_int(Int) -> Self\n}\npriv struct Acc { mut sum : Int }\nimpl Sink for Acc with put(self, x) {\n  self.sum = self.sum + x\n}\nimpl Sink for Acc with put2(self, x, y) {\n  Sink::put(self, x + y)\n}\nfn feed(s : &Sink, a : Int, b : Int) -> Unit {\n  s.put2(a, b)\n}\npub fn run() -> Int {\n  let a : Acc = { sum: 0 }\n  feed((a as &Sink), 3, 4)\n  let _ = Sink::from_int(42)\n  a.sum\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "put(self : Self, x : Int) -> Unit"), "trait method Self lowered to self : Self")
  assert_true(str_has(out, "name(self : Self, _p1 : Int) -> String"), "unnamed positional trait param gets synthetic _p1 name")
  assert_true(str_has(out, "pair(self : Self, f : (Self) -> Int) -> (Self, Self)"), "targeted Self rewrite must preserve fn-type params and return tuples")
  assert_true(str_has(out, "from_int(_p0 : Int) -> Self"), "unnamed first non-Self param gets synthetic _p0 name")
  assert_true(str_has(out, "s : dyn Sink"), "&Sink lowered to dyn Sink")
  assert_true(str_has(out, "as dyn Sink"), "as &Sink lowered to as dyn Sink")
  assert_true(str_has(out, "fn put(self : Acc, x : Int) -> Unit"), "impl method inherits param/ret types from trait")
  assert_true(str_has(out, "((self) as dyn Sink).put(x + y)"), "UFCS Sink::put(self, ...) lowered to ((self) as dyn Sink).put(...)")
  assert_true(str_has(out, "Sink::from_int(42)"), "associated trait method without Self receiver must not be rewritten to UFCS method call")
}

test "f1-6: generic method Type::method[T] brackets are not mis-probed as indexing in Stage A.5" {
  let code = "pub struct Box[T] {\n  mut v : T\n}\npub fn Box::update[T](self : Box[T], f : (T) -> T) -> Unit {\n  self.v = f(self.v)\n}\n"
  let (inst, sites) = instrument_probes_for_file("box.pion", code)
  assert_eq(sites.length(), 0)
  assert_true(!str_has(inst, "mbt_idx_probe"), "Box::update[T] must not be instrumented as mbt_idx_probe")
}
