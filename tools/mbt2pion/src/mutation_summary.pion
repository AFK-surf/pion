///| Package-wide transitive array mutation summary (`mutation_summary.pion`).
///|
///| Computes a monotone fixed-point summary `FnMutationSummary` for every top-level
///| function and method in a package, and provides `summarize_expr_span` /
///| `summarize_callback_arg` for checking loop bodies and callbacks.
///|
///| Soundness invariants (all 7 classes are fail-closed):
///|   1. Trait objects (`dyn Trait`), trait-bounded generics, trait methods, and
///|      unresolved `derive(...)` methods set `unknown = true`.
///|   2. Operator impls (`+ - * / % == != < <= > >= []`, `op_get`, `op_set`,
///|      `Show` interpolation) either follow all local impl edges or set `unknown = true`
///|      whenever operands are not proven built-in scalars/String.
///|   3. Any function-value / closure call (parameter, struct/tuple field, `Ref`,
///|      array element, indirect `(e)(...)`, `let mut` closure) sets `unknown = true`.
///|   4. Cross-package / external calls default to `unknown = true`, except a minimal
///|      provably read-only built-in / `mbt_compat` allowlist.
///|   5. Generic `fn[T]` writing `Array[T]` sets `mutates_any_array = true`.
///|   6. Reassigning array-typed fields/variables (`self.items = []`) and mutating
///|      `Map`/`Ref` holding arrays merges the corresponding element-type mutation.
///|   7. Complete built-in + `mbt_compat` mutating `Array` method list, index writes
///|      `arr[i] = ...`, and UFCS `Array::push(...)` calls are all tracked.

pub struct FnMutationSummary {
  mutated_elem_types : Map[String, Bool]
  mut mutates_any_array : Bool
  mut reaches_shrink : Bool
  mut unknown : Bool
}

pub fn FnMutationSummary::empty() -> FnMutationSummary {
  FnMutationSummary::{
    mutated_elem_types: Map(),
    mutates_any_array: false,
    reaches_shrink: false,
    unknown: false,
  }
}

pub fn FnMutationSummary::unknown_summary() -> FnMutationSummary {
  FnMutationSummary::{
    mutated_elem_types: Map(),
    mutates_any_array: false,
    reaches_shrink: false,
    unknown: true,
  }
}

///| Clone a `FnMutationSummary`.
pub fn fn_mutation_summary_clone(s : FnMutationSummary) -> FnMutationSummary {
  let m : Map[String, Bool] = Map()
  for k in s.mutated_elem_types.keys() {
    m[k] = true
  }
  FnMutationSummary::{
    mutated_elem_types: m,
    mutates_any_array: s.mutates_any_array,
    reaches_shrink: s.reaches_shrink,
    unknown: s.unknown,
  }
}

///| Merge `src` into `dst`; returns true iff `dst` grew.
pub fn fn_mutation_summary_merge(dst : FnMutationSummary, src : FnMutationSummary) -> Bool {
  let mut changed = false
  for k in src.mutated_elem_types.keys() {
    if !dst.mutated_elem_types.contains(k) {
      dst.mutated_elem_types[k] = true
      changed = true
    }
  }
  if src.mutates_any_array && !dst.mutates_any_array {
    dst.mutates_any_array = true
    changed = true
  }
  if src.reaches_shrink && !dst.reaches_shrink {
    dst.reaches_shrink = true
    changed = true
  }
  if src.unknown && !dst.unknown {
    dst.unknown = true
    changed = true
  }
  changed
}

///| True iff `sum` may mutate an `Array[target_elem_ty]` (fail-closed on `unknown`,
///| `mutates_any_array`, or empty/unknown `target_elem_ty` when any array is mutated).
pub fn summary_may_mutate_array(sum : FnMutationSummary, target_elem_ty : String) -> Bool {
  if sum.unknown || sum.mutates_any_array {
    return true
  }
  let t = target_elem_ty.trim()
  if t.length() == 0 {
    return sum.mutated_elem_types.length() > 0
  }
  sum.mutated_elem_types.contains(t)
}

pub struct PkgMutationSummary {
  summaries : Map[String, FnMutationSummary]
  declared_types : Map[String, Bool]
  declared_traits : Map[String, Bool]
  using_types : Map[String, Bool]
  trait_methods : Map[String, Bool]
  derived_types : Map[String, Bool]
  pure_eq_types : Map[String, Bool]
  custom_eq_types : Map[String, Bool]
  pure_hash_types : Map[String, Bool]
  custom_hash_types : Map[String, Bool]
  top_level_bindings : Map[String, Bool]
  enum_ctor_types : Map[String, String]
  field_types : Map[String, String]
  fn_typed_fields : Map[String, Bool]
  custom_ops : Map[String, Bool]
  ext_custom_ops : Map[String, Bool]
  op_impl_fns : Map[String, Array[String]]
  fn_keys : Map[String, Bool]
  method_names : Map[String, Bool]
  dep_methods : Map[String, Bool]
  method_overloads : Map[String, Array[String]]
  fn_generics : Map[String, Map[String, Bool]]
  fn_param_types : Map[String, Map[String, String]]
  fn_ret_types : Map[String, String]
  pure_map_ret_fns : Map[String, Bool]
}

pub fn PkgMutationSummary::empty() -> PkgMutationSummary {
  PkgMutationSummary::{
    summaries: Map(),
    declared_types: Map(),
    declared_traits: Map(),
    using_types: Map(),
    trait_methods: Map(),
    derived_types: Map(),
    pure_eq_types: Map(),
    custom_eq_types: Map(),
    pure_hash_types: Map(),
    custom_hash_types: Map(),
    top_level_bindings: Map(),
    enum_ctor_types: Map(),
    field_types: Map(),
    fn_typed_fields: Map(),
    custom_ops: Map(),
    ext_custom_ops: Map(),
    op_impl_fns: Map(),
    fn_keys: Map(),
    method_names: Map(),
    dep_methods: Map(),
    method_overloads: Map(),
    fn_generics: Map(),
    fn_param_types: Map(),
    fn_ret_types: Map(),
    pure_map_ret_fns: Map(),
  }
}

pub fn lookup_fn_mutation_summary(pkg : PkgMutationSummary, fn_key : String) -> Option[FnMutationSummary] {
  pkg.summaries.get(fn_key)
}

// ---------------------------------------------------------------------------
// Built-in mutating / read-only method & helper classification
// ---------------------------------------------------------------------------

///| Complete list of mutating `Array` / `FixedArray` / `ArrayBuf` / `ArrayView` methods
///| checked against `compiler/src/core/types.pion` and `tools/mbt_compat/src/collections.pion`.
pub fn ms_is_array_mutating_method(m : String) -> Bool {
  m == "push" || m == "pop" || m == "remove" || m == "clear" || m == "truncate" ||
  m == "resize" || m == "drain" || m == "retain" || m == "append" || m == "shrink_to_fit" ||
  m == "set" || m == "unsafe_set" || m == "swap" || m == "insert" || m == "reverse" ||
  m == "rev_in_place" || m == "sort" || m == "sort_by" || m == "sort_by_key" ||
  m == "dedup" || m == "map_in_place" || m == "push_iter" || m == "blit_to" ||
  m == "splice" || m == "fill" || m == "push_array" || m == "extend"
}

fn ms_is_shrink_method(m : String) -> Bool {
  m == "shrink_to_fit" || m == "arr_shrink_to_fit"
}

fn ms_is_mbt_compat_arr_mutating(m : String) -> Bool {
  is_mbt_compat_arr_mutating(m) ||
  m == "arr_reverse" || m == "arr_fill" || m == "arr_push_array" || m == "arr_extend" ||
  m == "fixed_array_blit_to" || m == "fixed_array_blit_to_fa" ||
  m == "fixed_array_sort_by" || m == "fixed_array_sort_i64" || m == "fixed_array_sort_int" ||
  m == "fixed_array_sort_double" || m == "fixed_array_sort_float" ||
  m == "fixed_array_sort_uint" || m == "fixed_array_sort_uint64" ||
  m == "fixed_array_sort_byte" || m == "fixed_array_sort_char" ||
  m == "fixed_array_unsafe_set"
}

fn ms_is_mbt_compat_pure_ro(m : String) -> Bool {
  m == "arr_is_empty" || m == "arr_get" || m == "arr_last" || m == "arr_copy" ||
  m == "arr_rev" || m == "arr_concat" || m == "arr_to_array" || m == "arr_unsafe_get" ||
  m == "arr_release_unused" || m == "arr_release_unused_with" || m == "arr_capacity_check" ||
  m == "array_slice_clamp" || m == "fixed_array_slice_clamp" || m == "fixed_array_copy" ||
  m == "fixed_array_unsafe_get" || m == "int_lnot" || m == "int_popcnt" ||
  m == "int_ctz" || m == "int_clz" || m == "int_to_uint64" || m == "int64_to_byte" ||
  m == "uint64_lnot" || m == "int_compare" || m == "int_min" || m == "int_max" ||
  m == "uint_compare" || m == "bool_compare" || m == "double_is_nan" || m == "double_is_inf" ||
  m == "double_compare" || m == "double_min" || m == "double_max" ||
  m == "double_reinterpret_as_int64" || m == "float_is_nan" || m == "float_compare" || m == "float_from_uint" ||
  m == "float_reinterpret_from_uint" || m == "str_compare" || m == "str_lexical_compare" ||
  m == "str_has_prefix" || m == "str_has_suffix" || m == "str_to_lower" || m == "str_to_upper" ||
  m == "str_trim_end" ||
  m == "str_find" || m == "str_rev_find" || m == "str_contains_char" || m == "str_get_char" ||
  m == "str_byte_len" || m == "str_cursor_step" || m == "str_view" || m == "str_exact_view" ||
  m == "str_clamped_view" || m == "utf16_slice" || m == "utf16_code_unit_at" ||
  m == "utf16_to_utf8_off" || m == "utf16_to_scalar_off" || m == "bytes_eq" ||
  m == "bytes_make" || m == "bytes_slice" || m == "bytes_clamped_view" ||
  m == "bytes_to_array" || m == "bytes_from_array" || m == "byte_to_uint" ||
  m == "char_is_ascii_alphabetic" || m == "opt_unwrap" || m == "opt_or" ||
  m == "opt_is_empty" || m == "ref_physical_equal" || m == "ref_new" || m == "mbt_cell" ||
  m == "checked_div_int" || m == "checked_mod_int" || m == "checked_div_int64" ||
  m == "checked_mod_int64" || m == "checked_div_uint" || m == "checked_mod_uint" ||
  m == "checked_div_uint64" || m == "checked_mod_uint64" || m == "ordered_map_size"
}

fn ms_is_mbt_compat_hof_ro(m : String) -> Bool {
  m == "arr_map" || m == "arr_mapi" || m == "arr_filter" || m == "arr_filter_map" ||
  m == "arr_each" || m == "arr_eachi" || m == "arr_fold" || m == "arr_any" ||
  m == "arr_all" || m == "arr_search_by" || m == "opt_map" || m == "opt_map_or" ||
  m == "opt_bind" || m == "arr_makei" || m == "fixed_array_makei" || m == "bytes_makei"
}

fn ms_is_builtin_scalar_ty(t : String) -> Bool {
  let s = t.trim()
  s == "Int" || s == "Int64" || s == "Int32" || s == "Int16" || s == "Int8" ||
  s == "UInt" || s == "UInt64" || s == "UInt32" || s == "UInt16" || s == "UInt8" ||
  s == "Double" || s == "Float" || s == "Bool" || s == "Char" || s == "Byte" ||
  s == "String" || s == "Unit"
}

fn ms_is_builtin_container_head(h : String) -> Bool {
  h == "Array" || h == "FixedArray" || h == "ImmArray" || h == "Option" ||
  h == "Result" || h == "Map" || h == "Bytes" || h == "StringBuilder" ||
  h == "ArrayBuf" || h == "ArrayView" || h == "OrderedMap" || h == "OrderedSet" ||
  h == "Ref" || h == "MbtCell" || h == "StrView" || h == "StringView"
}

fn ms_is_pure_builtin_method(m : String) -> Bool {
  m == "length" || m == "size" || m == "is_empty" || m == "get" || m == "copy" || m == "to_imm" ||
  m == "last" || m == "first" || m == "rev" || m == "unsafe_get" || m == "to_array" ||
  m == "to_int" || m == "to_int64" || m == "to_uint" || m == "to_uint64" ||
  m == "to_double" || m == "to_float" || m == "to_byte" || m == "to_char" ||
  m == "unsafe_to_char" || m == "abs" || m == "min" || m == "max" || m == "neg" ||
  m == "is_nan" || m == "is_inf" || m == "is_finite" || m == "is_some" || m == "is_none" ||
  m == "is_ok" || m == "is_err" ||
  m == "unwrap" || m == "unwrap_or" || m == "or" || m == "code_unit_at" || m == "char_at" ||
  m == "index_of" || m == "find" || m == "rev_find" || m == "slice" || m == "substring" ||
  m == "trim" || m == "trim_start" || m == "trim_end" ||
  m == "starts_with" || m == "ends_with" || m == "has_prefix" || m == "has_suffix" ||
  m == "strip_prefix" || m == "strip_suffix" || m == "replace" || m == "replace_all" ||
  m == "repeat" || m == "pad_start" || m == "pad_end" ||
  m == "to_lower" || m == "to_upper" || m == "to_ascii_lowercase" || m == "to_ascii_uppercase" ||
  m == "is_ascii" || m == "is_ascii_alphabetic" || m == "is_ascii_digit" ||
  m == "is_ascii_alphanumeric" || m == "is_ascii_whitespace" ||
  m == "is_ascii_uppercase" || m == "is_ascii_lowercase" ||
  m == "char_length" || m == "byte_length" ||
  m == "reinterpret_as_int" || m == "reinterpret_as_uint" || m == "reinterpret_as_int64" ||
  m == "reinterpret_as_uint64" || m == "to_bits" || m == "to_bytes" || m == "keys" ||
  m == "contains_key" || m == "slot_len" || m == "slot_live" || m == "slot_key" ||
  m == "slot_val" || m == "join" || m == "split" || m == "iter" ||
  m == "as_view" || m == "view" || m == "view_from" ||
  m == "exact_view" || m == "to_owned"
}

///| True iff `ty` is proven to have pure read-only structural `==`/`!=` (or `Hash` when passed
///| `pure_hash_types`): built-in scalar/String/Bytes, Option/Array/FixedArray/tuple of pure types,
///| or a local non-generic `derive(...)` type in `pure_types`, and NEVER an active generic param.
fn ms_ty_is_pure_eq(
  ty : String,
  pure_eq_types : Map[String, Bool],
  active_generics : Map[String, Bool],
) -> Bool {
  let t = ty.trim()
  if t.length() == 0 || t == "__AMBIG__" || active_generics.contains(t) {
    return false
  }
  if ms_is_builtin_scalar_ty(t) || t == "Bytes" {
    return true
  }
  if pure_eq_types.contains(t) {
    return true
  }
  // Tuple `(A, B, ...)`
  if t.starts_with("(") && t.ends_with(")") && !str_has(t, "->") {
    let inner = t.slice(1, t.length() - 1).trim()
    if inner.length() == 0 {
      return true
    }
    let parts = qt_split_top_level_type_args(inner)
    if parts.length() == 0 {
      return false
    }
    for p in parts {
      if !ms_ty_is_pure_eq(p, pure_eq_types, active_generics) {
        return false
      }
    }
    return true
  }
  // `Option[T]` / `Array[T]` / `FixedArray[T]`
  if t.starts_with("Option[") && t.ends_with("]") {
    return ms_ty_is_pure_eq(t.slice(7, t.length() - 1), pure_eq_types, active_generics)
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    return ms_ty_is_pure_eq(t.slice(6, t.length() - 1), pure_eq_types, active_generics)
  }
  if t.starts_with("FixedArray[") && t.ends_with("]") {
    return ms_ty_is_pure_eq(t.slice(11, t.length() - 1), pure_eq_types, active_generics)
  }
  false
}

///| True iff `kty` is safe as a `Map`/`OrderedMap`/`OrderedSet` key (pure `Eq` and pure `Hash`).
fn ms_ty_is_pure_map_key(
  kty : String,
  pkg : PkgMutationSummary,
  active_generics : Map[String, Bool],
) -> Bool {
  if pkg.custom_ops.contains("==") && !ms_ty_is_pure_eq(kty, pkg.pure_eq_types, active_generics) {
    return false
  }
  if pkg.custom_ops.contains("hash") && !ms_ty_is_pure_eq(kty, pkg.pure_hash_types, active_generics) {
    return false
  }
  true
}

///| True iff all keys inserted by `Map::from_array`/`Map::of`/`OrderedMap`/`OrderedSet` constructor
///| call `(lp..rp)` are proven pure under `ms_ty_is_pure_map_key`.
fn ms_infer_map_ctor_keys_pure(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  lp : Int,
  rp : Int,
  is_pair_entries : Bool,
  content : String,
  qfi_opt : Option[QtFileIndex],
  local_var_types : Map[String, String],
  active_generics : Map[String, Bool],
) -> Bool {
  let cargs = ms_split_call_args(tokens, lp, rp)
  if cargs.length() == 0 {
    return true
  }
  if cargs.length() != 1 {
    return false
  }
  let a0_s = cargs[0].0
  let a0_e = cargs[0].1
  if a0_s >= a0_e {
    return false
  }
  // Case 1: Array literal `[e1, e2, ...]`
  if tokens[a0_s].kind == TokenKind::LBracket && tokens[a0_e - 1].kind == TokenKind::RBracket &&
  find_matching_delim(tokens, a0_s) == a0_e - 1 {
    let elems = ms_split_call_args(tokens, a0_s, a0_e - 1)
    if elems.length() == 0 {
      return true
    }
    for el in elems {
      let es = el.0
      let ee = el.1
      if es >= ee {
        return false
      }
      if is_pair_entries {
        if tokens[es].kind == TokenKind::LParen && tokens[ee - 1].kind == TokenKind::RParen &&
        find_matching_delim(tokens, es) == ee - 1 {
          let pair_parts = ms_split_call_args(tokens, es, ee - 1)
          if pair_parts.length() != 2 || pair_parts[0].0 >= pair_parts[0].1 {
            return false
          }
          let k_ty = ms_infer_expr_ty(pkg, tokens, pair_parts[0].1 - 1, content, qfi_opt, local_var_types)
          if !ms_ty_is_pure_map_key(k_ty, pkg, active_generics) {
            return false
          }
        } else {
          let el_ty = ms_infer_expr_ty(pkg, tokens, ee - 1, content, qfi_opt, local_var_types).trim()
          if !(el_ty.starts_with("(") && el_ty.ends_with(")")) {
            return false
          }
          let parts = qt_split_top_level_type_args(el_ty.slice(1, el_ty.length() - 1))
          if parts.length() != 2 || !ms_ty_is_pure_map_key(parts[0], pkg, active_generics) {
            return false
          }
        }
      } else {
        let el_ty = ms_infer_expr_ty(pkg, tokens, ee - 1, content, qfi_opt, local_var_types)
        if !ms_ty_is_pure_map_key(el_ty, pkg, active_generics) {
          return false
        }
      }
    }
    return true
  }
  // Case 2: Non-literal expression of typed Array/FixedArray/ArrayView
  let arg_ty = ms_infer_expr_ty(pkg, tokens, a0_e - 1, content, qfi_opt, local_var_types)
  if ms_is_qualified_external_ty(arg_ty) {
    return false
  }
  let elem = ms_extract_array_elem_ty(arg_ty).trim()
  if elem.length() == 0 {
    return false
  }
  if is_pair_entries {
    if elem.starts_with("(") && elem.ends_with(")") {
      let parts = qt_split_top_level_type_args(elem.slice(1, elem.length() - 1))
      if parts.length() == 2 {
        return ms_ty_is_pure_map_key(parts[0], pkg, active_generics)
      }
    }
    return false
  }
  ms_ty_is_pure_map_key(elem, pkg, active_generics)
}

///| True iff the expression ending at `recv_end` is a freshly constructed built-in container iterator
///| with no intermediate lazy adapters (`.map`/`.filter`/etc.):
///| - Form A: `<base>.iter()` where `<base>` is a proven unshadowed built-in container
///| - Form B: `mbt_compat::(arr_iter|fixed_array_iter|array_view_iter|str_iter|ordered_map_iter_lazy|ordered_map_keys_iter)(...)`
fn ms_is_fresh_builtin_iter_expr(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  recv_end : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  local_var_types : Map[String, String],
  active_generics : Map[String, Bool],
) -> Bool {
  if recv_end < 2 || tokens[recv_end].kind != TokenKind::RParen {
    return false
  }
  let lp = find_open_before(tokens, recv_end, 0)
  if lp < 2 {
    return false
  }
  // Form A: `<base>.iter()` (zero args)
  if lp == recv_end - 1 && lp >= 3 && tokens[lp - 1].kind == TokenKind::Ident &&
  tokens[lp - 1].raw == "iter" && tokens[lp - 2].kind == TokenKind::Dot {
    let base_ty = ms_infer_expr_ty(pkg, tokens, lp - 3, content, qfi_opt, local_var_types)
    let bh = ms_type_head(base_ty)
    let is_builtin_base = bh == "Array" || bh == "FixedArray" || bh == "ArrayView" || bh == "ArrayBuf" ||
    bh == "String" || bh == "StrView" || bh == "StringView" || bh == "Bytes" ||
    bh == "Map" || bh == "OrderedMap" || bh == "OrderedSet"
    return is_builtin_base && ms_is_unshadowed_builtin_head(pkg, base_ty, bh, "iter", active_generics)
  }
  // Form B: `mbt_compat::<iter_ctor>(...)`
  if lp >= 3 && tokens[lp - 2].kind == TokenKind::ColonColon && tokens[lp - 3].raw == "mbt_compat" {
    let nm = tokens[lp - 1].raw
    return nm == "arr_iter" || nm == "fixed_array_iter" || nm == "array_view_iter" ||
    nm == "str_iter" || nm == "ordered_map_iter_lazy" || nm == "ordered_map_keys_iter"
  }
  false
}

///| Extract element type `E` from array or iterator types (`Array[E]`, `MbtIter[E]`, `Iter[E]`, etc.).
fn ms_extract_hof_elem_ty(ty : String) -> String {
  let direct = ms_extract_array_elem_ty(ty)
  if direct.length() > 0 {
    return direct
  }
  let t = ms_strip_pkg_prefix(ty)
  if !t.ends_with("]") {
    return ""
  }
  if t.starts_with("MbtIter[") {
    return t.slice(8, t.length() - 1).trim()
  }
  if t.starts_with("Iter[") {
    return t.slice(5, t.length() - 1).trim()
  }
  ""
}

///| Extract key type `K` from `Map[K, V]` / `OrderedMap[K, V]` / `OrderedSet[K]`.
fn ms_extract_map_key_ty(ty : String) -> String {
  let t = ms_strip_pkg_prefix(ty)
  if !t.ends_with("]") {
    return ""
  }
  if t.starts_with("Map[") || t.starts_with("OrderedMap[") || t.starts_with("OrderedSet[") {
    let lb = t.index_of("[")
    let inner = t.slice(lb + 1, t.length() - 1).trim()
    let parts = qt_split_top_level_type_args(inner)
    if parts.length() >= 1 {
      return parts[0].trim()
    }
  }
  ""
}

fn ms_is_pure_static_method(q : String, name : String) -> Bool {
  if q == "Int" || q == "Int64" || q == "UInt" || q == "UInt64" || q == "Double" ||
  q == "Float" || q == "Bool" || q == "Char" || q == "Byte" {
    return name == "default" || name == "from_int" || name == "from_uint" || name == "from_double" ||
    name == "from_int64" || name == "from_uint64" || name == "min" || name == "max" ||
    name == "abs" || name == "to_string" || name == "is_nan" || name == "is_inf" ||
    name == "max_value" || name == "min_value" || name == "infinity" || name == "neg_infinity" ||
    name == "not_a_number" || name == "from_char" || name == "from_code_unit" ||
    name == "reinterpret_as_int" || name == "reinterpret_as_uint" || name == "reinterpret_as_double"
  }
  if q == "String" || q == "StringBuilder" || q == "ImmArray" {
    return name == "new" || name == "default" || name == "from_array" || name == "of" ||
    name == "make" || name == "length" || name == "is_empty" || name == "get" ||
    name == "size_hint"
  }
  false
}

///| Collect identifiers bound in pattern positions (`for <pat> in`, `match` arm patterns,
///| `if ... is <pat>`, and destructuring `let <pat> =`) so pattern bindings shadowing
///| top-level pure functions are treated as unknown callables (fail-closed).
fn ms_is_pattern_kw(raw : String) -> Bool {
  raw == "_" || raw == "if" || raw == "else" || raw == "true" || raw == "false" ||
  raw == "mut" || raw == "as" || raw == "in" || raw == "is" || raw == "let" ||
  raw == "match" || raw == "for" || raw == "while" || raw == "return" ||
  raw == "break" || raw == "continue" || raw == "fn"
}

fn ms_add_pat_idents(tokens : Array[Token], s : Int, e : Int, out : Map[String, Bool]) -> Unit {
  let mut k = s
  while k < e {
    if tokens[k].kind == TokenKind::Ident && !ms_is_pattern_kw(tokens[k].raw) {
      // Skip struct field labels `field: pat` (the value pattern is scanned next)
      if !(k + 1 < e && tokens[k + 1].kind == TokenKind::Colon) {
        out[tokens[k].raw] = true
      }
    }
    k = k + 1
  }
}

fn ms_collect_pattern_bound_idents(tokens : Array[Token], body_open : Int, out : Map[String, Bool]) -> Unit {
  if body_open < 0 || body_open >= tokens.length() {
    return
  }
  let body_close = find_matching_delim(tokens, body_open)
  if body_close <= body_open {
    return
  }
  ms_collect_pattern_bound_idents_in_span(tokens, body_open + 1, body_close, out)
}

fn ms_collect_pattern_bound_idents_in_span(tokens : Array[Token], s : Int, e : Int, out : Map[String, Bool]) -> Unit {
  ms_collect_pattern_bound_idents_in_span_ex(tokens, s, e, out, true)
}

fn ms_collect_pattern_bound_idents_in_span_ex(
  tokens : Array[Token],
  s : Int,
  e : Int,
  out : Map[String, Bool],
  include_simple_for : Bool,
) -> Unit {
  if s < 0 || e <= s {
    return
  }
  let mut i = s
  while i < e {
    let raw = tokens[i].raw
    // 1. `for <pat> in`
    if raw == "for" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) {
      let mut j = i + 1
      let mut d = 0
      while j < e {
        let jk = tokens[j].kind
        if d == 0 && (tokens[j].raw == "in" || jk == TokenKind::LBrace || jk == TokenKind::Semi) { break }
        if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace { d = d + 1 }
        else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
        j = j + 1
      }
      if j < e && tokens[j].raw == "in" {
        let is_simple_for = j == i + 2 && tokens[i + 1].kind == TokenKind::Ident && !ms_is_pattern_kw(tokens[i + 1].raw)
        if include_simple_for || !is_simple_for {
          ms_add_pat_idents(tokens, i + 1, j, out)
        }
      }
    }
    // 2. `if ... is <pat>` (or `while ... is <pat>`): handle struct patterns `is { ... }` and `is S::{ ... }`
    if raw == "is" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) {
      let mut j = i + 1
      let mut d = 0
      while j < e {
        let jk = tokens[j].kind
        if d == 0 {
          if jk == TokenKind::AmpAmp || jk == TokenKind::PipePipe || jk == TokenKind::RParen || jk == TokenKind::Semi {
            break
          }
          if jk == TokenKind::LBrace {
            let is_struct_pat_brace = j == i + 1 ||
            tokens[j - 1].kind == TokenKind::ColonColon ||
            tokens[j - 1].kind == TokenKind::LParen ||
            tokens[j - 1].kind == TokenKind::Comma ||
            tokens[j - 1].kind == TokenKind::Pipe
            if !is_struct_pat_brace {
              break
            }
          }
        }
        if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace { d = d + 1 }
        else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
        j = j + 1
      }
      ms_add_pat_idents(tokens, i + 1, j, out)
    }
    // 3. Destructuring `let <pat> =` (including struct patterns `let { cb: helper } = ...` and `let S::{ ... } = ...`)
    if raw == "let" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) {
      let mut ni = i + 1
      if ni < e && tokens[ni].raw == "mut" { ni = ni + 1 }
      let is_simple_let = ni + 1 < e && tokens[ni].kind == TokenKind::Ident &&
      (tokens[ni + 1].kind == TokenKind::Eq || tokens[ni + 1].kind == TokenKind::Colon)
      if !is_simple_let && ni < e {
        let mut eq_i = ni
        let mut d = 0
        while eq_i < e {
          let ek = tokens[eq_i].kind
          if d == 0 && (ek == TokenKind::Eq || ek == TokenKind::Semi) { break }
          if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
          else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { if d > 0 { d = d - 1 } }
          eq_i = eq_i + 1
        }
        if eq_i < e && tokens[eq_i].kind == TokenKind::Eq {
          ms_add_pat_idents(tokens, ni, eq_i, out)
        }
      }
    }
    // 4. `match` arm patterns: scan backward from `=>` at arm level, stepping through struct pattern `{ ... }`
    if tokens[i].kind == TokenKind::FatArrow {
      let mut ps = i - 1
      let mut d = 0
      while ps >= s {
        let pk = tokens[ps].kind
        if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
          if d == 0 && pk == TokenKind::RBrace {
            let ob = find_open_before(tokens, ps, s)
            if ob <= s || tokens[ob - 1].kind == TokenKind::FatArrow {
              break
            }
          }
          d = d + 1
        } else if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
          if d == 0 { break }
          d = d - 1
        } else if d == 0 && (pk == TokenKind::Semi || pk == TokenKind::FatArrow) {
          break
        } else if d == 0 && tokens[ps].newline_before {
          // Include `ps` itself as the start of this arm pattern line
          ps = ps - 1
          break
        }
        ps = ps - 1
      }
      // Stop before `if` guard inside the match arm if present
      let mut pat_end = i
      let mut g = ps + 1
      let mut gd = 0
      while g < i {
        let gk = tokens[g].kind
        if gk == TokenKind::LParen || gk == TokenKind::LBracket || gk == TokenKind::LBrace { gd = gd + 1 }
        else if gk == TokenKind::RParen || gk == TokenKind::RBracket || gk == TokenKind::RBrace { if gd > 0 { gd = gd - 1 } }
        else if gd == 0 && tokens[g].raw == "if" { pat_end = g; break }
        g = g + 1
      }
      ms_add_pat_idents(tokens, ps + 1, pat_end, out)
    }
    i = i + 1
  }
}

///| Collect inner closure parameter names (`fn(a, b) { ... }`, `a => ...`, `(a, b) => ...`) in `[s, e)`
///| so inner closure params shadowing outer typed variables are marked `"__AMBIG__"`.
fn ms_collect_closure_param_names(tokens : Array[Token], s : Int, e : Int, out : Map[String, Bool]) -> Unit {
  let mut i = s
  while i < e {
    if tokens[i].raw == "fn" && i + 1 < e && tokens[i + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i + 1)
      if cp > i + 1 && cp < e {
        let pnames = collect_pion_fn_param_names(tokens, i + 1, cp)
        for pn in pnames {
          if pn.length() > 0 && pn != "_" {
            out[pn] = true
          }
        }
      }
    } else if tokens[i].kind == TokenKind::FatArrow && i > s {
      if tokens[i - 1].kind == TokenKind::Ident && !ms_is_pattern_kw(tokens[i - 1].raw) {
        out[tokens[i - 1].raw] = true
      } else if tokens[i - 1].kind == TokenKind::RParen {
        let lp = find_open_before(tokens, i - 1, s)
        if lp >= s {
          let pnames = collect_pion_fn_param_names(tokens, lp, i - 1)
          for pn in pnames {
            if pn.length() > 0 && pn != "_" {
              out[pn] = true
            }
          }
        }
      }
    }
    i = i + 1
  }
}

fn ms_mark_shadowed_ambig(vt : Map[String, String], names : Map[String, Bool]) -> Unit {
  for nm in names.keys() {
    vt[nm] = "__AMBIG__"
  }
}

fn ms_is_derive_method(m : String) -> Bool {
  m == "to_string" || m == "compare" || m == "equal" || m == "hash"
}

fn ms_is_qualified_external_ty(ty : String) -> Bool {
  let t = ty.trim()
  let lb = t.index_of("[")
  let head = if lb >= 0 { t.slice(0, lb).trim() } else { t }
  let cc = head.index_of("::")
  if cc > 0 {
    let prefix = head.slice(0, cc).trim()
    return prefix != "mbt_compat"
  }
  let dot = head.index_of(".")
  if dot > 0 {
    let prefix = head.slice(0, dot).trim()
    return prefix != "mbt_compat"
  }
  false
}

fn ms_is_unshadowed_builtin_head(
  pkg : PkgMutationSummary,
  ty : String,
  head : String,
  method_name : String,
  active_generics : Map[String, Bool],
) -> Bool {
  !ms_is_qualified_external_ty(ty) &&
  !pkg.declared_types.contains(head) &&
  !pkg.declared_traits.contains(head) &&
  !pkg.using_types.contains(head) &&
  !active_generics.contains(head) &&
  !(method_name.length() > 0 && pkg.fn_keys.contains(head + "::" + method_name))
}

fn ms_strip_pkg_prefix(ty : String) -> String {
  let t = ty.trim()
  let cc = t.index_of("::")
  let lb = t.index_of("[")
  if cc > 0 && (lb < 0 || cc < lb) {
    t.slice(cc + 2, t.length()).trim()
  } else {
    t
  }
}

fn ms_type_head(ty : String) -> String {
  let t = ms_strip_pkg_prefix(ty)
  let lb = t.index_of("[")
  if lb > 0 { t.slice(0, lb).trim() } else { t }
}

///| Extract element type `E` from `Array[E]` / `FixedArray[E]` / `ArrayBuf[E]` / `ArrayView[E]`, or "".
pub fn ms_extract_array_elem_ty(ty : String) -> String {
  let t = ms_strip_pkg_prefix(ty)
  if !t.ends_with("]") {
    return ""
  }
  if t.starts_with("Array[") {
    return t.slice(6, t.length() - 1).trim()
  }
  if t.starts_with("FixedArray[") {
    return t.slice(11, t.length() - 1).trim()
  }
  if t.starts_with("ArrayBuf[") {
    return t.slice(9, t.length() - 1).trim()
  }
  if t.starts_with("ArrayView[") {
    return t.slice(10, t.length() - 1).trim()
  }
  ""
}

///| Extract inner array element type from `Ref[Array[E]]` / `MbtCell[Array[E]]` / `Map[K, Array[E]]` / `OrderedMap[K, Array[E]]`.
fn ms_extract_nested_array_elem_ty(ty : String) -> String {
  let direct = ms_extract_array_elem_ty(ty)
  if direct.length() > 0 {
    return direct
  }
  let t = ms_strip_pkg_prefix(ty)
  if !t.ends_with("]") {
    return ""
  }
  if t.starts_with("Ref[") {
    return ms_extract_nested_array_elem_ty(t.slice(4, t.length() - 1).trim())
  }
  if t.starts_with("MbtCell[") {
    return ms_extract_nested_array_elem_ty(t.slice(8, t.length() - 1).trim())
  }
  if t.starts_with("Map[") || t.starts_with("OrderedMap[") {
    let lb = t.index_of("[")
    let inner = t.slice(lb + 1, t.length() - 1).trim()
    let parts = qt_split_top_level_type_args(inner)
    if parts.length() >= 2 {
      return ms_extract_nested_array_elem_ty(parts[1])
    }
  }
  if t.starts_with("Option[") {
    return ms_extract_nested_array_elem_ty(t.slice(7, t.length() - 1).trim())
  }
  ""
}

fn ms_ty_is_fn_type(ty : String) -> Bool {
  let t = ty.trim()
  str_has(t, "->") || t.starts_with("fn(")
}

fn ms_ty_is_dyn(ty : String) -> Bool {
  ty.trim().starts_with("dyn ")
}

fn ms_ty_contains_generic(ty : String, active_generics : Map[String, Bool]) -> Bool {
  if active_generics.length() == 0 {
    return false
  }
  let t = ty.trim()
  if t.length() == 0 {
    return false
  }
  if active_generics.contains(t) {
    return true
  }
  let toks = lex_moonbit(t)
  let n = toks.length() - 1
  let mut i = 0
  while i < n {
    if (toks[i].kind == TokenKind::UpperIdent || toks[i].kind == TokenKind::Ident) &&
    active_generics.contains(toks[i].raw) {
      return true
    }
    i = i + 1
  }
  false
}

fn ms_record_array_mutation(
  sum : FnMutationSummary,
  elem_ty : String,
  active_generics : Map[String, Bool],
  declared_types : Map[String, Bool],
) -> Unit {
  let e = elem_ty.trim()
  if e.length() == 0 || ms_ty_contains_generic(e, active_generics) ||
  !qt_is_ground_canon_type(e, declared_types, active_generics) {
    sum.mutates_any_array = true
  } else {
    sum.mutated_elem_types[e] = true
  }
}

fn ms_op_trait_to_symbols(trait_name : String) -> Array[String] {
  if trait_name == "Add" { return ["+"] }
  if trait_name == "Sub" { return ["-"] }
  if trait_name == "Mul" { return ["*"] }
  if trait_name == "Div" { return ["/"] }
  if trait_name == "Mod" { return ["%"] }
  if trait_name == "Neg" { return ["-"] }
  if trait_name == "Eq" { return ["==", "!="] }
  if trait_name == "Compare" { return ["<", "<=", ">", ">="] }
  if trait_name == "Show" { return ["Show"] }
  if trait_name == "Hash" { return ["hash"] }
  []
}

fn ms_op_name_to_symbol(op_name : String) -> String {
  if op_name == "add" { return "+" }
  if op_name == "sub" { return "-" }
  if op_name == "mul" { return "*" }
  if op_name == "div" { return "/" }
  if op_name == "mod" { return "%" }
  if op_name == "neg" { return "-" }
  if op_name == "eq" || op_name == "equal" || op_name == "op_equal" { return "==" }
  if op_name == "compare" { return "<" }
  if op_name == "hash" || op_name == "hash_combine" { return "hash" }
  ""
}

fn ms_add_op_impl_fn(pkg : PkgMutationSummary, sym : String, fn_key : String) -> Unit {
  pkg.custom_ops[sym] = true
  if fn_key.length() == 0 {
    return
  }
  let arr = match pkg.op_impl_fns.get(sym) {
    Some(a) => a
    None => []
  }
  let mut dup = false
  for x in arr {
    if x == fn_key { dup = true; break }
  }
  if !dup {
    arr.push(fn_key)
    pkg.op_impl_fns[sym] = arr
  }
}

// ---------------------------------------------------------------------------
// Parsing helpers for declarations, parameter lists, and type annotations
// ---------------------------------------------------------------------------

fn ms_join_token_slice(tokens : Array[Token], s : Int, e : Int) -> String {
  let sb = StringBuilder()
  let mut i = s
  while i < e {
    if i > s {
      let pk = tokens[i - 1].kind
      let ck = tokens[i].kind
      let no_sp = pk == TokenKind::LBracket || pk == TokenKind::LParen ||
      pk == TokenKind::ColonColon || pk == TokenKind::Dot ||
      ck == TokenKind::RBracket || ck == TokenKind::RParen ||
      ck == TokenKind::ColonColon || ck == TokenKind::Dot ||
      ck == TokenKind::Comma || ck == TokenKind::LBracket
      if !no_sp {
        sb.write_string(" ")
      }
    }
    sb.write_string(tokens[i].raw)
    i = i + 1
  }
  sb.to_string().trim()
}

///| Parse `[T, U : Bound]` generic type parameter names starting at `lb`.
fn ms_parse_generic_params(tokens : Array[Token], lb : Int, out : Map[String, Bool]) -> Int {
  let rb = find_matching_delim(tokens, lb)
  if rb <= lb {
    return lb
  }
  let mut p = lb + 1
  let mut bd = 0
  let mut at_start = true
  while p < rb {
    let pk = tokens[p].kind
    if pk == TokenKind::LBracket || pk == TokenKind::LParen || pk == TokenKind::LBrace {
      bd = bd + 1
      at_start = false
    } else if pk == TokenKind::RBracket || pk == TokenKind::RParen || pk == TokenKind::RBrace {
      if bd > 0 { bd = bd - 1 }
      at_start = false
    } else if bd == 0 && pk == TokenKind::Comma {
      at_start = true
    } else if bd == 0 && at_start && (pk == TokenKind::UpperIdent || pk == TokenKind::Ident) {
      out[tokens[p].raw] = true
      at_start = false
    } else {
      at_start = false
    }
    p = p + 1
  }
  rb
}

///| Parse `(a : T, b : U)` parameter types into `out`.
fn ms_parse_fn_params(tokens : Array[Token], lp : Int, rp : Int, out : Map[String, String]) -> Unit {
  let mut i = lp + 1
  while i < rp {
    if tokens[i].kind == TokenKind::Comma { i = i + 1; continue }
    let mut pe = i
    let mut d = 0
    while pe < rp {
      let pk = tokens[pe].kind
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { d = d + 1 }
      else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      else if d == 0 && pk == TokenKind::Comma { break }
      pe = pe + 1
    }
    let mut nm_i = i
    if nm_i < pe && tokens[nm_i].raw == "mut" {
      nm_i = nm_i + 1
    }
    if nm_i + 2 < pe && tokens[nm_i].kind == TokenKind::Ident {
      let pname = tokens[nm_i].raw
      let mut ci = nm_i + 1
      if ci < pe && (tokens[ci].kind == TokenKind::Tilde || tokens[ci].kind == TokenKind::Question) {
        ci = ci + 1
      }
      if ci < pe && tokens[ci].kind == TokenKind::Colon {
        let mut te = pe
        let mut td = 0
        let mut ti = ci + 1
        while ti < pe {
          let tk = tokens[ti].kind
          if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
          else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { if td > 0 { td = td - 1 } }
          else if td == 0 && tk == TokenKind::Eq { te = ti; break }
          ti = ti + 1
        }
        let ty_s = ms_join_token_slice(tokens, ci + 1, te)
        if ty_s.length() > 0 {
          out[pname] = ty_s
        }
      }
    }
    i = pe + 1
  }
}

struct MsFnDecl {
  key : String
  bare_name : String
  recv_type : String
  file_idx : Int
  body_open : Int
  body_close : Int
}

fn ms_record_field_type(pkg : PkgMutationSummary, struct_name : String, field_name : String, ty_s : String) -> Unit {
  if struct_name.length() > 0 {
    pkg.field_types[struct_name + "::" + field_name] = ty_s
  }
  if ms_ty_is_fn_type(ty_s) {
    pkg.fn_typed_fields[field_name] = true
  }
  match pkg.field_types.get(field_name) {
    Some(prev) => if prev != ty_s { pkg.field_types[field_name] = "__AMBIG__" }
    None => pkg.field_types[field_name] = ty_s
  }
}

///| Look up type of expression ending at `end_i` using `qfi_opt`, `local_var_types`,
///| `pkg.field_types`, and simple literal/constructor heuristics.
fn ms_infer_expr_ty(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  end_i : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  local_var_types : Map[String, String],
) -> String {
  if end_i < 0 || end_i >= tokens.length() {
    return ""
  }
  let tk = tokens[end_i]
  // Tuple element access `base.0` / `base.1` MUST be checked before bare `IntLit`!
  if tk.kind == TokenKind::IntLit && end_i >= 2 && tokens[end_i - 1].kind == TokenKind::Dot {
    let base_ty = ms_infer_expr_ty(pkg, tokens, end_i - 2, content, qfi_opt, local_var_types)
    let bt = base_ty.trim()
    if bt.starts_with("(") && bt.ends_with(")") {
      let parts = qt_split_top_level_type_args(bt.slice(1, bt.length() - 1))
      let idx = ms_parse_nonneg_int(tk.raw)
      if idx >= 0 && idx < parts.length() {
        return parts[idx]
      }
    }
    return ""
  }
  if tk.kind == TokenKind::IntLit { return "Int" }
  if tk.kind == TokenKind::FloatLit { return "Double" }
  if tk.kind == TokenKind::StringLit || tk.kind == TokenKind::RawMultiline ||
  tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline {
    return "String"
  }
  if tk.kind == TokenKind::CharLit { return "Char" }
  if tk.kind == TokenKind::ByteCharLit { return "Byte" }
  if tk.kind == TokenKind::ByteStringLit { return "Bytes" }
  if tk.raw == "true" || tk.raw == "false" { return "Bool" }
  // Bare identifier: prefer explicit `local_var_types` (includes closure params inferred from
  // receiver `Array[E]` before Stage B rewrites unknown methods), then fall back to `qfi_opt`.
  // When `local_var_types` marks a binding `"__AMBIG__"`, do NOT short-circuit before `qfi_opt`:
  // compiler byte-span types still disambiguate the exact scope, and only if `qfi_opt` misses do
  // we fail-closed with `""` (avoiding later field heuristics).
  let mut is_ambig_local = false
  if tk.kind == TokenKind::Ident && !(end_i > 0 && (tokens[end_i - 1].kind == TokenKind::Dot || tokens[end_i - 1].kind == TokenKind::ColonColon)) {
    match local_var_types.get(tk.raw) {
      Some(t) =>
      if t == "__AMBIG__" {
        is_ambig_local = true
      } else if t.length() > 0 {
        return t
      }
      None => ()
    }
  }
  // Try `PkgQueryTypes` on the receiver path span.
  match qfi_opt {
    Some(qfi) => {
      let rs = receiver_path_start_token(tokens, end_i)
      if rs >= 0 && rs <= end_i {
        match qt_lookup_expr_span_ty(qfi, content, tokens[rs].start_byte, tokens[end_i].end_byte, true) {
          Some(ty_c) =>
          if !str_has(ty_c, "?") && !str_has(ty_c, "<") {
            return ty_c
          }
          None => ()
        }
      }
    }
    None => ()
  }
  if is_ambig_local {
    return ""
  }
  // Field access `base.field`
  if tk.kind == TokenKind::Ident && end_i >= 2 && tokens[end_i - 1].kind == TokenKind::Dot {
    let base_ty = ms_infer_expr_ty(pkg, tokens, end_i - 2, content, qfi_opt, local_var_types)
    let base_head = ms_type_head(base_ty)
    if base_head.length() > 0 {
      match pkg.field_types.get(base_head + "::" + tk.raw) {
        Some(ft) => return ft
        None => ()
      }
    }
    match pkg.field_types.get(tk.raw) {
      Some(ft) => if ft != "__AMBIG__" { return ft }
      None => ()
    }
  }
  // Tuple element access `base.0` / `base.1`
  if tk.kind == TokenKind::IntLit && end_i >= 2 && tokens[end_i - 1].kind == TokenKind::Dot {
    let base_ty = ms_infer_expr_ty(pkg, tokens, end_i - 2, content, qfi_opt, local_var_types)
    let bt = base_ty.trim()
    if bt.starts_with("(") && bt.ends_with(")") {
      let parts = qt_split_top_level_type_args(bt.slice(1, bt.length() - 1))
      let idx = ms_parse_nonneg_int(tk.raw)
      if idx >= 0 && idx < parts.length() {
        return parts[idx]
      }
    }
  }
  // Array / FixedArray / ArrayBuf / ArrayView indexing `arr[i]` vs slice `arr[a:b]`
  if tk.kind == TokenKind::RBracket {
    let lb = find_open_before(tokens, end_i, 0)
    if lb > 0 {
      let mut is_slice = false
      let mut sk = lb + 1
      let mut sd = 0
      while sk < end_i {
        let skk = tokens[sk].kind
        if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace { sd = sd + 1 }
        else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace { if sd > 0 { sd = sd - 1 } }
        else if sd == 0 && skk == TokenKind::Colon { is_slice = true; break }
        sk = sk + 1
      }
      let base_ty = ms_infer_expr_ty(pkg, tokens, lb - 1, content, qfi_opt, local_var_types)
      let bh = ms_type_head(base_ty)
      let base_shadowed = ms_is_qualified_external_ty(base_ty) ||
      pkg.declared_types.contains(bh) || pkg.declared_traits.contains(bh) || pkg.using_types.contains(bh)
      if is_slice {
        if base_shadowed {
          return ""
        }
        if bh == "Array" || bh == "FixedArray" || bh == "ArrayView" || bh == "ArrayBuf" {
          let elem = ms_extract_array_elem_ty(base_ty)
          return if elem.length() > 0 { "ArrayView[" + elem + "]" } else { "" }
        }
        if bh == "String" || bh == "StrView" || bh == "StringView" {
          return "StrView"
        }
        if bh == "Bytes" {
          return "Bytes"
        }
        return ""
      }
      if base_shadowed {
        return ""
      }
      let elem = ms_extract_array_elem_ty(base_ty)
      if elem.length() > 0 {
        return elem
      }
    }
  }
  // Qualified or bare local enum variant constructor (`Enum::Variant` or `Variant`; never `dep::Enum::Variant`)
  if tk.kind == TokenKind::UpperIdent {
    if end_i >= 2 && tokens[end_i - 1].kind == TokenKind::ColonColon && tokens[end_i - 2].kind == TokenKind::UpperIdent &&
    !(end_i >= 3 && (tokens[end_i - 3].kind == TokenKind::ColonColon || tokens[end_i - 3].kind == TokenKind::Dot)) {
      let en = tokens[end_i - 2].raw
      if pkg.declared_types.contains(en) {
        return en
      }
    } else if !(end_i > 0 && (tokens[end_i - 1].kind == TokenKind::Dot || tokens[end_i - 1].kind == TokenKind::ColonColon)) {
      match pkg.enum_ctor_types.get(tk.raw) {
        Some(en) => if en != "__AMBIG__" && en.length() > 0 { return en }
        None => ()
      }
    }
  }
  // Call result `f(...)` / `T::m(...)` / `recv.m(...)`
  if tk.kind == TokenKind::RParen {
    let lp = find_open_before(tokens, end_i, 0)
    if lp >= 1 {
      let callee = tokens[lp - 1]
      if callee.kind == TokenKind::UpperIdent {
        if lp >= 3 && tokens[lp - 2].kind == TokenKind::ColonColon && tokens[lp - 3].kind == TokenKind::UpperIdent &&
        !(lp >= 4 && (tokens[lp - 4].kind == TokenKind::ColonColon || tokens[lp - 4].kind == TokenKind::Dot)) {
          let en = tokens[lp - 3].raw
          if pkg.declared_types.contains(en) {
            return en
          }
        } else if !(lp >= 2 && (tokens[lp - 2].kind == TokenKind::Dot || tokens[lp - 2].kind == TokenKind::ColonColon)) {
          match pkg.enum_ctor_types.get(callee.raw) {
            Some(en) => if en != "__AMBIG__" && en.length() > 0 { return en }
            None => ()
          }
        }
      } else if callee.kind == TokenKind::Ident {
        if lp >= 2 && tokens[lp - 2].kind == TokenKind::Dot {
          let m = callee.raw
          let recv_ty = ms_infer_expr_ty(pkg, tokens, lp - 3, content, qfi_opt, local_var_types)
          let rh = ms_type_head(recv_ty)
          if rh.length() > 0 {
            match pkg.fn_ret_types.get(rh + "::" + m) {
              Some(rt) => return rt
              None => ()
            }
          }
          if ms_is_qualified_external_ty(recv_ty) ||
          pkg.declared_types.contains(rh) || pkg.declared_traits.contains(rh) || pkg.using_types.contains(rh) {
            return ""
          }
          let is_str_recv = rh == "String" || rh == "StrView" || rh == "StringView"
          let is_arr_recv = rh == "Array" || rh == "FixedArray" || rh == "ArrayView" || rh == "ArrayBuf"
          let is_builtin_recv = ms_is_builtin_scalar_ty(recv_ty) || ms_is_builtin_container_head(rh)
          if m == "slice" {
            if is_str_recv { return "String" }
            if rh == "Bytes" { return "Bytes" }
            if is_arr_recv { return recv_ty }
            return ""
          }
          if m == "iter" {
            if is_arr_recv {
              let elem = ms_extract_array_elem_ty(recv_ty)
              return if elem.length() > 0 { "MbtIter[" + elem + "]" } else { "MbtIter" }
            }
            if is_str_recv { return "MbtIter[Char]" }
            if rh == "Bytes" { return "MbtIter[Byte]" }
            if rh == "Map" || rh == "OrderedMap" || rh == "OrderedSet" { return "MbtIter" }
            return ""
          }
          if m == "to_string" {
            if ms_is_builtin_scalar_ty(recv_ty) { return "String" }
            return ""
          }
          if m == "exact_view" || m == "view" || m == "view_from" || m == "as_view" {
            if is_str_recv { return "StrView" }
            return ""
          }
          if m == "trim" || m == "trim_start" || m == "trim_end" ||
          m == "substring" || m == "join" || m == "to_owned" ||
          m == "to_lower" || m == "to_upper" || m == "to_ascii_lowercase" || m == "to_ascii_uppercase" ||
          m == "replace" || m == "replace_all" || m == "repeat" || m == "pad_start" || m == "pad_end" {
            if is_str_recv { return "String" }
            return ""
          }
          if m == "get" && (rh == "Map" || rh == "OrderedMap") {
            let t_get = ms_strip_pkg_prefix(recv_ty)
            if t_get.ends_with("]") {
              let lb_get = t_get.index_of("[")
              if lb_get > 0 {
                let parts_get = qt_split_top_level_type_args(t_get.slice(lb_get + 1, t_get.length() - 1).trim())
                if parts_get.length() >= 2 {
                  return "Option[" + parts_get[1].trim() + "]"
                }
              }
            }
            return ""
          }
          if m == "is_some" || m == "is_none" {
            if rh == "Option" { return "Bool" }
            return ""
          }
          if m == "is_ok" || m == "is_err" {
            if rh == "Result" { return "Bool" }
            return ""
          }
          if is_builtin_recv {
            if m == "length" || m == "size" || m == "to_int" || m == "index_of" || m == "compare" || m == "code_unit_at" ||
            m == "char_length" || m == "byte_length" { return "Int" }
            if m == "is_empty" ||
            m == "starts_with" || m == "ends_with" || m == "has_prefix" || m == "has_suffix" || m == "contains" ||
            m == "is_ascii" || m == "is_ascii_alphabetic" || m == "is_ascii_digit" ||
            m == "is_ascii_alphanumeric" || m == "is_ascii_whitespace" ||
            m == "is_ascii_uppercase" || m == "is_ascii_lowercase" { return "Bool" }
          }
        } else if lp >= 3 && tokens[lp - 2].kind == TokenKind::ColonColon {
          let q = tokens[lp - 3].raw
          if q == "mbt_compat" {
            if callee.raw == "arr_iter" || callee.raw == "fixed_array_iter" || callee.raw == "array_view_iter" {
              let cargs = ms_split_call_args(tokens, lp, end_i)
              let elem = if cargs.length() >= 1 {
                ms_extract_array_elem_ty(ms_infer_expr_ty(pkg, tokens, cargs[0].1 - 1, content, qfi_opt, local_var_types))
              } else {
                ""
              }
              return if elem.length() > 0 { "MbtIter[" + elem + "]" } else { "MbtIter" }
            }
            if callee.raw == "str_iter" {
              return "MbtIter[Char]"
            }
            if callee.raw == "ordered_map_iter_lazy" || callee.raw == "ordered_map_keys_iter" {
              return "MbtIter"
            }
            if callee.raw == "str_to_lower" || callee.raw == "str_to_upper" || callee.raw == "str_trim_end" ||
            callee.raw == "str_view" || callee.raw == "str_exact_view" || callee.raw == "str_clamped_view" ||
            callee.raw == "utf16_slice" || callee.raw == "str_from_char_array" {
              return "String"
            }
            if callee.raw == "str_has_prefix" || callee.raw == "str_has_suffix" || callee.raw == "str_contains_char" ||
            callee.raw == "bytes_eq" || callee.raw == "ref_physical_equal" || callee.raw == "arr_is_empty" ||
            callee.raw == "opt_is_empty" || callee.raw == "double_is_nan" || callee.raw == "double_is_inf" ||
            callee.raw == "float_is_nan" || callee.raw == "char_is_ascii_alphabetic" {
              return "Bool"
            }
            if callee.raw == "str_byte_len" || callee.raw == "utf16_code_unit_at" ||
            callee.raw == "int_compare" || callee.raw == "int_min" || callee.raw == "int_max" ||
            callee.raw == "float_compare" || callee.raw == "ordered_map_size" ||
            callee.raw == "str_compare" || callee.raw == "str_lexical_compare" {
              return "Int"
            }
          }
          match pkg.fn_ret_types.get(q + "::" + callee.raw) {
            Some(rt) => return rt
            None => ()
          }
        } else {
          match pkg.fn_ret_types.get(callee.raw) {
            Some(rt) => return rt
            None => ()
          }
        }
      }
    }
  }
  ""
}

fn ms_parse_nonneg_int(s : String) -> Int {
  if s.length() == 0 { return -1 }
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 { return -1 }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  v
}

fn ms_record_local_var_ty(out : Map[String, String], vname : String, ty_s : String) -> Unit {
  if ty_s.length() == 0 {
    out[vname] = "__AMBIG__"
    return
  }
  match out.get(vname) {
    Some(prev) => if prev != ty_s { out[vname] = "__AMBIG__" }
    None => out[vname] = ty_s
  }
}

///| True iff `m` is a `MapKey`-only (never `new_by`) `mbt_compat::ordered_map_*` / `ordered_set_*` constructor.
fn ms_is_pure_mbt_compat_map_ctor(m : String) -> Bool {
  m == "ordered_map_new" || m == "ordered_map_new_cap" ||
  m == "ordered_map_new_pair" || m == "ordered_map_new_cap_pair" ||
  m == "ordered_map_new_triple" || m == "ordered_map_new_cap_triple" ||
  m == "ordered_map_from_array" || m == "ordered_map_from_array_cap" ||
  m == "ordered_map_from_array_pair" || m == "ordered_map_from_array_cap_pair" ||
  m == "ordered_map_from_array_triple" || m == "ordered_map_from_array_cap_triple" ||
  m == "ordered_map_from_map" ||
  m == "ordered_set_new" || m == "ordered_set_from_array" || m == "ordered_set_from_iter"
}

///| True iff `tokens[expr_s..expr_e)` is a direct `MapKey`-only map/set constructor, empty/key-value
///| map literal, or unshadowed call to a same-package function in `pkg.pure_map_ret_fns` (never `new_by`).
fn ms_is_pure_map_ctor_expr(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  expr_s0 : Int,
  expr_e0 : Int,
  local_var_types : Map[String, String],
  forbidden_fns : Map[String, Bool],
  active_generics : Map[String, Bool],
) -> Bool {
  let mut expr_s = expr_s0
  let mut expr_e = expr_e0
  while expr_s + 1 < expr_e && tokens[expr_s].kind == TokenKind::LParen &&
  tokens[expr_e - 1].kind == TokenKind::RParen && find_matching_delim(tokens, expr_s) == expr_e - 1 {
    expr_s = expr_s + 1
    expr_e = expr_e - 1
  }
  if expr_s >= expr_e {
    return false
  }
  // Empty `{}` or key-value map literal `{ k: v, ... }` (never a block `{ m_ext }` and never containing `new_by`)
  if tokens[expr_s].kind == TokenKind::LBrace && find_matching_delim(tokens, expr_s) == expr_e - 1 {
    if expr_s + 1 == expr_e - 1 {
      return true
    }
    let mut k = expr_s + 1
    let mut d = 0
    let mut entry_has_colon = false
    let mut has_entry_tokens = false
    while k < expr_e - 1 {
      let tk = tokens[k]
      let kk = tk.kind
      if tk.raw == "new_by" {
        return false
      }
      if d == 0 {
        if kk == TokenKind::Semi || tk.raw == "let" || tk.raw == "return" || tk.raw == "if" ||
        tk.raw == "match" || tk.raw == "for" || tk.raw == "while" || tk.raw == "loop" ||
        tk.raw == "try" || tk.raw == "fn" {
          return false
        }
        if kk == TokenKind::Comma {
          if !entry_has_colon {
            return false
          }
          entry_has_colon = false
          has_entry_tokens = false
          k = k + 1
          continue
        }
        if kk == TokenKind::Colon {
          entry_has_colon = true
        }
        has_entry_tokens = true
      }
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
      else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      k = k + 1
    }
    if has_entry_tokens && !entry_has_colon {
      return false
    }
    return true
  }
  if tokens[expr_e - 1].kind != TokenKind::RParen {
    return false
  }
  let lp = find_open_before(tokens, expr_e - 1, expr_s)
  if lp <= expr_s {
    return false
  }
  // `mbt_compat::<ctor>(...)`
  if lp == expr_s + 3 && tokens[expr_s].raw == "mbt_compat" &&
  tokens[expr_s + 1].kind == TokenKind::ColonColon && tokens[expr_s + 2].kind == TokenKind::Ident {
    return ms_is_pure_mbt_compat_map_ctor(tokens[expr_s + 2].raw)
  }
  // Unshadowed `Map::new(...)` / `OrderedMap::new(...)` / `OrderedSet::new(...)` / `from_array` / `of` / `from_iter`
  if lp == expr_s + 3 && tokens[expr_s + 1].kind == TokenKind::ColonColon && tokens[expr_s + 2].kind == TokenKind::Ident {
    let q = tokens[expr_s].raw
    let nm = tokens[expr_s + 2].raw
    let is_builtin_q = (q == "Map" || q == "OrderedMap" || q == "OrderedSet") &&
    !pkg.declared_types.contains(q) && !pkg.declared_traits.contains(q) && !pkg.using_types.contains(q)
    if is_builtin_q && (nm == "new" || nm == "from_array" || nm == "of" || nm == "from_iter") {
      return true
    }
    if !active_generics.contains(q) && !pkg.declared_traits.contains(q) && !pkg.using_types.contains(q) &&
    pkg.pure_map_ret_fns.contains(q + "::" + nm) {
      return true
    }
    return false
  }
  // Unshadowed `Map(...)` / `OrderedMap(...)` / `OrderedSet(...)` or unshadowed same-package `helper(...)`
  if lp == expr_s + 1 {
    let nm = tokens[expr_s].raw
    let is_builtin_ctor = (nm == "Map" || nm == "OrderedMap" || nm == "OrderedSet") &&
    !pkg.declared_types.contains(nm) && !pkg.declared_traits.contains(nm) && !pkg.using_types.contains(nm)
    if is_builtin_ctor {
      return true
    }
    if tokens[expr_s].kind == TokenKind::Ident && pkg.pure_map_ret_fns.contains(nm) &&
    !local_var_types.contains(nm) && !forbidden_fns.contains(nm) {
      return true
    }
    return false
  }
  false
}

///| True iff `tokens[expr_s..expr_e)` is a proven-pure map value (bare ident in `pure_map_vars` or `ms_is_pure_map_ctor_expr`).
fn ms_is_pure_map_value_expr(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  expr_s0 : Int,
  expr_e0 : Int,
  local_var_types : Map[String, String],
  pure_map_vars : Map[String, Bool],
  forbidden_fns : Map[String, Bool],
  active_generics : Map[String, Bool],
) -> Bool {
  let mut expr_s = expr_s0
  let mut expr_e = expr_e0
  while expr_s + 1 < expr_e && tokens[expr_s].kind == TokenKind::LParen &&
  tokens[expr_e - 1].kind == TokenKind::RParen && find_matching_delim(tokens, expr_s) == expr_e - 1 {
    expr_s = expr_s + 1
    expr_e = expr_e - 1
  }
  if expr_s + 1 == expr_e && tokens[expr_s].kind == TokenKind::Ident {
    return pure_map_vars.contains(tokens[expr_s].raw)
  }
  ms_is_pure_map_ctor_expr(pkg, tokens, expr_s, expr_e, local_var_types, forbidden_fns, active_generics)
}

///| True iff receiver ending at `recv_end` is proven to have `MapKey`-only callbacks (never `new_by`).
///| Never trusts `qfi_opt`, function params, fields, array elements, or `for m in ms`.
fn ms_is_proven_pure_map_recv(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  recv_end : Int,
  local_var_types : Map[String, String],
  pure_map_vars : Map[String, Bool],
  forbidden_fns : Map[String, Bool],
  active_generics : Map[String, Bool],
) -> Bool {
  if recv_end < 0 || recv_end >= tokens.length() {
    return false
  }
  let tk = tokens[recv_end]
  if tk.kind == TokenKind::Ident &&
  !(recv_end > 0 && (tokens[recv_end - 1].kind == TokenKind::Dot || tokens[recv_end - 1].kind == TokenKind::ColonColon)) {
    return pure_map_vars.contains(tk.raw)
  }
  if tk.kind == TokenKind::RParen {
    let rs = receiver_path_start_token(tokens, recv_end)
    if rs >= 0 && rs <= recv_end {
      return ms_is_pure_map_ctor_expr(pkg, tokens, rs, recv_end + 1, local_var_types, forbidden_fns, active_generics)
    }
  }
  false
}

///| Collect identifiers reassigned (`x = ...` / `x += ...`) in `[s, e)`, excluding `let` initializers and named call args.
fn ms_collect_reassigned_idents(tokens : Array[Token], s : Int, e : Int, out : Map[String, Bool]) -> Unit {
  let mut i = s + 1
  while i < e {
    let kk = tokens[i].kind
    if (kk == TokenKind::Eq || kk == TokenKind::AssignOp) && tokens[i - 1].kind == TokenKind::Ident {
      let is_field = i >= s + 2 && tokens[i - 2].kind == TokenKind::Dot
      if !is_field && !ms_is_let_eq(tokens, i, s) &&
      !(kk == TokenKind::Eq && ms_is_named_call_arg_eq(tokens, i - 1, s)) {
        out[tokens[i - 1].raw] = true
      }
    }
    i = i + 1
  }
}

fn ms_prune_pure_map_vars(pure_map_vars : Map[String, Bool], bad : Map[String, Bool]) -> Unit {
  for nm in bad.keys() {
    let _ = pure_map_vars.remove(nm)
  }
}

fn ms_clone_bool_map(m : Map[String, Bool]) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  for k in m.keys() {
    out[k] = true
  }
  out
}

///| True iff `next_tk` continues the expression ending at `prev_tk` (matching `p_parse_postfix_tail`:
///| `LParen` / `LBracket` / `Question` do not continue across a newline).
fn ms_is_expr_continuation_tok(prev_tk : Token, next_tk : Token) -> Bool {
  let k = next_tk.kind
  if (k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::Question) &&
  next_tk.line > prev_tk.line {
    return false
  }
  k == TokenKind::PipeGt || k == TokenKind::Dot || k == TokenKind::DotDot ||
  k == TokenKind::DotDotLt || k == TokenKind::DotDotLtEq || k == TokenKind::DotDotEq ||
  k == TokenKind::ColonColon || k == TokenKind::LParen || k == TokenKind::LBracket ||
  k == TokenKind::Question || k == TokenKind::QuestionEq || k == TokenKind::FatArrow ||
  k == TokenKind::Plus || k == TokenKind::Minus || k == TokenKind::Star ||
  k == TokenKind::Slash || k == TokenKind::Percent || k == TokenKind::Amp ||
  k == TokenKind::AmpAmp || k == TokenKind::Pipe || k == TokenKind::PipePipe ||
  k == TokenKind::Caret || k == TokenKind::Shl || k == TokenKind::Shr ||
  k == TokenKind::Eq || k == TokenKind::EqEq || k == TokenKind::BangEq ||
  k == TokenKind::Lt || k == TokenKind::LtEq || k == TokenKind::Gt ||
  k == TokenKind::GtEq || k == TokenKind::AssignOp ||
  next_tk.raw == "as" || next_tk.raw == "is"
}

///| Collect local `let [mut] x [: T] = rhs` and simple `for x in expr { ... }` variable types in `[s, e)` into `out`,
///| and record immutable `MapKey`-only local map/set bindings in `pure_map_vars`.
fn ms_collect_local_var_types(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  s : Int,
  e : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  out : Map[String, String],
  pure_map_vars : Map[String, Bool],
  forbidden_fns : Map[String, Bool],
  active_generics : Map[String, Bool],
) -> Unit {
  let for_bound : Map[String, Bool] = Map()
  let let_bound : Map[String, Bool] = Map()
  let mut i = s
  while i + 2 < e {
    // Skip nested closure bodies `fn(...) [-> R] { ... }` so closure-local `let`/`for` bindings
    // neither leak into the enclosing scope nor collide across sibling closures.
    if tokens[i].raw == "fn" && i + 1 < e && tokens[i + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i + 1)
      let mut lb = cp + 1
      while lb < e && tokens[lb].kind != TokenKind::LBrace && tokens[lb].kind != TokenKind::Semi && tokens[lb].kind != TokenKind::RBrace {
        lb = lb + 1
      }
      if lb < e && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        if rb > lb {
          i = rb + 1
          continue
        }
      }
    }
    if tokens[i].raw == "let" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) {
      let mut ni = i + 1
      let mut is_mut = false
      if ni < e && tokens[ni].raw == "mut" {
        is_mut = true
        ni = ni + 1
      }
      if ni < e && tokens[ni].kind == TokenKind::Ident {
        let vname = tokens[ni].raw
        let was_bound = for_bound.contains(vname) || let_bound.contains(vname) || out.contains(vname) ||
        pkg.top_level_bindings.contains(vname) || pkg.fn_keys.contains(vname)
        let mut rhs_s = -1
        let mut rhs_e = -1
        let mut rhs_continued = false
        if for_bound.contains(vname) || pkg.top_level_bindings.contains(vname) || pkg.fn_keys.contains(vname) {
          out[vname] = "__AMBIG__"
        } else if ni + 2 < e && tokens[ni + 1].kind == TokenKind::Colon {
          let mut eq_i = ni + 2
          let mut d = 0
          while eq_i < e && !(d == 0 && tokens[eq_i].kind == TokenKind::Eq) {
            let k = tokens[eq_i].kind
            if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
            else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { if d > 0 { d = d - 1 } }
            eq_i = eq_i + 1
          }
          if eq_i < e && eq_i > ni + 2 {
            let ty_s = ms_join_token_slice(tokens, ni + 2, eq_i)
            ms_record_local_var_ty(out, vname, ty_s)
            rhs_s = eq_i + 1
            rhs_e = statement_end(tokens, rhs_s, e)
            rhs_continued = rhs_e > rhs_s && rhs_e < e && ms_is_expr_continuation_tok(tokens[rhs_e - 1], tokens[rhs_e])
          }
        } else if ni + 2 < e && tokens[ni + 1].kind == TokenKind::Eq {
          rhs_s = ni + 2
          rhs_e = statement_end(tokens, rhs_s, e)
          rhs_continued = rhs_e > rhs_s && rhs_e < e && ms_is_expr_continuation_tok(tokens[rhs_e - 1], tokens[rhs_e])
          if rhs_e > rhs_s && !rhs_continued {
            // Check simple struct literal `Type::{ ... }` or `Type::new(...)` or `rhs` type
            if rhs_s + 2 < rhs_e && tokens[rhs_s].kind == TokenKind::UpperIdent &&
            tokens[rhs_s + 1].kind == TokenKind::ColonColon && tokens[rhs_s + 2].kind == TokenKind::LBrace {
              ms_record_local_var_ty(out, vname, tokens[rhs_s].raw)
            } else {
              let rty = ms_infer_expr_ty(pkg, tokens, rhs_e - 1, content, qfi_opt, out)
              ms_record_local_var_ty(out, vname, rty)
            }
          } else {
            out[vname] = "__AMBIG__"
          }
        }
        if !is_mut && !was_bound && !rhs_continued && rhs_s >= 0 && rhs_e > rhs_s &&
        ms_is_pure_map_ctor_expr(pkg, tokens, rhs_s, rhs_e, out, forbidden_fns, active_generics) {
          pure_map_vars[vname] = true
        } else {
          let _ = pure_map_vars.remove(vname)
        }
        let_bound[vname] = true
      }
    } else if i + 3 < e && tokens[i].raw == "for" && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
    tokens[i + 1].kind == TokenKind::Ident && !ms_is_pattern_kw(tokens[i + 1].raw) && tokens[i + 2].raw == "in" {
      let x = tokens[i + 1].raw
      let for_bound_was_present = for_bound.contains(x)
      for_bound[x] = true
      let _ = pure_map_vars.remove(x)
      let mut lb_i = i + 3
      let mut d = 0
      let mut has_ctrl_kw = false
      while lb_i < e {
        let lk = tokens[lb_i].kind
        if d == 0 && (lk == TokenKind::LBrace || lk == TokenKind::Semi) { break }
        if d == 0 {
          let lraw = tokens[lb_i].raw
          if lraw == "match" || lraw == "if" || lraw == "while" || lraw == "for" ||
          lraw == "loop" || lraw == "try" || lraw == "fn" {
            has_ctrl_kw = true
          }
        }
        if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace { d = d + 1 }
        else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
        lb_i = lb_i + 1
      }
      let can_infer_for = lb_i > i + 3 && lb_i < e && tokens[lb_i].kind == TokenKind::LBrace &&
      tokens[i + 3].kind != TokenKind::LBrace && !has_ctrl_kw &&
      !for_bound_was_present && !let_bound.contains(x) && !out.contains(x) &&
      !pkg.top_level_bindings.contains(x) && !pkg.fn_keys.contains(x)
      if can_infer_for {
        let arr_ty = ms_infer_expr_ty(pkg, tokens, lb_i - 1, content, qfi_opt, out)
        let arr_head = ms_type_head(arr_ty)
        if !ms_is_qualified_external_ty(arr_ty) &&
        !pkg.declared_types.contains(arr_head) &&
        !pkg.declared_traits.contains(arr_head) &&
        !pkg.using_types.contains(arr_head) &&
        !active_generics.contains(arr_head) {
          let elem = ms_extract_array_elem_ty(arr_ty)
          if elem.length() > 0 {
            ms_record_local_var_ty(out, x, elem)
          } else {
            out[x] = "__AMBIG__"
          }
        } else {
          out[x] = "__AMBIG__"
        }
      } else {
        out[x] = "__AMBIG__"
      }
    }
    i = i + 1
  }
}

///| True iff `tokens[lhs_end]` before `=` is a named call argument (`callee(..., name=val)`), not a reassignment.
fn ms_is_named_call_arg_eq(tokens : Array[Token], lhs_end : Int, s : Int) -> Bool {
  if lhs_end <= s || tokens[lhs_end].kind != TokenKind::Ident {
    return false
  }
  let pk = tokens[lhs_end - 1].kind
  if pk != TokenKind::LParen && pk != TokenKind::Comma {
    return false
  }
  let mut lp = lhs_end - 1
  if pk == TokenKind::Comma {
    let mut k = lhs_end - 2
    let mut d = 0
    lp = -1
    while k >= s {
      let kk = tokens[k].kind
      if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
        d = d + 1
      } else if kk == TokenKind::LParen {
        if d == 0 {
          lp = k
          break
        }
        d = d - 1
      } else if kk == TokenKind::LBracket || kk == TokenKind::LBrace {
        if d == 0 {
          return false
        }
        d = d - 1
      } else if d == 0 && kk == TokenKind::Semi {
        return false
      }
      k = k - 1
    }
  }
  lp > s && (tokens[lp - 1].kind == TokenKind::Ident || tokens[lp - 1].kind == TokenKind::UpperIdent)
}

///| Split comma-separated argument ranges `(start, end_excl)` inside `tokens[lp..rp]`.
fn ms_split_call_args(tokens : Array[Token], lp : Int, rp : Int) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  let mut i = lp + 1
  while i < rp {
    if tokens[i].kind == TokenKind::Comma { i = i + 1; continue }
    let mut ae = i
    let mut d = 0
    while ae < rp {
      let ak = tokens[ae].kind
      if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { d = d + 1 }
      else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      else if d == 0 && ak == TokenKind::Comma { break }
      ae = ae + 1
    }
    if ae > i {
      out.push((i, ae))
    }
    i = ae + 1
  }
  out
}

fn ms_is_token_binop(tk : Token) -> String {
  let k = tk.kind
  if k == TokenKind::Plus { return "+" }
  if k == TokenKind::Minus { return "-" }
  if k == TokenKind::Star { return "*" }
  if k == TokenKind::Slash { return "/" }
  if k == TokenKind::Percent { return "%" }
  if k == TokenKind::EqEq { return "==" }
  if k == TokenKind::BangEq { return "!=" }
  if k == TokenKind::Lt { return "<" }
  if k == TokenKind::LtEq { return "<=" }
  if k == TokenKind::Gt { return ">" }
  if k == TokenKind::GtEq { return ">=" }
  ""
}

///| Last token index (inclusive) of the postfix expression starting at `start_i` (`other.id`, `a.b[0].c()`).
fn ms_postfix_expr_end(tokens : Array[Token], start_i : Int, limit : Int) -> Int {
  if start_i < 0 || start_i >= limit {
    return -1
  }
  let mut cur = start_i
  if tokens[cur].kind == TokenKind::LParen || tokens[cur].kind == TokenKind::LBracket {
    let cl = find_matching_delim(tokens, cur)
    if cl > cur && cl < limit { cur = cl }
  }
  while cur + 1 < limit {
    let nk = tokens[cur + 1].kind
    if nk == TokenKind::Dot && cur + 2 < limit &&
    (tokens[cur + 2].kind == TokenKind::Ident || tokens[cur + 2].kind == TokenKind::IntLit) {
      cur = cur + 2
      continue
    }
    if nk == TokenKind::ColonColon && cur + 2 < limit &&
    (tokens[cur + 2].kind == TokenKind::Ident || tokens[cur + 2].kind == TokenKind::UpperIdent) {
      cur = cur + 2
      continue
    }
    if (nk == TokenKind::LParen || nk == TokenKind::LBracket) && !tokens[cur + 1].newline_before {
      let cl = find_matching_delim(tokens, cur + 1)
      if cl > cur + 1 && cl < limit {
        cur = cl
        continue
      }
    }
    break
  }
  cur
}

///| Scan `[s, e)` for direct mutation effects and call edges (into `callees_out` if `collect_edges` is true,
///| or directly merging from `pkg.summaries` if `collect_edges` is false).
fn ms_scan_span(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  s : Int,
  e : Int,
  fn_body_open : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  local_var_types : Map[String, String],
  pure_map_vars : Map[String, Bool],
  callables : Map[String, Bool],
  active_generics : Map[String, Bool],
  sum : FnMutationSummary,
  callees_out : Array[String],
  collect_edges : Bool,
  depth : Int,
) -> Unit {
  if depth > 8 {
    sum.unknown = true
    return
  }
  let mut i = s
  while i < e {
    let tk = tokens[i]
    let kk = tk.kind

    // Inline closure literals (`fn(...) { ... }`):
    // - If immediately invoked (`fn(...) { ... }(...)`), MUST scan its body with closure params marked `__AMBIG__`!
    // - If uncalled (e.g., dead/sibling closure or passed as HOF argument analyzed at call site), skip body.
    if tk.raw == "fn" && i + 1 < e && tokens[i + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i + 1)
      let mut lb = cp + 1
      while lb < e && tokens[lb].kind != TokenKind::LBrace && !tokens[lb].newline_before {
        lb = lb + 1
      }
      if lb < e && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        if rb > lb {
          if rb + 1 < e && tokens[rb + 1].kind == TokenKind::LParen {
            let cl_vt : Map[String, String] = Map()
            for k in local_var_types.keys() {
              match local_var_types.get(k) {
                Some(v) => cl_vt[k] = v
                None => ()
              }
            }
            let cl_pmv = ms_clone_bool_map(pure_map_vars)
            let pnames = collect_pion_fn_param_names(tokens, i + 1, cp)
            for pn in pnames {
              if pn.length() > 0 && pn != "_" {
                cl_vt[pn] = "__AMBIG__"
                let _ = cl_pmv.remove(pn)
              }
            }
            ms_collect_local_var_types(pkg, tokens, lb + 1, rb, content, qfi_opt, cl_vt, cl_pmv, callables, active_generics)
            let inner_pats : Map[String, Bool] = Map()
            ms_collect_pattern_bound_idents_in_span_ex(tokens, lb + 1, rb, inner_pats, false)
            ms_collect_closure_param_names(tokens, lb + 1, rb, inner_pats)
            ms_mark_shadowed_ambig(cl_vt, inner_pats)
            ms_prune_pure_map_vars(cl_pmv, inner_pats)
            let inner_reass : Map[String, Bool] = Map()
            ms_collect_reassigned_idents(tokens, lb + 1, rb, inner_reass)
            ms_prune_pure_map_vars(cl_pmv, inner_reass)
            ms_scan_span(pkg, tokens, lb + 1, rb, fn_body_open, content, qfi_opt, cl_vt, cl_pmv, callables, active_generics, sum, callees_out, collect_edges, depth + 1)
          }
          i = rb + 1
          continue
        }
      }
    }

    // Class 2: String interpolation `"\{expr}"` — scan holes + check Show purity
    if kk == TokenKind::InterpString || kk == TokenKind::InterpMultiline || kk == TokenKind::StringLit {
      let holes = interp_holes(tk.raw)
      for sub in holes {
        let sn = sub.length() - 1
        if sn > 0 {
          ms_scan_span(pkg, sub, 0, sn, fn_body_open, "", None, local_var_types, pure_map_vars, callables, active_generics, sum, callees_out, collect_edges, depth + 1)
          // Show dispatch: unless the hole expression is proven built-in scalar/String, mark unknown
          let hty = ms_infer_expr_ty(pkg, sub, sn - 1, "", None, local_var_types)
          if !ms_is_builtin_scalar_ty(hty) {
            sum.unknown = true
          }
        }
      }
    }

    // Class 2: Pipe operator `|>` — handle bare ident, qualified `T::f`, constructors, and fail-closed on all other RHS
    if kk == TokenKind::PipeGt {
      if i + 1 >= e {
        sum.unknown = true
      } else if i + 3 < e && (tokens[i + 1].kind == TokenKind::UpperIdent || tokens[i + 1].kind == TokenKind::Ident) &&
      tokens[i + 2].kind == TokenKind::ColonColon && tokens[i + 3].kind == TokenKind::Ident {
        // Qualified pipe RHS `x |> W::grow` or `x |> W::grow(y)`
        if !(i + 4 < e && tokens[i + 4].kind == TokenKind::LParen) {
          let pq = tokens[i + 1].raw
          let pnm = tokens[i + 3].raw
          let qk = pq + "::" + pnm
          if active_generics.contains(pq) || pkg.declared_traits.contains(pq) {
            sum.unknown = true
          } else if pkg.using_types.contains(pq) {
            if !is_ctor_name(pnm) {
              sum.unknown = true
            }
          } else if i + 4 < e && tokens[i + 4].kind == TokenKind::ColonColon {
            sum.unknown = true
          } else if pkg.fn_keys.contains(qk) {
            ms_add_call_effect(pkg, qk, sum, callees_out, collect_edges)
          } else if is_ctor_name(pnm) {
            ()
          } else {
            sum.unknown = true
          }
        }
      } else if tokens[i + 1].kind == TokenKind::Ident {
        if !(i + 2 < e && tokens[i + 2].kind == TokenKind::LParen) {
          let pnm = tokens[i + 1].raw
          if callables.contains(pnm) || local_var_types.contains(pnm) {
            sum.unknown = true
          } else if pkg.fn_keys.contains(pnm) {
            ms_add_call_effect(pkg, pnm, sum, callees_out, collect_edges)
          } else {
            sum.unknown = true
          }
        }
      } else if tokens[i + 1].kind == TokenKind::UpperIdent && is_ctor_name(tokens[i + 1].raw) &&
      !(i + 2 < e && tokens[i + 2].kind == TokenKind::ColonColon) {
        ()
      } else {
        // `@dep.f`, closure `fn(a){...}`, `(expr)`, etc. -> fail-closed!
        sum.unknown = true
      }
    }

    // Class 2: Binary & unary operator impls (`+ - * / % == != < <= > >=`)
    let op_sym = ms_is_token_binop(tk)
    if op_sym.length() > 0 && pkg.custom_ops.contains(op_sym) {
      let mut is_unary_minus = false
      if op_sym == "-" {
        if i <= s || tokens[i].newline_before {
          is_unary_minus = true
        } else {
          let pk = tokens[i - 1].kind
          let prev_ends_expr = pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
          pk == TokenKind::IntLit || pk == TokenKind::FloatLit || pk == TokenKind::StringLit ||
          pk == TokenKind::CharLit || pk == TokenKind::ByteCharLit || pk == TokenKind::ByteStringLit ||
          pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace
          if !prev_ends_expr {
            is_unary_minus = true
          }
        }
      }
      let lhs_ty = if is_unary_minus || i <= s { "" } else { ms_infer_expr_ty(pkg, tokens, i - 1, content, qfi_opt, local_var_types) }
      let rhs_end = if i + 1 < e { ms_postfix_expr_end(tokens, i + 1, e) } else { -1 }
      let rhs_ty = if rhs_end >= i + 1 { ms_infer_expr_ty(pkg, tokens, rhs_end, content, qfi_opt, local_var_types) } else { "" }
      let mut is_pure_scalar_op = if is_unary_minus {
        ms_is_builtin_scalar_ty(rhs_ty)
      } else if op_sym == "==" || op_sym == "!=" {
        ms_ty_is_pure_eq(lhs_ty, pkg.pure_eq_types, active_generics) && ms_ty_is_pure_eq(rhs_ty, pkg.pure_eq_types, active_generics)
      } else {
        ms_is_builtin_scalar_ty(lhs_ty) && ms_is_builtin_scalar_ty(rhs_ty)
      }
      // Guard `==`/`!=` operands adjacent to custom arithmetic/binary operators (`a + b == c` or `a == b + c`),
      // preserving pure scalar arithmetic (e.g. `x + 1 == 5` when both sides of `+` are built-in scalars).
      if is_pure_scalar_op && (op_sym == "==" || op_sym == "!=") {
        let lhs_start = receiver_path_start_token(tokens, i - 1)
        if lhs_start > s {
          let prev_op_i = lhs_start - 1
          let prev_op = ms_is_token_binop(tokens[prev_op_i])
          if prev_op.length() > 0 && prev_op != "==" && prev_op != "!=" && pkg.custom_ops.contains(prev_op) {
            let prev_lhs_ty = if prev_op_i > s { ms_infer_expr_ty(pkg, tokens, prev_op_i - 1, content, qfi_opt, local_var_types) } else { "" }
            if !(ms_is_builtin_scalar_ty(prev_lhs_ty) && ms_is_builtin_scalar_ty(lhs_ty)) {
              is_pure_scalar_op = false
            }
          }
        }
        if rhs_end >= i + 1 && rhs_end + 1 < e {
          let next_op_i = rhs_end + 1
          let next_op = ms_is_token_binop(tokens[next_op_i])
          if next_op.length() > 0 && next_op != "==" && next_op != "!=" && pkg.custom_ops.contains(next_op) {
            let next_rhs_end = if next_op_i + 1 < e { ms_postfix_expr_end(tokens, next_op_i + 1, e) } else { -1 }
            let next_rhs_ty = if next_rhs_end >= next_op_i + 1 { ms_infer_expr_ty(pkg, tokens, next_rhs_end, content, qfi_opt, local_var_types) } else { "" }
            if !(ms_is_builtin_scalar_ty(rhs_ty) && ms_is_builtin_scalar_ty(next_rhs_ty)) {
              is_pure_scalar_op = false
            }
          }
        }
      }
      if !is_pure_scalar_op {
        if pkg.ext_custom_ops.contains(op_sym) {
          sum.unknown = true
        } else {
          match pkg.op_impl_fns.get(op_sym) {
            Some(fns) =>
            if fns.length() == 0 {
              sum.unknown = true
            } else {
              for fk in fns {
                ms_add_call_effect(pkg, fk, sum, callees_out, collect_edges)
              }
            }
            None => sum.unknown = true
          }
        }
      }
    }

    // Class 2: Custom `op_get` / `op_set` indexing `x[i]` and Map custom `Hash`/`Eq` key lookup
    if kk == TokenKind::LBracket && i > s {
      let pk = tokens[i - 1].kind
      let is_index = pk == TokenKind::Ident || pk == TokenKind::RParen || pk == TokenKind::RBracket
      if is_index {
        let rty = ms_infer_expr_ty(pkg, tokens, i - 1, content, qfi_opt, local_var_types)
        let rh = ms_type_head(rty)
        if pkg.custom_ops.contains("[]") || pkg.method_overloads.contains("op_get") || pkg.method_overloads.contains("op_set") {
          if !ms_is_unshadowed_builtin_head(pkg, rty, rh, "", active_generics) ||
          !(rh == "Array" || rh == "FixedArray" || rh == "ImmArray" || rh == "Bytes" || rh == "Map" || rh == "OrderedMap" || rh == "ArrayBuf" || rh == "ArrayView") {
            sum.unknown = true
          }
        }
        if ms_is_unshadowed_builtin_head(pkg, rty, rh, "", active_generics) &&
        (rh == "Map" || rh == "OrderedMap") {
          let kty = ms_extract_map_key_ty(rty)
          if !ms_ty_is_pure_map_key(kty, pkg, active_generics) || !ms_is_proven_pure_map_recv(pkg, tokens, i - 1, local_var_types, pure_map_vars, callables, active_generics) {
            sum.unknown = true
          }
        }
      }
    }

    // Class 6 & 7: Assignments (`=`, `+=`, `-=`, etc.) — not `let` initializers
    if (kk == TokenKind::Eq || kk == TokenKind::AssignOp) && i > s {
      let is_let_init = ms_is_let_eq(tokens, i, s)
      if !is_let_init {
        let lhs_end = i - 1
        let pk = tokens[lhs_end].kind
        if pk == TokenKind::RBracket {
          // Index assignment `arr[idx] = val` or `map[k] = val`
          let lb = find_open_before(tokens, lhs_end, s)
          let base_ty = if lb > s { ms_infer_expr_ty(pkg, tokens, lb - 1, content, qfi_opt, local_var_types) } else { "" }
          let base_head = ms_type_head(base_ty)
          let base_unshadowed = ms_is_unshadowed_builtin_head(pkg, base_ty, base_head, "", active_generics)
          if base_unshadowed && (base_head == "Map" || base_head == "OrderedMap") {
            let kty = ms_extract_map_key_ty(base_ty)
            if !ms_ty_is_pure_map_key(kty, pkg, active_generics) || !ms_is_proven_pure_map_recv(pkg, tokens, lb - 1, local_var_types, pure_map_vars, callables, active_generics) {
              sum.unknown = true
            }
            let nested = ms_extract_nested_array_elem_ty(base_ty)
            if nested.length() > 0 || str_has(base_ty, "Array") {
              ms_record_array_mutation(sum, nested, active_generics, pkg.declared_types)
            }
          } else if base_unshadowed && base_head == "Bytes" {
            ()
          } else {
            let elem = ms_extract_array_elem_ty(base_ty)
            ms_record_array_mutation(sum, elem, active_generics, pkg.declared_types)
          }
        } else if pk == TokenKind::Ident && lhs_end >= s + 2 && tokens[lhs_end - 1].kind == TokenKind::Dot {
          // Field write `obj.field = val` (including `self.items = []` and `cell.v = ...`)
          let fname = tokens[lhs_end].raw
          let fty = ms_infer_expr_ty(pkg, tokens, lhs_end, content, qfi_opt, local_var_types)
          let base_ty = ms_infer_expr_ty(pkg, tokens, lhs_end - 2, content, qfi_opt, local_var_types)
          let base_head = ms_type_head(base_ty)
          if fname == "v" || fname == "val" {
            if base_head == "Ref" || base_head == "MbtCell" || base_ty.length() == 0 {
              let nested = ms_extract_nested_array_elem_ty(base_ty)
              if nested.length() > 0 || str_has(base_ty, "Array") || base_ty.length() == 0 {
                ms_record_array_mutation(sum, nested, active_generics, pkg.declared_types)
              }
            }
          }
          if fty.length() > 0 {
            let elem = ms_extract_nested_array_elem_ty(fty)
            if elem.length() > 0 || str_has(fty, "Array") {
              ms_record_array_mutation(sum, elem, active_generics, pkg.declared_types)
            }
          } else {
            match pkg.field_types.get(fname) {
              Some(ft) =>
              if ft == "__AMBIG__" || str_has(ft, "Array") {
                let elem = ms_extract_nested_array_elem_ty(ft)
                ms_record_array_mutation(sum, elem, active_generics, pkg.declared_types)
              }
              None => ()
            }
          }
        } else if pk == TokenKind::Ident {
          if kk == TokenKind::Eq && ms_is_named_call_arg_eq(tokens, lhs_end, s) {
            ()
          } else {
            // Variable reassignment `xs = ...`: fail-closed when LHS type is unknown
            let vty = ms_infer_expr_ty(pkg, tokens, lhs_end, content, qfi_opt, local_var_types)
            if vty.length() == 0 {
              sum.mutates_any_array = true
              sum.unknown = true
            } else if str_has(vty, "Array") || ms_extract_nested_array_elem_ty(vty).length() > 0 {
              let elem = ms_extract_nested_array_elem_ty(vty)
              ms_record_array_mutation(sum, elem, active_generics, pkg.declared_types)
            }
          }
        }
      }
    }

    // Calls: `callee(...)` where `tokens[i + 1]` is `(` (same line)
    if i + 1 < e && tokens[i + 1].kind == TokenKind::LParen && !tokens[i + 1].newline_before {
      let lp = i + 1
      let rp = find_matching_delim(tokens, lp)
      // Class 3: Indirect calls `(expr)(...)`, `b.1(...)`, `arr[i](...)`, `{ ... }(...)`
      if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace || kk == TokenKind::IntLit {
        sum.unknown = true
      } else if (kk == TokenKind::Ident || kk == TokenKind::UpperIdent) && !is_call_keyword(tk.raw) &&
      !(i > s && tokens[i - 1].raw == "fn") {
        let prev_dot = i > s && tokens[i - 1].kind == TokenKind::Dot
        let prev_cc = i > s && tokens[i - 1].kind == TokenKind::ColonColon
        if prev_dot {
          // Method call `recv.m(args...)`
          let m = tk.raw
          let recv_end = i - 2
          let recv_ty = ms_infer_expr_ty(pkg, tokens, recv_end, content, qfi_opt, local_var_types)
          let recv_head = ms_type_head(recv_ty)
          // Class 1: `dyn Trait` or generic type parameter receiver -> fail-closed!
          if ms_ty_is_dyn(recv_ty) || (recv_ty.length() > 0 && active_generics.contains(recv_ty.trim())) {
            sum.unknown = true
          } else if pkg.fn_typed_fields.contains(m) && !pkg.method_overloads.contains(m) {
            // Class 3: calling a function-typed struct field `s.cb(...)`
            sum.unknown = true
          } else if ms_is_array_mutating_method(m) || (m == "add" && recv_head == "OrderedSet") {
            let is_builtin_mut_container = ms_is_unshadowed_builtin_head(pkg, recv_ty, recv_head, m, active_generics) &&
            (recv_head == "Array" || recv_head == "FixedArray" ||
              recv_head == "ArrayBuf" || recv_head == "ArrayView" || recv_head == "Map" ||
              recv_head == "OrderedMap" || recv_head == "OrderedSet" || recv_head == "StringBuilder")
            if is_builtin_mut_container {
              // Class 7: mutating built-in container method
              if ms_is_shrink_method(m) {
                sum.reaches_shrink = true
              }
              if recv_head == "Map" || recv_head == "OrderedMap" || recv_head == "OrderedSet" {
                // Map::set / Map::remove / Map::clear: check if value holds Array or key/instance callbacks could mutate
                let kty = ms_extract_map_key_ty(recv_ty)
                if m != "clear" && (!ms_ty_is_pure_map_key(kty, pkg, active_generics) || !ms_is_proven_pure_map_recv(pkg, tokens, recv_end, local_var_types, pure_map_vars, callables, active_generics)) {
                  sum.unknown = true
                }
                let nested = ms_extract_nested_array_elem_ty(recv_ty)
                if nested.length() > 0 || str_has(recv_ty, "Array") {
                  ms_record_array_mutation(sum, nested, active_generics, pkg.declared_types)
                }
              } else if recv_head == "StringBuilder" {
                ()
              } else {
                let elem = ms_extract_array_elem_ty(recv_ty)
                ms_record_array_mutation(sum, elem, active_generics, pkg.declared_types)
              }
              // If this mutating method takes a callback (`retain`, `sort_by`, `sort_by_key`, `map_in_place`),
              // also analyze its callback argument!
              if m == "retain" || m == "sort_by" || m == "sort_by_key" || m == "map_in_place" {
                let cargs = ms_split_call_args(tokens, lp, rp)
                if cargs.length() >= 1 {
                  let last_a = cargs[cargs.length() - 1]
                  ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, ms_extract_array_elem_ty(recv_ty), sum, callees_out, collect_edges, depth + 1)
                }
              }
            } else if recv_head.length() > 0 {
              // User-defined or external type method named `clear`/`push`/`set`/...:
              // resolve via method call so `reaches_shrink` / `unknown` propagate!
              ms_resolve_method_call(pkg, m, recv_ty, recv_head, active_generics, sum, callees_out, collect_edges)
            } else {
              // Unknown receiver type: fail-closed on both mutation and unknown!
              if ms_is_shrink_method(m) {
                sum.reaches_shrink = true
              }
              sum.mutates_any_array = true
              sum.unknown = true
            }
          } else if m == "map" || m == "mapi" || m == "filter" || m == "filter_map" ||
          m == "each" || m == "eachi" || m == "fold" || m == "any" || m == "all" ||
          m == "find_first" || m == "search_by" || m == "map_or" || m == "bind" {
            // Higher-order read-only method on built-in containers / fresh iterators:
            // never exempt user-declared types, overridden methods, or opaque/adapted iterators!
            let is_iter_recv = recv_head == "MbtIter" || recv_head == "Iter"
            let is_direct_container_recv = recv_head == "Array" || recv_head == "FixedArray" ||
            recv_head == "ArrayView" || recv_head == "ArrayBuf" ||
            recv_head == "Option" || recv_head == "Result"
            let not_user_override = !pkg.trait_methods.contains(m) &&
            ms_is_unshadowed_builtin_head(pkg, recv_ty, recv_head, m, active_generics)
            let is_known_builtin_recv = not_user_override && (
              is_direct_container_recv ||
              (is_iter_recv && ms_is_fresh_builtin_iter_expr(pkg, tokens, recv_end, content, qfi_opt, local_var_types, active_generics))
            )
            if !is_known_builtin_recv {
              if is_iter_recv && !pkg.declared_types.contains(recv_head) && !pkg.fn_keys.contains(recv_head + "::" + m) {
                // Opaque/adapted `Iter`/`MbtIter` (param, local, field, call result, lazy chain) -> fail-closed!
                sum.unknown = true
              } else {
                ms_resolve_method_call(pkg, m, recv_ty, recv_head, active_generics, sum, callees_out, collect_edges)
              }
            } else {
              let cargs = ms_split_call_args(tokens, lp, rp)
              if cargs.length() >= 1 {
                let last_a = cargs[cargs.length() - 1]
                ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, ms_extract_hof_elem_ty(recv_ty), sum, callees_out, collect_edges, depth + 1)
              } else {
                sum.unknown = true
              }
            }
          } else if m == "contains" || m == "search" {
            // `String::contains` / `Bytes::contains` never invoke user `Eq`; `Array`/`Map`/`Set` check element/key Eq & Hash purity + instance provenance!
            let is_unqualified_builtin = ms_is_unshadowed_builtin_head(pkg, recv_ty, recv_head, m, active_generics)
            if is_unqualified_builtin && (recv_head == "String" || recv_head == "StrView" || recv_head == "StringView" || recv_head == "Bytes") {
              ()
            } else if is_unqualified_builtin && (recv_head == "Array" || recv_head == "FixedArray" || recv_head == "ArrayBuf" || recv_head == "ArrayView") {
              let elem = ms_extract_array_elem_ty(recv_ty)
              if pkg.custom_ops.contains("==") && !ms_ty_is_pure_eq(elem, pkg.pure_eq_types, active_generics) {
                sum.unknown = true
              }
            } else if is_unqualified_builtin && (recv_head == "Map" || recv_head == "OrderedMap" || recv_head == "OrderedSet") {
              let kty = ms_extract_map_key_ty(recv_ty)
              if !ms_ty_is_pure_map_key(kty, pkg, active_generics) || !ms_is_proven_pure_map_recv(pkg, tokens, recv_end, local_var_types, pure_map_vars, callables, active_generics) {
                sum.unknown = true
              }
            } else {
              ms_resolve_method_call(pkg, m, recv_ty, recv_head, active_generics, sum, callees_out, collect_edges)
            }
          } else if ms_is_derive_method(m) {
            if ms_is_qualified_external_ty(recv_ty) || pkg.using_types.contains(recv_head) ||
            pkg.declared_traits.contains(recv_head) || active_generics.contains(recv_head) {
              sum.unknown = true
            } else if ms_is_builtin_scalar_ty(recv_ty) ||
            (m == "equal" && ms_ty_is_pure_eq(recv_ty, pkg.pure_eq_types, active_generics) && !pkg.fn_keys.contains(recv_head + "::" + m)) {
              ()
            } else if recv_head.length() > 0 && pkg.fn_keys.contains(recv_head + "::" + m) {
              ms_add_call_effect(pkg, recv_head + "::" + m, sum, callees_out, collect_edges)
            } else {
              // Class 1: derive-generated or external Show/Compare/Eq/Hash method -> fail-closed!
              sum.unknown = true
            }
          } else if ms_is_pure_builtin_method(m) &&
          ms_is_unshadowed_builtin_head(pkg, recv_ty, recv_head, m, active_generics) &&
          (ms_is_builtin_scalar_ty(recv_ty) ||
            ms_is_builtin_container_head(recv_head) ||
            ((recv_head == "MbtIter" || recv_head == "Iter") &&
              ms_is_fresh_builtin_iter_expr(pkg, tokens, recv_end, content, qfi_opt, local_var_types, active_generics))) {
            if ((m == "get" || m == "contains_key") && (recv_head == "Map" || recv_head == "OrderedMap")) ||
            (m == "copy" && recv_head == "OrderedSet") {
              let kty = ms_extract_map_key_ty(recv_ty)
              if !ms_ty_is_pure_map_key(kty, pkg, active_generics) || !ms_is_proven_pure_map_recv(pkg, tokens, recv_end, local_var_types, pure_map_vars, callables, active_generics) {
                sum.unknown = true
              }
            } else if m == "size" && !(recv_head == "Map" || recv_head == "OrderedMap" || recv_head == "OrderedSet") {
              sum.unknown = true
            }
          } else {
            ms_resolve_method_call(pkg, m, recv_ty, recv_head, active_generics, sum, callees_out, collect_edges)
          }
        } else if prev_cc {
          // Qualified call `Q::name(args...)`
          let q = if i >= s + 2 { tokens[i - 2].raw } else { "" }
          let name = tk.raw
          let has_pkg_prefix = i >= s + 3 &&
          (tokens[i - 3].kind == TokenKind::Dot || tokens[i - 3].kind == TokenKind::ColonColon)
          let is_external_pkg_prefix = has_pkg_prefix
          let is_builtin_q_unshadowed = !is_external_pkg_prefix &&
          ms_is_unshadowed_builtin_head(pkg, q, q, name, active_generics)
          if is_external_pkg_prefix {
            if is_ctor_name(name) {
              // Qualified enum constructor `dep::Enum::Variant(...)`
              ()
            } else {
              // Cross-package static call `@dep.Iter::any(...)` / `dep::Foo::bar(...)` -> fail-closed!
              sum.unknown = true
            }
          } else if active_generics.contains(q) || pkg.declared_traits.contains(q) {
            sum.unknown = true
          } else if pkg.using_types.contains(q) {
            if !is_ctor_name(name) {
              sum.unknown = true
            }
          } else if q == "mbt_compat" {
            if ms_is_mbt_compat_arr_mutating(name) {
              if ms_is_shrink_method(name) {
                sum.reaches_shrink = true
              }
              let cargs = ms_split_call_args(tokens, lp, rp)
              let elem = if cargs.length() >= 1 {
                let a0_ty = ms_infer_expr_ty(pkg, tokens, cargs[0].1 - 1, content, qfi_opt, local_var_types)
                ms_extract_array_elem_ty(a0_ty)
              } else {
                ""
              }
              ms_record_array_mutation(sum, elem, active_generics, pkg.declared_types)
              if name == "arr_retain" || name == "arr_sort_by" || name == "arr_sort_by_key" || name == "arr_map_in_place" {
                if cargs.length() >= 2 {
                  let last_a = cargs[cargs.length() - 1]
                  ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, elem, sum, callees_out, collect_edges, depth + 1)
                }
              }
            } else if ms_is_mbt_compat_pure_ro(name) {
              ()
            } else if name == "arr_search" || name == "arr_contains" {
              let cargs = ms_split_call_args(tokens, lp, rp)
              let elem = if cargs.length() >= 1 {
                ms_extract_array_elem_ty(ms_infer_expr_ty(pkg, tokens, cargs[0].1 - 1, content, qfi_opt, local_var_types))
              } else {
                ""
              }
              if pkg.custom_ops.contains("==") && !ms_ty_is_pure_eq(elem, pkg.pure_eq_types, active_generics) {
                sum.unknown = true
              }
            } else if name == "arr_iter" || name == "fixed_array_iter" || name == "array_view_iter" || name == "str_iter" || name == "ordered_map_iter_lazy" || name == "ordered_map_keys_iter" {
              ()
            } else if ms_is_mbt_compat_hof_ro(name) {
              let cargs = ms_split_call_args(tokens, lp, rp)
              let elem = if cargs.length() >= 1 {
                ms_extract_array_elem_ty(ms_infer_expr_ty(pkg, tokens, cargs[0].1 - 1, content, qfi_opt, local_var_types))
              } else {
                ""
              }
              if cargs.length() >= 2 {
                let last_a = cargs[cargs.length() - 1]
                ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, elem, sum, callees_out, collect_edges, depth + 1)
              }
            } else if name == "ordered_map_new" || name == "ordered_map_new_cap" ||
            name == "ordered_map_new_pair" || name == "ordered_map_new_cap_pair" ||
            name == "ordered_map_new_triple" || name == "ordered_map_new_cap_triple" ||
            name == "ordered_set_new" {
              ()
            } else if name == "ordered_map_from_array" || name == "ordered_map_from_array_cap" ||
            name == "ordered_map_from_array_pair" || name == "ordered_map_from_array_cap_pair" ||
            name == "ordered_map_from_array_triple" || name == "ordered_map_from_array_cap_triple" ||
            name == "ordered_set_from_array" {
              let is_pairs = name != "ordered_set_from_array"
              if (pkg.custom_ops.contains("hash") || pkg.custom_ops.contains("==")) &&
              !ms_infer_map_ctor_keys_pure(pkg, tokens, lp, rp, is_pairs, content, qfi_opt, local_var_types, active_generics) {
                sum.unknown = true
              }
            } else {
              // Unknown `mbt_compat::*` helper -> fail-closed
              sum.unknown = true
            }
          } else if is_builtin_q_unshadowed && (q == "Array" || q == "FixedArray" || q == "ArrayBuf" || q == "ArrayView") {
            // Class 7: UFCS `Array::push(xs, v)` / `FixedArray::set(xs, 0, v)` / `FixedArray::makei(...)` etc.
            if ms_is_array_mutating_method(name) {
              if ms_is_shrink_method(name) {
                sum.reaches_shrink = true
              }
              let cargs = ms_split_call_args(tokens, lp, rp)
              let elem = if cargs.length() >= 1 {
                ms_extract_array_elem_ty(ms_infer_expr_ty(pkg, tokens, cargs[0].1 - 1, content, qfi_opt, local_var_types))
              } else {
                ""
              }
              ms_record_array_mutation(sum, elem, active_generics, pkg.declared_types)
              if name == "retain" || name == "sort_by" || name == "sort_by_key" || name == "map_in_place" {
                if cargs.length() >= 2 {
                  let last_a = cargs[cargs.length() - 1]
                  ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, elem, sum, callees_out, collect_edges, depth + 1)
                }
              }
            } else if name == "makei" {
              let cargs = ms_split_call_args(tokens, lp, rp)
              if cargs.length() >= 2 {
                let last_a = cargs[cargs.length() - 1]
                ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, "Int", sum, callees_out, collect_edges, depth + 1)
              } else {
                sum.unknown = true
              }
            } else if name == "new" || name == "make" || name == "with_capacity" || name == "from_array" ||
            ms_is_pure_builtin_method(name) {
              ()
            } else {
              sum.unknown = true
            }
          } else if is_builtin_q_unshadowed && (q == "Map" || q == "OrderedMap" || q == "OrderedSet") {
            if name == "new" || name == "size" || name == "length" || name == "is_empty" {
              ()
            } else if name == "from_array" || name == "of" {
              let is_pairs = q != "OrderedSet"
              if (pkg.custom_ops.contains("hash") || pkg.custom_ops.contains("==")) &&
              !ms_infer_map_ctor_keys_pure(pkg, tokens, lp, rp, is_pairs, content, qfi_opt, local_var_types, active_generics) {
                sum.unknown = true
              }
            } else if ms_is_array_mutating_method(name) {
              let cargs = ms_split_call_args(tokens, lp, rp)
              let a0_ty = if cargs.length() >= 1 {
                ms_infer_expr_ty(pkg, tokens, cargs[0].1 - 1, content, qfi_opt, local_var_types)
              } else {
                ""
              }
              if a0_ty.length() == 0 {
                sum.mutates_any_array = true
                sum.unknown = true
              } else {
                if name != "clear" {
                  let kty = ms_extract_map_key_ty(a0_ty)
                  if !ms_ty_is_pure_map_key(kty, pkg, active_generics) || !ms_is_proven_pure_map_recv(pkg, tokens, cargs[0].1 - 1, local_var_types, pure_map_vars, callables, active_generics) {
                    sum.unknown = true
                  }
                }
                if str_has(a0_ty, "Array") || ms_extract_nested_array_elem_ty(a0_ty).length() > 0 {
                  ms_record_array_mutation(sum, ms_extract_nested_array_elem_ty(a0_ty), active_generics, pkg.declared_types)
                }
              }
            } else {
              sum.unknown = true
            }
          } else if is_builtin_q_unshadowed && (q == "Option" || q == "Result") {
            if name == "map" || name == "map_or" || name == "bind" || name == "map_err" {
              let cargs = ms_split_call_args(tokens, lp, rp)
              if cargs.length() >= 2 {
                let last_a = cargs[cargs.length() - 1]
                ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, "", sum, callees_out, collect_edges, depth + 1)
              } else {
                sum.unknown = true
              }
            } else if name == "Some" || name == "None" || name == "Ok" || name == "Err" ||
            name == "unwrap" || name == "unwrap_or" || name == "is_some" || name == "is_none" ||
            name == "is_ok" || name == "is_err" {
              ()
            } else {
              sum.unknown = true
            }
          } else if is_builtin_q_unshadowed && q == "Bytes" {
            if name == "makei" {
              let cargs = ms_split_call_args(tokens, lp, rp)
              if cargs.length() >= 2 {
                let last_a = cargs[cargs.length() - 1]
                ms_analyze_callback_arg_into(pkg, tokens, last_a.0, last_a.1, fn_body_open, content, qfi_opt, local_var_types, pure_map_vars, callables, active_generics, "Int", sum, callees_out, collect_edges, depth + 1)
              } else {
                sum.unknown = true
              }
            } else if name == "new" || name == "make" || name == "from_array" || name == "of" ||
            name == "length" || name == "is_empty" || name == "get" {
              ()
            } else {
              sum.unknown = true
            }
          } else if is_builtin_q_unshadowed && ms_is_pure_static_method(q, name) {
            ()
          } else if is_ctor_name(name) {
            // Qualified enum constructor `Enum::Variant(...)`
            ()
          } else if pkg.fn_keys.contains(q + "::" + name) {
            ms_add_call_effect(pkg, q + "::" + name, sum, callees_out, collect_edges)
          } else {
            // Class 4: Cross-package / external call -> fail-closed!
            sum.unknown = true
          }
        } else {
          // Bare call `name(args...)`
          let name = tk.raw
          if is_ctor_name(name) {
            // Enum / tuple-struct constructor `Some(...)`, `Ok(...)`, `MyVariant(...)`
            ()
          } else if callables.contains(name) {
            // Class 3: Calling a parameter / local function value -> fail-closed!
            sum.unknown = true
          } else {
            // Check single-binding immutable local closure literal `let g = fn(...) { ... }`
            let lb = if fn_body_open >= 0 { local_closure_body(tokens, i, name) } else { -1 }
            if lb >= 0 {
              let rb = find_matching_delim(tokens, lb)
              if lb < i && i < rb {
                // Recursive local closure -> fail-closed
                sum.unknown = true
              } else {
                let lc_vt : Map[String, String] = Map()
                for k in local_var_types.keys() {
                  match local_var_types.get(k) {
                    Some(v) => lc_vt[k] = v
                    None => ()
                  }
                }
                let lc_pmv = ms_clone_bool_map(pure_map_vars)
                ms_collect_local_var_types(pkg, tokens, lb + 1, rb, content, qfi_opt, lc_vt, lc_pmv, callables, active_generics)
                let lc_sh : Map[String, Bool] = Map()
                ms_collect_pattern_bound_idents_in_span_ex(tokens, lb + 1, rb, lc_sh, false)
                ms_collect_closure_param_names(tokens, lb + 1, rb, lc_sh)
                ms_mark_shadowed_ambig(lc_vt, lc_sh)
                ms_prune_pure_map_vars(lc_pmv, lc_sh)
                let lc_reass : Map[String, Bool] = Map()
                ms_collect_reassigned_idents(tokens, lb + 1, rb, lc_reass)
                ms_prune_pure_map_vars(lc_pmv, lc_reass)
                ms_scan_span(pkg, tokens, lb + 1, rb, fn_body_open, content, qfi_opt, lc_vt, lc_pmv, callables, active_generics, sum, callees_out, collect_edges, depth + 1)
              }
            } else if local_var_types.contains(name) {
              sum.unknown = true
            } else if pkg.fn_keys.contains(name) {
              ms_add_call_effect(pkg, name, sum, callees_out, collect_edges)
            } else if name == "panic" || name == "abort" ||
            (name == "physical_equal" && !pkg.top_level_bindings.contains(name) && !local_var_types.contains(name)) {
              ()
            } else {
              // Unknown bare function -> fail-closed!
              sum.unknown = true
            }
          }
        }
      }
    }

    i = i + 1
  }
}

fn ms_is_let_eq(tokens : Array[Token], eq_i : Int, lo : Int) -> Bool {
  let mut k = eq_i - 1
  let mut d = 0
  while k >= lo {
    let kk = tokens[k].kind
    if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d + 1 }
    else if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      if d == 0 { return false }
      d = d - 1
    } else if d == 0 {
      if tokens[k].raw == "let" { return true }
      if kk == TokenKind::Semi || tokens[k].newline_before { return false }
    }
    k = k - 1
  }
  false
}

fn ms_add_call_effect(
  pkg : PkgMutationSummary,
  fn_key : String,
  sum : FnMutationSummary,
  callees_out : Array[String],
  collect_edges : Bool,
) -> Unit {
  if collect_edges {
    callees_out.push(fn_key)
  } else {
    match pkg.summaries.get(fn_key) {
      Some(cs) => { let _ = fn_mutation_summary_merge(sum, cs) }
      None => sum.unknown = true
    }
  }
}

fn ms_resolve_method_call(
  pkg : PkgMutationSummary,
  m : String,
  recv_ty : String,
  recv_head : String,
  active_generics : Map[String, Bool],
  sum : FnMutationSummary,
  callees_out : Array[String],
  collect_edges : Bool,
) -> Unit {
  if ms_is_qualified_external_ty(recv_ty) ||
  pkg.using_types.contains(recv_head) ||
  pkg.declared_traits.contains(recv_head) ||
  active_generics.contains(recv_head) {
    sum.unknown = true
    return
  }
  if recv_head.length() == 0 {
    // Unknown receiver type (could be external, generic, or `dyn`) -> strictly fail-closed!
    sum.unknown = true
    return
  }
  if pkg.fn_keys.contains(recv_head + "::" + m) {
    ms_add_call_effect(pkg, recv_head + "::" + m, sum, callees_out, collect_edges)
    return
  }
  if pkg.trait_methods.contains(m) || pkg.dep_methods.contains(m) || pkg.fn_typed_fields.contains(m) {
    sum.unknown = true
    return
  }
  if !pkg.declared_types.contains(recv_head) {
    // Receiver is an external / non-package type -> fail-closed!
    sum.unknown = true
    return
  }
  match pkg.method_overloads.get(m) {
    Some(ov) =>
    if ov.length() == 0 {
      sum.unknown = true
    } else {
      for fk in ov {
        ms_add_call_effect(pkg, fk, sum, callees_out, collect_edges)
      }
    }
    None => sum.unknown = true
  }
}

///| Analyze a callback argument `[arg_s, arg_e)` into `sum` / `callees_out`.
fn ms_analyze_callback_arg_into(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  arg_s : Int,
  arg_e : Int,
  fn_body_open : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  parent_var_types : Map[String, String],
  parent_pure_map_vars : Map[String, Bool],
  callables : Map[String, Bool],
  active_generics : Map[String, Bool],
  elem_ty : String,
  sum : FnMutationSummary,
  callees_out : Array[String],
  collect_edges : Bool,
  depth : Int,
) -> Unit {
  if arg_s >= arg_e {
    sum.unknown = true
    return
  }
  // Case 1: Inline closure literal `fn(p1, p2) [-> R] { body }`
  if tokens[arg_s].raw == "fn" && arg_s + 1 < arg_e && tokens[arg_s + 1].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, arg_s + 1)
    let mut lb = cp + 1
    while lb < arg_e && tokens[lb].kind != TokenKind::LBrace {
      lb = lb + 1
    }
    if lb < arg_e && tokens[lb].kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, lb)
      if rb < arg_e {
        let vt : Map[String, String] = Map()
        for k in parent_var_types.keys() {
          match parent_var_types.get(k) {
            Some(v) => vt[k] = v
            None => ()
          }
        }
        let pmv = ms_clone_bool_map(parent_pure_map_vars)
        // Bind this callback's own parameter types (annotated or inferred from `elem_ty`),
        // overwriting any outer-function `__AMBIG__` mark for its own params.
        let own_ptypes : Map[String, String] = Map()
        ms_parse_fn_params(tokens, arg_s + 1, cp, own_ptypes)
        let pnames = collect_pion_fn_param_names(tokens, arg_s + 1, cp)
        for pn in pnames {
          if pn.length() > 0 && pn != "_" {
            let _ = pmv.remove(pn)
            match own_ptypes.get(pn) {
              Some(pt) => vt[pn] = pt
              None => vt[pn] = "__AMBIG__"
            }
          }
        }
        if elem_ty.length() > 0 && pnames.length() >= 1 {
          let elem_param = pnames[pnames.length() - 1]
          if !own_ptypes.contains(elem_param) && elem_param != "_" {
            vt[elem_param] = elem_ty
          }
        }
        ms_collect_local_var_types(pkg, tokens, lb + 1, rb, content, qfi_opt, vt, pmv, callables, active_generics)
        let inner_sh : Map[String, Bool] = Map()
        ms_collect_pattern_bound_idents_in_span_ex(tokens, lb + 1, rb, inner_sh, false)
        ms_collect_closure_param_names(tokens, lb + 1, rb, inner_sh)
        ms_mark_shadowed_ambig(vt, inner_sh)
        ms_prune_pure_map_vars(pmv, inner_sh)
        let inner_reass : Map[String, Bool] = Map()
        ms_collect_reassigned_idents(tokens, lb + 1, rb, inner_reass)
        ms_prune_pure_map_vars(pmv, inner_reass)
        ms_scan_span(pkg, tokens, lb + 1, rb, fn_body_open, content, qfi_opt, vt, pmv, callables, active_generics, sum, callees_out, collect_edges, depth + 1)
        return
      }
    }
    sum.unknown = true
    return
  }
  // Case 2: Single identifier: local immutable closure literal or top-level package fn
  if arg_e == arg_s + 1 && tokens[arg_s].kind == TokenKind::Ident {
    let nm = tokens[arg_s].raw
    if callables.contains(nm) {
      sum.unknown = true
      return
    }
    let lb = if fn_body_open >= 0 { local_closure_body(tokens, arg_s, nm) } else { -1 }
    if lb >= 0 {
      let rb = find_matching_delim(tokens, lb)
      let lc_vt : Map[String, String] = Map()
      for k in parent_var_types.keys() {
        match parent_var_types.get(k) {
          Some(v) => lc_vt[k] = v
          None => ()
        }
      }
      let lc_pmv = ms_clone_bool_map(parent_pure_map_vars)
      ms_collect_local_var_types(pkg, tokens, lb + 1, rb, content, qfi_opt, lc_vt, lc_pmv, callables, active_generics)
      let lc_sh : Map[String, Bool] = Map()
      ms_collect_pattern_bound_idents_in_span_ex(tokens, lb + 1, rb, lc_sh, false)
      ms_collect_closure_param_names(tokens, lb + 1, rb, lc_sh)
      ms_mark_shadowed_ambig(lc_vt, lc_sh)
      ms_prune_pure_map_vars(lc_pmv, lc_sh)
      let lc_reass : Map[String, Bool] = Map()
      ms_collect_reassigned_idents(tokens, lb + 1, rb, lc_reass)
      ms_prune_pure_map_vars(lc_pmv, lc_reass)
      ms_scan_span(pkg, tokens, lb + 1, rb, fn_body_open, content, qfi_opt, lc_vt, lc_pmv, callables, active_generics, sum, callees_out, collect_edges, depth + 1)
      return
    }
    if parent_var_types.contains(nm) {
      sum.unknown = true
      return
    }
    if pkg.fn_keys.contains(nm) {
      ms_add_call_effect(pkg, nm, sum, callees_out, collect_edges)
      return
    }
    sum.unknown = true
    return
  }
  // Anything else (field closure `s.cb`, array element `cbs[0]`, call result `get_cb()`, etc.) -> fail-closed!
  sum.unknown = true
}

// ---------------------------------------------------------------------------
// Package-wide fixed-point builder
// ---------------------------------------------------------------------------

fn ms_has_derive_eq_hash(ts : Array[Token], decl_i : Int, close_i : Int, limit : Int) -> (Bool, Bool, Bool) {
  let mut has_any_derive = false
  let mut has_eq = false
  let mut has_hash = false
  // 1. Trailing `derive(...)` (MoonBit & Pion syntax)
  if close_i + 2 < limit && ts[close_i + 1].raw == "derive" && ts[close_i + 2].kind == TokenKind::LParen {
    has_any_derive = true
    let rp = find_matching_delim(ts, close_i + 2)
    let mut k = close_i + 3
    while k < rp && k < limit {
      if ts[k].kind == TokenKind::UpperIdent || ts[k].kind == TokenKind::Ident {
        if ts[k].raw == "Eq" { has_eq = true }
        if ts[k].raw == "Hash" { has_hash = true }
      }
      k = k + 1
    }
  }
  // 2. Leading attribute `#[derive(...)]` / `#derive(...)` before visibility keywords
  let mut back = decl_i - 1
  while back >= 0 {
    let bk = ts[back].kind
    if bk == TokenKind::RParen {
      let lp = find_open_before(ts, back, 0)
      if lp > 0 && ts[lp - 1].raw == "pub" {
        back = lp - 2
        continue
      }
      break
    }
    if ts[back].raw == "pub" || ts[back].raw == "priv" {
      back = back - 1
      continue
    }
    if bk == TokenKind::Attr {
      let raw = ts[back].raw
      let di = raw.index_of("derive(")
      if di >= 0 {
        has_any_derive = true
        let atoks = lex_moonbit(raw.slice(di + 7, raw.length()))
        for at in atoks {
          if at.kind == TokenKind::UpperIdent || at.kind == TokenKind::Ident {
            if at.raw == "Eq" { has_eq = true }
            if at.raw == "Hash" { has_hash = true }
          }
        }
      }
      back = back - 1
      continue
    }
    break
  }
  (has_any_derive, has_eq, has_hash)
}

fn ms_record_enum_ctor(pkg : PkgMutationSummary, ctor_name : String, enum_name : String) -> Unit {
  match pkg.enum_ctor_types.get(ctor_name) {
    Some(prev) => if prev != enum_name { pkg.enum_ctor_types[ctor_name] = "__AMBIG__" }
    None => pkg.enum_ctor_types[ctor_name] = enum_name
  }
}

pub fn collect_pkg_mutation_summary_tokens(all_tokens : Array[Array[Token]]) -> PkgMutationSummary {
  collect_pkg_mutation_summary(all_tokens, [], [], empty_pkg_query_types(), Map(), Map())
}

pub fn collect_pkg_mutation_summary(
  all_tokens : Array[Array[Token]],
  rel_paths : Array[String],
  contents : Array[String],
  pkg_qt : PkgQueryTypes,
  dep_methods : Map[String, Bool],
  op_lookup : Map[String, String],
) -> PkgMutationSummary {
  let pkg = PkgMutationSummary::empty()
  for k in dep_methods.keys() {
    pkg.dep_methods[k] = true
    if k == "eq" || k == "equal" || k == "op_equal" {
      pkg.custom_ops["=="] = true
      pkg.custom_ops["!="] = true
      pkg.ext_custom_ops["=="] = true
      pkg.ext_custom_ops["!="] = true
    } else if k == "compare" {
      pkg.custom_ops["<"] = true
      pkg.custom_ops["<="] = true
      pkg.custom_ops[">"] = true
      pkg.custom_ops[">="] = true
      pkg.ext_custom_ops["<"] = true
      pkg.ext_custom_ops["<="] = true
      pkg.ext_custom_ops[">"] = true
      pkg.ext_custom_ops[">="] = true
    } else if k == "output" {
      pkg.custom_ops["Show"] = true
      pkg.ext_custom_ops["Show"] = true
    } else if k == "op_get" || k == "op_set" {
      pkg.custom_ops["[]"] = true
      pkg.ext_custom_ops["[]"] = true
    } else if k == "hash" || k == "hash_combine" {
      pkg.custom_ops["hash"] = true
      pkg.ext_custom_ops["hash"] = true
    }
  }
  for k in op_lookup.keys() {
    let bar = k.index_of("|")
    if bar > 0 {
      let op_name = k.slice(bar + 1, k.length())
      let sym = ms_op_name_to_symbol(op_name)
      if sym.length() > 0 {
        let helper = match op_lookup.get(k) { Some(v) => v, None => "" }
        if str_has(helper, "::") {
          pkg.custom_ops[sym] = true
          pkg.ext_custom_ops[sym] = true
        } else {
          ms_add_op_impl_fn(pkg, sym, helper)
        }
      }
    }
  }

  let decls : Array[MsFnDecl] = []
  let derive_eq_field_types : Map[String, Array[String]] = Map()
  let derive_eq_invalid : Map[String, Bool] = Map()
  let derive_hash_field_types : Map[String, Array[String]] = Map()
  let derive_hash_invalid : Map[String, Bool] = Map()

  // Pass 1: Collect structs/enums/fields/traits/derives/impls and top-level fn declarations.
  let mut fi = 0
  while fi < all_tokens.length() {
    let ts = all_tokens[fi]
    let n = ts.length() - 1
    let mut depth = 0
    let mut i = 0
    while i < n {
      let tk = ts[i]
      let kk = tk.kind
      if kk == TokenKind::LBrace || kk == TokenKind::LParen || kk == TokenKind::LBracket {
        depth = depth + 1
        i = i + 1
        continue
      }
      if kk == TokenKind::RBrace || kk == TokenKind::RParen || kk == TokenKind::RBracket {
        if depth > 0 { depth = depth - 1 }
        i = i + 1
        continue
      }
      if depth != 0 {
        i = i + 1
        continue
      }
      // `struct Name` / `enum Name` / `type Name`
      if (tk.raw == "struct" || tk.raw == "enum" || tk.raw == "type") && i + 1 < n &&
      (ts[i + 1].kind == TokenKind::UpperIdent || ts[i + 1].kind == TokenKind::Ident) {
        let tname = ts[i + 1].raw
        pkg.declared_types[tname] = true
        let is_generic_ty = i + 2 < n && ts[i + 2].kind == TokenKind::LBracket
        if is_generic_ty {
          derive_eq_invalid[tname] = true
          derive_hash_invalid[tname] = true
        }
        if tk.raw == "struct" {
          let mut o = i + 2
          while o < n && ts[o].kind != TokenKind::LBrace && ts[o].kind != TokenKind::LParen && !ts[o].newline_before {
            o = o + 1
          }
          if o < n && ts[o].kind == TokenKind::LBrace {
            let close = find_matching_delim(ts, o)
            let s_ftys : Array[String] = []
            let mut all_fields_ok = true
            let mut k = o + 1
            let mut fd = 0
            while k < close {
              let fk = ts[k].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
              else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { if fd > 0 { fd = fd - 1 } }
              else if fd == 0 && fk == TokenKind::Ident && k + 2 < close && ts[k + 1].kind == TokenKind::Colon &&
              (k == o + 1 || ts[k].newline_before || ts[k - 1].raw == "mut" || ts[k - 1].raw == "pub" || ts[k - 1].raw == "priv" || ts[k - 1].kind == TokenKind::Comma || ts[k - 1].kind == TokenKind::Semi) {
                let fname = ts[k].raw
                let mut fe = k + 2
                let mut ftd = 0
                while fe < close {
                  let ftk = ts[fe].kind
                  if ftk == TokenKind::LParen || ftk == TokenKind::LBracket || ftk == TokenKind::LBrace { ftd = ftd + 1 }
                  else if ftk == TokenKind::RParen || ftk == TokenKind::RBracket || ftk == TokenKind::RBrace { if ftd > 0 { ftd = ftd - 1 } }
                  else if ftd == 0 && (ftk == TokenKind::Comma || ftk == TokenKind::Semi || ts[fe].newline_before) { break }
                  fe = fe + 1
                }
                let ty_s = ms_join_token_slice(ts, k + 2, fe)
                if ty_s.length() > 0 {
                  ms_record_field_type(pkg, tname, fname, ty_s)
                  s_ftys.push(ty_s)
                } else {
                  all_fields_ok = false
                }
                k = fe
                continue
              } else if fd == 0 && fk != TokenKind::Comma && fk != TokenKind::Semi &&
              ts[k].raw != "mut" && ts[k].raw != "pub" && ts[k].raw != "priv" {
                all_fields_ok = false
              }
              k = k + 1
            }
            let (has_drv, has_eq, has_hash) = ms_has_derive_eq_hash(ts, i, close, n)
            if has_drv {
              pkg.derived_types[tname] = true
            }
            if !is_generic_ty && has_eq && all_fields_ok {
              if derive_eq_field_types.contains(tname) {
                derive_eq_invalid[tname] = true
              } else {
                derive_eq_field_types[tname] = s_ftys
              }
            }
            if !is_generic_ty && has_hash && all_fields_ok {
              if derive_hash_field_types.contains(tname) {
                derive_hash_invalid[tname] = true
              } else {
                derive_hash_field_types[tname] = s_ftys
              }
            }
            i = close + 1
            continue
          } else if o < n && ts[o].kind == TokenKind::LParen {
            let close = find_matching_delim(ts, o)
            let p_args = ms_split_call_args(ts, o, close)
            let s_ftys : Array[String] = []
            let mut all_fields_ok = true
            for pa in p_args {
              let mut ps = pa.0
              if ps < pa.1 && (ts[ps].raw == "pub" || ts[ps].raw == "priv") { ps = ps + 1 }
              if ps < pa.1 && ts[ps].raw == "mut" { ps = ps + 1 }
              let ty_s = ms_join_token_slice(ts, ps, pa.1)
              if ty_s.length() > 0 { s_ftys.push(ty_s) } else { all_fields_ok = false }
            }
            let (has_drv, has_eq, has_hash) = ms_has_derive_eq_hash(ts, i, close, n)
            if has_drv {
              pkg.derived_types[tname] = true
            }
            if !is_generic_ty && has_eq && all_fields_ok {
              if derive_eq_field_types.contains(tname) {
                derive_eq_invalid[tname] = true
              } else {
                derive_eq_field_types[tname] = s_ftys
              }
            }
            if !is_generic_ty && has_hash && all_fields_ok {
              if derive_hash_field_types.contains(tname) {
                derive_hash_invalid[tname] = true
              } else {
                derive_hash_field_types[tname] = s_ftys
              }
            }
            i = close + 1
            continue
          }
        } else if tk.raw == "enum" {
          let mut o = i + 2
          while o < n && ts[o].kind != TokenKind::LBrace && !ts[o].newline_before {
            o = o + 1
          }
          if o < n && ts[o].kind == TokenKind::LBrace {
            let close = find_matching_delim(ts, o)
            let e_ftys : Array[String] = []
            let mut all_vars_ok = true
            let mut k = o + 1
            while k < close {
              let fk = ts[k].kind
              if fk == TokenKind::Comma || fk == TokenKind::Semi {
                k = k + 1
                continue
              }
              if fk == TokenKind::UpperIdent {
                ms_record_enum_ctor(pkg, ts[k].raw, tname)
                let mut nxt = k + 1
                if nxt < close && ts[nxt].kind == TokenKind::LParen && !ts[nxt].newline_before {
                  let vrp = find_matching_delim(ts, nxt)
                  let vargs = ms_split_call_args(ts, nxt, vrp)
                  for va in vargs {
                    let mut vs = va.0
                    let ve = va.1
                    if vs < ve && ts[vs].raw == "mut" { vs = vs + 1 }
                    // Strip optional `label~ : ` / `label? : ` / `label : `
                    let mut ci = -1
                    let mut sc = vs
                    let mut vd = 0
                    while sc < ve {
                      let sck = ts[sc].kind
                      if sck == TokenKind::LParen || sck == TokenKind::LBracket || sck == TokenKind::LBrace { vd = vd + 1 }
                      else if sck == TokenKind::RParen || sck == TokenKind::RBracket || sck == TokenKind::RBrace { if vd > 0 { vd = vd - 1 } }
                      else if vd == 0 && sck == TokenKind::Colon { ci = sc; break }
                      sc = sc + 1
                    }
                    let ty_s = if ci >= vs {
                      ms_join_token_slice(ts, ci + 1, ve)
                    } else {
                      ms_join_token_slice(ts, vs, ve)
                    }
                    if ty_s.length() > 0 { e_ftys.push(ty_s) } else { all_vars_ok = false }
                  }
                  nxt = vrp + 1
                } else if nxt < close && ts[nxt].kind == TokenKind::Eq {
                  // C-like enum discriminant `Variant = 0`
                  nxt = nxt + 1
                  while nxt < close && ts[nxt].kind != TokenKind::Comma && ts[nxt].kind != TokenKind::Semi && !ts[nxt].newline_before {
                    nxt = nxt + 1
                  }
                }
                k = nxt
                continue
              }
              all_vars_ok = false
              k = k + 1
            }
            let (has_drv, has_eq, has_hash) = ms_has_derive_eq_hash(ts, i, close, n)
            if has_drv {
              pkg.derived_types[tname] = true
            }
            if !is_generic_ty && has_eq && all_vars_ok {
              if derive_eq_field_types.contains(tname) {
                derive_eq_invalid[tname] = true
              } else {
                derive_eq_field_types[tname] = e_ftys
              }
            }
            if !is_generic_ty && has_hash && all_vars_ok {
              if derive_hash_field_types.contains(tname) {
                derive_hash_invalid[tname] = true
              } else {
                derive_hash_field_types[tname] = e_ftys
              }
            }
            i = close + 1
            continue
          }
        }
      }
      // `trait Name { ... }`
      if tk.raw == "trait" && i + 1 < n && (ts[i + 1].kind == TokenKind::UpperIdent || ts[i + 1].kind == TokenKind::Ident) {
        pkg.declared_traits[ts[i + 1].raw] = true
        let mut o = i + 2
        while o < n && ts[o].kind != TokenKind::LBrace { o = o + 1 }
        if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          let mut k = o + 1
          while k + 1 < close {
            if ts[k].kind == TokenKind::Ident && ts[k + 1].kind == TokenKind::LParen {
              pkg.trait_methods[ts[k].raw] = true
            }
            k = k + 1
          }
          i = close + 1
          continue
        }
      }
      // `impl Trait for Type with m(...) { ... }` or `impl[T] @pkg.Trait for Type[T] { fn ... }`
      if tk.raw == "impl" && i + 1 < n {
        let mut o = i + 1
        let mut trait_nm = ""
        let mut target_ty = ""
        let mut saw_for = false
        let mut with_i = -1
        let impl_generics : Map[String, Bool] = Map()
        while o < n && ts[o].kind != TokenKind::LBrace {
          if ts[o].kind == TokenKind::LBracket {
            if !saw_for && trait_nm.length() == 0 {
              o = ms_parse_generic_params(ts, o, impl_generics) + 1
            } else {
              let cb = find_matching_delim(ts, o)
              o = if cb > o { cb + 1 } else { o + 1 }
            }
            continue
          }
          if ts[o].raw == "with" && with_i < 0 {
            with_i = o
            break
          }
          if ts[o].raw == "for" {
            saw_for = true
          } else if !saw_for && (ts[o].kind == TokenKind::UpperIdent || ts[o].kind == TokenKind::Ident) {
            // Keep last path segment (e.g. `@builtin.Eq` or `pkg::Eq` -> `"Eq"`)
            trait_nm = ts[o].raw
          } else if saw_for && (ts[o].kind == TokenKind::UpperIdent || ts[o].kind == TokenKind::Ident) && target_ty.length() == 0 {
            target_ty = ts[o].raw
          }
          o = o + 1
        }
        let op_syms = ms_op_trait_to_symbols(trait_nm)
        for sym in op_syms {
          pkg.custom_ops[sym] = true
        }
        if trait_nm == "Eq" && target_ty.length() > 0 {
          pkg.custom_eq_types[target_ty] = true
        }
        if trait_nm == "Hash" && target_ty.length() > 0 {
          pkg.custom_hash_types[target_ty] = true
        }
        if with_i > 0 {
          let (next_i, decl_opt) = ms_parse_fn_decl(pkg, ts, with_i, n, fi, target_ty)
          match decl_opt {
            Some(dc) => {
              if impl_generics.length() > 0 {
                let fg = match pkg.fn_generics.get(dc.key) {
                  Some(m) => m
                  None => Map()
                }
                for gk in impl_generics.keys() {
                  fg[gk] = true
                }
                pkg.fn_generics[dc.key] = fg
              }
              decls.push(dc)
              for sym in op_syms {
                ms_add_op_impl_fn(pkg, sym, dc.key)
              }
              if dc.bare_name == "op_get" || dc.bare_name == "op_set" {
                ms_add_op_impl_fn(pkg, "[]", dc.key)
              }
              i = next_i
              continue
            }
            None => {
              for sym in op_syms {
                pkg.ext_custom_ops[sym] = true
              }
            }
          }
        } else if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          let mut parsed_any = false
          let mut k = o + 1
          let mut id = 0
          while k + 1 < close {
            let kk2 = ts[k].kind
            if kk2 == TokenKind::LBrace { id = id + 1 }
            else if kk2 == TokenKind::RBrace { if id > 0 { id = id - 1 } }
            else if id == 0 && ts[k].raw == "fn" && ts[k + 1].kind != TokenKind::LParen {
              let (next_k, decl_opt) = ms_parse_fn_decl(pkg, ts, k, close, fi, target_ty)
              match decl_opt {
                Some(dc) => {
                  if impl_generics.length() > 0 {
                    let fg = match pkg.fn_generics.get(dc.key) {
                      Some(m) => m
                      None => Map()
                    }
                    for gk in impl_generics.keys() {
                      fg[gk] = true
                    }
                    pkg.fn_generics[dc.key] = fg
                  }
                  parsed_any = true
                  decls.push(dc)
                  for sym in op_syms {
                    ms_add_op_impl_fn(pkg, sym, dc.key)
                  }
                  if dc.bare_name == "op_get" || dc.bare_name == "op_set" {
                    ms_add_op_impl_fn(pkg, "[]", dc.key)
                  }
                }
                None => ()
              }
              k = next_k
              continue
            }
            k = k + 1
          }
          if !parsed_any {
            for sym in op_syms {
              pkg.ext_custom_ops[sym] = true
            }
          }
          i = close + 1
          continue
        } else {
          for sym in op_syms {
            pkg.ext_custom_ops[sym] = true
          }
        }
      }
      // Top-level `let [mut] <pat> = ...` / `const <name> = ...` / `using ... { ... }` bindings
      if (tk.raw == "let" || tk.raw == "const") && i + 1 < n {
        let mut ni = i + 1
        if ni < n && ts[ni].raw == "mut" { ni = ni + 1 }
        if ni < n && ts[ni].kind == TokenKind::Ident &&
        (ni + 1 >= n || ts[ni + 1].kind == TokenKind::Eq || ts[ni + 1].kind == TokenKind::Colon) {
          pkg.top_level_bindings[ts[ni].raw] = true
        } else if ni < n {
          let mut eq_i = ni
          let mut td = 0
          while eq_i < n && !(td == 0 && (ts[eq_i].kind == TokenKind::Eq || ts[eq_i].kind == TokenKind::Semi)) {
            let ek = ts[eq_i].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { td = td + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { if td > 0 { td = td - 1 } }
            eq_i = eq_i + 1
          }
          if eq_i < n && ts[eq_i].kind == TokenKind::Eq {
            ms_add_pat_idents(ts, ni, eq_i, pkg.top_level_bindings)
          }
        }
      }
      if tk.raw == "using" && i + 1 < n {
        let mut lb = i + 1
        while lb < n && ts[lb].kind != TokenKind::LBrace && !ts[lb].newline_before { lb = lb + 1 }
        if lb < n && ts[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(ts, lb)
          let mut k = lb + 1
          while k < rb && k < n {
            if ts[k].kind == TokenKind::Ident && !ms_is_pattern_kw(ts[k].raw) {
              pkg.top_level_bindings[ts[k].raw] = true
            } else if ts[k].kind == TokenKind::UpperIdent {
              pkg.using_types[ts[k].raw] = true
            }
            k = k + 1
          }
          i = rb + 1
          continue
        }
      }
      // Top-level `fn` / `fn[T]` / `fn Type::method`
      if tk.raw == "fn" && i + 1 < n && ts[i + 1].kind != TokenKind::LParen {
        let (next_i, decl_opt) = ms_parse_fn_decl(pkg, ts, i, n, fi, "")
        match decl_opt {
          Some(dc) => {
            decls.push(dc)
            // Detect Stage A operator pre-pass functions `mbt_op_<op>_<Type>` (and legacy `__mbt_op_`)
            if dc.bare_name.starts_with("mbt_op_") || dc.bare_name.starts_with("__mbt_op_") {
              let pfx_len = if dc.bare_name.starts_with("__mbt_op_") { 9 } else { 7 }
              let rest = dc.bare_name.slice(pfx_len, dc.bare_name.length())
              let us = rest.index_of("_")
              if us > 0 {
                let op_nm = rest.slice(0, us)
                let sym = ms_op_name_to_symbol(op_nm)
                if sym.length() > 0 {
                  ms_add_op_impl_fn(pkg, sym, dc.key)
                  if sym == "==" {
                    let t_suf = rest.slice(us + 1, rest.length())
                    if t_suf.length() > 0 {
                      pkg.custom_eq_types[t_suf] = true
                    }
                  }
                }
              }
            }
            if dc.recv_type.length() > 0 && (dc.bare_name == "equal" || dc.bare_name == "op_equal" || dc.bare_name == "eq") {
              pkg.custom_eq_types[dc.recv_type] = true
            }
            if dc.recv_type.length() > 0 && (dc.bare_name == "hash" || dc.bare_name == "hash_combine") {
              pkg.custom_hash_types[dc.recv_type] = true
              pkg.custom_ops["hash"] = true
            }
            if dc.bare_name == "op_get" || dc.bare_name == "op_set" {
              ms_add_op_impl_fn(pkg, "[]", dc.key)
            }
          }
          None => ()
        }
        i = next_i
        continue
      }
      i = i + 1
    }
    fi = fi + 1
  }

  // Fixed-point purity check for local non-generic `derive(Eq)` types without custom `impl Eq`.
  let empty_gen : Map[String, Bool] = Map()
  for tn in derive_eq_field_types.keys() {
    if !derive_eq_invalid.contains(tn) && !pkg.custom_eq_types.contains(tn) {
      pkg.pure_eq_types[tn] = true
    }
  }
  let mut eq_changed = true
  while eq_changed {
    eq_changed = false
    let to_remove : Array[String] = []
    for tn in pkg.pure_eq_types.keys() {
      match derive_eq_field_types.get(tn) {
        Some(ftys) => {
          for fty in ftys {
            if !ms_ty_is_pure_eq(fty, pkg.pure_eq_types, empty_gen) {
              to_remove.push(tn)
              break
            }
          }
        }
        None => to_remove.push(tn)
      }
    }
    for rn in to_remove {
      let _ = pkg.pure_eq_types.remove(rn)
      eq_changed = true
    }
  }

  // Fixed-point purity check for local non-generic `derive(Hash)` types without custom `impl Hash`.
  for tn in derive_hash_field_types.keys() {
    if !derive_hash_invalid.contains(tn) && !pkg.custom_hash_types.contains(tn) {
      pkg.pure_hash_types[tn] = true
    }
  }
  let mut hash_changed = true
  while hash_changed {
    hash_changed = false
    let to_remove : Array[String] = []
    for tn in pkg.pure_hash_types.keys() {
      match derive_hash_field_types.get(tn) {
        Some(ftys) => {
          for fty in ftys {
            if !ms_ty_is_pure_eq(fty, pkg.pure_hash_types, empty_gen) {
              to_remove.push(tn)
              break
            }
          }
        }
        None => to_remove.push(tn)
      }
    }
    for rn in to_remove {
      let _ = pkg.pure_hash_types.remove(rn)
      hash_changed = true
    }
  }

  // Pass 1.5: Compute `pkg.pure_map_ret_fns`: non-generic same-package functions returning unshadowed
  // `Map`/`OrderedMap`/`OrderedSet` whose body has no `new_by` and every return/tail expression is
  // proven to come from an immutable, unshadowed, unreassigned `MapKey`-only constructor local (or call
  // to another `pure_map_ret_fns` helper).
  let mut pm_changed = true
  let mut pm_round = 0
  while pm_changed && pm_round <= decls.length() {
    pm_changed = false
    pm_round = pm_round + 1
    for dc in decls {
      if pkg.pure_map_ret_fns.contains(dc.key) {
        continue
      }
      let active_gen = match pkg.fn_generics.get(dc.key) {
        Some(g) => g
        None => Map()
      }
      if active_gen.length() > 0 {
        continue
      }
      let ret_ty = match pkg.fn_ret_types.get(dc.key) {
        Some(rt) => rt
        None => ""
      }
      let rh = ms_type_head(ret_ty)
      if !((rh == "Map" || rh == "OrderedMap" || rh == "OrderedSet") &&
        !ms_is_qualified_external_ty(ret_ty) &&
        !pkg.declared_types.contains(rh) &&
        !pkg.declared_traits.contains(rh) &&
        !pkg.using_types.contains(rh)) {
        continue
      }
      let ts = all_tokens[dc.file_idx]
      let fcontent = if dc.file_idx < contents.length() { contents[dc.file_idx] } else { "" }
      let qfi_opt : Option[QtFileIndex] = if pkg_qt.ok && dc.file_idx < rel_paths.length() {
        pkg_qt.files.get(rel_paths[dc.file_idx])
      } else {
        None
      }
      let mut has_new_by = false
      let mut scan_i = dc.body_open + 1
      while scan_i < dc.body_close {
        if ts[scan_i].raw == "new_by" {
          has_new_by = true
          break
        }
        scan_i = scan_i + 1
      }
      if has_new_by {
        continue
      }
      let vt : Map[String, String] = Map()
      match pkg.fn_param_types.get(dc.key) {
        Some(pm) => {
          for pk in pm.keys() {
            match pm.get(pk) {
              Some(pv) => vt[pk] = pv
              None => ()
            }
          }
        }
        None => ()
      }
      if dc.recv_type.length() > 0 && !vt.contains("self") {
        vt["self"] = dc.recv_type
      }
      let pm_callables = callable_locals(ts, dc.body_open)
      ms_collect_pattern_bound_idents(ts, dc.body_open, pm_callables)
      let pmv : Map[String, Bool] = Map()
      ms_collect_local_var_types(pkg, ts, dc.body_open + 1, dc.body_close, fcontent, qfi_opt, vt, pmv, pm_callables, active_gen)
      let shadowed : Map[String, Bool] = Map()
      ms_collect_pattern_bound_idents_in_span_ex(ts, dc.body_open + 1, dc.body_close, shadowed, false)
      ms_collect_closure_param_names(ts, dc.body_open + 1, dc.body_close, shadowed)
      ms_prune_pure_map_vars(pmv, shadowed)
      let reass : Map[String, Bool] = Map()
      ms_collect_reassigned_idents(ts, dc.body_open + 1, dc.body_close, reass)
      ms_prune_pure_map_vars(pmv, reass)
      // Verify every `return <expr>` in the function body (skipping nested closures)
      let mut all_ok = true
      let mut k = dc.body_open + 1
      while k < dc.body_close {
        if ts[k].raw == "fn" && k + 1 < dc.body_close && ts[k + 1].kind == TokenKind::LParen {
          let cp = find_matching_delim(ts, k + 1)
          let mut lb = cp + 1
          while lb < dc.body_close && ts[lb].kind != TokenKind::LBrace { lb = lb + 1 }
          if lb < dc.body_close && ts[lb].kind == TokenKind::LBrace {
            let rb = find_matching_delim(ts, lb)
            if rb > lb { k = rb + 1; continue }
          }
        }
        if ts[k].raw == "guard" && (ts[k].kind == TokenKind::Keyword || ts[k].kind == TokenKind::Ident) {
          all_ok = false
          break
        }
        if ts[k].raw == "return" && (ts[k].kind == TokenKind::Keyword || ts[k].kind == TokenKind::Ident) {
          let ret_s = k + 1
          let ret_e = statement_end(ts, ret_s, dc.body_close)
          let ret_cont = ret_e > ret_s && ret_e < dc.body_close && ms_is_expr_continuation_tok(ts[ret_e - 1], ts[ret_e])
          if ret_e <= ret_s || ret_cont || !ms_is_pure_map_value_expr(pkg, ts, ret_s, ret_e, vt, pmv, pm_callables, active_gen) {
            all_ok = false
            break
          }
        }
        k = k + 1
      }
      if !all_ok {
        continue
      }
      // Verify trailing tail expression of the function body
      let mut st = dc.body_open + 1
      let mut last_s = -1
      let mut last_e = -1
      while st < dc.body_close {
        if ts[st].kind == TokenKind::Semi {
          st = st + 1
          continue
        }
        let se = statement_end(ts, st, dc.body_close)
        if se <= st {
          break
        }
        last_s = st
        last_e = se
        st = se
      }
      if last_s < 0 || last_e <= last_s {
        continue
      }
      let last_cont = last_e > last_s && last_e < dc.body_close && ms_is_expr_continuation_tok(ts[last_e - 1], ts[last_e])
      if ts[last_s].raw != "return" && (last_cont || !ms_is_pure_map_value_expr(pkg, ts, last_s, last_e, vt, pmv, pm_callables, active_gen)) {
        continue
      }
      pkg.pure_map_ret_fns[dc.key] = true
      pm_changed = true
    }
  }

  // Pass 2: Compute direct effects and direct call edges for every declared function.
  let edges : Map[String, Array[String]] = Map()
  for dc in decls {
    let ts = all_tokens[dc.file_idx]
    let fcontent = if dc.file_idx < contents.length() { contents[dc.file_idx] } else { "" }
    let qfi_opt : Option[QtFileIndex] = if pkg_qt.ok && dc.file_idx < rel_paths.length() {
      pkg_qt.files.get(rel_paths[dc.file_idx])
    } else {
      None
    }
    let sum = match pkg.summaries.get(dc.key) {
      Some(s) => s
      None => {
        let s = FnMutationSummary::empty()
        pkg.summaries[dc.key] = s
        s
      }
    }
    let callables = callable_locals(ts, dc.body_open)
    ms_collect_pattern_bound_idents(ts, dc.body_open, callables)
    let active_gen = match pkg.fn_generics.get(dc.key) {
      Some(g) => g
      None => Map()
    }
    let vt : Map[String, String] = Map()
    match pkg.fn_param_types.get(dc.key) {
      Some(pm) => {
        for pk in pm.keys() {
          match pm.get(pk) {
            Some(pv) => vt[pk] = pv
            None => ()
          }
        }
      }
      None => ()
    }
    if dc.recv_type.length() > 0 && !vt.contains("self") {
      vt["self"] = dc.recv_type
    }
    let pmv : Map[String, Bool] = Map()
    ms_collect_local_var_types(pkg, ts, dc.body_open + 1, dc.body_close, fcontent, qfi_opt, vt, pmv, callables, active_gen)
    let shadowed : Map[String, Bool] = Map()
    ms_collect_pattern_bound_idents_in_span_ex(ts, dc.body_open + 1, dc.body_close, shadowed, false)
    ms_collect_closure_param_names(ts, dc.body_open + 1, dc.body_close, shadowed)
    ms_mark_shadowed_ambig(vt, shadowed)
    ms_prune_pure_map_vars(pmv, shadowed)
    let reass : Map[String, Bool] = Map()
    ms_collect_reassigned_idents(ts, dc.body_open + 1, dc.body_close, reass)
    ms_prune_pure_map_vars(pmv, reass)
    let fn_edges : Array[String] = match edges.get(dc.key) {
      Some(e) => e
      None => []
    }
    ms_scan_span(pkg, ts, dc.body_open + 1, dc.body_close, dc.body_open, fcontent, qfi_opt, vt, pmv, callables, active_gen, sum, fn_edges, true, 0)
    edges[dc.key] = fn_edges
  }

  // Pass 3: Monotone fixed-point propagation over call graph.
  let mut changed = true
  while changed {
    changed = false
    for fk in edges.keys() {
      match pkg.summaries.get(fk) {
        Some(f_sum) =>
        match edges.get(fk) {
          Some(elist) => {
            for callee in elist {
              match pkg.summaries.get(callee) {
                Some(c_sum) =>
                if fn_mutation_summary_merge(f_sum, c_sum) {
                  changed = true
                }
                None =>
                if !f_sum.unknown {
                  f_sum.unknown = true
                  changed = true
                }
              }
            }
          }
          None => ()
        }
        None => ()
      }
    }
  }

  pkg
}

fn ms_parse_fn_decl(
  pkg : PkgMutationSummary,
  ts : Array[Token],
  fn_i : Int,
  limit : Int,
  file_idx : Int,
  impl_recv_type : String,
) -> (Int, Option[MsFnDecl]) {
  let generics : Map[String, Bool] = Map()
  let mut j = fn_i + 1
  if j < limit && ts[j].kind == TokenKind::LBracket {
    j = ms_parse_generic_params(ts, j, generics) + 1
  }
  let mut recv_ty = impl_recv_type
  let mut bare_name = ""
  if j + 2 < limit && (ts[j].kind == TokenKind::UpperIdent || ts[j].kind == TokenKind::Ident) &&
  ts[j + 1].kind == TokenKind::ColonColon && ts[j + 2].kind == TokenKind::Ident {
    recv_ty = ts[j].raw
    bare_name = ts[j + 2].raw
    j = j + 3
  } else if j < limit && ts[j].kind == TokenKind::Ident {
    bare_name = ts[j].raw
    if recv_ty.length() == 0 {
      pkg.top_level_bindings[bare_name] = true
    }
    j = j + 1
  } else {
    return (fn_i + 1, None)
  }
  if j < limit && ts[j].kind == TokenKind::LBracket {
    j = ms_parse_generic_params(ts, j, generics) + 1
  }
  if j >= limit || ts[j].kind != TokenKind::LParen {
    return (j, None)
  }
  let lp = j
  let rp = find_matching_delim(ts, lp)
  if rp < lp || rp >= limit {
    return (fn_i + 1, None)
  }
  let ptypes : Map[String, String] = Map()
  ms_parse_fn_params(ts, lp, rp, ptypes)
  let mut o = rp + 1
  let mut ret_s = -1
  let mut ret_e = -1
  let mut rd = 0
  while o < limit && ts[o].kind != TokenKind::LBrace {
    let ok = ts[o].kind
    if ok == TokenKind::LParen || ok == TokenKind::LBracket {
      rd = rd + 1
    } else if ok == TokenKind::RParen || ok == TokenKind::RBracket {
      if rd > 0 { rd = rd - 1 }
    } else if rd == 0 {
      if ok == TokenKind::Eq || ok == TokenKind::Semi {
        return (o, None)
      }
      let r = ts[o].raw
      if r == "fn" || r == "pub" || r == "priv" || r == "extern" || r == "struct" ||
      r == "enum" || r == "impl" || r == "trait" || r == "test" {
        return (o, None)
      }
      if ok == TokenKind::Arrow && ret_s < 0 {
        ret_s = o + 1
      }
    }
    o = o + 1
  }
  if o >= limit || ts[o].kind != TokenKind::LBrace {
    return (o, None)
  }
  if ret_s > 0 {
    ret_e = o
  }
  let close = find_matching_delim(ts, o)
  if close <= o {
    return (o + 1, None)
  }
  let key = if recv_ty.length() > 0 { recv_ty + "::" + bare_name } else { bare_name }
  pkg.fn_keys[key] = true
  pkg.summaries[key] = FnMutationSummary::empty()
  pkg.fn_generics[key] = generics
  pkg.fn_param_types[key] = ptypes
  if ret_s > 0 && ret_e > ret_s {
    pkg.fn_ret_types[key] = ms_join_token_slice(ts, ret_s, ret_e)
  }
  if recv_ty.length() > 0 {
    pkg.method_names[bare_name] = true
    let ov = match pkg.method_overloads.get(bare_name) {
      Some(a) => a
      None => []
    }
    let mut dup = false
    for x in ov {
      if x == key { dup = true; break }
    }
    if !dup {
      ov.push(key)
      pkg.method_overloads[bare_name] = ov
    }
  }
  (
    close + 1,
    Some(MsFnDecl::{
      key,
      bare_name,
      recv_type: recv_ty,
      file_idx,
      body_open: o,
      body_close: close,
    }),
  )
}

// ---------------------------------------------------------------------------
// Public span & callback summarization entry points for Gates A / B / C / D
// ---------------------------------------------------------------------------

///| Summarize any expression/block span `[s, e)` inside an enclosing function whose body opens at `fn_body_open`.
///| Flush one lexically visible prefix segment `[seg_s, seg_e)` inside an enclosing closure into `vt` and `pmv`.
fn ms_flush_enclosing_prefix_seg(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  seg_s : Int,
  seg_e : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  vt : Map[String, String],
  pmv : Map[String, Bool],
  callables : Map[String, Bool],
  active_generics : Map[String, Bool],
) -> Unit {
  if seg_e <= seg_s {
    return
  }
  ms_collect_local_var_types(pkg, tokens, seg_s, seg_e, content, qfi_opt, vt, pmv, callables, active_generics)
  let sh : Map[String, Bool] = Map()
  ms_collect_pattern_bound_idents_in_span_ex(tokens, seg_s, seg_e, sh, false)
  ms_mark_shadowed_ambig(vt, sh)
  ms_prune_pure_map_vars(pmv, sh)
  let reass : Map[String, Bool] = Map()
  ms_collect_reassigned_idents(tokens, seg_s, seg_e, reass)
  ms_prune_pure_map_vars(pmv, reass)
}

///| Apply lexical bindings, params, shadowing, and reassignments from every intermediate closure
///| strictly enclosing `[target_s, target_e)` inside `[fn_body_open + 1, body_close)` (outer to inner),
///| scanning only lexically visible prefix segments before `target_s` (skipping closed blocks and post-call code).
fn ms_apply_enclosing_closures(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  fn_body_open : Int,
  body_close : Int,
  target_s : Int,
  target_e : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  vt : Map[String, String],
  pmv : Map[String, Bool],
  callables : Map[String, Bool],
  active_generics : Map[String, Bool],
) -> Unit {
  let mut in_closure = false
  let mut seg_s = fn_body_open + 1
  let mut i = fn_body_open + 1
  while i < target_s && i < body_close {
    if tokens[i].raw == "fn" && i + 1 < body_close && tokens[i + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i + 1)
      let mut lb = cp + 1
      while lb < body_close && tokens[lb].kind != TokenKind::LBrace && tokens[lb].kind != TokenKind::Semi && tokens[lb].kind != TokenKind::RBrace {
        lb = lb + 1
      }
      if lb < body_close && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        if rb > lb {
          if in_closure && i > seg_s {
            ms_flush_enclosing_prefix_seg(pkg, tokens, seg_s, i, content, qfi_opt, vt, pmv, callables, active_generics)
          }
          if lb < target_s && target_e <= rb {
            let pnames = collect_pion_fn_param_names(tokens, i + 1, cp)
            for pn in pnames {
              if pn.length() > 0 && pn != "_" {
                vt[pn] = "__AMBIG__"
                let _ = pmv.remove(pn)
              }
            }
            in_closure = true
            i = lb + 1
            seg_s = i
            continue
          } else {
            i = rb + 1
            seg_s = i
            continue
          }
        }
      }
    }
    if in_closure && tokens[i].kind == TokenKind::LBrace {
      let blk_close = find_matching_delim(tokens, i)
      if blk_close > i {
        if blk_close < target_s {
          // Expression literal `{ ... }` (e.g. `let m = { 1: 2 }`, `S::{ ... }`) stays in the current segment;
          // closed control/statement blocks (`if c { let m = ext }`, `None => { ... }`) are skipped completely.
          let is_expr_brace = i > seg_s && (
            tokens[i - 1].kind == TokenKind::Eq ||
            tokens[i - 1].kind == TokenKind::ColonColon ||
            tokens[i - 1].kind == TokenKind::LParen ||
            tokens[i - 1].kind == TokenKind::LBracket ||
            tokens[i - 1].kind == TokenKind::Comma
          )
          if is_expr_brace {
            i = blk_close + 1
            continue
          }
          if i > seg_s {
            ms_flush_enclosing_prefix_seg(pkg, tokens, seg_s, i, content, qfi_opt, vt, pmv, callables, active_generics)
          }
          i = blk_close + 1
          seg_s = i
          continue
        } else if i < target_s && target_e <= blk_close {
          if i > seg_s {
            ms_flush_enclosing_prefix_seg(pkg, tokens, seg_s, i, content, qfi_opt, vt, pmv, callables, active_generics)
          }
          i = i + 1
          seg_s = i
          continue
        }
      }
    }
    i = i + 1
  }
  if in_closure && target_s > seg_s {
    ms_flush_enclosing_prefix_seg(pkg, tokens, seg_s, target_s, content, qfi_opt, vt, pmv, callables, active_generics)
  }
}

pub fn summarize_expr_span(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  s : Int,
  e : Int,
  fn_body_open : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  extra_var_types : Map[String, String],
  active_generics : Map[String, Bool],
) -> FnMutationSummary {
  let sum = FnMutationSummary::empty()
  let callables = if fn_body_open >= 0 { callable_locals(tokens, fn_body_open) } else { Map() }
  if fn_body_open >= 0 { ms_collect_pattern_bound_idents(tokens, fn_body_open, callables) }
  let vt : Map[String, String] = Map()
  let pmv : Map[String, Bool] = Map()
  // Seed with enclosing function's parameter types + locals
  if fn_body_open >= 0 {
    let fstart = fn_start_of(tokens, fn_body_open)
    if fstart >= 0 {
      let mut p = fstart + 1
      while p < fn_body_open && tokens[p].kind != TokenKind::LParen { p = p + 1 }
      if p < fn_body_open && tokens[p].kind == TokenKind::LParen {
        let rp = find_matching_delim(tokens, p)
        if rp < fn_body_open {
          ms_parse_fn_params(tokens, p, rp, vt)
        }
      }
    }
    let body_close = find_matching_delim(tokens, fn_body_open)
    ms_collect_local_var_types(pkg, tokens, fn_body_open + 1, body_close, content, qfi_opt, vt, pmv, callables, active_generics)
    let outer_sh : Map[String, Bool] = Map()
    ms_collect_pattern_bound_idents_in_span_ex(tokens, fn_body_open + 1, body_close, outer_sh, false)
    ms_collect_closure_param_names(tokens, fn_body_open + 1, body_close, outer_sh)
    ms_mark_shadowed_ambig(vt, outer_sh)
    ms_prune_pure_map_vars(pmv, outer_sh)
    let outer_reass : Map[String, Bool] = Map()
    ms_collect_reassigned_idents(tokens, fn_body_open + 1, body_close, outer_reass)
    ms_prune_pure_map_vars(pmv, outer_reass)
    ms_apply_enclosing_closures(pkg, tokens, fn_body_open, body_close, s, e, content, qfi_opt, vt, pmv, callables, active_generics)
  }
  for k in extra_var_types.keys() {
    match extra_var_types.get(k) {
      Some(v) => {
        vt[k] = v
        let _ = pmv.remove(k)
      }
      None => ()
    }
  }
  if fn_body_open < 0 {
    ms_collect_local_var_types(pkg, tokens, s, e, content, qfi_opt, vt, pmv, callables, active_generics)
  }
  if fn_body_open < 0 || extra_var_types.length() > 0 {
    let inner_sh : Map[String, Bool] = Map()
    ms_collect_pattern_bound_idents_in_span_ex(tokens, s, e, inner_sh, extra_var_types.length() > 0)
    ms_collect_closure_param_names(tokens, s, e, inner_sh)
    ms_mark_shadowed_ambig(vt, inner_sh)
    ms_prune_pure_map_vars(pmv, inner_sh)
    let inner_reass : Map[String, Bool] = Map()
    ms_collect_reassigned_idents(tokens, s, e, inner_reass)
    ms_prune_pure_map_vars(pmv, inner_reass)
  }
  let dummy_edges : Array[String] = []
  ms_scan_span(pkg, tokens, s, e, fn_body_open, content, qfi_opt, vt, pmv, callables, active_generics, sum, dummy_edges, false, 0)
  sum
}

///| Summarize a callback argument `[arg_s, arg_e)` (inline closure, local closure, or top-level fn)
///| given the target array's element type `elem_ty`.
pub fn summarize_callback_arg(
  pkg : PkgMutationSummary,
  tokens : Array[Token],
  arg_s : Int,
  arg_e : Int,
  fn_body_open : Int,
  content : String,
  qfi_opt : Option[QtFileIndex],
  elem_ty : String,
  active_generics : Map[String, Bool],
) -> FnMutationSummary {
  let sum = FnMutationSummary::empty()
  let callables = if fn_body_open >= 0 { callable_locals(tokens, fn_body_open) } else { Map() }
  if fn_body_open >= 0 { ms_collect_pattern_bound_idents(tokens, fn_body_open, callables) }
  let vt : Map[String, String] = Map()
  let pmv : Map[String, Bool] = Map()
  if fn_body_open >= 0 {
    let fstart = fn_start_of(tokens, fn_body_open)
    if fstart >= 0 {
      let mut p = fstart + 1
      while p < fn_body_open && tokens[p].kind != TokenKind::LParen { p = p + 1 }
      if p < fn_body_open && tokens[p].kind == TokenKind::LParen {
        let rp = find_matching_delim(tokens, p)
        if rp < fn_body_open {
          ms_parse_fn_params(tokens, p, rp, vt)
        }
      }
    }
    let body_close = find_matching_delim(tokens, fn_body_open)
    ms_collect_local_var_types(pkg, tokens, fn_body_open + 1, body_close, content, qfi_opt, vt, pmv, callables, active_generics)
    let outer_sh : Map[String, Bool] = Map()
    ms_collect_pattern_bound_idents_in_span_ex(tokens, fn_body_open + 1, body_close, outer_sh, false)
    ms_collect_closure_param_names(tokens, fn_body_open + 1, body_close, outer_sh)
    ms_mark_shadowed_ambig(vt, outer_sh)
    ms_prune_pure_map_vars(pmv, outer_sh)
    let outer_reass : Map[String, Bool] = Map()
    ms_collect_reassigned_idents(tokens, fn_body_open + 1, body_close, outer_reass)
    ms_prune_pure_map_vars(pmv, outer_reass)
    ms_apply_enclosing_closures(pkg, tokens, fn_body_open, body_close, arg_s, arg_e, content, qfi_opt, vt, pmv, callables, active_generics)
  }
  let dummy_edges : Array[String] = []
  ms_analyze_callback_arg_into(pkg, tokens, arg_s, arg_e, fn_body_open, content, qfi_opt, vt, pmv, callables, active_generics, elem_ty, sum, dummy_edges, false, 0)
  sum
}
