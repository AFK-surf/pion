///| Unit tests for multiline array concat backtracking, MbtJson expected-type isolation
///| and propagation, B2d float patterns with constructor rest `..`, unambiguous multi-arg
///| enum single-wildcard expansion, and local closure parameter inference from return structs.

test "stage B: folds >512-line multiline array literal concat" {
  let sb = StringBuilder()
  sb.write_string("pub fn big_concat(tail : Array[Int]) -> Array[Int] {\n")
  sb.write_string("  let xs : Array[Int] = [\n")
  let mut i = 0
  while i < 600 {
    sb.write_string("    " + i.to_string() + ",\n")
    i = i + 1
  }
  sb.write_string("  ] + tail\n")
  sb.write_string("  xs\n")
  sb.write_string("}\n")
  let pion_src = sb.to_string()
  let files = [GeneratedFile::{ rel_path: "big.pion", source_file: "big.mbt", content: pion_src, anchors: [] }]
  let mock_check : (Array[(String, String)]) -> String = fn(fs) {
    let lines = fs[0].1.split("\n")
    let mut li = 0
    while li < lines.length() {
      let ln = lines[li]
      if str_has(ln, "] +") {
        let c = ln.index_of("+") + 1
        return "{\"diagnostics\":[{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"big.pion\",\"line\":" + (li + 1).to_string() + ",\"col\":" + c.to_string() + ",\"message\":\"operator `+` is not supported on `Array[Int]`\"}]}"
      }
      li = li + 1
    }
    "{\"diagnostics\":[]}"
  }
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  let (out_files, _, _) = run_stage_b(files, empty_api_map(), mock_check, diags, ledger)
  let out = out_files[0].content
  assert_true(str_has(out, "mbt_compat::arr_concat(["), "must fold >512-line array concat into arr_concat: " + out.slice(0, 200))
  assert_true(str_has(out, "], tail)"), "must preserve rhs tail cleanly")
}

test "stage A: Json/MbtJson constructors and unwrap_or isolate outer MbtJson expected type" {
  let src = SourceFile::{
    rel_path: "json_isolate.mbt",
    content: "pub fn make_json(items : Array[Json]) -> Json {\n" +
    "  let a : Json = Json::boolean(false)\n" +
    "  let b : Json = MbtJson::boolean(false)\n" +
    "  let c : Json = Json::number(1.5)\n" +
    "  let d : Json = MbtJson::number(2.5)\n" +
    "  let e : Json = Json::string(\"ok\")\n" +
    "  let f : Json = Json::array([1, true])\n" +
    "  let g : String = Json::object({ \"more\": false, \"outbox\": [], \"nested\": { \"k\": true } }).stringify()\n" +
    "  let h : String = ({ \"a\": 1 } : Json).stringify()\n" +
    "  let nums : Array[Double] = items.map(fn(n) {\n" +
    "    (if n is Number(x, ..) { Some(x) } else { None }).unwrap_or(0.0)\n" +
    "  })\n" +
    "  let _ = (a, b, c, d, e, f, g, h, nums)\n" +
    "  Json::object({ \"flag\": Json::boolean(false), \"more\": false, \"outbox\": [] })\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "json_isolate blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::MbtJson::boolean(false)"), "Json::boolean(false) must keep Bool arg: " + out)
  assert_true(!str_has(out, "boolean(mbt_compat::MbtJson::False)"), "must never double-wrap Bool in boolean(): " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::number(1.5)"), "Json::number(1.5) must keep Double arg: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::number(2.5)"), "MbtJson::number(2.5) must keep Double arg: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::string(\"ok\")"), "Json::string must keep String arg: " + out)
  assert_true(str_has(out, "(\"more\", mbt_compat::MbtJson::False)"), "Map[String, Json] literal must lower false to MbtJson::False: " + out)
  assert_true(str_has(out, "(\"outbox\", mbt_compat::MbtJson::Array([]))"), "Map[String, Json] literal must lower [] to MbtJson::Array([]): " + out)
  assert_true(str_has(out, "(\"nested\", mbt_compat::MbtJson::Object("), "Map[String, Json] literal must lower nested object: " + out)
  assert_true(str_has(out, ".unwrap_or(0.0)"), "unwrap_or(0.0) must keep Double 0.0: " + out)
  assert_true(!str_has(out, ".unwrap_or(mbt_compat::MbtJson::Number("), "unwrap_or(0.0) must never wrap 0.0 in MbtJson: " + out)
}

test "stage A: Object(m), m.copy(), match-bound map, Array push/insert, Option/map/Signal Json propagation and shadowing" {
  let src = SourceFile::{
    rel_path: "json_containers.mbt",
    content: "pub struct Signal[T] {\n" +
    "  mut v : T\n" +
    "}\n\n" +
    "pub fn[T] Signal::set(self : Signal[T], x : T) -> Unit {\n" +
    "  self.v = x\n" +
    "}\n\n" +
    "pub struct Counter[T] {\n" +
    "  mut n : Int\n" +
    "}\n\n" +
    "pub fn[T] Counter::set(self : Counter[T], flag : Int) -> Unit {\n" +
    "  self.n = flag\n" +
    "}\n\n" +
    "pub struct CounterWrap {\n" +
    "  c : Counter[Json]\n" +
    "}\n\n" +
    "pub fn mutate_json(j : Json, label : String, xs : Array[String], sig : Signal[Json?], ctr : Counter[Json], cw : CounterWrap) -> Json? {\n" +
    "  let st = match j {\n" +
    "    Object(m) => m.copy()\n" +
    "    _ => {}\n" +
    "  }\n" +
    "  st[\"k\"] = { \"a\": 1, \"b\": [1, 2] }\n" +
    "  st[\"s\"] = label\n" +
    "  let arr : Array[Json] = []\n" +
    "  arr.push({ \"p\": true })\n" +
    "  arr.insert(0, [1, 2])\n" +
    "  let mapped : Array[Json] = xs.map(fn(x) { { \"item\": x } })\n" +
    "  sig.set(Some({ \"saved\": true }))\n" +
    "  ctr.set(0)\n" +
    "  cw.c.set(0)\n" +
    "  let _ = (arr, mapped)\n" +
    "  match j {\n" +
    "    Object(m) => {\n" +
    "      let o = m.copy()\n" +
    "      o[\"k\"] = [true]\n" +
    "      Some({ \"ok\": true })\n" +
    "    }\n" +
    "    _ => None\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "json_containers blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "st[\"k\"] = mbt_compat::MbtJson::Object("), "match-bound st[k] = obj must propagate MbtJson: " + out)
  assert_true(str_has(out, "st[\"s\"] = mbt_compat::MbtJson::String(label)"), "st[s] = label must wrap String in MbtJson: " + out)
  assert_true(str_has(out, "arr.push(mbt_compat::MbtJson::Object("), "Array[Json]::push must propagate MbtJson: " + out)
  assert_true(str_has(out, "arr.insert(0, mbt_compat::MbtJson::Array("), "Array[Json]::insert must propagate MbtJson: " + out)
  assert_true(str_has(out, "xs.map(fn(x) { mbt_compat::MbtJson::Object("), "Array::map returning Array[Json] must propagate MbtJson: " + out)
  assert_true(str_has(out, "sig.set(Some(mbt_compat::MbtJson::Object("), "Signal[Option[Json]]::set(Some({...})) must propagate MbtJson: " + out)
  assert_true(str_has(out, "ctr.set(0)"), "Counter[Json]::set(0) must keep Int 0 untouched: " + out)
  assert_true(str_has(out, "cw.c.set(0)"), "field Counter[Json]::set(0) must keep Int 0 untouched: " + out)
  assert_true(!str_has(out, "ctr.set(mbt_compat::MbtJson::"), "Counter[Json]::set(0) must never wrap 0 in MbtJson: " + out)
  assert_true(str_has(out, "o[\"k\"] = mbt_compat::MbtJson::Array([mbt_compat::MbtJson::True])"), "m.copy() o[k] = [true] must propagate MbtJson: " + out)
  assert_true(str_has(out, "Some(mbt_compat::MbtJson::Object("), "Option[Json] match arm Some({...}) must propagate MbtJson: " + out)
  // Negative check: untyped closure param `x` in `unknown_strings().map(fn(x) { { "k": x } })`
  // must shadow an outer `x : Int` so inner `x` is never mis-wrapped as `MbtJson::number((x).to_double())`.
  let shadow_src = SourceFile::{
    rel_path: "map_shadow.mbt",
    content: "pub fn map_with_outer_int(x : Int) -> Array[Json] {\n" +
    "  let _ = x\n" +
    "  unknown_strings().map(fn(x) { { \"k\": x } })\n" +
    "}\n",
    is_test: false,
  }
  let shadow_res = transpile_package_ex([shadow_src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let shadow_out = shadow_res.files[0].content
  assert_true(str_has(shadow_out, "(\"k\", x)"), "closure param x must shadow outer Int x without wrapping: " + shadow_out)
  assert_true(!str_has(shadow_out, "MbtJson::number((x).to_double())"), "outer Int x must never leak into shadowed map closure param: " + shadow_out)
  // Regression check: `r.val.map(fn(v) { v.id() })` on `r : Ref[Option[BoxItem]]` in Option[Int] context
  // must resolve `.val` to `.v` via `try_resolve_static_val_field`, never `.val_`.
  let ref_val_src = SourceFile::{
    rel_path: "ref_val_map.mbt",
    content: "pub struct BoxItem {\n" +
    "  n : Int\n" +
    "}\n\n" +
    "pub fn BoxItem::id(self : BoxItem) -> Int {\n" +
    "  self.n\n" +
    "}\n\n" +
    "pub fn read_ref_map() -> Int? {\n" +
    "  let r : Ref[BoxItem?] = Ref(None)\n" +
    "  r.val.map(fn(v) { v.id() })\n" +
    "}\n",
    is_test: false,
  }
  let ref_val_res = transpile_package_ex([ref_val_src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let ref_val_out = ref_val_res.files[0].content
  assert_true(str_has(ref_val_out, "r.v.map("), "Ref::val.map must resolve .val to .v: " + ref_val_out)
  assert_true(!str_has(ref_val_out, "r.val_"), "Ref::val.map must never emit r.val_: " + ref_val_out)
}

test "stage A: B2d float pattern allows enum rest .. and still rejects range .." {
  let src = SourceFile::{
    rel_path: "b2d_rest.mbt",
    content: "pub fn classify(v : Json?) -> Int {\n" +
    "  match v {\n" +
    "    Some(Number(3.0, ..)) => 3\n" +
    "    Some(Number(8.0, ..)) => 8\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "b2d_rest blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::MbtJson::Number(__mbt_flt_"), "B2d must lower float in Some(Number(3.0, ..)): " + out)
  assert_true(str_has(out, "== 3.0"), "B2d must emit == 3.0 guard: " + out)
  assert_true(str_has(out, "== 8.0"), "B2d must emit == 8.0 guard: " + out)
  assert_true(!str_has(out, "Number(3.0"), "must not leave raw float pattern Number(3.0: " + out)
  // Negative check: range `0.0..1.0` must still be disallowed by B2d.
  let range_toks = lex_moonbit("0.0..1.0")
  assert_true(pattern_has_b2d_disallowed_tok(range_toks, 0, range_toks.length() - 1), "0.0..1.0 must remain disallowed in B2d")
  let rest_toks = lex_moonbit("Some(Number(3.0, ..))")
  assert_true(!pattern_has_b2d_disallowed_tok(rest_toks, 0, rest_toks.length() - 1), "Some(Number(3.0, ..)) must be allowed in B2d")
}

test "stage A: multi-arg enum single wildcard Ctor(_) expands unambiguously and rejects ambiguous names" {
  let dep_src = SourceFile::{
    rel_path: "dep.mbt",
    content: "pub enum RemoteKind {\n" +
    "  Four(String, Int, Bool, Double)\n" +
    "}\n",
    is_test: false,
  }
  let dep_res = transpile_package([dep_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(dep_res.blockers == 0, "dep transpile must succeed")
  let src = SourceFile::{
    rel_path: "wild.mbt",
    content: "pub enum Msg {\n" +
    "  Quoted(String, Int, Bool, Double)\n" +
    "  Single(Int)\n" +
    "}\n\n" +
    "pub enum Named {\n" +
    "  Chat(String, String, Int, Bool)\n" +
    "}\n\n" +
    "pub enum AmbA {\n" +
    "  Dup(Int)\n" +
    "}\n\n" +
    "pub enum AmbB {\n" +
    "  Dup(Int, Int, Int, Int)\n" +
    "}\n\n" +
    "pub fn check_all(m : Msg, n : Named, r : @dep.RemoteKind, om : Msg?) -> Int {\n" +
    "  let a = match m {\n" +
    "    Quoted(_) => 1\n" +
    "    Single(_) => 2\n" +
    "  }\n" +
    "  let b = match n {\n" +
    "    Named::Chat(_) => 3\n" +
    "  }\n" +
    "  let c = match r {\n" +
    "    @dep.RemoteKind::Four(_) => 4\n" +
    "  }\n" +
    "  let d = match om {\n" +
    "    Some(Quoted(_)) => 5\n" +
    "    _ => 0\n" +
    "  }\n" +
    "  let e = if m is Quoted(_) { 6 } else { 0 }\n" +
    "  a + b + c + d + e\n" +
    "}\n\n" +
    "pub fn check_ambig(x : AmbB) -> Int {\n" +
    "  match x {\n" +
    "    AmbB::Dup(_) => 1\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_with_abis([src], empty_api_map(), default_recipes(), [], [], [], [("dep", dep_res.abi)], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "wild blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "Quoted(_, _, _, _)"), "4-field Quoted(_) must expand: " + out)
  assert_true(str_has(out, "Single(_)"), "1-field Single(_) must stay Single(_): " + out)
  assert_true(str_has(out, "Named::Chat(_, _, _, _)"), "4-field Named::Chat(_) must expand: " + out)
  assert_true(str_has(out, "dep::RemoteKind::Four(_, _, _, _)"), "cross-pkg 4-field Four(_) must expand: " + out)
  assert_true(
    str_has(out, "Some(.Quoted(_, _, _, _))") ||
    str_has(out, "Some(Msg::Quoted(_, _, _, _))") ||
    str_has(out, "Some(Quoted(_, _, _, _))"),
    "nested Some(Quoted(_)) must expand: " + out,
  )
  assert_true(str_has(out, "AmbB::Dup(_, _, _, _)"), "qualified AmbB::Dup(_) must expand: " + out)
  // Negative check: unqualified `Dup(_)` when AmbA::Dup(1) and AmbB::Dup(4) coexist must stay unexpanded.
  let ambig_src = SourceFile::{
    rel_path: "ambig_wild.mbt",
    content: "pub enum AmbA {\n" +
    "  Dup(Int)\n" +
    "}\n\n" +
    "pub enum AmbB {\n" +
    "  Dup(Int, Int, Int, Int)\n" +
    "}\n\n" +
    "pub fn check_unqual(x : Int) -> Int {\n" +
    "  match x {\n" +
    "    Dup(_) => 1\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let ambig_res = transpile_package_ex([ambig_src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let ambig_out = ambig_res.files[0].content
  assert_true(str_has(ambig_out, "Dup(_) => 1"), "ambiguous unqualified Dup(_) must stay Dup(_): " + ambig_out)
  assert_true(!str_has(ambig_out, "Dup(_, _, _, _)"), "ambiguous unqualified Dup(_) must not mis-expand: " + ambig_out)
  // Negative check: cross-package colliding `Foo::Pair(_)` (different arities across dep1 & dep2) must stay unexpanded.
  let dep1_src = SourceFile::{
    rel_path: "dep1.mbt",
    content: "pub enum Foo {\n  Pair(Int)\n}\n",
    is_test: false,
  }
  let dep2_src = SourceFile::{
    rel_path: "dep2.mbt",
    content: "pub enum Foo {\n  Pair(Int, Int, Int, Int)\n}\n",
    is_test: false,
  }
  let dep1_res = transpile_package([dep1_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  let dep2_res = transpile_package([dep2_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(dep1_res.blockers == 0 && dep2_res.blockers == 0, "dep1/dep2 must transpile")
  let xpkg_src = SourceFile::{
    rel_path: "xpkg_wild.mbt",
    content: "pub fn check_xpkg(x : Int) -> Int {\n" +
    "  match x {\n" +
    "    Foo::Pair(_) => 1\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let xpkg_res = transpile_package_with_abis(
    [xpkg_src],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [("dep1", dep1_res.abi), ("dep2", dep2_res.abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let xpkg_out = xpkg_res.files[0].content
  assert_true(str_has(xpkg_out, "Foo::Pair(_) => 1"), "cross-package colliding Foo::Pair(_) must stay unexpanded: " + xpkg_out)
  assert_true(!str_has(xpkg_out, "Foo::Pair(_, _, _, _)"), "cross-package colliding Foo::Pair(_) must not mis-expand: " + xpkg_out)
}

test "stage A: local let closure parameter inference from explicit non-generic return struct" {
  let src = SourceFile::{
    rel_path: "clo_ret_struct.mbt",
    content: "pub struct Entry {\n" +
    "  id : Int\n" +
    "  score : Double\n" +
    "  title : String\n" +
    "}\n\n" +
    "pub struct GenBox[T] {\n" +
    "  item : T\n" +
    "}\n\n" +
    "pub fn make_entries() -> Entry {\n" +
    "  let mk = fn(id, score, name) -> Entry { { id, score, title: name } }\n" +
    "  mk(1, 2.5, \"hello\")\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "clo_ret_struct blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "fn(id : Int, score : Double, name : String) -> Entry"), "local let closure must infer param types from Entry fields: " + out)
}
