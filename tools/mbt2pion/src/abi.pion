///| True iff `s` is complete, externally constructible & updatable, and has zero `priv` fields.
pub fn abi_struct_is_externally_expandable(s : AbiStructSchema) -> Bool {
  if !s.complete || !s.can_construct || !s.can_update {
    return false
  }
  for f in s.fields {
    if f.visibility != "pub" || f.src_name.length() == 0 || f.emit_name.length() == 0 {
      return false
    }
  }
  true
}

///| True iff `name` is a built-in Pion/MoonBit type that must never be hijacked by post-lowering qualification.
fn is_builtin_abi_type_name(name : String) -> Bool {
  name == "Int" || name == "Int64" || name == "UInt" || name == "UInt64" ||
  name == "Double" || name == "Float" || name == "Bool" || name == "Char" ||
  name == "Byte" || name == "Unit" || name == "String" || name == "Bytes" ||
  name == "Array" || name == "FixedArray" || name == "Option" || name == "Result" ||
  name == "Map" || name == "StringBuilder" || name == "Ref" || name == "Iter"
}

///| Qualify bare identifiers in `ty` that name a non-builtin local type of `pkg` (and not a generic param)
///| as `pkg::Name`, preserving already-qualified paths (`a::B`) and type prefixes (`B::C`).
fn qualify_abi_local_type_names(
  ty : String,
  pkg : String,
  local_types : Map[String, Bool],
  generics : Map[String, Bool],
) -> String {
  if pkg.length() == 0 || local_types.length() == 0 || ty.length() == 0 {
    return ty
  }
  let sb = StringBuilder()
  let n = ty.length()
  let mut i = 0
  while i < n {
    let c = ty.code_unit_at(i)
    if is_alnum(c) {
      let s = i
      while i < n && is_alnum(ty.code_unit_at(i)) {
        i = i + 1
      }
      let word = ty.slice(s, i)
      let qualified_before = s >= 2 && ty.code_unit_at(s - 1) == 58 && ty.code_unit_at(s - 2) == 58
      let path_after = i + 1 < n && ty.code_unit_at(i) == 58 && ty.code_unit_at(i + 1) == 58
      if !qualified_before && !path_after && !is_builtin_abi_type_name(word) && local_types.contains(word) && !generics.contains(word) {
        sb.write_string(pkg + "::" + word)
      } else {
        sb.write_string(word)
      }
    } else {
      sb.write_string(ty.slice(i, i + 1))
      i = i + 1
    }
  }
  sb.to_string()
}

///| Qualify source MoonBit type tokens `[start, end)` BEFORE `lower_type_tokens` runs:
///| only bare `UpperIdent` tokens that name a local type of `self_pkg` (and not a generic param)
///| are rewritten to `self_pkg::Name`, so builtin container lowerings (e.g. `ReadOnlyArray[Int]` -> `Array[Int]`)
///| are NEVER mis-qualified by a local `type Array = ...` alias!
fn qualify_source_type_tokens(
  tokens : Array[Token],
  start : Int,
  end : Int,
  self_pkg : String,
  local_types : Map[String, Bool],
  tparam_set : Map[String, Bool],
) -> Array[Token] {
  let out : Array[Token] = []
  let mut k = start
  while k < end {
    let t = tokens[k]
    let prev_qual = k > start && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon || tokens[k - 1].kind == TokenKind::PkgRef)
    let next_cc = k + 1 < end && tokens[k + 1].kind == TokenKind::ColonColon
    if self_pkg.length() > 0 && t.kind == TokenKind::UpperIdent && !prev_qual && !next_cc &&
    local_types.contains(t.raw) && !tparam_set.contains(t.raw) {
      out.push(Token::{
        kind: TokenKind::Ident,
        raw: self_pkg,
        leading_trivia: t.leading_trivia,
        newline_before: t.newline_before,
        line: t.line,
        col: t.col,
        start_byte: t.start_byte,
        end_byte: t.start_byte,
      })
      out.push(Token::{
        kind: TokenKind::ColonColon,
        raw: "::",
        leading_trivia: "",
        newline_before: false,
        line: t.line,
        col: t.col,
        start_byte: t.start_byte,
        end_byte: t.start_byte,
      })
      out.push(Token::{
        kind: TokenKind::UpperIdent,
        raw: t.raw,
        leading_trivia: "",
        newline_before: false,
        line: t.line,
        col: t.col,
        start_byte: t.start_byte,
        end_byte: t.end_byte,
      })
    } else {
      out.push(t)
    }
    k = k + 1
  }
  out.push(Token::{
    kind: TokenKind::Eof,
    raw: "",
    leading_trivia: "",
    newline_before: false,
    line: 1,
    col: 1,
    start_byte: 0,
    end_byte: 0,
  })
  out
}

///| Extract exported `pub` / `pub(all)` braced struct schemas from non-test MoonBit sources,
///| preserving exact field declaration order, mutability, visibility, type params, and rename map.
pub fn collect_exported_abi_structs(
  sources : Array[SourceFile],
  self_pkg : String,
  symtab : SymbolTable,
  recipes : Recipes,
  struct_field_renames : Map[String, Map[String, String]],
  target : String,
) -> Array[AbiStructSchema] {
  let out : Array[AbiStructSchema] = []
  let seen_structs : Map[String, Bool] = Map()
  // Only true nominal local declarations (excluding transparent `type Alias = ...`) are qualified.
  let nominal_local_types : Map[String, Bool] = Map()
  for lt in symtab.local_types.keys() {
    if !symtab.type_aliases.contains(lt) {
      nominal_local_types[lt] = true
    }
  }
  for sf in sources {
    if sf.is_test {
      continue
    }
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    let mut i = 0
    let mut depth = 0
    let mut next_cfg_excluded = false
    while i < n {
      let t = tokens[i]
      if t.kind == TokenKind::LBrace {
        depth = depth + 1
        i = i + 1
        continue
      }
      if t.kind == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
        i = i + 1
        continue
      }
      if depth == 0 && t.kind == TokenKind::Attr {
        if t.raw.starts_with("#cfg") {
          match eval_cfg_attr(t.raw, target) {
            Some(true) => ()
            _ => next_cfg_excluded = true
          }
        }
        i = i + 1
        continue
      }
      if depth == 0 && next_cfg_excluded {
        next_cfg_excluded = false
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "struct" &&
      i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        let is_pub = is_decl_pub(tokens, i)
        if !is_pub {
          i = i + 1
          continue
        }
        let mut is_pub_all = false
        if i >= 4 && tokens[i - 1].kind == TokenKind::RParen && tokens[i - 3].kind == TokenKind::LParen &&
        tokens[i - 4].kind == TokenKind::Keyword && tokens[i - 4].raw == "pub" &&
        (tokens[i - 2].raw == "all" || tokens[i - 2].raw == "open") {
          is_pub_all = true
        }
        let sname = tokens[i + 1].raw
        let mut lb = i + 2
        let mut tparams : Array[String] = []
        let tparam_set : Map[String, Bool] = Map()
        let added_g : Array[String] = []
        if lb < n && tokens[lb].kind == TokenKind::LBracket {
          let close_gb = find_matching_delim(tokens, lb)
          tparams = collect_generic_param_names(tokens, lb, close_gb)
          for gp in tparams {
            tparam_set[gp] = true
            if !symtab.active_generics.contains(gp) {
              symtab.active_generics[gp] = true
              added_g.push(gp)
            }
          }
          lb = close_gb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          if !seen_structs.contains(sname) {
            seen_structs[sname] = true
            let fields : Array[AbiStructField] = []
            let seen_src : Map[String, Bool] = Map()
            let seen_emit : Map[String, Bool] = Map()
            let mut complete = true
            let mut has_priv_field = false
            let mut fi = lb + 1
            while fi < rb {
              if tokens[fi].kind == TokenKind::Semi || tokens[fi].kind == TokenKind::Comma {
                fi = fi + 1
                continue
              }
              let mut fvis = "pub"
              let mut fmut = false
              if tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "pub" {
                fvis = "pub"
                fi = fi + 1
                if fi < rb && tokens[fi].kind == TokenKind::LParen {
                  fi = find_matching_delim(tokens, fi) + 1
                }
              } else if tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "priv" {
                fvis = "priv"
                has_priv_field = true
                fi = fi + 1
              }
              if fi < rb && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "mut" {
                fmut = true
                fi = fi + 1
              }
              if fi >= rb {
                complete = false
                break
              }
              if tokens[fi].kind != TokenKind::Ident && tokens[fi].kind != TokenKind::Keyword {
                complete = false
                fi = fi + 1
                continue
              }
              let raw_f = tokens[fi].raw
              let emit_f = match struct_field_renames.get(sname) {
                Some(rm) => match rm.get(raw_f) { Some(en) => en, None => rename_keyword_ident(raw_f) }
                None => rename_keyword_ident(raw_f)
              }
              let mut fc = fi + 1
              while fc < rb && tokens[fc].kind != TokenKind::Colon {
                if tokens[fc].kind == TokenKind::Semi || tokens[fc].kind == TokenKind::Comma || tokens[fc].newline_before {
                  break
                }
                fc = fc + 1
              }
              if fc >= rb || tokens[fc].kind != TokenKind::Colon {
                complete = false
                fi = if fc > fi { fc } else { fi + 1 }
                continue
              }
              let mut f_end = fc + 1
              let mut fd = 0
              while f_end < rb {
                let fk = tokens[f_end].kind
                if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace {
                  fd = fd + 1
                } else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace {
                  fd = fd - 1
                } else if fd == 0 && (fk == TokenKind::Semi || fk == TokenKind::Comma || tokens[f_end].newline_before) {
                  break
                }
                f_end = f_end + 1
              }
              let fty = if f_end > fc + 1 {
                let q_toks = qualify_source_type_tokens(tokens, fc + 1, f_end, self_pkg, nominal_local_types, tparam_set)
                let lowered = lower_type_tokens(q_toks, 0, q_toks.length() - 1, symtab, recipes).trim()
                qualify_abi_local_type_names(lowered, self_pkg, nominal_local_types, tparam_set)
              } else {
                complete = false
                ""
              }
              if raw_f.length() == 0 || emit_f.length() == 0 || fty.length() == 0 ||
              seen_src.contains(raw_f) || seen_emit.contains(emit_f) {
                complete = false
              } else {
                seen_src[raw_f] = true
                seen_emit[emit_f] = true
                fields.push(AbiStructField::{
                  src_name: raw_f,
                  emit_name: emit_f,
                  is_mut: fmut,
                  visibility: fvis,
                  ty: fty,
                })
              }
              fi = f_end
            }
            let can_ext = is_pub_all && !has_priv_field && complete
            out.push(AbiStructSchema::{
              pkg: self_pkg,
              name: sname,
              type_params: tparams,
              fields: fields,
              can_construct: can_ext,
              can_update: can_ext,
              complete: complete,
            })
          }
          for gp in added_g {
            symtab.active_generics.remove(gp)
          }
          i = rb + 1
          continue
        }
        for gp in added_g {
          symtab.active_generics.remove(gp)
        }
      }
      i = i + 1
    }
  }
  sort_abi_structs(out)
}

///| Extract exported top-level `pub let name : Ty = ...` and `pub const name : Ty = ...`
///| value schemas with explicit type annotations from non-test MoonBit sources.
///| Values without explicit type annotations are skipped (never guessed).
pub fn collect_exported_abi_values(
  sources : Array[SourceFile],
  self_pkg : String,
  symtab : SymbolTable,
  recipes : Recipes,
  target : String,
) -> Array[AbiValueSchema] {
  let out : Array[AbiValueSchema] = []
  let seen_values : Map[String, Bool] = Map()
  let nominal_local_types : Map[String, Bool] = Map()
  for lt in symtab.local_types.keys() {
    if !symtab.type_aliases.contains(lt) {
      nominal_local_types[lt] = true
    }
  }
  let empty_tparams : Map[String, Bool] = Map()
  for sf in sources {
    if sf.is_test {
      continue
    }
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    let mut i = 0
    let mut depth = 0
    let mut next_cfg_excluded = false
    while i < n {
      let t = tokens[i]
      if t.kind == TokenKind::LBrace {
        depth = depth + 1
        i = i + 1
        continue
      }
      if t.kind == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
        i = i + 1
        continue
      }
      if depth == 0 && t.kind == TokenKind::Attr {
        if t.raw.starts_with("#cfg") {
          match eval_cfg_attr(t.raw, target) {
            Some(true) => ()
            _ => next_cfg_excluded = true
          }
        }
        i = i + 1
        continue
      }
      if depth == 0 && next_cfg_excluded {
        next_cfg_excluded = false
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      if depth == 0 && t.kind == TokenKind::Keyword && (t.raw == "let" || t.raw == "const") && is_decl_pub(tokens, i) {
        let mut name_i = i + 1
        if name_i < n && tokens[name_i].kind == TokenKind::Keyword && tokens[name_i].raw == "mut" {
          name_i = name_i + 1
        }
        if name_i + 2 < n && (tokens[name_i].kind == TokenKind::Ident || tokens[name_i].kind == TokenKind::UpperIdent) &&
        tokens[name_i + 1].kind == TokenKind::Colon {
          let vname = tokens[name_i].raw
          let colon_i = name_i + 1
          let mut eq_i = colon_i + 1
          let mut td = 0
          while eq_i < n {
            let ek = tokens[eq_i].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
              td = td + 1
            } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
              if td > 0 { td = td - 1 } else { break }
            } else if td == 0 && (ek == TokenKind::Eq || ek == TokenKind::Semi) {
              break
            }
            eq_i = eq_i + 1
          }
          if eq_i < n && tokens[eq_i].kind == TokenKind::Eq && eq_i > colon_i + 1 && !seen_values.contains(vname) {
            let q_toks = qualify_source_type_tokens(tokens, colon_i + 1, eq_i, self_pkg, nominal_local_types, empty_tparams)
            let lowered = lower_type_tokens(q_toks, 0, q_toks.length() - 1, symtab, recipes).trim()
            let vty = qualify_abi_local_type_names(lowered, self_pkg, nominal_local_types, empty_tparams)
            if vty.length() > 0 {
              seen_values[vname] = true
              out.push(AbiValueSchema::{ name: vname, ty: vty })
            }
          }
          i = eq_i + 1
          continue
        }
      }
      i = i + 1
    }
  }
  sort_abi_values(out)
}

///| Extract exported top-level `pub fn ... raise E` raising function signatures from
///| non-test MoonBit sources (before checked-error lowering rewrites `raise` to `Result`).
pub fn collect_exported_abi_raising_fns(
  sources : Array[SourceFile],
  self_pkg : String,
  symtab : SymbolTable,
  target : String,
) -> Array[AbiRaisingFn] {
  let local_suberrors : Map[String, Bool] = Map()
  for sf in sources {
    if sf.is_test { continue }
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = tokens[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "suberror" &&
      i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        local_suberrors[tokens[i + 1].raw] = true
      }
      i = i + 1
    }
  }
  let out : Array[AbiRaisingFn] = []
  let seen : Map[String, Bool] = Map()
  for sf in sources {
    if sf.is_test { continue }
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    let mut i = 0
    let mut depth = 0
    let mut next_cfg_excluded = false
    while i < n {
      let t = tokens[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Attr {
        if t.raw.starts_with("#cfg") {
          match eval_cfg_attr(t.raw, target) {
            Some(true) => ()
            _ => next_cfg_excluded = true
          }
        }
        i = i + 1
        continue
      }
      if depth == 0 && next_cfg_excluded {
        next_cfg_excluded = false
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "fn" && is_decl_pub(tokens, i) {
        match le_parse_fn_header(sf.content, tokens, i, n) {
          Some((fname, _, _, _, has_r, ety, has_rp, lb)) => {
            let rb = find_matching_delim(tokens, lb)
            if has_r && !has_rp && fname.length() > 0 && !str_has(fname, "::") && ety.length() > 0 && ety != "Error" && ety != "Failure" && !seen.contains(fname) {
              let q_et = if ety.starts_with("@") {
                let dot = ety.index_of(".")
                if dot > 1 {
                  let rp = ety.slice(1, dot)
                  let tn = ety.slice(dot + 1, ety.length()).trim()
                  let cp = match symtab.pkg_aliases.get(rp) {
                    Some(p) => p
                    None => match symtab.moon_import_paths.get(rp) {
                      Some(fp) => {
                        let d = moon_import_default_alias(fp)
                        if d.length() > 0 { d } else { rp }
                      }
                      None => rp
                    }
                  }
                  cp + "::" + tn
                } else {
                  ety
                }
              } else if self_pkg.length() > 0 && local_suberrors.contains(ety) {
                self_pkg + "::" + ety
              } else {
                match symtab.using_types.get(ety) {
                  Some(resolved) => resolved
                  None => ety
                }
              }
              seen[fname] = true
              out.push(AbiRaisingFn::{ name: fname, err_ty: q_et })
            }
            i = rb + 1
            continue
          }
          None => ()
        }
      }
      i = i + 1
    }
  }
  sort_abi_raising_fns(out)
}

///| Exact compiler-aligned library source check (`compiler/src/cli/main.pion:188`):
///| ONLY literal suffix `_test.pion` is excluded from library compilation; `*_wbtest.pion` IS included!
pub fn is_abi_library_pion(rel_path : String) -> Bool {
  rel_path.ends_with(".pion") && !rel_path.ends_with("_test.pion")
}

///| Validate a companion filename (flat `.pion` file, no path traversal, not `*_test.pion`).
pub fn is_valid_companion_name(name : String) -> Bool {
  if name.length() == 0 || !name.ends_with(".pion") || name.ends_with("_test.pion") {
    return false
  }
  if str_has(name, "/") || str_has(name, "\\") || str_has(name, "..") || name == "." {
    return false
  }
  true
}

///| Parse `[[abi.companions]]` entries from `recipes.toml` without touching `symbols.pion`.
pub fn parse_abi_companions_toml(
  content : String,
  path : String,
  diags : Array[Diag],
) -> Array[AbiCompanionSpec] {
  let out : Array[AbiCompanionSpec] = []
  let seen_names : Map[String, Bool] = Map()
  let mut in_comp = false
  let mut cur_name = ""
  let mut cur_src = ""
  let mut cur_sha = ""
  let mut cur_line = 1
  let flush_item = fn(ln : Int) -> Unit {
    if !in_comp {
      return
    }
    if cur_name.length() == 0 || cur_src.length() == 0 {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "`[[abi.companions]]` requires non-empty `name` and `source`",
      ))
      return
    }
    if !is_valid_companion_name(cur_name) {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "invalid companion `name` `" + cur_name + "` (must be a flat `.pion` filename, not `*_test.pion`, no `/` or `..`)",
      ))
      return
    }
    if seen_names.contains(cur_name) {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "duplicate `[[abi.companions]]` entry for `" + cur_name + "`",
      ))
      return
    }
    if cur_sha.length() > 0 && !is_valid_sha256_hex(cur_sha) {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "invalid 64-hex `sha256` on companion `" + cur_name + "`",
      ))
      return
    }
    seen_names[cur_name] = true
    out.push(AbiCompanionSpec::{ name: cur_name, source: cur_src, sha256: cur_sha })
  }
  let lines = content.split("\n")
  let mut line_no = 0
  for raw_line in lines {
    line_no = line_no + 1
    let line = raw_line.trim()
    if line.length() == 0 || line.starts_with("#") {
      continue
    }
    if line.starts_with("[[") && line.ends_with("]]") {
      flush_item(cur_line)
      let sec = line.slice(2, line.length() - 2).trim()
      in_comp = sec == "abi.companions"
      cur_name = ""
      cur_src = ""
      cur_sha = ""
      cur_line = line_no
      continue
    }
    if line.starts_with("[") && line.ends_with("]") {
      flush_item(cur_line)
      in_comp = false
      continue
    }
    if !in_comp {
      continue
    }
    let eq_i = line.index_of("=")
    if eq_i <= 0 {
      continue
    }
    let k = line.slice(0, eq_i).trim()
    let v = unquote_toml(line.slice(eq_i + 1, line.length()).trim())
    if k == "name" {
      cur_name = v
    } else if k == "source" {
      cur_src = v
    } else if k == "sha256" {
      cur_sha = v
    } else {
      diags.push(diag_error(
        "MBT2PION_RECIPE_ERROR",
        path,
        line_no,
        1,
        "unknown key `" + k + "` in `[[abi.companions]]`",
      ))
    }
  }
  flush_item(cur_line)
  out
}

///| Validate a companion `.pion` file's public declarations:
///| rejects any `pub struct`/`pub enum` colliding with generated types,
///| any `pub struct` with an unmapped `val` field, or any `pub enum` with labeled variant fields.
pub fn validate_companion_declarations(
  comp_name : String,
  comp_content : String,
  gen_types : Map[String, Bool],
  diags : Array[Diag],
) -> Unit {
  let toks = lex_moonbit(comp_content)
  let n = toks.length() - 1
  let mut i = 0
  let mut depth = 0
  while i < n {
    let t = toks[i]
    if t.kind == TokenKind::LBrace {
      depth = depth + 1
      i = i + 1
      continue
    }
    if t.kind == TokenKind::RBrace {
      if depth > 0 { depth = depth - 1 }
      i = i + 1
      continue
    }
    if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "pub" {
      let mut k = i + 1
      if k < n && toks[k].kind == TokenKind::LParen {
        k = find_matching_delim(toks, k) + 1
      }
      if k + 1 < n && toks[k].kind == TokenKind::Keyword &&
      (toks[k].raw == "struct" || toks[k].raw == "enum") &&
      toks[k + 1].kind == TokenKind::UpperIdent {
        let is_struct = toks[k].raw == "struct"
        let tname = toks[k + 1].raw
        if gen_types.contains(tname) {
          diags.push(diag_error(
            "MBT2PION_ABI_COMPANION_ERROR",
            comp_name,
            toks[k + 1].line,
            toks[k + 1].col,
            "companion `" + comp_name + "` declares `pub " + toks[k].raw + " " + tname + "` colliding with a generated type",
          ))
        }
        let mut lb = k + 2
        while lb < n && toks[lb].kind != TokenKind::LBrace {
          lb = lb + 1
        }
        if lb < n && toks[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(toks, lb)
          if is_struct {
            let mut f = lb + 1
            let mut bd = 0
            while f < rb {
              let fk = toks[f].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { bd = bd + 1 }
              else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { if bd > 0 { bd = bd - 1 } }
              else if bd == 0 && toks[f].raw == "val" && f + 1 < rb && toks[f + 1].kind == TokenKind::Colon {
                diags.push(diag_error(
                  "MBT2PION_ABI_COMPANION_ERROR",
                  comp_name,
                  toks[f].line,
                  toks[f].col,
                  "companion `" + comp_name + "` declares `pub struct " + tname + "` with unmapped `val` field",
                ))
              }
              f = f + 1
            }
          } else {
            let mut f = lb + 1
            while f < rb {
              if toks[f].kind == TokenKind::LParen {
                let cp = find_matching_delim(toks, f)
                let mut p = f + 1
                while p + 1 < cp {
                  if (toks[p].kind == TokenKind::Ident || toks[p].kind == TokenKind::Keyword) &&
                  toks[p + 1].kind == TokenKind::Tilde {
                    diags.push(diag_error(
                      "MBT2PION_ABI_COMPANION_ERROR",
                      comp_name,
                      toks[p].line,
                      toks[p].col,
                      "companion `" + comp_name + "` declares `pub enum " + tname + "` with unmapped labeled variant field",
                    ))
                    break
                  }
                  p = p + 1
                }
                f = cp + 1
                continue
              }
              f = f + 1
            }
          }
          i = rb + 1
          continue
        }
      }
    }
    i = i + 1
  }
}

///| Collect all `struct`/`enum` type names declared in generated `.pion` files.
pub fn collect_generated_type_names(files : Array[GeneratedFile]) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  for gf in files {
    let toks = lex_moonbit(gf.content)
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Keyword && (t.raw == "struct" || t.raw == "enum") &&
      i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        out[toks[i + 1].raw] = true
      }
      i = i + 1
    }
  }
  out
}

fn abi_payload_to_json_opts(
  abi : PackageAbi,
  schema_ver : Int,
  include_publishable : Bool,
  include_reexports : Bool,
  include_values : Bool,
  include_raising_fns : Bool,
) -> json::JsonValue {
  let sorted_enums = sort_abi_enums(abi.enums)
  let enum_arr : Array[json::JsonValue] = []
  for en in sorted_enums {
    let var_arr : Array[json::JsonValue] = []
    for v in en.variants {
      let field_arr : Array[json::JsonValue] = []
      for f in v.fields {
        field_arr.push(json_obj([
          json_field("label", json_str(f.label)),
          json_field("ty", json_str(f.ty)),
        ]))
      }
      var_arr.push(json_obj([
        json_field("name", json_str(v.name)),
        json_field("fields", json_arr(field_arr)),
      ]))
    }
    enum_arr.push(json_obj([
      json_field("name", json_str(en.name)),
      json_field("can_match", json_bool(en.can_match)),
      json_field("can_construct", json_bool(en.can_construct)),
      json_field("variants", json_arr(var_arr)),
    ]))
  }
  let sorted_vals = sort_abi_struct_vals(abi.struct_val_fields)
  let val_arr : Array[json::JsonValue] = []
  for sv in sorted_vals {
    val_arr.push(json_obj([
      json_field("struct_name", json_str(sv.struct_name)),
      json_field("renamed_field", json_str(sv.renamed_field)),
    ]))
  }
  let fields : Array[json::JsonField] = [
    json_field("schema_version", json_int(schema_ver)),
    json_field("package", json_str(abi.package_name)),
    json_field("enums", json_arr(enum_arr)),
    json_field("struct_val_fields", json_arr(val_arr)),
  ]
  if schema_ver >= 2 {
    match abi.structs {
      Some(raw_structs) => {
        let sorted_sts = sort_abi_structs(raw_structs)
        let st_arr : Array[json::JsonValue] = []
        for st in sorted_sts {
          let tp_arr : Array[json::JsonValue] = []
          for tp in st.type_params {
            tp_arr.push(json_str(tp))
          }
          let sf_arr : Array[json::JsonValue] = []
          for f in st.fields {
            sf_arr.push(json_obj([
              json_field("src_name", json_str(f.src_name)),
              json_field("emit_name", json_str(f.emit_name)),
              json_field("is_mut", json_bool(f.is_mut)),
              json_field("visibility", json_str(f.visibility)),
              json_field("ty", json_str(f.ty)),
            ]))
          }
          st_arr.push(json_obj([
            json_field("name", json_str(st.name)),
            json_field("type_params", json_arr(tp_arr)),
            json_field("can_construct", json_bool(st.can_construct)),
            json_field("can_update", json_bool(st.can_update)),
            json_field("complete", json_bool(st.complete)),
            json_field("fields", json_arr(sf_arr)),
          ]))
        }
        fields.push(json_field("structs", json_arr(st_arr)))
      }
      None => ()
    }
  }
  if schema_ver >= 2 && abi.companion_files.length() > 0 {
    let sorted_comps = sort_abi_companions(abi.companion_files)
    let comp_arr : Array[json::JsonValue] = []
    for cf in sorted_comps {
      comp_arr.push(json_obj([
        json_field("path", json_str(cf.path)),
        json_field("sha256", json_str(cf.sha256)),
      ]))
    }
    fields.push(json_field("companion_files", json_arr(comp_arr)))
  }
  if schema_ver >= 2 && abi.op_impls.length() > 0 {
    let sorted_ops = sort_abi_op_impls(abi.op_impls)
    let op_arr : Array[json::JsonValue] = []
    for op in sorted_ops {
      op_arr.push(json_obj([
        json_field("type_name", json_str(op.type_name)),
        json_field("op", json_str(op.op)),
        json_field("fn_name", json_str(op.fn_name)),
      ]))
    }
    fields.push(json_field("op_impls", json_arr(op_arr)))
  }
  if schema_ver >= 2 && (include_reexports || abi.reexports.length() > 0) {
    let re_arr : Array[json::JsonValue] = []
    for r in sort_abi_reexports(abi.reexports) {
      re_arr.push(json_obj([json_field("name", json_str(r.name)), json_field("kind", json_str(r.kind)), json_field("target_pkg", json_str(r.target_pkg)), json_field("target_name", json_str(r.target_name))]))
    }
    fields.push(json_field("reexports", json_arr(re_arr)))
  }
  if schema_ver >= 2 && (include_values || abi.values.length() > 0) {
    let val_arr : Array[json::JsonValue] = []
    for v in sort_abi_values(abi.values) {
      val_arr.push(json_obj([
        json_field("name", json_str(v.name)),
        json_field("ty", json_str(v.ty)),
      ]))
    }
    fields.push(json_field("values", json_arr(val_arr)))
  }
  if schema_ver >= 2 && (include_raising_fns || abi.raising_fns.length() > 0) {
    let rf_arr : Array[json::JsonValue] = []
    for rf in sort_abi_raising_fns(abi.raising_fns) {
      rf_arr.push(json_obj([
        json_field("name", json_str(rf.name)),
        json_field("err_ty", json_str(rf.err_ty)),
      ]))
    }
    fields.push(json_field("raising_fns", json_arr(rf_arr)))
  }
  if schema_ver >= 2 && abi.ffi_shim_prefix.length() > 0 {
    fields.push(json_field("ffi_shim_prefix", json_str(abi.ffi_shim_prefix)))
  }
  if schema_ver >= 2 && include_publishable {
    fields.push(json_field("publishable", json_bool(abi.publishable)))
  }
  json_obj(fields)
}

fn abi_payload_to_json_versioned(abi : PackageAbi, schema_ver : Int) -> json::JsonValue {
  abi_payload_to_json_opts(abi, schema_ver, schema_ver >= 2, abi.reexports.length() > 0, abi.values.length() > 0, abi.raising_fns.length() > 0)
}

fn abi_payload_to_json(abi : PackageAbi) -> json::JsonValue {
  abi_payload_to_json_versioned(abi, 2)
}

///| Deterministic canonical JSON encoding of an ABI payload (schema v2).
pub fn render_canonical_abi_payload(abi : PackageAbi) -> String {
  json::stringify(abi_payload_to_json(abi))
}

///| SHA-256 of the canonical ABI payload for a specific schema version (1 or 2).
pub fn compute_abi_payload_sha256_v(abi : PackageAbi, schema_ver : Int) -> String {
  content_sha256(json::stringify(abi_payload_to_json_versioned(abi, schema_ver)))
}

///| SHA-256 of the canonical ABI v2 payload (embedded as `// abi-sha256: <hex>` in every `.pion` file).
pub fn compute_abi_payload_sha256(abi : PackageAbi) -> String {
  compute_abi_payload_sha256_v(abi, 2)
}

///| Deterministic SHA-256 over sorted `(rel_path, content)` `.pion` files.
///| v1 includes all `.pion` files; v2 includes all non-`*_test.pion` generated `.pion` files (keeping `*_wbtest.pion`).
pub fn compute_abi_files_sha256_v(files : Array[(String, String)], schema_ver : Int) -> String {
  let sorted : Array[(String, String)] = []
  for f in files {
    let keep = if schema_ver == 1 { f.0.ends_with(".pion") } else { is_abi_library_pion(f.0) }
    if keep {
      sorted.push(f)
    }
  }
  let mut i = 1
  while i < sorted.length() {
    let key = sorted[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(sorted[j].0, key.0) > 0 {
      sorted[j + 1] = sorted[j]
      j = j - 1
    }
    sorted[j + 1] = key
    i = i + 1
  }
  let sb = StringBuilder()
  for f in sorted {
    sb.write_string(f.0)
    sb.write_string(":")
    sb.write_string(f.1.length().to_string())
    sb.write_string(":")
    sb.write_string(content_sha256(f.1))
    sb.write_string("\n")
  }
  content_sha256(sb.to_string())
}

pub fn compute_abi_files_sha256(files : Array[(String, String)]) -> String {
  compute_abi_files_sha256_v(files, 2)
}

///| Extract `companion_files` (`path -> sha256`) from an existing `mbt2pion_abi.json` (returns empty map on error).
pub fn extract_abi_companion_hashes(raw_json : String) -> Map[String, String] {
  let out : Map[String, String] = Map()
  match json::parse(raw_json) {
    Ok(root) =>
    match json::obj_get(root, "payload") {
      Some(payload_v) =>
      match json::obj_get(payload_v, "companion_files") {
        Some(cfv) =>
        match json::as_arr(cfv) {
          Some(citems) => {
            for cit in citems {
              let cpath = j_str(cit, "path", "")
              let csha = j_str(cit, "sha256", "")
              if is_valid_companion_name(cpath) && is_valid_sha256_hex(csha) {
                out[cpath] = csha
              }
            }
          }
          None => ()
        }
        None => ()
      }
      None => ()
    }
    Err(_) => ()
  }
  out
}

///| Render the complete `mbt2pion_abi.json` sidecar (schema v2) for a published or audited package.
pub fn render_abi_json(
  abi : PackageAbi,
  final_pion_files : Array[(String, String)],
) -> String {
  let payload_v = abi_payload_to_json_versioned(abi, 2)
  let abi_sha = content_sha256(json::stringify(payload_v))
  let files_sha = compute_abi_files_sha256_v(final_pion_files, 2)
  let root = json_obj([
    json_field("schema_version", json_int(2)),
    json_field("package", json_str(abi.package_name)),
    json_field("abi_sha256", json_str(abi_sha)),
    json_field("files_sha256", json_str(files_sha)),
    json_field("payload", payload_v),
  ])
  json::stringify(root) + "\n"
}

///| Extract `// abi-sha256: <hex>` from the leading comment header of a `.pion` file.
pub fn extract_header_abi_sha256(content : String) -> Option[String] {
  let lines = content.split("\n")
  let prefix = "// abi-sha256: "
  for raw in lines {
    let ln = raw.trim()
    if ln.length() == 0 {
      continue
    }
    if !ln.starts_with("//") {
      break
    }
    if ln.starts_with(prefix) {
      return Some(ln.slice(prefix.length(), ln.length()).trim())
    }
  }
  None
}

///| Bidirectionally verify a `--dep` package's `mbt2pion_abi.json` against its `.pion` files.
///| - Ordinary hand-written Pion `--dep` (neither `// abi-sha256:` header nor `mbt2pion_abi.json`):
///|   returns `None` with zero diagnostics (full compatibility with hand-written deps).
///| - If EITHER `// abi-sha256:` OR `mbt2pion_abi.json` is present: enforces BOTH directions
///|   (`sha256(canonical(payload)) == abi_sha256 == every .pion header` AND `files_sha256 == sha256(sorted .pion)`),
///|   emitting `MBT2PION_DEP_ABI_ERROR` on any missing/mismatched/tampered/duplicate-label artifact!
pub fn verify_and_parse_dep_abi(
  dep_name : String,
  dep_path : String,
  pion_files : Array[(String, String)],
  abi_json_opt : Option[String],
  diags : Array[Diag],
) -> Option[PackageAbi] {
  let mut any_header = false
  for pf in pion_files {
    match extract_header_abi_sha256(pf.1) {
      Some(_) => any_header = true
      None => ()
    }
  }
  let has_sidecar = match abi_json_opt {
    Some(_) => true
    None => false
  }
  if !any_header && !has_sidecar {
    return None
  }
  let raw_json = match abi_json_opt {
    Some(s) => s
    None => {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path,
        1,
        1,
        "dep `" + dep_name + "` declares `// abi-sha256:` header in `.pion` files but `mbt2pion_abi.json` is missing",
      ))
      return None
    }
  }
  let root = match json::parse(raw_json) {
    Ok(v) => v
    Err(e) => {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path + "/mbt2pion_abi.json",
        1,
        1,
        "failed to parse `mbt2pion_abi.json` for dep `" + dep_name + "`: " + e,
      ))
      return None
    }
  }
  let sv = j_int(root, "schema_version", -1)
  if sv != 1 && sv != 2 {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "unsupported `mbt2pion_abi.json` schema_version for dep `" + dep_name + "` (expected 1 or 2)",
    ))
    return None
  }
  let decl_abi_sha = j_str(root, "abi_sha256", "")
  let decl_files_sha = j_str(root, "files_sha256", "")
  if !is_valid_sha256_hex(decl_abi_sha) || !is_valid_sha256_hex(decl_files_sha) {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "invalid `abi_sha256` or `files_sha256` in `mbt2pion_abi.json` for dep `" + dep_name + "`",
    ))
    return None
  }
  let payload_v = match json::obj_get(root, "payload") {
    Some(v) => v
    None => {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path + "/mbt2pion_abi.json",
        1,
        1,
        "missing `payload` in `mbt2pion_abi.json` for dep `" + dep_name + "`",
      ))
      return None
    }
  }
  let pkg_field = j_str(payload_v, "package", dep_name)
  let enums : Array[AbiEnumSchema] = []
  let seen_enums : Map[String, Bool] = Map()
  match json::obj_get(payload_v, "enums") {
    Some(ev) =>
    match json::as_arr(ev) {
      Some(eitems) => {
        for eit in eitems {
          let ename = j_str(eit, "name", "")
          if ename.length() == 0 {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "empty enum name in `mbt2pion_abi.json` for dep `" + dep_name + "`",
            ))
            return None
          }
          if seen_enums.contains(ename) {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "duplicate enum `" + ename + "` in `mbt2pion_abi.json` for dep `" + dep_name + "`",
            ))
            return None
          }
          seen_enums[ename] = true
          let can_match = match json::obj_get(eit, "can_match") {
            Some(v) => match json::as_bool(v) {
              Some(b) => b
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `can_match` on enum `" + ename + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            None => false
          }
          let can_construct = match json::obj_get(eit, "can_construct") {
            Some(v) => match json::as_bool(v) {
              Some(b) => b
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `can_construct` on enum `" + ename + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            None => false
          }
          if can_construct && !can_match {
            diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "enum `" + ename + "` in dep `" + dep_name + "` declares `can_construct: true` with `can_match: false`"))
            return None
          }
          let variants : Array[AbiEnumVariant] = []
          let seen_vars : Map[String, Bool] = Map()
          match json::obj_get(eit, "variants") {
            Some(vv) =>
            match json::as_arr(vv) {
              Some(vitems) => {
                for vit in vitems {
                  let vname = j_str(vit, "name", "")
                  if vname.length() == 0 || seen_vars.contains(vname) {
                    diags.push(diag_error(
                      "MBT2PION_DEP_ABI_ERROR",
                      dep_path + "/mbt2pion_abi.json",
                      1,
                      1,
                      "invalid or duplicate variant `" + vname + "` on enum `" + ename + "` in dep `" + dep_name + "`",
                    ))
                    return None
                  }
                  seen_vars[vname] = true
                  let fields : Array[AbiEnumField] = []
                  let seen_labels : Map[String, Bool] = Map()
                  match json::obj_get(vit, "fields") {
                    Some(fv) =>
                    match json::as_arr(fv) {
                      Some(fitems) => {
                        for fit in fitems {
                          let flbl = j_str(fit, "label", "")
                          let fty = j_str(fit, "ty", "")
                          if flbl.length() > 0 {
                            if seen_labels.contains(flbl) {
                              diags.push(diag_error(
                                "MBT2PION_DEP_ABI_ERROR",
                                dep_path + "/mbt2pion_abi.json",
                                1,
                                1,
                                "duplicate label `" + flbl + "` on variant `" + ename + "::" + vname + "` in dep `" + dep_name + "`",
                              ))
                              return None
                            }
                            seen_labels[flbl] = true
                          }
                          fields.push(AbiEnumField::{ label: flbl, ty: fty })
                        }
                      }
                      None => {
                        diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `fields` on variant `" + ename + "::" + vname + "` in dep `" + dep_name + "`"))
                        return None
                      }
                    }
                    None => ()
                  }
                  variants.push(AbiEnumVariant::{ name: vname, fields: fields })
                }
              }
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `variants` on enum `" + ename + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            None => ()
          }
          enums.push(AbiEnumSchema::{
            pkg: dep_name,
            name: ename,
            can_match: can_match,
            can_construct: can_construct,
            variants: variants,
          })
        }
      }
      None => ()
    }
    None => ()
  }
  let struct_vals : Array[AbiStructValRename] = []
  let seen_svals : Map[String, Bool] = Map()
  match json::obj_get(payload_v, "struct_val_fields") {
    Some(svv) =>
    match json::as_arr(svv) {
      Some(sitems) => {
        for sit in sitems {
          let sname = j_str(sit, "struct_name", "")
          let rfield = j_str(sit, "renamed_field", "")
          if sname.length() == 0 || rfield.length() == 0 || seen_svals.contains(sname) {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "invalid or duplicate `struct_val_fields` entry `" + sname + "` in dep `" + dep_name + "`",
            ))
            return None
          }
          seen_svals[sname] = true
          struct_vals.push(AbiStructValRename::{
            pkg: dep_name,
            struct_name: sname,
            renamed_field: rfield,
          })
        }
      }
      None => ()
    }
    None => ()
  }

  let mut parsed_structs : Option[Array[AbiStructSchema]] = None
  if sv >= 2 {
    match json::obj_get(payload_v, "structs") {
      Some(stv) => {
        let sitems = match json::as_arr(stv) {
          Some(a) => a
          None => {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "invalid `structs` field (expected array) in dep `" + dep_name + "`",
            ))
            return None
          }
        }
        let sval_map : Map[String, String] = Map()
        for sv_e in struct_vals {
          sval_map[sv_e.struct_name] = sv_e.renamed_field
        }
        let structs_arr : Array[AbiStructSchema] = []
        let seen_sts : Map[String, Bool] = Map()
        let mut prev_sname = ""
        for sit in sitems {
          let sname = j_str(sit, "name", "")
          if sname.length() == 0 || seen_sts.contains(sname) {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "invalid or duplicate struct `" + sname + "` in `mbt2pion_abi.json` for dep `" + dep_name + "`",
            ))
            return None
          }
          if prev_sname.length() > 0 && str_cmp(prev_sname, sname) > 0 {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "out-of-order `structs` entry `" + sname + "` after `" + prev_sname + "` in dep `" + dep_name + "`",
            ))
            return None
          }
          prev_sname = sname
          seen_sts[sname] = true
          let tparams : Array[String] = []
          let seen_tp : Map[String, Bool] = Map()
          match json::obj_get(sit, "type_params") {
            Some(tpv) =>
            match json::as_arr(tpv) {
              Some(tpitems) => {
                for tpit in tpitems {
                  match json::as_str(tpit) {
                    Some(tp) => {
                      if tp.length() == 0 || seen_tp.contains(tp) {
                        diags.push(diag_error(
                          "MBT2PION_DEP_ABI_ERROR",
                          dep_path + "/mbt2pion_abi.json",
                          1,
                          1,
                          "invalid or duplicate type_param `" + tp + "` on struct `" + sname + "` in dep `" + dep_name + "`",
                        ))
                        return None
                      }
                      seen_tp[tp] = true
                      tparams.push(tp)
                    }
                    None => {
                      diags.push(diag_error(
                        "MBT2PION_DEP_ABI_ERROR",
                        dep_path + "/mbt2pion_abi.json",
                        1,
                        1,
                        "non-string type_param on struct `" + sname + "` in dep `" + dep_name + "`",
                      ))
                      return None
                    }
                  }
                }
              }
              None => {
                diags.push(diag_error(
                  "MBT2PION_DEP_ABI_ERROR",
                  dep_path + "/mbt2pion_abi.json",
                  1,
                  1,
                  "invalid `type_params` on struct `" + sname + "` in dep `" + dep_name + "`",
                ))
                return None
              }
            }
            None => {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "missing `type_params` on struct `" + sname + "` in dep `" + dep_name + "`",
              ))
              return None
            }
          }
          let can_construct = match json::obj_get(sit, "can_construct") {
            Some(v) => match json::as_bool(v) {
              Some(b) => b
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `can_construct` on struct `" + sname + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            None => {
              diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "missing `can_construct` on struct `" + sname + "` in dep `" + dep_name + "`"))
              return None
            }
          }
          let can_update = match json::obj_get(sit, "can_update") {
            Some(v) => match json::as_bool(v) {
              Some(b) => b
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `can_update` on struct `" + sname + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            None => {
              diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "missing `can_update` on struct `" + sname + "` in dep `" + dep_name + "`"))
              return None
            }
          }
          let complete = match json::obj_get(sit, "complete") {
            Some(v) => match json::as_bool(v) {
              Some(b) => b
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `complete` on struct `" + sname + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            None => {
              diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "missing `complete` on struct `" + sname + "` in dep `" + dep_name + "`"))
              return None
            }
          }
          let fitems = match json::obj_get(sit, "fields") {
            Some(fv) => match json::as_arr(fv) {
              Some(a) => a
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `fields` on struct `" + sname + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            None => {
              diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "missing `fields` on struct `" + sname + "` in dep `" + dep_name + "`"))
              return None
            }
          }
          let sfields : Array[AbiStructField] = []
          let seen_src : Map[String, Bool] = Map()
          let seen_emit : Map[String, Bool] = Map()
          let mut has_priv = false
          for fit in fitems {
            let src_n = j_str(fit, "src_name", "")
            let emit_n = j_str(fit, "emit_name", "")
            let vis = j_str(fit, "visibility", "")
            let fty = j_str(fit, "ty", "")
            let is_m = match json::obj_get(fit, "is_mut") {
              Some(v) => match json::as_bool(v) {
                Some(b) => b
                None => {
                  diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `is_mut` on field `" + src_n + "` of struct `" + sname + "` in dep `" + dep_name + "`"))
                  return None
                }
              }
              None => {
                diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "missing `is_mut` on field `" + src_n + "` of struct `" + sname + "` in dep `" + dep_name + "`"))
                return None
              }
            }
            if src_n.length() == 0 || emit_n.length() == 0 || seen_src.contains(src_n) || seen_emit.contains(emit_n) {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "invalid or duplicate field `" + src_n + "`/`" + emit_n + "` on struct `" + sname + "` in dep `" + dep_name + "`",
              ))
              return None
            }
            if vis != "pub" && vis != "priv" {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "invalid visibility `" + vis + "` on field `" + src_n + "` of struct `" + sname + "` in dep `" + dep_name + "`",
              ))
              return None
            }
            if complete && fty.length() == 0 {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "empty field type on complete struct `" + sname + "` field `" + src_n + "` in dep `" + dep_name + "`",
              ))
              return None
            }
            if vis == "priv" {
              has_priv = true
            }
            if src_n == "val" {
              match sval_map.get(sname) {
                Some(expected_emit) =>
                if expected_emit != emit_n {
                  diags.push(diag_error(
                    "MBT2PION_DEP_ABI_ERROR",
                    dep_path + "/mbt2pion_abi.json",
                    1,
                    1,
                    "struct `" + sname + "` `val` emit_name `" + emit_n + "` conflicts with `struct_val_fields` `" + expected_emit + "` in dep `" + dep_name + "`",
                  ))
                  return None
                }
                None => ()
              }
            }
            seen_src[src_n] = true
            seen_emit[emit_n] = true
            sfields.push(AbiStructField::{
              src_name: src_n,
              emit_name: emit_n,
              is_mut: is_m,
              visibility: vis,
              ty: fty,
            })
          }
          if (can_construct || can_update) && (!complete || has_priv) {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "struct `" + sname + "` in dep `" + dep_name + "` claims external construct/update despite incomplete metadata or `priv` fields",
            ))
            return None
          }
          structs_arr.push(AbiStructSchema::{
            pkg: dep_name,
            name: sname,
            type_params: tparams,
            fields: sfields,
            can_construct: can_construct,
            can_update: can_update,
            complete: complete,
          })
        }
        parsed_structs = Some(structs_arr)
      }
      None => ()
    }
  }

  let companion_files : Array[AbiCompanionFile] = []
  let seen_comps : Map[String, String] = Map()
  if sv >= 2 {
    match json::obj_get(payload_v, "companion_files") {
      Some(cfv) =>
      match json::as_arr(cfv) {
        Some(citems) => {
          for cit in citems {
            let cpath = j_str(cit, "path", "")
            let csha = j_str(cit, "sha256", "")
            if !is_valid_companion_name(cpath) || !is_valid_sha256_hex(csha) || seen_comps.contains(cpath) {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "invalid or duplicate `companion_files` entry `" + cpath + "` in dep `" + dep_name + "`",
              ))
              return None
            }
            seen_comps[cpath] = csha
            companion_files.push(AbiCompanionFile::{ path: cpath, sha256: csha })
          }
        }
        None => ()
      }
      None => ()
    }
  }
  let op_impls : Array[OpImplEntry] = []
  let seen_ops : Map[String, Bool] = Map()
  if sv >= 2 {
    match json::obj_get(payload_v, "op_impls") {
      Some(oiv) =>
      match json::as_arr(oiv) {
        Some(oitems) => {
          for oit in oitems {
            let tname = j_str(oit, "type_name", "")
            let op_name = j_str(oit, "op", "")
            let fn_name = j_str(oit, "fn_name", "")
            let op_ok = op_name == "add" || op_name == "sub" || op_name == "mul" || op_name == "neg" || op_name == "div"
            let okey = tname + "|" + op_name
            if tname.length() == 0 || !op_ok || fn_name.length() == 0 || seen_ops.contains(okey) {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "invalid or duplicate `op_impls` entry `" + tname + "::" + op_name + "` in dep `" + dep_name + "`",
              ))
              return None
            }
            seen_ops[okey] = true
            op_impls.push(OpImplEntry::{
              pkg: dep_name,
              type_name: tname,
              op: op_name,
              fn_name: fn_name,
            })
          }
        }
        None => ()
      }
      None => ()
    }
  }

  let reexports : Array[AbiReexport] = []
  let seen_reexports : Map[String, Bool] = Map()
  let mut has_reexports_field = false
  if sv >= 2 {
    match json::obj_get(payload_v, "reexports") {
      Some(rev) => {
        has_reexports_field = true
        let ritems = match json::as_arr(rev) { Some(a) => a, None => { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `reexports` field in dep `" + dep_name + "`")); return None } }
        for rit in ritems {
          let rn = j_str(rit, "name", ""); let rk = j_str(rit, "kind", ""); let rp = j_str(rit, "target_pkg", ""); let rt = j_str(rit, "target_name", "")
          let rkey = rk + ":" + rn
          if rn.length() == 0 || (rk != "type" && rk != "value") || rp.length() == 0 || rt.length() == 0 || seen_reexports.contains(rkey) {
            diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid or duplicate `reexports` entry `" + rn + "` (" + rk + ") in dep `" + dep_name + "`"))
            return None
          }
          seen_reexports[rkey] = true
          reexports.push(AbiReexport::{ name: rn, kind: rk, target_pkg: rp, target_name: rt })
        }
      }
      None => ()
    }
  }

  let values : Array[AbiValueSchema] = []
  let seen_values : Map[String, Bool] = Map()
  let mut has_values_field = false
  if sv >= 2 {
    match json::obj_get(payload_v, "values") {
      Some(vv) => {
        has_values_field = true
        let vitems = match json::as_arr(vv) {
          Some(a) => a
          None => {
            diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `values` field in dep `" + dep_name + "`"))
            return None
          }
        }
        for vit in vitems {
          let vn = j_str(vit, "name", "")
          let vt = j_str(vit, "ty", "")
          if vn.length() == 0 || vt.length() == 0 || seen_values.contains(vn) {
            diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid or duplicate `values` entry `" + vn + "` in dep `" + dep_name + "`"))
            return None
          }
          seen_values[vn] = true
          values.push(AbiValueSchema::{ name: vn, ty: vt })
        }
      }
      None => ()
    }
  }

  let raising_fns : Array[AbiRaisingFn] = []
  let seen_raising_fns : Map[String, Bool] = Map()
  let mut has_raising_fns_field = false
  if sv >= 2 {
    match json::obj_get(payload_v, "raising_fns") {
      Some(rfv) => {
        has_raising_fns_field = true
        let rfitems = match json::as_arr(rfv) {
          Some(a) => a
          None => {
            diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `raising_fns` field in dep `" + dep_name + "`"))
            return None
          }
        }
        for rfit in rfitems {
          let rfn = j_str(rfit, "name", "")
          let rfe = j_str(rfit, "err_ty", "")
          if rfn.length() == 0 || rfe.length() == 0 || seen_raising_fns.contains(rfn) {
            diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid or duplicate `raising_fns` entry `" + rfn + "` in dep `" + dep_name + "`"))
            return None
          }
          seen_raising_fns[rfn] = true
          raising_fns.push(AbiRaisingFn::{ name: rfn, err_ty: rfe })
        }
      }
      None => ()
    }
  }

  let mut parsed_ffi_shim_prefix = ""
  if sv >= 2 {
    match json::obj_get(payload_v, "ffi_shim_prefix") {
      Some(pv) =>
      match json::as_str(pv) {
        Some(ps) =>
        if !is_valid_ffi_shim_prefix(ps) {
          diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `ffi_shim_prefix` `" + ps + "` in dep `" + dep_name + "`"))
          return None
        } else {
          parsed_ffi_shim_prefix = ps
        }
        None => {
          diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid non-string `ffi_shim_prefix` field in dep `" + dep_name + "`"))
          return None
        }
      }
      None => ()
    }
  }

  let has_pub_field = match json::obj_get(payload_v, "publishable") {
    Some(_) => true
    None => false
  }
  let is_publishable = if sv >= 2 { j_bool(payload_v, "publishable", true) } else { true }

  let parsed = PackageAbi::{
    package_name: pkg_field,
    enums: enums,
    struct_val_fields: struct_vals,
    structs: parsed_structs,
    companion_files: companion_files,
    op_impls: op_impls,
    reexports: reexports,
    values: values,
    raising_fns: raising_fns,
    ffi_shim_prefix: parsed_ffi_shim_prefix,
    publishable: is_publishable,
  }
  // Direction 1: canonical payload SHA-256 MUST equal `abi_sha256`!
  let actual_abi_sha = content_sha256(json::stringify(abi_payload_to_json_opts(parsed, sv, has_pub_field, has_reexports_field, has_values_field, has_raising_fns_field)))
  if actual_abi_sha != decl_abi_sha {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "tampered `mbt2pion_abi.json` for dep `" + dep_name + "`: payload sha256 " + actual_abi_sha + " != declared " + decl_abi_sha,
    ))
    return None
  }
  if sv == 1 {
    if pion_files.length() == 0 {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path,
        1,
        1,
        "dep `" + dep_name + "` has `mbt2pion_abi.json` but contains no `.pion` files",
      ))
      return None
    }
    for pf in pion_files {
      match extract_header_abi_sha256(pf.1) {
        Some(hdr_sha) =>
        if hdr_sha != decl_abi_sha {
          diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            dep_path + "/" + pf.0,
            1,
            1,
            "header `// abi-sha256:` mismatch in dep `" + dep_name + "` file `" + pf.0 + "` (header=" + hdr_sha + " sidecar=" + decl_abi_sha + ")",
          ))
          return None
        }
        None => {
          diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            dep_path + "/" + pf.0,
            1,
            1,
            "dep `" + dep_name + "` file `" + pf.0 + "` is missing `// abi-sha256:` header required by `mbt2pion_abi.json`",
          ))
          return None
        }
      }
    }
    // Direction 2 (v1): sorted `.pion` files SHA-256 MUST equal `files_sha256`!
    let actual_files_sha = compute_abi_files_sha256_v(pion_files, 1)
    if actual_files_sha != decl_files_sha {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path + "/mbt2pion_abi.json",
        1,
        1,
        "stale or tampered `.pion` files in dep `" + dep_name + "`: actual files_sha256 " + actual_files_sha + " != declared " + decl_files_sha,
      ))
      return None
    }
    return Some(parsed)
  }

  // Schema v2: partition non-`*_test.pion` files (keeping `*_wbtest.pion`!) into generated vs declared companions.
  let gen_files : Array[(String, String)] = []
  let found_comps : Map[String, String] = Map()
  for pf in pion_files {
    if !is_abi_library_pion(pf.0) {
      continue
    }
    if seen_comps.contains(pf.0) {
      found_comps[pf.0] = pf.1
    } else {
      gen_files.push(pf)
    }
  }
  for cf in companion_files {
    match found_comps.get(cf.path) {
      Some(ctxt) => {
        let actual_csha = content_sha256(ctxt)
        if actual_csha != cf.sha256 {
          diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            dep_path + "/" + cf.path,
            1,
            1,
            "companion file `" + cf.path + "` in dep `" + dep_name + "` sha256 mismatch (actual=" + actual_csha + " declared=" + cf.sha256 + ")",
          ))
          return None
        }
        match extract_header_abi_sha256(ctxt) {
          Some(hdr_sha) =>
          if hdr_sha != decl_abi_sha {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/" + cf.path,
              1,
              1,
              "companion file `" + cf.path + "` in dep `" + dep_name + "` carries mismatched `// abi-sha256:` header",
            ))
            return None
          }
          None => ()
        }
      }
      None => {
        diags.push(diag_error(
          "MBT2PION_DEP_ABI_ERROR",
          dep_path + "/" + cf.path,
          1,
          1,
          "declared companion file `" + cf.path + "` is missing in dep `" + dep_name + "`",
        ))
        return None
      }
    }
  }
  if gen_files.length() == 0 {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path,
      1,
      1,
      "dep `" + dep_name + "` has `mbt2pion_abi.json` but contains no generated library `.pion` files",
    ))
    return None
  }
  for pf in gen_files {
    match extract_header_abi_sha256(pf.1) {
      Some(hdr_sha) =>
      if hdr_sha != decl_abi_sha {
        diags.push(diag_error(
          "MBT2PION_DEP_ABI_ERROR",
          dep_path + "/" + pf.0,
          1,
          1,
          "header `// abi-sha256:` mismatch in dep `" + dep_name + "` file `" + pf.0 + "` (header=" + hdr_sha + " sidecar=" + decl_abi_sha + ")",
        ))
        return None
      }
      None => {
        diags.push(diag_error(
          "MBT2PION_DEP_ABI_ERROR",
          dep_path + "/" + pf.0,
          1,
          1,
          "dep `" + dep_name + "` file `" + pf.0 + "` is missing `// abi-sha256:` header (or is an undeclared companion)",
        ))
        return None
      }
    }
  }
  // Direction 2 (v2): sorted generated non-`*_test.pion` files SHA-256 MUST equal `files_sha256`!
  let actual_files_sha = compute_abi_files_sha256_v(gen_files, 2)
  if actual_files_sha != decl_files_sha {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "stale or tampered `.pion` files in dep `" + dep_name + "`: actual files_sha256 " + actual_files_sha + " != declared " + decl_files_sha,
    ))
    return None
  }
  // Cross-check declared `structs` type_params arity against generated `.pion` struct declarations!
  match parsed_structs {
    Some(sts) =>
    if sts.length() > 0 {
      let actual_tp_arity = collect_pion_struct_tparam_arity(gen_files)
      for st in sts {
        match actual_tp_arity.get(st.name) {
          Some(actual_ar) =>
          if actual_ar != st.type_params.length() {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "struct `" + st.name + "` in dep `" + dep_name + "` declares " + st.type_params.length().to_string() + " type params in ABI but `.pion` has " + actual_ar.to_string(),
            ))
            return None
          }
          None => {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "struct `" + st.name + "` declared in ABI `structs` does not exist in generated `.pion` files of dep `" + dep_name + "`",
            ))
            return None
          }
        }
      }
    }
    None => ()
  }
  Some(parsed)
}

///| Collect top-level `struct Name[...]` generic parameter counts from `.pion` files.
fn collect_pion_struct_tparam_arity(files : Array[(String, String)]) -> Map[String, Int] {
  let out : Map[String, Int] = Map()
  for pf in files {
    let toks = lex_moonbit(pf.1)
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "struct" &&
      i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        let sname = toks[i + 1].raw
        if i + 2 < n && toks[i + 2].kind == TokenKind::LBracket {
          let rb = find_matching_delim(toks, i + 2)
          let gparams = collect_generic_param_names(toks, i + 2, rb)
          out[sname] = gparams.length()
        } else {
          out[sname] = 0
        }
      }
      i = i + 1
    }
  }
  out
}

pub fn render_reexport_verify_anchor(reexports : Array[AbiReexport], dep_doc_jsons : Array[String]) -> String {
  if reexports.length() == 0 { return "" }
  let type_arity : Map[String, Int] = Map(); let generic_vals : Map[String, Bool] = Map()
  for dj in dep_doc_jsons {
    if dj.trim().length() == 0 { continue }
    let root = match json::parse(dj) { Ok(v) => v, Err(_) => continue }
    let pkgs = match json::obj_get(root, "packages") { Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }, None => continue }
    for pkg in pkgs {
      let pname = j_str(pkg, "name", "")
      let items = match json::obj_get(pkg, "items") { Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }, None => continue }
      for it in items {
        let k = j_str(it, "kind", ""); let nm = j_str(it, "name", ""); let sig = j_str(it, "sig", "")
        if pname.length() == 0 || nm.length() == 0 { continue }
        let key = pname + "::" + nm
        if k == "struct" || k == "enum" || k == "type" || k == "typealias" {
          let lb = sig.index_of("["); let lc = sig.index_of("{"); let lp = sig.index_of("(")
          let mut ar = 0
          if lb >= 0 && (lc < 0 || lb < lc) && (lp < 0 || lb < lp) {
            let mut j = lb + 1; let mut d = 0; let mut commas = 0; let mut has_tok = false
            while j < sig.length() {
              let c = sig.code_unit_at(j)
              if c == 91 { d = d + 1 } else if c == 93 { if d == 0 { if has_tok { ar = commas + 1 }; break } else { d = d - 1 } }
              else if c == 44 && d == 0 { commas = commas + 1 } else if c != 32 && c != 9 && c != 10 && c != 13 { has_tok = true }
              j = j + 1
            }
          }
          type_arity[key] = ar
        } else if k == "fn" { let lb = sig.index_of("["); let lp = sig.index_of("("); if lb >= 0 && (lp < 0 || lb < lp) { generic_vals[key] = true } }
      }
    }
  }
  let pkgs : Map[String, Bool] = Map()
  for r in reexports { pkgs[r.target_pkg] = true }
  let sb = StringBuilder()
  for p in sorted_map_keys(pkgs) { sb.write_string("import \"" + p + "\"\n") }
  sb.write_string("\nfn __mbt_verify_reexports_anchor(\n")
  let mut ti = 0
  for r in reexports {
    if r.kind == "type" {
      let key = r.target_pkg + "::" + r.target_name
      let ar = match type_arity.get(key) { Some(n) => n, None => 0 }
      let ts : Array[String] = []; let mut k = 0; while k < ar { ts.push("Int"); k = k + 1 }
      sb.write_string("  _t" + ti.to_string() + " : Option[" + key + (if ar > 0 { "[" + join_comma(ts) + "]" } else { "" }) + "],\n")
      ti = ti + 1
    }
  }
  sb.write_string(") -> Unit {\n")
  let mut vi = 0
  for r in reexports {
    if r.kind == "value" && !generic_vals.contains(r.target_pkg + "::" + r.target_name) {
      sb.write_string("  let _v" + vi.to_string() + " = " + r.target_pkg + "::" + r.target_name + "\n")
      vi = vi + 1
    }
  }
  sb.write_string("  ()\n}\n")
  sb.to_string()
}

// ---------------------------------------------------------------------------
// Track F4-3: Dual-Namespace `pub using` Canonical Provenance & Consumer Rewrite
// ---------------------------------------------------------------------------

struct DepPubIndexV2 {
  pub_types : Map[String, Map[String, Bool]]
  pub_values : Map[String, Map[String, Bool]]
  known_pkgs : Map[String, Bool]
  dep_re_type : Map[String, Map[String, AbiReexport]]
  dep_re_value : Map[String, Map[String, AbiReexport]]
}

fn build_dep_pub_index_v2(
  dep_doc_jsons : Array[String],
  dep_abis : Array[(String, PackageAbi)],
) -> DepPubIndexV2 {
  let pub_types : Map[String, Map[String, Bool]] = Map()
  let pub_values : Map[String, Map[String, Bool]] = Map()
  let known_pkgs : Map[String, Bool] = Map()
  let dep_re_type : Map[String, Map[String, AbiReexport]] = Map()
  let dep_re_value : Map[String, Map[String, AbiReexport]] = Map()
  for dj in dep_doc_jsons {
    if dj.trim().length() == 0 { continue }
    let root = match json::parse(dj) { Ok(v) => v, Err(_) => continue }
    let pkgs = match json::obj_get(root, "packages") {
      Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }
      None => continue
    }
    let last_i = pkgs.length() - 1
    let mut pi = 0
    for pkg in pkgs {
      let pname = j_str(pkg, "name", "")
      let is_root = pi == last_i
      pi = pi + 1
      if pname.length() == 0 { continue }
      if is_root { known_pkgs[pname] = true }
      let tmap = match pub_types.get(pname) {
        Some(m) => m
        None => { let m : Map[String, Bool] = Map(); pub_types[pname] = m; m }
      }
      let vmap = match pub_values.get(pname) {
        Some(m) => m
        None => { let m : Map[String, Bool] = Map(); pub_values[pname] = m; m }
      }
      let items = match json::obj_get(pkg, "items") {
        Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }
        None => continue
      }
      for it in items {
        let k = j_str(it, "kind", "")
        let nm = j_str(it, "name", "")
        if nm.length() == 0 { continue }
        if k == "struct" || k == "enum" || k == "type" || k == "typealias" {
          tmap[nm] = true
        } else if k == "fn" || k == "let" || k == "const" || k == "var" || k == "val" || k == "global" {
          vmap[nm] = true
        }
      }
    }
  }
  for pair in dep_abis {
    let dep_pkg = pair.0
    let abi = pair.1
    known_pkgs[dep_pkg] = true
    let tmap = match pub_types.get(dep_pkg) {
      Some(m) => m
      None => { let m : Map[String, Bool] = Map(); pub_types[dep_pkg] = m; m }
    }
    for en in abi.enums {
      tmap[en.name] = true
    }
    match abi.structs {
      Some(sts) => {
        for st in sts {
          tmap[st.name] = true
        }
      }
      None => ()
    }
    if abi.values.length() > 0 {
      let vmap = match pub_values.get(dep_pkg) {
        Some(m) => m
        None => { let m : Map[String, Bool] = Map(); pub_values[dep_pkg] = m; m }
      }
      for v in abi.values {
        vmap[v.name] = true
      }
    }
    if abi.reexports.length() > 0 {
      let rtmap : Map[String, AbiReexport] = Map()
      let rvmap : Map[String, AbiReexport] = Map()
      for r in abi.reexports {
        if r.kind == "type" {
          rtmap[r.name] = r
        } else if r.kind == "value" {
          rvmap[r.name] = r
        }
      }
      if rtmap.length() > 0 { dep_re_type[dep_pkg] = rtmap }
      if rvmap.length() > 0 { dep_re_value[dep_pkg] = rvmap }
    }
  }
  DepPubIndexV2::{
    pub_types: pub_types,
    pub_values: pub_values,
    known_pkgs: known_pkgs,
    dep_re_type: dep_re_type,
    dep_re_value: dep_re_value,
  }
}

///| Resolve `(start_pkg, start_name)` in the specified namespace (`"type"` or `"value"`)
///| to its canonical defining `(orig_pkg, orig_name)`. Fail-closed on cycles.
fn resolve_reexport_chain_v2(
  start_pkg : String,
  start_name : String,
  want_kind : String,
  idx : DepPubIndexV2,
  file : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Option[(String, String)] {
  let re_map = if want_kind == "type" { idx.dep_re_type } else { idx.dep_re_value }
  let mut cur_pkg = start_pkg
  let mut cur_name = start_name
  let visited : Map[String, Bool] = Map()
  while true {
    let vk = want_kind + ":" + cur_pkg + "::" + cur_name
    if visited.contains(vk) {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        file,
        line,
        col,
        "cyclic `pub using` (" + want_kind + ") involving `" + cur_pkg + "::" + cur_name + "`",
      ))
      return None
    }
    visited[vk] = true
    match re_map.get(cur_pkg) {
      Some(rmap) =>
      match rmap.get(cur_name) {
        Some(re) => {
          cur_pkg = re.target_pkg
          cur_name = re.target_name
        }
        None => break
      }
      None => break
    }
  }
  Some((cur_pkg, cur_name))
}

///| Dual-namespace, diamond-safe, fail-closed `pub using` pre-pass.
///| - Resolves `type` and `value` namespaces independently to canonical `(orig_pkg, orig_name)`.
///| - Allows diamond forwarding iff all paths converge to the identical canonical origin in the same namespace.
///| - Rejects private hops, cycles, conflicting origins, missing dep metadata, wrong kind, and unsupported forms.
pub fn preprocess_pub_using_v2(
  sources : Array[SourceFile],
  pkg_aliases : Map[String, String],
  moon_import_paths : Map[String, String],
  dep_doc_jsons : Array[String],
  dep_abis : Array[(String, PackageAbi)],
  diags : Array[Diag],
) -> (Array[SourceFile], Array[AbiReexport]) {
  let idx = build_dep_pub_index_v2(dep_doc_jsons, dep_abis)
  let out_sources : Array[SourceFile] = []
  let reexports : Array[AbiReexport] = []
  let seen_type_exports : Map[String, String] = Map()
  let seen_value_exports : Map[String, String] = Map()
  for sf in sources {
    let toks = lex_moonbit(sf.content)
    let n = toks.length() - 1
    let edits : Array[(Int, Int, String)] = []
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "pub" &&
      i + 3 < n && is_kw_or_id(toks[i + 1], "using") &&
      toks[i + 2].kind == TokenKind::PkgRef && toks[i + 3].kind == TokenKind::LBrace {
        let rb = find_matching_delim(toks, i + 3)
        match parse_using_block_items(toks, i + 3, rb) {
          Some(items) => {
            let raw_dep = toks[i + 2].raw.slice(1, toks[i + 2].raw.length())
            let dep_pkg = resolve_dep_pkg_alias(raw_dep, pkg_aliases, moon_import_paths, idx.known_pkgs)
            if !idx.known_pkgs.contains(dep_pkg) {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                sf.rel_path,
                t.line,
                t.col,
                "`pub using` references package `" + dep_pkg + "` whose metadata is missing (fail-closed)",
              ))
            } else {
              for it in items {
                let kind = it.0
                let nm = it.1
                match resolve_reexport_chain_v2(dep_pkg, nm, kind, idx, sf.rel_path, t.line, t.col, diags) {
                  Some((tpkg, tname)) => {
                    let ok = idx.known_pkgs.contains(tpkg) && (if kind == "type" {
                      match idx.pub_types.get(tpkg) { Some(m) => m.contains(tname), None => false }
                    } else {
                      match idx.pub_values.get(tpkg) { Some(m) => m.contains(tname), None => false }
                    })
                    if !ok {
                      diags.push(diag_error(
                        "MBT2PION_DEP_ABI_ERROR",
                        sf.rel_path,
                        t.line,
                        t.col,
                        "`pub using` target `" + tpkg + "::" + tname + "` (" + kind + ") missing, private, via private hop, or wrong kind",
                      ))
                    } else {
                      let sig = tpkg + "::" + tname
                      let seen_map = if kind == "type" { seen_type_exports } else { seen_value_exports }
                      match seen_map.get(nm) {
                        Some(prev) =>
                        if prev != sig {
                          diags.push(diag_error(
                            "MBT2PION_DEP_ABI_ERROR",
                            sf.rel_path,
                            t.line,
                            t.col,
                            "conflicting `pub using` (" + kind + ") for `" + nm + "`: `" + prev + "` vs `" + sig + "`",
                          ))
                        }
                        None => {
                          seen_map[nm] = sig
                          reexports.push(AbiReexport::{ name: nm, kind: kind, target_pkg: tpkg, target_name: tname })
                        }
                      }
                    }
                  }
                  None => ()
                }
              }
            }
            edits.push((toks[i].start_byte, toks[i + 1].start_byte, ""))
          }
          None =>
          diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            sf.rel_path,
            t.line,
            t.col,
            "unsupported item form inside `pub using` block (fail-closed)",
          ))
        }
        i = rb + 1
        continue
      }
      i = i + 1
    }
    out_sources.push(if edits.length() > 0 {
      SourceFile::{ rel_path: sf.rel_path, content: apply_byte_edits(sf.content, edits), is_test: sf.is_test }
    } else {
      sf
    })
  }
  (out_sources, sort_abi_reexports(reexports))
}

fn is_type_decl_lbrace(toks : Array[Token], lb_i : Int) -> Bool {
  let mut k = lb_i - 1
  if k >= 0 && toks[k].kind == TokenKind::RBracket {
    let mut bd = 1
    k = k - 1
    while k >= 0 && bd > 0 {
      if toks[k].kind == TokenKind::RBracket { bd = bd + 1 }
      else if toks[k].kind == TokenKind::LBracket { bd = bd - 1 }
      k = k - 1
    }
  }
  if k >= 1 && toks[k].kind == TokenKind::UpperIdent && toks[k - 1].kind == TokenKind::Keyword {
    let kw = toks[k - 1].raw
    return kw == "struct" || kw == "enum" || kw == "trait"
  }
  false
}

fn is_type_alias_eq_tok(toks : Array[Token], eq_i : Int, depth : Int) -> Bool {
  if depth != 0 || eq_i <= 0 || toks[eq_i].kind != TokenKind::Eq {
    return false
  }
  let mut k = eq_i - 1
  if k >= 0 && toks[k].kind == TokenKind::RBracket {
    let mut bd = 1
    k = k - 1
    while k >= 0 && bd > 0 {
      if toks[k].kind == TokenKind::RBracket { bd = bd + 1 }
      else if toks[k].kind == TokenKind::LBracket { bd = bd - 1 }
      k = k - 1
    }
  }
  k >= 1 && toks[k].kind == TokenKind::UpperIdent && toks[k - 1].kind == TokenKind::Keyword && toks[k - 1].raw == "type"
}

fn is_decl_colon_tok(toks : Array[Token], colon_i : Int, top_delim : String) -> Bool {
  if colon_i <= 0 || toks[colon_i].kind != TokenKind::Colon {
    return false
  }
  if top_delim == "type_brace" || top_delim == "paren" {
    return true
  }
  if colon_i >= 2 && (toks[colon_i - 1].kind == TokenKind::Ident || toks[colon_i - 1].kind == TokenKind::UpperIdent) {
    let mut p = colon_i - 2
    if p >= 0 && toks[p].kind == TokenKind::Keyword && toks[p].raw == "mut" {
      p = p - 1
    }
    if p >= 0 && toks[p].kind == TokenKind::Keyword {
      let kw = toks[p].raw
      return kw == "let" || kw == "const" || kw == "for"
    }
  }
  false
}

fn rewrite_reexport_snippet_v2(
  src : String,
  file : String,
  pkg_aliases : Map[String, String],
  moon_import_paths : Map[String, String],
  idx : DepPubIndexV2,
  allow_using : Bool,
  diags : Array[Diag],
) -> (String, Bool) {
  let toks = lex_moonbit(src)
  let n = toks.length() - 1
  let edits : Array[(Int, Int, String)] = []
  let delim_stack : Array[String] = []
  let mut i = 0
  let mut depth = 0
  while i < n {
    let t = toks[i]
    if t.kind == TokenKind::LBrace {
      if depth == 0 && is_type_decl_lbrace(toks, i) {
        delim_stack.push("type_brace")
      } else {
        delim_stack.push("expr_brace")
      }
      depth = depth + 1
      i = i + 1
      continue
    }
    if t.kind == TokenKind::RBrace {
      if delim_stack.length() > 0 { let _ = delim_stack.pop() }
      if depth > 0 { depth = depth - 1 }
      i = i + 1
      continue
    }
    if t.kind == TokenKind::LParen { delim_stack.push("paren"); i = i + 1; continue }
    if t.kind == TokenKind::RParen { if delim_stack.length() > 0 { let _ = delim_stack.pop() }; i = i + 1; continue }
    if t.kind == TokenKind::LBracket { delim_stack.push("bracket"); i = i + 1; continue }
    if t.kind == TokenKind::RBracket { if delim_stack.length() > 0 { let _ = delim_stack.pop() }; i = i + 1; continue }
    if allow_using && depth == 0 && is_kw_or_id(t, "using") &&
    i + 2 < n && toks[i + 1].kind == TokenKind::PkgRef && toks[i + 2].kind == TokenKind::LBrace {
      let rb = find_matching_delim(toks, i + 2)
      match parse_using_block_items(toks, i + 2, rb) {
        Some(items) => {
          let raw_pkg = toks[i + 1].raw.slice(1, toks[i + 1].raw.length())
          let dep_pkg = resolve_dep_pkg_alias(raw_pkg, pkg_aliases, moon_import_paths, idx.known_pkgs)
          let mut changed = dep_pkg != raw_pkg && idx.known_pkgs.contains(dep_pkg)
          let by_pkg : Map[String, Array[String]] = Map()
          let by_pkg_seen : Map[String, Map[String, Bool]] = Map()
          for it in items {
            let kind = it.0
            let nm = it.1
            let (tpkg, tname) = match resolve_reexport_chain_v2(dep_pkg, nm, kind, idx, file, t.line, t.col, diags) {
              Some(p) => p
              None => (dep_pkg, nm)
            }
            if tpkg != raw_pkg || tname != nm {
              changed = true
              if !idx.known_pkgs.contains(tpkg) {
                diags.push(diag_error(
                  "MBT2PION_DEP_ABI_ERROR",
                  file,
                  t.line,
                  t.col,
                  "missing transitive `--dep " + tpkg + "=...` for `" + nm + "`",
                ))
              }
            }
            let item_txt = if kind == "type" { "type " + tname } else { tname }
            let seen = match by_pkg_seen.get(tpkg) {
              Some(m) => m
              None => { let m : Map[String, Bool] = Map(); by_pkg_seen[tpkg] = m; m }
            }
            if !seen.contains(item_txt) {
              seen[item_txt] = true
              let arr = match by_pkg.get(tpkg) {
                Some(xs) => xs
                None => { let xs : Array[String] = []; by_pkg[tpkg] = xs; xs }
              }
              arr.push(item_txt)
            }
          }
          if changed {
            let sb = StringBuilder()
            let mut first = true
            for pk in sorted_map_keys(by_pkg) {
              if !first { sb.write_string("\n") }
              first = false
              let xs = match by_pkg.get(pk) { Some(v) => v, None => [] }
              sb.write_string("using @" + pk + " { " + join_comma(xs) + " }")
            }
            edits.push((toks[i].start_byte, toks[rb].end_byte, sb.to_string()))
          }
        }
        None => ()
      }
      i = rb + 1
      continue
    }
    if t.kind == TokenKind::PkgRef && i + 2 < n && toks[i + 1].kind == TokenKind::Dot &&
    (toks[i + 2].kind == TokenKind::UpperIdent || toks[i + 2].kind == TokenKind::Ident) {
      let raw_pkg = t.raw.slice(1, t.raw.length())
      let dep_pkg = resolve_dep_pkg_alias(raw_pkg, pkg_aliases, moon_import_paths, idx.known_pkgs)
      let nm = toks[i + 2].raw
      let t_opt : Option[AbiReexport] = match idx.dep_re_type.get(dep_pkg) { Some(m) => m.get(nm), None => None }
      let v_opt : Option[AbiReexport] = match idx.dep_re_value.get(dep_pkg) { Some(m) => m.get(nm), None => None }
      if t_opt is Some(_) || v_opt is Some(_) {
        let dep_has_local_type = match idx.pub_types.get(dep_pkg) { Some(m) => m.contains(nm), None => false }
        let dep_has_local_val = match idx.pub_values.get(dep_pkg) { Some(m) => m.contains(nm), None => false }
        let canon_type_opt : Option[(String, String)] = match t_opt {
          Some(_) => resolve_reexport_chain_v2(dep_pkg, nm, "type", idx, file, t.line, t.col, diags)
          None => if dep_has_local_type { Some((dep_pkg, nm)) } else { None }
        }
        let canon_val_opt : Option[(String, String)] = match v_opt {
          Some(_) => resolve_reexport_chain_v2(dep_pkg, nm, "value", idx, file, t.line, t.col, diags)
          None => if dep_has_local_val { Some((dep_pkg, nm)) } else { None }
        }
        let target_opt : Option[(String, String, Bool)] = match (canon_type_opt, canon_val_opt) {
          (Some((tp, tn)), None) => Some((tp, tn, t_opt is Some(_)))
          (None, Some((vp, vn))) => Some((vp, vn, v_opt is Some(_)))
          (Some((tp, tn)), Some((vp, vn))) =>
          if tp == vp && tn == vn {
            Some((tp, tn, t_opt is Some(_) || v_opt is Some(_)))
          } else {
            let top_d = if delim_stack.length() > 0 { delim_stack[delim_stack.length() - 1] } else { "" }
            let next_is_cc = i + 3 < n && toks[i + 3].kind == TokenKind::ColonColon
            let next_is_br = i + 3 < n && toks[i + 3].kind == TokenKind::LBracket
            let next_is_lp = i + 3 < n && toks[i + 3].kind == TokenKind::LParen
            let prev_is_alias_eq = i > 0 && toks[i - 1].kind == TokenKind::Eq && is_type_alias_eq_tok(toks, i - 1, depth)
            let prev_is_decl_col = i > 0 && toks[i - 1].kind == TokenKind::Colon && is_decl_colon_tok(toks, i - 1, top_d)
            let prev_is_expr_col = i > 0 && toks[i - 1].kind == TokenKind::Colon && top_d == "expr_brace" && !prev_is_decl_col
            let prev_is_type_ctx = prev_is_decl_col || prev_is_alias_eq ||
            (i > 0 && (toks[i - 1].kind == TokenKind::Arrow ||
              (toks[i - 1].kind == TokenKind::Keyword && (toks[i - 1].raw == "type" || toks[i - 1].raw == "as"))))
            let prev_is_val_op = prev_is_expr_col ||
            (i > 0 && ((toks[i - 1].kind == TokenKind::Eq && !prev_is_alias_eq) ||
              toks[i - 1].kind == TokenKind::Plus || toks[i - 1].kind == TokenKind::Minus ||
              toks[i - 1].kind == TokenKind::Star || toks[i - 1].kind == TokenKind::Slash ||
              toks[i - 1].kind == TokenKind::Percent || toks[i - 1].kind == TokenKind::EqEq ||
              toks[i - 1].kind == TokenKind::BangEq || toks[i - 1].kind == TokenKind::Lt ||
              toks[i - 1].kind == TokenKind::LtEq || toks[i - 1].kind == TokenKind::Gt ||
              toks[i - 1].kind == TokenKind::GtEq || toks[i - 1].kind == TokenKind::AmpAmp ||
              toks[i - 1].kind == TokenKind::PipePipe || toks[i - 1].kind == TokenKind::Bang ||
              (toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "return")))
            let next_is_val_op = i + 3 < n && (toks[i + 3].kind == TokenKind::Plus || toks[i + 3].kind == TokenKind::Minus ||
              toks[i + 3].kind == TokenKind::Star || toks[i + 3].kind == TokenKind::Slash || toks[i + 3].kind == TokenKind::Percent ||
              toks[i + 3].kind == TokenKind::EqEq || toks[i + 3].kind == TokenKind::BangEq || toks[i + 3].kind == TokenKind::Lt ||
              toks[i + 3].kind == TokenKind::LtEq || toks[i + 3].kind == TokenKind::Gt || toks[i + 3].kind == TokenKind::GtEq ||
              toks[i + 3].kind == TokenKind::AmpAmp || toks[i + 3].kind == TokenKind::PipePipe)
            if next_is_cc {
              Some((tp, tn, t_opt is Some(_)))
            } else if next_is_br {
              if prev_is_type_ctx && !prev_is_val_op {
                Some((tp, tn, t_opt is Some(_)))
              } else if prev_is_val_op && !prev_is_type_ctx {
                Some((vp, vn, v_opt is Some(_)))
              } else {
                diags.push(diag_error(
                  "MBT2PION_DEP_ABI_ERROR",
                  file,
                  t.line,
                  t.col,
                  "ambiguous dual-namespace bracketed reference `@" + raw_pkg + "." + nm + "[...]` (type `" + tp + "::" + tn + "` vs value `" + vp + "::" + vn + "`)",
                ))
                None
              }
            } else if prev_is_type_ctx && !prev_is_val_op && !next_is_val_op {
              Some((tp, tn, t_opt is Some(_)))
            } else if next_is_lp && toks[i + 2].kind == TokenKind::Ident && !prev_is_type_ctx {
              Some((vp, vn, v_opt is Some(_)))
            } else if !next_is_lp && (prev_is_val_op || next_is_val_op) && !prev_is_type_ctx {
              Some((vp, vn, v_opt is Some(_)))
            } else {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                file,
                t.line,
                t.col,
                "ambiguous dual-namespace reference `@" + raw_pkg + "." + nm + "` (type `" + tp + "::" + tn + "` vs value `" + vp + "::" + vn + "`)",
              ))
              None
            }
          }
          (None, None) => None
        }
        match target_opt {
          Some((tpkg, tname, should_rewrite)) =>
          if should_rewrite {
            if !idx.known_pkgs.contains(tpkg) {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                file,
                t.line,
                t.col,
                "missing transitive `--dep " + tpkg + "=...`",
              ))
            } else {
              edits.push((toks[i].start_byte, toks[i + 2].end_byte, "@" + tpkg + "." + tname))
            }
          }
          None => ()
        }
      }
      i = i + 3
      continue
    }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let is_ml = t.kind == TokenKind::InterpMultiline
      let mut any_ch = false
      let sb = StringBuilder()
      sb.write_string(if is_ml { "$|" } else { "\"" })
      for p in split_interp_string(t.raw, is_ml) {
        if p.is_expr {
          let (ns, ch) = rewrite_reexport_snippet_v2(p.text, file, pkg_aliases, moon_import_paths, idx, false, diags)
          if ch { any_ch = true }
          sb.write_string("\\{" + ns + "}")
        } else {
          sb.write_string(p.text)
        }
      }
      if !is_ml { sb.write_string("\"") }
      if any_ch { edits.push((t.start_byte, t.end_byte, sb.to_string())) }
    }
    i = i + 1
  }
  if edits.length() > 0 { (apply_byte_edits(src, edits), true) } else { (src, false) }
}

pub fn rewrite_dep_reexports_v2(
  sources : Array[SourceFile],
  pkg_aliases : Map[String, String],
  moon_import_paths : Map[String, String],
  dep_doc_jsons : Array[String],
  dep_abis : Array[(String, PackageAbi)],
  diags : Array[Diag],
) -> Array[SourceFile] {
  let idx = build_dep_pub_index_v2(dep_doc_jsons, dep_abis)
  if idx.dep_re_type.length() == 0 && idx.dep_re_value.length() == 0 && moon_import_paths.length() == 0 {
    return sources
  }
  let out : Array[SourceFile] = []
  for sf in sources {
    let (ns, ch) = rewrite_reexport_snippet_v2(sf.content, sf.rel_path, pkg_aliases, moon_import_paths, idx, true, diags)
    out.push(if ch { SourceFile::{ rel_path: sf.rel_path, content: ns, is_test: sf.is_test } } else { sf })
  }
  out
}

///| Canonical ABI enum schemas for standard compatibility types (e.g. `MbtJson`)
///| whose MoonBit constructors may carry trailing labeled/optional fields.
pub fn builtin_mbt_compat_enum_schemas() -> Array[AbiEnumSchema] {
  [
    AbiEnumSchema::{
      pkg: "mbt_compat",
      name: "MbtJson",
      can_match: true,
      can_construct: true,
      variants: [
        AbiEnumVariant::{ name: "Null", fields: [] },
        AbiEnumVariant::{ name: "True", fields: [] },
        AbiEnumVariant::{ name: "False", fields: [] },
        AbiEnumVariant::{
          name: "Number",
          fields: [
            AbiEnumField::{ label: "", ty: "Double" },
            AbiEnumField::{ label: "repr", ty: "Option[String]" },
          ],
        },
        AbiEnumVariant::{
          name: "String",
          fields: [AbiEnumField::{ label: "", ty: "String" }],
        },
        AbiEnumVariant::{
          name: "Array",
          fields: [AbiEnumField::{ label: "", ty: "Array[MbtJson]" }],
        },
        AbiEnumVariant::{
          name: "Object",
          fields: [AbiEnumField::{ label: "", ty: "OrderedMap[String, MbtJson]" }],
        },
      ],
    },
  ]
}
