///| Cross-package ABI metadata (`mbt2pion_abi.json`) with bidirectional SHA-256
///| verification, plus declarative `[comments]` redaction helpers.

import "json" as json

///| Sort `[comments]` replacement rules: longest `from` first, tie-break lexicographic.
pub fn sort_comment_rules(rules : Array[CommentReplaceRule]) -> Array[CommentReplaceRule] {
  let out : Array[CommentReplaceRule] = []
  for r in rules {
    out.push(r)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 {
      let la = out[j].from.length()
      let lb = key.from.length()
      let move_right = if la != lb { la < lb } else { str_cmp(out[j].from, key.from) > 0 }
      if move_right {
        out[j + 1] = out[j]
        j = j - 1
      } else {
        break
      }
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

///| Single-pass longest-match replacement on comment body text (never re-scans replaced text).
pub fn redact_comment_body(body : String, sorted_rules : Array[CommentReplaceRule]) -> String {
  if sorted_rules.length() == 0 || body.length() == 0 {
    return body
  }
  let n = body.length()
  let sb = StringBuilder()
  let mut pos = 0
  while pos < n {
    let mut matched = false
    for r in sorted_rules {
      let m = r.from.length()
      if m > 0 && pos + m <= n {
        let mut eq = true
        let mut k = 0
        while k < m {
          if body.code_unit_at(pos + k) != r.from.code_unit_at(k) {
            eq = false
            break
          }
          k = k + 1
        }
        if eq {
          sb.write_string(r.to)
          pos = pos + m
          matched = true
          break
        }
      }
    }
    if !matched {
      sb.write_byte(body.code_unit_at(pos).to_byte())
      pos = pos + 1
    }
  }
  sb.to_string()
}

///| Redact ONLY comment body text inside a token's `leading_trivia`, preserving
///| `//`, `///`, `///|`, `/*`, `*/`, and all whitespace verbatim.
pub fn redact_trivia(trivia : String, sorted_rules : Array[CommentReplaceRule]) -> String {
  if sorted_rules.length() == 0 || trivia.length() == 0 {
    return trivia
  }
  let n = trivia.length()
  let sb = StringBuilder()
  let mut i = 0
  while i < n {
    let c = trivia.code_unit_at(i)
    if c == 47 && i + 1 < n && trivia.code_unit_at(i + 1) == 47 {
      // Line comment: preserve `///|`, `///`, or `//` prefix verbatim
      let mut p_end = i + 2
      if p_end < n && trivia.code_unit_at(p_end) == 47 {
        p_end = p_end + 1
        if p_end < n && trivia.code_unit_at(p_end) == 124 {
          p_end = p_end + 1
        }
      }
      sb.write_string(trivia.slice(i, p_end))
      let mut eol = p_end
      while eol < n && trivia.code_unit_at(eol) != 10 && trivia.code_unit_at(eol) != 13 {
        eol = eol + 1
      }
      sb.write_string(redact_comment_body(trivia.slice(p_end, eol), sorted_rules))
      i = eol
    } else if c == 47 && i + 1 < n && trivia.code_unit_at(i + 1) == 42 {
      // Nested block comment `/* ... */`
      sb.write_string("/*")
      let body_start = i + 2
      let mut j = body_start
      let mut depth = 1
      while j < n && depth > 0 {
        let a = trivia.code_unit_at(j)
        if a == 47 && j + 1 < n && trivia.code_unit_at(j + 1) == 42 {
          depth = depth + 1
          j = j + 2
        } else if a == 42 && j + 1 < n && trivia.code_unit_at(j + 1) == 47 {
          depth = depth - 1
          if depth == 0 {
            sb.write_string(redact_comment_body(trivia.slice(body_start, j), sorted_rules))
            sb.write_string("*/")
            j = j + 2
            break
          }
          j = j + 2
        } else {
          j = j + 1
        }
      }
      if depth > 0 {
        sb.write_string(redact_comment_body(trivia.slice(body_start, n), sorted_rules))
      }
      i = j
    } else {
      sb.write_byte(c.to_byte())
      i = i + 1
    }
  }
  sb.to_string()
}

///| Apply `[comments]` redaction strictly to `leading_trivia` of original source tokens.
pub fn redact_tokens_comments(
  tokens : Array[Token],
  rules : Array[CommentReplaceRule],
) -> Array[Token] {
  if rules.length() == 0 {
    return tokens
  }
  let sorted = sort_comment_rules(rules)
  let out : Array[Token] = []
  for t in tokens {
    out.push(Token::{
      kind: t.kind,
      raw: t.raw,
      leading_trivia: redact_trivia(t.leading_trivia, sorted),
      newline_before: t.newline_before,
      line: t.line,
      col: t.col,
      start_byte: t.start_byte,
      end_byte: t.end_byte,
    })
  }
  out
}

// ---------------------------------------------------------------------------
// Cross-Package ABI Metadata (`mbt2pion_abi.json`) & Bidirectional SHA-256
// ---------------------------------------------------------------------------

fn sort_abi_enums(xs : Array[AbiEnumSchema]) -> Array[AbiEnumSchema] {
  let out : Array[AbiEnumSchema] = []
  for x in xs {
    out.push(x)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(out[j].name, key.name) > 0 {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

fn sort_abi_struct_vals(xs : Array[AbiStructValRename]) -> Array[AbiStructValRename] {
  let out : Array[AbiStructValRename] = []
  for x in xs {
    out.push(x)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(out[j].struct_name, key.struct_name) > 0 {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

fn sort_abi_companions(xs : Array[AbiCompanionFile]) -> Array[AbiCompanionFile] {
  let out : Array[AbiCompanionFile] = []
  for x in xs {
    out.push(x)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(out[j].path, key.path) > 0 {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

fn sort_abi_op_impls(xs : Array[OpImplEntry]) -> Array[OpImplEntry] {
  let out : Array[OpImplEntry] = []
  for x in xs {
    out.push(x)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 {
      let tc = str_cmp(out[j].type_name, key.type_name)
      let move_right = if tc != 0 { tc > 0 } else { str_cmp(out[j].op, key.op) > 0 }
      if move_right {
        out[j + 1] = out[j]
        j = j - 1
      } else {
        break
      }
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

fn sort_abi_reexports(xs : Array[AbiReexport]) -> Array[AbiReexport] {
  let out : Array[AbiReexport] = []
  for x in xs { out.push(x) }
  let mut i = 1
  while i < out.length() {
    let key = out[i]; let mut j = i - 1
    while j >= 0 && str_cmp(out[j].name, key.name) > 0 { out[j + 1] = out[j]; j = j - 1 }
    out[j + 1] = key; i = i + 1
  }
  out
}

///| Exact compiler-aligned library source check (`compiler/src/cli/main.pion:188`):
///| ONLY literal suffix `_test.pion` is excluded from library compilation; `*_wbtest.pion` IS included!
pub fn is_abi_library_pion(rel_path : String) -> Bool {
  rel_path.ends_with(".pion") && !rel_path.ends_with("_test.pion")
}

///| Validate a companion filename (flat `.pion` file, no path traversal, not `*_test.pion`).
pub fn is_valid_companion_name(name : String) -> Bool {
  if name.length() == 0 || !name.ends_with(".pion") || name.ends_with("_test.pion") {
    return false
  }
  if str_has(name, "/") || str_has(name, "\\") || str_has(name, "..") || name == "." {
    return false
  }
  true
}

///| Parse `[[abi.companions]]` entries from `recipes.toml` without touching `symbols.pion`.
pub fn parse_abi_companions_toml(
  content : String,
  path : String,
  diags : Array[Diag],
) -> Array[AbiCompanionSpec] {
  let out : Array[AbiCompanionSpec] = []
  let seen_names : Map[String, Bool] = Map()
  let mut in_comp = false
  let mut cur_name = ""
  let mut cur_src = ""
  let mut cur_sha = ""
  let mut cur_line = 1
  let flush_item = fn(ln : Int) -> Unit {
    if !in_comp {
      return
    }
    if cur_name.length() == 0 || cur_src.length() == 0 {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "`[[abi.companions]]` requires non-empty `name` and `source`",
      ))
      return
    }
    if !is_valid_companion_name(cur_name) {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "invalid companion `name` `" + cur_name + "` (must be a flat `.pion` filename, not `*_test.pion`, no `/` or `..`)",
      ))
      return
    }
    if seen_names.contains(cur_name) {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "duplicate `[[abi.companions]]` entry for `" + cur_name + "`",
      ))
      return
    }
    if cur_sha.length() > 0 && !is_valid_sha256_hex(cur_sha) {
      diags.push(diag_error(
        "MBT2PION_ABI_COMPANION_ERROR",
        path,
        ln,
        1,
        "invalid 64-hex `sha256` on companion `" + cur_name + "`",
      ))
      return
    }
    seen_names[cur_name] = true
    out.push(AbiCompanionSpec::{ name: cur_name, source: cur_src, sha256: cur_sha })
  }
  let lines = content.split("\n")
  let mut line_no = 0
  for raw_line in lines {
    line_no = line_no + 1
    let line = raw_line.trim()
    if line.length() == 0 || line.starts_with("#") {
      continue
    }
    if line.starts_with("[[") && line.ends_with("]]") {
      flush_item(cur_line)
      let sec = line.slice(2, line.length() - 2).trim()
      in_comp = sec == "abi.companions"
      cur_name = ""
      cur_src = ""
      cur_sha = ""
      cur_line = line_no
      continue
    }
    if line.starts_with("[") && line.ends_with("]") {
      flush_item(cur_line)
      in_comp = false
      continue
    }
    if !in_comp {
      continue
    }
    let eq_i = line.index_of("=")
    if eq_i <= 0 {
      continue
    }
    let k = line.slice(0, eq_i).trim()
    let v = unquote_toml(line.slice(eq_i + 1, line.length()).trim())
    if k == "name" {
      cur_name = v
    } else if k == "source" {
      cur_src = v
    } else if k == "sha256" {
      cur_sha = v
    } else {
      diags.push(diag_error(
        "MBT2PION_RECIPE_ERROR",
        path,
        line_no,
        1,
        "unknown key `" + k + "` in `[[abi.companions]]`",
      ))
    }
  }
  flush_item(cur_line)
  out
}

///| Validate a companion `.pion` file's public declarations:
///| rejects any `pub struct`/`pub enum` colliding with generated types,
///| any `pub struct` with an unmapped `val` field, or any `pub enum` with labeled variant fields.
pub fn validate_companion_declarations(
  comp_name : String,
  comp_content : String,
  gen_types : Map[String, Bool],
  diags : Array[Diag],
) -> Unit {
  let toks = lex_moonbit(comp_content)
  let n = toks.length() - 1
  let mut i = 0
  let mut depth = 0
  while i < n {
    let t = toks[i]
    if t.kind == TokenKind::LBrace {
      depth = depth + 1
      i = i + 1
      continue
    }
    if t.kind == TokenKind::RBrace {
      if depth > 0 { depth = depth - 1 }
      i = i + 1
      continue
    }
    if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "pub" {
      let mut k = i + 1
      if k < n && toks[k].kind == TokenKind::LParen {
        k = find_matching_delim(toks, k) + 1
      }
      if k + 1 < n && toks[k].kind == TokenKind::Keyword &&
      (toks[k].raw == "struct" || toks[k].raw == "enum") &&
      toks[k + 1].kind == TokenKind::UpperIdent {
        let is_struct = toks[k].raw == "struct"
        let tname = toks[k + 1].raw
        if gen_types.contains(tname) {
          diags.push(diag_error(
            "MBT2PION_ABI_COMPANION_ERROR",
            comp_name,
            toks[k + 1].line,
            toks[k + 1].col,
            "companion `" + comp_name + "` declares `pub " + toks[k].raw + " " + tname + "` colliding with a generated type",
          ))
        }
        let mut lb = k + 2
        while lb < n && toks[lb].kind != TokenKind::LBrace {
          lb = lb + 1
        }
        if lb < n && toks[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(toks, lb)
          if is_struct {
            let mut f = lb + 1
            let mut bd = 0
            while f < rb {
              let fk = toks[f].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { bd = bd + 1 }
              else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { if bd > 0 { bd = bd - 1 } }
              else if bd == 0 && toks[f].raw == "val" && f + 1 < rb && toks[f + 1].kind == TokenKind::Colon {
                diags.push(diag_error(
                  "MBT2PION_ABI_COMPANION_ERROR",
                  comp_name,
                  toks[f].line,
                  toks[f].col,
                  "companion `" + comp_name + "` declares `pub struct " + tname + "` with unmapped `val` field",
                ))
              }
              f = f + 1
            }
          } else {
            let mut f = lb + 1
            while f < rb {
              if toks[f].kind == TokenKind::LParen {
                let cp = find_matching_delim(toks, f)
                let mut p = f + 1
                while p + 1 < cp {
                  if (toks[p].kind == TokenKind::Ident || toks[p].kind == TokenKind::Keyword) &&
                  toks[p + 1].kind == TokenKind::Tilde {
                    diags.push(diag_error(
                      "MBT2PION_ABI_COMPANION_ERROR",
                      comp_name,
                      toks[p].line,
                      toks[p].col,
                      "companion `" + comp_name + "` declares `pub enum " + tname + "` with unmapped labeled variant field",
                    ))
                    break
                  }
                  p = p + 1
                }
                f = cp + 1
                continue
              }
              f = f + 1
            }
          }
          i = rb + 1
          continue
        }
      }
    }
    i = i + 1
  }
}

///| Collect all `struct`/`enum` type names declared in generated `.pion` files.
pub fn collect_generated_type_names(files : Array[GeneratedFile]) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  for gf in files {
    let toks = lex_moonbit(gf.content)
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Keyword && (t.raw == "struct" || t.raw == "enum") &&
      i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        out[toks[i + 1].raw] = true
      }
      i = i + 1
    }
  }
  out
}

fn abi_payload_to_json_opts(
  abi : PackageAbi,
  schema_ver : Int,
  include_publishable : Bool,
  include_reexports : Bool,
) -> json::JsonValue {
  let sorted_enums = sort_abi_enums(abi.enums)
  let enum_arr : Array[json::JsonValue] = []
  for en in sorted_enums {
    let var_arr : Array[json::JsonValue] = []
    for v in en.variants {
      let field_arr : Array[json::JsonValue] = []
      for f in v.fields {
        field_arr.push(json_obj([
          json_field("label", json_str(f.label)),
          json_field("ty", json_str(f.ty)),
        ]))
      }
      var_arr.push(json_obj([
        json_field("name", json_str(v.name)),
        json_field("fields", json_arr(field_arr)),
      ]))
    }
    enum_arr.push(json_obj([
      json_field("name", json_str(en.name)),
      json_field("can_match", json_bool(en.can_match)),
      json_field("can_construct", json_bool(en.can_construct)),
      json_field("variants", json_arr(var_arr)),
    ]))
  }
  let sorted_vals = sort_abi_struct_vals(abi.struct_val_fields)
  let val_arr : Array[json::JsonValue] = []
  for sv in sorted_vals {
    val_arr.push(json_obj([
      json_field("struct_name", json_str(sv.struct_name)),
      json_field("renamed_field", json_str(sv.renamed_field)),
    ]))
  }
  let fields : Array[json::JsonField] = [
    json_field("schema_version", json_int(schema_ver)),
    json_field("package", json_str(abi.package_name)),
    json_field("enums", json_arr(enum_arr)),
    json_field("struct_val_fields", json_arr(val_arr)),
  ]
  if schema_ver >= 2 && abi.companion_files.length() > 0 {
    let sorted_comps = sort_abi_companions(abi.companion_files)
    let comp_arr : Array[json::JsonValue] = []
    for cf in sorted_comps {
      comp_arr.push(json_obj([
        json_field("path", json_str(cf.path)),
        json_field("sha256", json_str(cf.sha256)),
      ]))
    }
    fields.push(json_field("companion_files", json_arr(comp_arr)))
  }
  if schema_ver >= 2 && abi.op_impls.length() > 0 {
    let sorted_ops = sort_abi_op_impls(abi.op_impls)
    let op_arr : Array[json::JsonValue] = []
    for op in sorted_ops {
      op_arr.push(json_obj([
        json_field("type_name", json_str(op.type_name)),
        json_field("op", json_str(op.op)),
        json_field("fn_name", json_str(op.fn_name)),
      ]))
    }
    fields.push(json_field("op_impls", json_arr(op_arr)))
  }
  if schema_ver >= 2 && (include_reexports || abi.reexports.length() > 0) {
    let re_arr : Array[json::JsonValue] = []
    for r in sort_abi_reexports(abi.reexports) {
      re_arr.push(json_obj([json_field("name", json_str(r.name)), json_field("kind", json_str(r.kind)), json_field("target_pkg", json_str(r.target_pkg)), json_field("target_name", json_str(r.target_name))]))
    }
    fields.push(json_field("reexports", json_arr(re_arr)))
  }
  if schema_ver >= 2 && include_publishable {
    fields.push(json_field("publishable", json_bool(abi.publishable)))
  }
  json_obj(fields)
}

fn abi_payload_to_json_versioned(abi : PackageAbi, schema_ver : Int) -> json::JsonValue {
  abi_payload_to_json_opts(abi, schema_ver, schema_ver >= 2, abi.reexports.length() > 0)
}

fn abi_payload_to_json(abi : PackageAbi) -> json::JsonValue {
  abi_payload_to_json_versioned(abi, 2)
}

///| Deterministic canonical JSON encoding of an ABI payload (schema v2).
pub fn render_canonical_abi_payload(abi : PackageAbi) -> String {
  json::stringify(abi_payload_to_json(abi))
}

///| SHA-256 of the canonical ABI payload for a specific schema version (1 or 2).
pub fn compute_abi_payload_sha256_v(abi : PackageAbi, schema_ver : Int) -> String {
  content_sha256(json::stringify(abi_payload_to_json_versioned(abi, schema_ver)))
}

///| SHA-256 of the canonical ABI v2 payload (embedded as `// abi-sha256: <hex>` in every `.pion` file).
pub fn compute_abi_payload_sha256(abi : PackageAbi) -> String {
  compute_abi_payload_sha256_v(abi, 2)
}

///| Deterministic SHA-256 over sorted `(rel_path, content)` `.pion` files.
///| v1 includes all `.pion` files; v2 includes all non-`*_test.pion` generated `.pion` files (keeping `*_wbtest.pion`).
pub fn compute_abi_files_sha256_v(files : Array[(String, String)], schema_ver : Int) -> String {
  let sorted : Array[(String, String)] = []
  for f in files {
    let keep = if schema_ver == 1 { f.0.ends_with(".pion") } else { is_abi_library_pion(f.0) }
    if keep {
      sorted.push(f)
    }
  }
  let mut i = 1
  while i < sorted.length() {
    let key = sorted[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(sorted[j].0, key.0) > 0 {
      sorted[j + 1] = sorted[j]
      j = j - 1
    }
    sorted[j + 1] = key
    i = i + 1
  }
  let sb = StringBuilder()
  for f in sorted {
    sb.write_string(f.0)
    sb.write_string(":")
    sb.write_string(f.1.length().to_string())
    sb.write_string(":")
    sb.write_string(content_sha256(f.1))
    sb.write_string("\n")
  }
  content_sha256(sb.to_string())
}

pub fn compute_abi_files_sha256(files : Array[(String, String)]) -> String {
  compute_abi_files_sha256_v(files, 2)
}

///| Extract `companion_files` (`path -> sha256`) from an existing `mbt2pion_abi.json` (returns empty map on error).
pub fn extract_abi_companion_hashes(raw_json : String) -> Map[String, String] {
  let out : Map[String, String] = Map()
  match json::parse(raw_json) {
    Ok(root) =>
    match json::obj_get(root, "payload") {
      Some(payload_v) =>
      match json::obj_get(payload_v, "companion_files") {
        Some(cfv) =>
        match json::as_arr(cfv) {
          Some(citems) => {
            for cit in citems {
              let cpath = j_str(cit, "path", "")
              let csha = j_str(cit, "sha256", "")
              if is_valid_companion_name(cpath) && is_valid_sha256_hex(csha) {
                out[cpath] = csha
              }
            }
          }
          None => ()
        }
        None => ()
      }
      None => ()
    }
    Err(_) => ()
  }
  out
}

///| Render the complete `mbt2pion_abi.json` sidecar (schema v2) for a published or audited package.
pub fn render_abi_json(
  abi : PackageAbi,
  final_pion_files : Array[(String, String)],
) -> String {
  let payload_v = abi_payload_to_json_versioned(abi, 2)
  let abi_sha = content_sha256(json::stringify(payload_v))
  let files_sha = compute_abi_files_sha256_v(final_pion_files, 2)
  let root = json_obj([
    json_field("schema_version", json_int(2)),
    json_field("package", json_str(abi.package_name)),
    json_field("abi_sha256", json_str(abi_sha)),
    json_field("files_sha256", json_str(files_sha)),
    json_field("payload", payload_v),
  ])
  json::stringify(root) + "\n"
}

///| Extract `// abi-sha256: <hex>` from the leading comment header of a `.pion` file.
pub fn extract_header_abi_sha256(content : String) -> Option[String] {
  let lines = content.split("\n")
  let prefix = "// abi-sha256: "
  for raw in lines {
    let ln = raw.trim()
    if ln.length() == 0 {
      continue
    }
    if !ln.starts_with("//") {
      break
    }
    if ln.starts_with(prefix) {
      return Some(ln.slice(prefix.length(), ln.length()).trim())
    }
  }
  None
}

///| Bidirectionally verify a `--dep` package's `mbt2pion_abi.json` against its `.pion` files.
///| - Ordinary hand-written Pion `--dep` (neither `// abi-sha256:` header nor `mbt2pion_abi.json`):
///|   returns `None` with zero diagnostics (full compatibility with hand-written deps).
///| - If EITHER `// abi-sha256:` OR `mbt2pion_abi.json` is present: enforces BOTH directions
///|   (`sha256(canonical(payload)) == abi_sha256 == every .pion header` AND `files_sha256 == sha256(sorted .pion)`),
///|   emitting `MBT2PION_DEP_ABI_ERROR` on any missing/mismatched/tampered/duplicate-label artifact!
pub fn verify_and_parse_dep_abi(
  dep_name : String,
  dep_path : String,
  pion_files : Array[(String, String)],
  abi_json_opt : Option[String],
  diags : Array[Diag],
) -> Option[PackageAbi] {
  let mut any_header = false
  for pf in pion_files {
    match extract_header_abi_sha256(pf.1) {
      Some(_) => any_header = true
      None => ()
    }
  }
  let has_sidecar = match abi_json_opt {
    Some(_) => true
    None => false
  }
  if !any_header && !has_sidecar {
    return None
  }
  let raw_json = match abi_json_opt {
    Some(s) => s
    None => {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path,
        1,
        1,
        "dep `" + dep_name + "` declares `// abi-sha256:` header in `.pion` files but `mbt2pion_abi.json` is missing",
      ))
      return None
    }
  }
  let root = match json::parse(raw_json) {
    Ok(v) => v
    Err(e) => {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path + "/mbt2pion_abi.json",
        1,
        1,
        "failed to parse `mbt2pion_abi.json` for dep `" + dep_name + "`: " + e,
      ))
      return None
    }
  }
  let sv = j_int(root, "schema_version", -1)
  if sv != 1 && sv != 2 {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "unsupported `mbt2pion_abi.json` schema_version for dep `" + dep_name + "` (expected 1 or 2)",
    ))
    return None
  }
  let decl_abi_sha = j_str(root, "abi_sha256", "")
  let decl_files_sha = j_str(root, "files_sha256", "")
  if !is_valid_sha256_hex(decl_abi_sha) || !is_valid_sha256_hex(decl_files_sha) {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "invalid `abi_sha256` or `files_sha256` in `mbt2pion_abi.json` for dep `" + dep_name + "`",
    ))
    return None
  }
  let payload_v = match json::obj_get(root, "payload") {
    Some(v) => v
    None => {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path + "/mbt2pion_abi.json",
        1,
        1,
        "missing `payload` in `mbt2pion_abi.json` for dep `" + dep_name + "`",
      ))
      return None
    }
  }
  let pkg_field = j_str(payload_v, "package", dep_name)
  let enums : Array[AbiEnumSchema] = []
  let seen_enums : Map[String, Bool] = Map()
  match json::obj_get(payload_v, "enums") {
    Some(ev) =>
    match json::as_arr(ev) {
      Some(eitems) => {
        for eit in eitems {
          let ename = j_str(eit, "name", "")
          if ename.length() == 0 {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "empty enum name in `mbt2pion_abi.json` for dep `" + dep_name + "`",
            ))
            return None
          }
          if seen_enums.contains(ename) {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "duplicate enum `" + ename + "` in `mbt2pion_abi.json` for dep `" + dep_name + "`",
            ))
            return None
          }
          seen_enums[ename] = true
          let can_match = j_bool(eit, "can_match", false)
          let can_construct = j_bool(eit, "can_construct", false)
          let variants : Array[AbiEnumVariant] = []
          let seen_vars : Map[String, Bool] = Map()
          match json::obj_get(eit, "variants") {
            Some(vv) =>
            match json::as_arr(vv) {
              Some(vitems) => {
                for vit in vitems {
                  let vname = j_str(vit, "name", "")
                  if vname.length() == 0 || seen_vars.contains(vname) {
                    diags.push(diag_error(
                      "MBT2PION_DEP_ABI_ERROR",
                      dep_path + "/mbt2pion_abi.json",
                      1,
                      1,
                      "invalid or duplicate variant `" + vname + "` on enum `" + ename + "` in dep `" + dep_name + "`",
                    ))
                    return None
                  }
                  seen_vars[vname] = true
                  let fields : Array[AbiEnumField] = []
                  let seen_labels : Map[String, Bool] = Map()
                  match json::obj_get(vit, "fields") {
                    Some(fv) =>
                    match json::as_arr(fv) {
                      Some(fitems) => {
                        for fit in fitems {
                          let flbl = j_str(fit, "label", "")
                          let fty = j_str(fit, "ty", "")
                          if flbl.length() > 0 {
                            if seen_labels.contains(flbl) {
                              diags.push(diag_error(
                                "MBT2PION_DEP_ABI_ERROR",
                                dep_path + "/mbt2pion_abi.json",
                                1,
                                1,
                                "duplicate label `" + flbl + "` on variant `" + ename + "::" + vname + "` in dep `" + dep_name + "`",
                              ))
                              return None
                            }
                            seen_labels[flbl] = true
                          }
                          fields.push(AbiEnumField::{ label: flbl, ty: fty })
                        }
                      }
                      None => ()
                    }
                    None => ()
                  }
                  variants.push(AbiEnumVariant::{ name: vname, fields: fields })
                }
              }
              None => ()
            }
            None => ()
          }
          enums.push(AbiEnumSchema::{
            pkg: dep_name,
            name: ename,
            can_match: can_match,
            can_construct: can_construct,
            variants: variants,
          })
        }
      }
      None => ()
    }
    None => ()
  }
  let struct_vals : Array[AbiStructValRename] = []
  let seen_svals : Map[String, Bool] = Map()
  match json::obj_get(payload_v, "struct_val_fields") {
    Some(svv) =>
    match json::as_arr(svv) {
      Some(sitems) => {
        for sit in sitems {
          let sname = j_str(sit, "struct_name", "")
          let rfield = j_str(sit, "renamed_field", "")
          if sname.length() == 0 || rfield.length() == 0 || seen_svals.contains(sname) {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/mbt2pion_abi.json",
              1,
              1,
              "invalid or duplicate `struct_val_fields` entry `" + sname + "` in dep `" + dep_name + "`",
            ))
            return None
          }
          seen_svals[sname] = true
          struct_vals.push(AbiStructValRename::{
            pkg: dep_name,
            struct_name: sname,
            renamed_field: rfield,
          })
        }
      }
      None => ()
    }
    None => ()
  }

  let companion_files : Array[AbiCompanionFile] = []
  let seen_comps : Map[String, String] = Map()
  if sv >= 2 {
    match json::obj_get(payload_v, "companion_files") {
      Some(cfv) =>
      match json::as_arr(cfv) {
        Some(citems) => {
          for cit in citems {
            let cpath = j_str(cit, "path", "")
            let csha = j_str(cit, "sha256", "")
            if !is_valid_companion_name(cpath) || !is_valid_sha256_hex(csha) || seen_comps.contains(cpath) {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "invalid or duplicate `companion_files` entry `" + cpath + "` in dep `" + dep_name + "`",
              ))
              return None
            }
            seen_comps[cpath] = csha
            companion_files.push(AbiCompanionFile::{ path: cpath, sha256: csha })
          }
        }
        None => ()
      }
      None => ()
    }
  }
  let op_impls : Array[OpImplEntry] = []
  let seen_ops : Map[String, Bool] = Map()
  if sv >= 2 {
    match json::obj_get(payload_v, "op_impls") {
      Some(oiv) =>
      match json::as_arr(oiv) {
        Some(oitems) => {
          for oit in oitems {
            let tname = j_str(oit, "type_name", "")
            let op_name = j_str(oit, "op", "")
            let fn_name = j_str(oit, "fn_name", "")
            let op_ok = op_name == "add" || op_name == "sub" || op_name == "mul" || op_name == "neg" || op_name == "div"
            let okey = tname + "|" + op_name
            if tname.length() == 0 || !op_ok || fn_name.length() == 0 || seen_ops.contains(okey) {
              diags.push(diag_error(
                "MBT2PION_DEP_ABI_ERROR",
                dep_path + "/mbt2pion_abi.json",
                1,
                1,
                "invalid or duplicate `op_impls` entry `" + tname + "::" + op_name + "` in dep `" + dep_name + "`",
              ))
              return None
            }
            seen_ops[okey] = true
            op_impls.push(OpImplEntry::{
              pkg: dep_name,
              type_name: tname,
              op: op_name,
              fn_name: fn_name,
            })
          }
        }
        None => ()
      }
      None => ()
    }
  }

  let reexports : Array[AbiReexport] = []
  let seen_reexports : Map[String, Bool] = Map()
  let mut has_reexports_field = false
  if sv >= 2 {
    match json::obj_get(payload_v, "reexports") {
      Some(rev) => {
        has_reexports_field = true
        let ritems = match json::as_arr(rev) { Some(a) => a, None => { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid `reexports` field in dep `" + dep_name + "`")); return None } }
        for rit in ritems {
          let rn = j_str(rit, "name", ""); let rk = j_str(rit, "kind", ""); let rp = j_str(rit, "target_pkg", ""); let rt = j_str(rit, "target_name", "")
          if rn.length() == 0 || (rk != "type" && rk != "value") || rp.length() == 0 || rt.length() == 0 || seen_reexports.contains(rn) {
            diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", dep_path + "/mbt2pion_abi.json", 1, 1, "invalid or duplicate `reexports` entry `" + rn + "` in dep `" + dep_name + "`"))
            return None
          }
          seen_reexports[rn] = true
          reexports.push(AbiReexport::{ name: rn, kind: rk, target_pkg: rp, target_name: rt })
        }
      }
      None => ()
    }
  }

  let has_pub_field = match json::obj_get(payload_v, "publishable") {
    Some(_) => true
    None => false
  }
  let is_publishable = if sv >= 2 { j_bool(payload_v, "publishable", true) } else { true }

  let parsed = PackageAbi::{
    package_name: pkg_field,
    enums: enums,
    struct_val_fields: struct_vals,
    companion_files: companion_files,
    op_impls: op_impls,
    reexports: reexports,
    publishable: is_publishable,
  }
  // Direction 1: canonical payload SHA-256 MUST equal `abi_sha256`!
  let actual_abi_sha = content_sha256(json::stringify(abi_payload_to_json_opts(parsed, sv, has_pub_field, has_reexports_field)))
  if actual_abi_sha != decl_abi_sha {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "tampered `mbt2pion_abi.json` for dep `" + dep_name + "`: payload sha256 " + actual_abi_sha + " != declared " + decl_abi_sha,
    ))
    return None
  }
  if sv == 1 {
    if pion_files.length() == 0 {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path,
        1,
        1,
        "dep `" + dep_name + "` has `mbt2pion_abi.json` but contains no `.pion` files",
      ))
      return None
    }
    for pf in pion_files {
      match extract_header_abi_sha256(pf.1) {
        Some(hdr_sha) =>
        if hdr_sha != decl_abi_sha {
          diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            dep_path + "/" + pf.0,
            1,
            1,
            "header `// abi-sha256:` mismatch in dep `" + dep_name + "` file `" + pf.0 + "` (header=" + hdr_sha + " sidecar=" + decl_abi_sha + ")",
          ))
          return None
        }
        None => {
          diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            dep_path + "/" + pf.0,
            1,
            1,
            "dep `" + dep_name + "` file `" + pf.0 + "` is missing `// abi-sha256:` header required by `mbt2pion_abi.json`",
          ))
          return None
        }
      }
    }
    // Direction 2 (v1): sorted `.pion` files SHA-256 MUST equal `files_sha256`!
    let actual_files_sha = compute_abi_files_sha256_v(pion_files, 1)
    if actual_files_sha != decl_files_sha {
      diags.push(diag_error(
        "MBT2PION_DEP_ABI_ERROR",
        dep_path + "/mbt2pion_abi.json",
        1,
        1,
        "stale or tampered `.pion` files in dep `" + dep_name + "`: actual files_sha256 " + actual_files_sha + " != declared " + decl_files_sha,
      ))
      return None
    }
    return Some(parsed)
  }

  // Schema v2: partition non-`*_test.pion` files (keeping `*_wbtest.pion`!) into generated vs declared companions.
  let gen_files : Array[(String, String)] = []
  let found_comps : Map[String, String] = Map()
  for pf in pion_files {
    if !is_abi_library_pion(pf.0) {
      continue
    }
    if seen_comps.contains(pf.0) {
      found_comps[pf.0] = pf.1
    } else {
      gen_files.push(pf)
    }
  }
  for cf in companion_files {
    match found_comps.get(cf.path) {
      Some(ctxt) => {
        let actual_csha = content_sha256(ctxt)
        if actual_csha != cf.sha256 {
          diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            dep_path + "/" + cf.path,
            1,
            1,
            "companion file `" + cf.path + "` in dep `" + dep_name + "` sha256 mismatch (actual=" + actual_csha + " declared=" + cf.sha256 + ")",
          ))
          return None
        }
        match extract_header_abi_sha256(ctxt) {
          Some(hdr_sha) =>
          if hdr_sha != decl_abi_sha {
            diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              dep_path + "/" + cf.path,
              1,
              1,
              "companion file `" + cf.path + "` in dep `" + dep_name + "` carries mismatched `// abi-sha256:` header",
            ))
            return None
          }
          None => ()
        }
      }
      None => {
        diags.push(diag_error(
          "MBT2PION_DEP_ABI_ERROR",
          dep_path + "/" + cf.path,
          1,
          1,
          "declared companion file `" + cf.path + "` is missing in dep `" + dep_name + "`",
        ))
        return None
      }
    }
  }
  if gen_files.length() == 0 {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path,
      1,
      1,
      "dep `" + dep_name + "` has `mbt2pion_abi.json` but contains no generated library `.pion` files",
    ))
    return None
  }
  for pf in gen_files {
    match extract_header_abi_sha256(pf.1) {
      Some(hdr_sha) =>
      if hdr_sha != decl_abi_sha {
        diags.push(diag_error(
          "MBT2PION_DEP_ABI_ERROR",
          dep_path + "/" + pf.0,
          1,
          1,
          "header `// abi-sha256:` mismatch in dep `" + dep_name + "` file `" + pf.0 + "` (header=" + hdr_sha + " sidecar=" + decl_abi_sha + ")",
        ))
        return None
      }
      None => {
        diags.push(diag_error(
          "MBT2PION_DEP_ABI_ERROR",
          dep_path + "/" + pf.0,
          1,
          1,
          "dep `" + dep_name + "` file `" + pf.0 + "` is missing `// abi-sha256:` header (or is an undeclared companion)",
        ))
        return None
      }
    }
  }
  // Direction 2 (v2): sorted generated non-`*_test.pion` files SHA-256 MUST equal `files_sha256`!
  let actual_files_sha = compute_abi_files_sha256_v(gen_files, 2)
  if actual_files_sha != decl_files_sha {
    diags.push(diag_error(
      "MBT2PION_DEP_ABI_ERROR",
      dep_path + "/mbt2pion_abi.json",
      1,
      1,
      "stale or tampered `.pion` files in dep `" + dep_name + "`: actual files_sha256 " + actual_files_sha + " != declared " + decl_files_sha,
    ))
    return None
  }
  Some(parsed)
}

pub fn render_reexport_verify_anchor(reexports : Array[AbiReexport], dep_doc_jsons : Array[String]) -> String {
  if reexports.length() == 0 { return "" }
  let type_arity : Map[String, Int] = Map(); let generic_vals : Map[String, Bool] = Map()
  for dj in dep_doc_jsons {
    if dj.trim().length() == 0 { continue }
    let root = match json::parse(dj) { Ok(v) => v, Err(_) => continue }
    let pkgs = match json::obj_get(root, "packages") { Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }, None => continue }
    for pkg in pkgs {
      let pname = j_str(pkg, "name", "")
      let items = match json::obj_get(pkg, "items") { Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }, None => continue }
      for it in items {
        let k = j_str(it, "kind", ""); let nm = j_str(it, "name", ""); let sig = j_str(it, "sig", "")
        if pname.length() == 0 || nm.length() == 0 { continue }
        let key = pname + "::" + nm
        if k == "struct" || k == "enum" || k == "type" || k == "typealias" {
          let lb = sig.index_of("["); let lc = sig.index_of("{"); let lp = sig.index_of("(")
          let mut ar = 0
          if lb >= 0 && (lc < 0 || lb < lc) && (lp < 0 || lb < lp) {
            let mut j = lb + 1; let mut d = 0; let mut commas = 0; let mut has_tok = false
            while j < sig.length() {
              let c = sig.code_unit_at(j)
              if c == 91 { d = d + 1 } else if c == 93 { if d == 0 { if has_tok { ar = commas + 1 }; break } else { d = d - 1 } }
              else if c == 44 && d == 0 { commas = commas + 1 } else if c != 32 && c != 9 && c != 10 && c != 13 { has_tok = true }
              j = j + 1
            }
          }
          type_arity[key] = ar
        } else if k == "fn" { let lb = sig.index_of("["); let lp = sig.index_of("("); if lb >= 0 && (lp < 0 || lb < lp) { generic_vals[key] = true } }
      }
    }
  }
  let pkgs : Map[String, Bool] = Map()
  for r in reexports { pkgs[r.target_pkg] = true }
  let sb = StringBuilder()
  for p in sorted_map_keys(pkgs) { sb.write_string("import \"" + p + "\"\n") }
  sb.write_string("\nfn __mbt_verify_reexports_anchor(\n")
  let mut ti = 0
  for r in reexports {
    if r.kind == "type" {
      let key = r.target_pkg + "::" + r.target_name
      let ar = match type_arity.get(key) { Some(n) => n, None => 0 }
      let ts : Array[String] = []; let mut k = 0; while k < ar { ts.push("Int"); k = k + 1 }
      sb.write_string("  _t" + ti.to_string() + " : Option[" + key + (if ar > 0 { "[" + join_comma(ts) + "]" } else { "" }) + "],\n")
      ti = ti + 1
    }
  }
  sb.write_string(") -> Unit {\n")
  let mut vi = 0
  for r in reexports {
    if r.kind == "value" && !generic_vals.contains(r.target_pkg + "::" + r.target_name) {
      sb.write_string("  let _v" + vi.to_string() + " = " + r.target_pkg + "::" + r.target_name + "\n")
      vi = vi + 1
    }
  }
  sb.write_string("  ()\n}\n")
  sb.to_string()
}
