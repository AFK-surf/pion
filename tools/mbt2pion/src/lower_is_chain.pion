///| Track F3d-3 isolated lowering module:
///| 1. `if`/`guard <expr> is <struct-pat> [as alias] && <cond>` lowering to nested `match`.
///| 2. Strictly sound exhaustive array-slice `match` analysis (no guard, irrefutable elements,
///|    exact coverage of all non-negative lengths).

///| Return true if pattern token range `[start, end)` contains any `as` keyword
///| (excluding array rest-slice `.. as rest`).
fn pattern_contains_as_kw(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut k = start
  while k < end {
    if tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "as" {
      if !(k > start && tokens[k - 1].kind == TokenKind::DotDot) {
        return true
      }
    }
    k = k + 1
  }
  false
}

///| Find depth-0 `is` keyword in `[start, end)`, or `-1` if absent.
fn find_top_level_is_kw(tokens : Array[Token], start : Int, end : Int) -> Int {
  let mut k = start
  let mut d = 0
  while k < end {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    } else if d == 0 && kk == TokenKind::Keyword && tokens[k].raw == "is" {
      return k
    }
    k = k + 1
  }
  -1
}

///| Split `[start, end)` by depth-0 `&&` into `(seg_start, seg_end)` ranges.
///| Returns empty array if any depth-0 `||` is present.
fn split_cond_ampamp_segs(tokens : Array[Token], start : Int, end : Int) -> Array[(Int, Int)] {
  let segs : Array[(Int, Int)] = []
  let mut seg_s = start
  let mut k = start
  let mut d = 0
  while k < end {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    } else if d == 0 && kk == TokenKind::PipePipe {
      return []
    } else if d == 0 && kk == TokenKind::AmpAmp {
      if k > seg_s {
        segs.push((seg_s, k))
      }
      seg_s = k + 1
    }
    k = k + 1
  }
  if end > seg_s {
    segs.push((seg_s, end))
  }
  segs
}

///| Return true if pattern token range `[start, end)` has a top-level `|` (after stripping outer parens).
fn pattern_has_top_pipe(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut ps = start
  let mut pe = end
  while ps + 1 < pe && tokens[ps].kind == TokenKind::LParen && find_matching_delim(tokens, ps) == pe - 1 {
    ps = ps + 1
    pe = pe - 1
  }
  let mut k = ps
  let mut d = 0
  while k < pe {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    } else if d == 0 && kk == TokenKind::Pipe {
      return true
    }
    k = k + 1
  }
  false
}

///| Check whether a condition `[start, end)` in `if` or `guard` contains an `is` segment
///| whose pattern uses struct destructuring `{ ... }` (without top-level `|` or-pattern)
///| or `as` aliasing and therefore requires nested `match` lowering instead of Pion's built-in `is`.
fn cond_needs_is_chain_lowering(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let segs = split_cond_ampamp_segs(tokens, start, end)
  if segs.length() == 0 {
    return false
  }
  for seg in segs {
    let (ss, se) = seg
    let is_i = find_top_level_is_kw(tokens, ss, se)
    if is_i > ss && is_i + 1 < se {
      if !pattern_has_top_pipe(tokens, is_i + 1, se) {
        if pattern_contains_as_kw(tokens, is_i + 1, se) {
          return true
        }
        if pattern_contains_struct_pat(tokens, is_i + 1, se) {
          return true
        }
      }
    }
  }
  false
}

///| Fail-closed check: reject top-level `|` or-patterns combined with `as` in `if`/`guard` `is` conditions.
fn check_unsupported_pipe_as_in_cond(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> Bool {
  let segs = split_cond_ampamp_segs(tokens, start, end)
  for seg in segs {
    let (ss, se) = seg
    let is_i = find_top_level_is_kw(tokens, ss, se)
    if is_i > ss && is_i + 1 < se {
      if pattern_has_top_pipe(tokens, is_i + 1, se) && pattern_contains_as_kw(tokens, is_i + 1, se) {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          tokens[is_i].line,
          tokens[is_i].col,
          "top-level or-pattern `|` combined with `as` binding in `is` condition is not supported (fail-closed)",
        ))
        return true
      }
    }
  }
  false
}

///| Find depth-0 `as <ident>` at the tail of pattern `[start, end)`, returning index of `as` or `-1`
///| (excluding array rest-slice `.. as rest`).
fn find_top_level_as_kw(tokens : Array[Token], start : Int, end : Int) -> Int {
  let mut k = start
  let mut d = 0
  while k < end {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    } else if d == 0 && kk == TokenKind::Keyword && tokens[k].raw == "as" {
      if !(k > start && tokens[k - 1].kind == TokenKind::DotDot) {
        return k
      }
    }
    k = k + 1
  }
  -1
}

fn range_has_top_comma(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut k = start
  let mut d = 0
  while k < end {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    } else if d == 0 && kk == TokenKind::Comma {
      return true
    }
    k = k + 1
  }
  false
}

///| Peel outermost nested `as` bindings inside `(...)` and `[...]` sub-patterns of `[start, end)`
///| (excluding `{ ... } as alias` which `peel_struct_patterns_in_pat` handles, and excluding `.. as rest`).
///| Returns `(rewritten_tokens_with_eof, [(alias_var, sub_pat_start, sub_pat_end)])`.
fn peel_nested_as_tokens(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
  as_obls : Array[(String, Int, Int)],
) -> Array[Token] {
  if pattern_has_top_pipe(tokens, start, end) && pattern_contains_as_kw(tokens, start, end) {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      tokens[start].line,
      tokens[start].col,
      "or-pattern `|` combined with nested `as` binding inside `is`-chain is not supported (fail-closed)",
    ))
    return []
  }
  let out : Array[Token] = []
  let mut k = start
  while k < end {
    let tk = tokens[k].kind
    if tk == TokenKind::LBrace {
      // Leave `{ ... }` (and optional trailing `as ident`) untouched for `peel_struct_patterns_in_pat`
      let cb = find_matching_delim(tokens, k)
      let mut m = k
      while m <= cb && m < end {
        out.push(tokens[m])
        m = m + 1
      }
      if cb + 2 < end && tokens[cb + 1].kind == TokenKind::Keyword && tokens[cb + 1].raw == "as" &&
      (tokens[cb + 2].kind == TokenKind::Ident || tokens[cb + 2].kind == TokenKind::Underscore) {
        out.push(tokens[cb + 1])
        out.push(tokens[cb + 2])
        k = cb + 3
      } else {
        k = cb + 1
      }
      continue
    }
    if tk == TokenKind::LParen || tk == TokenKind::LBracket {
      let cp = find_matching_delim(tokens, k)
      if cp < end && pattern_contains_as_kw(tokens, k + 1, cp) {
        out.push(tokens[k])
        let mut item_s = k + 1
        while item_s < cp {
          if tokens[item_s].kind == TokenKind::Comma {
            out.push(tokens[item_s])
            item_s = item_s + 1
            continue
          }
          let mut item_e = item_s
          let mut d = 0
          while item_e < cp {
            let ik = tokens[item_e].kind
            if ik == TokenKind::LParen || ik == TokenKind::LBracket || ik == TokenKind::LBrace { d = d + 1 }
            else if ik == TokenKind::RParen || ik == TokenKind::RBracket || ik == TokenKind::RBrace { if d > 0 { d = d - 1 } }
            else if d == 0 && ik == TokenKind::Comma { break }
            item_e = item_e + 1
          }
          let mut val_s = item_s
          let val_e = item_e
          // Preserve optional labeled argument prefix `label=` inside constructor patterns
          if (tokens[val_s].kind == TokenKind::Ident || tokens[val_s].kind == TokenKind::Keyword) &&
          val_s + 1 < val_e && tokens[val_s + 1].kind == TokenKind::Eq {
            out.push(tokens[val_s])
            out.push(tokens[val_s + 1])
            val_s = val_s + 2
          }
          // Strip balanced outer grouping parens around `[val_s, val_e)` (NEVER strip tuple parens `(a, b)`!)
          let mut ps = val_s
          let mut pe = val_e
          while ps + 1 < pe && tokens[ps].kind == TokenKind::LParen &&
          find_matching_delim(tokens, ps) == pe - 1 &&
          !range_has_top_comma(tokens, ps + 1, pe - 1) {
            ps = ps + 1
            pe = pe - 1
          }
          let top_as = find_top_level_as_kw(tokens, ps, pe)
          // Check if the sub-pattern before `as` is a direct struct pattern `{ ... }` or `S::{ ... }`
          let is_direct_struct_as = if top_as > ps {
            (tokens[ps].kind == TokenKind::LBrace && find_matching_delim(tokens, ps) == top_as - 1) ||
            (ps + 2 < top_as && tokens[ps].kind == TokenKind::UpperIdent &&
              tokens[ps + 1].kind == TokenKind::ColonColon && tokens[ps + 2].kind == TokenKind::LBrace &&
              find_matching_delim(tokens, ps + 2) == top_as - 1)
          } else {
            false
          }
          if pattern_has_top_pipe(tokens, ps, pe) && pattern_contains_as_kw(tokens, ps, pe) {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              tokens[ps].line,
              tokens[ps].col,
              "or-pattern `|` combined with nested `as` binding inside `is`-chain is not supported (fail-closed)",
            ))
          } else if top_as > ps && !is_direct_struct_as {
            if top_as + 2 != pe || (tokens[top_as + 1].kind != TokenKind::Ident && tokens[top_as + 1].kind != TokenKind::Underscore) {
              ctx.diags.push(diag_error(
                "MBT2PION_UNSUPPORTED_SYNTAX",
                file,
                tokens[top_as].line,
                tokens[top_as].col,
                "unsupported nested `as` alias form inside `is`-chain pattern (fail-closed)",
              ))
            } else if pattern_has_top_pipe(tokens, ps, top_as) {
              ctx.diags.push(diag_error(
                "MBT2PION_UNSUPPORTED_SYNTAX",
                file,
                tokens[top_as].line,
                tokens[top_as].col,
                "or-pattern `|` combined with nested `as` binding inside `is`-chain is not supported (fail-closed)",
              ))
            } else {
              let alias_tok = tokens[top_as + 1]
              let is_wild = alias_tok.kind == TokenKind::Underscore || alias_tok.raw == "_"
              let raw_emit_name = if is_wild {
                let tmp = fresh_temp(ctx, "as")
                ctx.synth_sp_temps[tmp] = true
                tmp
              } else {
                alias_tok.raw
              }
              let resolved_alias = if is_wild { raw_emit_name } else { resolve_ident_in_scope(ctx, raw_emit_name) }
              out.push(Token::{
                kind: TokenKind::Ident,
                raw: raw_emit_name,
                leading_trivia: tokens[val_s].leading_trivia,
                newline_before: tokens[val_s].newline_before,
                line: tokens[val_s].line,
                col: tokens[val_s].col,
                start_byte: tokens[val_s].start_byte,
                end_byte: tokens[val_e - 1].end_byte,
              })
              as_obls.push((resolved_alias, ps, top_as))
            }
          } else if pattern_contains_as_kw(tokens, val_s, val_e) {
            let sub_toks = peel_nested_as_tokens(ctx, tokens, val_s, val_e, file, as_obls)
            let mut si = 0
            while si < sub_toks.length() {
              out.push(sub_toks[si])
              si = si + 1
            }
          } else {
            let mut m = val_s
            while m < val_e {
              out.push(tokens[m])
              m = m + 1
            }
          }
          if item_e < cp && tokens[item_e].kind == TokenKind::Comma {
            out.push(tokens[item_e])
            item_s = item_e + 1
          } else {
            item_s = item_e
          }
        }
        out.push(tokens[cp])
        k = cp + 1
        continue
      }
    }
    out.push(tokens[k])
    k = k + 1
  }
  out
}

fn finish_peeled_tokens(toks : Array[Token]) -> Array[Token] {
  let res : Array[Token] = []
  for t in toks {
    res.push(t)
  }
  res.push(Token::{
    kind: TokenKind::Eof,
    raw: "",
    leading_trivia: "",
    newline_before: false,
    line: 1,
    col: 1,
    start_byte: 0,
    end_byte: 0,
  })
  res
}

///| Lower a single `(scrut_expr, pat_s..pat_e)` match obligation (supporting nested `as` and `{ ... }`)
///| and then continue with remaining `as_obls[as_idx..]` -> `segs[next_seg_idx..]`.
enum IsChainCont {
  ExprCont(String)
  BlockCont(Int, Int, Bool)
}

fn expand_is_chain_as_obls(
  ctx : StageAContext,
  orig_tokens : Array[Token],
  as_obls : Array[(Array[Token], String, Int, Int, String)],
  idx : Int,
  segs : Array[(Int, Int)],
  next_seg_idx : Int,
  file : String,
  cont : IsChainCont,
  fail_expr : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> String {
  if idx >= as_obls.length() {
    return match cont {
      IsChainCont::ExprCont(then_expr) =>
      lower_is_chain_segs(ctx, orig_tokens, segs, next_seg_idx, file, then_expr, fail_expr, bound_out, bound_seen)
      IsChainCont::BlockCont(then_lb, then_rb, wrap_some) =>
      lower_is_chain_segs_with_block(ctx, orig_tokens, segs, next_seg_idx, file, then_lb, then_rb, wrap_some, fail_expr, bound_out, bound_seen)
    }
  }
  let (tokens, scrut_var, raw_ps, raw_pe, scrut_ty) = as_obls[idx]
  let mut ps = raw_ps
  let mut pe = raw_pe
  while ps + 1 < pe && tokens[ps].kind == TokenKind::LParen &&
  find_matching_delim(tokens, ps) == pe - 1 &&
  !range_has_top_comma(tokens, ps + 1, pe - 1) {
    ps = ps + 1
    pe = pe - 1
  }
  let tail_as_obls : Array[(Array[Token], String, Int, Int, String)] = []
  let mut oi = idx + 1
  while oi < as_obls.length() {
    tail_as_obls.push(as_obls[oi])
    oi = oi + 1
  }
  if pattern_has_top_pipe(tokens, ps, pe) &&
  (pattern_contains_as_kw(tokens, ps, pe) || pattern_contains_struct_pat(tokens, ps, pe)) {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      tokens[ps].line,
      tokens[ps].col,
      "or-pattern `|` with `as` or struct pattern inside `is`-chain is not supported (fail-closed)",
    ))
  }
  // Handle chained top-level `as` on this sub-pattern (e.g. `((Some(x) as b) as a)`)
  let top_as = find_top_level_as_kw(tokens, ps, pe)
  let mut inner_pe = pe
  let mut chain_alias = ""
  if top_as > ps {
    if top_as + 2 == pe && (tokens[top_as + 1].kind == TokenKind::Ident || tokens[top_as + 1].kind == TokenKind::Underscore) {
      let at = tokens[top_as + 1]
      if at.kind != TokenKind::Underscore && at.raw != "_" {
        chain_alias = resolve_ident_in_scope(ctx, at.raw)
        record_is_chain_binder(ctx, chain_alias, scrut_ty, bound_out, bound_seen)
      }
      inner_pe = top_as
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[top_as].line,
        tokens[top_as].col,
        "unsupported nested `as` alias form inside `is`-chain pattern (fail-closed)",
      ))
    }
  }
  let eff_scrut = if chain_alias.length() > 0 { chain_alias } else { scrut_var }
  let child_as_raw : Array[(String, Int, Int)] = []
  let peeled_toks = if pattern_contains_as_kw(tokens, ps, inner_pe) {
    finish_peeled_tokens(peel_nested_as_tokens(ctx, tokens, ps, inner_pe, file, child_as_raw))
  } else {
    []
  }
  for cab in child_as_raw {
    if !ctx.synth_sp_temps.contains(cab.0) {
      record_is_chain_binder(ctx, cab.0, "", bound_out, bound_seen)
    }
  }
  let next_as_obls : Array[(Array[Token], String, Int, Int, String)] = []
  for cab in child_as_raw { next_as_obls.push((tokens, cab.0, cab.1, cab.2, "")) }
  for tab in tail_as_obls { next_as_obls.push(tab) }
  let use_peeled = child_as_raw.length() > 0
  let p_toks = if use_peeled { peeled_toks } else { tokens }
  let p_s = if use_peeled { 0 } else { ps }
  let p_e = if use_peeled { peeled_toks.length() - 1 } else { inner_pe }
  let inner_body = if pattern_contains_struct_pat(p_toks, p_s, p_e) {
    if scrut_ty.length() > 0 {
      push_expected_type(ctx, scrut_ty)
    }
    let (outer_pat_raw, raw_obls) = peel_struct_patterns_in_pat(ctx, p_toks, p_s, p_e, file)
    let obls : Array[(String, Int, Int, String)] = []
    for ob in raw_obls {
      let osname = if ob.3.length() > 0 {
        ob.3
      } else {
        infer_struct_name_from_ty_and_pat(ctx, scrut_ty, p_toks, p_s, p_e, ob.1)
      }
      obls.push((ob.0, ob.1, ob.2, osname))
    }
    if scrut_ty.length() > 0 {
      pop_expected_type(ctx)
    }
    let outer_pat = outer_pat_raw.trim()
    for ob in obls {
      if !ctx.synth_sp_temps.contains(ob.0) {
        record_is_chain_binder(ctx, ob.0, "", bound_out, bound_seen)
      }
    }
    let ob_set : Map[String, Bool] = Map()
    for ob in obls { ob_set[ob.0] = true }
    let outer_toks = lex_moonbit(outer_pat)
    let outer_raw_bs = collect_pattern_binders(outer_toks, 0, outer_toks.length() - 1)
    for rb in outer_raw_bs {
      if !ob_set.contains(rb) && !ctx.synth_sp_temps.contains(rb) {
        record_is_chain_binder(ctx, rb, "", bound_out, bound_seen)
      }
    }
    let expanded = expand_is_chain_struct_obls_with_as(
      ctx,
      p_toks,
      orig_tokens,
      obls,
      0,
      next_as_obls,
      segs,
      next_seg_idx,
      file,
      cont,
      fail_expr,
      bound_out,
      bound_seen,
    )
    if is_irrefutable_simple_pat(outer_pat) {
      if outer_pat == eff_scrut {
        expanded
      } else {
        "{ let " + outer_pat + " = " + eff_scrut + "; " + expanded + " }"
      }
    } else {
      "match " + eff_scrut + " { " + outer_pat + " => " + expanded + ", _ => " + fail_expr + " }"
    }
  } else {
    let pat_str = lower_expr_range(ctx, p_toks, p_s, p_e, file, true).trim()
    let raw_bs = collect_pattern_binders(p_toks, p_s, p_e)
    for rb in raw_bs {
      let bname = resolve_ident_in_scope(ctx, rb)
      if !ctx.synth_sp_temps.contains(bname) {
        record_is_chain_binder(ctx, bname, "", bound_out, bound_seen)
      }
    }
    let next_s = expand_is_chain_as_obls(
      ctx,
      orig_tokens,
      next_as_obls,
      0,
      segs,
      next_seg_idx,
      file,
      cont,
      fail_expr,
      bound_out,
      bound_seen,
    )
    if is_irrefutable_simple_pat(pat_str) {
      if pat_str == "_" {
        next_s
      } else if pat_str == eff_scrut {
        next_s
      } else {
        "{ let " + pat_str + " = " + eff_scrut + "; " + next_s + " }"
      }
    } else {
      "match " + eff_scrut + " { " + pat_str + " => " + next_s + ", _ => " + fail_expr + " }"
    }
  }
  if chain_alias.length() > 0 {
    "{ let " + chain_alias + " = " + scrut_var + "; " + inner_body + " }"
  } else {
    inner_body
  }
}

///| Expand struct obligations `obls` (whose token indices reference `struct_toks`),
///| then continue into `pending_as_obls`, then `segs[next_seg_idx..]`.
fn expand_is_chain_struct_obls_with_as(
  ctx : StageAContext,
  struct_toks : Array[Token],
  orig_toks : Array[Token],
  obls : Array[(String, Int, Int, String)],
  idx : Int,
  pending_as_obls : Array[(Array[Token], String, Int, Int, String)],
  segs : Array[(Int, Int)],
  next_seg_idx : Int,
  file : String,
  cont : IsChainCont,
  fail_expr : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> String {
  if idx >= obls.length() {
    return expand_is_chain_as_obls(
      ctx,
      orig_toks,
      pending_as_obls,
      0,
      segs,
      next_seg_idx,
      file,
      cont,
      fail_expr,
      bound_out,
      bound_seen,
    )
  }
  let (bind_var, open_b, close_b, explicit_sname) = obls[idx]
  let checks : Array[String] = []
  let bind_fields : Array[(String, String, Bool)] = []
  let next_obls : Array[(String, Int, Int, String)] = []
  let mut oi = idx + 1
  while oi < obls.length() {
    next_obls.push(obls[oi])
    oi = oi + 1
  }
  let combined_as : Array[(Array[Token], String, Int, Int, String)] = []
  let mut fi = open_b + 1
  while fi < close_b {
    if struct_toks[fi].kind == TokenKind::Comma || struct_toks[fi].kind == TokenKind::DotDot {
      fi = fi + 1
      continue
    }
    let mut fe = fi
    let mut fd = 0
    while fe < close_b {
      let fk = struct_toks[fe].kind
      if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
      else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
      else if fd == 0 && fk == TokenKind::Comma { break }
      fe = fe + 1
    }
    let raw_f = struct_toks[fi].raw
    if struct_toks[fi].kind == TokenKind::StringLit &&
    ((fi + 2 < fe && struct_toks[fi + 1].kind == TokenKind::Colon) ||
      (fi + 3 < fe && struct_toks[fi + 1].kind == TokenKind::Question && struct_toks[fi + 2].kind == TokenKind::Colon)) {
      let is_opt_key = struct_toks[fi + 1].kind == TokenKind::Question
      let vs = if is_opt_key { fi + 3 } else { fi + 2 }
      let fexpr = bind_var + ".get(" + raw_f + ")"
      let has_sp = pattern_contains_struct_pat(struct_toks, vs, fe)
      let has_as = pattern_contains_as_kw(struct_toks, vs, fe)
      if has_sp && has_as {
        let ftmp = fresh_temp(ctx, "mk")
        ctx.synth_sp_temps[ftmp] = true
        if is_opt_key {
          bind_fields.push((fexpr, ftmp, true))
        } else {
          bind_fields.push((fexpr, "Some(" + ftmp + ")", false))
        }
        combined_as.push((struct_toks, ftmp, vs, fe, ""))
      } else if has_sp {
        let (peeled_pat, child_obls) = peel_struct_patterns_in_pat(ctx, struct_toks, vs, fe, file)
        for cob in child_obls {
          if !ctx.synth_sp_temps.contains(cob.0) {
            record_is_chain_binder(ctx, cob.0, "", bound_out, bound_seen)
          }
          next_obls.push((cob.0, cob.1, cob.2, cob.3))
        }
        let pp = peeled_pat.trim()
        if is_opt_key {
          bind_fields.push((fexpr, pp, is_irrefutable_simple_pat(pp)))
        } else {
          bind_fields.push((fexpr, "Some(" + pp + ")", false))
        }
      } else if has_as {
        let ftmp = fresh_temp(ctx, "mk")
        ctx.synth_sp_temps[ftmp] = true
        if is_opt_key {
          bind_fields.push((fexpr, ftmp, true))
        } else {
          bind_fields.push((fexpr, "Some(" + ftmp + ")", false))
        }
        combined_as.push((struct_toks, ftmp, vs, fe, ""))
      } else {
        register_simple_is_pat_binders(ctx, struct_toks, vs, fe, "", bound_out, bound_seen)
        let pat_s = lower_expr_range(ctx, struct_toks, vs, fe, file, true).trim()
        if is_opt_key {
          bind_fields.push((fexpr, pat_s, is_irrefutable_simple_pat(pat_s)))
        } else {
          bind_fields.push((fexpr, "Some(" + pat_s + ")", false))
        }
      }
      fi = fe + 1
      continue
    }
    let access_f = resolve_is_chain_struct_field(ctx, explicit_sname, raw_f, file, struct_toks[fi].line, struct_toks[fi].col)
    if (struct_toks[fi].kind == TokenKind::Ident || struct_toks[fi].kind == TokenKind::Keyword) &&
    fi + 2 < fe && struct_toks[fi + 1].kind == TokenKind::Colon {
      let fexpr = bind_var + "." + access_f
      let vs = fi + 2
      let has_sp = pattern_contains_struct_pat(struct_toks, vs, fe)
      let has_as = pattern_contains_as_kw(struct_toks, vs, fe)
      let field_ty = if explicit_sname.length() > 0 {
        match ctx.symtab.struct_field_types.get(explicit_sname) {
          Some(fm) => match fm.get(raw_f) { Some(ft) => ft, None => "" }
          None => ""
        }
      } else {
        ""
      }
      if has_sp && has_as {
        // Field contains BOTH nested struct pattern AND `as`: route through `expand_is_chain_as_obls`
        // with `field_ty` preserved so non-struct `as` are peeled BEFORE `peel_struct_patterns_in_pat`!
        let ftmp = fresh_temp(ctx, "fa")
        ctx.synth_sp_temps[ftmp] = true
        bind_fields.push((fexpr, ftmp, true))
        combined_as.push((struct_toks, ftmp, vs, fe, field_ty))
      } else if has_sp {
        let (peeled_pat, child_obls) = peel_struct_patterns_in_pat(ctx, struct_toks, vs, fe, file)
        for cob in child_obls {
          if !ctx.synth_sp_temps.contains(cob.0) {
            record_is_chain_binder(ctx, cob.0, "", bound_out, bound_seen)
          }
          let csname = if cob.3.length() > 0 {
            cob.3
          } else {
            infer_struct_name_from_ty_and_pat(ctx, field_ty, struct_toks, vs, fe, cob.1)
          }
          next_obls.push((cob.0, cob.1, cob.2, csname))
        }
        let pp = peeled_pat.trim()
        bind_fields.push((fexpr, pp, is_irrefutable_simple_pat(pp)))
      } else if has_as {
        let ftmp = fresh_temp(ctx, "fa")
        ctx.synth_sp_temps[ftmp] = true
        bind_fields.push((fexpr, ftmp, true))
        combined_as.push((struct_toks, ftmp, vs, fe, field_ty))
      } else {
        let mut has_binder = false
        let mut bi = vs
        while bi < fe {
          if struct_toks[bi].kind == TokenKind::Ident && struct_toks[bi].raw != "_" &&
          !(bi > vs && (struct_toks[bi - 1].kind == TokenKind::Dot || struct_toks[bi - 1].kind == TokenKind::ColonColon)) &&
          !(bi + 1 < fe && struct_toks[bi + 1].kind == TokenKind::Colon) {
            has_binder = true
          }
          bi = bi + 1
        }
        if has_binder {
          register_simple_is_pat_binders(ctx, struct_toks, vs, fe, "", bound_out, bound_seen)
          let pat_s = lower_expr_range(ctx, struct_toks, vs, fe, file, true).trim()
          bind_fields.push((fexpr, pat_s, is_irrefutable_simple_pat(pat_s)))
        } else if vs < fe {
          let vt = struct_toks[vs]
          if vs + 1 == fe && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
            vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
            checks.push(fexpr + " == " + vt.raw)
          } else {
            let ps = lower_expr_range(ctx, struct_toks, vs, fe, file, true).trim()
            if ps != "_" {
              checks.push("(match " + fexpr + " { " + ps + " => true, _ => false })")
            }
          }
        }
      }
    } else if struct_toks[fi].kind == TokenKind::Ident && fe == fi + 1 {
      let bind_name = resolve_ident_in_scope(ctx, raw_f)
      record_is_chain_binder(ctx, bind_name, "", bound_out, bound_seen)
      bind_fields.push((bind_var + "." + access_f, bind_name, true))
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        struct_toks[fi].line,
        struct_toks[fi].col,
        "unsupported field pattern inside struct pattern",
      ))
    }
    fi = fe + 1
  }
  for pas in pending_as_obls {
    combined_as.push(pas)
  }
  let inner_s = expand_is_chain_struct_obls_with_as(
    ctx,
    struct_toks,
    orig_toks,
    next_obls,
    0,
    combined_as,
    segs,
    next_seg_idx,
    file,
    cont,
    fail_expr,
    bound_out,
    bound_seen,
  )
  let mut wrapped = inner_s
  if bind_fields.length() > 0 {
    let mut all_irref = true
    for bf in bind_fields {
      if !bf.2 {
        all_irref = false
        break
      }
    }
    if all_irref {
      let lsb = StringBuilder()
      lsb.write_string("{ ")
      for bf in bind_fields {
        lsb.write_string("let " + bf.1 + " = " + bf.0 + "; ")
      }
      lsb.write_string(wrapped + " }")
      wrapped = lsb.to_string()
    } else {
      let scrut_e = if bind_fields.length() == 1 {
        bind_fields[0].0
      } else {
        let es : Array[String] = []
        for bf in bind_fields { es.push(bf.0) }
        "(" + join_comma(es) + ")"
      }
      let pat_e = if bind_fields.length() == 1 {
        bind_fields[0].1
      } else {
        let ps : Array[String] = []
        for bf in bind_fields { ps.push(bf.1) }
        "(" + join_comma(ps) + ")"
      }
      wrapped = "match " + scrut_e + " { " + pat_e + " => " + wrapped + ", _ => " + fail_expr + " }"
    }
  }
  if checks.length() > 0 {
    let csb = StringBuilder()
    let mut ci = 0
    while ci < checks.length() {
      if ci > 0 { csb.write_string(" && ") }
      csb.write_string(checks[ci])
      ci = ci + 1
    }
    wrapped = "if (" + csb.to_string() + ") { " + wrapped + " } else { " + fail_expr + " }"
  }
  wrapped
}

///| Collect ALL raw binder names introduced anywhere in an `is` pattern `[start, end)`
///| (including `as <ident>`, struct shorthand `{ f }`, field sub-pattern binders `{ f: p }`,
///| and simple pattern binders `Some(x)`) so `compute_scoped_binder_renames` avoids both
///| outer `ctx.scope_vars` and sibling binders (e.g. `val` vs `val_`).
fn collect_is_pat_all_raw_binders(tokens : Array[Token], start : Int, end : Int, out : Array[String]) -> Unit {
  let mut k = start
  while k < end {
    let tk = tokens[k].kind
    if tk == TokenKind::Keyword && tokens[k].raw == "as" && k + 1 < end && tokens[k + 1].kind == TokenKind::Ident {
      let r = tokens[k + 1].raw
      if r != "_" { out.push(r) }
      k = k + 2
      continue
    }
    if tk == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, k)
      let mut fi = k + 1
      while fi < cb {
        if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
          fi = fi + 1
          continue
        }
        let mut fe = fi
        let mut fd = 0
        while fe < cb {
          let fk = tokens[fe].kind
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
          else if fd == 0 && fk == TokenKind::Comma { break }
          fe = fe + 1
        }
        if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
        fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
          collect_is_pat_all_raw_binders(tokens, fi + 2, fe, out)
        } else if tokens[fi].kind == TokenKind::Ident && fe == fi + 1 && tokens[fi].raw != "_" {
          out.push(tokens[fi].raw)
        }
        fi = fe + 1
      }
      k = cb + 1
      continue
    }
    if tk == TokenKind::Ident && tokens[k].raw != "_" {
      let prev_dot = k > start && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)
      let next_col = k + 1 < end && tokens[k + 1].kind == TokenKind::Colon
      let next_lp = k + 1 < end && tokens[k + 1].kind == TokenKind::LParen
      if !prev_dot && !next_col && !next_lp {
        out.push(tokens[k].raw)
      }
    }
    k = k + 1
  }
}

///| Infer a local struct name for an anonymous `{ ... }` pattern at `open_b` inside pattern `[pat_s, pat_e)`
///| given the scrutinee's static type `scrut_ty` (unwrapping `Option[T]` / `Result[T, E]` / `using_types` / `type_aliases`).
fn infer_struct_name_from_ty_and_pat(
  ctx : StageAContext,
  scrut_ty : String,
  tokens : Array[Token],
  pat_s : Int,
  pat_e : Int,
  open_b : Int,
) -> String {
  let st = scrut_ty.trim()
  if st.length() == 0 {
    return ""
  }
  let mut ps = pat_s
  let mut pe = pat_e
  while ps + 1 < pe && tokens[ps].kind == TokenKind::LParen && find_matching_delim(tokens, ps) == pe - 1 {
    ps = ps + 1
    pe = pe - 1
  }
  let mut cand_ty = ""
  if ps == open_b {
    cand_ty = st
  } else if ps + 2 < pe && tokens[ps].kind == TokenKind::UpperIdent && tokens[ps + 1].kind == TokenKind::LParen {
    let ctor = tokens[ps].raw
    if ctor == "Some" && st.starts_with("Option[") && st.ends_with("]") {
      cand_ty = st.slice(7, st.length() - 1).trim()
    } else if (ctor == "Ok" || ctor == "Err") && st.starts_with("Result[") && st.ends_with("]") {
      let inner = st.slice(7, st.length() - 1)
      let mut ci = 0
      let mut d = 0
      let mut split = -1
      while ci < inner.length() {
        let ch = inner.code_unit_at(ci)
        if ch == 40 || ch == 91 || ch == 123 { d = d + 1 }
        else if ch == 41 || ch == 93 || ch == 125 { if d > 0 { d = d - 1 } }
        else if d == 0 && ch == 44 { split = ci; break }
        ci = ci + 1
      }
      if split > 0 {
        cand_ty = if ctor == "Ok" { inner.slice(0, split).trim() } else { inner.slice(split + 1, inner.length()).trim() }
      }
    }
  } else if ps + 4 < pe && tokens[ps].kind == TokenKind::UpperIdent &&
  tokens[ps + 1].kind == TokenKind::ColonColon && tokens[ps + 2].kind == TokenKind::UpperIdent &&
  tokens[ps + 3].kind == TokenKind::LParen {
    let ctor = tokens[ps + 2].raw
    if ctor == "Some" && st.starts_with("Option[") && st.ends_with("]") {
      cand_ty = st.slice(7, st.length() - 1).trim()
    }
  }
  if cand_ty.length() == 0 {
    return ""
  }
  let raw_base = strip_type_args_sym(cand_ty)
  let resolved = match ctx.symtab.using_types.get(raw_base) {
    Some(q) => strip_type_args_sym(q)
    None =>
    match ctx.symtab.type_aliases.get(raw_base) {
      Some(a) => strip_type_args_sym(a)
      None => raw_base
    }
  }
  if ctx.struct_field_renames.contains(resolved) {
    resolved
  } else {
    ""
  }
}

///| Resolve a struct field access name in an `is`-chain struct pattern, failing closed when
///| `explicit_sname` is unknown and `raw_f` is a Pion-reserved keyword that collides with a
///| renamed field in the package (e.g. `val` vs `val_`).
fn resolve_is_chain_struct_field(
  ctx : StageAContext,
  explicit_sname : String,
  raw_f : String,
  file : String,
  line : Int,
  col : Int,
) -> String {
  if explicit_sname.length() > 0 {
    if ctx.struct_field_renames.contains(explicit_sname) {
      return rename_struct_field(ctx, explicit_sname, raw_f)
    }
    if raw_f == "val" && ctx.symtab.dep_struct_val_fields.contains(explicit_sname) {
      return rename_struct_field(ctx, explicit_sname, raw_f)
    }
  }
  let def_name = rename_keyword_ident(raw_f)
  if def_name != raw_f {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      line,
      col,
      "keyword-colliding field `" + raw_f + "` in anonymous struct pattern with unknown struct type is not supported (fail-closed)",
    ))
  }
  def_name
}

///| Record a binder name in `bound_out` (preserving order, deduplicated) and push onto `ctx.scope_vars`.
fn record_is_chain_binder(
  ctx : StageAContext,
  name : String,
  ty : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> Unit {
  if name.length() == 0 || name == "_" {
    return
  }
  ctx.scope_vars.push(ScopeVar::{ name: name, ty: ty, is_mut: false, is_boxed: false })
  if !bound_seen.contains(name) {
    bound_seen[name] = true
    bound_out.push(name)
  }
}

///| Collect and register binders from a non-struct pattern range `[start, end)`,
///| inferring inner `Option[T]` / `Result[T, E]` binder type when `scrut_ty` is known.
fn register_simple_is_pat_binders(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  scrut_ty : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> Unit {
  let st = scrut_ty.trim()
  // Special case: `Some(x)` on `Option[T]`
  if start + 3 < end && tokens[start].kind == TokenKind::UpperIdent && tokens[start].raw == "Some" &&
  tokens[start + 1].kind == TokenKind::LParen && find_matching_delim(tokens, start + 1) == end - 1 &&
  start + 3 == end - 1 && tokens[start + 2].kind == TokenKind::Ident && tokens[start + 2].raw != "_" &&
  st.starts_with("Option[") && st.ends_with("]") {
    let inner_ty = st.slice(7, st.length() - 1).trim()
    let bname = resolve_ident_in_scope(ctx, tokens[start + 2].raw)
    record_is_chain_binder(ctx, bname, inner_ty, bound_out, bound_seen)
    return
  }
  let raw_bs = collect_pattern_binders(tokens, start, end)
  for rb in raw_bs {
    let bname = resolve_ident_in_scope(ctx, rb)
    record_is_chain_binder(ctx, bname, "", bound_out, bound_seen)
  }
}

///| Expand peeled struct-pattern obligations for an `is`-chain in a single pass (zero double evaluation).
fn expand_is_chain_struct_obls(
  ctx : StageAContext,
  tokens : Array[Token],
  obls : Array[(String, Int, Int, String)],
  idx : Int,
  segs : Array[(Int, Int)],
  next_seg_idx : Int,
  file : String,
  then_expr : String,
  fail_expr : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> String {
  if idx >= obls.length() {
    return lower_is_chain_segs(ctx, tokens, segs, next_seg_idx, file, then_expr, fail_expr, bound_out, bound_seen)
  }
  let (bind_var, open_b, close_b, explicit_sname) = obls[idx]
  let checks : Array[String] = []
  let bind_fields : Array[(String, String, Bool)] = []
  let next_obls : Array[(String, Int, Int, String)] = []
  let mut oi = idx + 1
  while oi < obls.length() {
    next_obls.push(obls[oi])
    oi = oi + 1
  }
  let mut fi = open_b + 1
  while fi < close_b {
    if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
      fi = fi + 1
      continue
    }
    let mut fe = fi
    let mut fd = 0
    while fe < close_b {
      let fk = tokens[fe].kind
      if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
      else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
      else if fd == 0 && fk == TokenKind::Comma { break }
      fe = fe + 1
    }
    let raw_f = tokens[fi].raw
    if tokens[fi].kind == TokenKind::StringLit &&
    ((fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon) ||
      (fi + 3 < fe && tokens[fi + 1].kind == TokenKind::Question && tokens[fi + 2].kind == TokenKind::Colon)) {
      let is_opt_key = tokens[fi + 1].kind == TokenKind::Question
      let vs = if is_opt_key { fi + 3 } else { fi + 2 }
      let fexpr = bind_var + ".get(" + raw_f + ")"
      if pattern_contains_struct_pat(tokens, vs, fe) {
        let (peeled_pat, child_obls) = peel_struct_patterns_in_pat(ctx, tokens, vs, fe, file)
        for cob in child_obls {
          if !ctx.synth_sp_temps.contains(cob.0) {
            record_is_chain_binder(ctx, cob.0, "", bound_out, bound_seen)
          }
          next_obls.push((cob.0, cob.1, cob.2, cob.3))
        }
        let pp = peeled_pat.trim()
        if is_opt_key {
          bind_fields.push((fexpr, pp, is_irrefutable_simple_pat(pp)))
        } else {
          bind_fields.push((fexpr, "Some(" + pp + ")", false))
        }
      } else {
        register_simple_is_pat_binders(ctx, tokens, vs, fe, "", bound_out, bound_seen)
        let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
        if is_opt_key {
          bind_fields.push((fexpr, pat_s, is_irrefutable_simple_pat(pat_s)))
        } else {
          bind_fields.push((fexpr, "Some(" + pat_s + ")", false))
        }
      }
      fi = fe + 1
      continue
    }
    let access_f = resolve_is_chain_struct_field(ctx, explicit_sname, raw_f, file, tokens[fi].line, tokens[fi].col)
    if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
    fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
      let fexpr = bind_var + "." + access_f
      let vs = fi + 2
      if pattern_contains_struct_pat(tokens, vs, fe) {
        let field_ty = if explicit_sname.length() > 0 {
          match ctx.symtab.struct_field_types.get(explicit_sname) {
            Some(fm) => match fm.get(raw_f) { Some(ft) => ft, None => "" }
            None => ""
          }
        } else {
          ""
        }
        let (peeled_pat, child_obls) = peel_struct_patterns_in_pat(ctx, tokens, vs, fe, file)
        for cob in child_obls {
          if !ctx.synth_sp_temps.contains(cob.0) {
            record_is_chain_binder(ctx, cob.0, "", bound_out, bound_seen)
          }
          let csname = if cob.3.length() > 0 {
            cob.3
          } else {
            infer_struct_name_from_ty_and_pat(ctx, field_ty, tokens, vs, fe, cob.1)
          }
          next_obls.push((cob.0, cob.1, cob.2, csname))
        }
        let pp = peeled_pat.trim()
        bind_fields.push((fexpr, pp, is_irrefutable_simple_pat(pp)))
      } else {
        let mut has_binder = false
        let mut bi = vs
        while bi < fe {
          if tokens[bi].kind == TokenKind::Ident && tokens[bi].raw != "_" &&
          !(bi > vs && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
          !(bi + 1 < fe && tokens[bi + 1].kind == TokenKind::Colon) {
            has_binder = true
          }
          bi = bi + 1
        }
        if has_binder {
          register_simple_is_pat_binders(ctx, tokens, vs, fe, "", bound_out, bound_seen)
          let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
          bind_fields.push((fexpr, pat_s, is_irrefutable_simple_pat(pat_s)))
        } else if vs < fe {
          let vt = tokens[vs]
          if vs + 1 == fe && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
            vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
            checks.push(fexpr + " == " + vt.raw)
          } else {
            let ps = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
            if ps != "_" {
              checks.push("(match " + fexpr + " { " + ps + " => true, _ => false })")
            }
          }
        }
      }
    } else if tokens[fi].kind == TokenKind::Ident && fe == fi + 1 {
      let bind_name = resolve_ident_in_scope(ctx, raw_f)
      record_is_chain_binder(ctx, bind_name, "", bound_out, bound_seen)
      bind_fields.push((bind_var + "." + access_f, bind_name, true))
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[fi].line,
        tokens[fi].col,
        "unsupported field pattern inside struct pattern",
      ))
    }
    fi = fe + 1
  }
  let inner_s = expand_is_chain_struct_obls(
    ctx,
    tokens,
    next_obls,
    0,
    segs,
    next_seg_idx,
    file,
    then_expr,
    fail_expr,
    bound_out,
    bound_seen,
  )
  let mut wrapped = inner_s
  if bind_fields.length() > 0 {
    let mut all_irref = true
    for bf in bind_fields {
      if !bf.2 {
        all_irref = false
        break
      }
    }
    if all_irref {
      let lsb = StringBuilder()
      lsb.write_string("{ ")
      for bf in bind_fields {
        lsb.write_string("let " + bf.1 + " = " + bf.0 + "; ")
      }
      lsb.write_string(wrapped + " }")
      wrapped = lsb.to_string()
    } else {
      let scrut_e = if bind_fields.length() == 1 {
        bind_fields[0].0
      } else {
        let es : Array[String] = []
        for bf in bind_fields { es.push(bf.0) }
        "(" + join_comma(es) + ")"
      }
      let pat_e = if bind_fields.length() == 1 {
        bind_fields[0].1
      } else {
        let ps : Array[String] = []
        for bf in bind_fields { ps.push(bf.1) }
        "(" + join_comma(ps) + ")"
      }
      wrapped = "match " + scrut_e + " { " + pat_e + " => " + wrapped + ", _ => " + fail_expr + " }"
    }
  }
  if checks.length() > 0 {
    let csb = StringBuilder()
    let mut ci = 0
    while ci < checks.length() {
      if ci > 0 { csb.write_string(" && ") }
      csb.write_string(checks[ci])
      ci = ci + 1
    }
    wrapped = "if (" + csb.to_string() + ") { " + wrapped + " } else { " + fail_expr + " }"
  }
  wrapped
}

///| Lower a sequence of `&&`-separated condition segments `[idx, segs.length())`
///| into a left-to-right short-circuiting nested `match`/`if` chain.
fn lower_is_chain_segs(
  ctx : StageAContext,
  tokens : Array[Token],
  segs : Array[(Int, Int)],
  idx : Int,
  file : String,
  then_expr : String,
  fail_expr : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> String {
  if idx >= segs.length() {
    return then_expr
  }
  let (ss, se) = segs[idx]
  let is_i = find_top_level_is_kw(tokens, ss, se)
  if is_i <= ss || is_i + 1 >= se {
    // Plain boolean condition segment
    let cond_s = lower_expr_range(ctx, tokens, ss, se, file, false).trim()
    let next_s = lower_is_chain_segs(ctx, tokens, segs, idx + 1, file, then_expr, fail_expr, bound_out, bound_seen)
    return "if (" + cond_s + ") { " + next_s + " } else { " + fail_expr + " }"
  }
  // `<lhs> is <pat>` segment: evaluate `<lhs>` ONCE before binding any pattern variables!
  let lhs_ty = infer_simple_expr_type(ctx, tokens, ss, is_i)
  let lhs_s = lower_expr_range(ctx, tokens, ss, is_i, file, false).trim()
  let mut pat_s = is_i + 1
  let mut pat_e = se
  while pat_s + 1 < pat_e && tokens[pat_s].kind == TokenKind::LParen &&
  find_matching_delim(tokens, pat_s) == pat_e - 1 &&
  !range_has_top_comma(tokens, pat_s + 1, pat_e - 1) {
    pat_s = pat_s + 1
    pat_e = pat_e - 1
  }
  if pattern_has_top_pipe(tokens, pat_s, pat_e) &&
  (pattern_contains_as_kw(tokens, pat_s, pat_e) || pattern_contains_struct_pat(tokens, pat_s, pat_e)) {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      tokens[pat_s].line,
      tokens[pat_s].col,
      "top-level or-pattern `|` with `as` or struct pattern in `is`-chain is not supported (fail-closed)",
    ))
  }
  let seg_raw_binders : Array[String] = []
  collect_is_pat_all_raw_binders(tokens, pat_s, pat_e, seg_raw_binders)
  let seg_rn = compute_scoped_binder_renames(ctx, seg_raw_binders)
  if seg_rn.length() > 0 {
    ctx.ident_renames.push(seg_rn)
  }
  let top_as = find_top_level_as_kw(tokens, pat_s, pat_e)
  let mut alias_var = ""
  let mut inner_pat_e = pat_e
  if top_as > pat_s {
    if top_as + 2 == pat_e && tokens[top_as + 1].kind == TokenKind::Ident {
      alias_var = resolve_ident_in_scope(ctx, tokens[top_as + 1].raw)
      inner_pat_e = top_as
      record_is_chain_binder(ctx, alias_var, lhs_ty, bound_out, bound_seen)
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[top_as].line,
        tokens[top_as].col,
        "unsupported `as` alias form inside `is`-chain pattern (fail-closed)",
      ))
    }
  }
  let scrut_expr = if alias_var.length() > 0 { alias_var } else { lhs_s }
  let raw_as_obls : Array[(String, Int, Int)] = []
  let peeled_as_toks = if pattern_contains_as_kw(tokens, pat_s, inner_pat_e) {
    finish_peeled_tokens(peel_nested_as_tokens(ctx, tokens, pat_s, inner_pat_e, file, raw_as_obls))
  } else {
    []
  }
  let seg_as_obls : Array[(Array[Token], String, Int, Int, String)] = []
  for aob in raw_as_obls {
    if !ctx.synth_sp_temps.contains(aob.0) {
      record_is_chain_binder(ctx, aob.0, "", bound_out, bound_seen)
    }
    seg_as_obls.push((tokens, aob.0, aob.1, aob.2, ""))
  }
  let use_peeled_as = raw_as_obls.length() > 0
  let p_toks = if use_peeled_as { peeled_as_toks } else { tokens }
  let p_s = if use_peeled_as { 0 } else { pat_s }
  let p_e = if use_peeled_as { peeled_as_toks.length() - 1 } else { inner_pat_e }
  let body_expr = if pattern_contains_struct_pat(p_toks, p_s, p_e) {
    if lhs_ty.length() > 0 {
      push_expected_type(ctx, lhs_ty)
    }
    let (outer_pat_raw, raw_obls) = peel_struct_patterns_in_pat(ctx, p_toks, p_s, p_e, file)
    let obls : Array[(String, Int, Int, String)] = []
    for ob in raw_obls {
      let osname = if ob.3.length() > 0 {
        ob.3
      } else {
        infer_struct_name_from_ty_and_pat(ctx, lhs_ty, p_toks, p_s, p_e, ob.1)
      }
      obls.push((ob.0, ob.1, ob.2, osname))
    }
    if lhs_ty.length() > 0 {
      pop_expected_type(ctx)
    }
    let outer_pat = outer_pat_raw.trim()
    // Register any explicit `as` alias binders created by `peel_struct_patterns_in_pat`
    for ob in obls {
      if !ctx.synth_sp_temps.contains(ob.0) {
        record_is_chain_binder(ctx, ob.0, "", bound_out, bound_seen)
      }
    }
    // Also register any non-struct binders directly in `outer_pat` (outside peeled struct vars)
    let ob_set : Map[String, Bool] = Map()
    for ob in obls { ob_set[ob.0] = true }
    let outer_toks = lex_moonbit(outer_pat)
    let outer_raw_bs = collect_pattern_binders(outer_toks, 0, outer_toks.length() - 1)
    for rb in outer_raw_bs {
      if !ob_set.contains(rb) && !ctx.synth_sp_temps.contains(rb) {
        record_is_chain_binder(ctx, rb, "", bound_out, bound_seen)
      }
    }
    let expanded = expand_is_chain_struct_obls_with_as(
      ctx,
      p_toks,
      tokens,
      obls,
      0,
      seg_as_obls,
      segs,
      idx + 1,
      file,
      IsChainCont::ExprCont(then_expr),
      fail_expr,
      bound_out,
      bound_seen,
    )
    if is_irrefutable_simple_pat(outer_pat) {
      if outer_pat == scrut_expr {
        expanded
      } else {
        "{ let " + outer_pat + " = " + scrut_expr + "; " + expanded + " }"
      }
    } else {
      "match " + scrut_expr + " { " + outer_pat + " => " + expanded + ", _ => " + fail_expr + " }"
    }
  } else {
    if lhs_ty.length() > 0 {
      push_expected_type(ctx, lhs_ty)
    }
    let pat_str = lower_expr_range(ctx, p_toks, p_s, p_e, file, true).trim()
    if lhs_ty.length() > 0 {
      pop_expected_type(ctx)
    }
    if !use_peeled_as {
      register_simple_is_pat_binders(ctx, p_toks, p_s, p_e, lhs_ty, bound_out, bound_seen)
    } else {
      let raw_bs = collect_pattern_binders(p_toks, p_s, p_e)
      for rb in raw_bs {
        let bname = resolve_ident_in_scope(ctx, rb)
        if !ctx.synth_sp_temps.contains(bname) {
          record_is_chain_binder(ctx, bname, "", bound_out, bound_seen)
        }
      }
    }
    let next_s = expand_is_chain_as_obls(
      ctx,
      tokens,
      seg_as_obls,
      0,
      segs,
      idx + 1,
      file,
      IsChainCont::ExprCont(then_expr),
      fail_expr,
      bound_out,
      bound_seen,
    )
    if is_irrefutable_simple_pat(pat_str) {
      if pat_str == "_" {
        "{ let _ = " + scrut_expr + "; " + next_s + " }"
      } else if pat_str == scrut_expr {
        next_s
      } else {
        "{ let " + pat_str + " = " + scrut_expr + "; " + next_s + " }"
      }
    } else {
      "match " + scrut_expr + " { " + pat_str + " => " + next_s + ", _ => " + fail_expr + " }"
    }
  }
  if alias_var.length() > 0 {
    "{ let " + alias_var + " = " + lhs_s + "; " + body_expr + " }"
  } else {
    body_expr
  }
}

///| Recursively consume a complete `if ... { ... } [else if ... { ... }]* [else { ... }]` chain
///| starting at `if_start` (`tokens[if_start].raw == "if"`), returning `(pion_code, next_token_idx)`.
fn lower_full_if_else_chain(
  ctx : StageAContext,
  tokens : Array[Token],
  if_start : Int,
  end : Int,
  file : String,
) -> (String, Int) {
  let sb = StringBuilder()
  let (head_s, cur0) = lower_one_token_or_form(ctx, tokens, if_start, end, file, false)
  let mut cur = cur0
  sb.write_string(head_s)
  while cur + 1 < end && tokens[cur].kind == TokenKind::Keyword && tokens[cur].raw == "else" {
    if tokens[cur + 1].kind == TokenKind::LBrace {
      let erb = find_matching_delim(tokens, cur + 1)
      let eb = lower_block_range(ctx, tokens, cur + 1, erb, file, "")
      sb.write_string(tokens[cur].leading_trivia + "else" + tokens[cur + 1].leading_trivia + eb)
      cur = erb + 1
      break
    } else if tokens[cur + 1].kind == TokenKind::Keyword && tokens[cur + 1].raw == "if" {
      let (sub_s, sub_next) = lower_full_if_else_chain(ctx, tokens, cur + 1, end, file)
      sb.write_string(tokens[cur].leading_trivia + "else" + sub_s)
      cur = sub_next
      break
    } else {
      break
    }
  }
  (sb.to_string(), cur)
}

///| Check whether a block `[lb, rb]` definitely diverges on its last top-level statement
///| using ONLY unshadowable control-flow keywords (`return`, `break`, `continue`).
fn block_definitely_diverges(tokens : Array[Token], lb : Int, rb : Int) -> Bool {
  if rb <= lb + 1 {
    return false
  }
  let mut last_stmt_start = -1
  let mut i = lb + 1
  let mut d = 0
  let mut stmt_start = lb + 1
  while i < rb {
    let tk = tokens[i].kind
    if d == 0 && tk == TokenKind::Semi {
      if i > stmt_start {
        last_stmt_start = stmt_start
      }
      stmt_start = i + 1
      i = i + 1
      continue
    }
    if d == 0 && i > stmt_start && str_has(tokens[i].leading_trivia, "\n") {
      let raw_i = tokens[i].raw
      if tk == TokenKind::Keyword && (raw_i == "return" || raw_i == "break" || raw_i == "continue" || raw_i == "let" || raw_i == "if" || raw_i == "match" || raw_i == "for" || raw_i == "while" || raw_i == "guard") {
        last_stmt_start = stmt_start
        stmt_start = i
      }
    }
    if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace {
      d = d + 1
    } else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    }
    i = i + 1
  }
  if stmt_start < rb {
    last_stmt_start = stmt_start
  }
  if last_stmt_start < 0 || last_stmt_start >= rb {
    return false
  }
  let ft = tokens[last_stmt_start]
  if ft.kind == TokenKind::Keyword && (ft.raw == "return" || ft.raw == "break" || ft.raw == "continue") {
    return true
  }
  false
}

///| Lower `if <cond> { <then> } [else <else>]` when `<cond>` requires `is`-chain lowering.
///| Returns `Some((pion_code, next_token_idx))` or `None` if not applicable.
fn try_lower_if_is_chain(
  ctx : StageAContext,
  tokens : Array[Token],
  if_i : Int,
  lb_in : Int,
  close_b_in : Int,
  end : Int,
  file : String,
  trivia : String,
) -> Option[(String, Int)] {
  let mut lb = lb_in
  let mut close_b = close_b_in
  while lb < end && lb > if_i + 1 && tokens[lb].kind == TokenKind::LBrace &&
  tokens[lb - 1].kind == TokenKind::Keyword && tokens[lb - 1].raw == "is" {
    let mut scan = close_b + 1
    let mut pd = 0
    while scan < end {
      let sk = tokens[scan].kind
      if pd == 0 && sk == TokenKind::LBrace {
        if !(scan > if_i + 1 && tokens[scan - 1].kind == TokenKind::ColonColon) {
          break
        }
      }
      if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { pd = pd + 1 }
      else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
      scan = scan + 1
    }
    if scan >= end || tokens[scan].kind != TokenKind::LBrace {
      return None
    }
    lb = scan
    close_b = find_matching_delim(tokens, lb)
  }
  if check_unsupported_pipe_as_in_cond(ctx, tokens, if_i + 1, lb, file) {
    return None
  }
  if !cond_needs_is_chain_lowering(tokens, if_i + 1, lb) {
    return None
  }
  let segs = split_cond_ampamp_segs(tokens, if_i + 1, lb)
  if segs.length() == 0 {
    return None
  }
  // Check for trailing `else { ... }` or `else if ...`
  let has_else = close_b + 2 < end &&
  tokens[close_b + 1].kind == TokenKind::Keyword && tokens[close_b + 1].raw == "else" &&
  (tokens[close_b + 2].kind == TokenKind::LBrace ||
    (tokens[close_b + 2].kind == TokenKind::Keyword && tokens[close_b + 2].raw == "if"))
  if !has_else {
    let saved_sc = ctx.scope_vars.length()
    let saved_rn = ctx.ident_renames.length()
    let bound_out : Array[String] = []
    let bound_seen : Map[String, Bool] = Map()
    let code = lower_is_chain_segs_with_block(
      ctx,
      tokens,
      segs,
      0,
      file,
      lb,
      close_b,
      false,
      "()",
      bound_out,
      bound_seen,
    )
    restore_scope_vars(ctx, saved_sc)
    restore_ident_renames(ctx, saved_rn)
    return Some((trivia + code, close_b + 1))
  }
  // Has `else`: lower `else` FIRST in the outer scope (so `else` NEVER sees `is` binders!)
  // Consume the complete `else if ... else ...` chain recursively so trailing `else` is never orphaned.
  let (else_s, next_after_else) = if tokens[close_b + 2].kind == TokenKind::LBrace {
    let else_lb = close_b + 2
    let else_rb = find_matching_delim(tokens, else_lb)
    (lower_block_range(ctx, tokens, else_lb, else_rb, file, ""), else_rb + 1)
  } else {
    lower_full_if_else_chain(ctx, tokens, close_b + 2, end, file)
  }
  let then_div = block_definitely_diverges(tokens, lb, close_b)
  let saved_sc = ctx.scope_vars.length()
  let saved_rn = ctx.ident_renames.length()
  let bound_out : Array[String] = []
  let bound_seen : Map[String, Bool] = Map()
  let chain_s = lower_is_chain_segs_with_block(
    ctx,
    tokens,
    segs,
    0,
    file,
    lb,
    close_b,
    !then_div,
    if then_div { "()" } else { "Option::None" },
    bound_out,
    bound_seen,
  )
  restore_scope_vars(ctx, saved_sc)
  restore_ident_renames(ctx, saved_rn)
  if then_div {
    let out = trivia + "{ " + chain_s + "; " + else_s.trim() + " }"
    return Some((out, next_after_else))
  }
  let res_v = fresh_temp(ctx, "ic")
  let out = trivia + "match (" + chain_s + ") { Option::Some(" + res_v + ") => " + res_v + ", Option::None => " + else_s.trim() + " }"
  Some((out, next_after_else))
}

///| Variant of `lower_is_chain_segs` that lowers the `then` block `[then_lb, then_rb]` at the leaf
///| AFTER all `is` binders have been pushed onto `ctx.scope_vars`.
fn lower_is_chain_segs_with_block(
  ctx : StageAContext,
  tokens : Array[Token],
  segs : Array[(Int, Int)],
  idx : Int,
  file : String,
  then_lb : Int,
  then_rb : Int,
  wrap_some : Bool,
  fail_expr : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> String {
  if idx >= segs.length() {
    let then_s = lower_block_range(ctx, tokens, then_lb, then_rb, file, "")
    return if wrap_some { "Option::Some(" + then_s + ")" } else { then_s }
  }
  let (ss, se) = segs[idx]
  let is_i = find_top_level_is_kw(tokens, ss, se)
  if is_i <= ss || is_i + 1 >= se {
    let cond_s = lower_expr_range(ctx, tokens, ss, se, file, false).trim()
    let next_s = lower_is_chain_segs_with_block(
      ctx,
      tokens,
      segs,
      idx + 1,
      file,
      then_lb,
      then_rb,
      wrap_some,
      fail_expr,
      bound_out,
      bound_seen,
    )
    return "if (" + cond_s + ") { " + next_s + " } else { " + fail_expr + " }"
  }
  let lhs_ty = infer_simple_expr_type(ctx, tokens, ss, is_i)
  let lhs_s = lower_expr_range(ctx, tokens, ss, is_i, file, false).trim()
  let mut pat_s = is_i + 1
  let mut pat_e = se
  while pat_s + 1 < pat_e && tokens[pat_s].kind == TokenKind::LParen &&
  find_matching_delim(tokens, pat_s) == pat_e - 1 &&
  !range_has_top_comma(tokens, pat_s + 1, pat_e - 1) {
    pat_s = pat_s + 1
    pat_e = pat_e - 1
  }
  if pattern_has_top_pipe(tokens, pat_s, pat_e) &&
  (pattern_contains_as_kw(tokens, pat_s, pat_e) || pattern_contains_struct_pat(tokens, pat_s, pat_e)) {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      tokens[pat_s].line,
      tokens[pat_s].col,
      "top-level or-pattern `|` with `as` or struct pattern in `is`-chain is not supported (fail-closed)",
    ))
  }
  let seg_raw_binders : Array[String] = []
  collect_is_pat_all_raw_binders(tokens, pat_s, pat_e, seg_raw_binders)
  let seg_rn = compute_scoped_binder_renames(ctx, seg_raw_binders)
  if seg_rn.length() > 0 {
    ctx.ident_renames.push(seg_rn)
  }
  let top_as = find_top_level_as_kw(tokens, pat_s, pat_e)
  let mut alias_var = ""
  let mut inner_pat_e = pat_e
  if top_as > pat_s {
    if top_as + 2 == pat_e && tokens[top_as + 1].kind == TokenKind::Ident {
      alias_var = resolve_ident_in_scope(ctx, tokens[top_as + 1].raw)
      inner_pat_e = top_as
      record_is_chain_binder(ctx, alias_var, lhs_ty, bound_out, bound_seen)
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[top_as].line,
        tokens[top_as].col,
        "unsupported `as` alias form inside `is`-chain pattern (fail-closed)",
      ))
    }
  }
  let scrut_expr = if alias_var.length() > 0 { alias_var } else { lhs_s }
  let raw_as_obls : Array[(String, Int, Int)] = []
  let peeled_as_toks = if pattern_contains_as_kw(tokens, pat_s, inner_pat_e) {
    finish_peeled_tokens(peel_nested_as_tokens(ctx, tokens, pat_s, inner_pat_e, file, raw_as_obls))
  } else {
    []
  }
  let seg_as_obls : Array[(Array[Token], String, Int, Int, String)] = []
  for aob in raw_as_obls {
    if !ctx.synth_sp_temps.contains(aob.0) {
      record_is_chain_binder(ctx, aob.0, "", bound_out, bound_seen)
    }
    seg_as_obls.push((tokens, aob.0, aob.1, aob.2, ""))
  }
  let use_peeled_as = raw_as_obls.length() > 0
  let p_toks = if use_peeled_as { peeled_as_toks } else { tokens }
  let p_s = if use_peeled_as { 0 } else { pat_s }
  let p_e = if use_peeled_as { peeled_as_toks.length() - 1 } else { inner_pat_e }
  let body_expr = if pattern_contains_struct_pat(p_toks, p_s, p_e) {
    if lhs_ty.length() > 0 {
      push_expected_type(ctx, lhs_ty)
    }
    let (outer_pat_raw, raw_obls) = peel_struct_patterns_in_pat(ctx, p_toks, p_s, p_e, file)
    let obls : Array[(String, Int, Int, String)] = []
    for ob in raw_obls {
      let osname = if ob.3.length() > 0 {
        ob.3
      } else {
        infer_struct_name_from_ty_and_pat(ctx, lhs_ty, p_toks, p_s, p_e, ob.1)
      }
      obls.push((ob.0, ob.1, ob.2, osname))
    }
    if lhs_ty.length() > 0 {
      pop_expected_type(ctx)
    }
    let outer_pat = outer_pat_raw.trim()
    for ob in obls {
      if !ctx.synth_sp_temps.contains(ob.0) {
        record_is_chain_binder(ctx, ob.0, "", bound_out, bound_seen)
      }
    }
    let ob_set : Map[String, Bool] = Map()
    for ob in obls { ob_set[ob.0] = true }
    let outer_toks = lex_moonbit(outer_pat)
    let outer_raw_bs = collect_pattern_binders(outer_toks, 0, outer_toks.length() - 1)
    for rb in outer_raw_bs {
      if !ob_set.contains(rb) && !ctx.synth_sp_temps.contains(rb) {
        record_is_chain_binder(ctx, rb, "", bound_out, bound_seen)
      }
    }
    let expanded = expand_is_chain_struct_obls_with_as(
      ctx,
      p_toks,
      tokens,
      obls,
      0,
      seg_as_obls,
      segs,
      idx + 1,
      file,
      IsChainCont::BlockCont(then_lb, then_rb, wrap_some),
      fail_expr,
      bound_out,
      bound_seen,
    )
    if is_irrefutable_simple_pat(outer_pat) {
      if outer_pat == scrut_expr {
        expanded
      } else {
        "{ let " + outer_pat + " = " + scrut_expr + "; " + expanded + " }"
      }
    } else {
      "match " + scrut_expr + " { " + outer_pat + " => " + expanded + ", _ => " + fail_expr + " }"
    }
  } else {
    if lhs_ty.length() > 0 {
      push_expected_type(ctx, lhs_ty)
    }
    let pat_str = lower_expr_range(ctx, p_toks, p_s, p_e, file, true).trim()
    if lhs_ty.length() > 0 {
      pop_expected_type(ctx)
    }
    if !use_peeled_as {
      register_simple_is_pat_binders(ctx, p_toks, p_s, p_e, lhs_ty, bound_out, bound_seen)
    } else {
      let raw_bs = collect_pattern_binders(p_toks, p_s, p_e)
      for rb in raw_bs {
        let bname = resolve_ident_in_scope(ctx, rb)
        if !ctx.synth_sp_temps.contains(bname) {
          record_is_chain_binder(ctx, bname, "", bound_out, bound_seen)
        }
      }
    }
    let next_s = expand_is_chain_as_obls(
      ctx,
      tokens,
      seg_as_obls,
      0,
      segs,
      idx + 1,
      file,
      IsChainCont::BlockCont(then_lb, then_rb, wrap_some),
      fail_expr,
      bound_out,
      bound_seen,
    )
    if is_irrefutable_simple_pat(pat_str) {
      if pat_str == "_" {
        "{ let _ = " + scrut_expr + "; " + next_s + " }"
      } else if pat_str == scrut_expr {
        next_s
      } else {
        "{ let " + pat_str + " = " + scrut_expr + "; " + next_s + " }"
      }
    } else {
      "match " + scrut_expr + " { " + pat_str + " => " + next_s + ", _ => " + fail_expr + " }"
    }
  }
  if alias_var.length() > 0 {
    "{ let " + alias_var + " = " + lhs_s + "; " + body_expr + " }"
  } else {
    body_expr
  }
}

///| Expand struct obligations for `lower_is_chain_segs_with_block`.
fn expand_is_chain_struct_obls_with_block(
  ctx : StageAContext,
  tokens : Array[Token],
  obls : Array[(String, Int, Int, String)],
  idx : Int,
  segs : Array[(Int, Int)],
  next_seg_idx : Int,
  file : String,
  then_lb : Int,
  then_rb : Int,
  wrap_some : Bool,
  fail_expr : String,
  bound_out : Array[String],
  bound_seen : Map[String, Bool],
) -> String {
  if idx >= obls.length() {
    return lower_is_chain_segs_with_block(
      ctx,
      tokens,
      segs,
      next_seg_idx,
      file,
      then_lb,
      then_rb,
      wrap_some,
      fail_expr,
      bound_out,
      bound_seen,
    )
  }
  let (bind_var, open_b, close_b, explicit_sname) = obls[idx]
  let checks : Array[String] = []
  let bind_fields : Array[(String, String, Bool)] = []
  let next_obls : Array[(String, Int, Int, String)] = []
  let mut oi = idx + 1
  while oi < obls.length() {
    next_obls.push(obls[oi])
    oi = oi + 1
  }
  let mut fi = open_b + 1
  while fi < close_b {
    if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
      fi = fi + 1
      continue
    }
    let mut fe = fi
    let mut fd = 0
    while fe < close_b {
      let fk = tokens[fe].kind
      if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
      else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
      else if fd == 0 && fk == TokenKind::Comma { break }
      fe = fe + 1
    }
    let raw_f = tokens[fi].raw
    if tokens[fi].kind == TokenKind::StringLit &&
    ((fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon) ||
      (fi + 3 < fe && tokens[fi + 1].kind == TokenKind::Question && tokens[fi + 2].kind == TokenKind::Colon)) {
      let is_opt_key = tokens[fi + 1].kind == TokenKind::Question
      let vs = if is_opt_key { fi + 3 } else { fi + 2 }
      let fexpr = bind_var + ".get(" + raw_f + ")"
      if pattern_contains_struct_pat(tokens, vs, fe) {
        let (peeled_pat, child_obls) = peel_struct_patterns_in_pat(ctx, tokens, vs, fe, file)
        for cob in child_obls {
          if !ctx.synth_sp_temps.contains(cob.0) {
            record_is_chain_binder(ctx, cob.0, "", bound_out, bound_seen)
          }
          next_obls.push((cob.0, cob.1, cob.2, cob.3))
        }
        let pp = peeled_pat.trim()
        if is_opt_key {
          bind_fields.push((fexpr, pp, is_irrefutable_simple_pat(pp)))
        } else {
          bind_fields.push((fexpr, "Some(" + pp + ")", false))
        }
      } else {
        register_simple_is_pat_binders(ctx, tokens, vs, fe, "", bound_out, bound_seen)
        let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
        if is_opt_key {
          bind_fields.push((fexpr, pat_s, is_irrefutable_simple_pat(pat_s)))
        } else {
          bind_fields.push((fexpr, "Some(" + pat_s + ")", false))
        }
      }
      fi = fe + 1
      continue
    }
    let access_f = resolve_is_chain_struct_field(ctx, explicit_sname, raw_f, file, tokens[fi].line, tokens[fi].col)
    if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
    fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
      let fexpr = bind_var + "." + access_f
      let vs = fi + 2
      if pattern_contains_struct_pat(tokens, vs, fe) {
        let field_ty = if explicit_sname.length() > 0 {
          match ctx.symtab.struct_field_types.get(explicit_sname) {
            Some(fm) => match fm.get(raw_f) { Some(ft) => ft, None => "" }
            None => ""
          }
        } else {
          ""
        }
        let (peeled_pat, child_obls) = peel_struct_patterns_in_pat(ctx, tokens, vs, fe, file)
        for cob in child_obls {
          if !ctx.synth_sp_temps.contains(cob.0) {
            record_is_chain_binder(ctx, cob.0, "", bound_out, bound_seen)
          }
          let csname = if cob.3.length() > 0 {
            cob.3
          } else {
            infer_struct_name_from_ty_and_pat(ctx, field_ty, tokens, vs, fe, cob.1)
          }
          next_obls.push((cob.0, cob.1, cob.2, csname))
        }
        let pp = peeled_pat.trim()
        bind_fields.push((fexpr, pp, is_irrefutable_simple_pat(pp)))
      } else {
        let mut has_binder = false
        let mut bi = vs
        while bi < fe {
          if tokens[bi].kind == TokenKind::Ident && tokens[bi].raw != "_" &&
          !(bi > vs && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
          !(bi + 1 < fe && tokens[bi + 1].kind == TokenKind::Colon) {
            has_binder = true
          }
          bi = bi + 1
        }
        if has_binder {
          register_simple_is_pat_binders(ctx, tokens, vs, fe, "", bound_out, bound_seen)
          let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
          bind_fields.push((fexpr, pat_s, is_irrefutable_simple_pat(pat_s)))
        } else if vs < fe {
          let vt = tokens[vs]
          if vs + 1 == fe && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
            vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
            checks.push(fexpr + " == " + vt.raw)
          } else {
            let ps = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
            if ps != "_" {
              checks.push("(match " + fexpr + " { " + ps + " => true, _ => false })")
            }
          }
        }
      }
    } else if tokens[fi].kind == TokenKind::Ident && fe == fi + 1 {
      let bind_name = resolve_ident_in_scope(ctx, raw_f)
      record_is_chain_binder(ctx, bind_name, "", bound_out, bound_seen)
      bind_fields.push((bind_var + "." + access_f, bind_name, true))
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[fi].line,
        tokens[fi].col,
        "unsupported field pattern inside struct pattern",
      ))
    }
    fi = fe + 1
  }
  let inner_s = expand_is_chain_struct_obls_with_block(
    ctx,
    tokens,
    next_obls,
    0,
    segs,
    next_seg_idx,
    file,
    then_lb,
    then_rb,
    wrap_some,
    fail_expr,
    bound_out,
    bound_seen,
  )
  let mut wrapped = inner_s
  if bind_fields.length() > 0 {
    let mut all_irref = true
    for bf in bind_fields {
      if !bf.2 {
        all_irref = false
        break
      }
    }
    if all_irref {
      let lsb = StringBuilder()
      lsb.write_string("{ ")
      for bf in bind_fields {
        lsb.write_string("let " + bf.1 + " = " + bf.0 + "; ")
      }
      lsb.write_string(wrapped + " }")
      wrapped = lsb.to_string()
    } else {
      let scrut_e = if bind_fields.length() == 1 {
        bind_fields[0].0
      } else {
        let es : Array[String] = []
        for bf in bind_fields { es.push(bf.0) }
        "(" + join_comma(es) + ")"
      }
      let pat_e = if bind_fields.length() == 1 {
        bind_fields[0].1
      } else {
        let ps : Array[String] = []
        for bf in bind_fields { ps.push(bf.1) }
        "(" + join_comma(ps) + ")"
      }
      wrapped = "match " + scrut_e + " { " + pat_e + " => " + wrapped + ", _ => " + fail_expr + " }"
    }
  }
  if checks.length() > 0 {
    let csb = StringBuilder()
    let mut ci = 0
    while ci < checks.length() {
      if ci > 0 { csb.write_string(" && ") }
      csb.write_string(checks[ci])
      ci = ci + 1
    }
    wrapped = "if (" + csb.to_string() + ") { " + wrapped + " } else { " + fail_expr + " }"
  }
  wrapped
}

///| Generate a guard leaf sentinel guaranteed NOT to appear anywhere in `[start, end)` token raw/trivia.
fn fresh_guard_sentinel(tokens : Array[Token], start : Int, end : Int, base : String) -> String {
  let mut cand = base
  let mut k = 1
  while true {
    let mut found = false
    let mut i = start
    while i < end {
      if str_has(tokens[i].raw, cand) || str_has(tokens[i].leading_trivia, cand) {
        found = true
        break
      }
      i = i + 1
    }
    if !found {
      return cand
    }
    cand = base + "_" + k.to_string()
    k = k + 1
  }
  cand
}

///| Lower a diverging `guard <cond> else { <else_body> }` when `<cond>` requires `is`-chain lowering.
///| Leaves all bound variables in `ctx.scope_vars` for the remainder of the enclosing block, while
///| keeping `<else_body>` completely outside the scope of any `is` binder.
fn try_lower_diverging_guard_is_chain(
  ctx : StageAContext,
  tokens : Array[Token],
  guard_i : Int,
  else_idx : Int,
  else_body : String,
  file : String,
) -> Option[String] {
  if check_unsupported_pipe_as_in_cond(ctx, tokens, guard_i + 1, else_idx, file) {
    return None
  }
  if !cond_needs_is_chain_lowering(tokens, guard_i + 1, else_idx) {
    return None
  }
  let segs = split_cond_ampamp_segs(tokens, guard_i + 1, else_idx)
  if segs.length() == 0 {
    return None
  }
  let bound_out : Array[String] = []
  let bound_seen : Map[String, Bool] = Map()
  let sentinel = fresh_guard_sentinel(tokens, guard_i + 1, else_idx, "__MBT_GUARD_LEAF_TUPLE__")
  let chain_raw = lower_is_chain_segs(
    ctx,
    tokens,
    segs,
    0,
    file,
    sentinel,
    "Option::None",
    bound_out,
    bound_seen,
  )
  let gv = fresh_temp(ctx, "gv")
  if bound_out.length() == 0 {
    let chain_s = chain_raw.replace(sentinel, "Option::Some(())")
    return Some("match (" + chain_s + ") { Option::Some(_) => (), Option::None => " + else_body.trim() + " }")
  }
  if bound_out.length() == 1 {
    let v0 = bound_out[0]
    let chain_s = chain_raw.replace(sentinel, "Option::Some(" + v0 + ")")
    return Some("let " + v0 + " = match (" + chain_s + ") { Option::Some(" + gv + ") => " + gv + ", Option::None => " + else_body.trim() + " }")
  }
  let tup = "(" + join_comma(bound_out) + ")"
  let chain_s = chain_raw.replace(sentinel, "Option::Some(" + tup + ")")
  Some("let " + tup + " = match (" + chain_s + ") { Option::Some(" + gv + ") => " + gv + ", Option::None => " + else_body.trim() + " }")
}

///| Lower a value-returning (non-diverging) `guard <cond> else { <else_body> }; <rest>`
///| when `<cond>` requires `is`-chain lowering.
fn try_lower_value_guard_is_chain(
  ctx : StageAContext,
  tokens : Array[Token],
  guard_i : Int,
  else_idx : Int,
  else_body : String,
  after_else : Int,
  end : Int,
  file : String,
) -> Option[String] {
  if check_unsupported_pipe_as_in_cond(ctx, tokens, guard_i + 1, else_idx, file) {
    return None
  }
  if !cond_needs_is_chain_lowering(tokens, guard_i + 1, else_idx) {
    return None
  }
  let segs = split_cond_ampamp_segs(tokens, guard_i + 1, else_idx)
  if segs.length() == 0 {
    return None
  }
  let saved_sc = ctx.scope_vars.length()
  let saved_rn = ctx.ident_renames.length()
  let bound_out : Array[String] = []
  let bound_seen : Map[String, Bool] = Map()
  let sentinel = fresh_guard_sentinel(tokens, guard_i + 1, else_idx, "__MBT_VGUARD_LEAF__")
  let chain_raw = lower_is_chain_segs(
    ctx,
    tokens,
    segs,
    0,
    file,
    sentinel,
    "Option::None",
    bound_out,
    bound_seen,
  )
  let rest_body = lower_stmts_range(ctx, tokens, after_else, end, file)
  restore_scope_vars(ctx, saved_sc)
  restore_ident_renames(ctx, saved_rn)
  let chain_s = chain_raw.replace(sentinel, "Option::Some({\n" + rest_body + "\n  })")
  let gv = fresh_temp(ctx, "gv")
  Some("match (" + chain_s + ") { Option::Some(" + gv + ") => " + gv + ", Option::None => " + else_body.trim() + " }")
}

// ============================================================================
// Part 2: Strictly sound exhaustive array-slice `match` analysis
// ============================================================================

///| Check whether a single array element sub-pattern `[start, end)` is 100% irrefutable:
///| - `_` (wildcard)
///| - lowercase identifier (binding variable; never a constructor, literal, or const)
///| - tuple `(p1, p2, ...)` whose elements are recursively irrefutable
///| - `<irrefutable> as <ident>`
///| Rejects constructors (`Some(x)`), literals, struct patterns, nested array patterns, `|`, ranges.
fn is_irrefutable_array_elem_pat(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut s = start
  let mut e = end
  if s >= e {
    return false
  }
  // Handle trailing `as <ident>` at depth 0
  let top_as = find_top_level_as_kw(tokens, s, e)
  if top_as > s {
    if top_as + 2 != e || tokens[top_as + 1].kind != TokenKind::Ident {
      return false
    }
    e = top_as
  }
  if e == s + 1 {
    let k = tokens[s].kind
    return k == TokenKind::Underscore || k == TokenKind::Ident
  }
  if tokens[s].kind == TokenKind::LParen && find_matching_delim(tokens, s) == e - 1 {
    let mut k = s + 1
    let mut has_item = false
    while k < e - 1 {
      if tokens[k].kind == TokenKind::Comma {
        k = k + 1
        continue
      }
      let mut ke = k
      let mut kd = 0
      while ke < e - 1 {
        let kk = tokens[ke].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { kd = kd + 1 }
        else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { kd = kd - 1 }
        else if kd == 0 && kk == TokenKind::Comma { break }
        ke = ke + 1
      }
      if ke <= k {
        return false
      }
      has_item = true
      if !is_irrefutable_array_elem_pat(tokens, k, ke) {
        return false
      }
      k = ke + 1
    }
    return has_item
  }
  false
}

///| Strictly sound exhaustiveness check for a `match` arm list `[start, end)` over array slices.
///| Returns `true` ONLY when:
///|   (a) at least one top-level array pattern arm is present,
///|   (b) qualifying arms have NO `if` guard, NO top-level `|` or-pattern, and EVERY element
///|       sub-pattern is irrefutable (identifier, `_`, or recursively irrefutable tuple),
///|   (c) the set of covered lengths covers EVERY non-negative integer `0, 1, 2, ...`
///|       (i.e. some open-ended `..` arm covers `>= min_open`, and every `k` in `0..<min_open`
///|       is covered by an exact-length qualifying arm).
fn is_exhaustive_array_match_arms(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let exact_lens : Map[Int, Bool] = Map()
  let mut min_open = -1
  let mut has_any_arr_arm = false
  let mut i = start
  while i < end {
    let mut fa = i
    let mut depth = 0
    let mut if_idx = -1
    let mut has_pipe = false
    while fa < end {
      let k = tokens[fa].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
        depth = depth - 1
      } else if depth == 0 {
        if k == TokenKind::FatArrow {
          break
        } else if k == TokenKind::Keyword && tokens[fa].raw == "if" && if_idx < 0 {
          if_idx = fa
        } else if k == TokenKind::Pipe && if_idx < 0 {
          has_pipe = true
        }
      }
      fa = fa + 1
    }
    if fa >= end {
      break
    }
    let pat_end = if if_idx >= 0 { if_idx } else { fa }
    // Advance past arm body to find next arm
    let body_start = fa + 1
    let mut next_i = body_start
    if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
      next_i = find_matching_delim(tokens, body_start) + 1
    } else if body_start < end && tokens[body_start].kind == TokenKind::Keyword &&
    (tokens[body_start].raw == "for" || tokens[body_start].raw == "while") {
      next_i = find_loop_stmt_end(tokens, body_start, end)
    } else {
      next_i = find_expr_end(tokens, body_start, end)
    }
    if next_i < end && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
      next_i = next_i + 1
    }

    // Check if this arm is a qualifying unguarded top-level array pattern
    if if_idx < 0 && !has_pipe && i < pat_end && tokens[i].kind == TokenKind::LBracket {
      let cbr = find_matching_delim(tokens, i)
      let has_as = cbr + 2 == pat_end - 1 &&
      tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as" &&
      tokens[cbr + 2].kind == TokenKind::Ident
      if cbr == pat_end - 1 || has_as {
        has_any_arr_arm = true
        let mut seen_rest = false
        let mut invalid = false
        let mut elem_cnt = 0
        let mut ei = i + 1
        while ei < cbr {
          if tokens[ei].kind == TokenKind::Comma {
            ei = ei + 1
            continue
          }
          let mut ee = ei
          let mut ed = 0
          while ee < cbr {
            let ek = tokens[ee].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
            else if ed == 0 && ek == TokenKind::Comma { break }
            ee = ee + 1
          }
          if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
            if seen_rest { invalid = true; break }
            seen_rest = true
          } else if ee == ei + 3 && tokens[ei].kind == TokenKind::DotDot &&
          tokens[ei + 1].kind == TokenKind::Keyword && tokens[ei + 1].raw == "as" &&
          (tokens[ei + 2].kind == TokenKind::Ident || tokens[ei + 2].kind == TokenKind::Underscore) {
            if seen_rest { invalid = true; break }
            seen_rest = true
          } else if ee > ei {
            if !is_irrefutable_array_elem_pat(tokens, ei, ee) {
              invalid = true
              break
            }
            elem_cnt = elem_cnt + 1
          }
          ei = ee + 1
        }
        if !invalid {
          if seen_rest {
            if min_open < 0 || elem_cnt < min_open {
              min_open = elem_cnt
            }
          } else {
            exact_lens[elem_cnt] = true
          }
        }
      }
    }
    i = next_i
  }
  if !has_any_arr_arm || min_open < 0 {
    return false
  }
  let mut need = 0
  while need < min_open {
    if !exact_lens.contains(need) {
      return false
    }
    need = need + 1
  }
  true
}
