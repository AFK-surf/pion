  let opget_poison_src = "struct BadEq { same : (BadEq) -> Bool }\n" +
  "impl Eq for BadEq { fn equal(self : BadEq, other : BadEq) -> Bool { (self.same)(other) } }\n" +
  "struct Bag { v : BadEq }\n" +
  "struct HasArr { kids : Array[Int] }\n" +
  "struct HasBag { kids : Bag }\n" +
  "pub fn f_bag_get(xs : Array[Int], b : HasBag, target : BadEq) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for x in xs { if b.kids[0] == target { s = s + x } }\n" +
  "  s\n" +
  "}\n"
  let og_d : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "og.pion", content: opget_poison_src, source_file: "og.mbt", anchors: [] }], og_d)
  assert_true(og_d.length() == 1 && og_d[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "same-name non-Array field Bag must poison array_elem_types/array_elem_all_builtin")

  // 16. `symtab_load_pionc_doc_json` must NOT leak `mbt_compat` container methods/Eq into `dep_method_names`,
  //     while real external dependency methods and `impl Eq` (including `" eq"` marker) MUST be recorded.
  let compat_doc = "{\"packages\":[{\"name\":\"mbt_compat\",\"items\":[" +
  "{\"kind\":\"fn\",\"name\":\"OrderedMap::length\",\"sig\":\"pub fn OrderedMap::length[K, V](self : OrderedMap[K, V]) -> Int\"}," +
  "{\"kind\":\"impl\",\"name\":\"Eq for MbtJson\",\"sig\":\"pub impl Eq for MbtJson { fn equal(self : MbtJson, other : MbtJson) -> Bool }\"}" +
  "]}]}"
  let st_compat = empty_symbol_table()
  symtab_load_pionc_doc_json(st_compat, compat_doc)
  assert_true(!st_compat.dep_method_names.contains("length"), "mbt_compat OrderedMap::length must not enter dep_method_names")
  assert_true(!st_compat.dep_method_names.contains("equal"), "mbt_compat MbtJson::equal must not enter dep_method_names")
  assert_true(!st_compat.dep_method_names.contains(" eq"), "mbt_compat impl Eq must not enter dep_method_names")

  let dep_doc = "{\"packages\":[{\"name\":\"dep\",\"items\":[" +
  "{\"kind\":\"fn\",\"name\":\"Hook::length\",\"sig\":\"pub fn Hook::length(self : Hook) -> Int\"}," +
  "{\"kind\":\"impl\",\"name\":\"Eq for Key\",\"sig\":\"pub impl Eq for Key\"}" +
  "]}]}"
  let st_dep = empty_symbol_table()
  symtab_load_pionc_doc_json(st_dep, dep_doc)
  assert_true(st_dep.dep_method_names.get("length") == Some(true), "real dep Hook::length must enter dep_method_names")
  assert_true(st_dep.dep_method_names.get(" eq") == Some(true), "real dep impl Eq must record ' eq' in dep_method_names")
  let dep_eq_only_src = "pub fn f_dep_eq(xs : Array[Int], a : dep::Key, b : dep::Key) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for x in xs { if a == b { s = s + x } }\n" +
  "  s\n" +
  "}\n"
  let dep_eq_only_d : Array[Diag] = []
  stage_b_audit_for_in_arrays_with_deps([GeneratedFile::{ rel_path: "deq.pion", content: dep_eq_only_src, source_file: "deq.mbt", anchors: [] }], st_dep.dep_method_names, dep_eq_only_d)
  assert_true(dep_eq_only_d.length() == 1 && dep_eq_only_d[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "real dep impl Eq (' eq' marker without fn equal in sig) must block for-in Eq")

  // 17. Precision refinements (positive cases that must NOT false-positive):
  //     (a) multi-type array field sets (`Plot.shelves: Array[Int]` / `Atlas.shelves: Array[Shelf]` / `Atlas.plots: Array[Plot]`)
  //     (b) non-pub freshly-constructed non-escaping `distinct_array_fields` (`Shelf.keys`)
  //     (c) package-local fresh-array returning helper (including non-escaping accumulator helper `collect_into`)
  //     (d) package-local field-or-fresh returning helper (`flow_items`) without field mutation
  //     (e) nested struct array field indexing `self.stages[ti]` without field mutation
  let prec_pos_src = "struct Plot { shelves : Array[Int] }\n" +
  "struct Shelf { keys : Array[Int] }\n" +
  "pub struct Atlas { plots : Array[Plot], shelves : Array[Shelf] }\n" +
  "fn mk_shelf() -> Shelf { Shelf::{ keys: [] } }\n" +
  "pub fn clear_plots(a : Atlas) -> Unit {\n" +
  "  for p in a.plots { p.shelves.clear() }\n" +
  "}\n" +
  "pub fn clear_shelf_keys(p : Plot, a : Atlas) -> Unit {\n" +
  "  for i in p.shelves { let s = a.shelves[i]; s.keys.clear() }\n" +
  "}\n" +
  "fn collect_into(n : Int, out : Array[Int]) -> Unit { if n > 0 { out.push(n); collect_into(n - 1, out) } }\n" +
  "fn fresh_list(n : Int) -> Array[Int] { let out = []; collect_into(n, out); out }\n" +
  "fn mutate_other(ys : Array[Int]) -> Unit { ys.clear() }\n" +
  "fn mutate_other_str(ys : Array[String]) -> Unit { ys.clear() }\n" +
  "pub fn iter_fresh_helper(n : Int, ys : Array[Int]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for x in fresh_list(n) { mutate_other(ys); s = s + x }\n" +
  "  s\n" +
  "}\n" +
  "struct Tree { children : Array[Int] }\n" +
  "fn flow_items(t : Tree, flag : Bool) -> Array[Int] { if flag { return t.children }; let out = []; out }\n" +
  "pub fn iter_flow_items(t : Tree, ys : Array[String]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for x in flow_items(t, true) { mutate_other_str(ys); s = s + x }\n" +
  "  s\n" +
  "}\n" +
  "struct Plan { stages : Array[Array[Int]] }\n" +
  "pub fn iter_nested_stage(p : Plan, ti : Int, ys : Array[String]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for x in p.stages[ti] { mutate_other_str(ys); s = s + x }\n" +
  "  s\n" +
  "}\n"
  let pp_d : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "pp.pion", content: prec_pos_src, source_file: "pp.mbt", anchors: [] }], pp_d)
  let pp_msg = if pp_d.length() > 0 { pp_d[0].message } else { "" }
  assert_true(pp_d.length() == 0, "sound precision refinements must not false-positive, got " + pp_d.length().to_string() + ": " + pp_msg)

  // 18. Companion soundness negatives for refinements (ALL 23 must fail closed):
  let prec_neg_src = "struct Box { items : Array[Int] }\n" +
  "fn get_items(b : Box) -> Array[Int] { b.items }\n" +
  "fn get_items_2(dummy : Int, b : Box) -> Array[Int] { let _ = dummy; b.items }\n" +
  "fn wipe_items(b : Box) -> Unit { b.items.clear() }\n" +
  "fn mutate_other(ys : Array[Int]) -> Unit { ys.clear() }\n" +
  "fn mutate_other_str(ys : Array[String]) -> Unit { ys.clear() }\n" +
  "fn wrap_dep(b : Box) -> Unit { dep::touch(b) }\n" +
  "fn copy(self : Box) -> Array[Int] { self.items }\n" +
  "pub fn n1(b : Box) -> Int { let mut s = 0; for x in get_items(b) { b.items.clear(); s = s + x }; s }\n" +
  "pub fn n2(b : Box) -> Int { let mut s = 0; for x in get_items(b) { wipe_items(b); s = s + x }; s }\n" +
  "struct Grid { grid : Array[Array[Int]] }\n" +
  "fn wipe_grid(g : Grid) -> Unit { g.grid[0].clear() }\n" +
  "pub fn n3(g : Grid) -> Int { let mut s = 0; for x in g.grid[0] { g.grid[0].clear(); s = s + x }; s }\n" +
  "pub fn n4(g : Grid) -> Int { let mut s = 0; for x in g.grid[0] { wipe_grid(g); s = s + x }; s }\n" +
  "pub struct PubPair { pub a : Array[Int], pub b : Array[Int] }\n" +
  "fn mk_pub() -> PubPair { PubPair::{ a: [], b: [] } }\n" +
  "pub fn n5(p : PubPair) -> Int { let mut s = 0; for x in p.a { p.b.clear(); s = s + x }; s }\n" +
  "struct PrivShared { sa : Array[Int], sb : Array[Int] }\n" +
  "fn mk_shared(xs : Array[Int]) -> PrivShared { PrivShared::{ sa: xs, sb: xs } }\n" +
  "pub fn n6(p : PrivShared) -> Int { let mut s = 0; for x in p.sa { p.sb.clear(); s = s + x }; s }\n" +
  "pub fn n7(b : Box, ys : Array[Int]) -> Int { let mut s = 0; for x in get_items(b) { mutate_other(ys); s = s + x }; s }\n" +
  "pub fn n8(g : Grid, ti : Int, ys : Array[Int]) -> Int { let mut s = 0; for x in g.grid[ti] { mutate_other(ys); s = s + x }; s }\n" +
  "pub fn n9(b : Box) -> Int { let alias = b.items; let mut s = 0; for x in b.items { mutate_other(alias); s = s + x }; s }\n" +
  "pub fn n10(xs : Array[Int], ys : Array[Int]) -> Int { let mut s = 0; for x in xs { mutate_other(ys); s = s + x }; s }\n" +
  "fn leak_push(grid : Array[Array[Int]]) -> Array[Int] { let out = [1, 2]; mbt_compat::arr_push(grid, out); out }\n" +
  "pub fn n11(grid : Array[Array[Int]]) -> Int { let mut s = 0; for x in leak_push(grid) { grid[0].clear(); s = s + x }; s }\n" +
  "pub fn n12(b : Box) -> Int { let mut s = 0; for x in get_items_2(0, b) { wrap_dep(b); s = s + x }; s }\n" +
  "struct NestMix { mixed : Array[Array[Int]] }\n" +
  "struct FlatMix { mixed : Array[Int] }\n" +
  "pub fn n13(nm : NestMix, ys : Array[String]) -> Int { let mut s = 0; for x in nm.mixed[0] { mutate_other_str(ys); s = s + x }; s }\n" +
  "pub fn n14(b : Box) -> Int { let mut s = 0; for x in b.copy() { b.items.clear(); s = s + x }; s }\n" +
  "pub fn n15_generic[T](xs : Array[Int], ys : Array[T], a : T, b : T) -> Int { let mut s = 0; for x in xs { if x == 1 { ys.push(a); ys[1] = b }; s = s + x }; s }\n" +
  "struct GenBox[T] { gxs : Array[Int], gys : Array[T] }\n" +
  "pub fn n16_genericfield[T](v : GenBox[T], a : T, b : T) -> Int { let mut s = 0; for x in v.gxs { if x == 1 { v.gys.push(a); v.gys[1] = b }; s = s + x }; s }\n" +
  "fn hp(xs : Array[Int]) -> Array[Int] { let _ = xs; [9] }\n" +
  "pub fn n17_scope(xs : Array[Int], hp : (Array[Int]) -> Array[Int]) -> Int { let mut s = 0; for x in hp(xs) { if x == 1 { xs.push(4); xs[1] = 9 }; s = s + x }; s }\n" +
  "fn produce(xs : Array[Int]) -> Array[Int] { let _ = xs; [9] }\n" +
  "pub fn n18_shadowfn(xs : Array[Int]) -> Int { let produce = fn(a : Array[Int]) -> Array[Int] { a }; let mut s = 0; for x in produce(xs) { if x == 1 { xs.push(4); xs[1] = 9 }; s = s + x }; s }\n" +
  "fn deep_ret(b : Bool, xs : Array[Int]) -> Array[Int] {\n" +
  "  if b { [9] } else { if b { [9] } else { if b { [9] } else { if b { [9] } else { if b { [9] } else { if b { [9] } else { if b { [9] } else { if b { [9] } else { xs } } } } } } } }\n" +
  "}\n" +
  "pub fn n19_depth(xs : Array[Int]) -> Int { let mut s = 0; for x in deep_ret(false, xs) { if x == 1 { xs.push(4); xs[1] = 9 }; s = s + x }; s }\n" +
  "struct NestPriv { ngrid : Array[Array[Int]], nother : Array[Int] }\n" +
  "fn mk_np(xs : Array[Int]) -> NestPriv { NestPriv::{ ngrid: [xs], nother: xs } }\n" +
  "pub fn n20_innerfield(v : NestPriv) -> Int { let mut s = 0; for x in v.nother { if x == 1 { v.ngrid[0].push(4); v.ngrid[0][1] = 9 }; s = s + x }; s }\n" +
  "pub fn n21_nestedpriv(v : NestPriv) -> Int { let mut s = 0; for x in v.ngrid[0] { if x == 1 { v.nother.push(4); v.nother[1] = 9 }; s = s + x }; s }\n" +
  "pub struct NestPub { pub pgrid : Array[Array[Int]], pub pother : Array[Int] }\n" +
  "pub fn n22_pub_innerfield(v : NestPub) -> Int { let mut s = 0; for x in v.pother { if x == 1 { v.pgrid[0].push(4); v.pgrid[0][1] = 9 }; s = s + x }; s }\n" +
  "struct LocalShadow { sitems : Array[String] }\n" +
  "fn mk_ls() -> LocalShadow { LocalShadow::{ sitems: [] } }\n" +
  "pub fn n23_dep_local_field_shadow(v : dep::Holder, xs : Array[Int]) -> Int { let mut s = 0; for x in v.sitems { if x == 1 { xs.push(4); xs[1] = 9 }; s = s + x }; s }\n" +
  "pub fn n24_param_indexed(xs : Array[Int], grid : Array[Array[Int]]) -> Int { let mut s = 0; for x in xs { if x == 1 { grid[0].push(4); grid[0][1] = 9 }; s = s + x }; s }\n" +
  "struct Box3D { g3 : Array[Array[Array[Int]]], o3 : Array[Int] }\n" +
  "pub fn n25_field_multi_indexed(v : Box3D) -> Int { let mut s = 0; for x in v.o3 { if x == 1 { v.g3[0][0].push(4); v.g3[0][0][1] = 9 }; s = s + x }; s }\n" +
  "pub fn n26_let_param_indexed(xs : Array[Int], grid : Array[Array[Int]]) -> Int { let mut s = 0; for x in xs { if x == 1 { let row = grid[0]; row.push(4); row[1] = 9 }; s = s + x }; s }\n" +
  "pub fn n27_let_field_multi_indexed(v : Box3D) -> Int { let mut s = 0; for x in v.o3 { if x == 1 { let row = v.g3[0][0]; row.push(4); row[1] = 9 }; s = s + x }; s }\n" +
  "pub fn n28_local_push_escape() -> Int { let xs = [1, 2, 3]; let g : Array[Array[Int]] = []; g.push(xs); let mut s = 0; for x in xs { if x == 1 { g[0].push(4); g[0][1] = 9 }; s = s + x }; s }\n" +
  "pub fn n29_fresh_2d_late_assign(xs : Array[Int]) -> Int { let pauses : Array[Array[Int]] = [[], []]; let mut s = 0; for x in xs { if x == 2 { pauses[0].push(4); pauses[0][1] = 9 }; if x == 1 { pauses[0] = xs }; s = s + x }; s }\n" +
  "pub fn n30_param_3d_indexed(xs : Array[Int], g3 : Array[Array[Array[Int]]]) -> Int { let mut s = 0; for x in xs { if x == 1 { g3[0][0].push(4); g3[0][0][1] = 9 }; s = s + x }; s }\n" +
  "pub fn n31_let_block_indexed(xs : Array[Int], grid : Array[Array[Int]]) -> Int { let mut s = 0; for x in xs { if x == 1 { let row = { grid[0] }; row.push(4); row[1] = 9 }; s = s + x }; s }\n" +
  "pub fn n32_let_if_indexed(xs : Array[Int], grid : Array[Array[Int]]) -> Int { let mut s = 0; for x in xs { if x == 1 { let row = if x == 1 { grid[0] } else { [] }; row.push(4); row[1] = 9 }; s = s + x }; s }\n" +
  "pub fn n33_let_field_indexed(xs : Array[Int], v : Grid) -> Int { let mut s = 0; for x in xs { if x == 1 { let row = v.grid[0]; row.push(4); row[1] = 9 }; s = s + x }; s }\n" +
  "struct T { v : Int }\n" +
  "fn note_t[T](row : T) -> Unit { let _ = row }\n" +
  "pub fn n34_generic_tparam_struct_clash(xs : Array[Int], grid : Array[Array[Int]]) -> Int { let mut s = 0; for x in xs { if x == 1 { let row = grid[0]; note_t(row); row.push(4); row[1] = 9 }; s = s + x }; s }\n" +
  "fn use_int_n35(a : Int) -> Unit { let _ = a }\n" +
  "pub fn n35_inner_tuple_shadow(xs : Array[Int], grid : Array[Array[Int]]) -> Int { let mut s = 0; for x in xs { if x == 1 { let row = grid[0]; if false { let (row, k) = (3, 2); use_int_n35(row); let _ = k }; row.push(4); row[1] = 9 }; s = s + x }; s }\n" +
  "fn put_outer_2d(g : Array[Array[Int]], a : Array[Int]) -> Unit { g[0] = a }\n" +
  "pub fn n36_fresh_2d_helper_put(xs : Array[Int]) -> Int { let g : Array[Array[Int]] = [[], []]; let mut s = 0; for x in xs { if x == 2 { g[0].push(4); g[0][1] = 9 }; if x == 1 { put_outer_2d(g, xs) }; s = s + x }; s }\n" +
  "pub fn n37_fresh_2d_alias_write(xs : Array[Int]) -> Int { let g : Array[Array[Int]] = [[], []]; let u = g; let mut s = 0; for x in xs { if x == 2 { g[0].push(4); g[0][1] = 9 }; if x == 1 { u[0] = xs }; s = s + x }; s }\n"
  let pn_d : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "pn.pion", content: prec_neg_src, source_file: "pn.mbt", anchors: [] }], pn_d)
  assert_true(pn_d.length() == 37, "all 37 refinement soundness negatives must fail closed, got " + pn_d.length().to_string())
}
