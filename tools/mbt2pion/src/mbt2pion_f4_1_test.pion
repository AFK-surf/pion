///| Wave M2-F4 Track F4-1 unit tests:
///| 1. Stage B content-versioned caching zero-drift (cached == uncached byte-for-byte + diagnostics)
///|    & order-sensitivity (edit A then audit B, reversed file order, mid-pass arr_iter lowering)
///| 2. Exact MoonBit `(buf, init_len)` slot-stability invariant on `search_by`, `iter`, and `for .. in`
///|    (single-op `insert`/`splice`/`resize`, `for x in f2 { f2.clear() }`, immediate-break `remove; break`)
///| 3. Strict package-confined escape analysis, declaration-bound effect summaries (mutual recursion),
///|    private struct closure fields `(e.off)()`, and `combobox`-style negative tests
///| 4. Dep-only dangerous same-name method rejection (`sort_key_env_of_with_deps`)

fn f4_1_has_diag(ds : Array[Diag], code : String, needle : String) -> Bool {
  for d in ds {
    if d.code == code && str_has(d.message, needle) {
      return true
    }
  }
  false
}

fn f4_1_same_files(a : Array[GeneratedFile], b : Array[GeneratedFile]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].rel_path != b[i].rel_path || a[i].content != b[i].content {
      return false
    }
    i = i + 1
  }
  true
}

fn f4_1_same_diags(a : Array[Diag], b : Array[Diag]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].code != b[i].code || a[i].file != b[i].file || a[i].line != b[i].line ||
    a[i].col != b[i].col || a[i].message != b[i].message {
      return false
    }
    i = i + 1
  }
  true
}

///| Synthetic `check_fn` that emits `unknown method` JSON diagnostics for `.shrink_to_fit()`, `.search_by(`,
///| and `.iter()` in `batch`, allowing deterministic multi-round Stage B cached vs uncached comparison.
fn f4_1_mock_check(batch : Array[(String, String)]) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"diagnostics\":[")
  let mut first = true
  for pair in batch {
    let fname = pair.0
    let lines = pair.1.split("\n")
    let mut li = 0
    while li < lines.length() {
      let ln = lines[li]
      for m in ["shrink_to_fit", "search_by", "iter"] {
        let needle = "." + m + "("
        let idx = ln.index_of(needle)
        if idx >= 0 {
          if !first { sb.write_string(",") }
          first = false
          let col = idx + 2
          sb.write_string("{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"")
          sb.write_string(fname)
          sb.write_string("\",\"line\":")
          sb.write_string((li + 1).to_string())
          sb.write_string(",\"col\":")
          sb.write_string(col.to_string())
          sb.write_string(",\"message\":\"unknown method `")
          sb.write_string(m)
          sb.write_string("` on type `Array[Int]`\"}")
        }
      }
      li = li + 1
    }
  }
  sb.write_string("]}")
  sb.to_string()
}

test "F4-1-1: Stage B content-versioned cache is byte-identical to uncached across rounds & file orders" {
  let file_a = GeneratedFile::{
    rel_path: "a.pion",
    content: "struct Box {\n  priv items : Array[Int]\n  priv aux : Array[Int]\n}\n" +
    "pub fn Box::new() -> Box {\n  Box::{ items: [], aux: [] }\n}\n" +
    "pub fn Box::reset(self : Box) -> Unit {\n  self.items.clear()\n  self.items.shrink_to_fit()\n  self.aux.clear()\n  self.aux.shrink_to_fit()\n}\n",
    source_file: "a.mbt",
    anchors: [],
  }
  let file_b = GeneratedFile::{
    rel_path: "b.pion",
    content: "pub fn find_two(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { x == 2 })\n}\n" +
    "pub fn sum_it(xs : Array[Int]) -> Int {\n  xs.iter().count()\n}\n",
    source_file: "b.mbt",
    anchors: [],
  }
  let file_c = GeneratedFile::{
    rel_path: "c.pion",
    content: "pub fn untouched(n : Int) -> Int {\n  n + 1\n}\n",
    source_file: "c.mbt",
    anchors: [],
  }

  // Order 1: [A, B, C]
  let files1 = [file_a, file_b, file_c]
  stage_b_set_cache_enabled(false)
  stage_b_reset_perf_counters()
  let d_off1 : Array[Diag] = []
  let l_off1 : Array[DriftEntry] = []
  let (out_off1, it_off1, _) = run_stage_b_with_ops(files1, empty_api_map(), Map(), f4_1_mock_check, d_off1, l_off1)
  let stats_off = stage_b_get_perf_counters()

  stage_b_set_cache_enabled(true)
  stage_b_reset_perf_counters()
  let d_on1 : Array[Diag] = []
  let l_on1 : Array[DriftEntry] = []
  let (out_on1, it_on1, _) = run_stage_b_with_ops(files1, empty_api_map(), Map(), f4_1_mock_check, d_on1, l_on1)
  let stats_on = stage_b_get_perf_counters()

  assert_eq(it_on1, it_off1)
  assert_true(f4_1_same_files(out_on1, out_off1), "cached vs uncached files must be byte-identical")
  assert_true(f4_1_same_diags(d_on1, d_off1), "cached vs uncached diagnostics must be identical")
  assert_true(stats_on.1 < stats_off.1, "cached shrink_pkg_builds must be strictly fewer than uncached")
  assert_true(stats_on.0 < stats_off.0, "cached lex_calls must be strictly fewer than uncached")
  assert_true(str_has(out_on1[0].content, "mbt_compat::arr_shrink_to_fit(self.items)"), "confined field shrink_to_fit lowered")
  assert_true(str_has(out_on1[1].content, "mbt_compat::arr_search_by(xs"), "pure search_by lowered")

  // Order 2: Reversed file order [C, B, A]
  let files2 = [file_c, file_b, file_a]
  stage_b_set_cache_enabled(false)
  let d_off2 : Array[Diag] = []
  let l_off2 : Array[DriftEntry] = []
  let (out_off2, _, _) = run_stage_b_with_ops(files2, empty_api_map(), Map(), f4_1_mock_check, d_off2, l_off2)

  stage_b_set_cache_enabled(true)
  let d_on2 : Array[Diag] = []
  let l_on2 : Array[DriftEntry] = []
  let (out_on2, _, _) = run_stage_b_with_ops(files2, empty_api_map(), Map(), f4_1_mock_check, d_on2, l_on2)

  assert_true(f4_1_same_files(out_on2, out_off2), "reversed file order cached vs uncached must be byte-identical")
  assert_true(f4_1_same_diags(d_on2, d_off2), "reversed file order diags must be identical")

  // Order 3: Mid-pass `xs.iter()` lowered to `mbt_compat::arr_iter(xs)` must still be recognized by `collect_shrink_pkg`
  let mid_src = "fn f(xs : Array[Int]) -> Array[Int] {\n  let it = mbt_compat::arr_iter(xs)\n  trim(xs)\n  it.collect()\n}\n" +
  "fn trim(ys : Array[Int]) -> Unit {\n  ys.shrink_to_fit()\n}\n"
  let mid_pkg = collect_shrink_pkg([mid_src])
  assert_true(mid_pkg.iterated_tails.contains("xs"), "kept mbt_compat::arr_iter(xs) must remain visible in iterated_tails")
  stage_b_set_cache_enabled(true)
}

test "F4-1-2: Exact MoonBit (buf, init_len) slot-stability on search_by, iter, and for .. in" {
  // 1. Single compound shifting op `xs.insert(0, 9)` in `search_by` MUST fail closed!
  let ins_src = "pub fn bad_insert(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { if x == 1 { xs.insert(0, 9) }; x == 2 })\n}\n"
  let ins_toks = lex_moonbit(ins_src)
  let ins_sum = collect_cap_pkg_summary([ins_toks], Map())
  let ins_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(ins_toks, ins_sum, "ins.pion", 2, 6, ins_diags), "insert in search_by must block")
  assert_true(f4_1_has_diag(ins_diags, "MBT2PION_ARRAY_ITER_MUTATION", ".insert(..)"), "insert diag")

  // 2. `splice` and `resize` in `search_by` and `kept_iter` MUST fail closed!
  let spl_src = "pub fn bad_splice(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { xs.splice(0, 1, []); x == 2 })\n}\n"
  let spl_toks = lex_moonbit(spl_src)
  let spl_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(spl_toks, collect_cap_pkg_summary([spl_toks], Map()), "spl.pion", 2, 6, spl_diags), "splice in search_by must block")

  let ki_spl = "fn f(xs : Array[Int]) -> Int {\n  let it = xs.iter()\n  xs.splice(0, 1, [])\n  it.count()\n}\n"
  let ki_ts = lex_moonbit(ki_spl)
  let mut ki_hit = ""
  for i, t in ki_ts {
    if t.kind == TokenKind::Dot && i + 1 < ki_ts.length() && ki_ts[i + 1].raw == "iter" {
      ki_hit = kept_iter_hazard(ki_ts, i)
    }
  }
  assert_true(str_has(ki_hit, ".splice(..)"), "splice in kept iter must block: " + ki_hit)

  // 3. In-place write ONLY in `search_by` is allowed; growth + write is blocked!
  let wr_only = "pub fn ok_write(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { xs[1] = 9; x == 9 })\n}\n"
  let wr_toks = lex_moonbit(wr_only)
  let wr_diags : Array[Diag] = []
  assert_true(stage_b_check_search_by_cached(wr_toks, collect_cap_pkg_summary([wr_toks], Map()), "wr.pion", 2, 6, wr_diags), "in-place write only in search_by is exact")

  let gw_src = "pub fn bad_grow_write(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { if x == 1 { xs.push(4); xs[1] = 9 }; x == 9 })\n}\n"
  let gw_toks = lex_moonbit(gw_src)
  let gw_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(gw_toks, collect_cap_pkg_summary([gw_toks], Map()), "gw.pion", 2, 6, gw_diags), "push + write in search_by must block")
  assert_true(f4_1_has_diag(gw_diags, "MBT2PION_ARRAY_ITER_MUTATION", "appended to and written"), "grow+write diag")

  // 4. Opus P1-3: `for x in f2 { if x == 1 { f2.clear() }; s += x }` MUST fail closed!
  let f2_src = "pub fn opus_f2() -> Int {\n  let f2 = [1, 2, 3]\n  let mut s = 0\n  for x in f2 {\n    if x == 1 { f2.clear() }\n    s = s + x\n  }\n  s\n}\n"
  let f2_diags : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "f2.pion", content: f2_src, source_file: "f2.mbt", anchors: [] }], f2_diags)
  assert_true(f4_1_has_diag(f2_diags, "MBT2PION_ARRAY_ITER_MUTATION", ".clear(..)"), "for-in clear must block")

  // 5. `for i, e in self.entries { if e.id == id { self.entries.remove(i); break } }` exits immediately -> allowed!
  let brk_src = "fn drop(self : Stack, id : Int) -> Unit {\n  for i, e in self.entries {\n    if e.id == id {\n      let _ = self.entries.remove(i)\n      break\n    }\n  }\n}\n"
  let brk_diags : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "brk.pion", content: brk_src, source_file: "brk.mbt", anchors: [] }], brk_diags)
  assert_true(brk_diags.length() == 0, "for-in remove immediately followed by break must be allowed")

  // 6. `for x in a { b.clear() }` where both `a` and `b` are array parameters -> may alias -> blocked!
  let al_src = "pub fn alias_for(a : Array[Int], b : Array[Int]) -> Int {\n  let mut s = 0\n  for x in a {\n    b.clear()\n    s = s + x\n  }\n  s\n}\n"
  let al_diags : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "al.pion", content: al_src, source_file: "al.mbt", anchors: [] }], al_diags)
  assert_true(f4_1_has_diag(al_diags, "MBT2PION_ARRAY_ITER_MUTATION", ".clear(..)"), "aliased param clear in for-in must block")
}

test "F4-1-3: Strict escape rules, mutual-recursion effect summaries, struct closure fields & combobox negative" {
  // 1. Private field initialized from caller param is NOT package-confined -> pub fn shrink_to_fit blocks!
  let caller_init = "struct S {\n  priv xs : Array[Int]\n}\n" +
  "pub fn S::wrap(xs : Array[Int]) -> S {\n  S::{ xs: xs }\n}\n" +
  "pub fn S::trim(self : S) -> Unit {\n  self.xs.shrink_to_fit()\n}\n"
  let ci_pkg = collect_shrink_pkg([caller_init])
  let ci_ts = lex_moonbit(caller_init)
  let mut ci_hit = ""
  for i, t in ci_ts {
    if t.raw == "shrink_to_fit" {
      ci_hit = shrink_snapshot_hazard(ci_ts, i, ci_pkg)
    }
  }
  assert_true(str_has(ci_hit, "is `pub`"), "private field initialized from param must NOT be confined: " + ci_hit)

  // 2. Private field returned from pub fn is NOT confined -> blocks!
  let ret_esc = "struct S {\n  priv xs : Array[Int]\n}\n" +
  "pub fn S::new() -> S {\n  S::{ xs: [] }\n}\n" +
  "pub fn S::leak(self : S) -> Array[Int] {\n  self.xs\n}\n" +
  "pub fn S::trim(self : S) -> Unit {\n  self.xs.shrink_to_fit()\n}\n"
  let re_pkg = collect_shrink_pkg([ret_esc])
  assert_true(!re_pkg.visible_fields.contains(" confined_field:xs"), "returned private field must NOT be confined")

  // 3. Mutual recursion in package effect summary: `a` calls `b`, `b` calls `a` and `clear()`
  let mrec_src = "fn a(xs : Array[Int]) -> Bool {\n  b(xs)\n}\n" +
  "fn b(xs : Array[Int]) -> Bool {\n  if xs.length() > 1 { xs.clear(); a(xs) } else { false }\n}\n" +
  "pub fn run(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { a(xs) && x == 1 })\n}\n"
  let mr_toks = lex_moonbit(mrec_src)
  let mr_sum = collect_cap_pkg_summary([mr_toks], Map())
  let mr_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(mr_toks, mr_sum, "mrec.pion", 8, 6, mr_diags), "mutually recursive mutator in search_by must block")

  // 4. Private struct closure field `(e.off)()`: pure init allowed, pub field or param init blocked!
  let priv_cb_ok = "struct Entry {\n  off : () -> Bool\n}\n" +
  "fn mk() -> Entry {\n  Entry::{ off: fn() { true } }\n}\n" +
  "pub fn find_on(es : Array[Entry]) -> Option[Int] {\n  es.search_by(fn(e) { !(e.off)() })\n}\n"
  let pc_toks = lex_moonbit(priv_cb_ok)
  let pc_sum = collect_cap_pkg_summary([pc_toks], Map())
  let pc_diags : Array[Diag] = []
  assert_true(stage_b_check_search_by_cached(pc_toks, pc_sum, "pc.pion", 8, 6, pc_diags), "priv struct closure field with all-pure inits allowed")

  let pub_cb_bad = "pub struct Entry {\n  off : () -> Bool\n}\n" +
  "fn mk() -> Entry {\n  Entry::{ off: fn() { true } }\n}\n" +
  "pub fn find_on(es : Array[Entry]) -> Option[Int] {\n  es.search_by(fn(e) { !(e.off)() })\n}\n"
  let pb_toks = lex_moonbit(pub_cb_bad)
  let pb_sum = collect_cap_pkg_summary([pb_toks], Map())
  let pb_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(pb_toks, pb_sum, "pb.pion", 8, 6, pb_diags), "pub struct closure field must block")

  // 5. `combobox`-style negative: `active_of(keys, off)` with closure parameter `off` MUST block!
  let combo_src = "fn active_of(keys : Array[Int], off : (Int) -> Bool) -> Option[Int] {\n  keys.iter().find_first(fn(k) { !off(k) })\n}\n"
  let cb_ts = lex_moonbit(combo_src)
  let mut cb_hit = ""
  for i, t in cb_ts {
    if t.kind == TokenKind::Dot && i + 1 < cb_ts.length() && cb_ts[i + 1].raw == "iter" {
      cb_hit = kept_iter_hazard(cb_ts, i)
    }
  }
  assert_true(str_has(cb_hit, "a call to `off(..)`"), "combobox-style opaque callback must block: " + cb_hit)
}

test "F4-1-4: Dep-only dangerous same-name method rejection (explicit dep_methods context)" {
  let src = "pub fn f(xs : Array[Int], h : dep::Hook, arr : Array[Int]) -> Unit {\n  xs.sort_by_key(fn(x) { h.length() + x })\n  xs.sort_by_key(fn(x) { arr.length() + x })\n}\n"
  let ts = lex_moonbit(src)
  let dep_m : Map[String, Bool] = Map()
  dep_m["length"] = true

  // 1. Explicit context interface (`sort_key_env_of_with_deps`)
  let env_explicit = sort_key_env_of_with_deps([ts], dep_m)
  let mut hits_exp : Array[String] = []
  for i, t in ts {
    if t.raw == "sort_by_key" {
      hits_exp.push(sort_key_closure_opacity(ts, i + 1, env_explicit))
    }
  }
  assert_eq(hits_exp.length(), 2)
  assert_true(str_has(hits_exp[0], "not proven built-in"), "dep-only method `length` must reject h.length(): " + hits_exp[0])
  assert_true(hits_exp[1] == "", "proven built-in Array[Int] arr.length() still allowed: " + hits_exp[1])

  // 2. Post-convergence `stage_b_audit_final_sort_keys_with_deps` threads explicit dep_methods (no global state)
  let sk_src = "pub fn f(xs : Array[Int], h : dep::Hook) -> Unit {\n  mbt_compat::arr_sort_by_key(xs, fn(x) { h.length() + x })\n}\n"
  let sk_diags : Array[Diag] = []
  stage_b_audit_final_sort_keys_with_deps([GeneratedFile::{ rel_path: "sk_dep.pion", content: sk_src, source_file: "sk_dep.mbt", anchors: [] }], dep_m, sk_diags)
  assert_true(sk_diags.length() == 1 && sk_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "stage_b_audit_final_sort_keys_with_deps must reject dep-only length")
}

test "F4-1-5: Review & Red-Team R1 soundness regressions" {
  // 1. P0-1: `remove; break` inside an inner `for` or `while` MUST block (only exits inner loop, not outer `for x in xs`)
  let inner_for_src = "pub fn f(xs : Array[Int], ys : Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    for y in ys {\n      if y == 1 { xs.remove(0); break }\n    }\n    s = s + x\n  }\n  s\n}\n"
  let d1 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "if1.pion", content: inner_for_src, source_file: "if1.mbt", anchors: [] }], d1)
  assert_true(d1.length() == 1 && d1[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "inner for break must NOT exempt outer for-in remove")

  let inner_while_src = "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    let mut i = 0\n    while i < 2 {\n      xs.remove(0)\n      break\n    }\n    s = s + x\n  }\n  s\n}\n"
  let d1b : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "iw1.pion", content: inner_while_src, source_file: "iw1.mbt", anchors: [] }], d1b)
  assert_true(d1b.length() == 1 && d1b[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "inner while break must NOT exempt outer for-in remove")

  // 2. Red-Team #2: `xs.clear(); return` inside an inner closure in `for x in xs` MUST block!
  let clo_ret_src = "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    let g = fn() -> Int { xs.clear(); return 0 }\n    s = s + g() + x\n  }\n  s\n}\n"
  let d2 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "cr1.pion", content: clo_ret_src, source_file: "cr1.mbt", anchors: [] }], d2)
  assert_true(d2.length() == 1 && d2[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "return inside inner closure must NOT exempt outer for-in clear")

  // 3. P0-2 (Refined Option B): `for x in xs { cb(xs) }`, `for x in pool { clear_pool() }`,
  //    `for x in self.items { reset(self) }`, `for x in xs { (cbs[0])(xs) }`, `for x in xs { dep::mutate(xs) }`
  let cb_for_src = "pub fn f(xs : Array[Int], cb : (Array[Int]) -> Unit) -> Int {\n  let mut s = 0\n  for x in xs { cb(xs); s = s + x }\n  s\n}\n"
  let d3a : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "cb1.pion", content: cb_for_src, source_file: "cb1.mbt", anchors: [] }], d3a)
  assert_true(d3a.length() == 1 && d3a[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "opaque cb(xs) in for-in must block")

  let pool_src = "let pool : Array[Int] = [1, 2, 3]\nfn clear_pool() -> Unit { pool.clear() }\npub fn f() -> Int {\n  let mut s = 0\n  for x in pool { clear_pool(); s = s + x }\n  s\n}\n"
  let d3b : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "pl1.pion", content: pool_src, source_file: "pl1.mbt", anchors: [] }], d3b)
  assert_true(d3b.length() == 1 && d3b[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "zero-arg clear_pool() in for-in must block")

  let reset_self_src = "struct Box { items : Array[Int] }\nfn reset(b : Box) -> Unit { b.items.clear() }\npub fn Box::run(self : Box) -> Int {\n  let mut s = 0\n  for x in self.items { reset(self); s = s + x }\n  s\n}\n"
  let d3c : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "rs1.pion", content: reset_self_src, source_file: "rs1.mbt", anchors: [] }], d3c)
  assert_true(d3c.length() == 1 && d3c[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "reset(self) in for-in self.items must block")

  let indir_src = "pub fn f(xs : Array[Int], cbs : Array[(Array[Int]) -> Unit]) -> Int {\n  let mut s = 0\n  for x in xs { (cbs[0])(xs); s = s + x }\n  s\n}\n"
  let d3d : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "in1.pion", content: indir_src, source_file: "in1.mbt", anchors: [] }], d3d)
  assert_true(d3d.length() == 1 && d3d[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "indirect call given xs in for-in must block")

  let xpkg_src = "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs { dep::mutate(xs); s = s + x }\n  s\n}\n"
  let d3e : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "xp1.pion", content: xpkg_src, source_file: "xp1.mbt", anchors: [] }], d3e)
  assert_true(d3e.length() == 1 && d3e[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "cross-package call in for-in must block")

  // 4. Red-Team #1: Cross-function grow + local write (`fn g(xs) { xs.push(4) }` + `for x in xs { g(xs); xs[1] = 9 }`)
  //    AND arbitrary receiver method `b.clear_all()`
  let xgrow_src = "fn g(xs : Array[Int]) -> Unit { xs.push(4) }\npub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs { g(xs); xs[1] = 9; s = s + x }\n  s\n}\n"
  let d4a : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "xg1.pion", content: xgrow_src, source_file: "xg1.mbt", anchors: [] }], d4a)
  assert_true(d4a.length() == 1 && d4a[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "cross-fn grow + local write in for-in must block")

  let other_recv_src = "struct Holder { items : Array[Int] }\nfn Holder::clear_all(self : Holder) -> Unit { self.items.clear() }\npub fn f(a : Holder, b : Holder) -> Int {\n  let mut s = 0\n  for x in a.items { b.clear_all(); s = s + x }\n  s\n}\n"
  let d4b : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "or1.pion", content: other_recv_src, source_file: "or1.mbt", anchors: [] }], d4b)
  assert_true(d4b.length() == 1 && d4b[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "arbitrary receiver b.clear_all() in for-in must block")

  // 5. P1-3: `search_by` calling `eq_helper(a, b)` where `impl Eq` mutates array + 3-segment `dep::Type::mutate()` collision
  let eq_help_src = "let g_arr : Array[Int] = [1, 2]\nstruct K { v : Int }\nimpl Eq for K { fn op_equal(self : K, other : K) -> Bool { g_arr.clear(); self.v == other.v } }\nfn eq_helper(a : K, b : K) -> Bool { a == b }\npub fn f(xs : Array[K], target : K) -> Option[Int] {\n  xs.search_by(fn(x) { eq_helper(x, target) })\n}\n"
  let eh_toks = lex_moonbit(eq_help_src)
  let eh_sum = collect_cap_pkg_summary([eh_toks], Map())
  let eh_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(eh_toks, eh_sum, "eh.pion", 6, 6, eh_diags), "search_by via eq_helper with mutating custom impl Eq must block")

  let seg3_src = "struct Foo { v : Int }\nfn Foo::mutate() -> Bool { true }\nfn call_dep() -> Bool { dep::Foo::mutate() }\npub fn f(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { call_dep() && x == 1 })\n}\n"
  let s3_toks = lex_moonbit(seg3_src)
  let s3_sum = collect_cap_pkg_summary([s3_toks], Map())
  let s3_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(s3_toks, s3_sum, "s3.pion", 5, 6, s3_diags), "3-segment dep::Foo::mutate() must NOT collide with local pure Foo::mutate()")

  // 6. Red-Team #3: `xs.search_by(fn(x) { [x].iter().any(cb) })` MUST block opaque `cb`!
  let sb_any_src = "pub fn f(xs : Array[Int], cb : (Int) -> Bool) -> Option[Int] {\n  xs.search_by(fn(x) { [x].iter().any(cb) })\n}\n"
  let sa_toks = lex_moonbit(sb_any_src)
  let sa_sum = collect_cap_pkg_summary([sa_toks], Map())
  let sa_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(sa_toks, sa_sum, "sa.pion", 2, 6, sa_diags), "search_by with .iter().any(cb) must block opaque cb")

  // 7. P1-5 + Red-Team #4: Confined private array with `for x in s.items { cb(s) }` or `self.xs.each(cb)` re-entering `pub fn trim`
  let reenter_for = "struct S {\n  items : Array[Int]\n}\npub fn iter_cb(s : S, cb : (S) -> Unit) -> Unit {\n  for x in s.items { cb(s) }\n}\npub fn reset(s : S) -> Unit {\n  s.items.shrink_to_fit()\n}\n"
  let rf_pkg = collect_shrink_pkg([reenter_for])
  assert_true(rf_pkg.iterated_tails.contains("items"), "for-in with opaque cb(s) must record items in iterated_tails")
  let rf_ts = lex_moonbit(reenter_for)
  let mut rf_why = ""
  for i, t in rf_ts {
    if t.raw == "shrink_to_fit" { rf_why = shrink_snapshot_hazard(rf_ts, i, rf_pkg) }
  }
  assert_true(rf_why.length() > 0, "re-entrant for-in cb(s) must block shrink_to_fit even on confined_field")

  let reenter_each = "pub struct S {\n  priv xs : Array[Int]\n}\npub fn S::visit(self : S, cb : (Int) -> Unit) -> Unit {\n  self.xs.each(cb)\n}\npub fn S::trim(self : S) -> Unit {\n  self.xs.shrink_to_fit()\n}\n"
  let re_each_pkg = collect_shrink_pkg([reenter_each])
  assert_true(!re_each_pkg.visible_fields.contains(" confined_field:xs"), "higher-order self.xs.each(cb) must disqualify confined_field")
  assert_true(re_each_pkg.iterated_tails.contains("xs"), "self.xs.each(cb) must record xs in iterated_tails")

  // 8. Unknown / trait method not in `by_name` or `dep_methods` MUST set `may_call_unknown` and block `search_by`
  let unk_m_src = "fn call_unknown_meth(u : UnknownObj) -> Bool {\n  u.mystery_mut()\n}\npub fn f(xs : Array[Int], u : UnknownObj) -> Option[Int] {\n  xs.search_by(fn(x) { call_unknown_meth(u) && x == 1 })\n}\n"
  let um_toks = lex_moonbit(unk_m_src)
  let um_sum = collect_cap_pkg_summary([um_toks], Map())
  let um_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(um_toks, um_sum, "um.pion", 5, 6, um_diags), "unknown method in callee must set may_call_unknown and block search_by")

  let trait_m_src = "fn call_trait(h : Runner) -> Bool {\n  h.run()\n}\npub fn f(xs : Array[Int], h : Runner) -> Option[Int] {\n  xs.search_by(fn(x) { call_trait(h) && x == 1 })\n}\n"
  let tm_toks = lex_moonbit(trait_m_src)
  let tm_sum = collect_cap_pkg_summary([tm_toks], Map())
  let tm_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(tm_toks, tm_sum, "tm.pion", 5, 6, tm_diags), "trait method h.run() in search_by callee must block")

  // 9. Red-Team R2: `dep_methods["clear_all"]` must NOT skip merging local `Box::clear_all`'s `mutated_fields`
  let dep_col_src = "struct Box { items : Array[Int] }\nfn Box::clear_all(self : Box) -> Unit { self.items.clear() }\nfn helper(b : Box) -> Unit { b.clear_all() }\npub fn run(a : Box, b : Box) -> Int {\n  let mut s = 0\n  for x in a.items { helper(b); s = s + x }\n  s\n}\n"
  let dc_toks = lex_moonbit(dep_col_src)
  let dc_deps : Map[String, Bool] = Map()
  dc_deps["clear_all"] = true
  let dc_sum = collect_cap_pkg_summary([dc_toks], dc_deps)
  let mut dc_hit = ""
  for i, t in dc_toks {
    if t.raw == "for" { dc_hit = for_in_array_hazard(dc_toks, i, dc_sum) }
  }
  assert_true(dc_hit.length() > 0, "dep_methods collision on clear_all must still merge local mutated_fields: " + dc_hit)

  // 10. Red-Team R2: `fn w(b : Box) { dep::mutate(b) }` inside `for x in b.items { w(b) }` must block
  let wrap_dep_src = "struct Box { items : Array[Int] }\nfn w(b : Box) -> Unit { dep::mutate(b) }\npub fn run(b : Box) -> Int {\n  let mut s = 0\n  for x in b.items { w(b); s = s + x }\n  s\n}\n"
  let wd_diags : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "wd.pion", content: wrap_dep_src, source_file: "wd.mbt", anchors: [] }], wd_diags)
  assert_true(wd_diags.length() == 1 && wd_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "wrapper calling dep::mutate(b) in for-in b.items must block")
}

test "f4_1_astra_r2_soundness_and_cache_regressions" {
  // 1. Astra P1-1: User method shadowing `Array::push` (`Hook::push`) in search_by, kept_iter, and for-in
  let hook_sb_src = "struct Hook { xs : Array[Int] }\nfn Hook::push(self : Hook, v : Int) -> Unit { self.xs.clear() }\npub fn f(xs : Array[Int], h : Hook) -> Option[Int] {\n  xs.search_by(fn(x) { h.push(x); x == 2 })\n}\n"
  let hsb_toks = lex_moonbit(hook_sb_src)
  let hsb_sum = collect_cap_pkg_summary([hsb_toks], Map())
  let hsb_diags : Array[Diag] = []
  assert_true(!stage_b_check_search_by_cached(hsb_toks, hsb_sum, "hsb.pion", 4, 6, hsb_diags), "Hook::push inside search_by must block")

  let hook_iter_src = "struct Hook { xs : Array[Int] }\nfn Hook::push(self : Hook, v : Int) -> Unit { self.xs.clear() }\npub fn f(xs : Array[Int], h : Hook) -> Int {\n  let it = xs.iter()\n  h.push(1)\n  it.count()\n}\n"
  let hi_toks = lex_moonbit(hook_iter_src)
  let hi_env = sort_key_env_of([hi_toks])
  let mut hi_dot = -1
  for i, t in hi_toks {
    if t.kind == TokenKind::Dot && i + 1 < hi_toks.length() && hi_toks[i + 1].raw == "iter" { hi_dot = i }
  }
  assert_true(kept_iter_hazard_with_env(hi_toks, hi_dot, hi_env).length() > 0, "Hook::push during kept iter must block")

  let hook_for_src = "struct Hook { items : Array[Int] }\nfn Hook::push(self : Hook, v : Int) -> Unit { self.items.clear() }\npub fn f(h : Hook) -> Int {\n  let mut s = 0\n  for x in h.items { h.push(x); s = s + x }\n  s\n}\n"
  let hf_diags : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "hf.pion", content: hook_for_src, source_file: "hf.mbt", anchors: [] }], hf_diags)
  assert_true(hf_diags.length() == 1 && hf_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "Hook::push inside for-in h.items must block")

  // 2. Astra P1-2: Same-round version bump on File A must NOT poison File A's tokens when File B scans the package
  let file_a = "pub fn a(xs : Array[Int]) -> Unit {\n  xs.unsafe_set(0, 1)\n}\n"
  let file_b = "pub fn b(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { x == 1 })\n}\n"
  let run_two = fn(cache_on : Bool) -> (String, String, Array[Diag]) {
    stage_b_set_cache_enabled(cache_on)
    let files = [
      GeneratedFile::{ rel_path: "a.pion", content: file_a, source_file: "a.mbt", anchors: [] },
      GeneratedFile::{ rel_path: "b.pion", content: file_b, source_file: "b.mbt", anchors: [] },
    ]
    let diags : Array[Diag] = []
    let log : Array[DriftEntry] = []
    let mut call_n = 0
    let (out, _, _) = run_stage_b_with_ops(files, empty_api_map(), Map(), fn(batch : Array[(String, String)]) -> String {
      call_n = call_n + 1
      if call_n == 1 {
        return "{\"diagnostics\":[{\"code\":\"E_TYPE_MISMATCH\",\"severity\":\"error\",\"file\":\"a.pion\",\"line\":2,\"col\":6,\"message\":\"unknown method `unsafe_set` on type `Array[Int]`\"},{\"code\":\"E_TYPE_MISMATCH\",\"severity\":\"error\",\"file\":\"b.pion\",\"line\":2,\"col\":6,\"message\":\"unknown method `search_by` on type `Array[Int]`\"}]}"
      }
      if call_n == 2 {
        // Verify File A was actually rewritten in round 1 AND round 2 sees updated File A (no stale cache)!
        let mut a_has_unsafe = false
        for p in batch {
          if p.0 == "a.pion" && str_has(p.1, "unsafe_set") { a_has_unsafe = true }
        }
        assert_true(!a_has_unsafe, "round 2 must see rewritten a.pion")
      }
      "{\"diagnostics\":[]}"
    }, diags, log)
    stage_b_set_cache_enabled(true)
    (out[0].content, out[1].content, diags)
  }
  let (a_off, b_off, d_off) = run_two(false)
  let (a_on, b_on, d_on) = run_two(true)
  assert_true(a_off == a_on && b_off == b_on && d_off.length() == d_on.length(), "same-round A rewrite + B pkg scan must be byte-identical with cache on/off")
  // Both a.pion and b.pion changed in round 1 (version 0 -> 1) and round 2 had 0 diags, so token_cache must NOT
  // have poisoned version 1 with round-1 tokens (Astra P1-2).
  assert_true(stage_b_last_tokens_count() == 0, "stage_b_last_tokens must not publish stale v0 tokens for v1 files")
  // Also verify Astra P2-6: stage_b_last_tokens populated by post-convergence audit and cleared after stage_b_audit_final_sort_keys
  let post_files = [
    GeneratedFile::{ rel_path: "a.pion", content: a_on, source_file: "a.mbt", anchors: [] },
    GeneratedFile::{ rel_path: "b.pion", content: b_on, source_file: "b.mbt", anchors: [] },
  ]
  let post_diags : Array[Diag] = []
  stage_b_audit_for_in_arrays(post_files, post_diags)
  assert_true(stage_b_last_tokens_count() == 2, "stage_b_last_tokens populated during post-convergence audit")
  let sk_diags : Array[Diag] = []
  stage_b_audit_final_sort_keys(post_files, sk_diags)
  assert_true(stage_b_last_tokens_count() == 0, "stage_b_last_tokens must be cleared after stage_b_audit_final_sort_keys")

  // 3. Astra P1-3: parenthesized iterable, direct field shift (mbt_compat::arr_insert), field alias, param-field alias
  let paren_src = "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in (xs) { xs.clear(); s = s + x }\n  s\n}\n"
  let p3a : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "p3a.pion", content: paren_src, source_file: "p3a.mbt", anchors: [] }], p3a)
  assert_true(p3a.length() == 1 && p3a[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "for x in (xs) with clear must block")

  let field_ins_src = "struct Box { items : Array[Int] }\npub fn f(b : Box) -> Int {\n  let mut s = 0\n  for x in b.items { mbt_compat::arr_insert(b.items, 0, 9); s = s + x }\n  s\n}\n"
  let p3b : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "p3b.pion", content: field_ins_src, source_file: "p3b.mbt", anchors: [] }], p3b)
  assert_true(p3b.length() == 1 && p3b[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "for x in b.items with mbt_compat::arr_insert(b.items, ..) must block")

  let field_alias_src = "struct Box { items : Array[Int] }\npub fn f(b : Box) -> Int {\n  let ys = b.items\n  let mut s = 0\n  for x in b.items { ys.push(4); ys[1] = 9; s = s + x }\n  s\n}\n"
  let p3c : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "p3c.pion", content: field_alias_src, source_file: "p3c.mbt", anchors: [] }], p3c)
  assert_true(p3c.length() == 1 && p3c[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "field alias ys = b.items with grow+write must block")

  let param_field_src = "struct Box { items : Array[Int] }\npub fn f(xs : Array[Int], b : Box) -> Int {\n  let mut s = 0\n  for x in xs { b.items.push(4); b.items[1] = 9; s = s + x }\n  s\n}\n"
  let p3d : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "p3d.pion", content: param_field_src, source_file: "p3d.mbt", anchors: [] }], p3d)
  assert_true(p3d.length() == 1 && p3d[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "param xs aliased by b.items with grow+write must block")

  // 4. Astra P1-4: `let _ = if x == 1 { continue } else { 0 }; break` after shift must NOT be treated as immediate exit
  let cont_src = "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    if x == 1 {\n      mbt_compat::arr_insert(xs, 0, 9)\n      let _ = if x == 1 { continue } else { 0 }\n      break\n    }\n    s = s + x\n  }\n  s\n}\n"
  let p4 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "p4.pion", content: cont_src, source_file: "p4.mbt", anchors: [] }], p4)
  assert_true(p4.length() == 1 && p4[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "continue inside let-init before break must NOT bypass for-in hazard")

  // 5. Astra P1-5: Tab after `for` (`for\tx in xs`) must NOT bypass `stage_b_audit_for_in_arrays`
  let tab_src = "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for\tx in xs { xs.clear(); s = s + x }\n  s\n}\n"
  let p5 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "p5.pion", content: tab_src, source_file: "p5.mbt", anchors: [] }], p5)
  assert_true(p5.length() == 1 && p5[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "for<tab>x in xs must still be audited and blocked")

  // 6. Leader #1: Generic type parameter `[T : Show]` must NOT shift `fn_param_idx`
  let gen_dep_src = "struct Box { items : Array[Int] }\nfn w[T : Show](b : Box, t : T) -> Unit { dep::mutate(b) }\npub fn run(b : Box) -> Int {\n  let mut s = 0\n  for x in b.items { w(b, x); s = s + x }\n  s\n}\n"
  let l1 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "l1.pion", content: gen_dep_src, source_file: "l1.mbt", anchors: [] }], l1)
  assert_true(l1.length() == 1 && l1[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "generic fn w[T : Show](b : Box) calling dep::mutate(b) must block")

  // 7. Leader #2: Method receiver `self` must map to `arg_ord = 0` in `b.w()`
  let meth_dep_src = "struct Box { items : Array[Int] }\nfn Box::w(self : Box) -> Unit { dep::mutate(self) }\npub fn run(b : Box) -> Int {\n  let mut s = 0\n  for x in b.items { b.w(); s = s + x }\n  s\n}\n"
  let l2 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "l2.pion", content: meth_dep_src, source_file: "l2.mbt", anchors: [] }], l2)
  assert_true(l2.length() == 1 && l2[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "method b.w() calling dep::mutate(self) must block")

  // 8. Opus P1 (Scheme A): Per-type impure `impl Eq` allows `Int != Int` in same pkg, blocks `BadEq` & generic `T : Eq`
  let opus_eq_src = "struct BadEq { same : (BadEq) -> Bool }\n" +
  "impl Eq for BadEq { fn equal(self : BadEq, other : BadEq) -> Bool { (self.same)(other) } }\n" +
  "struct Node { kids : Array[Int], picks : Array[BadEq] }\n" +
  "pub fn ok_int_cmp(self : Node, item : Int) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for k in self.kids { if k != item { s = s + k } }\n" +
  "  s\n" +
  "}\n" +
  "pub fn bad_eq_cmp(self : Node, target : BadEq) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for p in self.picks { if p == target { s = s + 1 } }\n" +
  "  s\n" +
  "}\n" +
  "pub fn bad_generic_cmp[T : Eq](xs : Array[T], t : T) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for x in xs { if x == t { s = s + 1 } }\n" +
  "  s\n" +
  "}\n"
  let op1 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "op1.pion", content: opus_eq_src, source_file: "op1.mbt", anchors: [] }], op1)
  // Expect exactly 2 diagnostics: bad_eq_cmp (line 11) and bad_generic_cmp (line 16), NOT ok_int_cmp (line 6)!
  assert_true(op1.length() == 2, "expected 2 diags (BadEq + generic T), got " + op1.length().to_string())
  assert_true(op1[0].line == 11 && op1[1].line == 16, "ok_int_cmp must pass while BadEq & generic T block")

  // Also verify `let mut item = at` (`at : Int`) + `for k in self.nodes[0].kids` (`kids : Array[Int]`) passes!
  let along_src = "struct BadEq { same : (BadEq) -> Bool }\n" +
  "impl Eq for BadEq { fn equal(self : BadEq, other : BadEq) -> Bool { (self.same)(other) } }\n" +
  "struct Node { mut parent : Int, kids : Array[Int] }\n" +
  "struct Tree { nodes : Array[Node] }\n" +
  "pub fn Tree::along_row_at(self : Tree, at : Int) -> Bool {\n" +
  "  let mut item = at\n" +
  "  for k in self.nodes[0].kids { if k != item { return true } }\n" +
  "  false\n" +
  "}\n"
  let op2 : Array[Diag] = []
  stage_b_audit_for_in_arrays([GeneratedFile::{ rel_path: "op2.pion", content: along_src, source_file: "op2.mbt", anchors: [] }], op2)
  assert_true(op2.length() == 0, "along_row_at Int != Int must pass with 0 diags")
}
