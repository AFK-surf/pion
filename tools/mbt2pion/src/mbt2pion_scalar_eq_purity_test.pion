///| One-sided sealed built-in scalar `==`/`!=` purity tests (positive and fail-closed).

test "scalar_eq_one_sided_purity: sealed built-in scalar ==/!= with pattern-bound operand passes Gates B and C" {
  let dep_abi = PackageAbi::{
    package_name: "dep",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [
      AbiFnMutationSummary::{
        name: "text",
        mutated_elem_types: [],
        mutates_any_array: false,
        reaches_shrink: false,
        unknown: false,
      },
    ],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let ctx = CrossPkgMutationContext::{
    dep_abis: [("dep", dep_abi)],
    using_values: Map(),
    using_types: Map(),
    pkg_aliases: Map(),
  }
  let dep_rets : Map[String, String] = Map()
  dep_rets["dep::text"] = "String"
  let src = "struct CustomBad {\n" +
  "  xs : Array[Int]\n" +
  "}\n" +
  "impl Eq for CustomBad {\n" +
  "  fn equal(self : CustomBad, _other : CustomBad) -> Bool {\n" +
  "    self.xs.clear()\n" +
  "    true\n" +
  "  }\n" +
  "}\n" +
  "struct Entry {\n" +
  "  name : String\n" +
  "  code : Int\n" +
  "}\n" +
  "pub fn check_pat_rhs(xs : Array[Entry], target : Option[String]) -> Bool {\n" +
  "  xs.iter().any(fn(e) {\n" +
  "    match target {\n" +
  "      Some(n) => e.name == n\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn check_pat_lhs(xs : Array[Entry], target : Option[String]) -> Bool {\n" +
  "  xs.iter().any(fn(e) {\n" +
  "    match target {\n" +
  "      Some(n) => n != e.name\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn check_dep_text(xs : Array[mbt_compat::MbtJson], target : Option[String]) -> Bool {\n" +
  "  xs.iter().any(fn(x) {\n" +
  "    match target {\n" +
  "      Some(id) => dep::text(Some(x), \"id\") == id\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn check_tuple_search(xs : Array[(String, Int)], pair : Option[(String, Int)]) -> Option[Int] {\n" +
  "  xs.search_by(fn(h) {\n" +
  "    match pair {\n" +
  "      Some((s, k)) => h.0 == s && h.1 != k\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n"

  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_with_cross_pkg_and_rets([toks], ["a.pion"], [src], empty_pkg_query_types(), Map(), Map(), ctx, dep_rets)

  let iter_dots : Array[Int] = []
  let mut ti = 1
  while ti + 2 < toks.length() {
    if toks[ti].kind == TokenKind::Dot && toks[ti + 1].raw == "iter" && toks[ti + 2].kind == TokenKind::LParen {
      iter_dots.push(ti)
    }
    ti = ti + 1
  }
  assert_true(iter_dots.length() == 3, "expected 3 .iter() sites")
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[0], ms, src, None, "Entry") != None,
    "e.name == n with pattern-bound n must pass Gate C",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[1], ms, src, None, "Entry") != None,
    "n != e.name with pattern-bound n on LHS must pass Gate C",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[2], ms, src, None, "mbt_compat::MbtJson") != None,
    "dep::text(Some(x), \"id\") == id must pass Gate C",
  )

  let mut sb_line = 0
  let mut sb_col = 0
  for tk in toks {
    if tk.raw == "search_by" {
      sb_line = tk.line
      sb_col = tk.col
    }
  }
  assert_true(
    stage_b_check_array_cb_with_summary(toks, ms, "a.pion", src, None, "(String, Int)", "search_by", "mbt_compat::arr_search_by", sb_line, sb_col, true, []),
    "h.0 == s && h.1 != k in search_by must pass Gate B",
  )
}

test "scalar_eq_one_sided_purity: fail-closed on impure operand, custom Eq, non-scalar pure_eq, and adjacent unknown ops" {
  let dep_abi = PackageAbi::{
    package_name: "dep",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [
      AbiFnMutationSummary::{
        name: "text",
        mutated_elem_types: [],
        mutates_any_array: false,
        reaches_shrink: false,
        unknown: false,
      },
    ],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let ctx = CrossPkgMutationContext::{
    dep_abis: [("dep", dep_abi)],
    using_values: Map(),
    using_types: Map(),
    pkg_aliases: Map(),
  }
  let dep_rets : Map[String, String] = Map()
  dep_rets["dep::text"] = "String"
  let src = "struct CustomBad {\n" +
  "  xs : Array[Int]\n" +
  "}\n" +
  "impl Eq for CustomBad {\n" +
  "  fn equal(self : CustomBad, _other : CustomBad) -> Bool {\n" +
  "    self.xs.clear()\n" +
  "    true\n" +
  "  }\n" +
  "}\n" +
  "impl Add for CustomBad {\n" +
  "  fn add(self : CustomBad, _other : CustomBad) -> CustomBad {\n" +
  "    self.xs.clear()\n" +
  "    self\n" +
  "  }\n" +
  "}\n" +
  "struct PureTag {\n" +
  "  v : Int\n" +
  "} derive(Eq)\n" +
  "pub fn neg_impure_rhs(xs : Array[mbt_compat::MbtJson], opaque_cb : () -> String) -> Bool {\n" +
  "  xs.iter().any(fn(x) { dep::text(Some(x), \"id\") == opaque_cb() })\n" +
  "}\n" +
  "pub fn neg_custom_eq_pat(xs : Array[Int], b : CustomBad, opt : Option[CustomBad]) -> Bool {\n" +
  "  xs.iter().any(fn(_x) {\n" +
  "    match opt {\n" +
  "      Some(other) => b == other\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn neg_pure_struct_pat(xs : Array[Int], p : PureTag, opt : Option[PureTag]) -> Bool {\n" +
  "  xs.iter().any(fn(_x) {\n" +
  "    match opt {\n" +
  "      Some(other) => p == other\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn neg_mbt_json_pat(xs : Array[Int], j : mbt_compat::MbtJson, opt : Option[mbt_compat::MbtJson]) -> Bool {\n" +
  "  xs.iter().any(fn(_x) {\n" +
  "    match opt {\n" +
  "      Some(other) => j == other\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn neg_adj_unknown_lhs_add(xs : Array[Int], opt : Option[(Int, Int)]) -> Bool {\n" +
  "  xs.iter().any(fn(_x) {\n" +
  "    match opt {\n" +
  "      Some((u, v)) => u + v == 1\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn neg_adj_unknown_rhs_add(xs : Array[Int], opt : Option[(Int, Int)]) -> Bool {\n" +
  "  xs.iter().any(fn(_x) {\n" +
  "    match opt {\n" +
  "      Some((u, v)) => 1 == u + v\n" +
  "      None => false\n" +
  "    }\n" +
  "  })\n" +
  "}\n" +
  "pub fn neg_conflict_ty(xs : Array[Int], s : String, b : CustomBad) -> Bool {\n" +
  "  xs.iter().any(fn(_x) { s == b })\n" +
  "}\n"

  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_with_cross_pkg_and_rets([toks], ["neg.pion"], [src], empty_pkg_query_types(), Map(), Map(), ctx, dep_rets)

  let iter_dots : Array[Int] = []
  let mut ti = 1
  while ti + 2 < toks.length() {
    if toks[ti].kind == TokenKind::Dot && toks[ti + 1].raw == "iter" && toks[ti + 2].kind == TokenKind::LParen {
      iter_dots.push(ti)
    }
    ti = ti + 1
  }
  assert_true(iter_dots.length() == 7, "expected 7 negative .iter() sites")
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[0], ms, src, None, "mbt_compat::MbtJson") == None,
    "impure opaque_cb() on RHS must fail closed",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[1], ms, src, None, "Int") == None,
    "custom Eq struct compared to pattern-bound var must fail closed",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[2], ms, src, None, "Int") == None,
    "user derive(Eq) struct compared to pattern-bound var must fail closed",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[3], ms, src, None, "Int") == None,
    "MbtJson compared to pattern-bound var must fail closed",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[4], ms, src, None, "Int") == None,
    "adjacent u + v == 1 with unknown u must fail closed",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[5], ms, src, None, "Int") == None,
    "adjacent 1 == u + v with unknown v must fail closed",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[6], ms, src, None, "Int") == None,
    "conflicting non-empty types s == b must fail closed",
  )
}
