///| Verified QBE SSA translation validator.
///|
///| `validate_fn(src, tgt)` accepts only when every execution of `tgt`
///| performs the side effects of an execution of `src` in the same order with
///| equal operands and ends the same way (same return value or `hlt`). Loads
///| and trapping divisions of `src` may be dropped (when they do not trap they
///| do not change the world; a trap is undefined behaviour).
///|
///| Solver vs. checker: `build_cert` (untrusted) searches a certificate and
///| `verify_cert` (trusted, the only part the soundness proof covers) checks
///| it, recomputing everything it relies on:
///| 1. `wf_code`: dense ids, temps in range, single assignment, `par` only at
///|    the entry.
///| 2. `check_src_defs` / `check_tgt_defs`: the symbolic value (`canon.pion`)
///|    of every temp is the value of its definition; a phi may fold only
///|    over its live edges (`edge_dead`).
///| 3. `check_avail`: every use is initialised on every path, and no value
///|    available at the entry of a block depends on a phi / effect of a
///|    source block entered while that block runs (so a value's symbolic
///|    denotation stays its current value while it is available).
///| 4. `check_facts`: values known to be zero / non-zero at a block entry
///|    (dominating `jnz`, `vendor/qbe/gvn.c` `propjnz0`).
///| 5. `replay_pair`: every matched pair of blocks (from (0, 0)) runs in lock
///|    step by its recorded steps: side effects are compared one by one, a
///|    side whose block ends with `jmp` may enter the next block (`simplcfg`
///|    merges, empty blocks), terminators are compared, the successor pairs
///|    must be certified, and target phis are checked on every matched edge.

///|
///| CFG helpers.
///|

pub fn term_nsucc(t : Term) -> Int {
  match t {
    Jmp(_) => 1
    Jnz(_, _, _) => 2
    _ => 0
  }
}

pub fn term_succ(t : Term, k : Int) -> Int {
  match t {
    Jmp(s) => if k == 0 { s } else { -1 }
    Jnz(_, s1, s2) => if k == 0 { s1 } else if k == 1 { s2 } else { -1 }
    _ => -1
  }
}

pub fn is_edge(f : Func, p : Int, s : Int) -> Bool {
  let t = f.blocks[p].term
  let n = term_nsucc(t)
  let mut k = 0
  while k < n {
    if term_succ(t, k) == s {
      return true
    }
    k = k + 1
  }
  false
}

pub fn inst_dst(inst : Inst) -> Int {
  match inst {
    Par(d, _, _) => d
    Un(d, _, _, _) => d
    Bin(d, _, _, _, _) => d
    Load(d, _, _, _, _) => d
    Store(_, _, _) => -1
    Call(d, _, h, _, _) => if h { d } else { -1 }
    Alloc(d, _, _) => d
  }
}

pub fn contains_int(xs : Array[Int], x : Int) -> Bool {
  for y in xs {
    if y == x {
      return true
    }
  }
  false
}

pub fn iota(n : Int) -> Array[Int] {
  let mut xs = Array::make(n, 0)
  let mut i = 0
  while i < n {
    xs[i] = i
    i = i + 1
  }
  xs
}

///| Static facts about a well-formed function.
pub struct FnInfo {
  nb : Int
  nt : Int
  ninst : Int
  /// 0 undefined, 1 phi, 2 instruction.
  def_kind : Array[Int]
  def_blk : Array[Int]
  def_idx : Array[Int]
  reach : Array[Bool]
  /// Number of incoming CFG edges.
  npred : Array[Int]
}

pub fn build_info(f : Func) -> FnInfo {
  let nb = f.blocks.length()
  let nt = f.ntemps
  let mut dk = Array::make(nt, 0)
  let mut db = Array::make(nt, -1)
  let mut di = Array::make(nt, -1)
  let mut ninst = 0
  let mut b = 0
  while b < nb {
    let np = f.blocks[b].phis.length()
    let mut k = 0
    while k < np {
      let d = f.blocks[b].phis[k].dst
      dk[d] = 1
      db[d] = b
      di[d] = k
      k = k + 1
    }
    let ni = f.blocks[b].insts.length()
    let mut i = 0
    while i < ni {
      let d = inst_dst(f.blocks[b].insts[i])
      if d >= 0 {
        dk[d] = 2
        db[d] = b
        di[d] = i
      }
      i = i + 1
    }
    ninst = ninst + ni
    b = b + 1
  }
  let mut npred = Array::make(nb, 0)
  let mut y = 0
  while y < nb {
    let t = f.blocks[y].term
    let n = term_nsucc(t)
    let mut k = 0
    while k < n {
      let s = term_succ(t, k)
      if s >= 0 && s < nb {
        npred[s] = npred[s] + 1
      }
      k = k + 1
    }
    y = y + 1
  }
  let mut reach = Array::make(nb, false)
  reach[0] = true
  let mut changed = true
  let mut rounds = 0
  while changed && rounds <= nb {
    changed = false
    let mut x = 0
    while x < nb {
      if reach[x] {
        let t = f.blocks[x].term
        let n = term_nsucc(t)
        let mut k = 0
        while k < n {
          let s = term_succ(t, k)
          if s >= 0 && s < nb && !reach[s] {
            reach[s] = true
            changed = true
          }
          k = k + 1
        }
      }
      x = x + 1
    }
    rounds = rounds + 1
  }
  FnInfo::{ nb, nt, ninst, def_kind: dk, def_blk: db, def_idx: di, reach, npred }
}

///|
///| 1. Well-formedness.
///|

fn temp_ok(nt : Int, t : Int) -> Bool {
  t >= 0 && t < nt
}

fn atom_ok(nt : Int, a : Atom) -> Bool {
  match a {
    Temp(t) => temp_ok(nt, t)
    _ => true
  }
}

fn inst_atoms_ok(nt : Int, inst : Inst) -> Bool {
  match inst {
    Par(_, _, _) => true
    Un(_, _, _, a) => atom_ok(nt, a)
    Bin(_, _, _, a, b) => atom_ok(nt, a) && atom_ok(nt, b)
    Load(_, _, _, _, a) => atom_ok(nt, a)
    Store(_, v, a) => atom_ok(nt, v) && atom_ok(nt, a)
    Call(_, _, _, c, args) => {
      if !atom_ok(nt, c) {
        return false
      }
      for x in args {
        if !atom_ok(nt, x.arg) {
          return false
        }
      }
      true
    }
    Alloc(_, _, _) => true
  }
}

fn target_ok(nb : Int, s : Int) -> Bool {
  s > 0 && s < nb
}

///| An instruction that writes a temp names one in range (`setreg` of a
///| negative id would write some other temp).
fn dst_ok(nt : Int, inst : Inst) -> Bool {
  match inst {
    Par(d, _, _) => temp_ok(nt, d)
    Un(d, _, _, _) => temp_ok(nt, d)
    Bin(d, _, _, _, _) => temp_ok(nt, d)
    Load(d, _, _, _, _) => temp_ok(nt, d)
    Store(_, _, _) => true
    Call(d, _, h, _, _) => !h || temp_ok(nt, d)
    Alloc(d, _, _) => temp_ok(nt, d)
  }
}

///| Every instruction of `f` passes `dst_ok`.
fn dsts_ok(f : Func) -> Bool {
  for blk in f.blocks {
    for inst in blk.insts {
      if !dst_ok(f.ntemps, inst) {
        return false
      }
    }
  }
  true
}

///| 0 when `f` is well formed, else a failure code.
pub fn wf_code(f : Func) -> Int {
  let nb = f.blocks.length()
  if nb == 0 {
    return 1
  }
  if f.ntemps < 0 || f.nparams < 0 {
    return 2
  }
  if !dsts_ok(f) {
    return 16
  }
  let nt = f.ntemps
  let mut defs = Array::make(nt, 0)
  let mut b = 0
  while b < nb {
    if f.blocks[b].id != b {
      return 3
    }
    if b == 0 && f.blocks[b].phis.length() > 0 {
      return 4
    }
    for phi in f.blocks[b].phis {
      if !temp_ok(nt, phi.dst) {
        return 5
      }
      defs[phi.dst] = defs[phi.dst] + 1
      for arm in phi.arms {
        if arm.pred < 0 || arm.pred >= nb {
          return 6
        }
        if !atom_ok(nt, arm.value) {
          return 7
        }
      }
    }
    let mut seen_other = false
    for inst in f.blocks[b].insts {
      match inst {
        Par(_, _, k) => {
          if b != 0 || seen_other {
            return 8
          }
          if k < 0 || k >= f.nparams {
            return 9
          }
        }
        _ => seen_other = true
      }
      if !inst_atoms_ok(nt, inst) {
        return 10
      }
      let d = inst_dst(inst)
      if d >= 0 {
        if !temp_ok(nt, d) {
          return 11
        }
        defs[d] = defs[d] + 1
      }
    }
    match f.blocks[b].term {
      Jmp(s) => if !target_ok(nb, s) {
        return 12
      }
      Jnz(a, s1, s2) => if !atom_ok(nt, a) || !target_ok(nb, s1) || !target_ok(nb, s2) {
        return 13
      }
      Ret(_, _, a) => if !atom_ok(nt, a) {
        return 14
      }
      Hlt => ()
    }
    b = b + 1
  }
  let mut t = 0
  while t < nt {
    if defs[t] > 1 {
      return 15
    }
    t = t + 1
  }
  0
}

pub fn wf_fn(f : Func) -> Bool {
  wf_code(f) == 0
}

///|
///| 2. Symbolic values.
///|

///| The value of atom `a` read at class `cls` (-1 when unknown).
pub fn atom_use(mut vg : ValGraph, vids : Array[Int], cls : Cls, a : Atom) -> Int {
  match a {
    Temp(t) =>
    if t >= 0 && t < vids.length() {
      vg_use(mut vg, cls, vids[t])
    } else {
      -1
    }
    Const(v) => vg_konst(mut vg, cls, v)
    Sym(id, off) => {
      let s = vg_intern(mut vg, SSym(id))
      let r = if off == 0UL {
        s
      } else {
        let o = vg_konst(mut vg, L, off)
        vg_canon_bin(mut vg, L, Add, s, o)
      }
      vg_use(mut vg, cls, r)
    }
  }
}

///| A division that cannot trap (`is_safe_div_const` on canonical operands).
pub fn bin_safe(vg : ValGraph, cls : Cls, op : BinOp, av : Int, bv : Int) -> Bool {
  match vg_const(vg, bv) {
    Some(y) => is_safe_div_const(cls, op, vg_const(vg, av), y)
    None => false
  }
}

///| The value an instruction defines; effects are the leaf `SEffect(cls, b,
///| i)` when `leaf_effects`, else -1 (target effects get their value by
///| matching).
pub fn eval_inst(
  mut vg : ValGraph,
  vids : Array[Int],
  inst : Inst,
  b : Int,
  i : Int,
  leaf_effects : Bool,
) -> Int {
  match inst {
    Par(_, c, k) => vg_intern(mut vg, SParam(c, k))
    Un(_, c, op, a) => {
      let av = atom_use(mut vg, vids, unop_arg_cls(op, c), a)
      vg_canon_un(mut vg, c, op, av)
    }
    Bin(_, c, op, a, x) => {
      let av = atom_use(mut vg, vids, binop_arg_cls(op, c, 0), a)
      let bv = atom_use(mut vg, vids, binop_arg_cls(op, c, 1), x)
      if is_trapping_binop(op) && !bin_safe(vg, c, op, av, bv) {
        if leaf_effects {
          vg_intern(mut vg, SEffect(c, b, i))
        } else {
          -1
        }
      } else {
        vg_canon_bin(mut vg, c, op, av, bv)
      }
    }
    Load(_, c, _, _, _) =>
    if leaf_effects {
      vg_intern(mut vg, SEffect(c, b, i))
    } else {
      -1
    }
    Call(_, c, _, _, _) =>
    if leaf_effects {
      vg_intern(mut vg, SEffect(c, b, i))
    } else {
      -1
    }
    Alloc(_, _, _) =>
    if leaf_effects {
      vg_intern(mut vg, SEffect(L, b, i))
    } else {
      -1
    }
    Store(_, _, _) => -1
  }
}

fn atom_known(vids : Array[Int], a : Atom) -> Bool {
  match a {
    Temp(t) => t >= 0 && t < vids.length() && vids[t] >= 0
    _ => true
  }
}

///| Operands needed before `eval_inst` (effects need none).
fn operands_known(vids : Array[Int], inst : Inst) -> Bool {
  match inst {
    Un(_, _, _, a) => atom_known(vids, a)
    Bin(_, _, _, a, b) => atom_known(vids, a) && atom_known(vids, b)
    _ => true
  }
}

fn phi_arm_index(f : Func, b : Int, k : Int, pred : Int) -> Int {
  let n = f.blocks[b].phis[k].arms.length()
  let mut j = 0
  while j < n {
    if f.blocks[b].phis[k].arms[j].pred == pred {
      return j
    }
    j = j + 1
  }
  -1
}

fn is_self_arm(a : Atom, d : Int) -> Bool {
  match a {
    Temp(t) => t == d
    _ => false
  }
}

///| Phi k1 and phi k2 of block b take equal arguments on every edge.
fn phis_same_args(mut vg : ValGraph, f : Func, vids : Array[Int], b : Int, k1 : Int, k2 : Int) -> Bool {
  let n2 = f.blocks[b].phis[k2].arms.length()
  if n2 != f.blocks[b].phis[k1].arms.length() {
    return false
  }
  let c = f.blocks[b].phis[k2].cls
  let d1 = f.blocks[b].phis[k1].dst
  let d2 = f.blocks[b].phis[k2].dst
  let mut j = 0
  while j < n2 {
    let p = f.blocks[b].phis[k2].arms[j].pred
    let a2 = f.blocks[b].phis[k2].arms[j].value
    let j1 = phi_arm_index(f, b, k1, p)
    if j1 < 0 {
      return false
    }
    let a1 = f.blocks[b].phis[k1].arms[j1].value
    if !(is_self_arm(a1, d1) && is_self_arm(a2, d2)) {
      let v1 = atom_use(mut vg, vids, c, a1)
      let v2 = atom_use(mut vg, vids, c, a2)
      if v1 < 0 || v2 < 0 || v1 != v2 {
        return false
      }
    }
    j = j + 1
  }
  true
}

///| The only predecessor of block p (-1 when it has none or several edges).
fn sole_pred(f : Func, p : Int) -> Int {
  let nb = f.blocks.length()
  let mut found = -1
  let mut count = 0
  let mut x = 0
  while x < nb {
    let t = f.blocks[x].term
    let n = term_nsucc(t)
    let mut k = 0
    while k < n {
      if term_succ(t, k) == p {
        found = x
        count = count + 1
      }
      k = k + 1
    }
    x = x + 1
  }
  if count == 1 {
    found
  } else {
    -1
  }
}

///| `vendor/qbe/copy.c` `phicopyref`: `b: x = phi @p1 1, @p0 0` where block d
///| ends with `jnz c, @p1, @p0` on a 0/1 value `c`, and p1 / p0 have d as
///| only predecessor and jump to b, is `c`. -1: no, -2: `c` not known yet.
fn phi_select(mut vg : ValGraph, f : Func, vids : Array[Int], b : Int, k : Int) -> Int {
  if f.blocks[b].phis[k].arms.length() != 2 {
    return -1
  }
  let c = f.blocks[b].phis[k].cls
  let mut p1 = -1
  let mut p0 = -1
  let mut j = 0
  while j < 2 {
    let arm_p = f.blocks[b].phis[k].arms[j].pred
    let a = f.blocks[b].phis[k].arms[j].value
    if !atom_known(vids, a) {
      return -2
    }
    let av = atom_use(mut vg, vids, c, a)
    if vg_is_const(vg, av, 1UL) {
      p1 = arm_p
    } else if vg_is_const(vg, av, 0UL) {
      p0 = arm_p
    }
    j = j + 1
  }
  if p1 < 0 || p0 < 0 || p1 == p0 {
    return -1
  }
  match f.blocks[p1].term {
    Jmp(s) => if s != b {
      return -1
    }
    _ => return -1
  }
  match f.blocks[p0].term {
    Jmp(s) => if s != b {
      return -1
    }
    _ => return -1
  }
  let d = sole_pred(f, p1)
  if d < 0 || d != sole_pred(f, p0) {
    return -1
  }
  match f.blocks[d].term {
    Jnz(cond, s1, s2) => {
      if s1 != p1 || s2 != p0 {
        return -1
      }
      if !atom_known(vids, cond) {
        return -2
      }
      let cv = atom_use(mut vg, vids, W, cond)
      if !is_bool_node(vg, cv) {
        return -1
      }
      let v = vg_use(mut vg, c, cv)
      if v < 0 || vid_mentions_blk(vg, v, b) || vid_mentions_blk(vg, v, p1) || vid_mentions_blk(vg, v, p0) {
        return -1
      }
      v
    }
    _ => -1
  }
}

///| Facts claiming a value both zero and non-zero: the block is never
///| entered.
fn facts_contradict(fs : Array[Fact]) -> Bool {
  for fa in fs {
    if fa.zero && fact_in(fs, fa.vid, false) {
      return true
    }
  }
  false
}

///| The edge p -> b is never taken: p is unreachable, its facts contradict,
///| or its `jnz` folds (under its facts) to the other successor.
pub fn edge_dead(
  mut vg : ValGraph,
  f : Func,
  info : FnInfo,
  vids : Array[Int],
  facts : Array[Fact],
  p : Int,
  b : Int,
) -> Bool {
  if p < 0 || p >= info.nb || !info.reach[p] {
    return true
  }
  let fs = facts_of(facts, p)
  if facts_contradict(fs) {
    return true
  }
  match f.blocks[p].term {
    Jnz(c, s1, s2) =>
    if s1 != s2 && atom_known(vids, c) {
      let cv0 = atom_use(mut vg, vids, W, c)
      let cv = apply_facts(mut vg, fs, cv0)
      match vg_const(vg, cv) {
        Some(x) => return (if x != 0UL { s1 } else { s2 }) != b
        None => ()
      }
    }
    _ => ()
  }
  false
}

///| Phi k of block b when all its arguments on live edges, other than itself,
///| are one value not depending on b (`gvn.c` `dedupphi`): that value; -1
///| when they differ, -2 while an argument is unknown.
fn phi_fold(mut vg : ValGraph, f : Func, info : FnInfo, vids : Array[Int], facts : Array[Fact], b : Int, k : Int) -> Int {
  let d = f.blocks[b].phis[k].dst
  let c = f.blocks[b].phis[k].cls
  let n = f.blocks[b].phis[k].arms.length()
  let mut cand = -1
  let mut same = true
  let mut j = 0
  while j < n {
    let a = f.blocks[b].phis[k].arms[j].value
    let p = f.blocks[b].phis[k].arms[j].pred
    if !is_self_arm(a, d) && !edge_dead(mut vg, f, info, vids, facts, p, b) {
      let v = atom_use(mut vg, vids, c, a)
      if v < 0 {
        return -2
      }
      if cand < 0 {
        cand = v
      } else if v != cand {
        same = false
      }
    }
    j = j + 1
  }
  if same && cand >= 0 && !vid_mentions_blk(vg, cand, b) {
    cand
  } else {
    -1
  }
}

///| Value of phi k of block b, or -1 while an argument is unknown: a folded
///| phi (`phi_fold`), a 0/1 select (`phi_select`), the value of an earlier
///| phi with the same arguments, else the leaf `SPhi(cls, b, k)`.
fn phi_try(mut vg : ValGraph, f : Func, info : FnInfo, vids : Array[Int], facts : Array[Fact], b : Int, k : Int) -> Int {
  let c = f.blocks[b].phis[k].cls
  let fold = phi_fold(mut vg, f, info, vids, facts, b, k)
  if fold == -2 {
    return -1
  }
  if fold >= 0 {
    return fold
  }
  let sel = phi_select(mut vg, f, vids, b, k)
  if sel == -2 {
    return -1
  }
  if sel >= 0 {
    return sel
  }
  let mut k1 = 0
  while k1 < k {
    let d1 = f.blocks[b].phis[k1].dst
    if f.blocks[b].phis[k1].cls == c && vids[d1] >= 0 && phis_same_args(mut vg, f, vids, b, k1, k) {
      return vids[d1]
    }
    k1 = k1 + 1
  }
  vg_intern(mut vg, SPhi(c, b, k))
}

///| Symbolic value of every source temp (-1 for temps never defined); `facts`
///| (possibly empty) mark dead edges for `phi_fold`.
pub fn src_vids(mut vg : ValGraph, f : Func, info : FnInfo, facts : Array[Fact]) -> Array[Int] {
  let nt = info.nt
  let nb = info.nb
  let mut vids = Array::make(nt, -1)
  let limit = 2 * nt + nb + 4
  let mut rounds = 0
  while rounds < limit {
    rounds = rounds + 1
    let mut progress = false
    let mut pend_b = -1
    let mut pend_k = -1
    let mut b = 0
    while b < nb {
      let np = f.blocks[b].phis.length()
      let mut k = 0
      while k < np {
        let d = f.blocks[b].phis[k].dst
        if vids[d] < 0 {
          let r = phi_try(mut vg, f, info, vids, facts, b, k)
          if r >= 0 {
            vids[d] = r
            progress = true
          } else if pend_b < 0 {
            pend_b = b
            pend_k = k
          }
        }
        k = k + 1
      }
      let ni = f.blocks[b].insts.length()
      let mut i = 0
      while i < ni {
        let d = inst_dst(f.blocks[b].insts[i])
        if d >= 0 && vids[d] < 0 && operands_known(vids, f.blocks[b].insts[i]) {
          let v = eval_inst(mut vg, vids, f.blocks[b].insts[i], b, i, true)
          if v >= 0 {
            vids[d] = v
            progress = true
          }
        }
        i = i + 1
      }
      b = b + 1
    }
    if !progress {
      if pend_b < 0 {
        break
      }
      // A cycle through phis: the first waiting phi becomes a leaf.
      let d = f.blocks[pend_b].phis[pend_k].dst
      let c = f.blocks[pend_b].phis[pend_k].cls
      vids[d] = vg_intern(mut vg, SPhi(c, pend_b, pend_k))
    }
  }
  vids
}

///|
///| 3. Initialisation certificate.
///|

///| Reachable blocks in reverse postorder of a depth-first search from the
///| entry (edges to out-of-range blocks ignored).
pub fn rev_postorder(f : Func, nb : Int) -> Array[Int] {
  let mut post : Array[Int] = []
  if nb <= 0 {
    return post
  }
  let mut seen = Array::make(nb, false)
  let mut stk_b = [0]
  let mut stk_k = [0]
  seen[0] = true
  while stk_b.length() > 0 {
    let top = stk_b.length() - 1
    let b = stk_b[top]
    let k = stk_k[top]
    let tm = f.blocks[b].term
    if k < term_nsucc(tm) {
      stk_k[top] = k + 1
      let s = term_succ(tm, k)
      if s >= 0 && s < nb && !seen[s] {
        seen[s] = true
        stk_b.push(s)
        stk_k.push(0)
      }
    } else {
      post.push(b)
      let _ = stk_b.pop()
      let _ = stk_k.pop()
    }
  }
  let n = post.length()
  let mut rpo = Array::make(n, 0)
  let mut i = 0
  while i < n {
    rpo[i] = post[n - 1 - i]
    i = i + 1
  }
  rpo
}

///| The nearest common dominator of `a` and `b` (both with a dominator).
fn idom_meet(idom : Array[Int], num : Array[Int], a : Int, b : Int) -> Int {
  let mut x = a
  let mut y = b
  let mut fuel = 4 * idom.length() + 4
  while x != y && fuel > 0 {
    fuel = fuel - 1
    while num[x] > num[y] {
      x = idom[x]
    }
    while num[y] > num[x] {
      y = idom[y]
    }
  }
  x
}

///| Immediate dominators (Cooper, Harvey, Kennedy) of the reachable blocks:
///| `idom[0] == 0`, -1 for unreachable blocks.
pub fn compute_idom(f : Func, nb : Int) -> Array[Int] {
  let mut idom = Array::make(nb, -1)
  if nb <= 0 {
    return idom
  }
  let rpo = rev_postorder(f, nb)
  let n = rpo.length()
  let mut num = Array::make(nb, -1)
  let mut i = 0
  while i < n {
    num[rpo[i]] = i
    i = i + 1
  }
  // Predecessor lists (reachable predecessors only), as linked lists.
  let mut phead = Array::make(nb, -1)
  let mut pnext : Array[Int] = []
  let mut pfrom : Array[Int] = []
  let mut y = 0
  while y < nb {
    if num[y] >= 0 {
      let tm = f.blocks[y].term
      let ns = term_nsucc(tm)
      let mut k = 0
      while k < ns {
        let s = term_succ(tm, k)
        if s >= 0 && s < nb {
          pfrom.push(y)
          pnext.push(phead[s])
          phead[s] = pfrom.length() - 1
        }
        k = k + 1
      }
    }
    y = y + 1
  }
  idom[0] = 0
  let mut changed = true
  let mut rounds = 0
  while changed && rounds <= n + 2 {
    changed = false
    rounds = rounds + 1
    let mut r = 1
    while r < n {
      let b = rpo[r]
      let mut nd = -1
      let mut e = phead[b]
      while e >= 0 {
        let p = pfrom[e]
        if idom[p] >= 0 {
          if nd < 0 {
            nd = p
          } else {
            nd = idom_meet(idom, num, p, nd)
          }
        }
        e = pnext[e]
      }
      if nd >= 0 && idom[b] != nd {
        idom[b] = nd
        changed = true
      }
      r = r + 1
    }
  }
  idom
}

///| Solver: `avail_in[b * nt + t]` — temp t is defined on every path to the
///| entry of b, i.e. in a strict dominator of b (one pass in reverse
///| postorder: `av[b] = av[idom b] ∪ defs(idom b)`). Unreachable blocks get
///| nothing (the checker never reads them).
pub fn compute_avail(f : Func, info : FnInfo) -> Array[Bool] {
  let nb = info.nb
  let nt = info.nt
  let mut av = Array::make(nb * nt, false)
  if nb <= 0 {
    return av
  }
  let idom = compute_idom(f, nb)
  let rpo = rev_postorder(f, nb)
  let n = rpo.length()
  let mut r = 1
  while r < n {
    let b = rpo[r]
    let d = idom[b]
    if d >= 0 && d != b {
      let mut x = 0
      while x < nt {
        av[b * nt + x] = av[d * nt + x]
        x = x + 1
      }
      for phi in f.blocks[d].phis {
        if phi.dst >= 0 && phi.dst < nt {
          av[b * nt + phi.dst] = true
        }
      }
      for inst in f.blocks[d].insts {
        let dd = inst_dst(inst)
        if dd >= 0 && dd < nt {
          av[b * nt + dd] = true
        }
      }
    }
    r = r + 1
  }
  av
}

fn avail_atom(cur : Array[Bool], a : Atom) -> Bool {
  match a {
    Temp(t) => t >= 0 && t < cur.length() && cur[t]
    _ => true
  }
}

fn avail_inst_ops(cur : Array[Bool], inst : Inst) -> Bool {
  match inst {
    Par(_, _, _) => true
    Un(_, _, _, a) => avail_atom(cur, a)
    Bin(_, _, _, a, b) => avail_atom(cur, a) && avail_atom(cur, b)
    Load(_, _, _, _, a) => avail_atom(cur, a)
    Store(_, v, a) => avail_atom(cur, v) && avail_atom(cur, a)
    Call(_, _, _, c, args) => {
      if !avail_atom(cur, c) {
        return false
      }
      for x in args {
        if !avail_atom(cur, x.arg) {
          return false
        }
      }
      true
    }
    Alloc(_, _, _) => true
  }
}

fn avail_term_ops(cur : Array[Bool], t : Term) -> Bool {
  match t {
    Jnz(a, _, _) => avail_atom(cur, a)
    Ret(h, _, a) => !h || avail_atom(cur, a)
    _ => true
  }
}

///| Checker for `compute_avail`'s certificate; `bm_t[j]` runs source block
///| `bm_s[j]` (the identity for a source function). 0 when it holds, else
///| the failing block + 1.
pub fn check_avail(
  vg : ValGraph,
  f : Func,
  info : FnInfo,
  av : Array[Bool],
  vids : Array[Int],
  bm_t : Array[Int],
  bm_s : Array[Int],
) -> Int {
  let nb = info.nb
  let nt = info.nt
  if av.length() != nb * nt || vids.length() != nt {
    return 1
  }
  let mut t = 0
  while t < nt {
    if av[t] {
      return 1
    }
    t = t + 1
  }
  let mut b = 0
  while b < nb {
    if info.reach[b] {
      // Values available at the entry of b must not depend on b.
      let mut xs = Array::make(0, 0)
      let mut j = 0
      while j < bm_t.length() && j < bm_s.length() {
        if bm_t[j] == b && !contains_int(xs, bm_s[j]) {
          xs.push(bm_s[j])
        }
        j = j + 1
      }
      for sb in xs {
        let m = blk_mentions_table(vg, sb)
        let mut x = 0
        while x < nt {
          if av[b * nt + x] && vids[x] >= 0 && (vids[x] >= m.length() || m[vids[x]]) {
            return b + 1
          }
          x = x + 1
        }
      }
      let mut cur = Array::make(nt, false)
      let mut y = 0
      while y < nt {
        cur[y] = av[b * nt + y]
        y = y + 1
      }
      for phi in f.blocks[b].phis {
        cur[phi.dst] = true
      }
      for inst in f.blocks[b].insts {
        if !avail_inst_ops(cur, inst) {
          return b + 1
        }
        let d = inst_dst(inst)
        if d >= 0 {
          cur[d] = true
        }
      }
      let tm = f.blocks[b].term
      if !avail_term_ops(cur, tm) {
        return b + 1
      }
      let n = term_nsucc(tm)
      let mut k = 0
      while k < n {
        let s = term_succ(tm, k)
        if s <= 0 || s >= nb {
          return b + 1
        }
        let mut z = 0
        while z < nt {
          if av[s * nt + z] && !cur[z] {
            return b + 1
          }
          z = z + 1
        }
        let np = f.blocks[s].phis.length()
        let mut q = 0
        while q < np {
          let ai = phi_arm_index(f, s, q, b)
          if ai < 0 {
            return b + 1
          }
          if !avail_atom(cur, f.blocks[s].phis[q].arms[ai].value) {
            return b + 1
          }
          q = q + 1
        }
        k = k + 1
      }
    }
    b = b + 1
  }
  0
}

///|
///| Liveness (for dead source effects).
///|

fn mark_atom(mut live : Array[Bool], a : Atom) -> Bool {
  match a {
    Temp(t) =>
    if t >= 0 && t < live.length() && !live[t] {
      live[t] = true
      true
    } else {
      false
    }
    _ => false
  }
}

fn mark_inst_ops(mut live : Array[Bool], inst : Inst) -> Bool {
  match inst {
    Un(_, _, _, a) => mark_atom(mut live, a)
    Bin(_, _, _, a, b) => {
      let x = mark_atom(mut live, a)
      let y = mark_atom(mut live, b)
      x || y
    }
    Load(_, _, _, _, a) => mark_atom(mut live, a)
    Store(_, v, a) => {
      let x = mark_atom(mut live, v)
      let y = mark_atom(mut live, a)
      x || y
    }
    Call(_, _, _, c, args) => {
      let mut ch = mark_atom(mut live, c)
      for x in args {
        if mark_atom(mut live, x.arg) {
          ch = true
        }
      }
      ch
    }
    _ => false
  }
}

///| Temps whose value may reach a store, call, branch, return or live phi.
pub fn src_live(f : Func, info : FnInfo) -> Array[Bool] {
  let nb = info.nb
  let nt = info.nt
  let mut live = Array::make(nt, false)
  let mut b = 0
  while b < nb {
    for inst in f.blocks[b].insts {
      match inst {
        Store(_, _, _) => {
          let _ = mark_inst_ops(mut live, inst)
        }
        Call(_, _, _, _, _) => {
          let _ = mark_inst_ops(mut live, inst)
        }
        _ => ()
      }
    }
    match f.blocks[b].term {
      Jnz(a, _, _) => {
        let _ = mark_atom(mut live, a)
      }
      Ret(h, _, a) => if h {
        let _ = mark_atom(mut live, a)
      }
      _ => ()
    }
    b = b + 1
  }
  let mut changed = true
  let mut rounds = 0
  while changed && rounds <= nt + 1 {
    changed = false
    rounds = rounds + 1
    let mut x = 0
    while x < nb {
      for phi in f.blocks[x].phis {
        if live[phi.dst] {
          for arm in phi.arms {
            if mark_atom(mut live, arm.value) {
              changed = true
            }
          }
        }
      }
      for inst in f.blocks[x].insts {
        let d = inst_dst(inst)
        if d >= 0 && live[d] {
          if mark_inst_ops(mut live, inst) {
            changed = true
          }
        }
      }
      x = x + 1
    }
  }
  live
}

///| A source load / trapping division whose result is dead may be dropped by
///| the target (`vendor/qbe/gcm.c` `canelim`): neither changes the world when
///| it does not trap. An `alloc` is never dropped.
fn src_effect_elidable(live : Array[Bool], inst : Inst) -> Bool {
  match inst {
    Load(d, _, _, _, _) => d >= 0 && d < live.length() && !live[d]
    Bin(d, _, op, _, _) => is_trapping_binop(op) && d >= 0 && d < live.length() && !live[d]
    _ => false
  }
}

///|
///| 4. Branch facts.
///|

///| At the entry of `blk`, the value `vid` is zero (`zero`) or non-zero.
pub struct Fact {
  blk : Int
  vid : Int
  zero : Bool
}

///| Facts of block `b`: the run of facts with `blk == b` found by binary
///| search (the solver emits them sorted by block; on an unsorted array this
///| only finds fewer facts, and every fact returned is one of `b`).
pub fn facts_of(facts : Array[Fact], b : Int) -> Array[Fact] {
  let n = facts.length()
  let mut lo = 0
  let mut hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if facts[mid].blk < b {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  let mut out : Array[Fact] = []
  let mut j = lo
  while j >= 0 && j < n && facts[j].blk == b {
    out.push(facts[j])
    j = j + 1
  }
  out
}

fn fact_in(fs : Array[Fact], vid : Int, zero : Bool) -> Bool {
  for fa in fs {
    if fa.vid == vid && fa.zero == zero {
      return true
    }
  }
  false
}

fn fact_in_blk(fs : Array[Fact], b : Int, vid : Int, zero : Bool) -> Bool {
  fact_in(facts_of(fs, b), vid, zero)
}

///| Facts established by taking the edge p -> s (`jnz` condition and its
///| `ceq` / `cne` against 0), with `blk = s`.
pub fn edge_facts(mut vg : ValGraph, f : Func, vids : Array[Int], p : Int, s : Int) -> Array[Fact] {
  let mut out : Array[Fact] = []
  match f.blocks[p].term {
    Jnz(c, s1, s2) =>
    if s1 != s2 && (s == s1 || s == s2) {
      let cv = atom_use(mut vg, vids, W, c)
      if cv >= 0 {
        let taken = s == s1
        out.push(Fact::{ blk: s, vid: cv, zero: !taken })
        match vg.nodes[cv] {
          // `x == 0` / `x != 0` read at class cc says x is zero only when x
          // has class cc (the certificate's graph is untrusted).
          SBin(_, CEq(cc), x, y) => if vg_is_const(vg, y, 0UL) && vg_cls(vg, x) == cc {
            out.push(Fact::{ blk: s, vid: x, zero: taken })
          }
          SBin(_, CNe(cc), x, y) => if vg_is_const(vg, y, 0UL) && vg_cls(vg, x) == cc {
            out.push(Fact::{ blk: s, vid: x, zero: !taken })
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

fn retarget(fs : Array[Fact], b : Int) -> Array[Fact] {
  let mut out : Array[Fact] = []
  for fa in fs {
    out.push(Fact::{ blk: b, vid: fa.vid, zero: fa.zero })
  }
  out
}

fn fact_intersect(a : Array[Fact], b : Array[Fact]) -> Array[Fact] {
  let mut out : Array[Fact] = []
  for fa in a {
    if fact_in(b, fa.vid, fa.zero) && !fact_in(out, fa.vid, fa.zero) {
      out.push(fa)
    }
  }
  out
}

fn fact_same_set(a : Array[Fact], b : Array[Fact]) -> Bool {
  for fa in a {
    if !fact_in(b, fa.vid, fa.zero) {
      return false
    }
  }
  for fb in b {
    if !fact_in(a, fb.vid, fb.zero) {
      return false
    }
  }
  true
}

///| Facts of `p` and of the edge p -> s, as facts of s.
pub fn edge_fact_set(mut vg : ValGraph, f : Func, vids : Array[Int], facts : Array[Fact], p : Int, s : Int) -> Array[Fact] {
  let mut out = retarget(facts_of(facts, p), s)
  let ef = edge_facts(mut vg, f, vids, p, s)
  for fa in ef {
    if !fact_in(out, fa.vid, fa.zero) {
      out.push(fa)
    }
  }
  out
}

///| At most this many facts are kept per block (the most recent first): a
///| long `else if` chain would otherwise carry O(blocks) facts into every
///| block (O(blocks^2) facts in all).
fn facts_cap() -> Int {
  16
}

///| Edge facts of p -> s first, then the facts of `p` (as facts of s),
///| without duplicates.
fn edge_set_of(mut vg : ValGraph, f : Func, vids : Array[Int], pf : Array[Fact], p : Int, s : Int) -> Array[Fact] {
  let mut out : Array[Fact] = []
  let ef = edge_facts(mut vg, f, vids, p, s)
  for fa in ef {
    if !fact_in(out, fa.vid, fa.zero) {
      out.push(Fact::{ blk: s, vid: fa.vid, zero: fa.zero })
    }
  }
  for fa in pf {
    if !fact_in(out, fa.vid, fa.zero) {
      out.push(Fact::{ blk: s, vid: fa.vid, zero: fa.zero })
    }
  }
  out
}

///| Solver: facts holding at every block entry (optimistic iteration over
///| the reachable blocks in reverse postorder, then pruned until every fact
///| holds on every incoming edge); sorted by block.
pub fn compute_facts(mut vg : ValGraph, f : Func, info : FnInfo, vids : Array[Int]) -> Array[Fact] {
  let nb = info.nb
  let mut flat : Array[Fact] = []
  if nb <= 0 {
    return flat
  }
  let rpo = rev_postorder(f, nb)
  let n = rpo.length()
  let mut inr = Array::make(nb, false)
  for b in rpo {
    inr[b] = true
  }
  // Reachable predecessors, as linked lists.
  let mut phead = Array::make(nb, -1)
  let mut pnext : Array[Int] = []
  let mut pfrom : Array[Int] = []
  for y in rpo {
    let tm = f.blocks[y].term
    let ns = term_nsucc(tm)
    let mut k = 0
    while k < ns {
      let s = term_succ(tm, k)
      if s >= 0 && s < nb && !(k == 1 && term_succ(tm, 0) == s) {
        pfrom.push(y)
        pnext.push(phead[s])
        phead[s] = pfrom.length() - 1
      }
      k = k + 1
    }
  }
  let mut by_blk : Array[Array[Fact]] = []
  let mut i0 = 0
  while i0 < nb {
    let empty : Array[Fact] = []
    by_blk.push(empty)
    i0 = i0 + 1
  }
  let mut known = Array::make(nb, false)
  known[0] = true
  let cap = facts_cap()
  let mut changed = true
  let mut rounds = 0
  while changed && rounds < n + 3 {
    changed = false
    rounds = rounds + 1
    let mut r = 1
    while r < n {
      let b = rpo[r]
      let mut cand : Array[Fact] = []
      let mut have = false
      let mut e = phead[b]
      while e >= 0 {
        let p = pfrom[e]
        if known[p] {
          let set = edge_set_of(mut vg, f, vids, by_blk[p], p, b)
          if have {
            cand = fact_intersect(cand, set)
          } else {
            cand = set
            have = true
          }
        }
        e = pnext[e]
      }
      if have {
        let mut keep : Array[Fact] = []
        if cand.length() > 0 {
          let m = blk_mentions_table(vg, b)
          for fa in cand {
            if keep.length() < cap && fa.vid >= 0 && fa.vid < m.length() && !m[fa.vid] && !fact_in(keep, fa.vid, fa.zero) {
              keep.push(fa)
            }
          }
        }
        if !known[b] || !fact_same_set(by_blk[b], keep) {
          by_blk[b] = keep
          known[b] = true
          changed = true
        }
      }
      r = r + 1
    }
  }
  // Prune: drop facts not established on some incoming edge (the iteration
  // above may stop early, and the cap is not monotone).
  let mut pruning = true
  let mut prounds = 0
  while pruning && prounds < 4 * n + 4 {
    pruning = false
    prounds = prounds + 1
    let mut r = 1
    while r < n {
      let b = rpo[r]
      if by_blk[b].length() > 0 {
        let mut keep : Array[Fact] = []
        for fa in by_blk[b] {
          let mut ok = true
          let mut e = phead[b]
          while e >= 0 && ok {
            let p = pfrom[e]
            if !fact_in(by_blk[p], fa.vid, fa.zero) {
              let ef = edge_facts(mut vg, f, vids, p, b)
              if !fact_in(ef, fa.vid, fa.zero) {
                ok = false
              }
            }
            e = pnext[e]
          }
          if ok {
            keep.push(fa)
          }
        }
        if keep.length() != by_blk[b].length() {
          by_blk[b] = keep
          pruning = true
        }
      }
      r = r + 1
    }
  }
  let mut b2 = 1
  while b2 < nb {
    if inr[b2] {
      for fa in by_blk[b2] {
        flat.push(fa)
      }
    }
    b2 = b2 + 1
  }
  flat
}

///| Checker: every fact of a block holds on every incoming edge and does not
///| depend on the block. 0 when it holds, else the failing block + 1.
pub fn check_facts(mut vg : ValGraph, f : Func, info : FnInfo, vids : Array[Int], facts : Array[Fact]) -> Int {
  let nb = info.nb
  // The mention table of the block of the previous fact (facts come grouped
  // by block).
  let mut mb = -1
  let mut m : Array[Bool] = []
  for fa in facts {
    let b = fa.blk
    if b <= 0 || b >= nb || !info.reach[b] {
      return 1
    }
    if !vg_valid(vg, fa.vid) {
      return b + 1
    }
    if mb != b {
      m = blk_mentions_table(vg, b)
      mb = b
    }
    if fa.vid >= m.length() || m[fa.vid] {
      return b + 1
    }
    let mut p = 0
    while p < nb {
      if info.reach[p] && is_edge(f, p, b) {
        if !fact_in_blk(facts, p, fa.vid, fa.zero) {
          let ef = edge_facts(mut vg, f, vids, p, b)
          if !fact_in(ef, fa.vid, fa.zero) {
            return b + 1
          }
        }
      }
      p = p + 1
    }
  }
  0
}

fn fact_post(mut vg : ValGraph, fs : Array[Fact], r : Int) -> Int {
  if !vg_valid(vg, r) {
    return r
  }
  let c = vg_cls(vg, r)
  if fact_in(fs, r, true) {
    return vg_konst(mut vg, c, 0UL)
  }
  match vg.nodes[r] {
    SBin(_, op, x, y) =>
    if binop_is_cmp(op) {
      if fact_in(fs, r, false) {
        return vg_konst(mut vg, c, 1UL)
      }
      if vg_is_const(vg, y, 0UL) && fact_in(fs, x, false) {
        match op {
          CEq(cc) => if vg_cls(vg, x) == cc {
            return vg_konst(mut vg, c, 0UL)
          }
          CNe(cc) => if vg_cls(vg, x) == cc {
            return vg_konst(mut vg, c, 1UL)
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  r
}

///| `v` with the facts `fs` substituted and re-canonicalised.
pub fn apply_facts(mut vg : ValGraph, fs : Array[Fact], v : Int) -> Int {
  if !vg_valid(vg, v) || fs.length() == 0 {
    return v
  }
  let n0 = v + 1
  let mut mark = Array::make(n0, false)
  mark[v] = true
  let mut i = v
  while i >= 0 {
    if mark[i] {
      match vg.nodes[i] {
        SUn(_, _, a) => if a >= 0 && a < i {
          mark[a] = true
        }
        SBin(_, _, a, b) => {
          if a >= 0 && a < i {
            mark[a] = true
          }
          if b >= 0 && b < i {
            mark[b] = true
          }
        }
        _ => ()
      }
    }
    i = i - 1
  }
  let mut memo = Array::make(n0, -1)
  let mut j = 0
  while j < n0 {
    if mark[j] {
      let n = vg.nodes[j]
      // The operands are read at the classes `vg_canon_un` / `vg_canon_bin`
      // assume (a node like `vg_trunc_w`'s `SUn(W, Copy, l)` has an `L`
      // child); a division that may trap keeps its operation.
      let r = match n {
        SUn(c, op, a) => if a >= 0 && a < j {
          let ua = vg_use(mut vg, unop_arg_cls(op, c), memo[a])
          vg_canon_un(mut vg, c, op, ua)
        } else {
          j
        }
        SBin(c, op, a, b) => if a >= 0 && a < j && b >= 0 && b < j {
          let ua = vg_use(mut vg, binop_arg_cls(op, c, 0), memo[a])
          let ub = vg_use(mut vg, binop_arg_cls(op, c, 1), memo[b])
          if is_trapping_binop(op) && !bin_safe(vg, c, op, ua, ub) {
            vg_intern(mut vg, SBin(c, op, memo[a], memo[b]))
          } else {
            vg_canon_bin(mut vg, c, op, ua, ub)
          }
        } else {
          j
        }
        _ => j
      }
      memo[j] = fact_post(mut vg, fs, r)
    }
    j = j + 1
  }
  memo[v]
}

///| Equal values under the facts `fs` (both must be known).
pub fn eq_under(mut vg : ValGraph, fs : Array[Fact], x : Int, y : Int) -> Bool {
  if !vg_valid(vg, x) || !vg_valid(vg, y) {
    return false
  }
  if x == y {
    return true
  }
  if fs.length() == 0 {
    return false
  }
  let x1 = apply_facts(mut vg, fs, x)
  let y1 = apply_facts(mut vg, fs, y)
  x1 >= 0 && x1 == y1
}

///|
///| 5. Target values and the product walk.
///|

pub struct TgtState {
  /// Symbolic value of each target temp (-1 unknown).
  mut tvid : Array[Int]
  /// Matched block pairs (queue).
  mut ps : Array[Int]
  mut pt : Array[Int]
  /// Matched edges (source pred, target pred) -> (source head, target head).
  mut e_sp : Array[Int]
  mut e_tp : Array[Int]
  mut e_sh : Array[Int]
  mut e_th : Array[Int]
  /// Target block `bm_t[j]` runs source block `bm_s[j]`.
  mut bm_t : Array[Int]
  mut bm_s : Array[Int]
  /// Index of `bm_t` / `bm_s` by target block (`bm_head[tb]`, then
  /// `bm_next[j]`, -1 ends) and of the queue by source block.
  mut bm_head : Array[Int]
  mut bm_next : Array[Int]
  mut pq_head : Array[Int]
  mut pq_next : Array[Int]
  /// Diagnostics only: the walk's steps (`act * 1_000_000 + src * 1000 + tgt`).
  mut trace : Array[Int]
  /// Certificate of the pair being walked, and of the pairs walked so far
  /// (`pcs[q]` is pair `(ps[q], pt[q])`).
  mut cur_steps : Array[Step]
  mut cur_fin : EndCert
  mut pcs : Array[PairCert]
}

pub fn tgt_state_new(nt : Int, nbs : Int, nbt : Int) -> TgtState {
  TgtState::{
    tvid: Array::make(nt, -1),
    ps: Array::make(0, 0),
    pt: Array::make(0, 0),
    e_sp: Array::make(0, 0),
    e_tp: Array::make(0, 0),
    e_sh: Array::make(0, 0),
    e_th: Array::make(0, 0),
    bm_t: Array::make(0, 0),
    bm_s: Array::make(0, 0),
    bm_head: Array::make(nbt, -1),
    bm_next: Array::make(0, 0),
    pq_head: Array::make(nbs, -1),
    pq_next: Array::make(0, 0),
    trace: Array::make(0, 0),
    cur_steps: [],
    cur_fin: EndHlt,
    pcs: [],
  }
}

fn pending_operand(tv : Array[Int], inst : Inst) -> Int {
  match inst {
    Un(_, _, _, a) =>
    match a {
      Temp(t) => if t >= 0 && t < tv.length() && tv[t] < 0 { t } else { -1 }
      _ => -1
    }
    Bin(_, _, _, a, b) => {
      match a {
        Temp(t) => if t >= 0 && t < tv.length() && tv[t] < 0 {
          return t
        }
        _ => ()
      }
      match b {
        Temp(t) => if t >= 0 && t < tv.length() && tv[t] < 0 { t } else { -1 }
        _ => -1
      }
    }
    _ => -1
  }
}

///| Value of target temp t0, evaluating pure definitions on demand (phis and
///| effects get theirs from the walk); -1 when unknown.
pub fn t_eval(mut vg : ValGraph, mut ts : TgtState, tgt : Func, ti : FnInfo, t0 : Int) -> Int {
  if t0 < 0 || t0 >= ts.tvid.length() {
    return -1
  }
  if ts.tvid[t0] >= 0 {
    return ts.tvid[t0]
  }
  let mut stack = [t0]
  let mut fuel = 4 * ti.nt + 16
  while stack.length() > 0 {
    if fuel <= 0 {
      return -1
    }
    fuel = fuel - 1
    let t = stack[stack.length() - 1]
    if ts.tvid[t] >= 0 {
      let _ = stack.pop()
    } else {
      if ti.def_kind[t] != 2 {
        return -1
      }
      let b = ti.def_blk[t]
      let i = ti.def_idx[t]
      let need = pending_operand(ts.tvid, tgt.blocks[b].insts[i])
      if need >= 0 {
        if contains_int(stack, need) {
          return -1
        }
        stack.push(need)
      } else {
        let v = eval_inst(mut vg, ts.tvid, tgt.blocks[b].insts[i], b, i, false)
        if v < 0 {
          return -1
        }
        ts.tvid[t] = v
        let _ = stack.pop()
      }
    }
  }
  ts.tvid[t0]
}

pub fn t_atom(mut vg : ValGraph, mut ts : TgtState, tgt : Func, ti : FnInfo, cls : Cls, a : Atom) -> Int {
  match a {
    Temp(t) => {
      let v = t_eval(mut vg, mut ts, tgt, ti, t)
      vg_use(mut vg, cls, v)
    }
    _ => atom_use(mut vg, ts.tvid, cls, a)
  }
}

///| Instruction i of source block b is a side effect: anything but a pure
///| instruction, and a division whose value is its own leaf `SEffect(c, b,
///| i)` (`eval_inst`). A division `check_src_defs` gave a canonical value is
///| pure even when that value is the effect leaf of another instruction (a
///| target result matched with it would hold that leaf after the source
///| re-enters its block).
fn src_inst_is_effect(vg : ValGraph, svid : Array[Int], inst : Inst, b : Int, i : Int) -> Bool {
  match inst {
    Par(_, _, _) => false
    Un(_, _, _, _) => false
    Bin(d, c, op, _, _) =>
    is_trapping_binop(op) &&
    (d < 0 || d >= svid.length() || !vg_valid(vg, svid[d]) || sym_node_eq(vg.nodes[svid[d]], SEffect(c, b, i)))
    _ => true
  }
}

fn tgt_inst_is_effect(mut vg : ValGraph, mut ts : TgtState, tgt : Func, ti : FnInfo, inst : Inst) -> Bool {
  match inst {
    Par(_, _, _) => false
    Un(_, _, _, _) => false
    Bin(_, c, op, a, b) =>
    if !is_trapping_binop(op) {
      false
    } else {
      let av = t_atom(mut vg, mut ts, tgt, ti, binop_arg_cls(op, c, 0), a)
      let bv = t_atom(mut vg, mut ts, tgt, ti, binop_arg_cls(op, c, 1), b)
      !bin_safe(vg, c, op, av, bv)
    }
    _ => true
  }
}

///| Some phi of source block b is the leaf `SPhi(_, b, _)`: entering b
///| redefines it, so b must not be run in the middle of a matched pair.
fn blk_has_phi_leaf(vg : ValGraph, f : Func, svid : Array[Int], b : Int) -> Bool {
  for phi in f.blocks[b].phis {
    let d = phi.dst
    if d >= 0 && d < svid.length() && vg_is_phi_of(vg, svid[d], b) {
      return true
    }
  }
  false
}

///| A block with no phi and no side effect that ends with `jmp`.
fn is_trivial(f : Func, b : Int) -> Bool {
  if f.blocks[b].phis.length() > 0 {
    return false
  }
  for inst in f.blocks[b].insts {
    match inst {
      Par(_, _, _) => ()
      Un(_, _, _, _) => ()
      Bin(_, _, op, _, _) => if is_trapping_binop(op) {
        return false
      }
      _ => return false
    }
  }
  match f.blocks[b].term {
    Jmp(_) => true
    _ => false
  }
}

///| A block with no side effect that ends with `jmp` (phis allowed).
fn is_pure_jmp(f : Func, b : Int) -> Bool {
  for inst in f.blocks[b].insts {
    match inst {
      Par(_, _, _) => ()
      Un(_, _, _, _) => ()
      Bin(_, _, op, _, _) => if is_trapping_binop(op) {
        return false
      }
      _ => return false
    }
  }
  match f.blocks[b].term {
    Jmp(_) => true
    _ => false
  }
}

///| The block reached from b0 through blocks with no phi and no side effect
///| ending with `jmp` (at most `nb` of them).
pub fn resolve_trivial(f : Func, b0 : Int) -> Int {
  let nb = f.blocks.length()
  let mut b = b0
  let mut steps = 0
  while steps < nb && is_trivial(f, b) {
    match f.blocks[b].term {
      Jmp(n) => b = n
      _ => ()
    }
    steps = steps + 1
  }
  b
}

///| Source block b ends with `jnz` whose two arms reach the same block r
///| through empty blocks (`vendor/qbe/cfg.c` `simplcfg`): r, else -1. No
///| branch fact is assumed at r: both arms get there.
pub fn src_join(f : Func, b : Int) -> Int {
  match f.blocks[b].term {
    Jnz(_, s1, s2) => {
      let r1 = resolve_trivial(f, s1)
      let r2 = resolve_trivial(f, s2)
      if r1 == r2 {
        r1
      } else {
        -1
      }
    }
    _ => -1
  }
}

///| `src_join` of the current source block when the walk may enter it.
fn src_join_ok(vg : ValGraph, src : Func, svid : Array[Int], sc : Int, schain : Array[Int]) -> Int {
  let r = src_join(src, sc)
  if r > 0 && !contains_int(schain, r) && !blk_has_phi_leaf(vg, src, svid, r) {
    r
  } else {
    -1
  }
}

///| A block with no side effect that ends with `jnz`.
fn is_pure_branch(f : Func, b : Int) -> Bool {
  for inst in f.blocks[b].insts {
    match inst {
      Par(_, _, _) => ()
      Un(_, _, _, _) => ()
      Bin(_, _, op, _, _) => if is_trapping_binop(op) {
        return false
      }
      _ => return false
    }
  }
  match f.blocks[b].term {
    Jnz(_, _, _) => true
    _ => false
  }
}

///| A terminator after constant folding under the block's facts.
enum TView {
  VJmp(Int)
  VJnz(Int, Int, Int)
  VRet(Bool, Cls, Int)
  VHlt
}

fn view_jmp(v : TView) -> Int {
  match v {
    VJmp(s) => s
    _ => -1
  }
}

fn src_view(mut vg : ValGraph, f : Func, svid : Array[Int], fs : Array[Fact], b : Int) -> TView {
  match f.blocks[b].term {
    Jmp(s) => VJmp(s)
    Jnz(c, s1, s2) => {
      if s1 == s2 {
        return VJmp(s1)
      }
      let cv0 = atom_use(mut vg, svid, W, c)
      let cv = apply_facts(mut vg, fs, cv0)
      match vg_const(vg, cv) {
        Some(x) => return VJmp(if x != 0UL { s1 } else { s2 })
        None => ()
      }
      VJnz(cv, s1, s2)
    }
    Ret(h, c, a) =>
    if h {
      let v0 = atom_use(mut vg, svid, c, a)
      VRet(h, c, apply_facts(mut vg, fs, v0))
    } else {
      VRet(h, c, -1)
    }
    Hlt => VHlt
  }
}

fn tgt_view(mut vg : ValGraph, mut ts : TgtState, f : Func, ti : FnInfo, fs : Array[Fact], b : Int) -> TView {
  match f.blocks[b].term {
    Jmp(s) => VJmp(s)
    Jnz(c, s1, s2) => {
      if s1 == s2 {
        return VJmp(s1)
      }
      let cv0 = t_atom(mut vg, mut ts, f, ti, W, c)
      let cv = apply_facts(mut vg, fs, cv0)
      match vg_const(vg, cv) {
        Some(x) => return VJmp(if x != 0UL { s1 } else { s2 })
        None => ()
      }
      VJnz(cv, s1, s2)
    }
    Ret(h, c, a) =>
    if h {
      let v0 = t_atom(mut vg, mut ts, f, ti, c, a)
      VRet(h, c, apply_facts(mut vg, fs, v0))
    } else {
      VRet(h, c, -1)
    }
    Hlt => VHlt
  }
}

///| Compare a source and a target operand read at class `cls`.
fn obs_eq(
  mut vg : ValGraph,
  mut ts : TgtState,
  tgt : Func,
  ti : FnInfo,
  svid : Array[Int],
  fs : Array[Fact],
  cls : Cls,
  sa : Atom,
  ta : Atom,
) -> Bool {
  let sv = atom_use(mut vg, svid, cls, sa)
  let tv = t_atom(mut vg, mut ts, tgt, ti, cls, ta)
  eq_under(mut vg, fs, sv, tv)
}

///| The bits a store of width `w` writes, as a value.
fn store_view(mut vg : ValGraph, w : MemWidth, v : Int) -> Int {
  match w {
    B1 => {
      let x = vg_use(mut vg, W, v)
      vg_canon_un(mut vg, W, ExtUB, x)
    }
    B2 => {
      let x = vg_use(mut vg, W, v)
      vg_canon_un(mut vg, W, ExtUH, x)
    }
    B4 => vg_use(mut vg, W, v)
    B8 => vg_use(mut vg, L, v)
  }
}

fn store_cls(w : MemWidth) -> Cls {
  match w {
    B8 => L
    _ => W
  }
}

fn assign_tgt(mut ts : TgtState, td : Int, v : Int) -> Int {
  if v < 0 || td < 0 || td >= ts.tvid.length() {
    return 2
  }
  if ts.tvid[td] >= 0 && ts.tvid[td] != v {
    return 2
  }
  ts.tvid[td] = v
  0
}

///| 0: equal effects (the target result gets the source value), 1: different,
///| 2: the target result already has another value.
fn match_effect(
  mut vg : ValGraph,
  mut ts : TgtState,
  tgt : Func,
  ti : FnInfo,
  svid : Array[Int],
  fs : Array[Fact],
  sinst : Inst,
  tinst : Inst,
) -> Int {
  match sinst {
    Load(sd, sc, sw, ssg, sa) =>
    match tinst {
      Load(td, tc, tw, tsg, ta) => {
        if sc != tc || sw != tw || ssg != tsg {
          return 1
        }
        if !obs_eq(mut vg, mut ts, tgt, ti, svid, fs, L, sa, ta) {
          return 1
        }
        assign_tgt(mut ts, td, svid[sd])
      }
      _ => 1
    }
    Store(sw, sv, sa) =>
    match tinst {
      Store(tw, tv, ta) => {
        if sw != tw {
          return 1
        }
        if !obs_eq(mut vg, mut ts, tgt, ti, svid, fs, L, sa, ta) {
          return 1
        }
        let c = store_cls(sw)
        let s0 = atom_use(mut vg, svid, c, sv)
        let t0 = t_atom(mut vg, mut ts, tgt, ti, c, tv)
        let s1 = store_view(mut vg, sw, s0)
        let t1 = store_view(mut vg, sw, t0)
        if eq_under(mut vg, fs, s1, t1) {
          0
        } else {
          1
        }
      }
      _ => 1
    }
    Call(sd, sc, sh, scal, sargs) =>
    match tinst {
      Call(td, tc, th, tcal, targs) => {
        if sh != th || (sh && sc != tc) {
          return 1
        }
        if !obs_eq(mut vg, mut ts, tgt, ti, svid, fs, L, scal, tcal) {
          return 1
        }
        let n = sargs.length()
        if n != targs.length() {
          return 1
        }
        let mut j = 0
        while j < n {
          if sargs[j].cls != targs[j].cls {
            return 1
          }
          if !obs_eq(mut vg, mut ts, tgt, ti, svid, fs, sargs[j].cls, sargs[j].arg, targs[j].arg) {
            return 1
          }
          j = j + 1
        }
        if sh {
          assign_tgt(mut ts, td, svid[sd])
        } else {
          0
        }
      }
      _ => 1
    }
    Alloc(sd, sal, ssz) =>
    match tinst {
      Alloc(td, tal, tsz) =>
      if sal == tal && ssz == tsz {
        assign_tgt(mut ts, td, svid[sd])
      } else {
        1
      }
      _ => 1
    }
    Bin(sd, sc, sop, sa, sb) =>
    match tinst {
      Bin(td, tc, top, ta, tb) => {
        if sc != tc || sop != top {
          return 1
        }
        if !obs_eq(mut vg, mut ts, tgt, ti, svid, fs, binop_arg_cls(sop, sc, 0), sa, ta) {
          return 1
        }
        if !obs_eq(mut vg, mut ts, tgt, ti, svid, fs, binop_arg_cls(sop, sc, 1), sb, tb) {
          return 1
        }
        assign_tgt(mut ts, td, svid[sd])
      }
      _ => 1
    }
    _ => 1
  }
}

fn find_phi(f : Func, b : Int, d : Int) -> Int {
  let n = f.blocks[b].phis.length()
  let mut k = 0
  while k < n {
    if f.blocks[b].phis[k].dst == d {
      return k
    }
    k = k + 1
  }
  -1
}

fn bm_add(mut ts : TgtState, tb : Int, sb : Int) -> Unit {
  if tb < 0 || tb >= ts.bm_head.length() {
    return
  }
  let mut j = ts.bm_head[tb]
  while j >= 0 {
    if ts.bm_s[j] == sb {
      return
    }
    j = ts.bm_next[j]
  }
  ts.bm_t.push(tb)
  ts.bm_s.push(sb)
  ts.bm_next.push(ts.bm_head[tb])
  ts.bm_head[tb] = ts.bm_t.length() - 1
}

///| Queue the pair (sh, th) entered by the edges sp -> sh / tp -> th; its
///| index in the queue.
///| `bm_t` (`which == 0`) or `bm_s` (`which == 1`) with the pairs sorted by
///| target block (what `bm_has` searches).
fn bm_sorted(ts : TgtState, which : Int) -> Array[Int] {
  let mut out : Array[Int] = []
  let mut tb = 0
  while tb < ts.bm_head.length() {
    let mut j = ts.bm_head[tb]
    while j >= 0 {
      out.push(if which == 0 { ts.bm_t[j] } else { ts.bm_s[j] })
      j = ts.bm_next[j]
    }
    tb = tb + 1
  }
  out
}

fn enqueue(mut ts : TgtState, sp : Int, tp : Int, sh : Int, th : Int) -> Int {
  ts.e_sp.push(sp)
  ts.e_tp.push(tp)
  ts.e_sh.push(sh)
  ts.e_th.push(th)
  enqueue_pair(mut ts, sh, th)
}

fn enqueue_pair(mut ts : TgtState, sh : Int, th : Int) -> Int {
  let n = ts.ps.length()
  if sh >= 0 && sh < ts.pq_head.length() {
    let mut j = ts.pq_head[sh]
    while j >= 0 {
      if ts.pt[j] == th {
        return j
      }
      j = ts.pq_next[j]
    }
    ts.pq_next.push(ts.pq_head[sh])
    ts.pq_head[sh] = n
  } else {
    ts.pq_next.push(-1)
  }
  ts.ps.push(sh)
  ts.pt.push(th)
  n
}

///| Values of the phis of target head `tb` entered with source head `sb`:
///| the source phi of the same temp at `sb` (a front-end hint), else that
///| temp's source value when it does not depend on `sb`. Checked on every
///| matched edge afterwards (`phi_arm_checks`).
fn map_head_phis(
  mut vg : ValGraph,
  mut ts : TgtState,
  src : Func,
  si : FnInfo,
  svid : Array[Int],
  tgt : Func,
  sb : Int,
  tb : Int,
) -> Option[TvFail] {
  let np = tgt.blocks[tb].phis.length()
  let mut j = 0
  while j < np {
    let d = tgt.blocks[tb].phis[j].dst
    let c = tgt.blocks[tb].phis[j].cls
    let mut h = -1
    if d >= 0 && d < si.nt && d < svid.length() {
      let k = find_phi(src, sb, d)
      if k >= 0 {
        if src.blocks[sb].phis[k].cls == c {
          h = svid[d]
        }
      } else if si.def_kind[d] != 0 && svid[d] >= 0 {
        let v = vg_use(mut vg, c, svid[d])
        if v >= 0 && !vid_mentions_blk(vg, v, sb) {
          h = v
        }
      }
    }
    if h < 0 {
      return Some(PhiUnmapped(tb, d))
    }
    // A target phi entered with source head sb stands for a phi of sb or a
    // value independent of the edge; never for a phi of another block.
    match vg.nodes[h] {
      SPhi(_, b0, _) => if b0 != sb {
        return Some(PhiUnmapped(tb, d))
      }
      _ => ()
    }
    if ts.tvid[d] >= 0 {
      if ts.tvid[d] != h {
        return Some(PhiConflict(d))
      }
    } else {
      ts.tvid[d] = h
    }
    j = j + 1
  }
  None
}

fn is_phi_of_blk(f : Func, b : Int, a : Atom) -> Bool {
  match a {
    Temp(t) => find_phi(f, b, t) >= 0
    _ => false
  }
}

///| Phis of a target block absorbed from `pred`: the argument on that edge
///| (all read before any is written).
fn absorb_tgt_phis(mut vg : ValGraph, mut ts : TgtState, tgt : Func, ti : FnInfo, m : Int, pred : Int) -> Option[TvFail] {
  let np = tgt.blocks[m].phis.length()
  let mut vals = Array::make(np, -1)
  let mut j = 0
  while j < np {
    let d = tgt.blocks[m].phis[j].dst
    let c = tgt.blocks[m].phis[j].cls
    let ai = phi_arm_index(tgt, m, j, pred)
    if ai < 0 {
      return Some(PhiUnmapped(m, d))
    }
    let a = tgt.blocks[m].phis[j].arms[ai].value
    if is_phi_of_blk(tgt, m, a) {
      return Some(UnknownValue(d))
    }
    let v = t_atom(mut vg, mut ts, tgt, ti, c, a)
    if v < 0 {
      return Some(UnknownValue(d))
    }
    vals[j] = v
    j = j + 1
  }
  let mut k = 0
  while k < np {
    let d = tgt.blocks[m].phis[k].dst
    if ts.tvid[d] >= 0 && ts.tvid[d] != vals[k] {
      return Some(PhiConflict(d))
    }
    if ts.tvid[d] < 0 {
      ts.tvid[d] = vals[k]
    }
    k = k + 1
  }
  None
}

fn term_compare(
  mut vg : ValGraph,
  mut ts : TgtState,
  fs : Array[Fact],
  sv : TView,
  tv : TView,
  sc : Int,
  tc : Int,
) -> Option[TvFail] {
  match sv {
    VRet(sh, scls, svv) =>
    match tv {
      VRet(th, tcls, tvv) =>
      if sh != th {
        Some(RetMismatch(sc, tc))
      } else if sh && (scls != tcls || !eq_under(mut vg, fs, svv, tvv)) {
        Some(RetMismatch(sc, tc))
      } else {
        ts.cur_fin = EndRet
        None
      }
      _ => Some(TermMismatch(sc, tc))
    }
    VHlt =>
    match tv {
      VHlt => {
        ts.cur_fin = EndHlt
        None
      }
      _ => Some(TermMismatch(sc, tc))
    }
    VJnz(cs, s1, s2) =>
    match tv {
      VJnz(ct, t1, t2) =>
      if eq_under(mut vg, fs, cs, ct) {
        let i1 = enqueue(mut ts, sc, tc, s1, t1)
        let i2 = enqueue(mut ts, sc, tc, s2, t2)
        ts.cur_fin = EndJnz(false, i1, i2)
        None
      } else {
        let z = vg_konst(mut vg, W, 0UL)
        let ns = vg_canon_bin(mut vg, W, CEq(W), cs, z)
        let nt = vg_canon_bin(mut vg, W, CEq(W), ct, z)
        if eq_under(mut vg, fs, ns, ct) || eq_under(mut vg, fs, cs, nt) {
          let i1 = enqueue(mut ts, sc, tc, s1, t2)
          let i2 = enqueue(mut ts, sc, tc, s2, t1)
          ts.cur_fin = EndJnz(true, i1, i2)
          None
        } else {
          Some(CondMismatch(sc, tc))
        }
      }
      _ => Some(TermMismatch(sc, tc))
    }
    VJmp(_) => Some(TermMismatch(sc, tc))
  }
}

fn is_load(inst : Inst) -> Bool {
  match inst {
    Load(_, _, _, _, _) => true
    _ => false
  }
}

///| Source instruction x of block b is a dead load and a later live load of
///| the same class, width, signedness and address follows it with no store,
///| call or alloc in between.
fn dead_load_shadowed(
  mut vg : ValGraph,
  src : Func,
  svid : Array[Int],
  slive : Array[Bool],
  fs : Array[Fact],
  b : Int,
  x : Int,
) -> Bool {
  match src.blocks[b].insts[x] {
    Load(_, c, w, sg, a) => {
      let n = src.blocks[b].insts.length()
      let mut y = x + 1
      while y < n {
        match src.blocks[b].insts[y] {
          Store(_, _, _) => return false
          Call(_, _, _, _, _) => return false
          Alloc(_, _, _) => return false
          Load(_, c2, w2, sg2, a2) =>
          if c2 == c && w2 == w && sg2 == sg && !src_effect_elidable(slive, src.blocks[b].insts[y]) {
            let av = atom_use(mut vg, svid, L, a)
            let av2 = atom_use(mut vg, svid, L, a2)
            if eq_under(mut vg, fs, av, av2) {
              return true
            }
          }
          _ => ()
        }
        y = y + 1
      }
      false
    }
    _ => false
  }
}

///| Block b ends with `jnz` whose arms are blocks without phis or
///| instructions that jump to one join (or the join itself).
fn empty_diamond(f : Func, b : Int) -> Bool {
  match f.blocks[b].term {
    Jnz(_, s1, s2) => {
      let j1 = empty_hop(f, s1)
      let j2 = empty_hop(f, s2)
      j1 >= 0 && j1 == j2
    }
    _ => false
  }
}

fn empty_hop(f : Func, s : Int) -> Int {
  if s < 0 || s >= f.blocks.length() {
    return -1
  }
  if f.blocks[s].phis.length() > 0 || f.blocks[s].insts.length() > 0 {
    return s
  }
  match f.blocks[s].term {
    Jmp(n) => n
    _ => s
  }
}

///| Both sides end with `jnz`, the source's arms are empty and meet at `r`
///| (`src_join`), and the target branch is the one of `r`: `simplcfg` /
///| GVN folded the source's `c ? 1 : 0` diamond into `r`'s branch. True when
///| the branches cannot be paired here, or when `r` branches on the target's
///| condition (or its negation) and the target branch is no empty diamond
///| of its own.
fn prefer_src_join(
  mut vg : ValGraph,
  src : Func,
  svid : Array[Int],
  facts : Array[Fact],
  tgt : Func,
  fs : Array[Fact],
  sv : TView,
  tv : TView,
  r : Int,
  tc : Int,
) -> Bool {
  match tv {
    VJnz(ct, _, _) => {
      let z = vg_konst(mut vg, W, 0UL)
      let nt = vg_canon_bin(mut vg, W, CEq(W), ct, z)
      let here = match sv {
        VJnz(cs, _, _) => {
          let ns = vg_canon_bin(mut vg, W, CEq(W), cs, z)
          eq_under(mut vg, fs, cs, ct) || eq_under(mut vg, fs, ns, ct) || eq_under(mut vg, fs, cs, nt)
        }
        _ => false
      }
      if !here {
        return true
      }
      if empty_diamond(tgt, tc) {
        return false
      }
      let rfs = facts_of(facts, r)
      match src_view(mut vg, src, svid, rfs, r) {
        VJnz(cr, _, _) => eq_under(mut vg, rfs, cr, ct) || eq_under(mut vg, rfs, cr, nt)
        _ => false
      }
    }
    _ => false
  }
}

///| Run the matched pair (sb, tb) in lock step until both reach terminators
///| that end it (return, `hlt`, or branches to queued pairs).
fn walk_one(
  mut vg : ValGraph,
  mut ts : TgtState,
  src : Func,
  si : FnInfo,
  svid : Array[Int],
  slive : Array[Bool],
  facts : Array[Fact],
  tgt : Func,
  ti : FnInfo,
  sb : Int,
  tb : Int,
) -> Option[TvFail] {
  ts.trace.push(9000000 + sb * 1000 + tb)
  match map_head_phis(mut vg, mut ts, src, si, svid, tgt, sb, tb) {
    Some(e) => return Some(e)
    None => ()
  }
  bm_add(mut ts, tb, sb)
  ts.cur_steps = []
  let mut sc = sb
  let mut sx = 0
  let mut tc = tb
  let mut tx = 0
  let mut schain = [sb]
  let mut tchain = [tb]
  let mut fuel = 2 * (si.ninst + ti.ninst + si.nb + ti.nb) + 16
  while fuel > 0 {
    fuel = fuel - 1
    let slen = src.blocks[sc].insts.length()
    while sx < slen && !src_inst_is_effect(vg, svid, src.blocks[sc].insts[sx], sc, sx) {
      sx = sx + 1
    }
    let tlen = tgt.blocks[tc].insts.length()
    while tx < tlen && !tgt_inst_is_effect(mut vg, mut ts, tgt, ti, tgt.blocks[tc].insts[tx]) {
      tx = tx + 1
    }
    let s_has = sx < slen
    let t_has = tx < tlen
    let fs = facts_of(facts, sc)
    // What to do next: 1 advance both, 2 skip a dead source effect,
    // 3 absorb the source jump target, 4 absorb the target jump target,
    // 5 done, 6 absorb both jump targets, 7 absorb the join of a source
    // `jnz` whose arms are empty (`src_join`).
    let mut act = 0
    let mut nxt = -1
    if s_has {
      let s_elide = src_effect_elidable(slive, src.blocks[sc].insts[sx])
      if t_has {
        // A dead load followed (before any store / call / alloc) by a live
        // load of the same address and width: GVN kept one load, which
        // stands for the live one.
        let shadow = s_elide && is_load(tgt.blocks[tc].insts[tx]) &&
        dead_load_shadowed(mut vg, src, svid, slive, fs, sc, sx)
        let r = if shadow {
          1
        } else {
          match_effect(mut vg, mut ts, tgt, ti, svid, fs, src.blocks[sc].insts[sx], tgt.blocks[tc].insts[tx])
        }
        if r == 0 {
          act = 1
        } else if r == 1 && s_elide {
          act = 2
        } else if r == 2 {
          return Some(EffectConflict(tc))
        } else {
          return Some(EffectMismatch(sc, tc))
        }
      } else if s_elide {
        act = 2
      } else {
        let tj = view_jmp(tgt_view(mut vg, mut ts, tgt, ti, fs, tc))
        if tj > 0 && !contains_int(tchain, tj) {
          act = 4
          nxt = tj
        } else {
          return Some(EffectMismatch(sc, tc))
        }
      }
    } else if t_has {
      let sj = view_jmp(src_view(mut vg, src, svid, fs, sc))
      if sj > 0 && !contains_int(schain, sj) && !blk_has_phi_leaf(vg, src, svid, sj) {
        act = 3
        nxt = sj
      } else {
        let r = src_join_ok(vg, src, svid, sc, schain)
        if sj < 0 && r > 0 {
          act = 7
          nxt = r
        } else {
          return Some(EffectMismatch(sc, tc))
        }
      }
    } else {
      let sv = src_view(mut vg, src, svid, fs, sc)
      let tv = tgt_view(mut vg, mut ts, tgt, ti, fs, tc)
      let sj = view_jmp(sv)
      let tj = view_jmp(tv)
      if sj >= 0 && tj >= 0 {
        // Run on through empty blocks, and into blocks only this edge
        // reaches — on both sides at once when both can, so that they stay
        // in step; a source block reached by one edge may have been merged
        // into its predecessor by `simplcfg`. Otherwise the two targets
        // form a new pair (a target block left with one predecessor after
        // GVN dropped a dead edge is still the source join block).
        let s_ok = sj > 0 && !contains_int(schain, sj) && !blk_has_phi_leaf(vg, src, svid, sj)
        let t_ok = tj > 0 && !contains_int(tchain, tj)
        let s_triv = s_ok && is_pure_jmp(src, sj)
        let t_triv = t_ok && is_trivial(tgt, tj)
        let s_one = s_ok && si.npred[sj] == 1
        let t_one = t_ok && ti.npred[tj] == 1
        if (s_triv && t_triv) || (s_one && t_one) {
          act = 6
        } else if s_triv {
          act = 3
          nxt = sj
        } else if t_triv {
          act = 4
          nxt = tj
        } else if s_one {
          act = 3
          nxt = sj
        } else {
          let i = enqueue(mut ts, sc, tc, sj, tj)
          ts.cur_fin = EndJmp(i)
          act = 5
        }
      } else if sj >= 0 {
        if sj > 0 && !contains_int(schain, sj) && !blk_has_phi_leaf(vg, src, svid, sj) {
          act = 3
          nxt = sj
        } else {
          match tv {
            // The target branches where the source does not: both target
            // paths must follow the one source path.
            VJnz(_, t1, t2) => {
              let i1 = enqueue(mut ts, sc, tc, sj, t1)
              let i2 = enqueue(mut ts, sc, tc, sj, t2)
              ts.cur_fin = EndTgtBranch(i1, i2)
              act = 5
            }
            _ => return Some(TermMismatch(sc, tc))
          }
        }
      } else if tj >= 0 {
        if tj > 0 && !contains_int(tchain, tj) && ti.npred[tj] == 1 {
          act = 4
          nxt = tj
        } else {
          match sv {
            // The source branches where the target does not (a branch the
            // target folded, or two empty arms): the one target path must
            // follow both source paths.
            VJnz(_, s1, s2) =>
            if tj > 0 && !contains_int(tchain, tj) && is_pure_branch(tgt, tj) {
              // The target merged the block holding the branch.
              act = 4
              nxt = tj
            } else {
              let i1 = enqueue(mut ts, sc, tc, s1, tj)
              let i2 = enqueue(mut ts, sc, tc, s2, tj)
              ts.cur_fin = EndSrcBranch(i1, i2)
              act = 5
            }
            _ =>
            if tj > 0 && !contains_int(tchain, tj) {
              act = 4
              nxt = tj
            } else {
              return Some(TermMismatch(sc, tc))
            }
          }
        }
      } else {
        let r = src_join_ok(vg, src, svid, sc, schain)
        let t_branch = match tv {
          VJnz(_, _, _) => true
          _ => false
        }
        if r > 0 && (!t_branch || prefer_src_join(mut vg, src, svid, facts, tgt, fs, sv, tv, r, tc)) {
          act = 7
          nxt = r
        } else {
          match term_compare(mut vg, mut ts, fs, sv, tv, sc, tc) {
            Some(e) => return Some(e)
            None => act = 5
          }
        }
      }
    }
    ts.trace.push(act * 1000000 + sc * 1000 + tc)
    if act == 1 {
      ts.cur_steps.push(MatchEff)
      sx = sx + 1
      tx = tx + 1
    } else if act == 2 {
      ts.cur_steps.push(SkipSrcReadOnly)
      sx = sx + 1
    } else if act == 3 || act == 7 {
      ts.cur_steps.push(if act == 3 { SrcJmp } else { SrcJoin })
      schain.push(nxt)
      sc = nxt
      sx = 0
      bm_add(mut ts, tc, nxt)
    } else if act == 4 {
      ts.cur_steps.push(TgtJmp)
      match absorb_tgt_phis(mut vg, mut ts, tgt, ti, nxt, tc) {
        Some(e) => return Some(e)
        None => ()
      }
      tchain.push(nxt)
      tc = nxt
      tx = 0
    } else if act == 6 {
      ts.cur_steps.push(BothJmp)
      let sj = view_jmp(src_view(mut vg, src, svid, fs, sc))
      let tj = view_jmp(tgt_view(mut vg, mut ts, tgt, ti, fs, tc))
      match absorb_tgt_phis(mut vg, mut ts, tgt, ti, tj, tc) {
        Some(e) => return Some(e)
        None => ()
      }
      tchain.push(tj)
      tc = tj
      tx = 0
      schain.push(sj)
      sc = sj
      sx = 0
      bm_add(mut ts, tc, sc)
    } else {
      ts.pcs.push(PairCert::{ sb, tb, steps: ts.cur_steps.copy(), fin: ts.cur_fin })
      return None
    }
  }
  Some(WorkLimit(sb))
}

fn walk(
  mut vg : ValGraph,
  mut ts : TgtState,
  src : Func,
  si : FnInfo,
  svid : Array[Int],
  slive : Array[Bool],
  facts : Array[Fact],
  tgt : Func,
  ti : FnInfo,
) -> Option[TvFail] {
  let _ = enqueue_pair(mut ts, 0, 0)
  let limit = (si.nb + 1) * (ti.nb + 1) + 1
  let mut q = 0
  while q < ts.ps.length() {
    if q >= limit {
      return Some(WorkLimit(q))
    }
    let sb = ts.ps[q]
    let tb = ts.pt[q]
    match walk_one(mut vg, mut ts, src, si, svid, slive, facts, tgt, ti, sb, tb) {
      Some(e) => return Some(e)
      None => ()
    }
    q = q + 1
  }
  None
}

///| On every matched edge, each target phi argument equals the source value
///| the phi stands for (the source phi's argument on that edge, or its
///| value when the phi was folded).
fn phi_arm_checks(
  mut vg : ValGraph,
  mut ts : TgtState,
  src : Func,
  svid : Array[Int],
  facts : Array[Fact],
  tgt : Func,
  ti : FnInfo,
) -> Option[TvFail] {
  let ne = ts.e_sp.length()
  let mut e = 0
  while e < ne {
    let sp = ts.e_sp[e]
    let tp = ts.e_tp[e]
    let sh = ts.e_sh[e]
    let th = ts.e_th[e]
    let fs = edge_fact_set(mut vg, src, svid, facts, sp, sh)
    let np = tgt.blocks[th].phis.length()
    let mut j = 0
    while j < np {
      let d = tgt.blocks[th].phis[j].dst
      let c = tgt.blocks[th].phis[j].cls
      let ai = phi_arm_index(tgt, th, j, tp)
      if ai < 0 {
        return Some(PhiArmMismatch(th, d))
      }
      let tv = t_atom(mut vg, mut ts, tgt, ti, c, tgt.blocks[th].phis[j].arms[ai].value)
      let k = if d >= 0 && d < svid.length() { find_phi(src, sh, d) } else { -1 }
      let mut sv = -1
      if k >= 0 && vg_is_phi_of(vg, svid[d], sh) {
        let si_ = phi_arm_index(src, sh, k, sp)
        if si_ < 0 {
          return Some(PhiArmMismatch(th, d))
        }
        sv = atom_use(mut vg, svid, c, src.blocks[sh].phis[k].arms[si_].value)
      } else {
        sv = ts.tvid[d]
      }
      if !eq_under(mut vg, fs, sv, tv) {
        return Some(PhiArmMismatch(th, d))
      }
      j = j + 1
    }
    e = e + 1
  }
  None
}

///|
///| 6. Certificates: the solver above (`build_cert`) and the checker
///| (`verify_cert`), which trusts nothing the solver computed.
///|

///| One step of a matched pair, after both sides skipped their pure
///| instructions.
pub enum Step {
  /// The next source and target side effects are equal.
  MatchEff
  /// The next source effect (a load or a division) is dropped.
  SkipSrcReadOnly
  /// The source (no effect left) enters the block its `jmp` goes to.
  SrcJmp
  /// The source (no effect left) enters the join of its `jnz` (`src_join`).
  SrcJoin
  /// The target (no effect left) enters the block its `jmp` goes to.
  TgtJmp
  /// Both (no effect left) enter the blocks their `jmp`s go to.
  BothJmp
}

///| How a matched pair ends; pair arguments are indices into `Cert.pairs`.
pub enum EndCert {
  EndRet
  EndHlt
  /// Both jump: (successor pair).
  EndJmp(Int)
  /// Both branch on equal (or, swapped, complementary) conditions.
  EndJnz(Bool, Int, Int)
  /// The source branches, the target jumps: (pair true, pair false).
  EndSrcBranch(Int, Int)
  /// The source jumps, the target branches: (pair true, pair false).
  EndTgtBranch(Int, Int)
}

///| Source head `sb` runs in lock step with target head `tb`.
pub struct PairCert {
  sb : Int
  tb : Int
  steps : Array[Step]
  fin : EndCert
}

pub struct Cert {
  /// Frozen value graph (the checker copies it and may only append).
  vg : ValGraph
  svid : Array[Int]
  tvid : Array[Int]
  savail : Array[Bool]
  tavail : Array[Bool]
  facts : Array[Fact]
  /// `pairs[0]` is (0, 0).
  pairs : Array[PairCert]
  /// Target block `bm_t[j]` runs source block `bm_s[j]`.
  bm_t : Array[Int]
  bm_s : Array[Int]
}

pub enum CertResult {
  CertOk(Cert)
  CertFail(TvFail)
}

///| The solver: a certificate, or why none was found.
pub fn build_cert_diag(src : Func, tgt : Func) -> CertResult {
  let ws = wf_code(src)
  if ws != 0 {
    return CertFail(BadSrc(ws))
  }
  let wt = wf_code(tgt)
  if wt != 0 {
    return CertFail(BadTgt(wt))
  }
  let si = build_info(src)
  let ti = build_info(tgt)
  let mut vg = vg_new()
  let svid0 = src_vids(mut vg, src, si, [])
  let facts0 = compute_facts(mut vg, src, si, svid0)
  let svid = src_vids(mut vg, src, si, facts0)
  let savail = compute_avail(src, si)
  let ids = iota(si.nb)
  let ca = check_avail(vg, src, si, savail, svid, ids, ids)
  if ca != 0 {
    return CertFail(SrcAvail(ca - 1))
  }
  let slive = src_live(src, si)
  let facts = compute_facts(mut vg, src, si, svid)
  let cf = check_facts(mut vg, src, si, svid, facts)
  if cf != 0 {
    return CertFail(SrcFacts(cf - 1))
  }
  let mut ts = tgt_state_new(ti.nt, si.nb, ti.nb)
  match walk(mut vg, mut ts, src, si, svid, slive, facts, tgt, ti) {
    Some(e) => return CertFail(e)
    None => ()
  }
  match phi_arm_checks(mut vg, mut ts, src, svid, facts, tgt, ti) {
    Some(e) => return CertFail(e)
    None => ()
  }
  let tavail = compute_avail(tgt, ti)
  let ct = check_avail(vg, tgt, ti, tavail, ts.tvid, ts.bm_t, ts.bm_s)
  if ct != 0 {
    return CertFail(TgtAvail(ct - 1))
  }
  CertOk(Cert::{
    vg,
    svid,
    tvid: ts.tvid.copy(),
    savail,
    tavail,
    facts,
    pairs: ts.pcs.copy(),
    bm_t: bm_sorted(ts, 0),
    bm_s: bm_sorted(ts, 1),
  })
}

pub fn build_cert(src : Func, tgt : Func) -> Option[Cert] {
  match build_cert_diag(src, tgt) {
    CertOk(c) => Some(c)
    CertFail(_) => None
  }
}

///| Every child index of node i is below i.
pub fn check_vg_dag(vg : ValGraph) -> Bool {
  let n = vg.nodes.length()
  let mut i = 0
  while i < n {
    match vg.nodes[i] {
      SUn(_, _, a) => if a < 0 || a >= i {
        return false
      }
      SBin(_, _, a, b) => if a < 0 || a >= i || b < 0 || b >= i {
        return false
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

///| Every entry is -1 or a node.
fn vids_ok(vg : ValGraph, vids : Array[Int], n : Int) -> Bool {
  if vids.length() != n {
    return false
  }
  for v in vids {
    if v != -1 && !vg_valid(vg, v) {
      return false
    }
  }
  true
}

///| Phi k of source block b has the value `svid[dst]`: its leaf, its folded
///| value, its 0/1 select, or the value of an earlier phi with the same
///| arguments.
fn src_phi_def_ok(
  mut vg : ValGraph,
  f : Func,
  info : FnInfo,
  svid : Array[Int],
  facts : Array[Fact],
  b : Int,
  k : Int,
) -> Bool {
  let d = f.blocks[b].phis[k].dst
  let c = f.blocks[b].phis[k].cls
  let v = svid[d]
  if !vg_valid(vg, v) {
    return false
  }
  if sym_node_eq(vg.nodes[v], SPhi(c, b, k)) {
    return true
  }
  if phi_fold(mut vg, f, info, svid, facts, b, k) == v {
    return true
  }
  if phi_select(mut vg, f, svid, b, k) == v {
    return true
  }
  let mut k1 = 0
  while k1 < k {
    let d1 = f.blocks[b].phis[k1].dst
    if f.blocks[b].phis[k1].cls == c && svid[d1] == v && phis_same_args(mut vg, f, svid, b, k1, k) {
      return true
    }
    k1 = k1 + 1
  }
  false
}

///| Every source temp defined by the code has the value of its definition.
pub fn check_src_defs(mut vg : ValGraph, f : Func, info : FnInfo, svid : Array[Int], facts : Array[Fact]) -> Bool {
  let mut b = 0
  while b < info.nb {
    let np = f.blocks[b].phis.length()
    let mut k = 0
    while k < np {
      if !src_phi_def_ok(mut vg, f, info, svid, facts, b, k) {
        return false
      }
      k = k + 1
    }
    let ni = f.blocks[b].insts.length()
    let mut i = 0
    while i < ni {
      let d = inst_dst(f.blocks[b].insts[i])
      if d >= 0 {
        let v = svid[d]
        if v < 0 || v != eval_inst(mut vg, svid, f.blocks[b].insts[i], b, i, true) {
          return false
        }
      }
      i = i + 1
    }
    b = b + 1
  }
  true
}

///| A target instruction whose value comes from matching (a side effect or a
///| division that may trap).
fn tgt_effect_c(mut vg : ValGraph, tvid : Array[Int], inst : Inst) -> Bool {
  match inst {
    Par(_, _, _) => false
    Un(_, _, _, _) => false
    Bin(_, c, op, a, b) =>
    if !is_trapping_binop(op) {
      false
    } else {
      let av = atom_use(mut vg, tvid, binop_arg_cls(op, c, 0), a)
      let bv = atom_use(mut vg, tvid, binop_arg_cls(op, c, 1), b)
      !bin_safe(vg, c, op, av, bv)
    }
    _ => true
  }
}

///| Every pure target temp with a value has the value of its definition
///| (effects and phis are checked by the replay).
pub fn check_tgt_defs(mut vg : ValGraph, f : Func, info : FnInfo, tvid : Array[Int]) -> Bool {
  let mut b = 0
  while b < info.nb {
    let ni = f.blocks[b].insts.length()
    let mut i = 0
    while i < ni {
      let d = inst_dst(f.blocks[b].insts[i])
      if d >= 0 && tvid[d] >= 0 && !tgt_effect_c(mut vg, tvid, f.blocks[b].insts[i]) {
        if tvid[d] != eval_inst(mut vg, tvid, f.blocks[b].insts[i], b, i, false) {
          return false
        }
      }
      i = i + 1
    }
    b = b + 1
  }
  true
}

///| `(tb, sb)` is a pair of `bm_t` / `bm_s`: binary search for the run of
///| `tb` (the solver emits `bm_t` sorted; on an unsorted array this only
///| finds fewer pairs).
fn bm_has(cert : Cert, tb : Int, sb : Int) -> Bool {
  let n = cert.bm_t.length()
  let mut lo = 0
  let mut hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if cert.bm_t[mid] < tb {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  let mut j = lo
  while j >= 0 && j < n && j < cert.bm_s.length() && cert.bm_t[j] == tb {
    if cert.bm_s[j] == sb {
      return true
    }
    j = j + 1
  }
  false
}

fn skip_src_pure(vg : ValGraph, f : Func, svid : Array[Int], b : Int, x0 : Int) -> Int {
  let n = f.blocks[b].insts.length()
  let mut x = x0
  while x < n && !src_inst_is_effect(vg, svid, f.blocks[b].insts[x], b, x) {
    x = x + 1
  }
  x
}

///| Instruction i of target block b runs as a pure instruction in the
///| replay: no effect, and a division that cannot trap has, when it has a
///| value, the value of its definition in the graph as it is now (the graph
///| grew since `check_tgt_defs` classified it).
fn tgt_pure_c(mut vg : ValGraph, f : Func, tvid : Array[Int], b : Int, i : Int) -> Bool {
  if tgt_effect_c(mut vg, tvid, f.blocks[b].insts[i]) {
    return false
  }
  match f.blocks[b].insts[i] {
    Bin(d, _, op, _, _) =>
    if is_trapping_binop(op) && d >= 0 && d < tvid.length() && tvid[d] >= 0 {
      tvid[d] == eval_inst(mut vg, tvid, f.blocks[b].insts[i], b, i, false)
    } else {
      true
    }
    _ => true
  }
}

fn skip_tgt_pure(mut vg : ValGraph, f : Func, tvid : Array[Int], b : Int, x0 : Int) -> Int {
  let n = f.blocks[b].insts.length()
  let mut x = x0
  while x < n && tgt_pure_c(mut vg, f, tvid, b, x) {
    x = x + 1
  }
  x
}

fn tgt_view_c(mut vg : ValGraph, f : Func, tvid : Array[Int], fs : Array[Fact], b : Int) -> TView {
  match f.blocks[b].term {
    Jmp(s) => VJmp(s)
    Jnz(c, s1, s2) => {
      if s1 == s2 {
        return VJmp(s1)
      }
      let cv0 = atom_use(mut vg, tvid, W, c)
      let cv = apply_facts(mut vg, fs, cv0)
      match vg_const(vg, cv) {
        Some(x) => VJmp(if x != 0UL { s1 } else { s2 })
        None => VJnz(cv, s1, s2)
      }
    }
    Ret(h, c, a) =>
    if h {
      let v0 = atom_use(mut vg, tvid, c, a)
      VRet(h, c, apply_facts(mut vg, fs, v0))
    } else {
      VRet(h, c, -1)
    }
    Hlt => VHlt
  }
}

fn obs_eq_c(mut vg : ValGraph, svid : Array[Int], tvid : Array[Int], fs : Array[Fact], cls : Cls, sa : Atom, ta : Atom) -> Bool {
  let sv = atom_use(mut vg, svid, cls, sa)
  let tv = atom_use(mut vg, tvid, cls, ta)
  eq_under(mut vg, fs, sv, tv)
}

///| The target result of a matched effect has the source result's value.
fn same_result(svid : Array[Int], tvid : Array[Int], sd : Int, td : Int) -> Bool {
  sd >= 0 && sd < svid.length() && td >= 0 && td < tvid.length() && svid[sd] >= 0 && tvid[td] == svid[sd]
}

///| Checker counterpart of `match_effect`.
fn match_effect_c(
  mut vg : ValGraph,
  svid : Array[Int],
  tvid : Array[Int],
  fs : Array[Fact],
  sinst : Inst,
  tinst : Inst,
) -> Bool {
  match sinst {
    Load(sd, sc, sw, ssg, sa) =>
    match tinst {
      Load(td, tc, tw, tsg, ta) =>
      sc == tc && sw == tw && ssg == tsg && obs_eq_c(mut vg, svid, tvid, fs, L, sa, ta) &&
      same_result(svid, tvid, sd, td)
      _ => false
    }
    Store(sw, sv, sa) =>
    match tinst {
      Store(tw, tv, ta) => {
        if sw != tw || !obs_eq_c(mut vg, svid, tvid, fs, L, sa, ta) {
          return false
        }
        let c = store_cls(sw)
        let sv0 = atom_use(mut vg, svid, c, sv)
        let s1 = store_view(mut vg, sw, sv0)
        let tv0 = atom_use(mut vg, tvid, c, tv)
        let t1 = store_view(mut vg, sw, tv0)
        eq_under(mut vg, fs, s1, t1)
      }
      _ => false
    }
    Call(sd, sc, sh, scal, sargs) =>
    match tinst {
      Call(td, tc, th, tcal, targs) => {
        if sh != th || (sh && sc != tc) || !obs_eq_c(mut vg, svid, tvid, fs, L, scal, tcal) {
          return false
        }
        let n = sargs.length()
        if n != targs.length() {
          return false
        }
        let mut j = 0
        while j < n {
          if sargs[j].cls != targs[j].cls || !obs_eq_c(mut vg, svid, tvid, fs, sargs[j].cls, sargs[j].arg, targs[j].arg) {
            return false
          }
          j = j + 1
        }
        !sh || same_result(svid, tvid, sd, td)
      }
      _ => false
    }
    Alloc(sd, sal, ssz) =>
    match tinst {
      Alloc(td, tal, tsz) => sal == tal && ssz == tsz && same_result(svid, tvid, sd, td)
      _ => false
    }
    Bin(sd, sc, sop, sa, sb) =>
    match tinst {
      Bin(td, tc, top, ta, tb) =>
      sc == tc && sop == top &&
      obs_eq_c(mut vg, svid, tvid, fs, binop_arg_cls(sop, sc, 0), sa, ta) &&
      obs_eq_c(mut vg, svid, tvid, fs, binop_arg_cls(sop, sc, 1), sb, tb) &&
      same_result(svid, tvid, sd, td)
      _ => false
    }
    _ => false
  }
}

///| A source effect the target may drop: a load or a division (neither
///| changes the world when it does not trap).
fn src_skippable(inst : Inst) -> Bool {
  match inst {
    Load(_, _, _, _, _) => true
    Bin(_, _, op, _, _) => is_trapping_binop(op)
    _ => false
  }
}

///| Target phis of head `tb` entered with source head `sb`: a phi of the
///| same temp that is a leaf of `sb` (same value), or a value that depends
///| on no phi / effect of `sb` and is no phi leaf.
fn head_ok(mut vg : ValGraph, src : Func, svid : Array[Int], tgt : Func, tvid : Array[Int], sb : Int, tb : Int) -> Bool {
  let np = tgt.blocks[tb].phis.length()
  let mut j = 0
  while j < np {
    let d = tgt.blocks[tb].phis[j].dst
    let c = tgt.blocks[tb].phis[j].cls
    let v = tvid[d]
    if !vg_valid(vg, v) {
      return false
    }
    let k = if d < svid.length() { find_phi(src, sb, d) } else { -1 }
    if k >= 0 && vg_is_phi_of(vg, svid[d], sb) {
      if src.blocks[sb].phis[k].cls != c || v != svid[d] {
        return false
      }
    } else {
      if vid_mentions_blk(vg, v, sb) {
        return false
      }
      match vg.nodes[v] {
        SPhi(_, _, _) => return false
        _ => ()
      }
    }
    j = j + 1
  }
  true
}

///| The target phis of an absorbed block m get their argument on the edge
///| from `pred` (read before any is written).
fn absorb_ok(mut vg : ValGraph, tgt : Func, tvid : Array[Int], m : Int, pred : Int) -> Bool {
  let np = tgt.blocks[m].phis.length()
  let mut j = 0
  while j < np {
    let d = tgt.blocks[m].phis[j].dst
    let c = tgt.blocks[m].phis[j].cls
    let ai = phi_arm_index(tgt, m, j, pred)
    if ai < 0 {
      return false
    }
    let a = tgt.blocks[m].phis[j].arms[ai].value
    if is_phi_of_blk(tgt, m, a) {
      return false
    }
    let v = atom_use(mut vg, tvid, c, a)
    if v < 0 || tvid[d] != v {
      return false
    }
    j = j + 1
  }
  true
}

///| No phi value of target block tc depends on source block sj (which the
///| source is about to enter while the target stays in tc).
fn src_enter_scope_ok(vg : ValGraph, tgt : Func, tvid : Array[Int], tc : Int, sj : Int) -> Bool {
  for phi in tgt.blocks[tc].phis {
    if vid_mentions_blk(vg, tvid[phi.dst], sj) {
      return false
    }
  }
  true
}

///| On the edges sp -> sh / tp -> th every target phi argument of th equals
///| the source value the phi stands for (`head_ok`).
fn edge_ok(
  mut vg : ValGraph,
  src : Func,
  svid : Array[Int],
  facts : Array[Fact],
  tgt : Func,
  tvid : Array[Int],
  sp : Int,
  tp : Int,
  sh : Int,
  th : Int,
) -> Bool {
  let fs = edge_fact_set(mut vg, src, svid, facts, sp, sh)
  let np = tgt.blocks[th].phis.length()
  let mut j = 0
  while j < np {
    let d = tgt.blocks[th].phis[j].dst
    let c = tgt.blocks[th].phis[j].cls
    let ai = phi_arm_index(tgt, th, j, tp)
    if ai < 0 {
      return false
    }
    let tv = atom_use(mut vg, tvid, c, tgt.blocks[th].phis[j].arms[ai].value)
    let k = if d < svid.length() { find_phi(src, sh, d) } else { -1 }
    let mut sv = tvid[d]
    if k >= 0 && vg_is_phi_of(vg, svid[d], sh) {
      let sa = phi_arm_index(src, sh, k, sp)
      if sa < 0 {
        return false
      }
      sv = atom_use(mut vg, svid, c, src.blocks[sh].phis[k].arms[sa].value)
    }
    if !eq_under(mut vg, fs, sv, tv) {
      return false
    }
    j = j + 1
  }
  true
}

///| `pairs[i]` is (sh, th) and the edges into it check.
fn next_ok(mut vg : ValGraph, src : Func, svid : Array[Int], tgt : Func, cert : Cert, i : Int, sp : Int, tp : Int, sh : Int, th : Int) -> Bool {
  i >= 0 && i < cert.pairs.length() && cert.pairs[i].sb == sh && cert.pairs[i].tb == th &&
  edge_ok(mut vg, src, svid, cert.facts, tgt, cert.tvid, sp, tp, sh, th)
}

fn cmp_zero(mut vg : ValGraph, c : Int) -> Int {
  let z = vg_konst(mut vg, W, 0UL)
  vg_canon_bin(mut vg, W, CEq(W), c, z)
}

///| The terminators of the replayed pair end as `fin` says.
fn check_end(
  mut vg : ValGraph,
  src : Func,
  tgt : Func,
  cert : Cert,
  fs : Array[Fact],
  sc : Int,
  tc : Int,
  fin : EndCert,
) -> Bool {
  let sv = src_view(mut vg, src, cert.svid, fs, sc)
  let tv = tgt_view_c(mut vg, tgt, cert.tvid, fs, tc)
  match fin {
    EndRet =>
    match sv {
      VRet(sh, scls, svv) =>
      match tv {
        VRet(th, tcls, tvv) => sh == th && (!sh || (scls == tcls && eq_under(mut vg, fs, svv, tvv)))
        _ => false
      }
      _ => false
    }
    EndHlt =>
    match sv {
      VHlt =>
      match tv {
        VHlt => true
        _ => false
      }
      _ => false
    }
    EndJmp(i) =>
    match sv {
      VJmp(sj) =>
      match tv {
        VJmp(tj) => next_ok(mut vg, src, cert.svid, tgt, cert, i, sc, tc, sj, tj)
        _ => false
      }
      _ => false
    }
    EndJnz(sw, i1, i2) =>
    match sv {
      VJnz(cs, s1, s2) =>
      match tv {
        VJnz(ct, t1, t2) =>
        if !sw {
          eq_under(mut vg, fs, cs, ct) && next_ok(mut vg, src, cert.svid, tgt, cert, i1, sc, tc, s1, t1) &&
          next_ok(mut vg, src, cert.svid, tgt, cert, i2, sc, tc, s2, t2)
        } else {
          let ns = cmp_zero(mut vg, cs)
          let nt = cmp_zero(mut vg, ct)
          (eq_under(mut vg, fs, ns, ct) || eq_under(mut vg, fs, cs, nt)) &&
          next_ok(mut vg, src, cert.svid, tgt, cert, i1, sc, tc, s1, t2) &&
          next_ok(mut vg, src, cert.svid, tgt, cert, i2, sc, tc, s2, t1)
        }
        _ => false
      }
      _ => false
    }
    EndSrcBranch(i1, i2) =>
    match sv {
      VJnz(_, s1, s2) =>
      match tv {
        VJmp(tj) =>
        next_ok(mut vg, src, cert.svid, tgt, cert, i1, sc, tc, s1, tj) &&
        next_ok(mut vg, src, cert.svid, tgt, cert, i2, sc, tc, s2, tj)
        _ => false
      }
      _ => false
    }
    EndTgtBranch(i1, i2) =>
    match sv {
      VJmp(sj) =>
      match tv {
        VJnz(_, t1, t2) =>
        next_ok(mut vg, src, cert.svid, tgt, cert, i1, sc, tc, sj, t1) &&
        next_ok(mut vg, src, cert.svid, tgt, cert, i2, sc, tc, sj, t2)
        _ => false
      }
      _ => false
    }
  }
}

///| Replay pair p: its steps consume every side effect of both block chains
///| and its end checks the terminators and the successor pairs (0, else
///| the number of the failed check).
fn replay_pair(mut vg : ValGraph, src : Func, si : FnInfo, tgt : Func, ti : FnInfo, cert : Cert, p : PairCert) -> Int {
  let sb = p.sb
  let tb = p.tb
  if sb < 0 || sb >= si.nb || tb < 0 || tb >= ti.nb {
    return 1
  }
  if !head_ok(mut vg, src, cert.svid, tgt, cert.tvid, sb, tb) || !bm_has(cert, tb, sb) {
    return 2
  }
  let mut sc = sb
  let mut sx = 0
  let mut tc = tb
  let mut tx = 0
  let mut schain = [sb]
  let mut tchain = [tb]
  for st in p.steps {
    sx = skip_src_pure(vg, src, cert.svid, sc, sx)
    tx = skip_tgt_pure(mut vg, tgt, cert.tvid, tc, tx)
    let s_has = sx < src.blocks[sc].insts.length()
    let t_has = tx < tgt.blocks[tc].insts.length()
    let fs = facts_of(cert.facts, sc)
    // Where each side goes next (-1: stays).
    let mut sj = -1
    let mut tj = -1
    match st {
      MatchEff => {
        if !s_has || !t_has || !match_effect_c(mut vg, cert.svid, cert.tvid, fs, src.blocks[sc].insts[sx], tgt.blocks[tc].insts[tx]) {
          return 3
        }
        sx = sx + 1
        tx = tx + 1
      }
      SkipSrcReadOnly => {
        if !s_has || !src_skippable(src.blocks[sc].insts[sx]) {
          return 4
        }
        sx = sx + 1
      }
      SrcJmp => {
        if s_has {
          return 5
        }
        sj = view_jmp(src_view(mut vg, src, cert.svid, fs, sc))
      }
      SrcJoin => {
        if s_has {
          return 6
        }
        match src_view(mut vg, src, cert.svid, fs, sc) {
          VJnz(_, _, _) => sj = src_join(src, sc)
          _ => return 7
        }
      }
      TgtJmp => {
        if t_has {
          return 8
        }
        tj = view_jmp(tgt_view_c(mut vg, tgt, cert.tvid, fs, tc))
      }
      BothJmp => {
        if s_has || t_has {
          return 9
        }
        sj = view_jmp(src_view(mut vg, src, cert.svid, fs, sc))
        tj = view_jmp(tgt_view_c(mut vg, tgt, cert.tvid, fs, tc))
        if sj < 0 || tj < 0 {
          return 10
        }
      }
    }
    // The target moves first: its phis read their arguments before the
    // source enters a block.
    if tj >= 0 {
      if tj <= 0 || tj >= ti.nb || contains_int(tchain, tj) || !absorb_ok(mut vg, tgt, cert.tvid, tj, tc) {
        return 11
      }
      // The source block stays the one it entered before: a value of it
      // that is available now stays valid in tj (no `bm` entry needed).
      tchain.push(tj)
      tc = tj
      tx = 0
    }
    if sj >= 0 {
      if sj <= 0 || sj >= si.nb || contains_int(schain, sj) || blk_has_phi_leaf(vg, src, cert.svid, sj) {
        return 13
      }
      if !src_enter_scope_ok(vg, tgt, cert.tvid, tc, sj) || !bm_has(cert, tc, sj) {
        return 14
      }
      schain.push(sj)
      sc = sj
      sx = 0
    }
  }
  sx = skip_src_pure(vg, src, cert.svid, sc, sx)
  tx = skip_tgt_pure(mut vg, tgt, cert.tvid, tc, tx)
  if sx < src.blocks[sc].insts.length() || tx < tgt.blocks[tc].insts.length() {
    return 15
  }
  if check_end(mut vg, src, tgt, cert, facts_of(cert.facts, sc), sc, tc, p.fin) {
    0
  } else {
    16
  }
}

///| 0 when the certificate checks, else the number of the failed check.
pub fn cert_fail_code(src : Func, tgt : Func, cert : Cert) -> Int {
  if wf_code(src) != 0 || wf_code(tgt) != 0 {
    return 1
  }
  if !check_vg_dag(cert.vg) {
    return 2
  }
  let si = build_info(src)
  let ti = build_info(tgt)
  if !vids_ok(cert.vg, cert.svid, si.nt) || !vids_ok(cert.vg, cert.tvid, ti.nt) {
    return 3
  }
  let mut vg = ValGraph::{ nodes: cert.vg.nodes.copy(), buckets: [] }
  if !check_src_defs(mut vg, src, si, cert.svid, cert.facts) {
    return 4
  }
  if !check_tgt_defs(mut vg, tgt, ti, cert.tvid) {
    return 5
  }
  let ids = iota(si.nb)
  if check_avail(vg, src, si, cert.savail, cert.svid, ids, ids) != 0 {
    return 6
  }
  if check_avail(vg, tgt, ti, cert.tavail, cert.tvid, cert.bm_t, cert.bm_s) != 0 {
    return 7
  }
  if check_facts(mut vg, src, si, cert.svid, cert.facts) != 0 {
    return 8
  }
  if cert.pairs.length() == 0 || cert.pairs[0].sb != 0 || cert.pairs[0].tb != 0 {
    return 9
  }
  for p in cert.pairs {
    let r = replay_pair(mut vg, src, si, tgt, ti, cert, p)
    if r != 0 {
      return 100 + r
    }
  }
  0
}

///| The checker: `tgt` refines `src` by the certificate `cert`.
pub fn verify_cert(src : Func, tgt : Func, cert : Cert) -> Bool {
  cert_fail_code(src, tgt, cert) == 0
}

pub fn validate_fn_diag(src : Func, tgt : Func) -> TvResult {
  match build_cert_diag(src, tgt) {
    CertFail(e) => Rejected(e)
    CertOk(cert) => {
      let code = cert_fail_code(src, tgt, cert)
      if code == 0 {
        Valid
      } else {
        Rejected(CertRejected(code))
      }
    }
  }
}

///| `tgt` refines `src`: the solver finds a certificate and the checker
///| accepts it.
pub fn validate_fn(src : Func, tgt : Func) -> Bool {
  match build_cert(src, tgt) {
    None => false
    Some(cert) => verify_cert(src, tgt, cert)
  }
}

///| Diagnostics only (not part of the checker): the steps of the product
///| walk, `9_000_000 + src * 1000 + tgt` at each pair and
///| `act * 1_000_000 + src * 1000 + tgt` per step.
pub fn debug_walk_trace(src : Func, tgt : Func) -> Array[Int] {
  if wf_code(src) != 0 || wf_code(tgt) != 0 {
    return Array::make(0, 0)
  }
  let si = build_info(src)
  let ti = build_info(tgt)
  let mut vg = vg_new()
  let svid0 = src_vids(mut vg, src, si, [])
  let facts0 = compute_facts(mut vg, src, si, svid0)
  let svid = src_vids(mut vg, src, si, facts0)
  let slive = src_live(src, si)
  let facts = compute_facts(mut vg, src, si, svid)
  let mut ts = tgt_state_new(ti.nt, si.nb, ti.nb)
  let _ = walk(mut vg, mut ts, src, si, svid, slive, facts, tgt, ti)
  ts.trace.copy()
}
