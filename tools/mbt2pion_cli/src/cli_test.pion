///| Unit tests for `tools/mbt2pion_cli` helpers.

fn assert_true(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic("ASSERTION FAILED: " + msg)
  }
}

test "cli path and test file helpers" {
  assert_true(join_path("/a/b", "c.mbt") == "/a/b/c.mbt", "join_path without trailing slash")
  assert_true(join_path("/a/b/", "c.mbt") == "/a/b/c.mbt", "join_path with trailing slash")
  assert_true(dirname("/a/b/c.pion") == "/a/b", "dirname")
  assert_true(is_test_mbt("foo_test.mbt"), "_test.mbt detected")
  assert_true(is_test_mbt("foo_wbtest.mbt"), "_wbtest.mbt detected")
  assert_true(!is_test_mbt("foo.mbt"), "regular .mbt is not test")
}

test "check server response validation rejects wrong id, missing ok, non-array diagnostics, and protocol_error" {
  assert_true(
    is_valid_check_server_resp("{\"id\":3,\"ok\":true,\"diagnostics\":[]}", 3),
    "valid ok response accepted",
  )
  assert_true(
    is_valid_check_server_resp("{\"id\":4,\"ok\":false,\"diagnostics\":[{\"code\":\"E_TYPE_MISMATCH\"}]}", 4),
    "valid diagnostic response accepted",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":2,\"ok\":true,\"diagnostics\":[]}", 3),
    "mismatched id rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"diagnostics\":[]}", 3),
    "missing ok field rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"ok\":\"true\",\"diagnostics\":[]}", 3),
    "non-bool ok field rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"ok\":true,\"diagnostics\":{}}", 3),
    "non-array diagnostics object rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"ok\":false,\"protocol_error\":\"bad\",\"diagnostics\":[]}", 3),
    "protocol_error rejected",
  )
}
