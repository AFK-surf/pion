///| Unit tests for `tools/mbt2pion_cli` helpers.

fn assert_true(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic("ASSERTION FAILED: " + msg)
  }
}

test "cli path and test file helpers" {
  assert_true(join_path("/a/b", "c.mbt") == "/a/b/c.mbt", "join_path without trailing slash")
  assert_true(join_path("/a/b/", "c.mbt") == "/a/b/c.mbt", "join_path with trailing slash")
  assert_true(dirname("/a/b/c.pion") == "/a/b", "dirname")
  assert_true(is_test_mbt("foo_test.mbt"), "_test.mbt detected")
  assert_true(is_test_mbt("foo_wbtest.mbt"), "_wbtest.mbt detected")
  assert_true(!is_test_mbt("foo.mbt"), "regular .mbt is not test")
  assert_true(is_pionc_discoverable_source_file("foo.pion"), "top-level non-dot .pion is discoverable source")
  assert_true(!is_pionc_discoverable_source_file("foo_test.pion"), "test file is not discoverable source")
  assert_true(!is_pionc_discoverable_source_file("sub/foo.pion"), "subdir file is not discoverable source")
  assert_true(!is_pionc_discoverable_source_file(".helper.pion"), "leading-dot file is not discoverable source")
  assert_true(is_pionc_discoverable_test_file("foo_test.pion"), "top-level non-dot *_test.pion is discoverable test")
  assert_true(!is_pionc_discoverable_test_file("foo.pion"), "non-test file is not discoverable test")
  assert_true(!is_pionc_discoverable_test_file("sub/foo_test.pion"), "subdir test file is not discoverable test")
  assert_true(!is_pionc_discoverable_test_file(".math_test.pion"), "leading-dot *_test.pion is not discoverable test")
  assert_true(!is_pionc_discoverable_test_file(".math_wbtest_test.pion"), "leading-dot wbtest is not discoverable test")
}

test "check server response validation rejects wrong id, missing ok, non-array diagnostics, and protocol_error" {
  assert_true(
    is_valid_check_server_resp("{\"id\":3,\"ok\":true,\"diagnostics\":[]}", 3),
    "valid ok response accepted",
  )
  assert_true(
    is_valid_check_server_resp("{\"id\":4,\"ok\":false,\"diagnostics\":[{\"code\":\"E_TYPE_MISMATCH\"}]}", 4),
    "valid diagnostic response accepted",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":2,\"ok\":true,\"diagnostics\":[]}", 3),
    "mismatched id rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":4294967297,\"ok\":true,\"diagnostics\":[]}", 1),
    "id + 2^32 rejected without 32-bit narrowing",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":-4294967295,\"ok\":true,\"diagnostics\":[]}", 1),
    "id - 2^32 rejected without 32-bit narrowing",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"diagnostics\":[]}", 3),
    "missing ok field rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"ok\":\"true\",\"diagnostics\":[]}", 3),
    "non-bool ok field rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"ok\":true,\"diagnostics\":{}}", 3),
    "non-array diagnostics object rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":3,\"ok\":false,\"protocol_error\":\"bad\",\"diagnostics\":[]}", 3),
    "protocol_error rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[],\"extra\":\"unterminated", 1),
    "truncated response with unterminated string and missing closing brace rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":truefalse,\"diagnostics\":[]}", 1),
    "non-delimited boolean truefalse rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"id\":999,\"ok\":true,\"diagnostics\":[]}", 1),
    "duplicate id key rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"ok\":\"bad\",\"diagnostics\":[]}", 1),
    "duplicate ok key rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[],\"diagnostics\":{}}", 1),
    "duplicate diagnostics key rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[}]}", 1),
    "mismatched nested brackets rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[0,],\"types\":[]}", 1),
    "trailing comma in array rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[],}", 1),
    "trailing comma in object rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[],\"types\":[],\"note\":\"\\q\"}", 1),
    "invalid escape in skipped string rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[],\"note\":\"\\u123\"}", 1),
    "truncated unicode escape rejected",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"ok\":true,\"diagnostics\":[]\"types\":[]}", 1),
    "missing comma between object entries rejected",
  )
  assert_true(
    is_valid_check_server_resp("{\"\\u0069d\":1,\"ok\":true,\"diagnostics\":[],\"types\":[]}", 1),
    "unicode-escaped id key accepted",
  )
  assert_true(
    !is_valid_check_server_resp("{\"id\":1,\"\\u0069d\":1,\"ok\":true,\"diagnostics\":[]}", 1),
    "duplicate unicode-escaped id key rejected",
  )
}

test "check batch alias mapping avoids collision with real __mbt_probe files" {
  let deep_seg = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let deep_path = deep_seg + "/" + deep_seg + "/" + deep_seg + "/" + deep_seg + "/" + deep_seg + "/" + deep_seg + "/" + deep_seg + "/leaf.pion"
  let batch = [
    ("a.pion", "fn aa() {}"),
    ("a__mbt_probe.pion", "fn bb() {}"),
    ("a_test.pion", "test \"t\" {}"),
    ("xa_test__mbt_probe.pion", "fn cc() {}"),
    ("sub/a_test__mbt_probe.pion", "fn dd() {}"),
    (deep_path, "fn ee() {}"),
  ]
  let (aliased, temp_to_orig) = build_check_batch_aliases(batch)
  assert_true(aliased.length() == 6, "batch length preserved")
  assert_true(aliased[0].0 == "a.pion", "a.pion unchanged")
  assert_true(aliased[1].0 == "a__mbt_probe.pion", "real __mbt_probe file unchanged")
  assert_true(aliased[2].0 == "__mbt_probe_1.pion", "test file gets short fixed-length alias")
  assert_true(aliased[3].0 == "xa_test__mbt_probe.pion", "suffixed __mbt_probe file unchanged")
  assert_true(aliased[4].0 == "__mbt_probe_2.pion", "subdir __mbt_probe file gets short fixed-length alias")
  assert_true(aliased[5].0.length() <= 64, "7-level 250+ byte subdir path alias stays short (<= 64 bytes)")
  let restored = restore_probe_aliases(
    "{\"diagnostics\":[{\"file\":\"src/__mbt_probe_1.pion\",\"message\":\"src/__mbt_probe_1.pion\"},{\"file\":\"__mbt_probe_2.pion\"}],\"types\":[{\"file\":\"src/a__mbt_probe.pion\"},{\"file\":\"src/__mbt_probe_1.pion\"},{\"file\":\"src/xa_test__mbt_probe.pion\"},{\"file\":\"src/sub/a_test__mbt_probe.pion\"},{\"file\":\"src/__mbt_probe_2.pion\"}]}",
    temp_to_orig,
    "",
  )
  assert_true(restored.index_of("\"file\":\"src/a__mbt_probe.pion\"") >= 0, "real __mbt_probe file untouched on restore")
  assert_true(restored.index_of("\"file\":\"src/a_test.pion\"") >= 0, "test alias restored accurately")
  assert_true(restored.index_of("\"file\":\"src/xa_test__mbt_probe.pion\"") >= 0, "suffixed __mbt_probe file preserved intact")
  assert_true(restored.index_of("\"file\":\"src/sub/a_test__mbt_probe.pion\"") >= 0, "subdir alias restored accurately")
  assert_true(restored.index_of("\"file\":\"sub/a_test__mbt_probe.pion\"") >= 0, "bare flat alias restored to POSIX path, not backslash")
  assert_true(restored.index_of("__mbt_probe_2.pion") < 0, "short subdir alias fully restored")
  assert_true(restored.index_of("\"message\":\"src/__mbt_probe_1.pion\"") >= 0, "message text never rewritten")
  let restored_posix = restore_probe_aliases(
    "{\"diagnostics\":[{\"file\":\"/tmp/chk/src/__mbt_probe_1.pion\"},{\"file\":\"/tmp/chk/src/sub/a_test__mbt_probe.pion\"}]}",
    temp_to_orig,
    "/tmp/chk/src",
  )
  assert_true(restored_posix.index_of("\"file\":\"/tmp/chk/src/a_test.pion\"") >= 0, "posix abs root alias restored")
  assert_true(restored_posix.index_of("\"file\":\"/tmp/chk/src/sub/a_test__mbt_probe.pion\"") >= 0, "posix abs subdir preserved")
  let restored_win = restore_probe_aliases(
    "{\"diagnostics\":[{\"file\":\"C:\\\\tmp\\\\chk\\\\src\\\\__mbt_probe_1.pion\"},{\"file\":\"C:\\\\tmp\\\\chk\\\\src\\\\__mbt_probe_2.pion\"}]}",
    temp_to_orig,
    "C:\\tmp\\chk\\src",
  )
  assert_true(restored_win.index_of("\"file\":\"C:\\\\tmp\\\\chk\\\\src\\\\a_test.pion\"") >= 0, "win abs root alias restored")
  assert_true(restored_win.index_of("\"file\":\"C:\\\\tmp\\\\chk\\\\src\\\\sub\\\\a_test__mbt_probe.pion\"") >= 0, "win abs subdir alias restored with backslashes")
  let restored_prefixed = restore_probe_aliases(
    "exit 1: {\"ok\":false,\"diagnostics\":[{\"file\":\"/tmp/chk/src/__mbt_probe_2.pion\",\"message\":\"keep /tmp/chk/src/__mbt_probe_2.pion\"}]}",
    temp_to_orig,
    "/tmp/chk/src",
  )
  assert_true(restored_prefixed.index_of("\"file\":\"/tmp/chk/src/sub/a_test__mbt_probe.pion\"") >= 0, "prefixed error JSON file restored")
  assert_true(restored_prefixed.index_of("\"message\":\"keep /tmp/chk/src/__mbt_probe_2.pion\"") >= 0, "prefixed error JSON message untouched")
}
