///| mbt_compat array_view tests (MoonBit `Array` + `ArrayView` buffer semantics).

test "1 write before growth is visible through the view" {
  let a = ArrayBuf::from_array([1, 2, 3])
  let v = a.view(0, 2)
  a.set(0, 2)
  debug_assert(v.get(0) == 2, "v[0] == 2")
  debug_assert(a.capacity() == 3, "literal capacity == length")
}

test "2 after 256 pushes the old view keeps the old buffer" {
  let a = ArrayBuf::from_array([1, 2, 3])
  let v = a.view(0, 2)
  a.set(0, 2)
  let mut i = 0
  while i < 256 {
    a.push(i)
    i = i + 1
  }
  a.set(0, 3)
  debug_assert(v.get(0) == 2, "old view still reads 2")
  debug_assert(a.get(0) == 3, "array reads 3")
  debug_assert(a.length() == 259, "length")
  debug_assert(a.capacity() == 384, "3 -> 6 -> 12 -> ... -> 384")
}

test "3 nested sub-views share the buffer" {
  let a = ArrayBuf::from_array([10, 11, 12, 13, 14, 15])
  let v = a.view(1, 5)
  let w = v.view(1, 3)
  debug_assert(w.length() == 2 && w.get(0) == 12 && w.get(1) == 13, "w = [12, 13]")
  w.set(0, 99)
  debug_assert(a.get(2) == 99 && v.get(1) == 99, "write through nested view")
  let e = v.exact_view(2, 4)
  debug_assert(e.length() == 2 && e.get(1) == 14, "exact sub-view [13, 14]")
}

test "4 view clamps like xs[a:b]" {
  let a = ArrayBuf::from_array([1, 2, 3, 4, 5])
  debug_assert(a.view(3, 10).to_owned().length() == 2, "end clamped")
  debug_assert(a.view(-2, 2).get(0) == 1, "start clamped")
  debug_assert(a.view(4, 1).length() == 0, "inverted is empty")
  debug_assert(a.view_from(3).get(1) == 5, "a[3:]")
  let v = a.view(1, 4)
  debug_assert(v.view(1, 10).length() == 2, "sub-view clamps to view")
  debug_assert(v.view(3, 1).length() == 0, "sub-view inverted")
}

test "5 exact_view accepts exact ranges" {
  let a = ArrayBuf::from_array([1, 2, 3, 4, 5])
  let v = a.exact_view(1, 4)
  debug_assert(v.length() == 3 && v.get(0) == 2, "[2, 3, 4]")
  debug_assert(a.exact_view(5, 5).length() == 0, "empty at end")
}

test "6 to_owned is independent" {
  let a = ArrayBuf::from_array([1, 2, 3])
  let v = a.view(0, 3)
  let o = v.to_owned()
  a.set(1, 20)
  v.set(2, 30)
  debug_assert(o[1] == 2 && o[2] == 3, "copy unaffected")
  debug_assert(v.get(1) == 20 && a.get(2) == 30, "view and array still shared")
  let b = v.to_buf()
  b.set(0, -1)
  debug_assert(a.get(0) == 1, "to_buf copy unaffected")
}

test "growth policy, with_capacity, insert, remove, append, pop" {
  let e : ArrayBuf[Int] = ArrayBuf::new()
  e.push(1)
  debug_assert(e.capacity() == 8, "0 -> 8")
  let c : ArrayBuf[Int] = ArrayBuf::with_capacity(2)
  c.push(1)
  let cv = c.view(0, 1)
  c.push(2)
  c.set(0, 5)
  debug_assert(cv.get(0) == 5 && c.capacity() == 2, "reserved buffer shared")
  c.push(3)
  c.set(0, 6)
  debug_assert(cv.get(0) == 5 && c.capacity() == 4, "grew 2 -> 4")
  c.insert(0, 0)
  debug_assert(c.to_array().length() == 4 && c.get(0) == 0 && c.get(1) == 6, "insert")
  debug_assert(c.remove(1) == 6 && c.length() == 3, "remove")
  let d = ArrayBuf::from_array([7, 8])
  d.append(c.as_view())
  debug_assert(d.length() == 5 && d.get(4) == 3 && d.capacity() == 8, "append grows 2 -> 8")
  debug_assert(d.pop().unwrap_or(-1) == 3 && d.length() == 4, "pop")
  let m = ArrayBuf::make(3, 'x')
  debug_assert(m.length() == 3 && m.get(2) == 'x', "make")
  let src = [1, 2]
  let fa = ArrayBuf::from_array(src)
  fa.set(0, 9)
  debug_assert(src[0] == 1, "from_array copies")
}

test "array_slice_clamp copies with xs[a:b] clamping" {
  let xs = [1, 2, 3, 4, 5]
  let a = array_slice_clamp(xs, 1, 3)
  debug_assert(a.length() == 2 && a[0] == 2 && a[1] == 3, "[1:3]")
  debug_assert(array_slice_clamp(xs, 3, 10).length() == 2, "end clamped")
  debug_assert(array_slice_clamp(xs, -2, 2)[0] == 1, "start clamped")
  debug_assert(array_slice_clamp(xs, 4, 1).length() == 0, "inverted is empty")
  a[0] = 99
  debug_assert(xs[1] == 2, "independent copy")
  let b = ArrayBuf::from_array(xs)
  for p in [(3, 10), (-2, 2), (4, 1), (0, 5), (5, 5), (2, 2)] {
    let x = array_slice_clamp(xs, p.0, p.1)
    let y = b.view(p.0, p.1).to_owned()
    let mut same = x.length() == y.length()
    let mut i = 0
    while same && i < x.length() {
      same = x[i] == y[i]
      i = i + 1
    }
    debug_assert(same, "same clamping as ArrayBuf::view")
  }
}
