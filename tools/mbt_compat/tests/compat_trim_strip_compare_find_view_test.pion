///| Runtime unit tests for `str_trim_start`, `str_trim_end`, `str_trim` default
///| whitespace, `str_strip_prefix`, `str_clamped_view`, `i64_compare`,
///| `arr_find_first`, and `arr_exact_view`.

test "str_trim_start, str_trim_end, and str_trim default and custom chars" {
  debug_assert(str_trim_start("  \t\n\rhello  ") == "hello  ", "trim_start default whitespace")
  debug_assert(str_trim_end("  hello \t\n\r ") == "  hello", "trim_end default whitespace")
  debug_assert(str_trim(" \t\r\nhello\n\t ") == "hello", "trim default whitespace")
  debug_assert(str_trim_start("xxxhi", chars="x") == "hi", "trim_start custom chars")
  debug_assert(str_trim_end("hixxx", chars="x") == "hi", "trim_end custom chars")
  debug_assert(str_trim("   ") == "", "trim all whitespace")
  debug_assert(str_trim_start("") == "", "trim_start empty")
  debug_assert(str_trim_end("") == "", "trim_end empty")
}

test "str_strip_prefix hit, miss, empty prefix, and exact match" {
  let r1 = match str_strip_prefix("hello world", "hello ") { Some(s) => s == "world", None => false }
  debug_assert(r1, "strip_prefix hit")
  let r2 = match str_strip_prefix("hello", "world") { None => true, Some(_) => false }
  debug_assert(r2, "strip_prefix miss")
  let r3 = match str_strip_prefix("hello", "") { Some(s) => s == "hello", None => false }
  debug_assert(r3, "strip_prefix empty prefix")
  let r4 = match str_strip_prefix("hi", "hello") { None => true, Some(_) => false }
  debug_assert(r4, "strip_prefix longer than string")
  let r5 = match str_strip_prefix("hello", "hello") { Some(s) => s == "", None => false }
  debug_assert(r5, "strip_prefix exact match")
}

test "str_clamped_view bounds clamping and find/to_owned chaining" {
  debug_assert(str_clamped_view("abcdef", start=1, end=4) == "bcd", "in-bounds slice")
  debug_assert(str_clamped_view("abcdef", start=-5, end=3) == "abc", "negative start clamped to 0")
  debug_assert(str_clamped_view("abcdef", start=2, end=99) == "cdef", "end clamped to len")
  debug_assert(str_clamped_view("abcdef", start=4, end=2) == "", "inverted bounds empty")
  let sub = str_clamped_view("hello world", start=6)
  let f = match str_find(sub, "or") { Some(idx) => idx == 1, None => false }
  debug_assert(f, "clamped_view followed by str_find")
  debug_assert(str_to_owned(sub) == "world", "clamped_view followed by str_to_owned")
}

test "i64_compare handles full Int64 range without overflow" {
  let min_i64 : Int64 = -9223372036854775807L - 1L
  let max_i64 : Int64 = 9223372036854775807L
  debug_assert(i64_compare(min_i64, max_i64) == -1, "min < max")
  debug_assert(i64_compare(max_i64, min_i64) == 1, "max > min")
  debug_assert(i64_compare(min_i64, min_i64) == 0, "min == min")
  debug_assert(i64_compare(max_i64, max_i64) == 0, "max == max")
  debug_assert(i64_compare(-1L, 1L) == -1, "-1 < 1")
  debug_assert(i64_compare(42L, 42L) == 0, "42 == 42")
}

test "arr_find_first returns first matching element or None" {
  let xs : Array[Int] = [1, 4, 6, 8]
  let f1 = match arr_find_first(xs, fn(x) { x > 3 }) { Some(v) => v == 4, None => false }
  debug_assert(f1, "find_first returns first match")
  let f2 = match arr_find_first(xs, fn(x) { x > 10 }) { None => true, Some(_) => false }
  debug_assert(f2, "find_first miss returns None")
  let empty : Array[Int] = []
  let f3 = match arr_find_first(empty, fn(x) { x == 0 }) { None => true, Some(_) => false }
  debug_assert(f3, "find_first empty returns None")
}

test "arr_exact_view slices with default and explicit bounds" {
  let xs : Array[Int] = [10, 20, 30, 40]
  let v1 = arr_exact_view(xs, start=1, end=3)
  debug_assert(v1.length() == 2 && v1[0] == 20 && v1[1] == 30, "exact_view [1, 3)")
  let v2 = arr_exact_view(xs, start=2)
  debug_assert(v2.length() == 2 && v2[0] == 30 && v2[1] == 40, "exact_view [2, len)")
  let v3 = arr_exact_view(xs, start=2, end=2)
  debug_assert(v3.length() == 0, "exact_view empty slice")
}
