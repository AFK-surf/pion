test "mbt_ffi_fixed_array: empty arrays return NULL without allocating" {
  let d0 : FixedArray[Double] = FixedArray::make(0, 0.0)
  let dp = mbt_ffi_fixed_array_double_to_ptr(d0)
  assert_true(mbt_ffi_ptr_is_null(dp), "empty Double array must return NULL")
  mbt_ffi_fixed_array_double_from_ptr(d0, dp)

  let i0 : FixedArray[Int] = FixedArray::make(0, 0)
  let ip = mbt_ffi_fixed_array_int_to_ptr(i0)
  assert_true(mbt_ffi_ptr_is_null(ip), "empty Int array must return NULL")
  mbt_ffi_fixed_array_int_from_ptr(i0, ip)

  let b0 : FixedArray[Byte] = FixedArray::make(0, 0.to_byte())
  let bp = mbt_ffi_fixed_array_byte_to_ptr(b0)
  assert_true(mbt_ffi_ptr_is_null(bp), "empty Byte array must return NULL")
  mbt_ffi_fixed_array_byte_from_ptr(b0, bp)

  let f0 : FixedArray[Float] = FixedArray::make(0, 0.0.to_float())
  let fp = mbt_ffi_fixed_array_float_to_ptr(f0)
  assert_true(mbt_ffi_ptr_is_null(fp), "empty Float array must return NULL")
  mbt_ffi_fixed_array_float_from_ptr(f0, fp)

  let l0 : FixedArray[Int64] = FixedArray::make(0, 0L)
  let lp = mbt_ffi_fixed_array_int64_to_ptr(l0)
  assert_true(mbt_ffi_ptr_is_null(lp), "empty Int64 array must return NULL")
  mbt_ffi_fixed_array_int64_from_ptr(l0, lp)
}

test "mbt_ffi_fixed_array: round-trip copy-in and copy-back for all 5 element types" {
  let ds : FixedArray[Double] = FixedArray::make(3, 0.0)
  ds[0] = 1.5
  ds[1] = -2.25
  ds[2] = 42.0
  let dp = mbt_ffi_fixed_array_double_to_ptr(ds)
  assert_true(!mbt_ffi_ptr_is_null(dp), "non-empty Double buffer must be non-null")
  ptr_write_f64(dp, 8L, 99.5)
  mbt_ffi_fixed_array_double_from_ptr(ds, dp)
  mbt_ffi_ptr_free(dp)
  assert_true(ds[0] == 1.5 && ds[1] == 99.5 && ds[2] == 42.0, "Double copy-back mismatch")

  let is_arr : FixedArray[Int] = FixedArray::make(3, 0)
  is_arr[0] = -10
  is_arr[1] = 20
  is_arr[2] = 2147483647
  let ip = mbt_ffi_fixed_array_int_to_ptr(is_arr)
  assert_true(!mbt_ffi_ptr_is_null(ip), "non-empty Int buffer must be non-null")
  ptr_write_i32(ip, 0L, 777)
  mbt_ffi_fixed_array_int_from_ptr(is_arr, ip)
  mbt_ffi_ptr_free(ip)
  assert_true(is_arr[0] == 777 && is_arr[1] == 20 && is_arr[2] == 2147483647, "Int copy-back mismatch")

  let bs : FixedArray[Byte] = FixedArray::make(3, 0.to_byte())
  bs[0] = 0.to_byte()
  bs[1] = 127.to_byte()
  bs[2] = 255.to_byte()
  let bp = mbt_ffi_fixed_array_byte_to_ptr(bs)
  assert_true(!mbt_ffi_ptr_is_null(bp), "non-empty Byte buffer must be non-null")
  ptr_write_u8(bp, 1L, 200)
  mbt_ffi_fixed_array_byte_from_ptr(bs, bp)
  mbt_ffi_ptr_free(bp)
  assert_true(bs[0].to_int() == 0 && bs[1].to_int() == 200 && bs[2].to_int() == 255, "Byte copy-back mismatch")

  let fs : FixedArray[Float] = FixedArray::make(2, 0.0.to_float())
  fs[0] = 1.25.to_float()
  fs[1] = (-3.5).to_float()
  let fp = mbt_ffi_fixed_array_float_to_ptr(fs)
  assert_true(!mbt_ffi_ptr_is_null(fp), "non-empty Float buffer must be non-null")
  ptr_write_i32(fp, 4L, 6.75.to_float().to_bits())
  mbt_ffi_fixed_array_float_from_ptr(fs, fp)
  mbt_ffi_ptr_free(fp)
  assert_true(fs[0].to_double() == 1.25 && fs[1].to_double() == 6.75, "Float copy-back mismatch")

  // Bit-exact f32 round-trip: sNaN (0x7f800001 -> 0x7f800003), -0.0f (0x80000000), min subnormal (0x00000001)
  let neg_zero_bits = 0x80000000U.reinterpret_as_int()
  let snan_in = 0x7f800001
  let snan_out = 0x7f800003
  let min_sub = 0x00000001
  let fb : FixedArray[Float] = FixedArray::make(3, 0.0.to_float())
  fb[0] = Float::from_bits(snan_in)
  fb[1] = Float::from_bits(neg_zero_bits)
  fb[2] = Float::from_bits(min_sub)
  let fbp = mbt_ffi_fixed_array_float_to_ptr(fb)
  assert_true(!mbt_ffi_ptr_is_null(fbp), "non-empty Float bits buffer must be non-null")
  assert_true(ptr_read_i32(fbp, 0L) == snan_in, "sNaN input bits must survive copy-in")
  assert_true(ptr_read_i32(fbp, 4L) == neg_zero_bits, "-0.0f bits must survive copy-in")
  assert_true(ptr_read_i32(fbp, 8L) == min_sub, "min subnormal bits must survive copy-in")
  ptr_write_i32(fbp, 0L, snan_out)
  mbt_ffi_fixed_array_float_from_ptr(fb, fbp)
  mbt_ffi_ptr_free(fbp)
  assert_true(fb[0].to_bits() == snan_out, "sNaN output bits must survive copy-back")
  assert_true(fb[1].to_bits() == neg_zero_bits, "-0.0f bits must survive copy-back")
  assert_true(fb[2].to_bits() == min_sub, "min subnormal bits must survive copy-back")

  let ls : FixedArray[Int64] = FixedArray::make(2, 0L)
  ls[0] = -900000000000L
  ls[1] = 1234567890123L
  let lp = mbt_ffi_fixed_array_int64_to_ptr(ls)
  assert_true(!mbt_ffi_ptr_is_null(lp), "non-empty Int64 buffer must be non-null")
  ptr_write_i64(lp, 0L, 424242424242L)
  mbt_ffi_fixed_array_int64_from_ptr(ls, lp)
  mbt_ffi_ptr_free(lp)
  assert_true(ls[0] == 424242424242L && ls[1] == 1234567890123L, "Int64 copy-back mismatch")
}
