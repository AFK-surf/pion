///| mbt_compat utf16 tests (expected values from `moon run --target wasm-gc`).

let SAMPLE : String = "A中😀B"

test "utf16_len counts UTF-16 code units" {
  debug_assert(utf16_len(SAMPLE) == 5, "A中😀B has 5 units")
  debug_assert(SAMPLE.length() == 9, "and 9 UTF-8 bytes")
  debug_assert(utf16_len("") == 0, "empty")
  debug_assert(utf16_len("e\u{301}") == 2, "combining mark is its own unit")
  debug_assert(utf16_len("😀😀") == 4, "two pairs")
  debug_assert(scalar_len(SAMPLE) == 4, "4 scalars")
}

test "utf16_code_unit_at returns surrogate halves" {
  debug_assert(utf16_code_unit_at(SAMPLE, 0) == 65, "A")
  debug_assert(utf16_code_unit_at(SAMPLE, 1) == 20013, "中")
  debug_assert(utf16_code_unit_at(SAMPLE, 2) == 55357, "high surrogate")
  debug_assert(utf16_code_unit_at(SAMPLE, 3) == 56832, "low surrogate")
  debug_assert(utf16_code_unit_at(SAMPLE, 4) == 66, "B")
  let us = utf16_units(SAMPLE)
  debug_assert(us.length() == 5, "utf16_units length")
  let mut i = 0
  while i < 5 {
    debug_assert(us[i] == utf16_code_unit_at(SAMPLE, i), "utf16_units agrees")
    i = i + 1
  }
}

test "utf16_slice follows clamped_view" {
  debug_assert(utf16_slice(SAMPLE, 2, 4) == "😀", "whole pair")
  debug_assert(utf16_slice(SAMPLE, 3, 4) == "", "start inside pair moves forward")
  debug_assert(utf16_slice(SAMPLE, 2, 3) == "", "end inside pair moves back")
  debug_assert(utf16_slice(SAMPLE, 3, 5) == "B", "start inside pair, then B")
  debug_assert(utf16_slice(SAMPLE, -3, 99) == SAMPLE, "clamped both ends")
  debug_assert(utf16_slice(SAMPLE, 4, 1) == "", "inverted is empty")
  debug_assert(utf16_slice(SAMPLE, 1, 1) == "", "empty range")
  debug_assert(utf16_slice(SAMPLE, 0, 2) == "A中", "prefix")
  debug_assert(utf16_slice_from(SAMPLE, 1) == "中😀B", "suffix")
  debug_assert(utf16_slice("e\u{301}x", 1, 2) == "\u{301}", "combining mark alone")
}

test "utf16_exact_view on valid ranges" {
  debug_assert(utf16_exact_view(SAMPLE, 2, 4) == "😀", "pair")
  debug_assert(utf16_exact_view(SAMPLE, 0, 5) == SAMPLE, "all")
  debug_assert(utf16_exact_view(SAMPLE, 5, 5) == "", "empty at end")
  debug_assert(utf16_get_view(SAMPLE, 3, 4).is_none(), "get_view mid pair")
  debug_assert(utf16_get_view(SAMPLE, 2, 3).is_none(), "get_view end mid pair")
  debug_assert(utf16_get_view(SAMPLE, 0, 6).is_none(), "get_view oob")
  debug_assert(utf16_get_view(SAMPLE, 1, 2).unwrap_or("?") == "中", "get_view ok")
}

test "utf16 <-> utf8 offset conversion" {
  debug_assert(utf16_to_utf8_off(SAMPLE, 0) == 0, "0")
  debug_assert(utf16_to_utf8_off(SAMPLE, 1) == 1, "after A")
  debug_assert(utf16_to_utf8_off(SAMPLE, 2) == 4, "after 中")
  debug_assert(utf16_to_utf8_off(SAMPLE, 3) == 4, "mid pair floors to scalar start")
  debug_assert(utf16_to_utf8_off(SAMPLE, 4) == 8, "after 😀")
  debug_assert(utf16_to_utf8_off(SAMPLE, 5) == 9, "end")
  debug_assert(utf8_to_utf16_off(SAMPLE, 0) == 0, "b0")
  debug_assert(utf8_to_utf16_off(SAMPLE, 1) == 1, "b1")
  debug_assert(utf8_to_utf16_off(SAMPLE, 2) == 1, "inside 中 floors")
  debug_assert(utf8_to_utf16_off(SAMPLE, 4) == 2, "b4")
  debug_assert(utf8_to_utf16_off(SAMPLE, 6) == 2, "inside 😀 floors")
  debug_assert(utf8_to_utf16_off(SAMPLE, 8) == 4, "b8")
  debug_assert(utf8_to_utf16_off(SAMPLE, 9) == 5, "end")
  debug_assert(utf8_to_scalar_off(SAMPLE, 8) == 3, "scalar of B")
  debug_assert(scalar_to_utf8_off(SAMPLE, 3) == 8, "byte of B")
  debug_assert(scalar_to_utf8_off(SAMPLE, 4) == 9, "end scalar")
  // Round trip on every scalar boundary.
  let mut u = 0
  while u <= 5 {
    if u != 3 {
      debug_assert(utf8_to_utf16_off(SAMPLE, utf16_to_utf8_off(SAMPLE, u)) == u, "round trip")
    }
    u = u + 1
  }
}

test "str_iter_scalar_indexed gives scalar indexes" {
  let idx : Array[Int] = []
  let chars : Array[Char] = []
  str_iter_scalar_indexed(SAMPLE, fn(i : Int, c : Char) -> Unit {
    idx.push(i)
    chars.push(c)
  })
  debug_assert(idx.length() == 4, "4 scalars")
  debug_assert(idx[0] == 0 && idx[1] == 1 && idx[2] == 2 && idx[3] == 3, "0,1,2,3")
  debug_assert(chars[0] == 'A', "A")
  debug_assert(chars[1].to_int() == 0x4E2D, "中")
  debug_assert(chars[2].to_int() == 0x1F600, "😀")
  debug_assert(chars[3] == 'B', "B")
  debug_assert(str_scalars("e\u{301}").length() == 2, "combining is a scalar")
}

test "malformed UTF-8 decodes byte-wise as U+FFFD" {
  let bad = "a\xFFb\xE4\xB8"
  debug_assert(utf16_len(bad) == 5, "each bad byte is one unit")
  debug_assert(utf16_code_unit_at(bad, 1) == 0xFFFD, "replacement")
  debug_assert(utf16_code_unit_at(bad, 2) == 98, "b")
  debug_assert(utf16_to_utf8_off(bad, 5) == 5, "end (5 bytes)")
}

test "prefix, suffix and ASCII-only to_lower" {
  debug_assert(str_has_prefix(SAMPLE, "A中"), "prefix")
  debug_assert(!str_has_prefix(SAMPLE, "中"), "not prefix")
  debug_assert(str_has_suffix(SAMPLE, "😀B"), "suffix")
  debug_assert(str_has_prefix(SAMPLE, ""), "empty prefix")
  debug_assert(str_to_lower("Hello WORLD Ä") == "hello world Ä", "ASCII only")
  debug_assert(str_to_lower("😀X") == "😀x", "after non-BMP")
  debug_assert(str_to_lower("abc") == "abc", "unchanged")
  debug_assert(str_to_upper("abc中z") == "ABC中Z", "upper ASCII only")
}

test "str_rev_find, str_lexical_compare, str_from_char_array, char/int helpers, str_cursor_step" {
  debug_assert(str_rev_find("a/b/c", "/").unwrap_or(-1) == 3, "rev_find ascii")
  debug_assert(str_rev_find("A中😀中B", "中").unwrap_or(-1) == 4, "rev_find utf16 offset")
  debug_assert(str_rev_find("abc", "z").is_none(), "rev_find none")
  debug_assert(str_lexical_compare("alpha", "k9") < 0, "lexical alpha < k9")
  debug_assert(str_lexical_compare("abc", "abcd") < 0, "lexical prefix < longer")
  debug_assert(str_lexical_compare("abc", "abc") == 0, "lexical eq")
  let chars = ['A', '中', '😀', 'B']
  debug_assert(str_from_char_array(chars) == "A中😀B", "str_from_char_array")
  debug_assert(char_is_ascii_digit('0') && char_is_ascii_digit('9') && !char_is_ascii_digit('a'), "char_is_ascii_digit")
  debug_assert(char_to_ascii_lowercase('Z') == 'z' && char_to_ascii_lowercase('a') == 'a', "char_to_ascii_lowercase")
  debug_assert(int_unsafe_to_char(65) == 'A' && int_unsafe_to_char(0x1F600) == '😀', "int_unsafe_to_char")
  let s = "A中😀B"
  let mut pos = 0
  let n = str_byte_len(s)
  let out : Array[Char] = []
  while pos < n {
    let (ch, next_pos) = str_cursor_step(s, pos)
    pos = next_pos
    out.push(ch)
  }
  debug_assert(out.length() == 4 && out[0] == 'A' && out[2] == '😀' && out[3] == 'B', "str_cursor_step")
}

test "utf16 <-> scalar offset conversion" {
  // "A中😀B": utf16 offsets 0 1 2 (3 inside the pair) 4 5 -> scalars 0 1 2 (2) 3 4
  debug_assert(utf16_to_scalar_off(SAMPLE, 0) == 0, "0")
  debug_assert(utf16_to_scalar_off(SAMPLE, 2) == 2, "start of pair")
  debug_assert(utf16_to_scalar_off(SAMPLE, 3) == 2, "mid pair floors to its scalar")
  debug_assert(utf16_to_scalar_off(SAMPLE, 4) == 3, "B")
  debug_assert(utf16_to_scalar_off(SAMPLE, 5) == 4, "end")
  debug_assert(scalar_to_utf16_off(SAMPLE, 0) == 0, "s0")
  debug_assert(scalar_to_utf16_off(SAMPLE, 2) == 2, "s2")
  debug_assert(scalar_to_utf16_off(SAMPLE, 3) == 4, "after pair")
  debug_assert(scalar_to_utf16_off(SAMPLE, 4) == 5, "end")
  // Round trips through all three units on every scalar boundary.
  let mut k = 0
  while k <= 4 {
    let u = scalar_to_utf16_off(SAMPLE, k)
    debug_assert(utf16_to_scalar_off(SAMPLE, u) == k, "scalar->utf16->scalar")
    let b = scalar_to_utf8_off(SAMPLE, k)
    debug_assert(utf8_to_utf16_off(SAMPLE, b) == u, "scalar->utf8->utf16")
    debug_assert(utf16_to_utf8_off(SAMPLE, u) == b, "scalar->utf16->utf8")
    debug_assert(utf8_to_scalar_off(SAMPLE, b) == k, "scalar->utf8->scalar")
    k = k + 1
  }
  debug_assert(utf16_to_scalar_off("e\u{301}x", 2) == 2, "combining mark counts")
}

test "str_compare follows MoonBit String ordering" {
  debug_assert(str_compare("k9", "alpha") == -1, "shorter first")
  debug_assert(str_compare("beta", "zeta") == -1, "same length: code units")
  debug_assert(str_compare("zeta", "beta") == 1, "reverse")
  debug_assert(str_compare("mid", "mid") == 0, "equal")
  debug_assert(str_compare("😀", "\u{FF01}\u{FF01}") == -1, "UTF-16 order, not UTF-8 bytes")
  debug_assert(str_compare("中", "😀") == -1, "1 unit < 2 units")
  let xs = ["alpha", "k9", "zeta", "mid", "beta"]
  arr_sort_by(xs, str_compare)
  debug_assert(xs.join(",") == "k9,mid,beta,zeta,alpha", "MoonBit sort() order")
}

fn repeat(piece : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(piece)
    i = i + 1
  }
  sb.to_string()
}

fn units_agree(s : String) -> Bool {
  let us = utf16_units(s)
  if utf16_len(s) != us.length() || utf16_len_scan(s) != us.length() {
    return false
  }
  let mut i = 0
  while i < us.length() {
    if utf16_code_unit_at(s, i) != us[i] {
      return false
    }
    i = i + 1
  }
  true
}

test "indexed long strings agree with the plain scan" {
  debug_assert(units_agree(repeat("abcdefgh", 100)), "ASCII 800")
  debug_assert(units_agree(repeat("abc中文😀de", 200)), "mixed CJK + pairs")
  debug_assert(units_agree(repeat("😀", 100)), "pairs straddle every checkpoint")
  debug_assert(units_agree(repeat("x😀", 70)), "odd pair alignment")
  debug_assert(units_agree(repeat("a\xFFb\xE4", 40)), "malformed bytes")
  debug_assert(units_agree("a" + repeat("é", 40)), "2-byte scalars")
  let mixed = repeat("abc中文😀de", 10)
  debug_assert(utf16_len(mixed) == 90, "10 x 9 units")
  debug_assert(utf16_code_unit_at(mixed, 5) == 0xD83D, "high half")
  debug_assert(utf16_code_unit_at(mixed, 6) == 0xDE00, "low half")
  debug_assert(utf16_slice(mixed, 6, 9) == "de", "slice moves past the pair")
}

test "index cache survives more strings than slots" {
  let ss : Array[String] = []
  let mut k = 0
  while k < 7 {
    ss.push(repeat("ab😀" + k.to_string(), 30 + k))
    k = k + 1
  }
  let mut ok = true
  let mut round = 0
  while round < 3 {
    for s in ss {
      ok = ok && units_agree(s)
    }
    round = round + 1
  }
  debug_assert(ok, "round-robin eviction keeps results exact")
}

test "str_trim_end drops trailing scalars of the set" {
  debug_assert(str_trim_end("ab \t\n", chars=" \t\n\r") == "ab", "ASCII whitespace")
  debug_assert(str_trim_end("abc", chars=" ") == "abc", "nothing to trim")
  debug_assert(str_trim_end("   ", chars=" ") == "", "all trimmed")
  debug_assert(str_trim_end("", chars=" ") == "", "empty")
  debug_assert(str_trim_end("h\u{e9}llo\u{20ac}\u{20ac}", chars="\u{20ac}") == "h\u{e9}llo", "multi-byte set member")
  debug_assert(str_trim_end("x\u{e9}", chars="\u{e8}") == "x\u{e9}", "scalars compared whole, not by bytes")
  debug_assert(str_trim_end("a b ", chars="") == "a b ", "empty set keeps all")
  debug_assert(str_trim_end("A😀😀", chars="😀") == "A", "astral scalars")
}
