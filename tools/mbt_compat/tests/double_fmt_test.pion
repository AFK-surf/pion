///| mbt_compat double_fmt tests (golden values from `moon run --target wasm-gc`).

fn df(d : Double) -> String {
  double_to_string(d)
}

test "special values" {
  debug_assert(df(0.0) == "0", "0")
  debug_assert(df(-0.0) == "0", "-0.0 prints 0")
  debug_assert(df(0.0 / 0.0) == "NaN", "NaN")
  debug_assert(df(1.0 / 0.0) == "Infinity", "Infinity")
  debug_assert(df(-1.0 / 0.0) == "-Infinity", "-Infinity")
}

test "integers and plain decimals" {
  debug_assert(df(1.0) == "1", "1")
  debug_assert(df(100.0) == "100", "100")
  debug_assert(df(-2.5) == "-2.5", "-2.5")
  debug_assert(df(123.456) == "123.456", "123.456")
  debug_assert(df(0.1 + 0.2) == "0.30000000000000004", "0.1+0.2")
  debug_assert(df(1e20) == "100000000000000000000", "1e20")
  debug_assert(df(123456789012345680000.0) == "123456789012345680000", "big int")
  debug_assert(df(9007199254740993.0) == "9007199254740992", "2^53+1 rounds")
  debug_assert(df(0.000001) == "0.000001", "1e-6 plain")
  debug_assert(df(-0.5) == "-0.5", "-0.5")
}

test "scientific notation" {
  debug_assert(df(1.5e-7) == "1.5e-7", "1.5e-7")
  debug_assert(df(1e-7) == "1e-7", "1e-7")
  debug_assert(df(2e-7) == "2e-7", "2e-7")
  debug_assert(df(1e21) == "1e+21", "1e21")
  debug_assert(df(1e100) == "1e+100", "1e100")
  debug_assert(df(5e-324) == "5e-324", "min subnormal")
  debug_assert(df(1.7976931348623157e308) == "1.7976931348623157e+308", "max")
  debug_assert(df(2.2250738585072014e-308) == "2.2250738585072014e-308", "min normal")
  debug_assert(df(-1.25e-10) == "-1.25e-10", "negative sci")
}

test "shortest digits round-trip" {
  let samples = [0.1, 0.7, 1.0 / 3.0, 2.0 / 3.0, 3.14159, 6.02214076e23, 1.0e-5, 4.35, 0.3, 1e15 + 0.3]
  for d in samples {
    let s = df(d)
    match s.to_double() {
      Some(back) => debug_assert(back == d, "round trip " + s)
      None => debug_assert(false, "unparsable " + s)
    }
  }
  debug_assert(df(1.0 / 3.0) == "0.3333333333333333", "1/3")
  debug_assert(df(2.0 / 3.0) == "0.6666666666666666", "2/3")
}
