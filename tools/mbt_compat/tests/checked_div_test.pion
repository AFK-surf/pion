///| mbt_compat checked_div tests. The trapping cases (zero divisor, signed
///| MIN / -1) are covered by the differential oracle, which runs them as
///| separate processes and compares the panic with Moon `wasm-gc`.

test "signed 32-bit division truncates toward zero" {
  debug_assert(div_checked_i32(7, 2) == 3, "7/2")
  debug_assert(div_checked_i32(-7, 2) == -3, "-7/2")
  debug_assert(mod_checked_i32(-7, 2) == -1, "-7%2")
  debug_assert(mod_checked_i32(7, -2) == 1, "7%-2")
  debug_assert(div_checked_i32(-2147483648, 1) == -2147483648, "MIN/1")
  debug_assert(div_checked_i32(2147483647, -1) == -2147483647, "MAX/-1")
  debug_assert(mod_checked_i32(-2147483648, -1) == 0, "MIN%-1 is 0")
  debug_assert(mod_checked_i32(5, -1) == 0, "x%-1 is 0")
}

test "signed 64-bit" {
  debug_assert(div_checked_i64(-7L, 2L) == -3L, "-7/2")
  debug_assert(mod_checked_i64(-7L, 2L) == -1L, "-7%2")
  debug_assert(mod_checked_i64(-9223372036854775807L - 1L, -1L) == 0L, "MIN%-1")
  debug_assert(div_checked_i64(9223372036854775807L, -1L) == -9223372036854775807L, "MAX/-1")
}

test "unsigned and byte" {
  debug_assert(div_checked_u32(4294967295U, 7U) == 613566756U, "u32 max/7")
  debug_assert(mod_checked_u32(4294967295U, 7U) == 3U, "u32 max%7")
  debug_assert(div_checked_u64(18446744073709551615UL, 10UL) == 1844674407370955161UL, "u64")
  debug_assert(mod_checked_u64(18446744073709551615UL, 10UL) == 5UL, "u64 mod")
  debug_assert(div_checked_byte(b'\xff', b'\x07') == b'\x24', "255/7=36")
  debug_assert(mod_checked_byte(b'\xff', b'\x07') == b'\x03', "255%7=3")
}
