///| Unit tests for `mbt_iter2_new`, `ordered_map_values_iter`, and `MbtToJson` / `mbt_to_json`.

fn assert_eq_str_tji(actual : String, expected : String, msg : String) -> Unit {
  if actual != expected {
    panic("ASSERTION FAILED: " + msg + " (got `" + actual + "`, expected `" + expected + "`)")
  }
}

fn assert_eq_int_tji(actual : Int, expected : Int, msg : String) -> Unit {
  if actual != expected {
    panic("ASSERTION FAILED: " + msg + " (got " + actual.to_string() + ", expected " + expected.to_string() + ")")
  }
}

test "iter2_new: lazy pull pairs, to_array, each, and iter" {
  let mut idx = 0
  let it = mbt_iter2_new(fn() -> Option[(String, Int)] {
    if idx == 0 {
      idx = 1
      Some(("a", 10))
    } else if idx == 1 {
      idx = 2
      Some(("b", 20))
    } else {
      None
    }
  })
  let pairs = it.to_array()
  assert_eq_int_tji(pairs.length(), 2, "iter2 pair count")
  assert_eq_str_tji(pairs[0].0, "a", "pair 0 key")
  assert_eq_int_tji(pairs[0].1, 10, "pair 0 val")
  assert_eq_str_tji(pairs[1].0, "b", "pair 1 key")
  assert_eq_int_tji(pairs[1].1, 20, "pair 1 val")
  assert_eq_int_tji(it.to_array().length(), 0, "exhausted iter2")

  let mut idx2 = 0
  let it_from = mbt_iter2_from_iter(mbt_iter_new(fn() -> Option[(String, Int)] {
    if idx2 == 0 {
      idx2 = 1
      Some(("k", 99))
    } else {
      None
    }
  }))
  let pairs2 = it_from.to_array()
  assert_eq_int_tji(pairs2.length(), 1, "mbt_iter2_from_iter count")
  assert_eq_str_tji(pairs2[0].0, "k", "mbt_iter2_from_iter key")
  assert_eq_int_tji(pairs2[0].1, 99, "mbt_iter2_from_iter val")
}

struct ArrFieldKey {
  tag : Int
  items : Array[Int]
}

impl Eq for ArrFieldKey {
  fn equal(self : ArrFieldKey, other : ArrFieldKey) -> Bool {
    if self.tag != other.tag || self.items.length() != other.items.length() {
      return false
    }
    let mut i = 0
    while i < self.items.length() {
      if self.items[i] != other.items[i] {
        return false
      }
      i = i + 1
    }
    true
  }
}

impl MbtHash for ArrFieldKey {
  fn hash_combine(self : ArrFieldKey, hasher : MbtHasher) -> Unit {
    self.tag.hash_combine(hasher)
    for x in self.items {
      x.hash_combine(hasher)
    }
  }
}

impl MapKey for ArrFieldKey {
  fn key_hash(self : ArrFieldKey) -> Int {
    mbt_hash(self)
  }
  fn key_eq(self : ArrFieldKey, other : ArrFieldKey) -> Bool {
    self == other
  }
}

test "array_key helpers and struct with Array[Int] field as OrderedMap key" {
  let m : OrderedMap[ArrFieldKey, String] = ordered_map_new()
  let k1 = ArrFieldKey::{ tag: 1, items: [10, 20] }
  let k2 = ArrFieldKey::{ tag: 1, items: [10, 20] }
  let k3 = ArrFieldKey::{ tag: 1, items: [10, 30] }
  m.set(k1, "hit")
  match m.get(k2) {
    Some(v) => assert_eq_str_tji(v, "hit", "equal ArrFieldKey lookup")
    None => panic("expected Some(\"hit\") for equal ArrFieldKey")
  }
  match m.get(k3) {
    Some(_) => panic("distinct ArrFieldKey must not collide")
    None => ()
  }

  let am : OrderedMap[Array[Int], Int] = ordered_map_new_array()
  am.set([1, 2], 42)
  match am.get([1, 2]) {
    Some(v) => assert_eq_int_tji(v, 42, "ordered_map_new_array lookup")
    None => panic("expected Some(42)")
  }
  assert_eq_int_tji(mbt_hash_array([1, 2]), 851499103, "mbt_hash_array matches MoonBit Hash::hash([1, 2])")
}

test "ordered_map_values_iter: live in-place update and skip deleted unvisited keys" {
  let m : OrderedMap[String, Int] = ordered_map_new()
  m.set("first", 1)
  m.set("second", 2)
  m.set("third", 3)
  let it = ordered_map_values_iter(m)
  match it.head() {
    Some(v) => assert_eq_int_tji(v, 1, "first value")
    None => panic("expected Some(1)")
  }
  m.remove("second")
  m.set("third", 30)
  let rest = it.collect()
  assert_eq_int_tji(rest.length(), 1, "deleted unvisited key skipped")
  assert_eq_int_tji(rest[0], 30, "in-place update on unvisited key observed")
}

test "mbt_to_json: primitives, non-finite Double/Float as String, and MbtJson" {
  assert_eq_str_tji(mbt_to_json(42).stringify(), "42", "Int")
  assert_eq_str_tji(mbt_to_json(9007199254740993L).stringify(), "\"9007199254740993\"", "Int64")
  assert_eq_str_tji(mbt_to_json(7U).stringify(), "7", "UInt")
  assert_eq_str_tji(mbt_to_json(18446744073709551615UL).stringify(), "\"18446744073709551615\"", "UInt64")
  assert_eq_str_tji(mbt_to_json(1.5).stringify(), "1.5", "Double")
  assert_eq_str_tji(mbt_to_json(Float::from_double(2.5)).stringify(), "2.5", "Float")
  assert_eq_str_tji(mbt_to_json(true).stringify(), "true", "Bool true")
  assert_eq_str_tji(mbt_to_json(false).stringify(), "false", "Bool false")
  assert_eq_str_tji(mbt_to_json("hi").stringify(), "\"hi\"", "String")
  assert_eq_str_tji(mbt_to_json('A').stringify(), "\"A\"", "Char")
  assert_eq_str_tji(mbt_to_json(()).stringify(), "null", "Unit")
  assert_eq_str_tji(mbt_to_json(MbtJson::Null).stringify(), "null", "MbtJson")

  let d_nan = 0.0 / 0.0
  let d_inf = double_inf()
  let d_ninf = double_neg_inf()
  match mbt_to_json(d_nan) {
    MbtJson::String(s) => assert_eq_str_tji(s, "NaN", "Double NaN is MbtJson::String")
    _ => panic("Double NaN must produce MbtJson::String(\"NaN\")")
  }
  match mbt_to_json(d_inf) {
    MbtJson::String(s) => assert_eq_str_tji(s, "Infinity", "Double +Inf is MbtJson::String")
    _ => panic("Double +Inf must produce MbtJson::String(\"Infinity\")")
  }
  match mbt_to_json(d_ninf) {
    MbtJson::String(s) => assert_eq_str_tji(s, "-Infinity", "Double -Inf is MbtJson::String")
    _ => panic("Double -Inf must produce MbtJson::String(\"-Infinity\")")
  }
  match mbt_to_json(Float::from_double(d_nan)) {
    MbtJson::String(s) => assert_eq_str_tji(s, "NaN", "Float NaN is MbtJson::String")
    _ => panic("Float NaN must produce MbtJson::String(\"NaN\")")
  }
  match mbt_to_json(Float::from_double(d_inf)) {
    MbtJson::String(s) => assert_eq_str_tji(s, "Infinity", "Float +Inf is MbtJson::String")
    _ => panic("Float +Inf must produce MbtJson::String(\"Infinity\")")
  }
  match mbt_to_json(Float::from_double(d_ninf)) {
    MbtJson::String(s) => assert_eq_str_tji(s, "-Infinity", "Float -Inf is MbtJson::String")
    _ => panic("Float -Inf must produce MbtJson::String(\"-Infinity\")")
  }
}

test "ordered_map_from_iter: scalar, pair, triple, array keys and duplicate overwrite order" {
  let m : OrderedMap[String, Int] = ordered_map_from_iter(arr_iter([("a", 1), ("b", 2), ("a", 9)]))
  let ks = m.keys()
  assert_eq_int_tji(ks.length(), 2, "duplicate key count")
  assert_eq_str_tji(ks[0], "a", "first key stays first")
  assert_eq_str_tji(ks[1], "b", "second key stays second")
  assert_eq_int_tji(m.get_or_default("a", 0), 9, "later value overwrites earlier")

  let mp : OrderedMap[(Int, String), Int] = ordered_map_from_iter_pair(arr_iter([((1, "x"), 10), ((2, "y"), 20), ((1, "x"), 30)]))
  assert_eq_int_tji(mp.get_or_default((1, "x"), 0), 30, "pair key overwrite")
  assert_eq_int_tji(mp.get_or_default((2, "y"), 0), 20, "pair key second")

  let mt : OrderedMap[(Int, Int, Int), String] = ordered_map_from_iter_triple(arr_iter([((1, 2, 3), "ok")]))
  assert_eq_str_tji(mt.get_or_default((1, 2, 3), ""), "ok", "triple key lookup")

  let ma : OrderedMap[Array[Int], Int] = ordered_map_from_iter_array(arr_iter([([1, 2], 7), ([1, 2], 8)]))
  assert_eq_int_tji(ma.get_or_default([1, 2], 0), 8, "array key overwrite")
}

test "ordered_map_to_json: OrderedMap[String, Int/Double/String/Bool/MbtJson]" {
  let mi : OrderedMap[String, Int] = ordered_map_from_array([("a", 1), ("b", 2)])
  assert_eq_str_tji(mi.to_json().stringify(), "{\"a\":1,\"b\":2}", "OrderedMap[String, Int]")
  assert_eq_str_tji(ordered_map_to_json(mi).stringify(), "{\"a\":1,\"b\":2}", "ordered_map_to_json Int")

  let md : OrderedMap[String, Double] = ordered_map_from_array([("x", 1.5)])
  assert_eq_str_tji(md.to_json().stringify(), "{\"x\":1.5}", "OrderedMap[String, Double]")

  let ms : OrderedMap[String, String] = ordered_map_from_array([("k", "v")])
  assert_eq_str_tji(ms.to_json().stringify(), "{\"k\":\"v\"}", "OrderedMap[String, String]")

  let mb : OrderedMap[String, Bool] = ordered_map_from_array([("t", true), ("f", false)])
  assert_eq_str_tji(mb.to_json().stringify(), "{\"t\":true,\"f\":false}", "OrderedMap[String, Bool]")

  let mj : OrderedMap[String, MbtJson] = ordered_map_from_array([("n", MbtJson::Null)])
  assert_eq_str_tji(mj.to_json().stringify(), "{\"n\":null}", "OrderedMap[String, MbtJson]")
}
