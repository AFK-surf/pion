///| mbt_compat ordered_set tests: insertion order, iterator mutation semantics,
///| O(live) slot compaction, set algebra, and MapKey xxHash32 unification.

test "OrderedSet basic operations and insertion order" {
  let s : OrderedSet[Int] = OrderedSet::new()
  debug_assert(s.is_empty() && s.length() == 0, "empty")
  s.add(3)
  s.add(1)
  s.add(2)
  s.add(1)
  debug_assert(s.length() == 3 && !s.is_empty(), "dedup")
  let a = s.to_array()
  debug_assert(a.length() == 3 && a[0] == 3 && a[1] == 1 && a[2] == 2, "insertion order")
  debug_assert(s.contains(1) && !s.contains(99), "contains")
  debug_assert(s.remove_and_check(1), "remove present")
  debug_assert(!s.remove_and_check(1), "remove absent")
  s.add(1)
  let a2 = s.to_array()
  debug_assert(a2.length() == 3 && a2[0] == 3 && a2[1] == 2 && a2[2] == 1, "re-add moves to end")
}

test "OrderedSet iter mutation semantics (remove+add, add+remove, clear+add)" {
  // Case 1: remove(3); add(4) -> yields 1, 2, 4
  let s1 : OrderedSet[Int] = OrderedSet::from_array([1, 2, 3])
  let it1 = s1.iter()
  let out1 : Array[Int] = []
  match (it1.next)() {
    Some(v) => out1.push(v)
    None => ()
  }
  s1.remove(3)
  s1.add(4)
  while true {
    match (it1.next)() {
      Some(v) => out1.push(v)
      None => break
    }
  }
  debug_assert(out1.length() == 3 && out1[0] == 1 && out1[1] == 2 && out1[2] == 4, "remove(3)+add(4) -> 124")

  // Case 2: add(4); remove(2) -> yields 1, 2, 3
  let s2 : OrderedSet[Int] = OrderedSet::from_array([1, 2, 3])
  let it2 = s2.iter()
  let out2 : Array[Int] = []
  match (it2.next)() {
    Some(v) => out2.push(v)
    None => ()
  }
  s2.add(4)
  s2.remove(2)
  while true {
    match (it2.next)() {
      Some(v) => out2.push(v)
      None => break
    }
  }
  debug_assert(out2.length() == 3 && out2[0] == 1 && out2[1] == 2 && out2[2] == 3, "add(4)+remove(2) -> 123")

  // Case 3: clear(); add(4) -> old yields 2, 3; new set len == 1
  let s3 : OrderedSet[Int] = OrderedSet::from_array([1, 2, 3])
  let it3 = s3.iter()
  let first3 = match (it3.next)() {
    Some(v) => v
    None => -1
  }
  debug_assert(first3 == 1, "first is 1")
  s3.clear()
  s3.add(4)
  let rest3 : Array[Int] = []
  while true {
    match (it3.next)() {
      Some(v) => rest3.push(v)
      None => break
    }
  }
  debug_assert(rest3.length() == 2 && rest3[0] == 2 && rest3[1] == 3, "clear+add -> old yields 2,3")
  debug_assert(s3.length() == 1 && s3.contains(4), "cleared set has only 4")
}

test "OrderedSet 100k -> 1 compaction and abandoned cursor stress" {
  let s : OrderedSet[Int] = OrderedSet::new()
  let mut i = 0
  while i < 100000 {
    s.add(i)
    i = i + 1
  }
  debug_assert(s.length() == 100000, "100k inserted")
  // Keep one active iterator and abandon many iterators during deletion
  let live_it = s.iter()
  let _ = (live_it.next)()
  i = 0
  while i < 99999 {
    if i % 10000 == 0 {
      let abandoned = s.iter()
      let _ = (abandoned.next)()
    }
    s.remove(i)
    i = i + 1
  }
  debug_assert(s.length() == 1 && s.contains(99999), "only 99999 remains")
  debug_assert(s.slot_table_len() <= 64, "slot table compacted to O(live) <= 64")
}

test "OrderedSet set algebra, retain, each, eachi, copy, equal" {
  let a : OrderedSet[String] = ordered_set_from_array(["a", "b", "c"])
  let b : OrderedSet[String] = ordered_set_from_array(["b", "c", "d"])
  debug_assert(a.union(b).to_array().join(",") == "a,b,c,d", "union")
  debug_assert(a.intersection(b).to_array().join(",") == "b,c", "intersection")
  debug_assert(a.difference(b).to_array().join(",") == "a", "difference")
  debug_assert(a.symmetric_difference(b).to_array().join(",") == "a,d", "symdiff")
  debug_assert(ordered_set_from_array(["b", "c"]).is_subset(a), "is_subset")
  debug_assert(ordered_set_from_array(["x", "y"]).is_disjoint(a), "is_disjoint")
  debug_assert(a.equal(ordered_set_from_array(["c", "a", "b"])), "equal order-independent")
  let c = a.copy()
  c.retain(fn(x : String) -> Bool { x != "b" })
  debug_assert(c.to_array().join(",") == "a,c" && a.length() == 3, "retain + copy independence")
  let seen : Array[String] = []
  c.eachi(fn(idx : Int, k : String) -> Unit { seen.push("\{idx}:\{k}") })
  debug_assert(seen.join(",") == "0:a,1:c", "eachi")
}

test "MapKey key_hash unified with MbtHasher xxHash32 and arr_retain/arr_filter_map" {
  let k : Int = 7
  debug_assert(k.key_hash() == mbt_hash(7), "MapKey::key_hash == mbt_hash")
  debug_assert(mbt_hash(7) == -427046664, "xxHash32(7) == -427046664")
  let xs : Array[Int] = [1, 2, 3, 4, 5, 6]
  arr_retain(xs, fn(x : Int) -> Bool { x % 2 == 0 })
  debug_assert(xs.length() == 3 && xs[0] == 2 && xs[1] == 4 && xs[2] == 6, "arr_retain")
  let ys = arr_filter_map([1, 2, 3, 4], fn(x : Int) -> Option[Int] {
    if x % 2 == 1 { Some(x * 10) } else { None }
  })
  debug_assert(ys.length() == 2 && ys[0] == 10 && ys[1] == 30, "arr_filter_map")
  // Keep-all and drop-all non-mutating retain/filter_map edge cases
  let zs : Array[Int] = [1, 2, 3]
  arr_retain(zs, fn(_x : Int) -> Bool { true })
  debug_assert(zs.length() == 3 && zs[0] == 1 && zs[2] == 3, "arr_retain keep-all")
  arr_retain(zs, fn(_x : Int) -> Bool { false })
  debug_assert(zs.length() == 0, "arr_retain drop-all")
  let empty_fm = arr_filter_map([1, 2, 3], fn(_x : Int) -> Option[Int] { None })
  debug_assert(empty_fm.length() == 0, "arr_filter_map none")
  // P1-6: single-pass UTF-8->UTF-16 string hash parity with MbtHasher across ASCII, Latin-1, CJK, surrogate emoji, empty
  let samples = ["", "hello", "key_0123456789", "é", "中文", "😀", "aé中😀z"]
  for s in samples {
    debug_assert(s.key_hash() == mbt_hash(s), "MapKey::key_hash(String) == mbt_hash(String)")
  }
}
