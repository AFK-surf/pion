///| Unit tests for `MbtJson`, `utf8_decode_strict`, `str_try_parse_int`, `str_try_parse_double`, `bytes_clamped_view`, `str_view`.

fn assert_true_j(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic("ASSERTION FAILED: " + msg)
  }
}

test "MbtJson constructors, stringify, parse, and eq" {
  let obj : OrderedMap[String, MbtJson] = ordered_map_new()
  obj.set("a", MbtJson::number(42.0))
  obj.set("b", MbtJson::boolean(true))
  obj.set("c", MbtJson::string("hi\n\"x\""))
  obj.set("d", MbtJson::array([MbtJson::null(), MbtJson::boolean(false), MbtJson::number(1.5)]))
  let j = MbtJson::object(obj)
  let s = j.stringify()
  assert_true_j(s == "{\"a\":42,\"b\":true,\"c\":\"hi\\n\\\"x\\\"\",\"d\":[null,false,1.5]}", "stringify: " + s)
  match mbt_json_parse(s) {
    Ok(parsed) => assert_true_j(mbt_json_eq(j, parsed), "parse round-trip equals original")
    Err(e) => panic("mbt_json_parse failed: " + e)
  }
  match mbt_json_parse("{bad") {
    Ok(_) => panic("invalid json must return Err")
    Err(_) => ()
  }
  // P1-2: MbtJson repr preservation + non-finite stringify + strict RFC 8259
  match mbt_json_parse("9007199254740993") {
    Ok(v) => assert_true_j(v.stringify() == "9007199254740993", "unsafe int repr: " + v.stringify())
    Err(e) => panic("parse unsafe int failed: " + e)
  }
  match mbt_json_parse("-9007199254740993") {
    Ok(v) => assert_true_j(v.stringify() == "-9007199254740993", "neg unsafe int repr: " + v.stringify())
    Err(e) => panic("parse neg unsafe int failed: " + e)
  }
  match mbt_json_parse("1e500") {
    Ok(v) => assert_true_j(v.stringify() == "1e500", "overflowing json number repr: " + v.stringify())
    Err(e) => panic("parse 1e500 failed: " + e)
  }
  match mbt_json_parse("-1e500") {
    Ok(v) => assert_true_j(v.stringify() == "-1e500", "neg overflowing json number repr: " + v.stringify())
    Err(e) => panic("parse -1e500 failed: " + e)
  }
  assert_true_j(MbtJson::number(0.0 / 0.0).stringify() == "\"NaN\"", "NaN stringify")
  assert_true_j(MbtJson::number(1.0 / 0.0).stringify() == "\"Infinity\"", "+Inf stringify")
  assert_true_j(MbtJson::number(-1.0 / 0.0).stringify() == "\"-Infinity\"", "-Inf stringify")
  assert_true_j(mbt_json_parse("01") is Err(_), "RFC 8259 rejects leading zero")
  assert_true_j(mbt_json_parse("+1") is Err(_), "RFC 8259 rejects leading plus")
  assert_true_j(mbt_json_parse(".5") is Err(_), "RFC 8259 rejects leading dot")
  assert_true_j(mbt_json_parse("1.") is Err(_), "RFC 8259 rejects trailing dot")
  assert_true_j(mbt_json_parse("1_000") is Err(_), "RFC 8259 rejects underscore")
}

test "utf8_decode_strict, str_try_parse_int, str_try_parse_double, clamped_view, str_view" {
  let ok_b = utf8_encode("hello 世界 🚀")
  match utf8_decode_strict(ok_b) {
    Ok(s) => assert_true_j(s == "hello 世界 🚀", "strict utf8 valid")
    Err(e) => panic("expected Ok: " + e)
  }
  let bad_b = bytes_from_array([0xC0.to_byte(), 0xAF.to_byte()])
  match utf8_decode_strict(bad_b) {
    Ok(_) => panic("overlong UTF-8 must fail")
    Err(_) => ()
  }
  let trunc_b = bytes_from_array([0xE4.to_byte(), 0xB8.to_byte()])
  match utf8_decode_strict(trunc_b) {
    Ok(_) => panic("truncated UTF-8 must fail")
    Err(_) => ()
  }
  assert_true_j(str_try_parse_int("-42") is Ok(-42), "parse_int -42")
  assert_true_j(str_try_parse_int(" 42 ") is Err(_), "parse_int rejects whitespace")
  assert_true_j(str_try_parse_int("0xff") is Ok(255), "parse_int 0xff default radix=0")
  assert_true_j(str_try_parse_int("0xFF", radix=16) is Ok(255), "parse_int 0xFF radix=16")
  assert_true_j(str_try_parse_int("1_000") is Ok(1000), "parse_int 1_000 radix=0")
  assert_true_j(str_try_parse_int("0x_FF") is Ok(255), "parse_int 0x_FF radix=0")
  assert_true_j(str_try_parse_int("1_0", radix=10) is Ok(10), "parse_int 1_0 radix=10")
  assert_true_j(str_try_parse_int("0xF_F", radix=16) is Ok(255), "parse_int 0xF_F radix=16")
  assert_true_j(str_try_parse_int("_1") is Err(_) && str_try_parse_int("1_") is Err(_) && str_try_parse_int("1__0") is Err(_) && str_try_parse_int("0x__FF") is Err(_) && str_try_parse_int("0x_FF", radix=10) is Err(_), "parse_int bad underscores")
  assert_true_j(str_try_parse_int("abc") is Err(_), "parse_int invalid")
  assert_true_j(str_try_parse_int("999999999999") is Err(_), "parse_int overflow")
  match str_try_parse_double("-3.25e2") {
    Ok(v) => assert_true_j(v == -325.0, "parse_double -325.0")
    Err(e) => panic("expected Ok double: " + e)
  }
  assert_true_j(str_try_parse_double(" 1.5 ") is Err(_), "parse_double rejects whitespace")
  assert_true_j(str_try_parse_double("1e309") is Err(_), "parse_double finite overflow is Err")
  assert_true_j(str_try_parse_double("1.7976931348623159e308") is Err(_), "parse_double just above max_value is Err")
  assert_true_j(str_try_parse_double("1e9999999999") is Err(_), "parse_double huge overflow is Err")
  match str_try_parse_double("1.7976931348623157e308") {
    Ok(v) => assert_true_j(v.to_bits() == 0x7fefffffffffffffL, "parse_double max_value exact bits")
    Err(e) => panic("expected max_value Ok: " + e)
  }
  match str_try_parse_double("2.2250738585072014e-308") {
    Ok(v) => assert_true_j(v.to_bits() == 0x0010000000000000L, "parse_double min_normal exact bits")
    Err(e) => panic("expected min_normal Ok: " + e)
  }
  match str_try_parse_double("2.4703282292062328e-324") {
    Ok(v) => assert_true_j(v.to_bits() == 1L, "parse_double above subnormal midpoint -> 1 bit")
    Err(e) => panic("expected subnormal Ok: " + e)
  }
  match str_try_parse_double("2.4703282292062327e-324") {
    Ok(v) => assert_true_j(v.to_bits() == 0L, "parse_double below subnormal midpoint -> 0")
    Err(e) => panic("expected subnormal 0 Ok: " + e)
  }
  match str_try_parse_double("1_000.5") {
    Ok(v) => assert_true_j(v == 1000.5, "parse_double 1_000.5")
    Err(e) => panic("expected 1_000.5 Ok: " + e)
  }
  assert_true_j(str_try_parse_double("_1.0") is Err(_) && str_try_parse_double("1_.0") is Err(_) && str_try_parse_double("1._0") is Err(_) && str_try_parse_double("1.0_") is Err(_) && str_try_parse_double("1__0.0") is Err(_) && str_try_parse_double("1e_2") is Err(_) && str_try_parse_double("1e+_2") is Err(_) && str_try_parse_double("1e2_") is Err(_), "parse_double invalid underscores")
  match str_try_parse_double("1e-400") {
    Ok(v) => assert_true_j(v.to_bits() == 0L, "parse_double 1e-400 underflows to +0.0")
    Err(e) => panic("expected Ok 0.0: " + e)
  }
  match str_try_parse_double("-1e-400") {
    Ok(v) => assert_true_j(v.to_bits() == 0x8000000000000000UL.reinterpret_as_int64(), "parse_double -1e-400 underflows to -0.0")
    Err(e) => panic("expected Ok -0.0: " + e)
  }
  assert_true_j(str_try_parse_double("nope") is Err(_), "parse_double invalid")
  let sub = bytes_clamped_view(utf8_encode("abcdef"), start=2, end=5)
  assert_true_j(utf8_decode_lossy(sub) == "cde", "bytes_clamped_view")
  assert_true_j(str_view("a😀b", start_offset=1, end_offset=3) == "😀", "str_view utf16")
  assert_true_j(str_view("abc", start_offset=1) == "bc", "str_view default end_offset")
  assert_true_j(str_clamped_view("abc", start=1) == "bc", "str_clamped_view start=1")
  assert_true_j(str_clamped_view("abc", start=-5, end=99) == "abc", "str_clamped_view clamped")
  assert_true_j(str_clamped_view("abc", start=2, end=1) == "", "str_clamped_view empty")
  // P1-3: JSON nesting depth 513 (Ok), 1024 (Ok), 1025 (Err)
  let mk_nest = fn(d : Int) -> String {
    let sb = StringBuilder()
    let mut k = 0
    while k < d { sb.write_char('['); k = k + 1 }
    sb.write_char('0')
    k = 0
    while k < d { sb.write_char(']'); k = k + 1 }
    sb.to_string()
  }
  assert_true_j(mbt_json_parse(mk_nest(513)) is Ok(_), "json depth 513 ok")
  assert_true_j(mbt_json_parse(mk_nest(1024)) is Ok(_), "json depth 1024 ok")
  assert_true_j(mbt_json_parse(mk_nest(1025)) is Err(_), "json depth 1025 err")
}
