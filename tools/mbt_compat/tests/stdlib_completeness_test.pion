///| Unit tests for stdlib completeness additions in `mbt_compat`.

test "str_unsafe_substring handles ASCII, BMP, and surrogate pairs" {
  debug_assert(str_unsafe_substring("hello world", start=0, end=5) == "hello", "ascii prefix")
  debug_assert(str_unsafe_substring("hello world", start=6, end=11) == "world", "ascii suffix")
  debug_assert(str_unsafe_substring("hello", start=2, end=2) == "", "empty slice")
  // Emoji takes 2 UTF-16 code units: "a😀b" has UTF-16 length 4 (a:0, 😀:1..3, b:3..4)
  let s = "a😀b"
  debug_assert(str_unsafe_substring(s, start=1, end=3) == "😀", "surrogate pair")
  debug_assert(str_unsafe_substring(s, start=3, end=4) == "b", "after surrogate pair")
  debug_assert(str_unsafe_substring(s, start=1) == "😀b", "default end")
}

test "str_escape matches MoonBit String::escape with quote=true and quote=false" {
  debug_assert(str_escape("abc") == "\"abc\"", "plain ascii default quote=true")
  debug_assert(str_escape("abc", quote=true) == "\"abc\"", "explicit quote=true")
  debug_assert(str_escape("abc", quote=false) == "abc", "plain ascii quote=false")
  debug_assert(str_escape("a\"b\\c\n\r\t") == "\"a\\\"b\\\\c\\n\\r\\t\"", "common escapes quoted")
  debug_assert(str_escape("a\"b\\c\n\r\t", quote=false) == "a\\\"b\\\\c\\n\\r\\t", "common escapes unquoted")
  debug_assert(str_escape("") == "\"\"", "empty string quoted")
  debug_assert(str_escape("", quote=false) == "", "empty string unquoted")
  let ctrl = str_from_char_array([(0).unsafe_to_char(), (0x1F).unsafe_to_char()])
  debug_assert(str_escape(ctrl) == "\"\\u{00}\\u{1f}\"", "control chars hex quoted")
  debug_assert(str_escape(ctrl, quote=false) == "\\u{00}\\u{1f}", "control chars hex unquoted")
}

test "str_replace replaces only first occurrence" {
  debug_assert(str_replace("foo bar foo", old="foo", new="baz") == "baz bar foo", "first only")
  debug_assert(str_replace("aaa", old="a", new="bb") == "bbaa", "single char first only")
  debug_assert(str_replace("hello", old="xyz", new="123") == "hello", "not found")
  debug_assert(str_replace("abc", old="", new="X") == "Xabc", "empty old prepends")
  debug_assert(str_replace_all("foo bar foo", "foo", "baz") == "baz bar baz", "contrast replace_all")
}

test "str_trim drops leading and trailing chars" {
  debug_assert(str_trim("  hello  ") == "hello", "default whitespace")
  debug_assert(str_trim("\t\n hi \r\n") == "hi", "mixed whitespace")
  debug_assert(str_trim("xxhelloxx", chars="x") == "hello", "custom char")
  debug_assert(str_trim("abccba", chars="ab") == "cc", "multi char set")
  debug_assert(str_trim("xxx", chars="x") == "", "all trimmed")
  debug_assert(str_trim("", chars="x") == "", "empty input")
  debug_assert(str_trim("abc", chars="") == "abc", "empty char set")
  debug_assert(str_trim("😀hello😀", chars="😀") == "hello", "utf8 scalar trim")
}

test "int_clamp and double_clamp boundaries" {
  debug_assert(int_clamp(5, min=0, max=10) == 5, "int in range")
  debug_assert(int_clamp(-3, min=0, max=10) == 0, "int below min")
  debug_assert(int_clamp(42, min=0, max=10) == 10, "int above max")
  debug_assert(int_clamp(7, min=7, max=7) == 7, "int equal bounds")

  debug_assert(double_clamp(2.5, min=0.0, max=5.0) == 2.5, "double in range")
  debug_assert(double_clamp(-1.0, min=0.0, max=5.0) == 0.0, "double below min")
  debug_assert(double_clamp(9.0, min=0.0, max=5.0) == 5.0, "double above max")
  let nan = double_nan()
  debug_assert(double_is_nan(double_clamp(nan, min=0.0, max=5.0)), "double nan propagates")
}

test "int_until ascending, descending, inclusive, step, and overflow boundary" {
  let a = int_until(0, 4).collect()
  debug_assert(a.length() == 4 && a[0] == 0 && a[3] == 3, "0..<4")
  let b = int_until(0, 4, inclusive=true).collect()
  debug_assert(b.length() == 5 && b[4] == 4, "0..=4")
  let c = int_until(0, 10, step=3).collect()
  debug_assert(c.length() == 4 && c[0] == 0 && c[1] == 3 && c[2] == 6 && c[3] == 9, "step 3")
  let d = int_until(5, 1, step=-2).collect()
  debug_assert(d.length() == 2 && d[0] == 5 && d[1] == 3, "neg step exclusive")
  let e = int_until(5, 1, step=-2, inclusive=true).collect()
  debug_assert(e.length() == 3 && e[2] == 1, "neg step inclusive")
  debug_assert(int_until(5, 2).collect().length() == 0, "empty ascending")
  debug_assert(int_until(0, 5, step=0).collect().length() == 0, "step 0 empty")
  // Near Int::max_value: must not overflow 32-bit int
  let hi = int_until(2147483646, 2147483647, inclusive=true).collect()
  debug_assert(hi.length() == 2 && hi[0] == 2147483646 && hi[1] == 2147483647, "max_value inclusive")
  // Chaining with MbtIter::map
  let doubled = int_until(1, 4).map(fn(x : Int) -> Int { x * 2 }).collect()
  debug_assert(doubled.length() == 3 && doubled[0] == 2 && doubled[2] == 6, "iter map")
}

test "byte_to_int64 zero-extends 0..255" {
  debug_assert(byte_to_int64((0).to_byte()) == 0L, "0")
  debug_assert(byte_to_int64((127).to_byte()) == 127L, "127")
  debug_assert(byte_to_int64((128).to_byte()) == 128L, "128 unsigned")
  debug_assert(byte_to_int64((255).to_byte()) == 255L, "255 unsigned")
}

test "fixed_array_map and fixed_array_fold" {
  let fa = FixedArray::from_array([1, 2, 3, 4])
  let mapped = fixed_array_map(fa, fn(x : Int) -> Int { x * 10 })
  debug_assert(mapped.length() == 4 && mapped[0] == 10 && mapped[3] == 40, "fixed_array_map")
  let sum = fixed_array_fold(fa, 100, fn(acc : Int, x : Int) -> Int { acc + x })
  debug_assert(sum == 110, "fixed_array_fold")
  let empty : FixedArray[Int] = FixedArray::from_array([])
  debug_assert(fixed_array_map(empty, fn(x : Int) -> Int { x }).length() == 0, "empty map")
  debug_assert(fixed_array_fold(empty, 7, fn(acc : Int, x : Int) -> Int { acc + x }) == 7, "empty fold")
}

test "opt_filter and opt_unwrap_or_else" {
  let s : Option[Int] = Some(10)
  let n : Option[Int] = None
  debug_assert(opt_filter(s, fn(x : Int) -> Bool { x > 5 }) == Some(10), "filter keep")
  debug_assert(opt_filter(s, fn(x : Int) -> Bool { x > 20 }).is_none(), "filter drop")
  debug_assert(opt_filter(n, fn(_x : Int) -> Bool { true }).is_none(), "filter none")
  let mut called = false
  let v1 = opt_unwrap_or_else(s, fn() -> Int { called = true; 99 })
  debug_assert(v1 == 10 && !called, "unwrap_or_else lazy on Some")
  let v2 = opt_unwrap_or_else(n, fn() -> Int { called = true; 99 })
  debug_assert(v2 == 99 && called, "unwrap_or_else invokes on None")
}

test "arr_resize, arr_unsafe_blit_fixed, arr_unsafe_pop, arr_rev_each" {
  let xs : Array[Int] = [1, 2]
  arr_resize(xs, 5, 9)
  debug_assert(xs.length() == 5 && xs[2] == 9 && xs[4] == 9, "resize grow")
  arr_resize(xs, 3, 0)
  debug_assert(xs.length() == 3 && xs[0] == 1 && xs[2] == 9, "resize shrink")

  let src = FixedArray::from_array([10, 20, 30, 40])
  arr_unsafe_blit_fixed(xs, 1, src, 2, 2)
  debug_assert(xs[0] == 1 && xs[1] == 30 && xs[2] == 40, "unsafe_blit_fixed")
  arr_unsafe_blit_fixed(xs, 0, src, 0, 0)
  debug_assert(xs[0] == 1, "unsafe_blit_fixed len 0")

  let popped = arr_unsafe_pop(xs)
  debug_assert(popped == 40 && xs.length() == 2, "unsafe_pop")

  let rev_seen : Array[Int] = []
  arr_rev_each([1, 2, 3], fn(x : Int) -> Unit { rev_seen.push(x) })
  debug_assert(rev_seen.length() == 3 && rev_seen[0] == 3 && rev_seen[1] == 2 && rev_seen[2] == 1, "rev_each")
}

test "ordered_map_map preserves insertion order and skips tombstones" {
  let m : OrderedMap[String, Int] = ordered_map_new()
  m.set("a", 1)
  m.set("b", 2)
  m.set("c", 3)
  m.remove("b")
  let m2 = ordered_map_map(m, fn(k : String, v : Int) -> String { k + "=" + (v * 10).to_string() })
  let ks = m2.keys()
  debug_assert(ks.length() == 2 && ks[0] == "a" && ks[1] == "c", "keys preserved")
  debug_assert(m2.get("a") == Some("a=10") && m2.get("c") == Some("c=30") && m2.get("b").is_none(), "mapped values")
}

test "ordered_map_iter_lazy handles removal and compaction during iteration" {
  let m : OrderedMap[Int, Int] = ordered_map_new()
  let mut i = 0
  while i < 20 {
    m.set(i, i * 2)
    i = i + 1
  }
  let it = ordered_map_iter_lazy(m)
  let mut visited = 0
  while true {
    match (it.next)() {
      Some(e) => {
        m.remove(e.0)
        visited = visited + 1
      }
      None => break
    }
  }
  debug_assert(visited == 20 && m.size() == 0, "all 20 entries visited and removed without OOB")
}

fn generic_show[T : MbtShow](x : T) -> String {
  x.to_string()
}

fn generic_cmp[T : MbtCompare](a : T, b : T) -> Int {
  mbt_compare(a, b)
}

test "MbtShow and mbt_compare generic trait bounds" {
  debug_assert(generic_show(42) == "42", "Int show")
  debug_assert(generic_show(100L) == "100", "Int64 show")
  debug_assert(generic_show(true) == "true", "Bool show")
  debug_assert(generic_show("hi") == "hi", "String show")
  debug_assert(generic_show(1.5) == "1.5", "Double show")
  debug_assert(generic_show(Float::from_double(0.1)) == "0.1", "Float show uses shortest float_to_string")
  debug_assert(generic_show((255).to_byte()) == byte_to_string((255).to_byte()), "Byte show")
  debug_assert(generic_cmp(1, 2) < 0 && generic_cmp(2, 2) == 0 && generic_cmp(3, 2) > 0, "Int compare")
  // MoonBit String::compare is UTF-16 length-first: "z" < "aa"
  debug_assert(generic_cmp("z", "aa") < 0, "String UTF-16 length-first compare")
}

test "ordered_map_iter_lazy reflects in-place updates and OrderedMap::map survives compaction" {
  let m : OrderedMap[Int, String] = ordered_map_new()
  m.set(1, "a")
  m.set(2, "b")
  m.set(3, "c")
  let it = ordered_map_iter_lazy(m)
  let sb = StringBuilder::new()
  while true {
    match (it.next)() {
      Some((k, v)) => {
        if k == 1 {
          m.set(2, "Z")
        }
        sb.write_string(v)
      }
      None => break
    }
  }
  debug_assert(sb.to_string() == "aZc", "in-place update to unvisited key is visible")

  let m2 : OrderedMap[Int, Int] = ordered_map_new()
  let mut i = 0
  while i < 20 {
    m2.set(i, i)
    i = i + 1
  }
  let mapped = m2.map(fn(k : Int, v : Int) -> Int {
    m2.remove(k)
    v + 1
  })
  debug_assert(mapped.size() == 20 && m2.size() == 0, "OrderedMap::map survives in-callback removals without OOB")
}
