///| mbt_compat ordered_map tests (order checked against MoonBit `Map`).

fn joined(m : OrderedMap[String, Int]) -> String {
  let parts : Array[String] = []
  m.each(fn(k : String, v : Int) -> Unit { parts.push(k + "=" + v.to_string()) })
  parts.join(" ")
}

test "insertion order, overwrite keeps position, re-insert moves to end" {
  let m : OrderedMap[String, Int] = OrderedMap::new()
  m.set("zeta", 1)
  m.set("alpha", 2)
  m.set("mid", 3)
  m.set("beta", 4)
  m.set("k9", 5)
  debug_assert(m.keys().join(" ") == "zeta alpha mid beta k9", "insertion order")
  m.remove("alpha")
  m.set("alpha", 6)
  m.set("zeta", 7)
  debug_assert(joined(m) == "zeta=7 mid=3 beta=4 k9=5 alpha=6", "moonbit order")
  debug_assert(m.size() == 5, "size")
  debug_assert(m.get("mid").unwrap_or(-1) == 3, "get")
  debug_assert(m.get("nope").is_none(), "absent")
  debug_assert(m.contains("k9") && !m.contains("nope"), "contains")
  debug_assert(m.get_or_default("nope", 42) == 42, "default")
  m.remove("nope")
  debug_assert(m.size() == 5, "remove absent is a no-op")
}

test "eachi, values, to_array, clear, is_empty" {
  let m : OrderedMap[String, Int] = OrderedMap::from_array([("b", 1), ("a", 2), ("b", 3)])
  debug_assert(joined(m) == "b=3 a=2", "literal dup keeps first position")
  let seen : Array[String] = []
  m.eachi(fn(i : Int, k : String, v : Int) -> Unit { seen.push("\{i}:\{k}:\{v}") })
  debug_assert(seen.join(",") == "0:b:3,1:a:2", "eachi")
  let vs = m.values()
  debug_assert(vs.length() == 2 && vs[0] == 3 && vs[1] == 2, "values")
  let ps = m.to_array()
  debug_assert(ps[1].0 == "a" && ps[1].1 == 2, "to_array")
  debug_assert(!m.is_empty(), "not empty")
  m.clear()
  debug_assert(m.is_empty() && m.size() == 0 && m.keys().length() == 0, "cleared")
  m.set("x", 1)
  debug_assert(joined(m) == "x=1", "usable after clear")
}

test "many keys, removals and compaction keep order" {
  let m : OrderedMap[Int, Int] = OrderedMap::new()
  let mut i = 0
  while i < 1000 {
    m.set(i * 7919 % 1000, i)
    i = i + 1
  }
  debug_assert(m.size() == 1000, "1000 distinct")
  i = 0
  while i < 1000 {
    if i % 3 != 0 {
      m.remove(i)
    }
    i = i + 1
  }
  debug_assert(m.size() == 334, "kept multiples of 3")
  // Insertion order was i * 7919 % 1000 for i = 0.. ; survivors keep it.
  let ks = m.keys()
  let mut expect : Array[Int] = []
  i = 0
  while i < 1000 {
    let k = i * 7919 % 1000
    if k % 3 == 0 {
      expect.push(k)
    }
    i = i + 1
  }
  let mut same = ks.length() == expect.length()
  let mut j = 0
  while same && j < ks.length() {
    same = ks[j] == expect[j]
    j = j + 1
  }
  debug_assert(same, "order survives compaction")
  m.set(1, -1)
  debug_assert(m.keys()[m.size() - 1] == 1, "re-inserted key goes last")
  let v999 = m.get(999).unwrap_or(-1)
  debug_assert(v999 >= 0 && v999 * 7919 % 1000 == 999, "get after rebuild")
  debug_assert(m.get(998).is_none(), "removed key stays absent after rebuild")
}

enum Shape {
  Circle(Int)
  Label(String)
}

fn shape_hash(s : Shape) -> Int {
  match s {
    Circle(r) => hash_combine(1, hash_mix(r))
    Label(t) => hash_combine(2, hash_string(t))
  }
}

fn shape_eq(a : Shape, b : Shape) -> Bool {
  match (a, b) {
    (Circle(x), Circle(y)) => x == y
    (Label(x), Label(y)) => x == y
    _ => false
  }
}

test "new_by: enum and (Int, String) tuple keys" {
  let m : OrderedMap[Shape, String] = OrderedMap::new_by(shape_hash, shape_eq)
  m.set(Label("b"), "lb")
  m.set(Circle(3), "c3")
  m.set(Label("a"), "la")
  m.set(Circle(3), "c3'")
  debug_assert(m.size() == 3, "3 distinct")
  debug_assert(m.get(Circle(3)).unwrap_or("") == "c3'", "overwrite")
  debug_assert(m.values().join(",") == "lb,c3',la", "order")
  let t : OrderedMap[(Int, String), Int] = OrderedMap::new_by(
    fn(k : (Int, String)) -> Int { hash_combine(hash_mix(k.0), hash_string(k.1)) },
    fn(a : (Int, String), b : (Int, String)) -> Bool { a.0 == b.0 && a.1 == b.1 },
  )
  t.set((1, "x"), 10)
  t.set((1, "y"), 11)
  t.set((1, "x"), 12)
  debug_assert(t.size() == 2 && t.get((1, "x")).unwrap_or(0) == 12, "tuple keys")
}

test "scalar key impls" {
  let a : OrderedMap[Char, Int] = OrderedMap::new()
  a.set('z', 1)
  a.set('a', 2)
  debug_assert(a.keys()[0] == 'z', "char keys keep order")
  let b : OrderedMap[Int64, Bool] = OrderedMap::new()
  b.set(1L << 40L, true)
  debug_assert(b.get(1L << 40L).unwrap_or(false), "int64 key")
  let c : OrderedMap[UInt64, Int] = OrderedMap::new()
  c.set(18446744073709551615UL, 1)
  debug_assert(c.contains(18446744073709551615UL), "u64 key")
  let d : OrderedMap[Bool, Int] = OrderedMap::new()
  d.set(false, 0)
  d.set(true, 1)
  debug_assert(d.size() == 2, "bool keys")
}

test "ordered_map <-> Pion Map boundary" {
  let m : OrderedMap[String, Int] = ordered_map_from_array([("b", 1), ("a", 2)])
  let pm = ordered_map_to_map(m)
  debug_assert(pm.length() == 2, "size")
  debug_assert(pm.get("a").unwrap_or(0) == 2 && pm.get("b").unwrap_or(0) == 1, "entries")
  pm.set("c", 3)
  debug_assert(!m.contains("c"), "independent copy")
  let back = ordered_map_from_map(pm)
  debug_assert(back.size() == 3 && back.get("c").unwrap_or(0) == 3, "from_map")
  let im : OrderedMap[Int, String] = ordered_map_new()
  im.set(7, "x")
  im.set(-1, "y")
  let ipm = ordered_map_to_map(im)
  debug_assert(ipm.get(-1).unwrap_or("") == "y", "Int keys")
  debug_assert(ordered_map_from_map(ipm).get(7).unwrap_or("") == "x", "Int back")
}

test "live cursor observes in-place value update during iteration" {
  let m : OrderedMap[String, Int] = OrderedMap::from_array([("a", 1), ("b", 2)])
  let mut acc = 0
  let mut i = 0
  while i < m.slot_len() {
    let slot = i
    i = i + 1
    if m.slot_live(slot) {
      let k = m.slot_key(slot)
      let v = m.slot_val(slot)
      if k == "a" {
        m.set("b", 3)
      }
      acc = acc * 10 + v
    }
  }
  debug_assert(acc == 13, "live cursor must see updated value 3 for b -> 13")
}

test "MbtHash for Float matches MoonBit 32-bit float bits" {
  let f1 : Float = 1.5
  let f_pos0 : Float = 0.0
  let f_neg0 : Float = -0.0
  debug_assert(mbt_hash(f_neg0) == mbt_hash(f_pos0), "-0.0F and 0.0F must hash identically")
  let h_exp = MbtHasher::new()
  h_exp.combine_uint(0x3FC00000U)
  debug_assert(mbt_hash(f1) == h_exp.finalize(), "1.5F must hash via 32-bit IEEE-754 bits 0x3FC00000U")
  debug_assert(mbt_hash(f1) != mbt_hash(1.5), "Float hash uses 32-bit bits, not 64-bit Double bits")
}

test "pure MapKey lookup helpers and is_custom_by preservation" {
  let m : OrderedMap[String, Int] = OrderedMap::from_array([("alpha", 10), ("beta", 20)])
  debug_assert(!ordered_map_is_custom_by(m), "from_array map is not custom_by")
  debug_assert(ordered_map_get_mapkey(m, "alpha") == m.get("alpha"), "get_mapkey hit")
  debug_assert(ordered_map_get_mapkey(m, "missing") == m.get("missing"), "get_mapkey miss")
  debug_assert(ordered_map_contains_mapkey(m, "beta") == m.contains("beta"), "contains_mapkey hit")
  debug_assert(ordered_map_contains_mapkey(m, "missing") == m.contains("missing"), "contains_mapkey miss")

  let mc = m.copy()
  debug_assert(!ordered_map_is_custom_by(mc), "copy preserves is_custom_by=false")
  debug_assert(ordered_map_get_mapkey(mc, "alpha").unwrap_or(-1) == 10, "copy get_mapkey")

  let mm = m.map(fn(_k : String, v : Int) -> Int { v * 2 })
  debug_assert(!ordered_map_is_custom_by(mm), "map preserves is_custom_by=false")
  debug_assert(ordered_map_get_mapkey(mm, "beta").unwrap_or(-1) == 40, "mapped get_mapkey")

  let im : OrderedMap[Int, String] = OrderedMap::new()
  im.set(7, "seven")
  im.set(-3, "neg")
  debug_assert(ordered_map_get_mapkey(im, 7) == Some("seven"), "Int get_mapkey")
  debug_assert(ordered_map_contains_mapkey(im, -3), "Int contains_mapkey")
  debug_assert(!ordered_map_contains_mapkey(im, 99), "Int contains_mapkey miss")

  let custom : OrderedMap[String, Int] = OrderedMap::new_by(
    fn(s : String) -> Int { hash_string(s) },
    fn(a : String, b : String) -> Bool { a == b },
  )
  custom.set("k", 1)
  debug_assert(ordered_map_is_custom_by(custom), "new_by sets is_custom_by=true")
  debug_assert(ordered_map_is_custom_by(custom.copy()), "copy preserves is_custom_by=true")
  debug_assert(ordered_map_is_custom_by(custom.map(fn(_k : String, v : Int) -> Int { v + 1 })), "map preserves is_custom_by=true")

  let s : OrderedSet[String] = OrderedSet::from_array(["x", "y"])
  debug_assert(!ordered_set_is_custom_by(s), "from_array set is not custom_by")
  debug_assert(ordered_set_contains_mapkey(s, "x") == s.contains("x"), "set contains_mapkey hit")
  debug_assert(ordered_set_contains_mapkey(s, "z") == s.contains("z"), "set contains_mapkey miss")
  debug_assert(!ordered_set_is_custom_by(s.copy()), "set copy preserves is_custom_by=false")

  let s2 : OrderedSet[String] = OrderedSet::new()
  s2.add("y")
  s2.add("z")
  debug_assert(!ordered_set_is_custom_by(s.union(s2)), "union of pure sets is pure")
  debug_assert(!ordered_set_is_custom_by(s.intersection(s2)), "intersection of pure sets is pure")
  debug_assert(!ordered_set_is_custom_by(s.difference(s2)), "difference of pure sets is pure")
  debug_assert(ordered_set_contains_mapkey(s.union(s2), "z"), "union contains_mapkey")

  let cs : OrderedSet[String] = OrderedSet::new_by(
    fn(k : String) -> Int { hash_string(k) },
    fn(a : String, b : String) -> Bool { a == b },
  )
  cs.add("x")
  debug_assert(ordered_set_is_custom_by(cs), "set new_by sets is_custom_by=true")
  debug_assert(ordered_set_is_custom_by(cs.copy()), "set copy preserves is_custom_by=true")
  debug_assert(ordered_set_is_custom_by(s.union(cs)), "union with custom_by sets is_custom_by=true")
  debug_assert(ordered_set_is_custom_by(s.intersection(cs)), "intersection with custom_by sets is_custom_by=true")
  debug_assert(ordered_set_is_custom_by(s.difference(cs)), "difference with custom_by sets is_custom_by=true")
}
