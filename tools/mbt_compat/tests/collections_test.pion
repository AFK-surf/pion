///| mbt_compat collections tests.

test "map, mapi, filter, fold, each, eachi" {
  let xs = [3, 1, 2]
  debug_assert(arr_map(xs, fn(x : Int) -> String { "<\{x}>" }).join("") == "<3><1><2>", "map")
  debug_assert(arr_mapi(xs, fn(i : Int, x : Int) -> Int { i * 10 + x })[2] == 22, "mapi")
  debug_assert(arr_filter(xs, fn(x : Int) -> Bool { x != 1 }).length() == 2, "filter")
  debug_assert(arr_fold(xs, 100, fn(a : Int, x : Int) -> Int { a - x }) == 94, "fold")
  let seen : Array[Int] = []
  arr_each(xs, fn(x : Int) -> Unit { seen.push(x) })
  arr_eachi(xs, fn(i : Int, _x : Int) -> Unit { seen.push(i) })
  debug_assert(seen.length() == 6 && seen[3] == 0 && seen[5] == 2, "each/eachi")
}

test "last, insert, remove, append" {
  let xs = [1, 2, 3]
  debug_assert(arr_last(xs).unwrap_or(0) == 3, "last")
  let empty : Array[Int] = []
  debug_assert(arr_last(empty).is_none(), "last of empty")
  arr_insert(xs, 0, 0)
  arr_insert(xs, 4, 4)
  arr_insert(xs, 2, 9)
  debug_assert(arr_map(xs, fn(x : Int) -> String { x.to_string() }).join(",") == "0,1,9,2,3,4", "insert")
  debug_assert(arr_remove(xs, 2) == 9, "remove returns element")
  debug_assert(arr_remove(xs, 4) == 4 && xs.length() == 4, "remove last")
  arr_append(xs, [7, 8])
  debug_assert(xs.length() == 6 && xs[5] == 8, "append")
}

test "sort_by sorts and matches MoonBit tie order" {
  let xs = [5, 3, 9, 1, 7, 2, 8, 6, 4, 0]
  arr_sort_by(xs, fn(a : Int, b : Int) -> Int { a - b })
  let mut ok = true
  let mut i = 0
  while i < 10 {
    ok = ok && xs[i] == i
    i = i + 1
  }
  debug_assert(ok, "sorted 0..9")
  // 200 pairs (key, id) sorted by key only: big enough for the quicksort path.
  let ps : Array[(Int, Int)] = []
  i = 0
  while i < 200 {
    ps.push(((i * 37) % 11, i))
    i = i + 1
  }
  arr_sort_by(ps, fn(a : (Int, Int), b : (Int, Int)) -> Int { a.0 - b.0 })
  let mut sorted = true
  i = 1
  while i < 200 {
    sorted = sorted && ps[i - 1].0 <= ps[i].0
    i = i + 1
  }
  debug_assert(sorted, "sorted by key")
  // Tie order recorded from MoonBit `Array::sort_by` on the same input.
  let head = arr_map(ps, fn(p : (Int, Int)) -> String { p.1.to_string() })
  debug_assert(
    head.length() == 200 && head[0] == "143" && head[1] == "198" && head[2] == "11" &&
    head[6] == "99" && head[8] == "0" && head[11] == "88",
    "MoonBit tie order head 143,198,11,22,33,44,99,55,0,66,77,88",
  )
  let mut h = 0
  for p in ps {
    h = h * 31 + p.1
  }
  debug_assert(h == -1998723432, "MoonBit tie order checksum")
  // Heap-sort fallback: a comparator that never returns 0.
  let hs : Array[Int] = []
  i = 0
  while i < 100 {
    hs.push(if i % 2 == 0 { 1 } else { 0 })
    i = i + 1
  }
  arr_sort_by(hs, fn(a : Int, b : Int) -> Int { if a < b { -1 } else { 1 } })
  let mut hsorted = true
  i = 1
  while i < 100 {
    hsorted = hsorted && hs[i - 1] <= hs[i]
    i = i + 1
  }
  debug_assert(hsorted, "heap sort fallback")
}

test "option helpers and assertions" {
  let s : Option[Int] = Some(2)
  let n : Option[Int] = None
  debug_assert(opt_map(s, fn(x : Int) -> Int { x * 3 }).unwrap_or(0) == 6, "map some")
  debug_assert(opt_map(n, fn(x : Int) -> Int { x * 3 }).is_none(), "map none")
  debug_assert(opt_unwrap(s) == 2, "unwrap")
  debug_assert(opt_or(n, 7) == 7 && opt_or(s, 7) == 2, "or")
  debug_assert(opt_is_empty(n) && !opt_is_empty(s), "is_empty")
  assert_eq_by(1, 1, fn(a : Int, b : Int) -> Bool { a == b }, fn(a : Int) -> String { a.to_string() }, "t.mbt:1:1")
  assert_true(true, "t.mbt:2:1")
  assert_false(false, "t.mbt:3:1")
}

test "arr_search, arr_contains, and MbtCell" {
  let xs = [10, 20, 30, 20]
  debug_assert(arr_search(xs, 20).unwrap_or(-1) == 1, "first match index")
  debug_assert(arr_search(xs, 99).is_none(), "missing returns None")
  debug_assert(arr_contains(xs, 30) && !arr_contains(xs, 99), "contains")
  let c : MbtCell[Int] = MbtCell::{ v: 10 }
  c.v = c.v + 4
  debug_assert(c.v == 14, "MbtCell mutable box")
}
