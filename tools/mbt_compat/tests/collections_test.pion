///| mbt_compat collections tests.

test "map, mapi, filter, fold, each, eachi" {
  let xs = [3, 1, 2]
  debug_assert(arr_map(xs, fn(x : Int) -> String { "<\{x}>" }).join("") == "<3><1><2>", "map")
  debug_assert(arr_mapi(xs, fn(i : Int, x : Int) -> Int { i * 10 + x })[2] == 22, "mapi")
  debug_assert(arr_filter(xs, fn(x : Int) -> Bool { x != 1 }).length() == 2, "filter")
  debug_assert(arr_fold(xs, 100, fn(a : Int, x : Int) -> Int { a - x }) == 94, "fold")
  let seen : Array[Int] = []
  arr_each(xs, fn(x : Int) -> Unit { seen.push(x) })
  arr_eachi(xs, fn(i : Int, _x : Int) -> Unit { seen.push(i) })
  debug_assert(seen.length() == 6 && seen[3] == 0 && seen[5] == 2, "each/eachi")
}

test "last, insert, remove, append" {
  let xs = [1, 2, 3]
  debug_assert(arr_last(xs).unwrap_or(0) == 3, "last")
  let empty : Array[Int] = []
  debug_assert(arr_last(empty).is_none(), "last of empty")
  arr_insert(xs, 0, 0)
  arr_insert(xs, 4, 4)
  arr_insert(xs, 2, 9)
  debug_assert(arr_map(xs, fn(x : Int) -> String { x.to_string() }).join(",") == "0,1,9,2,3,4", "insert")
  debug_assert(arr_remove(xs, 2) == 9, "remove returns element")
  debug_assert(arr_remove(xs, 4) == 4 && xs.length() == 4, "remove last")
  arr_append(xs, [7, 8])
  debug_assert(xs.length() == 6 && xs[5] == 8, "append")
}

test "sort_by sorts and matches MoonBit tie order" {
  let xs = [5, 3, 9, 1, 7, 2, 8, 6, 4, 0]
  arr_sort_by(xs, fn(a : Int, b : Int) -> Int { a - b })
  let mut ok = true
  let mut i = 0
  while i < 10 {
    ok = ok && xs[i] == i
    i = i + 1
  }
  debug_assert(ok, "sorted 0..9")
  // 200 pairs (key, id) sorted by key only: big enough for the quicksort path.
  let ps : Array[(Int, Int)] = []
  i = 0
  while i < 200 {
    ps.push(((i * 37) % 11, i))
    i = i + 1
  }
  arr_sort_by(ps, fn(a : (Int, Int), b : (Int, Int)) -> Int { a.0 - b.0 })
  let mut sorted = true
  i = 1
  while i < 200 {
    sorted = sorted && ps[i - 1].0 <= ps[i].0
    i = i + 1
  }
  debug_assert(sorted, "sorted by key")
  // Tie order recorded from MoonBit `Array::sort_by` on the same input.
  let head = arr_map(ps, fn(p : (Int, Int)) -> String { p.1.to_string() })
  debug_assert(
    head.length() == 200 && head[0] == "143" && head[1] == "198" && head[2] == "11" &&
    head[6] == "99" && head[8] == "0" && head[11] == "88",
    "MoonBit tie order head 143,198,11,22,33,44,99,55,0,66,77,88",
  )
  let mut h = 0
  for p in ps {
    h = h * 31 + p.1
  }
  debug_assert(h == -1998723432, "MoonBit tie order checksum")
  // Heap-sort fallback: a comparator that never returns 0.
  let hs : Array[Int] = []
  i = 0
  while i < 100 {
    hs.push(if i % 2 == 0 { 1 } else { 0 })
    i = i + 1
  }
  arr_sort_by(hs, fn(a : Int, b : Int) -> Int { if a < b { -1 } else { 1 } })
  let mut hsorted = true
  i = 1
  while i < 100 {
    hsorted = hsorted && hs[i - 1] <= hs[i]
    i = i + 1
  }
  debug_assert(hsorted, "heap sort fallback")
}

test "option helpers and assertions" {
  let s : Option[Int] = Some(2)
  let n : Option[Int] = None
  debug_assert(opt_map(s, fn(x : Int) -> Int { x * 3 }).unwrap_or(0) == 6, "map some")
  debug_assert(opt_map(n, fn(x : Int) -> Int { x * 3 }).is_none(), "map none")
  debug_assert(opt_unwrap(s) == 2, "unwrap")
  debug_assert(opt_or(n, 7) == 7 && opt_or(s, 7) == 2, "or")
  debug_assert(opt_is_empty(n) && !opt_is_empty(s), "is_empty")
  assert_eq_by(1, 1, fn(a : Int, b : Int) -> Bool { a == b }, fn(a : Int) -> String { a.to_string() }, "t.mbt:1:1")
  assert_true(true, "t.mbt:2:1")
  assert_false(false, "t.mbt:3:1")
}

test "arr_search, arr_contains, and MbtCell" {
  let xs = [10, 20, 30, 20]
  debug_assert(arr_search(xs, 20).unwrap_or(-1) == 1, "first match index")
  debug_assert(arr_search(xs, 99).is_none(), "missing returns None")
  debug_assert(arr_contains(xs, 30) && !arr_contains(xs, 99), "contains")
  let c : MbtCell[Int] = MbtCell::{ v: 10 }
  c.v = c.v + 4
  debug_assert(c.v == 14, "MbtCell mutable box")
}

test "MbtIter::join" {
  let empty : Array[String] = []
  debug_assert(arr_iter(empty).join(",") == "", "join empty non-empty sep")
  debug_assert(arr_iter(empty).join("") == "", "join empty empty sep")
  debug_assert(arr_iter(["only"]).join(",") == "only", "join single non-empty sep")
  debug_assert(arr_iter(["only"]).join("") == "only", "join single empty sep")
  debug_assert(arr_iter(["a", "b", "c"]).join(",") == "a,b,c", "join multi comma")
  debug_assert(arr_iter(["a", "b", "c"]).join("") == "abc", "join multi empty sep")
  debug_assert(
    arr_iter([1, 2, 3]).map(fn(x : Int) -> String { "<\{x}>" }).join("-") == "<1>-<2>-<3>",
    "join after map",
  )
}

test "BytesBuf write_byte, write_bytesview, to_bytes, reset" {
  let b = bytes_buf_new_with_capacity(16)
  debug_assert(b.is_empty() && b.length() == 0, "empty BytesBuf")
  b.write_bytesview("hi".to_bytes())
  b.write_byte(33.to_byte())
  debug_assert(b.length() == 3 && !b.is_empty(), "BytesBuf len 3")
  let out = b.to_bytes()
  debug_assert(bytes_eq(out, "hi!".to_bytes()), "BytesBuf to_bytes")
  debug_assert(bytes_eq(b.contents(), "hi!".to_bytes()), "BytesBuf contents")
  b.reset()
  debug_assert(b.is_empty() && b.length() == 0, "BytesBuf reset")
}

test "arr_sort and fixed_array_sort for Double, Float, UInt, UInt64, Byte, Char" {
  // Double: finite, -0.0, +0.0, +Inf, -Inf, NaN
  let nan_d = 0.0 / 0.0
  let inf_d = 1.0 / 0.0
  let ninf_d = -1.0 / 0.0
  let ds : Array[Double] = [3.5, ninf_d, -0.0, 0.0, -2.5, inf_d, 1.25]
  arr_sort_double(ds)
  debug_assert(
    ds[0] == ninf_d && ds[1] == -2.5 && ds[2] == 0.0 && ds[3] == 0.0 &&
    ds[4] == 1.25 && ds[5] == 3.5 && ds[6] == inf_d,
    "arr_sort_double finite + inf + signed zeros",
  )
  let ds_nan : Array[Double] = [2.0, nan_d, -1.0]
  arr_sort_double(ds_nan)
  debug_assert(ds_nan.length() == 3, "arr_sort_double with NaN terminates cleanly")

  // Float: compare + sort with finite, -0.0, +0.0, +Inf, -Inf, NaN
  let f_neg = Float::from_double(-2.5)
  let f_nzero = Float::from_double(-0.0)
  let f_pzero = Float::from_double(0.0)
  let f_one = Float::from_double(1.25)
  let f_three = Float::from_double(3.5)
  let f_inf = Float::from_double(1.0 / 0.0)
  let f_ninf = Float::from_double(-1.0 / 0.0)
  let f_nan = Float::from_double(0.0 / 0.0)
  debug_assert(float_compare(f_neg, f_one) == -1, "float_compare <")
  debug_assert(float_compare(f_three, f_one) == 1, "float_compare >")
  debug_assert(float_compare(f_nzero, f_pzero) == 0, "float_compare -0.0 == 0.0")
  debug_assert(float_compare(f_nan, f_one) == 0 && float_compare(f_one, f_nan) == 0, "float_compare NaN == 0")
  let fs : Array[Float] = [f_three, f_inf, f_nzero, f_neg, f_ninf, f_pzero, f_one]
  arr_sort_float(fs)
  debug_assert(
    fs[0] == f_ninf && fs[1] == f_neg && fs[2] == f_pzero && fs[3] == f_pzero &&
    fs[4] == f_one && fs[5] == f_three && fs[6] == f_inf,
    "arr_sort_float",
  )
  let fs_nan : Array[Float] = [f_three, f_nan, f_neg]
  arr_sort_float(fs_nan)
  debug_assert(fs_nan.length() == 3, "arr_sort_float with NaN terminates cleanly")

  // UInt: unsigned order above 0x7fffffff
  let us : Array[UInt] = [0xffffffffU, 1U, 0x80000000U, 0U, 0x7fffffffU]
  arr_sort_uint(us)
  debug_assert(
    us[0] == 0U && us[1] == 1U && us[2] == 0x7fffffffU && us[3] == 0x80000000U && us[4] == 0xffffffffU,
    "arr_sort_uint unsigned order",
  )

  // UInt64: unsigned order above 0x7fffffffffffffff
  let u64_hi = (-1L).reinterpret_as_uint64()
  let u64_mid = (-9223372036854775807L - 1L).reinterpret_as_uint64()
  let u64_lo = 0L.reinterpret_as_uint64()
  let u64_one = 1L.reinterpret_as_uint64()
  let u64s : Array[UInt64] = [u64_hi, u64_one, u64_mid, u64_lo]
  arr_sort_uint64(u64s)
  debug_assert(
    u64s[0] == u64_lo && u64s[1] == u64_one && u64s[2] == u64_mid && u64s[3] == u64_hi,
    "arr_sort_uint64 unsigned order",
  )

  // Byte: unsigned 0..255
  let bs : Array[Byte] = [255.to_byte(), 127.to_byte(), 128.to_byte(), 0.to_byte(), 1.to_byte()]
  arr_sort_byte(bs)
  debug_assert(
    bs[0] == 0.to_byte() && bs[1] == 1.to_byte() && bs[2] == 127.to_byte() &&
    bs[3] == 128.to_byte() && bs[4] == 255.to_byte(),
    "arr_sort_byte unsigned order",
  )

  // Char: Unicode scalar order
  let cs : Array[Char] = ['z', 'a', 'M', '0']
  arr_sort_char(cs)
  debug_assert(cs[0] == '0' && cs[1] == 'M' && cs[2] == 'a' && cs[3] == 'z', "arr_sort_char")

  // FixedArray variants
  let fd : FixedArray[Double] = FixedArray::from_array([2.5, -1.0, 0.0])
  fixed_array_sort_double(fd)
  debug_assert(fd[0] == -1.0 && fd[1] == 0.0 && fd[2] == 2.5, "fixed_array_sort_double")

  let ff : FixedArray[Float] = FixedArray::from_array([f_three, f_neg, f_one])
  fixed_array_sort_float(ff)
  debug_assert(ff[0] == f_neg && ff[1] == f_one && ff[2] == f_three, "fixed_array_sort_float")

  let fu : FixedArray[UInt] = FixedArray::from_array([0xffffffffU, 0U, 0x80000000U])
  fixed_array_sort_uint(fu)
  debug_assert(fu[0] == 0U && fu[1] == 0x80000000U && fu[2] == 0xffffffffU, "fixed_array_sort_uint")

  let fu64 : FixedArray[UInt64] = FixedArray::from_array([u64_hi, u64_lo, u64_mid])
  fixed_array_sort_uint64(fu64)
  debug_assert(fu64[0] == u64_lo && fu64[1] == u64_mid && fu64[2] == u64_hi, "fixed_array_sort_uint64")

  let fb : FixedArray[Byte] = FixedArray::from_array([255.to_byte(), 0.to_byte(), 128.to_byte()])
  fixed_array_sort_byte(fb)
  debug_assert(fb[0] == 0.to_byte() && fb[1] == 128.to_byte() && fb[2] == 255.to_byte(), "fixed_array_sort_byte")

  let fc : FixedArray[Char] = FixedArray::from_array(['c', 'a', 'b'])
  fixed_array_sort_char(fc)
  debug_assert(fc[0] == 'a' && fc[1] == 'b' && fc[2] == 'c', "fixed_array_sort_char")
}
