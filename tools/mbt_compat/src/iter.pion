///| mbt_compat/iter: Lazy short-circuiting push iterator matching MoonBit `Iter[T]`.
///|
///| `run(yield_fn)` invokes `yield_fn(elem)` for each element and stops immediately
///| when `yield_fn` returns `false`, returning `false` on early stop and `true` on completion.

pub struct MbtIter[T] {
  run : ((T) -> Bool) -> Bool
}

struct IterIntCell {
  mut v : Int
}

struct IterBoolCell {
  mut v : Bool
}

/// Lazy iterator over `Array[T]`.
pub fn arr_iter[T](xs : Array[T]) -> MbtIter[T] {
  MbtIter::{
    run: fn(yield_fn : (T) -> Bool) -> Bool {
      let n = xs.length()
      let mut i = 0
      while i < n {
        if !yield_fn(xs[i]) {
          return false
        }
        i = i + 1
      }
      true
    },
  }
}

/// Lazy iterator over `FixedArray[T]`.
pub fn fixed_array_iter[T](xs : FixedArray[T]) -> MbtIter[T] {
  MbtIter::{
    run: fn(yield_fn : (T) -> Bool) -> Bool {
      let n = xs.length()
      let mut i = 0
      while i < n {
        if !yield_fn(xs[i]) {
          return false
        }
        i = i + 1
      }
      true
    },
  }
}

/// Lazy iterator over `ArrayView[T]`.
pub fn array_view_iter[T](v : ArrayView[T]) -> MbtIter[T] {
  MbtIter::{
    run: fn(yield_fn : (T) -> Bool) -> Bool {
      let n = v.length()
      let mut i = 0
      while i < n {
        if !yield_fn(v.get(i)) {
          return false
        }
        i = i + 1
      }
      true
    },
  }
}

/// Lazy iterator over Unicode scalars of `String`.
pub fn str_iter(s : String) -> MbtIter[Char] {
  MbtIter::{
    run: fn(yield_fn : (Char) -> Bool) -> Bool {
      let n = s.length()
      let mut i = 0
      while i < n {
        let l = seq_len(s, i)
        if !yield_fn(seq_scalar(s, i, l).unsafe_to_char()) {
          return false
        }
        i = i + l
      }
      true
    },
  }
}

/// Lazy iterator over live `(K, V)` entries of `OrderedMap[K, V]` in insertion order.
pub fn ordered_map_iter_lazy[K, V](m : OrderedMap[K, V]) -> MbtIter[(K, V)] {
  MbtIter::{
    run: fn(yield_fn : ((K, V)) -> Bool) -> Bool {
      let n = m.slot_len()
      let mut i = 0
      while i < n {
        if m.slot_live(i) {
          if !yield_fn((m.slot_key(i), m.slot_val(i))) {
            return false
          }
        }
        i = i + 1
      }
      true
    },
  }
}

pub fn MbtIter::map[T, U](self : MbtIter[T], f : (T) -> U) -> MbtIter[U] {
  let inner = self.run
  MbtIter::{
    run: fn(yield_fn : (U) -> Bool) -> Bool {
      inner(fn(x : T) -> Bool { yield_fn(f(x)) })
    },
  }
}

pub fn MbtIter::filter[T](self : MbtIter[T], pred : (T) -> Bool) -> MbtIter[T] {
  let inner = self.run
  MbtIter::{
    run: fn(yield_fn : (T) -> Bool) -> Bool {
      inner(fn(x : T) -> Bool { if pred(x) { yield_fn(x) } else { true } })
    },
  }
}

pub fn MbtIter::filter_map[T, U](self : MbtIter[T], f : (T) -> Option[U]) -> MbtIter[U] {
  let inner = self.run
  MbtIter::{
    run: fn(yield_fn : (U) -> Bool) -> Bool {
      inner(fn(x : T) -> Bool {
        match f(x) {
          Some(u) => yield_fn(u)
          None => true
        }
      })
    },
  }
}

pub fn MbtIter::take[T](self : MbtIter[T], n : Int) -> MbtIter[T] {
  let inner = self.run
  MbtIter::{
    run: fn(yield_fn : (T) -> Bool) -> Bool {
      if n <= 0 {
        return true
      }
      let rem = IterIntCell::{ v: n }
      inner(fn(x : T) -> Bool {
        if rem.v <= 0 {
          return false
        }
        rem.v = rem.v - 1
        if !yield_fn(x) {
          return false
        }
        rem.v > 0
      })
    },
  }
}

pub fn MbtIter::drop[T](self : MbtIter[T], n : Int) -> MbtIter[T] {
  let inner = self.run
  MbtIter::{
    run: fn(yield_fn : (T) -> Bool) -> Bool {
      let skip = IterIntCell::{ v: if n < 0 { 0 } else { n } }
      inner(fn(x : T) -> Bool {
        if skip.v > 0 {
          skip.v = skip.v - 1
          return true
        }
        yield_fn(x)
      })
    },
  }
}

pub fn MbtIter::zip[T, U](self : MbtIter[T], other : MbtIter[U]) -> MbtIter[(T, U)] {
  let lhs = self.collect()
  let rhs = other.collect()
  MbtIter::{
    run: fn(yield_fn : ((T, U)) -> Bool) -> Bool {
      let n = if lhs.length() < rhs.length() { lhs.length() } else { rhs.length() }
      let mut i = 0
      while i < n {
        if !yield_fn((lhs[i], rhs[i])) {
          return false
        }
        i = i + 1
      }
      true
    },
  }
}

pub fn MbtIter::any[T](self : MbtIter[T], pred : (T) -> Bool) -> Bool {
  let found = IterBoolCell::{ v: false }
  let _ = (self.run)(fn(x : T) -> Bool {
    if pred(x) {
      found.v = true
      return false
    }
    true
  })
  found.v
}

pub fn MbtIter::all[T](self : MbtIter[T], pred : (T) -> Bool) -> Bool {
  let ok = IterBoolCell::{ v: true }
  let _ = (self.run)(fn(x : T) -> Bool {
    if !pred(x) {
      ok.v = false
      return false
    }
    true
  })
  ok.v
}

pub fn MbtIter::fold[T, A](self : MbtIter[T], init : A, f : (A, T) -> A) -> A {
  let acc = ref_new(init)
  let _ = (self.run)(fn(x : T) -> Bool {
    acc.v = f(acc.v, x)
    true
  })
  acc.v
}

pub fn MbtIter::each[T](self : MbtIter[T], f : (T) -> Unit) -> Unit {
  let _ = (self.run)(fn(x : T) -> Bool {
    f(x)
    true
  })
}

pub fn MbtIter::collect[T](self : MbtIter[T]) -> Array[T] {
  let out : Array[T] = []
  let _ = (self.run)(fn(x : T) -> Bool {
    out.push(x)
    true
  })
  out
}

pub fn MbtIter::count[T](self : MbtIter[T]) -> Int {
  let n = IterIntCell::{ v: 0 }
  let _ = (self.run)(fn(_x : T) -> Bool {
    n.v = n.v + 1
    true
  })
  n.v
}

pub fn MbtIter::find_first[T](self : MbtIter[T], pred : (T) -> Bool) -> Option[T] {
  let found : Ref[Option[T]] = ref_new(None)
  let _ = (self.run)(fn(x : T) -> Bool {
    if pred(x) {
      found.v = Some(x)
      return false
    }
    true
  })
  found.v
}
