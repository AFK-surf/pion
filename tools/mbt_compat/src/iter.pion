///| mbt_compat/iter: Lazy short-circuiting pull iterator matching MoonBit `Iter[T]`.
///|
///| `next()` pulls the next element on demand and returns `None` when exhausted.

pub struct MbtIter[T] {
  next : () -> Option[T]
}

/// Lazy short-circuiting pull iterator over `(A, B)` pairs matching MoonBit `Iter2[A, B]`.
pub struct MbtIter2[A, B] {
  next : () -> Option[(A, B)]
}

pub fn MbtIter2::each[A, B](self : MbtIter2[A, B], f : (A, B) -> Unit) -> Unit {
  let step = self.next
  while true {
    match step() {
      Some((a, b)) => f(a, b)
      None => return
    }
  }
}

pub fn MbtIter2::to_array[A, B](self : MbtIter2[A, B]) -> Array[(A, B)] {
  let step = self.next
  let out : Array[(A, B)] = []
  while true {
    match step() {
      Some(p) => out.push(p)
      None => return out
    }
  }
  out
}

pub fn MbtIter2::collect[A, B](self : MbtIter2[A, B]) -> Array[(A, B)] {
  self.to_array()
}

pub fn MbtIter2::iter[A, B](self : MbtIter2[A, B]) -> MbtIter[(A, B)] {
  MbtIter::{ next: self.next }
}

struct IterIntCell {
  mut v : Int
}

struct IterInt64Cell {
  mut v : Int64
}

/// MoonBit `Int::until(end, step~, inclusive~)` lazy iterator.
/// Uses `Int64` internally to avoid 32-bit signed overflow near `Int::max_value`/`Int::min_value`.
pub fn int_until(
  start : Int,
  end : Int,
  step~ : Int = 1,
  inclusive~ : Bool = false,
) -> MbtIter[Int] {
  let cur = IterInt64Cell::{ v: start.to_int64() }
  let end64 = end.to_int64()
  let step64 = step.to_int64()
  MbtIter::{
    next: fn() -> Option[Int] {
      if step64 == 0L {
        return None
      }
      let c = cur.v
      if step64 > 0L {
        if inclusive {
          if c > end64 {
            return None
          }
        } else if c >= end64 {
          return None
        }
      } else if inclusive {
        if c < end64 {
          return None
        }
      } else if c <= end64 {
        return None
      }
      cur.v = c + step64
      Some(c.to_int())
    },
  }
}

/// MoonBit `Iter::new(f : () -> T?) -> Iter[T]` lazy pull iterator constructor.
pub fn mbt_iter_new[T](f : () -> Option[T]) -> MbtIter[T] {
  MbtIter::{ next: f }
}

/// MoonBit `Iter2::new(f : () -> (K, V)?) -> Iter2[K, V]` lazy pull iterator constructor.
pub fn mbt_iter2_new[K, V](f : () -> Option[(K, V)]) -> MbtIter2[K, V] {
  MbtIter2::{ next: f }
}

/// MoonBit `Iter2(it : Iter[(K, V)]) -> Iter2[K, V]` newtype constructor.
pub fn mbt_iter2_from_iter[K, V](it : MbtIter[(K, V)]) -> MbtIter2[K, V] {
  MbtIter2::{ next: it.next }
}

/// Lazy iterator over `(index, elem)` pairs of `Array[T]` (MoonBit `Array::iter2`).
pub fn arr_iter2[T](xs : Array[T]) -> MbtIter2[Int, T] {
  let pos = IterIntCell::{ v: 0 }
  let init_len = xs.length()
  MbtIter2::{
    next: fn() -> Option[(Int, T)] {
      let i = pos.v
      let limit = if init_len < xs.length() { init_len } else { xs.length() }
      if i >= limit {
        return None
      }
      pos.v = i + 1
      Some((i, xs[i]))
    },
  }
}

/// Lazy reverse iterator over `Array[T]` (MoonBit `Array::rev_iter`).
pub fn arr_rev_iter[T](xs : Array[T]) -> MbtIter[T] {
  let pos = IterIntCell::{ v: xs.length() - 1 }
  MbtIter::{
    next: fn() -> Option[T] {
      let cur_len = xs.length()
      let mut i = pos.v
      if i >= cur_len {
        i = cur_len - 1
      }
      if i < 0 {
        return None
      }
      pos.v = i - 1
      Some(xs[i])
    },
  }
}

/// Lazy reverse iterator over Unicode scalars of `String` (MoonBit `String::rev_iter`).
pub fn str_rev_iter(s : String) -> MbtIter[Char] {
  let chars = str_scalars(s)
  arr_rev_iter(chars)
}

/// Lazy iterator over `(K, V)` entries of `OrderedMap[K, V]` (MoonBit `Map::iter2`).
pub fn ordered_map_iter2[K, V](m : OrderedMap[K, V]) -> MbtIter2[K, V] {
  MbtIter2::{ next: ordered_map_iter_lazy(m).next }
}

/// Lazy iterator over `Array[T]` (snapshots initial length at creation to match MoonBit `Array::iter`).
pub fn arr_iter[T](xs : Array[T]) -> MbtIter[T] {
  let pos = IterIntCell::{ v: 0 }
  let init_len = xs.length()
  MbtIter::{
    next: fn() -> Option[T] {
      let i = pos.v
      let limit = if init_len < xs.length() { init_len } else { xs.length() }
      if i >= limit {
        return None
      }
      pos.v = i + 1
      Some(xs[i])
    },
  }
}

/// Lazy iterator over `FixedArray[T]`.
pub fn fixed_array_iter[T](xs : FixedArray[T]) -> MbtIter[T] {
  let pos = IterIntCell::{ v: 0 }
  MbtIter::{
    next: fn() -> Option[T] {
      let i = pos.v
      if i >= xs.length() {
        return None
      }
      pos.v = i + 1
      Some(xs[i])
    },
  }
}

/// Lazy iterator over `ArrayView[T]`.
pub fn array_view_iter[T](v : ArrayView[T]) -> MbtIter[T] {
  let pos = IterIntCell::{ v: 0 }
  MbtIter::{
    next: fn() -> Option[T] {
      let i = pos.v
      if i >= v.length() {
        return None
      }
      pos.v = i + 1
      Some(v.get(i))
    },
  }
}

/// Lazy iterator over Unicode scalars of `String`.
pub fn str_iter(s : String) -> MbtIter[Char] {
  let pos = IterIntCell::{ v: 0 }
  let n = s.length()
  MbtIter::{
    next: fn() -> Option[Char] {
      let i = pos.v
      if i >= n {
        return None
      }
      let l = seq_len(s, i)
      pos.v = i + l
      Some(seq_scalar(s, i, l).unsafe_to_char())
    },
  }
}

/// Lazy iterator over `(K, V)` entries of `OrderedMap[K, V]` in insertion order.
/// Snapshots live keys at iterator creation time and reads current values via `m.get(k)`
/// at visit time: reflects in-place updates to unvisited keys, skips deleted keys, and
/// never suffers out-of-bounds slot access when deletions trigger table compaction.
pub fn ordered_map_iter_lazy[K, V](m : OrderedMap[K, V]) -> MbtIter[(K, V)] {
  let ks = m.keys()
  let pos = IterIntCell::{ v: 0 }
  MbtIter::{
    next: fn() -> Option[(K, V)] {
      while pos.v < ks.length() {
        let k = ks[pos.v]
        pos.v = pos.v + 1
        match m.get(k) {
          Some(v) => return Some((k, v))
          None => ()
        }
      }
      None
    },
  }
}

/// Lazy iterator over keys of `OrderedMap[K, V]` in insertion order (MoonBit `Map::keys`).
/// Snapshots live keys at iterator creation time so deleting an unvisited key during iteration
/// preserves MoonBit `Map::keys()` callback count while still advancing lazily.
pub fn ordered_map_keys_iter[K, V](m : OrderedMap[K, V]) -> MbtIter[K] {
  let ks = m.keys()
  let pos = IterIntCell::{ v: 0 }
  let n = ks.length()
  MbtIter::{
    next: fn() -> Option[K] {
      if pos.v < n {
        let i = pos.v
        pos.v = i + 1
        Some(ks[i])
      } else {
        None
      }
    },
  }
}

/// Lazy iterator over values of `OrderedMap[K, V]` in insertion order (MoonBit `Map::values`).
/// Snapshots live keys at iterator creation time and reads current values via `m.get(k)`
/// at visit time: reflects in-place updates to unvisited keys, skips deleted keys, and
/// matches `ordered_map_iter_lazy`.
pub fn ordered_map_values_iter[K, V](m : OrderedMap[K, V]) -> MbtIter[V] {
  let ks = m.keys()
  let pos = IterIntCell::{ v: 0 }
  MbtIter::{
    next: fn() -> Option[V] {
      while pos.v < ks.length() {
        let k = ks[pos.v]
        pos.v = pos.v + 1
        match m.get(k) {
          Some(v) => return Some(v)
          None => ()
        }
      }
      None
    },
  }
}

/// Consuming alias for `Iter::next()` (MoonBit `Iter::head`): advances the iterator on each call.
pub fn MbtIter::head[T](self : MbtIter[T]) -> Option[T] {
  (self.next)()
}

pub fn MbtIter::map[T, U](self : MbtIter[T], f : (T) -> U) -> MbtIter[U] {
  let inner = self.next
  MbtIter::{
    next: fn() -> Option[U] {
      match inner() {
        Some(x) => Some(f(x))
        None => None
      }
    },
  }
}

pub fn MbtIter::filter[T](self : MbtIter[T], pred : (T) -> Bool) -> MbtIter[T] {
  let inner = self.next
  MbtIter::{
    next: fn() -> Option[T] {
      while true {
        match inner() {
          Some(x) => if pred(x) { return Some(x) }
          None => return None
        }
      }
      None
    },
  }
}

pub fn MbtIter::filter_map[T, U](self : MbtIter[T], f : (T) -> Option[U]) -> MbtIter[U] {
  let inner = self.next
  MbtIter::{
    next: fn() -> Option[U] {
      while true {
        match inner() {
          Some(x) =>
          match f(x) {
            Some(u) => return Some(u)
            None => ()
          }
          None => return None
        }
      }
      None
    },
  }
}

pub fn MbtIter::take[T](self : MbtIter[T], n : Int) -> MbtIter[T] {
  let inner = self.next
  let rem = IterIntCell::{ v: if n < 0 { 0 } else { n } }
  MbtIter::{
    next: fn() -> Option[T] {
      if rem.v <= 0 {
        return None
      }
      rem.v = rem.v - 1
      inner()
    },
  }
}

pub fn MbtIter::drop[T](self : MbtIter[T], n : Int) -> MbtIter[T] {
  let inner = self.next
  let skip = IterIntCell::{ v: if n < 0 { 0 } else { n } }
  MbtIter::{
    next: fn() -> Option[T] {
      while skip.v > 0 {
        skip.v = skip.v - 1
        match inner() {
          Some(_) => ()
          None => return None
        }
      }
      inner()
    },
  }
}

pub fn MbtIter::zip[T, U](self : MbtIter[T], other : MbtIter[U]) -> MbtIter[(T, U)] {
  let a = self.next
  let b = other.next
  MbtIter::{
    next: fn() -> Option[(T, U)] {
      match a() {
        Some(x) =>
        match b() {
          Some(y) => Some((x, y))
          None => None
        }
        None => None
      }
    },
  }
}

pub fn MbtIter::any[T](self : MbtIter[T], pred : (T) -> Bool) -> Bool {
  let step = self.next
  while true {
    match step() {
      Some(x) => if pred(x) { return true }
      None => return false
    }
  }
  false
}

pub fn MbtIter::all[T](self : MbtIter[T], pred : (T) -> Bool) -> Bool {
  let step = self.next
  while true {
    match step() {
      Some(x) => if !pred(x) { return false }
      None => return true
    }
  }
  true
}

pub fn MbtIter::fold[T, A](self : MbtIter[T], init~ : A, f : (A, T) -> A) -> A {
  let step = self.next
  let mut acc = init
  while true {
    match step() {
      Some(x) => acc = f(acc, x)
      None => return acc
    }
  }
  acc
}

pub fn MbtIter::each[T](self : MbtIter[T], f : (T) -> Unit) -> Unit {
  let step = self.next
  while true {
    match step() {
      Some(x) => f(x)
      None => return
    }
  }
}

pub fn MbtIter::collect[T](self : MbtIter[T]) -> Array[T] {
  let step = self.next
  let out : Array[T] = []
  while true {
    match step() {
      Some(x) => out.push(x)
      None => return out
    }
  }
  out
}

/// MoonBit `it.to_array()`: the same as `collect()` -- pulls the elements
/// left, in order, so a partly consumed iterator yields its rest and an
/// exhausted one (or a second call) yields `[]`.
pub fn MbtIter::to_array[T](self : MbtIter[T]) -> Array[T] {
  self.collect()
}

pub fn MbtIter::count[T](self : MbtIter[T]) -> Int {
  let step = self.next
  let mut n = 0
  while true {
    match step() {
      Some(_) => n = n + 1
      None => return n
    }
  }
  n
}

pub fn MbtIter::find_first[T](self : MbtIter[T], pred : (T) -> Bool) -> Option[T] {
  let step = self.next
  while true {
    match step() {
      Some(x) => if pred(x) { return Some(x) }
      None => return None
    }
  }
  None
}

pub fn MbtIter::join(self : MbtIter[String], sep : String) -> String {
  let step = self.next
  let sb = StringBuilder()
  let mut first = true
  while true {
    match step() {
      Some(s) => {
        if !first {
          sb.write_string(sep)
        }
        first = false
        sb.write_string(s)
      }
      None => return sb.to_string()
    }
  }
  sb.to_string()
}

/// Idempotent `Iter::iter()` returning `self`.
pub fn MbtIter::iter[T](self : MbtIter[T]) -> MbtIter[T] {
  self
}

/// Consuming `Iter::last()`: advances to the final element, or `None` if empty.
pub fn MbtIter::last[T](self : MbtIter[T]) -> Option[T] {
  let step = self.next
  let mut res : Option[T] = None
  while true {
    match step() {
      Some(x) => res = Some(x)
      None => return res
    }
  }
  res
}
