///| mbt_compat/checked_div: integer `/` and `%` with MoonBit `wasm-gc` semantics.
///|
///| Reference oracle: `moon run --target wasm-gc` (the Wasm `div`/`rem`
///| instructions). Raw Pion `/` and `%` differ by target: ARM64 native returns
///| `0` for a zero divisor and `MIN` for `MIN / -1`, x86_64 raises SIGFPE, and
///| `wasm32` traps. These helpers give one behaviour on every Pion target:
///|   - `x / 0`        panics `divide by zero`              (Wasm trap)
///|   - `x % 0`        panics `remainder by zero`           (Wasm trap)
///|   - `MIN / -1`     panics `divide result unrepresentable` (signed only)
///|   - `MIN % -1`     returns `0`                          (no trap in Wasm)
///|   - otherwise      truncating division, remainder has the dividend's sign.
///| A divisor statically known to be non-zero (and not `-1` for signed `/`)
///| may keep the raw operator; everything else goes through these helpers.

/// Diverges like MoonBit's division-by-zero trap; usable at any type.
pub fn trap_div_zero[T]() -> T {
  panic("divide by zero")
}

/// Diverges like MoonBit's remainder-by-zero trap; usable at any type.
pub fn trap_rem_zero[T]() -> T {
  panic("remainder by zero")
}

/// Diverges like MoonBit's signed `MIN / -1` trap; usable at any type.
pub fn trap_div_overflow[T]() -> T {
  panic("divide result unrepresentable")
}

/// `Int` (32-bit signed) `a / b`.
pub fn div_checked_i32(a : Int, b : Int) -> Int {
  if b == 0 {
    return trap_div_zero()
  }
  if b == -1 {
    if a == -2147483648 {
      return trap_div_overflow()
    }
    return -a
  }
  a / b
}

/// `Int` (32-bit signed) `a % b`.
pub fn mod_checked_i32(a : Int, b : Int) -> Int {
  if b == 0 {
    return trap_rem_zero()
  }
  if b == -1 {
    return 0
  }
  a % b
}

/// `Int64` `a / b`.
pub fn div_checked_i64(a : Int64, b : Int64) -> Int64 {
  if b == 0L {
    return trap_div_zero()
  }
  if b == -1L {
    if a == -9223372036854775807L - 1L {
      return trap_div_overflow()
    }
    return -a
  }
  a / b
}

/// `Int64` `a % b`.
pub fn mod_checked_i64(a : Int64, b : Int64) -> Int64 {
  if b == 0L {
    return trap_rem_zero()
  }
  if b == -1L {
    return 0L
  }
  a % b
}

/// `UInt` `a / b`.
pub fn div_checked_u32(a : UInt, b : UInt) -> UInt {
  if b == 0U {
    return trap_div_zero()
  }
  a / b
}

/// `UInt` `a % b`.
pub fn mod_checked_u32(a : UInt, b : UInt) -> UInt {
  if b == 0U {
    return trap_rem_zero()
  }
  a % b
}

/// `UInt64` `a / b`.
pub fn div_checked_u64(a : UInt64, b : UInt64) -> UInt64 {
  if b == 0UL {
    return trap_div_zero()
  }
  a / b
}

/// `UInt64` `a % b`.
pub fn mod_checked_u64(a : UInt64, b : UInt64) -> UInt64 {
  if b == 0UL {
    return trap_rem_zero()
  }
  a % b
}

/// `Byte` `a / b` (unsigned 8-bit).
pub fn div_checked_byte(a : Byte, b : Byte) -> Byte {
  if b == b'\x00' {
    return trap_div_zero()
  }
  (a.to_int() / b.to_int()).to_byte()
}

/// `Byte` `a % b` (unsigned 8-bit).
pub fn mod_checked_byte(a : Byte, b : Byte) -> Byte {
  if b == b'\x00' {
    return trap_rem_zero()
  }
  (a.to_int() % b.to_int()).to_byte()
}
