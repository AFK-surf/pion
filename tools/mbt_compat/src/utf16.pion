///| mbt_compat/utf16: MoonBit string semantics on top of Pion's UTF-8 `String`.
///|
///| MoonBit strings are UTF-16: `length()`, `code_unit_at`, slicing and offsets
///| count UTF-16 code units, while `for i, ch in s` counts Unicode scalars.
///| Pion strings are UTF-8 bytes. The helpers below walk the UTF-8 bytes and
///| report positions in the unit the caller asks for:
///|   - `utf16`  : UTF-16 code units (a scalar >= U+10000 takes 2 units),
///|   - `utf8`   : bytes of the Pion string,
///|   - `scalar` : Unicode scalar values (Pion `Char`).
///|
///| Malformed UTF-8 (only reachable through `\xHH` escapes or raw bytes) is
///| decoded one byte at a time as U+FFFD, one UTF-16 unit per byte, so every
///| function is total and all of them agree on the same decoding.
///|
///| Failure behaviour mirrors MoonBit:
///|   - `utf16_code_unit_at` out of range panics (MoonBit traps),
///|   - `utf16_exact_view` panics on a bad range or a split surrogate pair
///|     (MoonBit `String::exact_view` aborts),
///|   - `utf16_slice` clamps and moves split pairs inward (MoonBit `s[a:b]`,
///|     `String::clamped_view`).

/// Byte length of the UTF-8 sequence starting at byte `i` (1 for a malformed
/// or truncated sequence, which then decodes as U+FFFD).
fn seq_len(s : String, i : Int) -> Int {
  let n = s.length()
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    return 1
  }
  let want = if b0 >= 0xC2 && b0 <= 0xDF {
    2
  } else if b0 >= 0xE0 && b0 <= 0xEF {
    3
  } else if b0 >= 0xF0 && b0 <= 0xF4 {
    4
  } else {
    0
  }
  if want == 0 || i + want > n {
    return 1
  }
  let b1 = s.code_unit_at(i + 1)
  // Second-byte ranges exclude overlong forms, surrogates and > U+10FFFF.
  let lo = if b0 == 0xE0 {
    0xA0
  } else if b0 == 0xF0 {
    0x90
  } else {
    0x80
  }
  let hi = if b0 == 0xED {
    0x9F
  } else if b0 == 0xF4 {
    0x8F
  } else {
    0xBF
  }
  if b1 < lo || b1 > hi {
    return 1
  }
  let mut k = 2
  while k < want {
    let bk = s.code_unit_at(i + k)
    if bk < 0x80 || bk > 0xBF {
      return 1
    }
    k = k + 1
  }
  want
}

/// Scalar value of the sequence of byte length `n` starting at byte `i`.
fn seq_scalar(s : String, i : Int, n : Int) -> Int {
  let b0 = s.code_unit_at(i)
  if n == 1 {
    if b0 < 0x80 {
      return b0
    }
    return 0xFFFD
  }
  if n == 2 {
    return ((b0 & 0x1F) << 6) | (s.code_unit_at(i + 1) & 0x3F)
  }
  if n == 3 {
    return ((b0 & 0x0F) << 12) |
    ((s.code_unit_at(i + 1) & 0x3F) << 6) |
    (s.code_unit_at(i + 2) & 0x3F)
  }
  ((b0 & 0x07) << 18) |
  ((s.code_unit_at(i + 1) & 0x3F) << 12) |
  ((s.code_unit_at(i + 2) & 0x3F) << 6) |
  (s.code_unit_at(i + 3) & 0x3F)
}

/// UTF-16 width (1 or 2) of the sequence of byte length `n`.
fn seq_units(n : Int) -> Int {
  if n == 4 {
    2
  } else {
    1
  }
}

// ---------------------------------------------------------------------------
// Index cache. MoonBit code indexes strings in loops such as
//   for i = 0; i < s.length(); i = i + 1 { ... s[i] ... }
// which translates to `utf16_len(s)` / `utf16_code_unit_at(s, i)` per step.
// A plain UTF-8 scan makes every call O(n) and the loop O(n^2) (seconds on a
// 40K string). Strings of at least `U16_CACHE_MIN` bytes therefore get an
// index built once in O(n): their UTF-16 length, whether they are pure ASCII
// (then unit i is byte i), and for other strings the byte/unit position of
// the scalar holding every `U16_CK`-th unit, so a lookup walks at most
// `U16_CK` units. The last `U16_CACHE_SLOTS` indexed strings are kept in a
// process-wide cache behind a `Mutex`, keyed by the string's data address and
// byte length. Each entry holds a reference to its string, so that address
// cannot be freed and reused by another string while the entry exists, and
// strings are immutable: a key match is always the same string.

let U16_CACHE_MIN : Int = 64

let U16_CK : Int = 32

let U16_CACHE_SLOTS : Int = 4

struct U16Index {
  s : String
  addr : Int64
  nbytes : Int
  units : Int
  ascii : Bool
  ck_byte : Array[Int]
  ck_unit : Array[Int]
}

struct U16Cache {
  entries : Array[U16Index]
  mut next : Int
}

let U16_CACHE : Mutex[U16Cache] = Mutex::new(U16Cache::{ entries: [], next: 0 })

fn u16_build(s : String, addr : Int64) -> U16Index {
  let n = s.length()
  let ck_byte : Array[Int] = []
  let ck_unit : Array[Int] = []
  let mut ascii = true
  let mut i = 0
  let mut u = 0
  while i < n {
    let b = s.code_unit_at(i)
    let l = if b < 0x80 { 1 } else { seq_len(s, i) }
    if b >= 0x80 {
      ascii = false
    }
    let w = seq_units(l)
    // Checkpoints whose unit falls in [u, u + w) start at this scalar.
    while ck_byte.length() * U16_CK < u + w {
      ck_byte.push(i)
      ck_unit.push(u)
    }
    u = u + w
    i = i + l
  }
  U16Index::{ s, addr, nbytes: n, units: u, ascii, ck_byte, ck_unit }
}

/// The cached index of `s` (built and inserted on a miss).
fn u16_index(s : String) -> U16Index {
  let addr = ptr_addr(str_data_ptr(s))
  let n = s.length()
  U16_CACHE.with_lock(fn(c : U16Cache) -> U16Index {
    for e in c.entries {
      if e.addr == addr && e.nbytes == n {
        return e
      }
    }
    let e = u16_build(s, addr)
    if c.entries.length() < U16_CACHE_SLOTS {
      c.entries.push(e)
    } else {
      c.entries[c.next] = e
      c.next = (c.next + 1) % U16_CACHE_SLOTS
    }
    e
  })
}

fn utf16_len_scan(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut units = 0
  while i < n {
    if s.code_unit_at(i) < 0x80 {
      i = i + 1
      units = units + 1
    } else {
      let l = seq_len(s, i)
      i = i + l
      units = units + seq_units(l)
    }
  }
  units
}

/// Code unit `idx` walking from byte `i0` / unit `u0` (a scalar start).
fn code_unit_from(s : String, idx : Int, i0 : Int, u0 : Int) -> Int {
  let n = s.length()
  let mut i = i0
  let mut u = u0
  while i < n {
    let l = seq_len(s, i)
    let c = seq_scalar(s, i, l)
    if l == 4 {
      if u == idx {
        return 0xD800 + ((c - 0x10000) >> 10)
      }
      if u + 1 == idx {
        return 0xDC00 + ((c - 0x10000) & 0x3FF)
      }
      u = u + 2
    } else {
      if u == idx {
        return c
      }
      u = u + 1
    }
    i = i + l
  }
  panic("index out of bounds: utf16_code_unit_at(\{idx}), length \{u}")
}

/// MoonBit `String::length()`: number of UTF-16 code units. O(1) after the
/// first call on a string of >= 64 bytes (see the index cache above).
pub fn utf16_len(s : String) -> Int {
  if s.length() < U16_CACHE_MIN {
    return utf16_len_scan(s)
  }
  u16_index(s).units
}

/// MoonBit `String::code_unit_at(idx)` / `s[idx]`: the UTF-16 code unit at
/// `idx` (surrogate halves for scalars >= U+10000). Panics when `idx` is out
/// of `0..<utf16_len(s)`. O(1) for indexed ASCII strings, at most 32 units of
/// walking for other indexed strings.
pub fn utf16_code_unit_at(s : String, idx : Int) -> Int {
  if idx < 0 {
    panic("index out of bounds: utf16_code_unit_at(\{idx})")
  }
  if s.length() < U16_CACHE_MIN {
    return code_unit_from(s, idx, 0, 0)
  }
  let e = u16_index(s)
  if idx >= e.units {
    panic("index out of bounds: utf16_code_unit_at(\{idx}), length \{e.units}")
  }
  if e.ascii {
    return s.code_unit_at(idx)
  }
  let c = idx / U16_CK
  code_unit_from(s, idx, e.ck_byte[c], e.ck_unit[c])
}

/// Every UTF-16 code unit of `s`, in order (one O(n) pass, no cache): for a
/// loop hoisted by the translator, or when many strings are indexed in turn
/// (the index cache keeps only the last 4).
pub fn utf16_units(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let l = seq_len(s, i)
    let c = seq_scalar(s, i, l)
    if l == 4 {
      out.push(0xD800 + ((c - 0x10000) >> 10))
      out.push(0xDC00 + ((c - 0x10000) & 0x3FF))
    } else {
      out.push(c)
    }
    i = i + l
  }
  out
}

/// Byte offset of UTF-16 offset `utf16_off` (`0..=utf16_len(s)`). An offset
/// that falls between the two halves of a surrogate pair maps to the start of
/// that scalar. Panics when the offset is out of range.
pub fn utf16_to_utf8_off(s : String, utf16_off : Int) -> Int {
  if utf16_off < 0 {
    panic("index out of bounds: utf16_to_utf8_off(\{utf16_off})")
  }
  let n = s.length()
  let mut i = 0
  let mut u = 0
  while i < n {
    if u == utf16_off {
      return i
    }
    let l = seq_len(s, i)
    let w = seq_units(l)
    if u + w > utf16_off {
      return i
    }
    u = u + w
    i = i + l
  }
  if u == utf16_off {
    return n
  }
  panic("index out of bounds: utf16_to_utf8_off(\{utf16_off}), length \{u}")
}

/// UTF-16 offset of byte offset `utf8_off` (`0..=s.length()`). A byte offset
/// inside a multi-byte sequence maps to the start of that scalar. Panics when
/// the offset is out of range.
pub fn utf8_to_utf16_off(s : String, utf8_off : Int) -> Int {
  let n = s.length()
  if utf8_off < 0 || utf8_off > n {
    panic("index out of bounds: utf8_to_utf16_off(\{utf8_off}), length \{n}")
  }
  let mut i = 0
  let mut u = 0
  while i < n {
    let l = seq_len(s, i)
    if i + l > utf8_off {
      return u
    }
    u = u + seq_units(l)
    i = i + l
  }
  u
}

/// Scalar index of byte offset `utf8_off`; inner bytes map to their scalar.
pub fn utf8_to_scalar_off(s : String, utf8_off : Int) -> Int {
  let n = s.length()
  if utf8_off < 0 || utf8_off > n {
    panic("index out of bounds: utf8_to_scalar_off(\{utf8_off}), length \{n}")
  }
  let mut i = 0
  let mut k = 0
  while i < n {
    let l = seq_len(s, i)
    if i + l > utf8_off {
      return k
    }
    k = k + 1
    i = i + l
  }
  k
}

/// Byte offset of scalar index `scalar_off` (`0..=scalar count`).
pub fn scalar_to_utf8_off(s : String, scalar_off : Int) -> Int {
  if scalar_off < 0 {
    panic("index out of bounds: scalar_to_utf8_off(\{scalar_off})")
  }
  let n = s.length()
  let mut i = 0
  let mut k = 0
  while i < n {
    if k == scalar_off {
      return i
    }
    i = i + seq_len(s, i)
    k = k + 1
  }
  if k == scalar_off {
    return n
  }
  panic("index out of bounds: scalar_to_utf8_off(\{scalar_off}), count \{k}")
}

/// Scalar index of UTF-16 offset `utf16_off` (`0..=utf16_len(s)`). An offset
/// between the two halves of a surrogate pair maps to that scalar (floor), as
/// in `utf16_to_utf8_off`. Panics when the offset is out of range.
pub fn utf16_to_scalar_off(s : String, utf16_off : Int) -> Int {
  if utf16_off < 0 {
    panic("index out of bounds: utf16_to_scalar_off(\{utf16_off})")
  }
  let n = s.length()
  let mut i = 0
  let mut u = 0
  let mut k = 0
  while i < n {
    if u == utf16_off {
      return k
    }
    let l = seq_len(s, i)
    let w = seq_units(l)
    if u + w > utf16_off {
      return k
    }
    u = u + w
    i = i + l
    k = k + 1
  }
  if u == utf16_off {
    return k
  }
  panic("index out of bounds: utf16_to_scalar_off(\{utf16_off}), length \{u}")
}

/// UTF-16 offset of scalar index `scalar_off` (`0..=scalar count`). Panics
/// when the index is out of range.
pub fn scalar_to_utf16_off(s : String, scalar_off : Int) -> Int {
  if scalar_off < 0 {
    panic("index out of bounds: scalar_to_utf16_off(\{scalar_off})")
  }
  let n = s.length()
  let mut i = 0
  let mut u = 0
  let mut k = 0
  while i < n {
    if k == scalar_off {
      return u
    }
    let l = seq_len(s, i)
    u = u + seq_units(l)
    i = i + l
    k = k + 1
  }
  if k == scalar_off {
    return u
  }
  panic("index out of bounds: scalar_to_utf16_off(\{scalar_off}), count \{k}")
}

/// Number of Unicode scalars (MoonBit `String::char_length()`).
pub fn scalar_len(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut k = 0
  while i < n {
    i = i + seq_len(s, i)
    k = k + 1
  }
  k
}

fn is_trailing_at(s : String, u : Int) -> Bool {
  let c = utf16_code_unit_at(s, u)
  c >= 0xDC00 && c <= 0xDFFF
}

fn is_leading_at(s : String, u : Int) -> Bool {
  let c = utf16_code_unit_at(s, u)
  c >= 0xD800 && c <= 0xDBFF
}

/// Copy of the bytes between two UTF-16 offsets that are not inside a pair.
fn utf16_copy(s : String, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  let b0 = utf16_to_utf8_off(s, start)
  let b1 = utf16_to_utf8_off(s, end)
  let sb = StringBuilder::with_capacity(b1 - b0)
  sb.write_substring(s, b0, b1)
  sb.to_string()
}

/// MoonBit `s[start:end]` (`String::clamped_view`), owned: offsets are clamped
/// to `0..=len`, an interior start inside a surrogate pair moves forward past
/// the pair, an interior end inside a pair moves back before it, and an empty
/// or inverted range yields `""`.
pub fn utf16_slice(s : String, start : Int, end : Int) -> String {
  let len = utf16_len(s)
  let lo = if start <= 0 {
    0
  } else if start >= len {
    len
  } else if is_trailing_at(s, start) && is_leading_at(s, start - 1) {
    start + 1
  } else {
    start
  }
  let hi = if end <= 0 {
    0
  } else if end >= len {
    len
  } else if is_trailing_at(s, end) && is_leading_at(s, end - 1) {
    end - 1
  } else {
    end
  }
  if lo >= hi {
    return ""
  }
  utf16_copy(s, lo, hi)
}

/// MoonBit `s[start:]`.
pub fn utf16_slice_from(s : String, start : Int) -> String {
  utf16_slice(s, start, utf16_len(s))
}

/// MoonBit `String::exact_view(start~, end~)`, owned: panics unless
/// `0 <= start <= end <= len` and neither bound lands on a trailing surrogate.
pub fn utf16_exact_view(s : String, start : Int, end : Int) -> String {
  let len = utf16_len(s)
  if !(start >= 0 && start <= end && end <= len) {
    panic("abort: utf16_exact_view(\{start}, \{end}) out of bounds, length \{len}")
  }
  if start < len && is_trailing_at(s, start) {
    panic("abort: utf16_exact_view start \{start} splits a surrogate pair")
  }
  if end < len && is_trailing_at(s, end) {
    panic("abort: utf16_exact_view end \{end} splits a surrogate pair")
  }
  utf16_copy(s, start, end)
}

/// MoonBit `String::get_view`, owned: `None` where `utf16_exact_view` panics.
pub fn utf16_get_view(s : String, start : Int, end : Int) -> Option[String] {
  let len = utf16_len(s)
  if !(start >= 0 && start <= end && end <= len) {
    return None
  }
  if start < len && is_trailing_at(s, start) {
    return None
  }
  if end < len && is_trailing_at(s, end) {
    return None
  }
  Some(utf16_copy(s, start, end))
}

/// MoonBit `for i, ch in s { ... }`: calls `f` with the scalar index
/// (0, 1, 2, ...) and the scalar of every character in order.
pub fn str_iter_scalar_indexed(s : String, f : (Int, Char) -> Unit) -> Unit {
  let n = s.length()
  let mut i = 0
  let mut k = 0
  while i < n {
    let l = seq_len(s, i)
    f(k, seq_scalar(s, i, l).unsafe_to_char())
    k = k + 1
    i = i + l
  }
}

/// Scalars of `s` in order (MoonBit `s.to_array()` / `s.iter().collect()`).
pub fn str_scalars(s : String) -> Array[Char] {
  let out : Array[Char] = []
  str_iter_scalar_indexed(s, fn(_i : Int, c : Char) -> Unit { out.push(c) })
  out
}

/// MoonBit `String::compare` (`<`, `sort()`, `Compare`): the shorter string
/// in UTF-16 units is smaller; equal lengths compare UTF-16 code units in
/// order. Differs from byte order twice: `"k9" < "alpha"`, and `"😀"`
/// (D83D DE00) < `"！！"` (FF01 FF01) although its UTF-8 bytes are larger.
/// Returns -1, 0 or 1.
pub fn str_compare(a : String, b : String) -> Int {
  if a == b {
    return 0
  }
  let la = utf16_len(a)
  let lb = utf16_len(b)
  if la != lb {
    return if la < lb { -1 } else { 1 }
  }
  let ua = utf16_units(a)
  let ub = utf16_units(b)
  let mut i = 0
  while i < la {
    if ua[i] != ub[i] {
      return if ua[i] < ub[i] { -1 } else { 1 }
    }
    i = i + 1
  }
  0
}

/// Identity helper when a MoonBit `StringView` slice lowered to `String` calls `.to_owned()`.
pub fn str_to_owned(s : String) -> String {
  s
}

/// MoonBit `String::has_prefix`. For well-formed strings the UTF-16 and UTF-8
/// prefix relations coincide, so this compares bytes.
pub fn str_has_prefix(s : String, prefix : String) -> Bool {
  s.starts_with(prefix)
}

/// MoonBit `String::has_suffix` (byte comparison, see `str_has_prefix`).
pub fn str_has_suffix(s : String, suffix : String) -> Bool {
  s.ends_with(suffix)
}

/// MoonBit `String::to_lower`: ASCII `A`-`Z` only, every other character
/// (including non-ASCII letters such as `Ä`) is kept as is.
pub fn str_to_lower(s : String) -> String {
  let n = s.length()
  let mut first = -1
  let mut i = 0
  while i < n && first < 0 {
    let b = s.code_unit_at(i)
    if b >= 0x41 && b <= 0x5A {
      first = i
    }
    i = i + 1
  }
  if first < 0 {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  sb.write_substring(s, 0, first)
  let mut j = first
  while j < n {
    let b = s.code_unit_at(j)
    if b >= 0x41 && b <= 0x5A {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    j = j + 1
  }
  sb.to_string()
}

/// MoonBit `String::to_upper`: ASCII `a`-`z` only.
pub fn str_to_upper(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::with_capacity(n)
  let mut j = 0
  while j < n {
    let b = s.code_unit_at(j)
    if b >= 0x61 && b <= 0x7A {
      sb.write_byte((b - 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    j = j + 1
  }
  sb.to_string()
}

/// Raw UTF-8 byte length for explicit cursor loops (`for ch in s`) without triggering `.length()` probing.
pub fn str_byte_len(s : String) -> Int {
  s.length()
}

/// Decode one Unicode scalar at UTF-8 byte offset `byte_pos`, returning `(scalar, next_byte_pos)`.
pub fn str_cursor_step(s : String, byte_pos : Int) -> (Char, Int) {
  let l = seq_len(s, byte_pos)
  let c = seq_scalar(s, byte_pos, l).unsafe_to_char()
  (c, byte_pos + l)
}

/// MoonBit `String::rev_find(needle)`: UTF-16 code-unit offset of the last occurrence of `needle`, or `None`.
pub fn str_rev_find(s : String, needle : String) -> Option[Int] {
  let n = s.length()
  let m = needle.length()
  if m == 0 {
    return Some(utf16_len(s))
  }
  if m > n {
    return None
  }
  let mut i = n - m
  while i >= 0 {
    let mut matched = true
    let mut k = 0
    while k < m {
      if s.code_unit_at(i + k) != needle.code_unit_at(k) {
        matched = false
        break
      }
      k = k + 1
    }
    if matched {
      return Some(utf8_to_utf16_off(s, i))
    }
    i = i - 1
  }
  None
}

/// MoonBit `String::lexical_compare`: lexicographic UTF-16 code-unit comparison (-1, 0, 1).
pub fn str_lexical_compare(a : String, b : String) -> Int {
  if a == b {
    return 0
  }
  let ua = utf16_units(a)
  let ub = utf16_units(b)
  let la = ua.length()
  let lb = ub.length()
  let n = if la < lb { la } else { lb }
  let mut i = 0
  while i < n {
    if ua[i] != ub[i] {
      return if ua[i] < ub[i] { -1 } else { 1 }
    }
    i = i + 1
  }
  if la < lb {
    -1
  } else if la > lb {
    1
  } else {
    0
  }
}

/// MoonBit `String::from_array(chars : Array[Char]) -> String`.
pub fn str_from_char_array(chars : Array[Char]) -> String {
  let sb = StringBuilder::with_capacity(chars.length())
  for c in chars {
    sb.write_char(c)
  }
  sb.to_string()
}

/// MoonBit `Char::is_ascii_digit`.
pub fn char_is_ascii_digit(c : Char) -> Bool {
  let n = c.to_int()
  n >= 48 && n <= 57
}

/// MoonBit `Char::to_ascii_lowercase`.
pub fn char_to_ascii_lowercase(c : Char) -> Char {
  let n = c.to_int()
  if n >= 65 && n <= 90 {
    (n + 32).unsafe_to_char()
  } else {
    c
  }
}

/// MoonBit `Int::unsafe_to_char`.
pub fn int_unsafe_to_char(n : Int) -> Char {
  n.unsafe_to_char()
}

/// MoonBit `String::replace_all(old~, new~)`.
pub fn str_replace_all(s : String, old : String, new_ : String) -> String {
  s.replace(old, new_)
}

/// MoonBit `String::replace(old~, new~)`: replaces only the first occurrence of `old` with `new`.
pub fn str_replace(s : String, old~ : String = "", new~ : String = "") -> String {
  if old.length() == 0 {
    return new + s
  }
  let idx = s.index_of(old)
  if idx < 0 {
    return s
  }
  s.slice(0, idx) + new + s.slice(idx + old.length(), s.length())
}

/// MoonBit `String::unsafe_substring(start~, end~)`: UTF-16 code-unit slice.
/// Note: Pion `String` enforces valid UTF-8 and cannot represent lone surrogates,
/// so slicing inside a surrogate pair fails closed with a panic (consistent with `str_exact_view`).
pub fn str_unsafe_substring(s : String, start~ : Int = 0, end~ : Int = -1) -> String {
  let e = if end < 0 { utf16_len(s) } else { end }
  utf16_exact_view(s, start, e)
}

/// MoonBit `String::escape(quote~)`: escaped string matching MoonBit core.
/// When `quote=true` (default), wraps the output in double quotes `"..."`;
/// when `quote=false`, omits the surrounding double quotes.
pub fn str_escape(s : String, quote~ : Bool = true) -> String {
  let escaped = debug_string(s)
  if quote {
    escaped
  } else {
    escaped.slice(1, escaped.length() - 1)
  }
}

/// MoonBit `String::trim_start(chars~)` / `StringView::trim_start(chars~)`: drops
/// leading Unicode scalars that occur in `chars` (default ASCII whitespace).
pub fn str_trim_start(s : String, chars~ : String = " \t\n\r") -> String {
  let n = s.length()
  let m = chars.length()
  let mut start = 0
  while start < n {
    let l = seq_len(s, start)
    let c = seq_scalar(s, start, l)
    let mut in_set = false
    let mut j = 0
    while j < m && !in_set {
      let lj = seq_len(chars, j)
      if seq_scalar(chars, j, lj) == c {
        in_set = true
      }
      j = j + lj
    }
    if !in_set {
      break
    }
    start = start + l
  }
  if start == 0 { s } else { s.slice(start, n) }
}

/// MoonBit `String::trim(chars~)` / `StringView::trim(chars~)`: drops leading and
/// trailing Unicode scalars that occur in `chars`.
pub fn str_trim(s : String, chars~ : String = " \t\n\r") -> String {
  str_trim_end(str_trim_start(s, chars=chars), chars=chars)
}

/// MoonBit `String::strip_prefix(prefix) -> Option[String]`.
pub fn str_strip_prefix(s : String, prefix : String) -> Option[String] {
  if s.starts_with(prefix) {
    Some(s.slice(prefix.length(), s.length()))
  } else {
    None
  }
}

/// MoonBit `String::exact_view(start~, end~)` with optional named bounds.
pub fn str_exact_view(s : String, start~ : Int = 0, end~ : Int = -1) -> String {
  let e = if end < 0 { utf16_len(s) } else { end }
  utf16_exact_view(s, start, e)
}

/// MoonBit `String::find(sub) -> Option[Int]` (returns UTF-16 code unit offset).
pub fn str_find(s : String, sub : String) -> Option[Int] {
  let byte_idx = s.index_of(sub)
  if byte_idx < 0 {
    None
  } else {
    Some(utf8_to_utf16_off(s, byte_idx))
  }
}

/// MoonBit `String::trim_end(chars~)` / `StringView::trim_end(chars~)`: drops
/// the trailing characters (Unicode scalars, not bytes) that occur in `chars`.
pub fn str_trim_end(s : String, chars~ : String = " \t\n\r") -> String {
  let n = s.length()
  let m = chars.length()
  let mut keep = 0
  let mut i = 0
  while i < n {
    let l = seq_len(s, i)
    let c = seq_scalar(s, i, l)
    let mut in_set = false
    let mut j = 0
    while j < m && !in_set {
      let lj = seq_len(chars, j)
      if seq_scalar(chars, j, lj) == c {
        in_set = true
      }
      j = j + lj
    }
    if !in_set {
      keep = i + l
    }
    i = i + l
  }
  if keep == n { s } else { s.slice(0, keep) }
}

/// MoonBit `String::contains_char(c) -> Bool`.
pub fn str_contains_char(s : String, c : Char) -> Bool {
  let target = c.to_int()
  let n = s.length()
  let mut i = 0
  while i < n {
    let l = seq_len(s, i)
    if seq_scalar(s, i, l) == target {
      return true
    }
    i = i + l
  }
  false
}

/// MoonBit `String::is_empty() -> Bool`.
pub fn str_is_empty(s : String) -> Bool {
  s.length() == 0
}

/// MoonBit `String::rev() -> String`: reverses Unicode scalar values (`Char`), keeping surrogate pairs intact.
pub fn str_rev(s : String) -> String {
  let chars = str_scalars(s)
  let sb = StringBuilder()
  let mut i = chars.length() - 1
  while i >= 0 {
    sb.write_char(chars[i])
    i = i - 1
  }
  sb.to_string()
}

/// MoonBit `String::repeat(n) -> String` (aborts on `n < 0`; returns `""` for `n == 0` or empty `s`).
pub fn str_repeat(s : String, n : Int) -> String {
  if n < 0 {
    panic("abort: negative repeat count")
  }
  if n == 0 || s.length() == 0 {
    return ""
  }
  let sb = StringBuilder()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

/// MoonBit `String::contains_code_unit(u) -> Bool`: matches exact UTF-16 code unit `u`.
pub fn str_contains_code_unit(s : String, u : Int) -> Bool {
  if u < 0 || u > 0xFFFF {
    return false
  }
  let n = s.length()
  let mut i = 0
  while i < n {
    let l = seq_len(s, i)
    let cp = seq_scalar(s, i, l)
    if cp <= 0xFFFF {
      if cp == u {
        return true
      }
    } else {
      let adj = cp - 0x10000
      let hi = 0xD800 + (adj >> 10)
      let lo = 0xDC00 + (adj & 0x3FF)
      if hi == u || lo == u {
        return true
      }
    }
    i = i + l
  }
  false
}

/// MoonBit `String::get_char(i) -> Option[Char]` (at UTF-16 offset `i`).
pub fn str_get_char(s : String, i : Int) -> Option[Char] {
  let len = utf16_len(s)
  if i < 0 || i >= len {
    return None
  }
  let u = utf16_code_unit_at(s, i)
  if u >= 0xD800 && u <= 0xDBFF {
    if i + 1 < len {
      let lo = utf16_code_unit_at(s, i + 1)
      if lo >= 0xDC00 && lo <= 0xDFFF {
        let cp = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00)
        return Some(cp.unsafe_to_char())
      }
    }
    return None
  }
  if u >= 0xDC00 && u <= 0xDFFF {
    return None
  }
  Some(u.unsafe_to_char())
}

/// MoonBit `@utf8.encode(s)`: returns the UTF-8 bytes of `s`.
pub fn utf8_encode(s : String) -> Bytes {
  let n = s.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  out
}

/// MoonBit `@string.parse_int(s)`: parses a base-10 signed integer.
pub fn str_parse_int(s : String) -> Int {
  let t = s.trim()
  let n = t.length()
  if n == 0 {
    panic("abort: parse_int empty string")
  }
  let mut i = 0
  let mut neg = false
  if t.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if t.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    panic("abort: parse_int invalid integer")
  }
  let mut acc : Int64 = 0L
  while i < n {
    let c = t.code_unit_at(i)
    if c == 95 {
      i = i + 1
      continue
    }
    if c < 48 || c > 57 {
      panic("abort: parse_int invalid digit")
    }
    acc = acc * 10L + (c - 48).to_int64()
    i = i + 1
  }
  if neg { (-acc).to_int() } else { acc.to_int() }
}

/// Format a single hex digit (lowercase).
fn hex_nibble_lower(v : Int) -> Char {
  let d = v & 0xF
  if d < 10 { (48 + d).unsafe_to_char() } else { (87 + d).unsafe_to_char() }
}

/// Write `width` lowercase hex digits of `cp` into `sb` (`width` in {2, 4, 6}).
fn write_hex_padded(sb : StringBuilder, cp : Int, width : Int) -> Unit {
  if width >= 6 {
    sb.write_char(hex_nibble_lower(cp >> 20))
    sb.write_char(hex_nibble_lower(cp >> 16))
  }
  if width >= 4 {
    sb.write_char(hex_nibble_lower(cp >> 12))
    sb.write_char(hex_nibble_lower(cp >> 8))
  }
  sb.write_char(hex_nibble_lower(cp >> 4))
  sb.write_char(hex_nibble_lower(cp))
}

/// Exact port of MoonBit `Char::is_printable`.
fn char_is_printable(cp : Int) -> Bool {
  if cp < 0x20 || (cp >= 0x7F && cp <= 0x9F) {
    return false
  }
  if (cp >= 0xE000 && cp <= 0xF8FF) || (cp >= 0xF0000 && cp <= 0xFFFFD) || (cp >= 0x100000 && cp <= 0x10FFFD) {
    return false
  }
  if cp >= 0xD800 && cp <= 0xDFFF {
    return false
  }
  if cp == 0x2028 || cp == 0x2029 {
    return false
  }
  if (cp >= 0xFDD0 && cp <= 0xFDEF) || ((cp & 0xFFFF) >= 0xFFFE) {
    return false
  }
  if cp == 0x00AD || (cp >= 0x0600 && cp <= 0x0605) || cp == 0x061C || cp == 0x06DD ||
  cp == 0x070F || cp == 0x0890 || cp == 0x0891 || cp == 0x08E2 || cp == 0x180E ||
  (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x202A && cp <= 0x202E) ||
  (cp >= 0x2060 && cp <= 0x2064) || (cp >= 0x2066 && cp <= 0x206F) ||
  cp == 0xFEFF || (cp >= 0xFFF9 && cp <= 0xFFFB) ||
  cp == 0x110BD || cp == 0x110CD || (cp >= 0x13430 && cp <= 0x1343F) ||
  (cp >= 0x1BCA0 && cp <= 0x1BCA3) || (cp >= 0x1D173 && cp <= 0x1D17A) ||
  cp == 0xE0001 || (cp >= 0xE0020 && cp <= 0xE007F) {
    return false
  }
  true
}

/// MoonBit `Debug` / `String::escape` formatting for `String` (double-quoted).
/// Matches `~/.moon/lib/core/builtin/show.mbt`: `"`/`\`/`\n`/`\r`/`\b`/`\t` escaped,
/// `cp < 0x20` (including `0x00`) formatted as `\u{XX}` (2 lowercase hex digits),
/// `cp >= 0x20` (including `0x7F` DEL and all non-ASCII) emitted verbatim.
pub fn debug_string(s : String) -> String {
  let sb = StringBuilder::with_capacity(s.length() + 2)
  sb.write_char('"')
  let n = s.length()
  let mut i = 0
  while i < n {
    let l = seq_len(s, i)
    let cp = seq_scalar(s, i, l)
    if cp == 92 {
      sb.write_string("\\\\")
    } else if cp == 34 {
      sb.write_string("\\\"")
    } else if cp == 10 {
      sb.write_string("\\n")
    } else if cp == 13 {
      sb.write_string("\\r")
    } else if cp == 8 {
      sb.write_string("\\b")
    } else if cp == 9 {
      sb.write_string("\\t")
    } else if cp < 0x20 {
      sb.write_string("\\u{")
      write_hex_padded(sb, cp, 2)
      sb.write_char('}')
    } else {
      sb.write_char(cp.unsafe_to_char())
    }
    i = i + l
  }
  sb.write_char('"')
  sb.to_string()
}

/// MoonBit `Debug` / `Char::escape` formatting for `Char` (single-quoted).
/// Matches `~/.moon/lib/core/builtin/char.mbt`: `'`/`\`/`\n`/`\r`/`\b`/`\t` escaped,
/// printable scalars emitted verbatim, non-printable formatted as `\u{HEX}` (2/4/6 lowercase hex digits).
pub fn debug_char(c : Char) -> String {
  let sb = StringBuilder::with_capacity(12)
  sb.write_char('\'')
  let cp = c.to_int()
  if cp == 92 {
    sb.write_string("\\\\")
  } else if cp == 39 {
    sb.write_string("\\'")
  } else if cp == 10 {
    sb.write_string("\\n")
  } else if cp == 13 {
    sb.write_string("\\r")
  } else if cp == 8 {
    sb.write_string("\\b")
  } else if cp == 9 {
    sb.write_string("\\t")
  } else if cp >= 0x20 && cp <= 0x7E {
    sb.write_char(c)
  } else if !char_is_printable(cp) {
    sb.write_string("\\u{")
    let width = if cp <= 0xFF { 2 } else if cp <= 0xFFFF { 4 } else { 6 }
    write_hex_padded(sb, cp, width)
    sb.write_char('}')
  } else {
    sb.write_char(c)
  }
  sb.write_char('\'')
  sb.to_string()
}

/// MoonBit `@utf8.decode_lossy(bytes, ignore_bom~)`: decodes UTF-8 bytes per Unicode
/// Table 3-7 / WHATWG maximal subpart rule, replacing each invalid maximal subpart with one U+FFFD.
pub fn utf8_decode_lossy(b : Bytes, ignore_bom~ : Bool = false) -> String {
  let n = b.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  if ignore_bom && n >= 3 && b[0].to_int() == 0xEF && b[1].to_int() == 0xBB && b[2].to_int() == 0xBF {
    i = 3
  }
  while i < n {
    let b0 = b[i].to_int()
    if b0 < 0x80 {
      sb.write_byte(b[i])
      i = i + 1
      continue
    }
    let want = if b0 >= 0xC2 && b0 <= 0xDF {
      2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      4
    } else {
      0
    }
    if want == 0 {
      sb.write_char('\u{FFFD}')
      i = i + 1
      continue
    }
    let lo = if b0 == 0xE0 {
      0xA0
    } else if b0 == 0xF0 {
      0x90
    } else {
      0x80
    }
    let hi = if b0 == 0xED {
      0x9F
    } else if b0 == 0xF4 {
      0x8F
    } else {
      0xBF
    }
    let mut valid_len = 1
    if i + 1 < n {
      let b1 = b[i + 1].to_int()
      if b1 >= lo && b1 <= hi {
        valid_len = 2
        while valid_len < want && i + valid_len < n {
          let bk = b[i + valid_len].to_int()
          if bk >= 0x80 && bk <= 0xBF {
            valid_len = valid_len + 1
          } else {
            break
          }
        }
      }
    }
    if valid_len == want {
      let mut j = 0
      while j < want {
        sb.write_byte(b[i + j])
        j = j + 1
      }
      i = i + want
    } else {
      sb.write_char('\u{FFFD}')
      i = i + valid_len
    }
  }
  sb.to_string()
}

/// MoonBit `@utf8.decode(bytes, ignore_bom~)`: strict UTF-8 decoder per Unicode Table 3-7.
/// Returns `Err(...)` on any ill-formed byte sequence; `Ok(s)` when completely valid.
pub fn utf8_decode_strict(b : Bytes, ignore_bom~ : Bool = false) -> Result[String, String] {
  let n = b.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  if ignore_bom && n >= 3 && b[0].to_int() == 0xEF && b[1].to_int() == 0xBB && b[2].to_int() == 0xBF {
    i = 3
  }
  while i < n {
    let b0 = b[i].to_int()
    if b0 < 0x80 {
      sb.write_byte(b[i])
      i = i + 1
      continue
    }
    let want = if b0 >= 0xC2 && b0 <= 0xDF {
      2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      4
    } else {
      0
    }
    if want == 0 || i + want > n {
      return Err("invalid UTF-8 at offset " + i.to_string())
    }
    let lo = if b0 == 0xE0 {
      0xA0
    } else if b0 == 0xF0 {
      0x90
    } else {
      0x80
    }
    let hi = if b0 == 0xED {
      0x9F
    } else if b0 == 0xF4 {
      0x8F
    } else {
      0xBF
    }
    let b1 = b[i + 1].to_int()
    if b1 < lo || b1 > hi {
      return Err("invalid UTF-8 continuation at offset " + (i + 1).to_string())
    }
    let mut k = 2
    while k < want {
      let bk = b[i + k].to_int()
      if bk < 0x80 || bk > 0xBF {
        return Err("invalid UTF-8 continuation at offset " + (i + k).to_string())
      }
      k = k + 1
    }
    let mut j = 0
    while j < want {
      sb.write_byte(b[i + j])
      j = j + 1
    }
    i = i + want
  }
  Ok(sb.to_string())
}

/// MoonBit `String::clamped_view(start~, end~)` lowered to clamped UTF-16 slice
/// (clamps out-of-bounds indices to `[0, len]`, shrinks split surrogates inward, returns `""` when `lo >= hi`).
pub fn str_clamped_view(s : String, start~ : Int = 0, end~ : Int = 2147483647) -> String {
  let len = utf16_len(s)
  let lo = if start < 0 { 0 } else if start > len { len } else { start }
  let hi = if end < 0 { 0 } else if end > len { len } else { end }
  if lo >= hi {
    return ""
  }
  // Shrink inward if `lo` lands on a low surrogate or `hi` lands after a high surrogate
  let mut adj_lo = lo
  if adj_lo > 0 && adj_lo < len {
    let u = utf16_code_unit_at(s, adj_lo)
    if u >= 0xDC00 && u <= 0xDFFF {
      let prev = utf16_code_unit_at(s, adj_lo - 1)
      if prev >= 0xD800 && prev <= 0xDBFF {
        adj_lo = adj_lo + 1
      }
    }
  }
  let mut adj_hi = hi
  if adj_hi > 0 && adj_hi < len {
    let prev = utf16_code_unit_at(s, adj_hi - 1)
    if prev >= 0xD800 && prev <= 0xDBFF {
      let nxt = utf16_code_unit_at(s, adj_hi)
      if nxt >= 0xDC00 && nxt <= 0xDFFF {
        adj_hi = adj_hi - 1
      }
    }
  }
  if adj_lo >= adj_hi {
    return ""
  }
  utf16_slice(s, adj_lo, adj_hi)
}

/// MoonBit `String::view(start_offset~, end_offset~)` exact UTF-16 view.
/// Panics with `"Invalid index for View"` on negative or out-of-bounds indices.
pub fn str_view(s : String, start_offset~ : Int = 0, end_offset~ : Int = 2147483647) -> String {
  let len = utf16_len(s)
  let e = if end_offset == 2147483647 { len } else { end_offset }
  if start_offset < 0 || e < 0 || start_offset > e || e > len {
    panic("Invalid index for View")
  }
  utf16_exact_view(s, start_offset, e)
}

/// MoonBit `@string.parse_int(s, base~)` / `@strconv.parse_int(s, base~)` non-panicking `Result` form.
/// Matches MoonBit core `strconv_int.mbt`:
/// - Does NOT trim leading/trailing whitespace (`" 42 "` -> `Err`).
/// - Default `radix = 0` auto-detects `0x`/`0X`, `0o`/`0O`, `0b`/`0B` (else 10); explicit `radix` 16/8/2
///   also accepts its own `0x`/`0o`/`0b` prefix.
/// - Underscore `_` is allowed in ALL radixes between digits or immediately after a consumed base prefix
///   (`"0x_FF"`, `"1_0"`), never leading/trailing/consecutive.
pub fn str_try_parse_int(s : String, radix~ : Int = 0) -> Result[Int, String] {
  let n = s.length()
  if n == 0 {
    return Err("parse_int: empty string")
  }
  let mut i = 0
  let mut neg = false
  let first_c = s.code_unit_at(0)
  if first_c == 45 {
    neg = true
    i = 1
  } else if first_c == 43 {
    i = 1
  }
  let mut allow_underscore = false
  let mut base = radix
  if base == 0 {
    if i + 2 <= n && s.code_unit_at(i) == 48 {
      let p = s.code_unit_at(i + 1)
      if p == 120 || p == 88 {
        base = 16
        i = i + 2
        allow_underscore = true
      } else if p == 111 || p == 79 {
        base = 8
        i = i + 2
        allow_underscore = true
      } else if p == 98 || p == 66 {
        base = 2
        i = i + 2
        allow_underscore = true
      } else {
        base = 10
      }
    } else {
      base = 10
    }
  } else if base == 16 && i + 2 <= n && s.code_unit_at(i) == 48 && (s.code_unit_at(i + 1) == 120 || s.code_unit_at(i + 1) == 88) {
    i = i + 2
    allow_underscore = true
  } else if base == 8 && i + 2 <= n && s.code_unit_at(i) == 48 && (s.code_unit_at(i + 1) == 111 || s.code_unit_at(i + 1) == 79) {
    i = i + 2
    allow_underscore = true
  } else if base == 2 && i + 2 <= n && s.code_unit_at(i) == 48 && (s.code_unit_at(i + 1) == 98 || s.code_unit_at(i + 1) == 66) {
    i = i + 2
    allow_underscore = true
  }
  if base < 2 || base > 36 {
    return Err("parse_int: invalid base")
  }
  if i >= n {
    return Err("parse_int: no digits")
  }
  let mut acc : Int64 = 0L
  let mut seen_digit = false
  let mut prev_underscore = false
  let r64 = base.to_int64()
  while i < n {
    let c = s.code_unit_at(i)
    if c == 95 {
      if !allow_underscore || prev_underscore {
        return Err("parse_int: invalid underscore")
      }
      prev_underscore = true
      allow_underscore = false
      i = i + 1
      continue
    }
    let d = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 97 && c <= 122 {
      c - 87
    } else if c >= 65 && c <= 90 {
      c - 55
    } else {
      -1
    }
    if d < 0 || d >= base {
      return Err("parse_int: invalid digit")
    }
    seen_digit = true
    prev_underscore = false
    allow_underscore = true
    acc = acc * r64 + d.to_int64()
    if neg {
      if acc > 2147483648L {
        return Err("parse_int: overflow")
      }
    } else if acc > 2147483647L {
      return Err("parse_int: overflow")
    }
    i = i + 1
  }
  if !seen_digit || prev_underscore {
    return Err("parse_int: invalid integer")
  }
  if neg { Ok((-acc).to_int()) } else { Ok(acc.to_int()) }
}

/// MoonBit `String::split(sep).next()` -> `Option[String]`.
/// Matches `moonbitlang/core/builtin/string_methods.mbt`:
/// - `sep == ""`: `None` when `s == ""`, else `Some` of the first Unicode scalar as a `String`.
/// - `sep != ""`: `Some(s.slice(0, idx))` if `sep` occurs at byte offset `idx`, else `Some(s)`.
pub fn str_split_first(s : String, sep : String) -> Option[String] {
  if sep.length() == 0 {
    if s.length() == 0 {
      return None
    }
    let l = seq_len(s, 0)
    let sb = StringBuilder::with_capacity(l)
    sb.write_char(seq_scalar(s, 0, l).unsafe_to_char())
    return Some(sb.to_string())
  }
  let idx = s.index_of(sep)
  if idx < 0 {
    Some(s)
  } else {
    Some(s.slice(0, idx))
  }
}
