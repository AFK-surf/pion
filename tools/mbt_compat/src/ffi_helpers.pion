///| Unshadowable C-ABI FFI bridge primitives for `mbt2pion` generated wrappers.
///| Calling these via `mbt_compat::mbt_ffi_*` ensures user-defined functions with
///| matching names (e.g. `fn cstr_to_str`) can never hijack bridged FFI wrappers.

pub fn mbt_ffi_cstr_to_str(p : Ptr) -> String {
  cstr_to_str(p)
}

pub fn mbt_ffi_ptr_null() -> Ptr {
  ptr_null()
}

pub fn mbt_ffi_ptr_is_null(p : Ptr) -> Bool {
  ptr_is_null(p)
}

pub fn mbt_ffi_ptr_alloc(n : Int64) -> Ptr {
  ptr_alloc(n)
}

pub fn mbt_ffi_ptr_free(p : Ptr) -> Unit {
  ptr_free(p)
}

pub fn mbt_ffi_ptr_write_i32(p : Ptr, off : Int64, v : Int) -> Unit {
  ptr_write_i32(p, off, v)
}

pub fn mbt_ffi_ptr_read_i32(p : Ptr, off : Int64) -> Int {
  ptr_read_i32(p, off)
}

pub fn mbt_ffi_bytes_copy_to_ptr(b : Bytes, off : Int, dst : Ptr, len : Int) -> Unit {
  bytes_copy_to_ptr(b, off, dst, len)
}

pub fn mbt_ffi_bytes_from_ptr(p : Ptr, len : Int) -> Bytes {
  bytes_from_ptr(p, len)
}

fn mbt_ffi_checked_alloc_elems(len : Int, elem_size : Int64) -> Ptr {
  if len <= 0 {
    return ptr_null()
  }
  let n = len.to_int64()
  let max_i64 = 9223372036854775807L
  if elem_size <= 0L || n > max_i64 / elem_size {
    panic("mbt_ffi: buffer size overflow")
  }
  let p = ptr_alloc(n * elem_size)
  if ptr_is_null(p) {
    panic("mbt_ffi: buffer allocation failed")
  }
  p
}

pub fn mbt_ffi_fixed_array_double_to_ptr(arr : FixedArray[Double]) -> Ptr {
  let len = arr.length()
  if len <= 0 {
    return ptr_null()
  }
  let p = mbt_ffi_checked_alloc_elems(len, 8L)
  let mut i = 0
  while i < len {
    ptr_write_f64(p, i.to_int64() * 8L, arr[i])
    i = i + 1
  }
  p
}

pub fn mbt_ffi_fixed_array_double_from_ptr(arr : FixedArray[Double], p : Ptr) -> Unit {
  if ptr_is_null(p) {
    return
  }
  let len = arr.length()
  let mut i = 0
  while i < len {
    arr[i] = ptr_read_f64(p, i.to_int64() * 8L)
    i = i + 1
  }
}

pub fn mbt_ffi_fixed_array_int_to_ptr(arr : FixedArray[Int]) -> Ptr {
  let len = arr.length()
  if len <= 0 {
    return ptr_null()
  }
  let p = mbt_ffi_checked_alloc_elems(len, 4L)
  let mut i = 0
  while i < len {
    ptr_write_i32(p, i.to_int64() * 4L, arr[i])
    i = i + 1
  }
  p
}

pub fn mbt_ffi_fixed_array_int_from_ptr(arr : FixedArray[Int], p : Ptr) -> Unit {
  if ptr_is_null(p) {
    return
  }
  let len = arr.length()
  let mut i = 0
  while i < len {
    arr[i] = ptr_read_i32(p, i.to_int64() * 4L)
    i = i + 1
  }
}

pub fn mbt_ffi_fixed_array_byte_to_ptr(arr : FixedArray[Byte]) -> Ptr {
  let len = arr.length()
  if len <= 0 {
    return ptr_null()
  }
  let p = mbt_ffi_checked_alloc_elems(len, 1L)
  let mut i = 0
  while i < len {
    ptr_write_u8(p, i.to_int64(), arr[i].to_int())
    i = i + 1
  }
  p
}

pub fn mbt_ffi_fixed_array_byte_from_ptr(arr : FixedArray[Byte], p : Ptr) -> Unit {
  if ptr_is_null(p) {
    return
  }
  let len = arr.length()
  let mut i = 0
  while i < len {
    arr[i] = ptr_read_u8(p, i.to_int64()).to_byte()
    i = i + 1
  }
}

pub fn mbt_ffi_fixed_array_float_to_ptr(arr : FixedArray[Float]) -> Ptr {
  let len = arr.length()
  if len <= 0 {
    return ptr_null()
  }
  let p = mbt_ffi_checked_alloc_elems(len, 4L)
  let mut i = 0
  while i < len {
    // Write little-endian f32 bytes via uint8_t stores so C11 effective type stays unset until C reads as float*.
    let bits = arr[i].to_bits()
    let base = i.to_int64() * 4L
    ptr_write_u8(p, base, bits & 255)
    ptr_write_u8(p, base + 1L, (bits >> 8) & 255)
    ptr_write_u8(p, base + 2L, (bits >> 16) & 255)
    ptr_write_u8(p, base + 3L, (bits >> 24) & 255)
    i = i + 1
  }
  p
}

pub fn mbt_ffi_fixed_array_float_from_ptr(arr : FixedArray[Float], p : Ptr) -> Unit {
  if ptr_is_null(p) {
    return
  }
  let len = arr.length()
  let mut i = 0
  while i < len {
    arr[i] = Float::from_bits(ptr_read_i32(p, i.to_int64() * 4L))
    i = i + 1
  }
}

pub fn mbt_ffi_fixed_array_int64_to_ptr(arr : FixedArray[Int64]) -> Ptr {
  let len = arr.length()
  if len <= 0 {
    return ptr_null()
  }
  let p = mbt_ffi_checked_alloc_elems(len, 8L)
  let mut i = 0
  while i < len {
    ptr_write_i64(p, i.to_int64() * 8L, arr[i])
    i = i + 1
  }
  p
}

pub fn mbt_ffi_fixed_array_int64_from_ptr(arr : FixedArray[Int64], p : Ptr) -> Unit {
  if ptr_is_null(p) {
    return
  }
  let len = arr.length()
  let mut i = 0
  while i < len {
    arr[i] = ptr_read_i64(p, i.to_int64() * 8L)
    i = i + 1
  }
}
