///| mbt_compat/mbt_json: MoonBit `Json` semantic compatibility layer.
///| Preserves exact `repr` for unsafe integers and overflowing numbers, and
///| formats non-finite `Double` values (`"NaN"`, `"Infinity"`, `"-Infinity"`)
///| identically to MoonBit `moonbitlang/core/json`.

pub enum MbtJson {
  Null
  True
  False
  Number(Double, Option[String])
  String(String)
  Array(Array[MbtJson])
  Object(OrderedMap[String, MbtJson])
}

pub fn MbtJson::null() -> MbtJson {
  MbtJson::Null
}

pub fn MbtJson::boolean(b : Bool) -> MbtJson {
  if b {
    MbtJson::True
  } else {
    MbtJson::False
  }
}

pub fn MbtJson::number(d : Double, repr~ : Option[String] = None) -> MbtJson {
  MbtJson::Number(d, repr)
}

pub fn MbtJson::string(s : String) -> MbtJson {
  MbtJson::String(s)
}

pub fn MbtJson::array(xs : Array[MbtJson]) -> MbtJson {
  MbtJson::Array(xs)
}

pub fn MbtJson::object(m : OrderedMap[String, MbtJson]) -> MbtJson {
  MbtJson::Object(m)
}

fn mbt_json_hex_lower(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (87 + n).unsafe_to_char()
  }
}

fn write_json_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_char('"')
  let n = s.length()
  let mut run_start = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 34 || c == 92 || c < 32 {
      sb.write_string(s.slice(run_start, i))
      if c == 34 {
        sb.write_string("\\\"")
      } else if c == 92 {
        sb.write_string("\\\\")
      } else if c == 10 {
        sb.write_string("\\n")
      } else if c == 13 {
        sb.write_string("\\r")
      } else if c == 9 {
        sb.write_string("\\t")
      } else if c == 8 {
        sb.write_string("\\b")
      } else if c == 12 {
        sb.write_string("\\f")
      } else {
        sb.write_string("\\u00")
        sb.write_char(mbt_json_hex_lower(c / 16))
        sb.write_char(mbt_json_hex_lower(c % 16))
      }
      run_start = i + 1
    }
    i = i + 1
  }
  sb.write_string(s.slice(run_start, n))
  sb.write_char('"')
}

fn write_mbt_json(sb : StringBuilder, v : MbtJson) -> Unit {
  match v {
    MbtJson::Null => sb.write_string("null")
    MbtJson::True => sb.write_string("true")
    MbtJson::False => sb.write_string("false")
    MbtJson::Number(d, repr) =>
    match repr {
      Some(r) => sb.write_string(r)
      None =>
      if d != d {
        sb.write_string("\"NaN\"")
      } else if d - d != 0.0 {
        if d > 0.0 {
          sb.write_string("\"Infinity\"")
        } else {
          sb.write_string("\"-Infinity\"")
        }
      } else {
        sb.write_string(double_to_string(d))
      }
    }
    MbtJson::String(s) => write_json_string(sb, s)
    MbtJson::Array(xs) => {
      sb.write_char('[')
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          sb.write_char(',')
        }
        write_mbt_json(sb, xs[i])
        i = i + 1
      }
      sb.write_char(']')
    }
    MbtJson::Object(m) => {
      sb.write_char('{')
      let mut first = true
      let mut i = 0
      let n = m.slot_len()
      while i < n {
        if m.slot_live(i) {
          if !first {
            sb.write_char(',')
          }
          first = false
          write_json_string(sb, m.slot_key(i))
          sb.write_char(':')
          write_mbt_json(sb, m.slot_val(i))
        }
        i = i + 1
      }
      sb.write_char('}')
    }
  }
}

pub fn MbtJson::stringify(self : MbtJson) -> String {
  let sb = StringBuilder()
  write_mbt_json(sb, self)
  sb.to_string()
}

struct MbtJsonParser {
  s : String
  n : Int
  mut pos : Int
}

fn jp_skip_ws(p : MbtJsonParser) -> Unit {
  while p.pos < p.n {
    let c = p.s.code_unit_at(p.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      p.pos = p.pos + 1
    } else {
      break
    }
  }
}

fn jp_hex_digit(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

fn jp_parse_hex4(p : MbtJsonParser) -> Result[Int, String] {
  if p.pos + 4 > p.n {
    return Err("json: incomplete unicode escape")
  }
  let mut v = 0
  let mut k = 0
  while k < 4 {
    let d = jp_hex_digit(p.s.code_unit_at(p.pos + k))
    if d < 0 {
      return Err("json: invalid hex digit in unicode escape")
    }
    v = (v << 4) | d
    k = k + 1
  }
  p.pos = p.pos + 4
  Ok(v)
}

fn jp_parse_string(p : MbtJsonParser) -> Result[String, String] {
  if p.pos >= p.n || p.s.code_unit_at(p.pos) != 34 {
    return Err("json: expected string")
  }
  p.pos = p.pos + 1
  let sb = StringBuilder()
  while p.pos < p.n {
    let c = p.s.code_unit_at(p.pos)
    if c == 34 {
      p.pos = p.pos + 1
      return Ok(sb.to_string())
    }
    if c < 32 {
      return Err("json: unescaped control character")
    }
    if c == 92 {
      p.pos = p.pos + 1
      if p.pos >= p.n {
        return Err("json: unterminated escape")
      }
      let esc = p.s.code_unit_at(p.pos)
      p.pos = p.pos + 1
      if esc == 34 {
        sb.write_char('"')
      } else if esc == 92 {
        sb.write_char('\\')
      } else if esc == 47 {
        sb.write_char('/')
      } else if esc == 98 {
        sb.write_byte(8.to_byte())
      } else if esc == 102 {
        sb.write_byte(12.to_byte())
      } else if esc == 110 {
        sb.write_char('\n')
      } else if esc == 114 {
        sb.write_char('\r')
      } else if esc == 116 {
        sb.write_char('\t')
      } else if esc == 117 {
        match jp_parse_hex4(p) {
          Err(e) => return Err(e)
          Ok(u) =>
          if u >= 0xD800 && u <= 0xDBFF {
            if p.pos + 2 > p.n || p.s.code_unit_at(p.pos) != 92 || p.s.code_unit_at(p.pos + 1) != 117 {
              return Err("json: lone high surrogate")
            }
            p.pos = p.pos + 2
            match jp_parse_hex4(p) {
              Err(e) => return Err(e)
              Ok(lo) => {
                if lo < 0xDC00 || lo > 0xDFFF {
                  return Err("json: invalid low surrogate")
                }
                let cp = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00)
                sb.write_char(cp.unsafe_to_char())
              }
            }
          } else if u >= 0xDC00 && u <= 0xDFFF {
            return Err("json: lone low surrogate")
          } else {
            sb.write_char(u.unsafe_to_char())
          }
        }
      } else {
        return Err("json: invalid escape character")
      }
    } else {
      sb.write_byte(c.to_byte())
      p.pos = p.pos + 1
    }
  }
  Err("json: unterminated string")
}

fn jp_parse_number(p : MbtJsonParser) -> Result[MbtJson, String] {
  let num_start = p.pos
  let mut neg = false
  if p.pos < p.n && p.s.code_unit_at(p.pos) == 45 {
    neg = true
    p.pos = p.pos + 1
  }
  if p.pos >= p.n {
    return Err("json: invalid number")
  }
  let first = p.s.code_unit_at(p.pos)
  if first == 48 {
    p.pos = p.pos + 1
    if p.pos < p.n {
      let nxt = p.s.code_unit_at(p.pos)
      if nxt >= 48 && nxt <= 57 {
        return Err("json: leading zero in number")
      }
    }
  } else if first >= 49 && first <= 57 {
    p.pos = p.pos + 1
    while p.pos < p.n {
      let c = p.s.code_unit_at(p.pos)
      if c >= 48 && c <= 57 {
        p.pos = p.pos + 1
      } else {
        break
      }
    }
  } else {
    return Err("json: invalid number")
  }
  let mut has_frac_or_exp = false
  if p.pos < p.n && p.s.code_unit_at(p.pos) == 46 {
    has_frac_or_exp = true
    p.pos = p.pos + 1
    let frac_start = p.pos
    while p.pos < p.n {
      let c = p.s.code_unit_at(p.pos)
      if c >= 48 && c <= 57 {
        p.pos = p.pos + 1
      } else {
        break
      }
    }
    if p.pos == frac_start {
      return Err("json: missing fractional digits")
    }
  }
  if p.pos < p.n && (p.s.code_unit_at(p.pos) == 101 || p.s.code_unit_at(p.pos) == 69) {
    has_frac_or_exp = true
    p.pos = p.pos + 1
    if p.pos < p.n && (p.s.code_unit_at(p.pos) == 43 || p.s.code_unit_at(p.pos) == 45) {
      p.pos = p.pos + 1
    }
    let exp_start = p.pos
    while p.pos < p.n {
      let c = p.s.code_unit_at(p.pos)
      if c >= 48 && c <= 57 {
        p.pos = p.pos + 1
      } else {
        break
      }
    }
    if p.pos == exp_start {
      return Err("json: missing exponent digits")
    }
  }
  let raw = p.s.slice(num_start, p.pos)
  if !has_frac_or_exp {
    let mut acc : Int64 = 0L
    let mut exceeded = false
    let mut k = if neg { num_start + 1 } else { num_start }
    while k < p.pos {
      let d = (p.s.code_unit_at(k) - 48).to_int64()
      if acc > 900719925474099L || (acc == 900719925474099L && d > 1L) {
        exceeded = true
        break
      }
      acc = acc * 10L + d
      k = k + 1
    }
    if !exceeded {
      let v = if neg {
        if acc == 0L {
          Double::from_bits(0x8000000000000000UL.reinterpret_as_int64())
        } else {
          -(acc.to_double())
        }
      } else {
        acc.to_double()
      }
      return Ok(MbtJson::Number(v, None))
    }
    match str_try_parse_double(raw) {
      Ok(d) => return Ok(MbtJson::Number(d, Some(raw)))
      Err(_) => return Ok(MbtJson::Number(if neg { double_neg_inf() } else { double_inf() }, Some(raw)))
    }
  }
  match str_try_parse_double(raw) {
    Ok(d) => Ok(MbtJson::Number(d, None))
    Err(_) => Ok(MbtJson::Number(if neg { double_neg_inf() } else { double_inf() }, Some(raw)))
  }
}

fn jp_parse_value(p : MbtJsonParser, remaining : Int) -> Result[MbtJson, String] {
  jp_skip_ws(p)
  if p.pos >= p.n {
    return Err("json: unexpected end of input")
  }
  let c = p.s.code_unit_at(p.pos)
  if c == 110 {
    if p.pos + 4 <= p.n && p.s.slice(p.pos, p.pos + 4) == "null" {
      p.pos = p.pos + 4
      return Ok(MbtJson::Null)
    }
    return Err("json: invalid token")
  }
  if c == 116 {
    if p.pos + 4 <= p.n && p.s.slice(p.pos, p.pos + 4) == "true" {
      p.pos = p.pos + 4
      return Ok(MbtJson::True)
    }
    return Err("json: invalid token")
  }
  if c == 102 {
    if p.pos + 5 <= p.n && p.s.slice(p.pos, p.pos + 5) == "false" {
      p.pos = p.pos + 5
      return Ok(MbtJson::False)
    }
    return Err("json: invalid token")
  }
  if c == 34 {
    match jp_parse_string(p) {
      Ok(str_v) => return Ok(MbtJson::String(str_v))
      Err(e) => return Err(e)
    }
  }
  if c == 91 {
    if remaining <= 0 {
      return Err("json: max depth exceeded")
    }
    p.pos = p.pos + 1
    jp_skip_ws(p)
    let out : Array[MbtJson] = []
    if p.pos < p.n && p.s.code_unit_at(p.pos) == 93 {
      p.pos = p.pos + 1
      return Ok(MbtJson::Array(out))
    }
    while true {
      match jp_parse_value(p, remaining - 1) {
        Err(e) => return Err(e)
        Ok(el) => out.push(el)
      }
      jp_skip_ws(p)
      if p.pos >= p.n {
        return Err("json: unterminated array")
      }
      let sep = p.s.code_unit_at(p.pos)
      if sep == 93 {
        p.pos = p.pos + 1
        return Ok(MbtJson::Array(out))
      }
      if sep != 44 {
        return Err("json: expected ',' or ']' in array")
      }
      p.pos = p.pos + 1
    }
    return Err("json: unreachable")
  }
  if c == 123 {
    if remaining <= 0 {
      return Err("json: max depth exceeded")
    }
    p.pos = p.pos + 1
    jp_skip_ws(p)
    let m : OrderedMap[String, MbtJson] = OrderedMap::new()
    if p.pos < p.n && p.s.code_unit_at(p.pos) == 125 {
      p.pos = p.pos + 1
      return Ok(MbtJson::Object(m))
    }
    while true {
      jp_skip_ws(p)
      let k = match jp_parse_string(p) {
        Err(e) => return Err(e)
        Ok(ks) => ks
      }
      jp_skip_ws(p)
      if p.pos >= p.n || p.s.code_unit_at(p.pos) != 58 {
        return Err("json: expected ':' after object key")
      }
      p.pos = p.pos + 1
      match jp_parse_value(p, remaining - 1) {
        Err(e) => return Err(e)
        Ok(jv) => m.set(k, jv)
      }
      jp_skip_ws(p)
      if p.pos >= p.n {
        return Err("json: unterminated object")
      }
      let sep = p.s.code_unit_at(p.pos)
      if sep == 125 {
        p.pos = p.pos + 1
        return Ok(MbtJson::Object(m))
      }
      if sep != 44 {
        return Err("json: expected ',' or '}' in object")
      }
      p.pos = p.pos + 1
    }
    return Err("json: unreachable")
  }
  if c == 45 || (c >= 48 && c <= 57) {
    return jp_parse_number(p)
  }
  Err("json: unexpected character")
}

pub fn mbt_json_parse(s : String) -> Result[MbtJson, String] {
  let p = MbtJsonParser::{ s: s, n: s.length(), pos: 0 }
  match jp_parse_value(p, 1024) {
    Err(e) => Err(e)
    Ok(v) => {
      jp_skip_ws(p)
      if p.pos != p.n {
        Err("json: trailing characters")
      } else {
        Ok(v)
      }
    }
  }
}

pub fn mbt_json_eq(a : MbtJson, b : MbtJson) -> Bool {
  match (a, b) {
    (MbtJson::Null, MbtJson::Null) => true
    (MbtJson::True, MbtJson::True) => true
    (MbtJson::False, MbtJson::False) => true
    (MbtJson::Number(x, _), MbtJson::Number(y, _)) => x == y
    (MbtJson::String(x), MbtJson::String(y)) => x == y
    (MbtJson::Array(xs), MbtJson::Array(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        if !mbt_json_eq(xs[i], ys[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (MbtJson::Object(xm), MbtJson::Object(ym)) => {
      if ordered_map_size(xm) != ordered_map_size(ym) {
        return false
      }
      let mut i = 0
      let n = xm.slot_len()
      while i < n {
        if xm.slot_live(i) {
          let k = xm.slot_key(i)
          match ym.get(k) {
            Some(yv) => if !mbt_json_eq(xm.slot_val(i), yv) { return false }
            None => return false
          }
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

pub impl Eq for MbtJson {
  fn equal(self : MbtJson, other : MbtJson) -> Bool {
    mbt_json_eq(self, other)
  }
}

///| MoonBit `ToJson` trait compatibility (`ToJson::to_json(v)`).
pub trait MbtToJson {
  to_json(self : Self) -> MbtJson
}

pub fn mbt_to_json[T : MbtToJson](v : T) -> MbtJson {
  v.to_json()
}

pub impl MbtToJson for Int {
  fn to_json(self : Int) -> MbtJson {
    MbtJson::Number(self.to_double(), None)
  }
}

pub impl MbtToJson for Int64 {
  fn to_json(self : Int64) -> MbtJson {
    MbtJson::String(self.to_string())
  }
}

pub impl MbtToJson for UInt {
  fn to_json(self : UInt) -> MbtJson {
    MbtJson::Number(self.to_double(), None)
  }
}

pub impl MbtToJson for UInt64 {
  fn to_json(self : UInt64) -> MbtJson {
    MbtJson::String(self.to_string())
  }
}

pub impl MbtToJson for Double {
  fn to_json(self : Double) -> MbtJson {
    if self != self {
      MbtJson::String("NaN")
    } else if self > 1.7976931348623157e308 {
      MbtJson::String("Infinity")
    } else if self < -1.7976931348623157e308 {
      MbtJson::String("-Infinity")
    } else {
      MbtJson::Number(self, None)
    }
  }
}

pub impl MbtToJson for Float {
  fn to_json(self : Float) -> MbtJson {
    self.to_double().to_json()
  }
}

pub impl MbtToJson for Bool {
  fn to_json(self : Bool) -> MbtJson {
    MbtJson::boolean(self)
  }
}

pub impl MbtToJson for String {
  fn to_json(self : String) -> MbtJson {
    MbtJson::String(self)
  }
}

pub impl MbtToJson for Char {
  fn to_json(self : Char) -> MbtJson {
    MbtJson::String(self.to_string())
  }
}

pub impl MbtToJson for Unit {
  fn to_json(self : Unit) -> MbtJson {
    let _ = self
    MbtJson::Null
  }
}

pub impl MbtToJson for MbtJson {
  fn to_json(self : MbtJson) -> MbtJson {
    self
  }
}

pub fn ordered_map_to_json[V : MbtToJson](m : OrderedMap[String, V]) -> MbtJson {
  let out : OrderedMap[String, MbtJson] = ordered_map_new()
  let mut i = 0
  let n = m.slot_len()
  while i < n {
    if m.slot_live(i) {
      out.set(m.slot_key(i), m.slot_val(i).to_json())
    }
    i = i + 1
  }
  MbtJson::Object(out)
}

pub fn OrderedMap::to_json[V : MbtToJson](self : OrderedMap[String, V]) -> MbtJson {
  ordered_map_to_json(self)
}
