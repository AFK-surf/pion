///| mbt_compat/mbt_json: MoonBit `Json` semantic compatibility layer built on Pion `std/json`.

import "json"

pub enum MbtJson {
  Null
  True
  False
  Number(Double)
  String(String)
  Array(Array[MbtJson])
  Object(OrderedMap[String, MbtJson])
}

pub fn MbtJson::null() -> MbtJson {
  MbtJson::Null
}

pub fn MbtJson::boolean(b : Bool) -> MbtJson {
  if b {
    MbtJson::True
  } else {
    MbtJson::False
  }
}

pub fn MbtJson::number(d : Double) -> MbtJson {
  MbtJson::Number(d)
}

pub fn MbtJson::string(s : String) -> MbtJson {
  MbtJson::String(s)
}

pub fn MbtJson::array(xs : Array[MbtJson]) -> MbtJson {
  MbtJson::Array(xs)
}

pub fn MbtJson::object(m : OrderedMap[String, MbtJson]) -> MbtJson {
  MbtJson::Object(m)
}

fn write_mbt_json(sb : StringBuilder, v : MbtJson) -> Unit {
  match v {
    MbtJson::Null => sb.write_string("null")
    MbtJson::True => sb.write_string("true")
    MbtJson::False => sb.write_string("false")
    MbtJson::Number(d) =>
    if d != d || d - d != 0.0 {
      sb.write_string("null")
    } else {
      sb.write_string(double_to_string(d))
    }
    MbtJson::String(s) => sb.write_string(json::stringify(json::JsonValue::JStr(s)))
    MbtJson::Array(xs) => {
      sb.write_char('[')
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          sb.write_char(',')
        }
        write_mbt_json(sb, xs[i])
        i = i + 1
      }
      sb.write_char(']')
    }
    MbtJson::Object(m) => {
      sb.write_char('{')
      let mut first = true
      let mut i = 0
      let n = m.slot_len()
      while i < n {
        if m.slot_live(i) {
          if !first {
            sb.write_char(',')
          }
          first = false
          sb.write_string(json::stringify(json::JsonValue::JStr(m.slot_key(i))))
          sb.write_char(':')
          write_mbt_json(sb, m.slot_val(i))
        }
        i = i + 1
      }
      sb.write_char('}')
    }
  }
}

pub fn MbtJson::stringify(self : MbtJson) -> String {
  let sb = StringBuilder()
  write_mbt_json(sb, self)
  sb.to_string()
}

fn json_value_to_mbt_json(v : json::JsonValue) -> MbtJson {
  match v {
    json::JsonValue::JNull => MbtJson::Null
    json::JsonValue::JBool(b) => if b { MbtJson::True } else { MbtJson::False }
    json::JsonValue::JInt(n) => MbtJson::Number(n.to_double())
    json::JsonValue::JFloat(d) => MbtJson::Number(d)
    json::JsonValue::JStr(s) => MbtJson::String(s)
    json::JsonValue::JArr(xs) => {
      let out : Array[MbtJson] = []
      for x in xs {
        out.push(json_value_to_mbt_json(x))
      }
      MbtJson::Array(out)
    }
    json::JsonValue::JObj(fields) => {
      let m : OrderedMap[String, MbtJson] = OrderedMap::new()
      for f in fields {
        m.set(f.key, json_value_to_mbt_json(f.value))
      }
      MbtJson::Object(m)
    }
  }
}

pub fn mbt_json_parse(s : String) -> Result[MbtJson, String] {
  match json::parse(s) {
    Ok(v) => Ok(json_value_to_mbt_json(v))
    Err(e) => Err(e)
  }
}

pub fn mbt_json_eq(a : MbtJson, b : MbtJson) -> Bool {
  match (a, b) {
    (MbtJson::Null, MbtJson::Null) => true
    (MbtJson::True, MbtJson::True) => true
    (MbtJson::False, MbtJson::False) => true
    (MbtJson::Number(x), MbtJson::Number(y)) => x == y
    (MbtJson::String(x), MbtJson::String(y)) => x == y
    (MbtJson::Array(xs), MbtJson::Array(ys)) => {
      if xs.length() != ys.length() {
        return false
      }
      let mut i = 0
      while i < xs.length() {
        if !mbt_json_eq(xs[i], ys[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    (MbtJson::Object(xm), MbtJson::Object(ym)) => {
      if ordered_map_size(xm) != ordered_map_size(ym) {
        return false
      }
      let mut i = 0
      let n = xm.slot_len()
      while i < n {
        if xm.slot_live(i) {
          let k = xm.slot_key(i)
          match ym.get(k) {
            Some(yv) => if !mbt_json_eq(xm.slot_val(i), yv) { return false }
            None => return false
          }
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}
