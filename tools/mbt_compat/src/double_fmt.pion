///| mbt_compat/double_fmt: MoonBit `Double::to_string` / `"\{d}"`, plus `Double`
///| hashing, NaN check, bit-reinterpret, and total-order comparison helpers.

/// MoonBit `d.is_nan()`.
pub fn double_is_nan(d : Double) -> Bool {
  d != d
}

/// MoonBit `d.is_inf()`.
pub fn double_is_inf(d : Double) -> Bool {
  let bits = d.to_bits() & 0x7fffffffffffffffL
  bits == 0x7ff0000000000000L
}

/// Construct `Double` from exact IEEE-754 binary64 bit pattern.
pub fn double_from_bits(bits : Int64) -> Double {
  Double::from_bits(bits)
}

/// MoonBit `@double.not_a_number`.
pub fn double_nan() -> Double {
  Double::from_bits(0x7ff8000000000000L)
}

/// MoonBit `@double.infinity`.
pub fn double_inf() -> Double {
  Double::from_bits(0x7ff0000000000000L)
}

/// MoonBit `@double.neg_infinity`.
pub fn double_neg_inf() -> Double {
  Double::from_bits(0xfff0000000000000UL.reinterpret_as_int64())
}

/// MoonBit `@double.max_value`.
pub fn double_max_value() -> Double {
  Double::from_bits(0x7fefffffffffffffL)
}

/// MoonBit `@double.min_value`.
pub fn double_min_value() -> Double {
  Double::from_bits(0xffefffffffffffffUL.reinterpret_as_int64())
}

/// MoonBit `@double.min_positive`.
pub fn double_min_positive() -> Double {
  Double::from_bits(0x0010000000000000L)
}

/// MoonBit `@math.PI`.
pub fn double_pi() -> Double {
  Double::from_bits(0x400921fb54442d18L)
}

/// MoonBit `@math.sin`.
pub fn math_sin(x : Double) -> Double {
  x.sin()
}

/// MoonBit `@math.cos`.
pub fn math_cos(x : Double) -> Double {
  x.cos()
}

/// MoonBit `@math.tan`.
pub fn math_tan(x : Double) -> Double {
  x.tan()
}

/// MoonBit `@math.asin`.
pub fn math_asin(x : Double) -> Double {
  x.asin()
}

/// MoonBit `@math.acos`.
pub fn math_acos(x : Double) -> Double {
  x.acos()
}

/// MoonBit `@math.atan`.
pub fn math_atan(x : Double) -> Double {
  x.atan()
}

/// MoonBit `@math.atan2`.
pub fn math_atan2(y : Double, x : Double) -> Double {
  y.atan2(x)
}

/// MoonBit `@math.exp`.
pub fn math_exp(x : Double) -> Double {
  x.exp()
}

/// MoonBit `@math.ln`.
pub fn math_ln(x : Double) -> Double {
  x.ln()
}

/// MoonBit `@math.pow`.
pub fn math_pow(x : Double, y : Double) -> Double {
  x.pow(y)
}

/// MoonBit `@math.floor`.
pub fn math_floor(x : Double) -> Double {
  x.floor()
}

/// MoonBit `@math.ceil`.
pub fn math_ceil(x : Double) -> Double {
  x.ceil()
}

/// MoonBit `@math.round`.
pub fn math_round(x : Double) -> Double {
  x.round()
}

/// MoonBit `@math.trunc`.
pub fn math_trunc(x : Double) -> Double {
  x.trunc()
}

/// MoonBit `@math.sqrt`.
pub fn math_sqrt(x : Double) -> Double {
  x.sqrt()
}

/// MoonBit `@math.cbrt`.
pub fn math_cbrt(x : Double) -> Double {
  x.cbrt()
}

/// MoonBit `@math.hypot` (overflow-safe).
pub fn math_hypot(x : Double, y : Double) -> Double {
  let ax = x.abs()
  let ay = y.abs()
  if double_is_inf(ax) || double_is_inf(ay) {
    return double_inf()
  }
  if double_is_nan(ax) || double_is_nan(ay) {
    return double_nan()
  }
  let hi = if ax >= ay { ax } else { ay }
  let lo = if ax >= ay { ay } else { ax }
  if hi == 0.0 {
    return 0.0
  }
  let r = lo / hi
  hi * (1.0 + r * r).sqrt()
}

/// MoonBit `@math.maximum` (matches MoonBit NaN and `-0.0`/`+0.0` semantics).
pub fn math_maximum(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

/// MoonBit `@math.minimum` (matches MoonBit NaN and `-0.0`/`+0.0` semantics).
pub fn math_minimum(a : Double, b : Double) -> Double {
  if a > b { b } else { a }
}

/// MoonBit `d.reinterpret_as_int64()`.
pub fn double_reinterpret_as_int64(d : Double) -> Int64 {
  d.reinterpret_as_uint64().reinterpret_as_int64()
}

/// MoonBit `v.reinterpret_as_double()`.
pub fn int64_reinterpret_as_double(v : Int64) -> Double {
  Double::from_bits(v)
}

/// MoonBit `Double::to_uint()` (saturating conversion: NaN / <= 0.0 -> 0U, >= 4294967295.0 -> 4294967295U).
pub fn double_to_uint(d : Double) -> UInt {
  if d != d || d <= 0.0 {
    return 0U
  }
  if d >= 4294967295.0 {
    return 4294967295U
  }
  d.to_int64().to_int().reinterpret_as_uint()
}

/// Canonical hash for `Double`: normalizes `+0.0`/`-0.0` to `0L` and all `NaN`s to
/// canonical quiet NaN (`0x7ff8000000000000L`) so equal doubles always hash identically.
pub fn double_hash(d : Double) -> Int {
  let bits : Int64 = if d == 0.0 {
    0L
  } else if d != d {
    9221120237041090560L
  } else {
    d.reinterpret_as_uint64().reinterpret_as_int64()
  }
  hash_mix((bits ^ (bits >> 32L)).to_int())
}

/// MoonBit `a.compare(b)` on `Double` (`-1`, `0`, `1`; any comparison with NaN returns `0`).
pub fn double_compare(a : Double, b : Double) -> Int {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

/// MoonBit `a.min(b)` on `Double`: if either operand is NaN returns the other;
/// otherwise returns `a` if `a < b` else `b` (matching MoonBit wasm-gc on `-0.0`/`+0.0`).
pub fn double_min(a : Double, b : Double) -> Double {
  if a != a {
    b
  } else if b != b {
    a
  } else if a < b {
    a
  } else {
    b
  }
}

/// MoonBit `a.max(b)` on `Double`: if either operand is NaN returns the other;
/// otherwise returns `a` if `a > b` else `b` (matching MoonBit wasm-gc on `-0.0`/`+0.0`).
pub fn double_max(a : Double, b : Double) -> Double {
  if a != a {
    b
  } else if b != b {
    a
  } else if a > b {
    a
  } else {
    b
  }
}

/// MoonBit `Double::clamp(min~, max~)`: clamps `x` into `[min, max]`.
/// Matches MoonBit core (`guard! min <= max`): panics if `min > max` or either bound is NaN;
/// returns `x` (NaN) when `min <= max` and `x` is NaN.
pub fn double_clamp(x : Double, min~ : Double = 0.0, max~ : Double = 0.0) -> Double {
  if !(min <= max) {
    panic("abort: Double::clamp: min > max")
  }
  if x != x {
    return x
  }
  if x < min {
    min
  } else if x > max {
    max
  } else {
    x
  }
}
///|
///| MoonBit prints the shortest decimal that reads back to the same double
///| (closest to the exact value when several have that length, ties to even),
///| laid out like ECMAScript `Number.prototype.toString`:
///|   - `0.0` and `-0.0` -> `"0"`, `NaN` -> `"NaN"`, `Infinity` / `-Infinity`,
///|   - decimal exponent `x` (value = d.ddd * 10^x) in `-7 < x < 21`: plain
///|     digits (`100000000000000000000`, `0.000001`, `123.456`),
///|   - otherwise `d[.ddd]e(+|-)x` (`1e+21`, `1.5e-7`, `5e-324`).
///| Pion's own `"\{d}"` uses C `%g`-style output (`1.5e-07`, `-0`, `nan`,
///| `1e+20`), hence this module.
///|
///| Digits come from the exact Burger-Dybvig free-format algorithm on big
///| integers (base 10^9 limbs), so the result does not depend on the target's
///| C library or JavaScript engine.

let LIMB : Int64 = 1000000000L

/// Big natural number, little-endian base-10^9 limbs, no trailing zero limbs.
struct Big {
  mut d : Array[Int64]
}

fn big_of(x : Int64) -> Big {
  let d : Array[Int64] = []
  let mut v = x
  while v > 0L {
    d.push(v % LIMB)
    v = v / LIMB
  }
  Big::{ d, }
}

fn big_copy(a : Big) -> Big {
  let d : Array[Int64] = []
  for x in a.d {
    d.push(x)
  }
  Big::{ d, }
}

/// a = a * m, with 0 <= m <= 10^9.
fn big_mul_small(a : Big, m : Int64) -> Unit {
  let mut carry = 0L
  let n = a.d.length()
  let mut i = 0
  while i < n {
    let t = a.d[i] * m + carry
    a.d[i] = t % LIMB
    carry = t / LIMB
    i = i + 1
  }
  while carry > 0L {
    a.d.push(carry % LIMB)
    carry = carry / LIMB
  }
}

fn big_mul_pow2(a : Big, n : Int) -> Unit {
  let mut k = n
  while k >= 29 {
    big_mul_small(a, 536870912L)
    k = k - 29
  }
  if k > 0 {
    big_mul_small(a, 1L << k.to_int64())
  }
}

fn big_mul_pow10(a : Big, n : Int) -> Unit {
  let mut k = n
  while k >= 9 {
    big_mul_small(a, LIMB)
    k = k - 9
  }
  let mut m = 1L
  while k > 0 {
    m = m * 10L
    k = k - 1
  }
  if m > 1L {
    big_mul_small(a, m)
  }
}

fn big_cmp(a : Big, b : Big) -> Int {
  let na = a.d.length()
  let nb = b.d.length()
  if na != nb {
    return if na < nb { -1 } else { 1 }
  }
  let mut i = na - 1
  while i >= 0 {
    let x = a.d[i]
    let y = b.d[i]
    if x != y {
      return if x < y { -1 } else { 1 }
    }
    i = i - 1
  }
  0
}

fn big_add(a : Big, b : Big) -> Big {
  let d : Array[Int64] = []
  let na = a.d.length()
  let nb = b.d.length()
  let n = if na > nb { na } else { nb }
  let mut carry = 0L
  let mut i = 0
  while i < n {
    let x = if i < na { a.d[i] } else { 0L }
    let y = if i < nb { b.d[i] } else { 0L }
    let t = x + y + carry
    d.push(t % LIMB)
    carry = t / LIMB
    i = i + 1
  }
  if carry > 0L {
    d.push(carry)
  }
  Big::{ d, }
}

/// a = a - b, requires a >= b.
fn big_sub(a : Big, b : Big) -> Unit {
  let nb = b.d.length()
  let mut borrow = 0L
  let mut i = 0
  let n = a.d.length()
  while i < n {
    let y = if i < nb { b.d[i] } else { 0L }
    let mut t = a.d[i] - y - borrow
    if t < 0L {
      t = t + LIMB
      borrow = 1L
    } else {
      borrow = 0L
    }
    a.d[i] = t
    i = i + 1
  }
  while a.d.length() > 0 && a.d[a.d.length() - 1] == 0L {
    let _ = a.d.pop()
  }
}

/// Shortest round-trip digits of the finite positive double with integer
/// significand `f` and binary exponent `e` (value = f * 2^e); returns the
/// digit string and the decimal exponent `k` (value ~ 0.DIGITS * 10^k).
fn shortest_digits(f : Int64, e : Int, symmetric : Bool) -> (String, Int) {
  let even = f % 2L == 0L
  let mut r = big_of(f)
  let mut s = big_of(1L)
  let mut mp = big_of(1L)
  let mut mm = big_of(1L)
  if e >= 0 {
    big_mul_pow2(mm, e)
    if symmetric {
      big_mul_pow2(r, e + 1)
      big_mul_small(s, 2L)
      big_mul_pow2(mp, e)
    } else {
      big_mul_pow2(r, e + 2)
      big_mul_small(s, 4L)
      big_mul_pow2(mp, e + 1)
    }
  } else if symmetric {
    big_mul_small(r, 2L)
    big_mul_pow2(s, 1 - e)
  } else {
    big_mul_small(r, 4L)
    big_mul_pow2(s, 2 - e)
    big_mul_small(mp, 2L)
  }
  // Estimate k = ceil(log10(v)) from the bit length; it is never too large.
  let mut bits = 0
  let mut ff = f
  while ff > 0L {
    bits = bits + 1
    ff = ff >> 1L
  }
  let est = ((e + bits - 1).to_double() * 0.30102999566398114 - 0.0000000001).ceil()
  let mut k = est.to_int()
  if k >= 0 {
    big_mul_pow10(s, k)
  } else {
    big_mul_pow10(r, -k)
    big_mul_pow10(mp, -k)
    big_mul_pow10(mm, -k)
  }
  // Fix up: smallest k with (r + m+) / s < 1 (or <= 1 when the high bound is
  // inclusive).
  while true {
    let c = big_cmp(big_add(r, mp), s)
    if (even && c >= 0) || (!even && c > 0) {
      big_mul_small(s, 10L)
      k = k + 1
    } else {
      break
    }
  }
  let sb = StringBuilder::new()
  while true {
    big_mul_small(r, 10L)
    big_mul_small(mp, 10L)
    big_mul_small(mm, 10L)
    let mut dgt = 0
    while big_cmp(r, s) >= 0 {
      big_sub(r, s)
      dgt = dgt + 1
    }
    let cl = big_cmp(r, mm)
    let tc1 = if even { cl <= 0 } else { cl < 0 }
    let ch = big_cmp(big_add(r, mp), s)
    let tc2 = if even { ch >= 0 } else { ch > 0 }
    if !tc1 && !tc2 {
      sb.write_byte((48 + dgt).to_byte())
      continue
    }
    let last = if tc1 && !tc2 {
      dgt
    } else if !tc1 && tc2 {
      dgt + 1
    } else {
      let r2 = big_copy(r)
      big_mul_small(r2, 2L)
      let c2 = big_cmp(r2, s)
      if c2 < 0 {
        dgt
      } else if c2 > 0 {
        dgt + 1
      } else if dgt % 2 == 0 {
        dgt
      } else {
        dgt + 1
      }
    }
    sb.write_byte((48 + last).to_byte())
    break
  }
  (sb.to_string(), k)
}

/// ECMAScript layout of digits `ds` (no leading/trailing zeros) with decimal
/// exponent `x` (value = d.ddd * 10^x).
fn layout(neg : Bool, ds : String, x : Int) -> String {
  let n = ds.length()
  let sb = StringBuilder::new()
  if neg {
    sb.write_byte(b'-')
  }
  if x < -6 || x >= 21 {
    sb.write_substring(ds, 0, 1)
    if n > 1 {
      sb.write_byte(b'.')
      sb.write_substring(ds, 1, n)
    }
    sb.write_byte(b'e')
    if x < 0 {
      sb.write_byte(b'-')
      sb.write_string((-x).to_string())
    } else {
      sb.write_byte(b'+')
      sb.write_string(x.to_string())
    }
  } else if x < 0 {
    sb.write_string("0.")
    let mut z = -1
    while z > x {
      sb.write_byte(b'0')
      z = z - 1
    }
    sb.write_string(ds)
  } else if x + 1 >= n {
    sb.write_string(ds)
    let mut z = n
    while z < x + 1 {
      sb.write_byte(b'0')
      z = z + 1
    }
  } else {
    sb.write_substring(ds, 0, x + 1)
    sb.write_byte(b'.')
    sb.write_substring(ds, x + 1, n)
  }
  sb.to_string()
}

/// MoonBit `Double::to_string` (and `Show` / string interpolation).
pub fn double_to_string(d : Double) -> String {
  if d != d {
    return "NaN"
  }
  if d == 0.0 {
    return "0"
  }
  let bits = d.reinterpret_as_uint64()
  let neg = (bits >> 63UL) != 0UL
  let be = ((bits >> 52UL) & 0x7FFUL).to_int()
  let fm = (bits & 0xFFFFFFFFFFFFFUL).reinterpret_as_int64()
  if be == 0x7FF {
    return if neg { "-Infinity" } else { "Infinity" }
  }
  // Integers below 2^53 print as their exact digits (shortest by construction).
  let a = d.abs()
  if a <= 9007199254740992.0 {
    let i = d.to_int64()
    if i.to_double() == d {
      return i.to_string()
    }
  }
  let (f, e) = if be == 0 {
    (fm, -1074)
  } else {
    (fm + 4503599627370496L, be - 1075)
  }
  let symmetric = fm != 0L || be <= 1
  let (ds, k) = shortest_digits(f, e, symmetric)
  layout(neg, ds, k - 1)
}

/// MoonBit `Float::to_string` (and `Show` / string interpolation): the shortest
/// digits that round-trip through binary32, in the same layout as
/// `double_to_string` (`1e-7`, `0.000001`, `1e+21`, `100000000000000000000`).
/// Unlike `Double`, integers are not printed exactly (`123456792.0` -> `123456790`)
/// and `-0.0` prints `0`.
pub fn float_to_string(x : Float) -> String {
  if x != x {
    return "NaN"
  }
  let bits = x.reinterpret_as_int()
  let neg = bits < 0
  let be = (bits >> 23) & 0xFF
  let fm = (bits & 0x7FFFFF).to_int64()
  if be == 0xFF {
    return if neg { "-Infinity" } else { "Infinity" }
  }
  if be == 0 && fm == 0L {
    return "0"
  }
  let (f, e) = if be == 0 { (fm, -149) } else { (fm + 8388608L, be - 150) }
  let symmetric = fm != 0L || be <= 1
  let (ds, k) = shortest_digits(f, e, symmetric)
  layout(neg, ds, k - 1)
}

/// MoonBit `Byte::to_string` (and `Show`): the decimal value (`b'a'` -> `97`).
pub fn byte_to_string(b : Byte) -> String {
  b.to_int().to_string()
}

/// MoonBit `Byte` debug / `Repr` format: lowercase hex (`b'\x00'` -> `"0x00"`, `b'\xff'` -> `"0xff"`).
pub fn debug_byte(b : Byte) -> String {
  let hex = "0123456789abcdef"
  let c = b.to_int()
  let sb = StringBuilder::new()
  sb.write_string("0x")
  sb.write_substring(hex, c / 16, c / 16 + 1)
  sb.write_substring(hex, c % 16, c % 16 + 1)
  sb.to_string()
}

/// MoonBit `Bytes::to_string` (and `Show`): `b"..."` with printable ASCII
/// (0x20..0x7e) kept except `"` and `\`, and every other byte as `\xNN`
/// (lowercase hex), e.g. `b"a\x22b\x5cc\x0a"`.
pub fn bytes_to_string(bs : Bytes) -> String {
  let hex = "0123456789abcdef"
  let sb = StringBuilder::new()
  sb.write_string("b\"")
  let n = bs.length()
  let mut i = 0
  while i < n {
    let c = bs[i].to_int()
    if c >= 0x20 && c <= 0x7E && c != 0x22 && c != 0x5C {
      sb.write_byte(c.to_byte())
    } else {
      sb.write_string("\\x")
      sb.write_substring(hex, c / 16, c / 16 + 1)
      sb.write_substring(hex, c % 16, c % 16 + 1)
    }
    i = i + 1
  }
  sb.write_string("\"")
  sb.to_string()
}
