///| mbt_compat/json_show: Exact MoonBit `Show` (`to_string`) implementation for `MbtJson`.
///| Matches MoonBit `Json::output` / `Json::to_string` char-for-char (NOT `stringify`!):
///| - `Null` -> `"Null"`, `True` -> `"True"`, `False` -> `"False"`
///| - `Number(d, _)` -> `"Number(" + double_to_string(d) + ")"`
///| - `String(s)` -> `"String(" + s + ")"` (unescaped raw string)
///| - `Array(xs)` -> `"Array([" + ... + "])"` with `", "` separator
///| - `Object(m)` -> `"Object({" + k + ": " + v + ... + "})"` (unescaped keys, `": "` and `", "`)

fn write_mbt_json_show(sb : StringBuilder, v : MbtJson) -> Unit {
  match v {
    MbtJson::Null => sb.write_string("Null")
    MbtJson::True => sb.write_string("True")
    MbtJson::False => sb.write_string("False")
    MbtJson::Number(d, _) => {
      sb.write_string("Number(")
      sb.write_string(double_to_string(d))
      sb.write_char(')')
    }
    MbtJson::String(s) => {
      sb.write_string("String(")
      sb.write_string(s)
      sb.write_char(')')
    }
    MbtJson::Array(xs) => {
      sb.write_string("Array([")
      let mut i = 0
      while i < xs.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_mbt_json_show(sb, xs[i])
        i = i + 1
      }
      sb.write_string("])")
    }
    MbtJson::Object(m) => {
      sb.write_string("Object({")
      let mut first = true
      let mut i = 0
      let n = m.slot_len()
      while i < n {
        if m.slot_live(i) {
          if !first {
            sb.write_string(", ")
          }
          first = false
          sb.write_string(m.slot_key(i))
          sb.write_string(": ")
          write_mbt_json_show(sb, m.slot_val(i))
        }
        i = i + 1
      }
      sb.write_string("})")
    }
  }
}

pub fn mbt_json_to_string(v : MbtJson) -> String {
  let sb = StringBuilder()
  write_mbt_json_show(sb, v)
  sb.to_string()
}

pub fn MbtJson::to_string(self : MbtJson) -> String {
  mbt_json_to_string(self)
}

///| Exact MoonBit `Debug` (`@debug.render` / `debug_inspect`) formatting for `MbtJson`.
///| 1:1 port of `moonbitlang/core/debug/{json,printer,pretty_print}.mbt`:
///| - 70-column (UTF-16 code unit) `with_resizing` compact-vs-multiline layout
///| - Depth pruning (`default_max_depth = 16` for `mbt_json_debug`, `None` for `mbt_json_debug_unpruned`)
///| - `MapEntry` and `EnumLabeledArg` do not consume depth budget (matching `Repr::info_adds_depth`)

enum JsonDebugRepr {
  DoubleLit(Double)
  StringLit(String)
  Enum(String, Array[JsonDebugRepr])
  Array(Array[JsonDebugRepr])
  Map(Array[JsonDebugRepr])
  MapEntry(JsonDebugRepr, JsonDebugRepr)
  EnumLabeledArg(String, JsonDebugRepr)
  Omitted
}

fn mbt_json_to_debug_repr(v : MbtJson) -> JsonDebugRepr {
  match v {
    MbtJson::Null => JsonDebugRepr::Enum("Null", [])
    MbtJson::True => JsonDebugRepr::Enum("True", [])
    MbtJson::False => JsonDebugRepr::Enum("False", [])
    MbtJson::Number(d, repr) =>
      match repr {
        None => JsonDebugRepr::Enum("Number", [JsonDebugRepr::DoubleLit(d)])
        Some(r) =>
          JsonDebugRepr::Enum("Number", [
            JsonDebugRepr::DoubleLit(d),
            JsonDebugRepr::EnumLabeledArg(
              "repr",
              JsonDebugRepr::Enum("Some", [JsonDebugRepr::StringLit(r)]),
            ),
          ])
      }
    MbtJson::String(s) => JsonDebugRepr::Enum("String", [JsonDebugRepr::StringLit(s)])
    MbtJson::Array(xs) => {
      let items : Array[JsonDebugRepr] = []
      let mut i = 0
      while i < xs.length() {
        items.push(mbt_json_to_debug_repr(xs[i]))
        i = i + 1
      }
      JsonDebugRepr::Enum("Array", [JsonDebugRepr::Array(items)])
    }
    MbtJson::Object(m) => {
      let entries : Array[JsonDebugRepr] = []
      let mut i = 0
      let n = m.slot_len()
      while i < n {
        if m.slot_live(i) {
          entries.push(
            JsonDebugRepr::MapEntry(
              JsonDebugRepr::StringLit(m.slot_key(i)),
              mbt_json_to_debug_repr(m.slot_val(i)),
            ),
          )
        }
        i = i + 1
      }
      JsonDebugRepr::Enum("Object", [JsonDebugRepr::Map(entries)])
    }
  }
}

fn jdr_prune(node : JsonDebugRepr, depth : Int) -> JsonDebugRepr {
  match node {
    JsonDebugRepr::DoubleLit(_) | JsonDebugRepr::StringLit(_) | JsonDebugRepr::Omitted => node
    JsonDebugRepr::Enum(name, children) => {
      if children.length() == 0 {
        return node
      }
      if depth <= 0 {
        return JsonDebugRepr::Omitted
      }
      let next : Array[JsonDebugRepr] = []
      let mut i = 0
      while i < children.length() {
        next.push(jdr_prune(children[i], depth - 1))
        i = i + 1
      }
      JsonDebugRepr::Enum(name, next)
    }
    JsonDebugRepr::Array(children) => {
      if children.length() == 0 {
        return node
      }
      if depth <= 0 {
        return JsonDebugRepr::Omitted
      }
      let next : Array[JsonDebugRepr] = []
      let mut i = 0
      while i < children.length() {
        next.push(jdr_prune(children[i], depth - 1))
        i = i + 1
      }
      JsonDebugRepr::Array(next)
    }
    JsonDebugRepr::Map(children) => {
      if children.length() == 0 {
        return node
      }
      if depth <= 0 {
        return JsonDebugRepr::Omitted
      }
      let next : Array[JsonDebugRepr] = []
      let mut i = 0
      while i < children.length() {
        next.push(jdr_prune(children[i], depth - 1))
        i = i + 1
      }
      JsonDebugRepr::Map(next)
    }
    JsonDebugRepr::MapEntry(k, v) =>
      // MapEntry does not consume depth budget (info_adds_depth == false).
      JsonDebugRepr::MapEntry(jdr_prune(k, depth), jdr_prune(v, depth))
    JsonDebugRepr::EnumLabeledArg(name, v) =>
      // EnumLabeledArg does not consume depth budget (info_adds_depth == false).
      JsonDebugRepr::EnumLabeledArg(name, jdr_prune(v, depth))
  }
}

fn jdr_repeat_spaces(n : Int) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < n {
    sb.write_char(' ')
    i = i + 1
  }
  sb.to_string()
}

fn jdr_compact_middle(lines : Array[String], start : Int, end_excl : Int) -> String {
  let parts : Array[String] = []
  let mut i = start
  while i < end_excl {
    let t = lines[i].trim()
    if t.length() > 0 {
      parts.push(t)
    }
    i = i + 1
  }
  let joined = parts.join(" ")
  if joined.ends_with(",") {
    joined.slice(0, joined.length() - 1)
  } else {
    joined
  }
}

fn jdr_compact_lines(lines : Array[String]) -> Array[String] {
  let n = lines.length()
  if n <= 1 {
    return lines
  }
  let first = lines[0]
  let last = lines[n - 1]
  if (first == "[" && last == "]") || (first == "{" && last == "}") {
    let joined = jdr_compact_middle(lines, 1, n - 1)
    if first == "{" {
      let s1 = if joined.starts_with(" ") { joined.slice(1, joined.length()) } else { joined }
      let inner = if s1.ends_with(" ") { s1.slice(0, s1.length() - 1) } else { s1 }
      if inner.length() == 0 {
        return ["{}"]
      }
      return ["{ " + inner + " }"]
    }
    return ["[" + joined + "]"]
  }
  if first.ends_with("(") && last == ")" {
    let joined = jdr_compact_middle(lines, 1, n - 1)
    return [first + joined + last]
  }
  let parts : Array[String] = [first]
  let mut i = 1
  while i < n {
    parts.push(lines[i].trim())
    i = i + 1
  }
  [parts.join(" ")]
}

fn jdr_push_indented_items(
  out : Array[String],
  indent_by : Int,
  contents : Array[Array[String]],
) -> Unit {
  let pad = jdr_repeat_spaces(indent_by)
  let mut ci = 0
  while ci < contents.length() {
    let item = contents[ci]
    let non_empty : Array[String] = []
    let mut j = 0
    while j < item.length() {
      if item[j].length() > 0 {
        non_empty.push(item[j])
      }
      j = j + 1
    }
    let m = non_empty.length()
    if m == 1 {
      out.push(pad + non_empty[0] + ",")
    } else if m > 1 {
      let mut k = 0
      while k < m - 1 {
        out.push(pad + non_empty[k])
        k = k + 1
      }
      out.push(pad + non_empty[m - 1] + ",")
    }
    ci = ci + 1
  }
}

fn jdr_bracket_seq_lines(
  open : String,
  close : String,
  indent_by : Int,
  contents : Array[Array[String]],
) -> Array[String] {
  let n = contents.length()
  if n == 0 {
    return [open + close]
  }
  if n == 1 {
    let item = contents[0]
    if item.length() > 1 {
      let pad = jdr_repeat_spaces(indent_by)
      let out : Array[String] = [open]
      let mut i = 0
      while i < item.length() {
        if i == item.length() - 1 {
          out.push(pad + item[i] + ",")
        } else {
          out.push(pad + item[i])
        }
        i = i + 1
      }
      out.push(close)
      return out
    }
    let inner = jdr_compact_lines(item)
    if inner.length() == 0 {
      return [open + close]
    }
    if inner.length() == 1 {
      let x = inner[0]
      if open == "{" && close == "}" {
        let trimmed = x.trim()
        if trimmed.length() == 0 {
          return ["{}"]
        }
        return ["{ " + trimmed + " }"]
      }
      return [open + x + close]
    }
    let pad = jdr_repeat_spaces(indent_by)
    let out : Array[String] = [open]
    let mut i = 0
    while i < item.length() {
      out.push(pad + item[i])
      i = i + 1
    }
    out.push(close)
    return out
  }
  let out : Array[String] = [open]
  jdr_push_indented_items(out, indent_by, contents)
  out.push(close)
  out
}

fn jdr_comma_seq_lines(
  begin : String,
  end : String,
  contents : Array[Array[String]],
) -> Array[String] {
  if begin == "[" && end == "]" {
    return jdr_bracket_seq_lines("[", "]", 2, contents)
  }
  if begin == "{" && end == "}" {
    return jdr_bracket_seq_lines("{", "}", 2, contents)
  }
  let n = contents.length()
  if n == 0 {
    return [begin + end]
  }
  if n == 1 {
    let item = contents[0]
    let non_empty : Array[String] = []
    let mut j = 0
    while j < item.length() {
      if item[j].length() > 0 {
        non_empty.push(item[j])
      }
      j = j + 1
    }
    let m = non_empty.length()
    if m == 0 {
      return [begin + end]
    }
    if m == 1 {
      return [begin + non_empty[0] + end]
    }
    let out : Array[String] = [begin]
    let mut k = 0
    while k < m - 1 {
      out.push("  " + non_empty[k])
      k = k + 1
    }
    out.push("  " + non_empty[m - 1] + ",")
    out.push(end)
    return out
  }
  let out : Array[String] = [begin]
  jdr_push_indented_items(out, 2, contents)
  out.push(end)
  out
}

fn jdr_with_resizing(threshold : Int, rendered : Array[String]) -> Array[String] {
  if threshold <= 0 {
    return rendered
  }
  let compacted = jdr_compact_lines(rendered)
  let mut i = 0
  while i < compacted.length() {
    if utf16_len(compacted[i]) > threshold {
      return rendered
    }
    i = i + 1
  }
  compacted
}

fn jdr_render(node : JsonDebugRepr, threshold : Int) -> Array[String] {
  let rendered : Array[String] = match node {
    JsonDebugRepr::DoubleLit(d) => [double_to_string(d)]
    JsonDebugRepr::StringLit(s) => [debug_string(s)]
    JsonDebugRepr::Omitted => ["..."]
    JsonDebugRepr::Enum(name, children) => {
      if children.length() == 0 {
        [name]
      } else {
        let child_lines : Array[Array[String]] = []
        let mut i = 0
        while i < children.length() {
          child_lines.push(jdr_render(children[i], threshold))
          i = i + 1
        }
        jdr_comma_seq_lines(name + "(", ")", child_lines)
      }
    }
    JsonDebugRepr::Array(children) => {
      let child_lines : Array[Array[String]] = []
      let mut i = 0
      while i < children.length() {
        child_lines.push(jdr_render(children[i], threshold))
        i = i + 1
      }
      jdr_comma_seq_lines("[", "]", child_lines)
    }
    JsonDebugRepr::Map(children) => {
      let child_lines : Array[Array[String]] = []
      let mut i = 0
      while i < children.length() {
        child_lines.push(jdr_render(children[i], threshold))
        i = i + 1
      }
      jdr_comma_seq_lines("{", "}", child_lines)
    }
    JsonDebugRepr::MapEntry(k, v) => {
      let kl = jdr_render(k, threshold)
      let vl = jdr_render(v, threshold)
      if vl.length() == 0 {
        []
      } else {
        let kstr = kl.join("\n")
        let out : Array[String] = [kstr + ": " + vl[0]]
        let mut i = 1
        while i < vl.length() {
          out.push(vl[i])
          i = i + 1
        }
        out
      }
    }
    JsonDebugRepr::EnumLabeledArg(name, v) => {
      let vl = jdr_render(v, threshold)
      if vl.length() == 0 {
        []
      } else {
        let out : Array[String] = [name + "=" + vl[0]]
        let mut i = 1
        while i < vl.length() {
          out.push(vl[i])
          i = i + 1
        }
        out
      }
    }
  }
  jdr_with_resizing(threshold, rendered)
}

pub fn mbt_json_debug(v : MbtJson) -> String {
  let pruned = jdr_prune(mbt_json_to_debug_repr(v), 16)
  jdr_render(pruned, 70).join("\n")
}

pub fn mbt_json_debug_unpruned(v : MbtJson) -> String {
  jdr_render(mbt_json_to_debug_repr(v), 70).join("\n")
}
