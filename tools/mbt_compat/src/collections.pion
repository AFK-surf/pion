///| mbt_compat/collections: MoonBit `Array` / `Option` / assertion helpers that
///| Pion has no built-in method for. Failure cases panic where MoonBit aborts.

/// Shared mutable cell used by `mbt2pion` to box `let mut` locals captured by
/// lifted recursive local functions without forming closure RC cycles.
pub struct MbtCell[T] {
  pub mut v : T
}

/// Construct a new `MbtCell[T]` (usable as a `[ref].ctor_call` target).
pub fn mbt_cell[T](v : T) -> MbtCell[T] {
  MbtCell::{ v: v }
}

let REF_PHYS_ID_SEQ : AtomicInt = AtomicInt::new(1)

/// MoonBit `Ref[T]` (`{ val: x }` / `Ref(x)` / `.val`) with unique identity for `physical_equal`.
pub struct Ref[T] {
  pub mut v : T
  phys_id : Int
}

/// Construct a new `Ref[T]`.
pub fn ref_new[T](v : T) -> Ref[T] {
  Ref::{ v: v, phys_id: REF_PHYS_ID_SEQ.fetch_add(1) }
}

/// MoonBit `physical_equal(a, b)` on `Ref[T]`.
pub fn ref_physical_equal[T](a : Ref[T], b : Ref[T]) -> Bool {
  a.phys_id == b.phys_id
}

extern "C" fn c_mbt_str_from_cstr(data : Ptr, len : Int64) -> Ptr = "pion_str_from_cstr"
extern "C" fn c_mbt_world_println(w : Ptr, s : Ptr) -> Unit = "pion_world_println"
extern "C" fn c_mbt_rc_dec(p : Ptr) -> Unit = "pion_rc_dec"

/// MoonBit bare `println(s)` (native + wasm32 compatible without `World`, 0 RC leaks).
pub fn mbt_println(s : String) -> Unit {
  let ps = c_mbt_str_from_cstr(s.as_cstr(), s.length().to_int64())
  c_mbt_world_println(ptr_null(), ps)
  c_mbt_rc_dec(ps)
}

/// MoonBit `xs.is_empty()`.
pub fn arr_is_empty[T](xs : Array[T]) -> Bool {
  xs.length() == 0
}

/// MoonBit `xs.truncate(len)`.
pub fn arr_truncate[T](xs : Array[T], len : Int) -> Unit {
  let target = if len < 0 { 0 } else { len }
  while xs.length() > target {
    let _ = xs.pop()
  }
}

/// MoonBit `FixedArray::makei(n, f)`.
pub fn fixed_array_makei[T](n : Int, f : (Int) -> T) -> FixedArray[T] {
  let out : Array[T] = []
  let mut i = 0
  while i < n {
    out.push(f(i))
    i = i + 1
  }
  FixedArray::from_array(out)
}

/// MoonBit `src.blit_to(dst, len~, src_offset~, dst_offset~)`.
pub fn fixed_array_blit_to[T](
  src : Array[T],
  dst : Array[T],
  len~ : Int = -1,
  src_offset~ : Int = 0,
  dst_offset~ : Int = 0,
) -> Unit {
  let n = if len < 0 { src.length() - src_offset } else { len }
  if n <= 0 {
    return
  }
  if src_offset < 0 || dst_offset < 0 || src_offset + n > src.length() || dst_offset + n > dst.length() {
    panic("abort: blit_to out of bounds")
  }
  // Copy through temporary slice if overlapping in same array (safe for aliasing)
  let tmp : Array[T] = []
  let mut i = 0
  while i < n {
    tmp.push(src[src_offset + i])
    i = i + 1
  }
  i = 0
  while i < n {
    dst[dst_offset + i] = tmp[i]
    i = i + 1
  }
}

/// MoonBit `x.lnot()` (bitwise NOT on 32-bit `Int`).
pub fn int_lnot(x : Int) -> Int {
  x ^ -1
}

/// MoonBit `fail(msg)` in tests.
pub fn fail[T](msg : String, loc : String) -> T {
  panic("abort: fail at " + loc + ": " + msg)
}

/// MoonBit `inspect(x, content=expected)` in tests.
pub fn inspect_eq(actual : String, expected : String, loc : String) -> Unit {
  if actual != expected {
    panic("abort: inspect failed at " + loc + ": got `" + actual + "`, expected `" + expected + "`")
  }
}

/// MoonBit `xs.map(f)`.
pub fn arr_map[T, U](xs : Array[T], f : (T) -> U) -> Array[U] {
  let out : Array[U] = []
  for x in xs {
    out.push(f(x))
  }
  out
}

/// MoonBit `xs.mapi(f)`.
pub fn arr_mapi[T, U](xs : Array[T], f : (Int, T) -> U) -> Array[U] {
  let out : Array[U] = []
  for i, x in xs {
    out.push(f(i, x))
  }
  out
}

/// MoonBit `xs.filter(f)`.
pub fn arr_filter[T](xs : Array[T], f : (T) -> Bool) -> Array[T] {
  let out : Array[T] = []
  for x in xs {
    if f(x) {
      out.push(x)
    }
  }
  out
}

/// MoonBit `xs.retain(f)` (in-place filter matching `core/builtin/array.mbt:2086`).
/// Zero-copy fast path; panics fail-closed if an indirect alias mutates `xs.length()` during `f`.
pub fn arr_retain[T](xs : Array[T], f : (T) -> Bool) -> Unit {
  let n = xs.length()
  let mut i = 0
  let mut j = 0
  while i < n {
    if xs.length() != n {
      panic("arr_retain: receiver array length mutated during callback")
    }
    let v = xs[i]
    if f(v) {
      if xs.length() != n {
        panic("arr_retain: receiver array length mutated during callback")
      }
      if j != i {
        xs[j] = v
      }
      j = j + 1
    } else if xs.length() != n {
      panic("arr_retain: receiver array length mutated during callback")
    }
    i = i + 1
  }
  while xs.length() > j {
    let _ = xs.pop()
  }
}

/// MoonBit `xs.filter_map(f)` (matching `core/builtin/array.mbt:2868`).
/// Zero-copy fast path; panics fail-closed if an indirect alias mutates `xs.length()` during `f`.
pub fn arr_filter_map[T, U](xs : Array[T], f : (T) -> Option[U]) -> Array[U] {
  let out : Array[U] = []
  let n = xs.length()
  let mut i = 0
  while i < n {
    if xs.length() != n {
      panic("arr_filter_map: receiver array length mutated during callback")
    }
    match f(xs[i]) {
      Some(u) => out.push(u)
      None => ()
    }
    if xs.length() != n {
      panic("arr_filter_map: receiver array length mutated during callback")
    }
    i = i + 1
  }
  out
}

/// MoonBit `xs.each(f)`.
pub fn arr_each[T](xs : Array[T], f : (T) -> Unit) -> Unit {
  for x in xs {
    f(x)
  }
}

/// MoonBit `xs.eachi(f)`.
pub fn arr_eachi[T](xs : Array[T], f : (Int, T) -> Unit) -> Unit {
  for i, x in xs {
    f(i, x)
  }
}

/// MoonBit `xs.fold(init~, f)`: left fold.
pub fn arr_fold[T, A](xs : Array[T], init : A, f : (A, T) -> A) -> A {
  let mut acc = init
  for x in xs {
    acc = f(acc, x)
  }
  acc
}

/// MoonBit `xs.last()`.
pub fn arr_last[T](xs : Array[T]) -> Option[T] {
  let n = xs.length()
  if n == 0 {
    None
  } else {
    Some(xs[n - 1])
  }
}

/// MoonBit `xs.insert(i, v)`: panics unless `0 <= i <= length`.
pub fn arr_insert[T](xs : Array[T], i : Int, v : T) -> Unit {
  let n = xs.length()
  if i < 0 || i > n {
    panic("abort: index out of bounds: the len is from 0 to \{n} but the index is \{i}")
  }
  if i == n {
    xs.push(v)
    return
  }
  xs.push(xs[n - 1])
  let mut j = n - 1
  while j > i {
    xs[j] = xs[j - 1]
    j = j - 1
  }
  xs[i] = v
}

/// MoonBit `xs.remove(i)`: returns the removed element; panics unless
/// `0 <= i < length`.
pub fn arr_remove[T](xs : Array[T], i : Int) -> T {
  let n = xs.length()
  if i < 0 || i >= n {
    panic("abort: index out of bounds: the len is from 0 to \{n} but the index is \{i}")
  }
  let v = xs[i]
  let mut j = i
  while j + 1 < n {
    xs[j] = xs[j + 1]
    j = j + 1
  }
  let _ = xs.pop()
  v
}

/// MoonBit `xs.append(ys)` (`ys` is copied element by element).
pub fn arr_append[T](xs : Array[T], ys : Array[T]) -> Unit {
  let n = ys.length()
  let mut i = 0
  while i < n {
    xs.push(ys[i])
    i = i + 1
  }
}

/// Identity helper when a MoonBit `ArrayView` slice lowered to `Array[T]` calls `.to_array()`.
pub fn arr_to_array[T](xs : Array[T]) -> Array[T] {
  xs
}

/// MoonBit `xs.search(v)`: returns the first index where `xs[i] == v`, or `None`.
pub fn arr_search[T](xs : Array[T], v : T) -> Option[Int] {
  let n = xs.length()
  let mut i = 0
  while i < n {
    if xs[i] == v {
      return Some(i)
    }
    i = i + 1
  }
  None
}

/// MoonBit `xs.contains(v)`: true iff some element equals `v`.
pub fn arr_contains[T](xs : Array[T], v : T) -> Bool {
  match arr_search(xs, v) {
    Some(_) => true
    None => false
  }
}

// ---------------------------------------------------------------------------
// `arr_sort_by`: the same algorithm as MoonBit core's `Array::sort_by`
// (moonbitlang/core `builtin/array_sort_by_impl.mbt`, Apache-2.0): quicksort
// with insertion ("bubble") sort for runs of <= 16, median-of-3 / ninther
// pivots, a sortedness probe, equal-to-predecessor skipping and a heapsort
// fallback. Reproducing it step by step keeps the final order of elements that
// compare equal identical to MoonBit (the sort is not stable).

fn sort_swap[T](xs : Array[T], i : Int, j : Int) -> Unit {
  let t = xs[i]
  xs[i] = xs[j]
  xs[j] = t
}

fn sort_get_limit(len : Int) -> Int {
  let mut n = len
  let mut limit = 0
  while n > 0 {
    n = n / 2
    limit = limit + 1
  }
  limit
}

/// Insertion sort on `xs[lo..hi)`.
fn sort_bubble[T](xs : Array[T], lo : Int, hi : Int, cmp : (T, T) -> Int) -> Unit {
  let mut i = lo + 1
  while i < hi {
    let mut j = i
    while j > lo && cmp(xs[j - 1], xs[j]) > 0 {
      sort_swap(xs, j, j - 1)
      j = j - 1
    }
    i = i + 1
  }
}

/// Insertion sort tolerating at most 8 out-of-place elements; false when it
/// gives up (the range is then partially reordered, as in MoonBit).
fn sort_try_bubble[T](
  xs : Array[T],
  lo : Int,
  hi : Int,
  cmp : (T, T) -> Int,
) -> Bool {
  let mut tries = 0
  let mut i = lo + 1
  while i < hi {
    let mut j = i
    let mut sorted = true
    while j > lo && cmp(xs[j - 1], xs[j]) > 0 {
      sort_swap(xs, j, j - 1)
      j = j - 1
      sorted = false
    }
    if !sorted {
      tries = tries + 1
      if tries > 8 {
        return false
      }
    }
    i = i + 1
  }
  true
}

/// Lomuto partition of `xs[lo..hi)` around the element at `lo + pivot`;
/// returns the pivot's final offset and whether nothing moved.
fn sort_partition[T](
  xs : Array[T],
  lo : Int,
  hi : Int,
  cmp : (T, T) -> Int,
  pivot_index : Int,
) -> (Int, Bool) {
  let len = hi - lo
  sort_swap(xs, lo + pivot_index, lo + len - 1)
  let pivot = xs[lo + len - 1]
  let mut i = 0
  let mut partitioned = true
  let mut j = 0
  while j < len - 1 {
    if cmp(xs[lo + j], pivot) < 0 {
      if i != j {
        sort_swap(xs, lo + i, lo + j)
        partitioned = false
      }
      i = i + 1
    }
    j = j + 1
  }
  sort_swap(xs, lo + i, lo + len - 1)
  (i, partitioned)
}

fn sort_reverse[T](xs : Array[T], lo : Int, hi : Int) -> Unit {
  let mut a = lo
  let mut b = hi - 1
  while a < b {
    sort_swap(xs, a, b)
    a = a + 1
    b = b - 1
  }
}

/// Pivot choice; returns (offset in the range, likely sorted).
fn sort_choose_pivot[T](
  xs : Array[T],
  lo : Int,
  hi : Int,
  cmp : (T, T) -> Int,
) -> (Int, Bool) {
  let len = hi - lo
  let mut swaps = 0
  let b = len / 4 * 2
  if len >= 8 {
    let a = len / 4 * 1
    let c = len / 4 * 3
    let sort_2 = fn(x : Int, y : Int) -> Unit {
      if cmp(xs[lo + x], xs[lo + y]) > 0 {
        sort_swap(xs, lo + x, lo + y)
        swaps = swaps + 1
      }
    }
    let sort_3 = fn(x : Int, y : Int, z : Int) -> Unit {
      sort_2(x, y)
      sort_2(y, z)
      sort_2(x, y)
    }
    if len > 50 {
      sort_3(a - 1, a, a + 1)
      sort_3(b - 1, b, b + 1)
      sort_3(c - 1, c, c + 1)
    }
    sort_3(a, b, c)
  }
  if swaps == 12 {
    sort_reverse(xs, lo, hi)
    (len - b - 1, true)
  } else {
    (b, swaps == 0)
  }
}

fn sort_sift_down[T](
  xs : Array[T],
  lo : Int,
  len : Int,
  start : Int,
  cmp : (T, T) -> Int,
) -> Unit {
  let mut index = start
  let mut child = index * 2 + 1
  while child < len {
    if child + 1 < len && cmp(xs[lo + child], xs[lo + child + 1]) < 0 {
      child = child + 1
    }
    if cmp(xs[lo + index], xs[lo + child]) >= 0 {
      return
    }
    sort_swap(xs, lo + index, lo + child)
    index = child
    child = child * 2 + 1
  }
}

fn sort_heap[T](xs : Array[T], lo : Int, hi : Int, cmp : (T, T) -> Int) -> Unit {
  let len = hi - lo
  let mut i = len / 2 - 1
  while i >= 0 {
    sort_sift_down(xs, lo, len, i, cmp)
    i = i - 1
  }
  let mut k = len - 1
  while k >= 1 {
    sort_swap(xs, lo, lo + k)
    sort_sift_down(xs, lo, k, 0, cmp)
    k = k - 1
  }
}

fn sort_quick[T](
  xs : Array[T],
  lo0 : Int,
  hi0 : Int,
  cmp : (T, T) -> Int,
  pred0 : Option[T],
  limit0 : Int,
) -> Unit {
  let mut lo = lo0
  let mut hi = hi0
  let mut pred = pred0
  let mut limit = limit0
  let mut was_partitioned = true
  let mut balanced = true
  while true {
    let len = hi - lo
    if len <= 16 {
      if len >= 2 {
        sort_bubble(xs, lo, hi, cmp)
      }
      return
    }
    if limit == 0 {
      sort_heap(xs, lo, hi, cmp)
      return
    }
    let (pivot_index, likely_sorted) = sort_choose_pivot(xs, lo, hi, cmp)
    if was_partitioned && balanced && likely_sorted {
      if sort_try_bubble(xs, lo, hi, cmp) {
        return
      }
    }
    let (pivot, partitioned) = sort_partition(xs, lo, hi, cmp, pivot_index)
    was_partitioned = partitioned
    let small = if pivot < len - pivot { pivot } else { len - pivot }
    balanced = small >= len / 8
    if !balanced {
      limit = limit - 1
    }
    let mut skipped = false
    match pred {
      Some(p) =>
      if cmp(p, xs[lo + pivot]) == 0 {
        let mut i = pivot
        while i < len && cmp(p, xs[lo + i]) == 0 {
          i = i + 1
        }
        lo = lo + i
        skipped = true
      }
      None => ()
    }
    if !skipped {
      let left_len = pivot
      let right_len = len - pivot - 1
      let pv = xs[lo + pivot]
      if left_len < right_len {
        sort_quick(xs, lo, lo + pivot, cmp, pred, limit)
        lo = lo + pivot + 1
        pred = Some(pv)
      } else {
        sort_quick(xs, lo + pivot + 1, hi, cmp, Some(pv), limit)
        hi = lo + pivot
      }
    }
  }
}

/// MoonBit `xs.sort_by(cmp)`: in place, `cmp` returns <0 / 0 / >0; equal
/// elements end in the same order as in MoonBit (not stable).
pub fn arr_sort_by[T](xs : Array[T], cmp : (T, T) -> Int) -> Unit {
  let n = xs.length()
  sort_quick(xs, 0, n, cmp, None, sort_get_limit(n))
}

/// MoonBit `Array(capacity=n)` / `Array::new(capacity=n)` abort on a negative
/// `n`; the capacity of a Pion `Array` is not observable otherwise.
pub fn arr_capacity_check(cap : Int) -> Unit {
  if cap < 0 {
    panic("abort: negative array capacity \{cap}")
  }
}

/// MoonBit `xs.shrink_to_fit()` on an array the translator kept as a Pion
/// `Array` (it promotes every array with a borrowed view to `ArrayBuf`, whose
/// `shrink_to_fit` reallocates exactly like MoonBit). A Pion `Array` has no
/// observable capacity and no view sharing its storage, so only `xs` is
/// evaluated; `mbt2pion` emits this call only where no `Array::iter()` of the
/// same array can still be read afterwards (see `MBT2PION_ARRAY_SHRINK_ITER`).
pub fn arr_shrink_to_fit[T](xs : Array[T]) -> Unit {
  let _ = xs
}

/// MoonBit `Compare` for the key types `sort_by_key` sorts by.
pub trait MbtCompare {
  mbt_compare(self : Self, other : Self) -> Int
}

impl MbtCompare for Int {
  fn mbt_compare(self : Int, other : Int) -> Int {
    int_compare(self, other)
  }
}

impl MbtCompare for Int64 {
  fn mbt_compare(self : Int64, other : Int64) -> Int {
    if self < other { -1 } else if self > other { 1 } else { 0 }
  }
}

impl MbtCompare for UInt {
  fn mbt_compare(self : UInt, other : UInt) -> Int {
    uint_compare(self, other)
  }
}

impl MbtCompare for UInt64 {
  fn mbt_compare(self : UInt64, other : UInt64) -> Int {
    if self < other { -1 } else if self > other { 1 } else { 0 }
  }
}

/// `NaN` compares equal to everything and `-0.0` to `0.0` (MoonBit), unlike
/// Pion's total-order `Double::compare`.
impl MbtCompare for Double {
  fn mbt_compare(self : Double, other : Double) -> Int {
    double_compare(self, other)
  }
}

impl MbtCompare for Float {
  fn mbt_compare(self : Float, other : Float) -> Int {
    if self < other { -1 } else if self > other { 1 } else { 0 }
  }
}

/// UTF-16 length first, then code units (MoonBit `String::compare`).
impl MbtCompare for String {
  fn mbt_compare(self : String, other : String) -> Int {
    str_compare(self, other)
  }
}

impl MbtCompare for Char {
  fn mbt_compare(self : Char, other : Char) -> Int {
    if self < other { -1 } else if self > other { 1 } else { 0 }
  }
}

impl MbtCompare for Byte {
  fn mbt_compare(self : Byte, other : Byte) -> Int {
    if self < other { -1 } else if self > other { 1 } else { 0 }
  }
}

impl MbtCompare for Bool {
  fn mbt_compare(self : Bool, other : Bool) -> Int {
    bool_compare(self, other)
  }
}

/// MoonBit `xs.sort_by_key(key)`: `arr_sort_by` (MoonBit's unstable sort)
/// comparing `key(a)` then `key(b)` on every comparison, so `key` runs twice
/// per comparison in MoonBit's order and ties end where MoonBit puts them.
pub fn arr_sort_by_key[T, K : MbtCompare](xs : Array[T], key : (T) -> K) -> Unit {
  arr_sort_by(xs, fn(a : T, b : T) -> Int {
    let ka = key(a)
    ka.mbt_compare(key(b))
  })
}

/// MoonBit `opt.map(f)`.
pub fn opt_map[T, U](o : Option[T], f : (T) -> U) -> Option[U] {
  match o {
    Some(x) => Some(f(x))
    None => None
  }
}

/// MoonBit `opt.unwrap()`: panics on `None`.
pub fn opt_unwrap[T](o : Option[T]) -> T {
  match o {
    Some(x) => x
    None => panic("abort: called `Option::unwrap()` on a `None` value")
  }
}

/// MoonBit `opt.or(default)`.
pub fn opt_or[T](o : Option[T], default : T) -> T {
  match o {
    Some(x) => x
    None => default
  }
}

/// MoonBit `opt.is_empty()` / `opt is None`.
pub fn opt_is_empty[T](o : Option[T]) -> Bool {
  match o {
    Some(_) => false
    None => true
  }
}

/// MoonBit `assert_eq(a, b)` for any type: `eq` decides, `show` renders the
/// failure message, `loc` names the source position (e.g. `"file.mbt:12:3"`).
pub fn assert_eq_by[T](
  a : T,
  b : T,
  eq : (T, T) -> Bool,
  show : (T) -> String,
  loc : String,
) -> Unit {
  if !eq(a, b) {
    panic("assertion failed at \{loc}: `\{show(a)} == \{show(b)}`")
  }
}

/// MoonBit `assert_true(c)`.
pub fn assert_true(c : Bool, loc : String) -> Unit {
  if !c {
    panic("assertion failed at \{loc}: expected true")
  }
}

/// MoonBit `assert_false(c)`.
pub fn assert_false(c : Bool, loc : String) -> Unit {
  if c {
    panic("assertion failed at \{loc}: expected false")
  }
}

/// MoonBit `arr.unsafe_get(i)`.
pub fn arr_unsafe_get[T](arr : Array[T], idx : Int) -> T {
  arr[idx]
}

/// MoonBit `arr.unsafe_set(i, v)`.
pub fn arr_unsafe_set[T](arr : Array[T], idx : Int, val_ : T) -> Unit {
  arr[idx] = val_
}

/// MoonBit `Array::makei(n, f)`.
pub fn arr_makei[T](n : Int, f : (Int) -> T) -> Array[T] {
  let out : Array[T] = []
  let mut i = 0
  while i < n {
    out.push(f(i))
    i = i + 1
  }
  out
}

/// MoonBit `xs.iter().any(f)`.
pub fn arr_any[T](xs : Array[T], f : (T) -> Bool) -> Bool {
  for x in xs {
    if f(x) {
      return true
    }
  }
  false
}

/// MoonBit `xs.iter().all(f)`.
pub fn arr_all[T](xs : Array[T], f : (T) -> Bool) -> Bool {
  for x in xs {
    if !f(x) {
      return false
    }
  }
  true
}

/// MoonBit `xs.rev_in_place()`.
pub fn arr_rev_in_place[T](xs : Array[T]) -> Unit {
  let mut lo = 0
  let mut hi = xs.length() - 1
  while lo < hi {
    let tmp = xs[lo]
    xs[lo] = xs[hi]
    xs[hi] = tmp
    lo = lo + 1
    hi = hi - 1
  }
}

/// MoonBit `a + b` on `Array[T]`.
pub fn arr_concat[T](a : Array[T], b : Array[T]) -> Array[T] {
  let out : Array[T] = []
  for x in a {
    out.push(x)
  }
  for x in b {
    out.push(x)
  }
  out
}

/// MoonBit `xs.copy()` on `Array[T]`.
pub fn arr_copy[T](xs : Array[T]) -> Array[T] {
  let out : Array[T] = []
  for x in xs {
    out.push(x)
  }
  out
}

/// MoonBit `Bytes::makei(n, f)`.
pub fn bytes_makei(n : Int, f : (Int) -> Byte) -> Bytes {
  let m = if n < 0 { 0 } else { n }
  let buf = Bytes::new(m)
  let mut i = 0
  while i < m {
    buf[i] = f(i)
    i = i + 1
  }
  buf
}

/// MoonBit `Bytes::from_array(xs)`.
pub fn bytes_from_array(xs : Array[Byte]) -> Bytes {
  let n = xs.length()
  let buf = Bytes::new(n)
  let mut i = 0
  while i < n {
    buf[i] = xs[i]
    i = i + 1
  }
  buf
}

/// MoonBit `b[start:end]` on `Bytes` (clamped).
pub fn bytes_slice(b : Bytes, start : Int, end : Int) -> Bytes {
  let n = b.length()
  let lo = if start < 0 { 0 } else if start > n { n } else { start }
  let hi0 = if end < 0 { 0 } else if end > n { n } else { end }
  let hi = if hi0 > lo { hi0 } else { lo }
  let len = hi - lo
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = b[lo + i]
    i = i + 1
  }
  out
}

/// MoonBit `Bytes::clamped_view(start~, end~)`.
pub fn bytes_clamped_view(b : Bytes, start~ : Int = 0, end? : Int) -> Bytes {
  let e = match end {
    Some(v) => v
    None => b.length()
  }
  bytes_slice(b, start, e)
}

/// MoonBit `FixedArray::unsafe_get(i)`.
pub fn fixed_array_unsafe_get[T](xs : FixedArray[T], idx : Int) -> T {
  xs[idx]
}

/// MoonBit `FixedArray::unsafe_set(i, v)`.
pub fn fixed_array_unsafe_set[T](xs : FixedArray[T], idx : Int, val_ : T) -> Unit {
  xs[idx] = val_
}

/// MoonBit `FixedArray[start:end]` clamped slice copy to `Array[T]`.
pub fn fixed_array_slice_clamp[T](xs : FixedArray[T], start : Int, end : Int) -> Array[T] {
  let n = xs.length()
  let lo = if start < 0 { 0 } else if start > n { n } else { start }
  let hi0 = if end < 0 { 0 } else if end > n { n } else { end }
  let hi = if hi0 > lo { hi0 } else { lo }
  let out : Array[T] = []
  let mut i = lo
  while i < hi {
    out.push(xs[i])
    i = i + 1
  }
  out
}

/// MoonBit `FixedArray::copy()`.
pub fn fixed_array_copy[T](xs : FixedArray[T]) -> FixedArray[T] {
  let n = xs.length()
  if n == 0 {
    return FixedArray::from_array([])
  }
  let out = FixedArray::make(n, xs[0])
  let mut i = 1
  while i < n {
    out[i] = xs[i]
    i = i + 1
  }
  out
}

/// MoonBit `FixedArray::sort_by(cmp)`.
pub fn fixed_array_sort_by[T](xs : FixedArray[T], cmp : (T, T) -> Int) -> Unit {
  let n = xs.length()
  if n <= 1 {
    return
  }
  let arr : Array[T] = []
  let mut i = 0
  while i < n {
    arr.push(xs[i])
    i = i + 1
  }
  arr_sort_by(arr, cmp)
  i = 0
  while i < n {
    xs[i] = arr[i]
    i = i + 1
  }
}

/// MoonBit `FixedArray[Int64]::sort()`.
pub fn fixed_array_sort_i64(xs : FixedArray[Int64]) -> Unit {
  fixed_array_sort_by(xs, fn(a : Int64, b : Int64) -> Int {
    if a < b { -1 } else if a > b { 1 } else { 0 }
  })
}

/// MoonBit `FixedArray[Int]::sort()`.
pub fn fixed_array_sort_int(xs : FixedArray[Int]) -> Unit {
  fixed_array_sort_by(xs, fn(a : Int, b : Int) -> Int {
    if a < b { -1 } else if a > b { 1 } else { 0 }
  })
}

/// MoonBit `src.blit_to(dst, len~, src_offset~, dst_offset~)` on `FixedArray[T]`.
pub fn fixed_array_blit_to_fa[T](
  src : FixedArray[T],
  dst : FixedArray[T],
  len~ : Int = -1,
  src_offset~ : Int = 0,
  dst_offset~ : Int = 0,
) -> Unit {
  let n = if len < 0 { src.length() - src_offset } else { len }
  if n <= 0 {
    return
  }
  if src_offset < 0 || dst_offset < 0 || src_offset + n > src.length() || dst_offset + n > dst.length() {
    panic("abort: blit_to out of bounds")
  }
  let tmp : Array[T] = []
  let mut i = 0
  while i < n {
    tmp.push(src[src_offset + i])
    i = i + 1
  }
  i = 0
  while i < n {
    dst[dst_offset + i] = tmp[i]
    i = i + 1
  }
}

/// MoonBit `Byte::to_uint()`.
pub fn byte_to_uint(b : Byte) -> UInt {
  b.to_int().reinterpret_as_uint()
}

/// MoonBit `Int::popcnt()`.
pub fn int_popcnt(x : Int) -> Int {
  let mut u = x.reinterpret_as_uint()
  let mut cnt = 0
  while u != 0U {
    u = u & (u - 1U)
    cnt = cnt + 1
  }
  cnt
}

/// MoonBit `Int::ctz()`.
pub fn int_ctz(x : Int) -> Int {
  if x == 0 {
    return 32
  }
  let mut u = x.reinterpret_as_uint()
  let mut cnt = 0
  while (u & 1U) == 0U {
    u = u >> 1U
    cnt = cnt + 1
  }
  cnt
}

/// MoonBit `Int::clz()`.
pub fn int_clz(x : Int) -> Int {
  if x == 0 {
    return 32
  }
  let mut u = x.reinterpret_as_uint()
  let mut cnt = 0
  while (u & 0x80000000U) == 0U {
    u = u << 1U
    cnt = cnt + 1
  }
  cnt
}

/// MoonBit `Int::to_uint64()`.
pub fn int_to_uint64(x : Int) -> UInt64 {
  x.to_int64().reinterpret_as_uint64()
}

/// MoonBit `Int64::to_byte()`.
pub fn int64_to_byte(x : Int64) -> Byte {
  x.to_int().to_byte()
}

/// MoonBit `UInt64::lnot()`.
pub fn uint64_lnot(x : UInt64) -> UInt64 {
  x ^ 18446744073709551615UL
}

/// MoonBit `Int::compare(other)`.
pub fn int_compare(a : Int, b : Int) -> Int {
  if a < b { -1 } else if a > b { 1 } else { 0 }
}

/// MoonBit `Int::min(other)`.
pub fn int_min(a : Int, b : Int) -> Int {
  if a < b { a } else { b }
}

/// MoonBit `Int::max(other)`.
pub fn int_max(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

/// MoonBit `UInt::compare(other)`.
pub fn uint_compare(a : UInt, b : UInt) -> Int {
  if a < b { -1 } else if a > b { 1 } else { 0 }
}

/// MoonBit `Bool::compare(other)`.
pub fn bool_compare(a : Bool, b : Bool) -> Int {
  if a == b { 0 } else if a { 1 } else { -1 }
}

/// MoonBit `Bytes::to_array()`.
pub fn bytes_to_array(b : Bytes) -> Array[Byte] {
  let out : Array[Byte] = []
  let mut i = 0
  while i < b.length() {
    out.push(b[i])
    i = i + 1
  }
  out
}

/// MoonBit `Array::get(i) -> Option[T]`.
pub fn arr_get[T](xs : Array[T], i : Int) -> Option[T] {
  if i < 0 || i >= xs.length() {
    None
  } else {
    Some(xs[i])
  }
}

/// MoonBit `Array::release_unused()`: safe no-op in Pion RC runtime.
pub fn arr_release_unused[T](_xs : Array[T]) -> Unit {
  ()
}

/// MoonBit `Array::release_unused(placeholder=...)`: evaluates placeholder once, safe no-op in Pion RC runtime.
pub fn arr_release_unused_with[T](_xs : Array[T], _placeholder : T) -> Unit {
  ()
}

/// MoonBit `Bytes` value equality (`a == b`).
pub fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

/// MoonBit `Bytes::make(len, fill)`: returns empty `Bytes` when `len <= 0` (no panic).
pub fn bytes_make(len : Int, fill : Byte) -> Bytes {
  if len <= 0 {
    return Bytes::new(0)
  }
  let buf = Bytes::new(len)
  let mut i = 0
  while i < len {
    buf[i] = fill
    i = i + 1
  }
  buf
}

/// MoonBit `Float::is_nan(x)`.
pub fn float_is_nan(x : Float) -> Bool {
  x != x
}

/// MoonBit `Float::from_uint(u)`: exact 32-bit UInt -> binary64 -> single-rounding binary32.
pub fn float_from_uint(u : UInt) -> Float {
  Float::from_double(u.to_double())
}

/// MoonBit `Float::reinterpret_from_uint(u)`: bit-exact IEEE-754 binary32 reinterpretation.
pub fn float_reinterpret_from_uint(u : UInt) -> Float {
  Float::from_bits(u.reinterpret_as_int())
}

/// MoonBit `Array::search_by(pred) -> Option[Int]`.
pub fn arr_search_by[T](xs : Array[T], pred : (T) -> Bool) -> Option[Int] {
  let n = xs.length()
  let mut i = 0
  while i < n {
    if pred(xs[i]) {
      return Some(i)
    }
    i = i + 1
  }
  None
}

/// MoonBit `Array::push_iter(iter)`: streams items produced by `iter` into `xs` one by one.
/// Because `arr_iter` snapshots `init_len` on construction, both streaming evaluation order
/// (`xs.push_iter([0, 0].iter().map(fn(_) { xs.length() }))`) and self-append
/// (`xs.push_iter(xs.iter())`) match MoonBit semantics.
pub fn arr_push_iter[T](xs : Array[T], it : MbtIter[T]) -> Unit {
  let step = it.next
  while true {
    match step() {
      Some(v) => xs.push(v)
      None => return
    }
  }
}

/// MoonBit `Array::rev()`: returns a new array with elements in reverse order.
pub fn arr_rev[T](xs : Array[T]) -> Array[T] {
  let out : Array[T] = []
  let mut i = xs.length() - 1
  while i >= 0 {
    out.push(xs[i])
    i = i - 1
  }
  out
}

/// MoonBit `Array::drain(begin, end)`: removes `[begin, end)` from `xs` and returns the removed elements.
pub fn arr_drain[T](xs : Array[T], begin : Int, end : Int) -> Array[T] {
  let n = xs.length()
  if begin < 0 || end < begin || end > n {
    panic("Array::drain: index out of bounds")
  }
  let removed : Array[T] = []
  let mut i = begin
  while i < end {
    removed.push(xs[i])
    i = i + 1
  }
  let count = end - begin
  if count > 0 {
    let mut dst = begin
    let mut src = end
    while src < n {
      xs[dst] = xs[src]
      dst = dst + 1
      src = src + 1
    }
    let mut k = 0
    while k < count {
      let _ = xs.pop()
      k = k + 1
    }
  }
  removed
}

/// MoonBit `Option::map_or(default, f)`: returns `f(v)` for `Some(v)` or `default` for `None`.
pub fn opt_map_or[T, U](o : Option[T], default : U, f : (T) -> U) -> U {
  match o {
    Some(v) => f(v)
    None => default
  }
}

/// MoonBit `Option::bind(f)`: flat-maps `Option[T]` with `f : (T) -> Option[U]`.
pub fn opt_bind[T, U](o : Option[T], f : (T) -> Option[U]) -> Option[U] {
  match o {
    Some(v) => f(v)
    None => None
  }
}

/// MoonBit `Char::is_ascii_alphabetic()`.
pub fn char_is_ascii_alphabetic(c : Char) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}
