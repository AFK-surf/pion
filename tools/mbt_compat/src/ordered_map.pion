///| mbt_compat/ordered_map: MoonBit `Map[K, V]` semantics.
///|
///| MoonBit maps iterate in insertion order: `set` on an existing key keeps its
///| position and replaces the value, `remove` followed by `set` moves the key
///| to the end, and keys may be any `Hash + Eq` type (enums, tuples holding
///| `String`, ...). Pion's `Map` iterates in hash order and only takes scalar,
///| `String` and POD keys, so translated code uses `OrderedMap` instead.
///|
///| Storage: entries live in insertion order in parallel arrays (removed ones
///| become tombstones and are compacted once they outnumber the live ones), and
///| an open-addressing table with linear probing maps hashes to entry indexes.
///| Keys are hashed and compared through two functions fixed at construction:
///| `new()` takes them from the `MapKey` trait (implemented here for every
///| scalar type and `String`), `new_by(hash, eq)` takes them as closures, which
///| covers enums, tuples and any other key type.
///|
///| Mutating a map from inside `each` / `eachi` is not supported (as in
///| MoonBit, where the outcome is unspecified).

/// Key types usable with `OrderedMap::new()` / `from_array`.
pub trait MapKey {
  key_hash(self : Self) -> Int
  key_eq(self : Self, other : Self) -> Bool
}

/// MoonBit xxHash32 `Hasher` (seed=0 default, bit-for-bit identical to MoonBit wasm-gc `core/builtin/hasher.mbt`).
pub struct MbtHasher {
  mut acc : UInt
}

fn mbt_rotl32(x : UInt, r : Int) -> UInt {
  (x << r) | (x >> (32 - r))
}

pub fn MbtHasher::new(seed~ : Int = 0) -> MbtHasher {
  MbtHasher::{ acc: seed.reinterpret_as_uint() + 0x165667B1U }
}

pub fn MbtHasher::consume4(self : MbtHasher, x : UInt) -> Unit {
  self.acc = mbt_rotl32(self.acc + x * 0xC2B2AE3DU, 17) * 0x27D4EB2FU
}

pub fn MbtHasher::consume1(self : MbtHasher, b : Byte) -> Unit {
  self.acc = mbt_rotl32(self.acc + b.to_int().reinterpret_as_uint() * 0x165667B1U, 11) * 0x9E3779B1U
}

pub fn MbtHasher::combine_uint(self : MbtHasher, v : UInt) -> Unit {
  self.acc = self.acc + 4U
  self.consume4(v)
}

pub fn MbtHasher::combine_unit(self : MbtHasher) -> Unit {
  self.combine_uint(0U)
}

pub fn MbtHasher::combine_int(self : MbtHasher, v : Int) -> Unit {
  self.combine_uint(v.reinterpret_as_uint())
}

pub fn MbtHasher::combine_bool(self : MbtHasher, v : Bool) -> Unit {
  self.combine_uint(if v { 1U } else { 0U })
}

pub fn MbtHasher::combine_char(self : MbtHasher, v : Char) -> Unit {
  self.combine_uint(v.to_int().reinterpret_as_uint())
}

pub fn MbtHasher::combine_byte(self : MbtHasher, b : Byte) -> Unit {
  self.consume1(b)
}

pub fn MbtHasher::combine_int64(self : MbtHasher, v : Int64) -> Unit {
  let u = v.reinterpret_as_uint64()
  self.acc = self.acc + 8U
  self.consume4(u.to_int().reinterpret_as_uint())
  self.consume4((u >> 32UL).to_int().reinterpret_as_uint())
}

pub fn MbtHasher::combine_uint64(self : MbtHasher, v : UInt64) -> Unit {
  self.combine_int64(v.reinterpret_as_int64())
}

pub fn MbtHasher::combine_double(self : MbtHasher, v : Double) -> Unit {
  let b = v.to_bits()
  self.combine_int64(if b == 0x8000000000000000UL.reinterpret_as_int64() { 0L } else { b })
}

pub fn MbtHasher::combine_string(self : MbtHasher, s : String) -> Unit {
  let n = utf16_len(s)
  let mut i = 0
  while i < n {
    self.combine_uint(utf16_code_unit_at(s, i).reinterpret_as_uint())
    i = i + 1
  }
}

pub fn MbtHasher::finalize(self : MbtHasher) -> Int {
  let mut a = self.acc
  a = a ^ (a >> 15)
  a = a * 0x85EBCA77U
  a = a ^ (a >> 13)
  a = a * 0xC2B2AE3DU
  a = a ^ (a >> 16)
  a.reinterpret_as_int()
}

/// MoonBit `Hash` trait compatibility for `Hash::hash(k)` and `#derive(Hash)`.
pub trait MbtHash {
  hash_combine(self : Self, hasher : MbtHasher) -> Unit
}

/// MoonBit `Hash::hash(x)` entry point (xxHash32 with seed=0).
pub fn mbt_hash[T : MbtHash](x : T) -> Int {
  let h = MbtHasher::new()
  x.hash_combine(h)
  h.finalize()
}

impl MbtHash for Int {
  fn hash_combine(self : Int, hasher : MbtHasher) -> Unit {
    hasher.combine_int(self)
  }
}

impl MbtHash for Int64 {
  fn hash_combine(self : Int64, hasher : MbtHasher) -> Unit {
    hasher.combine_int64(self)
  }
}

impl MbtHash for UInt {
  fn hash_combine(self : UInt, hasher : MbtHasher) -> Unit {
    hasher.combine_uint(self)
  }
}

impl MbtHash for UInt64 {
  fn hash_combine(self : UInt64, hasher : MbtHasher) -> Unit {
    hasher.combine_uint64(self)
  }
}

impl MbtHash for Double {
  fn hash_combine(self : Double, hasher : MbtHasher) -> Unit {
    hasher.combine_double(self)
  }
}

impl MbtHash for Byte {
  fn hash_combine(self : Byte, hasher : MbtHasher) -> Unit {
    hasher.combine_byte(self)
  }
}

impl MbtHash for Char {
  fn hash_combine(self : Char, hasher : MbtHasher) -> Unit {
    hasher.combine_char(self)
  }
}

impl MbtHash for Bool {
  fn hash_combine(self : Bool, hasher : MbtHasher) -> Unit {
    hasher.combine_bool(self)
  }
}

impl MbtHash for String {
  fn hash_combine(self : String, hasher : MbtHasher) -> Unit {
    hasher.combine_string(self)
  }
}

impl MbtHash for Unit {
  fn hash_combine(self : Unit, hasher : MbtHasher) -> Unit {
    let _ = self
    hasher.combine_unit()
  }
}

impl MbtHash for Float {
  fn hash_combine(self : Float, hasher : MbtHasher) -> Unit {
    let bits = self.reinterpret_as_uint()
    hasher.combine_uint(if bits == 0x80000000U { 0U } else { bits })
  }
}

/// 32-bit finalizer (murmur3 fmix32) on wrapping `Int` arithmetic.
pub fn hash_mix(h : Int) -> Int {
  let mut x = h
  x = x ^ ((x >> 16) & 0xFFFF)
  x = x * -2048144789
  x = x ^ ((x >> 13) & 0x7FFFF)
  x = x * -1028477387
  x = x ^ ((x >> 16) & 0xFFFF)
  x
}

/// Combines two hashes (for composite keys built with `new_by`).
pub fn hash_combine(a : Int, b : Int) -> Int {
  hash_mix(a * 31 + b)
}

/// FNV-1a over the UTF-8 bytes of `s`, finalized with `hash_mix`.
pub fn hash_string(s : String) -> Int {
  let mut h = -2128831035
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ s.code_unit_at(i)) * 16777619
    i = i + 1
  }
  hash_mix(h)
}

impl MapKey for Int {
  fn key_hash(self : Int) -> Int {
    hash_mix(self)
  }

  fn key_eq(self : Int, other : Int) -> Bool {
    self == other
  }
}

impl MapKey for Int64 {
  fn key_hash(self : Int64) -> Int {
    hash_mix((self ^ (self >> 32L)).to_int())
  }

  fn key_eq(self : Int64, other : Int64) -> Bool {
    self == other
  }
}

impl MapKey for UInt {
  fn key_hash(self : UInt) -> Int {
    hash_mix(self.reinterpret_as_int())
  }

  fn key_eq(self : UInt, other : UInt) -> Bool {
    self == other
  }
}

impl MapKey for UInt64 {
  fn key_hash(self : UInt64) -> Int {
    let x = self.reinterpret_as_int64()
    hash_mix((x ^ (x >> 32L)).to_int())
  }

  fn key_eq(self : UInt64, other : UInt64) -> Bool {
    self == other
  }
}

impl MapKey for Double {
  fn key_hash(self : Double) -> Int {
    double_hash(self)
  }

  fn key_eq(self : Double, other : Double) -> Bool {
    self == other
  }
}

impl MapKey for Byte {
  fn key_hash(self : Byte) -> Int {
    hash_mix(self.to_int())
  }

  fn key_eq(self : Byte, other : Byte) -> Bool {
    self == other
  }
}

impl MapKey for Char {
  fn key_hash(self : Char) -> Int {
    hash_mix(self.to_int())
  }

  fn key_eq(self : Char, other : Char) -> Bool {
    self == other
  }
}

impl MapKey for Bool {
  fn key_hash(self : Bool) -> Int {
    if self {
      1
    } else {
      0
    }
  }

  fn key_eq(self : Bool, other : Bool) -> Bool {
    self == other
  }
}

impl MapKey for String {
  fn key_hash(self : String) -> Int {
    hash_string(self)
  }

  fn key_eq(self : String, other : String) -> Bool {
    self == other
  }
}

let SLOT_EMPTY : Int = -1
let SLOT_DELETED : Int = -2

pub struct OrderedMap[K, V] {
  hash_fn : (K) -> Int
  eq_fn : (K, K) -> Bool
  mut ekeys : Array[K]
  mut evals : Array[V]
  mut ehash : Array[Int]
  mut elive : Array[Bool]
  mut slots : Array[Int]
  mut count : Int
  mut used : Int
}

fn empty_slots(cap : Int) -> Array[Int] {
  Array::make(cap, SLOT_EMPTY)
}

/// Empty map whose keys hash and compare with `hash` / `eq` (any key type).
pub fn OrderedMap::new_by[K, V](
  hash : (K) -> Int,
  eq : (K, K) -> Bool,
) -> OrderedMap[K, V] {
  OrderedMap::{
    hash_fn: hash,
    eq_fn: eq,
    ekeys: [],
    evals: [],
    ehash: [],
    elive: [],
    slots: empty_slots(8),
    count: 0,
    used: 0,
  }
}

/// Empty map for a `MapKey` key type (MoonBit `Map::new()` / `{}`).
pub fn OrderedMap::new[K : MapKey, V]() -> OrderedMap[K, V] {
  ordered_map_new()
}

/// MoonBit `Map::from_array` / map literal: later duplicates replace the value
/// and keep the first position.
pub fn OrderedMap::from_array[K : MapKey, V](
  pairs : Array[(K, V)],
) -> OrderedMap[K, V] {
  ordered_map_from_array(pairs)
}

/// Free-function form of `OrderedMap::new()`. Use this one from other
/// packages: pionc 0.1.0 resolves the trait bound of an imported *static*
/// method in the caller's package and reports `E_TRAIT_NOT_IMPLEMENTED`
/// (free generic functions are checked correctly).
pub fn ordered_map_new[K : MapKey, V]() -> OrderedMap[K, V] {
  OrderedMap::new_by(fn(k : K) -> Int { k.key_hash() }, fn(a : K, b : K) -> Bool {
    a.key_eq(b)
  })
}

/// Free-function form of `OrderedMap::from_array()` (see `ordered_map_new`).
pub fn ordered_map_from_array[K : MapKey, V](
  pairs : Array[(K, V)],
) -> OrderedMap[K, V] {
  let m : OrderedMap[K, V] = ordered_map_new()
  for p in pairs {
    m.set(p.0, p.1)
  }
  m
}

/// Slot holding `k` (with hash `h`), or -1.
fn OrderedMap::find_slot[K, V](self : OrderedMap[K, V], k : K, h : Int) -> Int {
  let mask = self.slots.length() - 1
  let mut i = h & mask
  while true {
    let e = self.slots[i]
    if e == SLOT_EMPTY {
      return -1
    }
    if e >= 0 && self.ehash[e] == h && self.eq_fn(self.ekeys[e], k) {
      return i
    }
    i = (i + 1) & mask
  }
  -1
}

/// Rebuilds the table at capacity `cap`, dropping tombstoned entries.
fn OrderedMap::rebuild[K, V](self : OrderedMap[K, V], cap : Int) -> Unit {
  let nk : Array[K] = []
  let nv : Array[V] = []
  let nh : Array[Int] = []
  let nl : Array[Bool] = []
  let slots = empty_slots(cap)
  let mask = cap - 1
  let n = self.ekeys.length()
  let mut i = 0
  while i < n {
    if self.elive[i] {
      let idx = nk.length()
      let h = self.ehash[i]
      nk.push(self.ekeys[i])
      nv.push(self.evals[i])
      nh.push(h)
      nl.push(true)
      let mut j = h & mask
      while slots[j] != SLOT_EMPTY {
        j = (j + 1) & mask
      }
      slots[j] = idx
    }
    i = i + 1
  }
  self.ekeys = nk
  self.evals = nv
  self.ehash = nh
  self.elive = nl
  self.slots = slots
  self.used = self.count
}

fn table_cap_for(count : Int) -> Int {
  let mut cap = 8
  while cap * 3 <= (count + 1) * 4 {
    cap = cap * 2
  }
  cap
}

/// MoonBit `m.set(k, v)` / `m[k] = v`.
pub fn OrderedMap::set[K, V](self : OrderedMap[K, V], k : K, v : V) -> Unit {
  let h = self.hash_fn(k)
  let s = self.find_slot(k, h)
  if s >= 0 {
    self.evals[self.slots[s]] = v
    return
  }
  if (self.used + 1) * 4 >= self.slots.length() * 3 {
    self.rebuild(table_cap_for(self.count + 1))
  }
  let idx = self.ekeys.length()
  self.ekeys.push(k)
  self.evals.push(v)
  self.ehash.push(h)
  self.elive.push(true)
  let mask = self.slots.length() - 1
  let mut j = h & mask
  while self.slots[j] >= 0 {
    j = (j + 1) & mask
  }
  if self.slots[j] == SLOT_EMPTY {
    self.used = self.used + 1
  }
  self.slots[j] = idx
  self.count = self.count + 1
}

/// MoonBit `m.get(k)`.
pub fn OrderedMap::get[K, V](self : OrderedMap[K, V], k : K) -> Option[V] {
  let s = self.find_slot(k, self.hash_fn(k))
  if s < 0 {
    None
  } else {
    Some(self.evals[self.slots[s]])
  }
}

/// MoonBit `m.get_or_default(k, d)`.
pub fn OrderedMap::get_or_default[K, V](
  self : OrderedMap[K, V],
  k : K,
  d : V,
) -> V {
  let s = self.find_slot(k, self.hash_fn(k))
  if s < 0 {
    d
  } else {
    self.evals[self.slots[s]]
  }
}

/// MoonBit `m.contains(k)`.
pub fn OrderedMap::contains[K, V](self : OrderedMap[K, V], k : K) -> Bool {
  self.find_slot(k, self.hash_fn(k)) >= 0
}

/// MoonBit `m.remove(k)`: no-op when absent.
pub fn OrderedMap::remove[K, V](self : OrderedMap[K, V], k : K) -> Unit {
  let s = self.find_slot(k, self.hash_fn(k))
  if s < 0 {
    return
  }
  let e = self.slots[s]
  self.slots[s] = SLOT_DELETED
  self.elive[e] = false
  self.count = self.count - 1
  let dead = self.ekeys.length() - self.count
  if dead > 8 && dead > self.count {
    self.rebuild(table_cap_for(self.count))
  }
}

/// MoonBit `m.size()` / `m.length()`.
pub fn OrderedMap::size[K, V](self : OrderedMap[K, V]) -> Int {
  self.count
}

/// MoonBit `m.is_empty()`.
pub fn OrderedMap::is_empty[K, V](self : OrderedMap[K, V]) -> Bool {
  self.count == 0
}

/// MoonBit `m.clear()`.
pub fn OrderedMap::clear[K, V](self : OrderedMap[K, V]) -> Unit {
  self.ekeys = []
  self.evals = []
  self.ehash = []
  self.elive = []
  self.slots = empty_slots(8)
  self.count = 0
  self.used = 0
}

/// MoonBit `m.each(fn(k, v) { ... })`, insertion order.
pub fn OrderedMap::each[K, V](
  self : OrderedMap[K, V],
  f : (K, V) -> Unit,
) -> Unit {
  let n = self.ekeys.length()
  let mut i = 0
  while i < n {
    if self.elive[i] {
      f(self.ekeys[i], self.evals[i])
    }
    i = i + 1
  }
}

/// MoonBit `m.eachi(fn(i, k, v) { ... })`: `i` counts live entries from 0.
pub fn OrderedMap::eachi[K, V](
  self : OrderedMap[K, V],
  f : (Int, K, V) -> Unit,
) -> Unit {
  let n = self.ekeys.length()
  let mut i = 0
  let mut k = 0
  while i < n {
    if self.elive[i] {
      f(k, self.ekeys[i], self.evals[i])
      k = k + 1
    }
    i = i + 1
  }
}

/// Keys in insertion order (MoonBit `m.keys().collect()`).
pub fn OrderedMap::keys[K, V](self : OrderedMap[K, V]) -> Array[K] {
  let out : Array[K] = []
  let n = self.ekeys.length()
  let mut i = 0
  while i < n {
    if self.elive[i] {
      out.push(self.ekeys[i])
    }
    i = i + 1
  }
  out
}

/// Values in insertion order (MoonBit `m.values().collect()`).
pub fn OrderedMap::values[K, V](self : OrderedMap[K, V]) -> Array[V] {
  let out : Array[V] = []
  let n = self.ekeys.length()
  let mut i = 0
  while i < n {
    if self.elive[i] {
      out.push(self.evals[i])
    }
    i = i + 1
  }
  out
}

/// `(key, value)` pairs in insertion order (MoonBit `m.to_array()`).
pub fn OrderedMap::to_array[K, V](self : OrderedMap[K, V]) -> Array[(K, V)] {
  let out : Array[(K, V)] = []
  let n = self.ekeys.length()
  let mut i = 0
  while i < n {
    if self.elive[i] {
      out.push((self.ekeys[i], self.evals[i]))
    }
    i = i + 1
  }
  out
}

/// `OrderedMap` -> Pion `Map` at an API boundary. `K` must be a Pion `Map` key
/// type (`String`, integer scalars, `Char`, `Bool`, scalar tuples / POD
/// structs); the insertion order is not kept (Pion `Map` is unordered).
pub fn ordered_map_to_map[K, V](m : OrderedMap[K, V]) -> Map[K, V] {
  let out : Map[K, V] = Map::new()
  m.each(fn(k : K, v : V) -> Unit { out.set(k, v) })
  out
}

/// Pion `Map` -> `OrderedMap` at an API boundary. Entries are inserted in the
/// Pion `Map`'s iteration order (`keys()`), which is the only order it has.
pub fn ordered_map_from_map[K : MapKey, V](m : Map[K, V]) -> OrderedMap[K, V] {
  let out : OrderedMap[K, V] = ordered_map_new()
  for k in m.keys() {
    match m.get(k) {
      Some(v) => out.set(k, v)
      None => ()
    }
  }
  out
}

/// Top-level helper wrappers matching `mbt2pion` Stage B rewrites.
pub fn ordered_map_size[K, V](m : OrderedMap[K, V]) -> Int {
  m.size()
}

pub fn ordered_map_each[K, V](m : OrderedMap[K, V], f : (K, V) -> Unit) -> Unit {
  m.each(f)
}

pub fn ordered_map_iter[K, V](m : OrderedMap[K, V]) -> Array[(K, V)] {
  m.to_array()
}

/// Live order-preserving cursor accessors for `for k, v in map` lowering.
/// Reading `slot_val(i)` at visit time reflects in-place updates to existing keys.
pub fn OrderedMap::slot_len[K, V](self : OrderedMap[K, V]) -> Int {
  self.ekeys.length()
}

pub fn OrderedMap::slot_live[K, V](self : OrderedMap[K, V], i : Int) -> Bool {
  self.elive[i]
}

pub fn OrderedMap::slot_key[K, V](self : OrderedMap[K, V], i : Int) -> K {
  self.ekeys[i]
}

pub fn OrderedMap::slot_val[K, V](self : OrderedMap[K, V], i : Int) -> V {
  self.evals[i]
}
