    (3, "1953125"),
    (4, "9765625"),
    (4, "48828125"),
    (4, "244140625"),
    (4, "1220703125"),
    (5, "6103515625"),
    (5, "30517578125"),
    (5, "152587890625"),
    (6, "762939453125"),
    (6, "3814697265625"),
    (6, "19073486328125"),
    (7, "95367431640625"),
    (7, "476837158203125"),
    (7, "2384185791015625"),
    (7, "11920928955078125"),
    (8, "59604644775390625"),
    (8, "298023223876953125"),
    (8, "1490116119384765625"),
    (9, "7450580596923828125"),
    (9, "37252902984619140625"),
    (9, "186264514923095703125"),
    (10, "931322574615478515625"),
    (10, "4656612873077392578125"),
    (10, "23283064365386962890625"),
    (10, "116415321826934814453125"),
    (11, "582076609134674072265625"),
    (11, "2910383045673370361328125"),
    (11, "14551915228366851806640625"),
    (12, "72759576141834259033203125"),
    (12, "363797880709171295166015625"),
    (12, "1818989403545856475830078125"),
    (13, "9094947017729282379150390625"),
    (13, "45474735088646411895751953125"),
    (13, "227373675443232059478759765625"),
    (13, "1136868377216160297393798828125"),
    (14, "5684341886080801486968994140625"),
    (14, "28421709430404007434844970703125"),
    (14, "142108547152020037174224853515625"),
    (15, "710542735760100185871124267578125"),
    (15, "3552713678800500929355621337890625"),
    (15, "17763568394002504646778106689453125"),
    (16, "88817841970012523233890533447265625"),
    (16, "444089209850062616169452667236328125"),
    (16, "2220446049250313080847263336181640625"),
    (16, "11102230246251565404236316680908203125"),
    (17, "55511151231257827021181583404541015625"),
    (17, "277555756156289135105907917022705078125"),
    (17, "1387778780781445675529539585113525390625"),
    (18, "6938893903907228377647697925567626953125"),
    (18, "34694469519536141888238489627838134765625"),
    (18, "173472347597680709441192448139190673828125"),
    (19, "867361737988403547205962240695953369140625"),
  ]
  tbl[s]
}

fn decimal_trim(self : ParseDecimal) -> Unit {
  while self.digits_num > 0 && self.digits[self.digits_num - 1].to_int() == 0 {
    self.digits_num = self.digits_num - 1
  }
  if self.digits_num == 0 {
    self.decimal_point = 0
  }
}

fn decimal_new_digits(self : ParseDecimal, s : Int) -> Int {
  let (nd, cheat_num) = left_shift_cheat(s)
  let mut less = false
  let cn = cheat_num.length()
  let mut i = 0
  while i < cn {
    if i >= self.digits_num {
      less = true
      break
    }
    let d = cheat_num.code_unit_at(i) - 48
    let sd = self.digits[i].to_int()
    if sd != d {
      less = sd < d
      break
    }
    i = i + 1
  }
  if less { nd - 1 } else { nd }
}

fn decimal_left_shift(self : ParseDecimal, s : Int) -> Unit {
  let new_digits = decimal_new_digits(self, s)
  let mut read_index = self.digits_num - 1
  let mut write_index = self.digits_num + new_digits
  let mut acc : Int64 = 0L
  while read_index >= 0 {
    let d = self.digits[read_index].to_int().to_int64()
    acc = acc + (d << s)
    let quo = acc / 10L
    let rem = (acc - quo * 10L).to_int()
    write_index = write_index - 1
    if write_index < self.digits.length() {
      self.digits[write_index] = rem.to_byte()
    } else if rem != 0 {
      self.truncated = true
    }
    acc = quo
    read_index = read_index - 1
  }
  while acc > 0L {
    let quo = acc / 10L
    let rem = (acc - 10L * quo).to_int()
    write_index = write_index - 1
    if write_index < self.digits.length() {
      self.digits[write_index] = rem.to_byte()
    } else if rem != 0 {
      self.truncated = true
    }
    acc = quo
  }
  self.digits_num = self.digits_num + new_digits
  if self.digits_num > self.digits.length() {
    self.digits_num = self.digits.length()
  }
  self.decimal_point = self.decimal_point + new_digits
  decimal_trim(self)
}

fn decimal_right_shift(self : ParseDecimal, s : Int) -> Unit {
  let mut read_index = 0
  let mut write_index = 0
  let mut acc : UInt64 = 0UL
  while (acc >> s) == 0UL {
    if read_index >= self.digits_num {
      while (acc >> s) == 0UL {
        acc = acc * 10UL
        read_index = read_index + 1
      }
      break
    }
    let d = self.digits[read_index].to_int().to_int64().reinterpret_as_uint64()
    acc = acc * 10UL + d
    read_index = read_index + 1
  }
  self.decimal_point = self.decimal_point - (read_index - 1)
  let mask : UInt64 = (1UL << s) - 1UL
  while read_index < self.digits_num {
    let out = acc >> s
    self.digits[write_index] = out.to_int().to_byte()
    write_index = write_index + 1
    acc = acc & mask
    let d = self.digits[read_index].to_int().to_int64().reinterpret_as_uint64()
    acc = acc * 10UL + d
    read_index = read_index + 1
  }
  while acc > 0UL {
    let out = acc >> s
    if write_index < self.digits.length() {
      self.digits[write_index] = out.to_int().to_byte()
      write_index = write_index + 1
    } else if out > 0UL {
      self.truncated = true
    }
    acc = (acc & mask) * 10UL
  }
  self.digits_num = write_index
  decimal_trim(self)
}

fn decimal_shift(self : ParseDecimal, s_in : Int) -> Unit {
  if self.digits_num == 0 {
    return
  }
  let max_shift = 59
  let mut s = s_in
  if s > 0 {
    while s > max_shift {
      decimal_left_shift(self, max_shift)
      s = s - max_shift
    }
    decimal_left_shift(self, s)
  } else if s < 0 {
    while s < -max_shift {
      decimal_right_shift(self, max_shift)
      s = s + max_shift
    }
    decimal_right_shift(self, -s)
  }
}

fn decimal_should_round_up(self : ParseDecimal, d : Int) -> Bool {
  if d < 0 || d >= self.digits_num {
    return false
  }
  let dig = self.digits[d].to_int()
  if dig == 5 && d + 1 == self.digits_num {
    if self.truncated {
      return true
    }
    return d > 0 && (self.digits[d - 1].to_int() % 2) != 0
  }
  dig >= 5
}

fn decimal_rounded_integer(self : ParseDecimal) -> Int64 {
  if self.decimal_point > 20 {
    return -1L
  }
  let mut n : Int64 = 0L
  let mut i = 0
  while i < self.decimal_point && i < self.digits_num {
    n = n * 10L + self.digits[i].to_int().to_int64()
    i = i + 1
  }
  while i < self.decimal_point {
    n = n * 10L
    i = i + 1
  }
  if decimal_should_round_up(self, self.decimal_point) {
    n + 1L
  } else {
    n
  }
}

fn assemble_double_bits(mantissa : Int64, exponent : Int, negative : Bool) -> Int64 {
  let biased_exp = exponent + 1023
  let mut bits = mantissa & ((1L << 52) - 1L)
  let exp_bits = (biased_exp & 0x7FF).to_int64()
  bits = bits | (exp_bits << 52)
  if negative {
    bits = bits | 0x8000000000000000UL.reinterpret_as_int64()
  }
  bits
}

fn decimal_to_double(self : ParseDecimal) -> Result[Double, String] {
  let mut exponent = 0
  let mut mantissa : Int64 = 0L
  let effective_dp = self.decimal_point + self.overflowed
  if self.digits_num == 0 || effective_dp < -330 {
    let bits = assemble_double_bits(0L, -1023, self.negative)
    return Ok(Double::from_bits(bits))
  }
  if effective_dp > 310 {
    return Err("value out of range")
  }
  self.decimal_point = effective_dp

  // Scale by powers of 2 until in range [0.5, 1)
  while self.decimal_point > 0 {
    let n = powtab_at(self.decimal_point)
    decimal_shift(self, -n)
    exponent = exponent + n
  }
  while self.decimal_point < 0 || (self.decimal_point == 0 && self.digits[0].to_int() < 5) {
    let n = powtab_at(-self.decimal_point)
    decimal_shift(self, n)
    exponent = exponent - n
  }

  // Normalized range is [1, 2), currently [0.5, 1)
  exponent = exponent - 1

  // Subnormal floor: minimum normal exponent is -1022
  if exponent < -1022 {
    let n = -1022 - exponent
    decimal_shift(self, -n)
    exponent = exponent + n
  }
  if exponent + 1023 >= 2047 {
    return Err("value out of range")
  }

  // Extract 53-bit rounded significand
  decimal_shift(self, 53)
  mantissa = decimal_rounded_integer(self)

  // Rounding carry out of bit 52
  if mantissa == (2L << 52) {
    mantissa = mantissa >> 1
    exponent = exponent + 1
    if exponent + 1023 >= 2047 {
      return Err("value out of range")
    }
  }

  // Subnormal encoding
  if (mantissa & (1L << 52)) == 0L {
    exponent = -1023
  }

  let bits = assemble_double_bits(mantissa, exponent, self.negative)
  Ok(Double::from_bits(bits))
}

/// Validate underscores in a decimal floating-point literal (MoonBit `check_underscore` rules).
/// Underscores may only appear between two ASCII decimal digits (never leading, trailing,
/// consecutive, or adjacent to `.`, `e`, `E`, `+`, `-`, or letters).
fn check_double_underscore(s : String) -> Bool {
  if !s.contains("_") {
    return true
  }
  let n = s.length()
  let mut i = 0
  if i < n && (s.code_unit_at(i) == 43 || s.code_unit_at(i) == 45) {
    i = i + 1
  }
  let mut allow_underscore = false
  let mut follow_underscore = false
  while i < n {
    let c = s.code_unit_at(i)
    if c == 95 {
      if i + 1 == n || !allow_underscore {
        return false
      }
      allow_underscore = false
      follow_underscore = true
    } else if c >= 48 && c <= 57 {
      allow_underscore = true
      follow_underscore = false
    } else {
      if follow_underscore {
        return false
      }
      allow_underscore = false
      follow_underscore = false
    }
    i = i + 1
  }
  !follow_underscore
}

/// Exact powers of 10 in IEEE-754 binary64 for Clinger's fast path (0..=22).
fn exact_pow10(exp : Int) -> Double {
  let tbl : Array[Double] = [
    1.0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22,
  ]
  tbl[exp]
}

/// MoonBit `@strconv.parse_double(s)` / `@string.parse_double(s)` non-panicking `Result` form.
/// 0-ULP exact IEEE-754 binary64 parsing:
/// - Does NOT trim leading/trailing whitespace (`" 1.5 "` -> `Err`).
/// - Supports `_` separators strictly between decimal digits (`"1_000.5"` -> `Ok(1000.5)`).
/// - Literal `"inf"`/`"infinity"`/`"nan"` (case-insensitive, optional sign) return `Ok(Inf/-Inf/NaN)`.
/// - Finite overflow (`"1.7976931348623159e308"`, `"1e309"`) returns `Err("value out of range")`.
/// - Underflow (`"1e-400"`, `"-1e-400"`) returns `Ok(0.0)` / `Ok(-0.0)`.
pub fn str_try_parse_double(s : String) -> Result[Double, String] {
  let n = s.length()
  if n == 0 {
    return Err("parse_double: empty string")
  }
  if !check_double_underscore(s) {
    return Err("parse_double: invalid underscore")
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  if i >= n {
    return Err("parse_double: no digits")
  }
  // Special literals (cannot contain underscores; already validated)
  let rest_len = n - i
  if rest_len == 3 || rest_len == 8 {
    let rest_lower = str_to_lower(s.slice(i, n))
    if rest_lower == "nan" {
      return Ok(double_nan())
    }
    if rest_lower == "inf" || rest_lower == "infinity" {
      return Ok(if neg { double_neg_inf() } else { double_inf() })
    }
  }

  let d = decimal_new()
  d.negative = neg
  let mut has_dp = false
  let mut has_digits = false
  // Fast-path accumulator (Clinger)
  let mut fast_mant : UInt64 = 0UL
  let mut fast_many = false
  let mut fast_frac_digits = 0

  while i < n {
    let c = s.code_unit_at(i)
    if c == 95 {
      i = i + 1
      continue
    }
    if c == 46 {
      if has_dp {
        return Err("parse_double: multiple decimal points")
      }
      has_dp = true
      d.decimal_point = d.digits_num
      i = i + 1
      continue
    }
    if c >= 48 && c <= 57 {
      has_digits = true
      let dig = c - 48
      if has_dp {
        fast_frac_digits = fast_frac_digits + 1
      }
      if !fast_many {
        if fast_mant <= 900719925474099UL {
          fast_mant = fast_mant * 10UL + dig.to_int64().reinterpret_as_uint64()
        } else {
          fast_many = true
        }
      }
      if dig == 0 && d.digits_num == 0 {
        if has_dp && d.decimal_point > -1000000 {
          d.decimal_point = d.decimal_point - 1
        }
        i = i + 1
        continue
      }
      if d.digits_num < d.digits.length() {
        d.digits[d.digits_num] = dig.to_byte()
        d.digits_num = d.digits_num + 1
      } else {
        if !has_dp {
          d.overflowed = d.overflowed + 1
        }
        if dig != 0 {
          d.truncated = true
        }
      }
      i = i + 1
      continue
    }
    break
  }
  if !has_digits {
    return Err("parse_double: no digits")
  }
  if !has_dp {
    d.decimal_point = d.digits_num
  }

  let mut exp_val = 0
  let mut exp_sign = 1
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    if i < n && s.code_unit_at(i) == 43 {
      i = i + 1
    } else if i < n && s.code_unit_at(i) == 45 {
      exp_sign = -1
      i = i + 1
    }
    if i >= n || !(s.code_unit_at(i) >= 48 && s.code_unit_at(i) <= 57) {
      return Err("parse_double: invalid exponent")
    }
    let effective_dp = d.decimal_point + d.overflowed
    let exp_limit = if exp_sign > 0 {
      if effective_dp < 311 { 311 - effective_dp } else { 0 }
    } else if effective_dp > -331 {
      effective_dp + 331
    } else {
      0
    }
    while i < n {
      let c = s.code_unit_at(i)
      if c == 95 {
        i = i + 1
        continue
      }
      if c >= 48 && c <= 57 {
        if exp_val < exp_limit {
          exp_val = exp_val * 10 + (c - 48)
          if exp_val > exp_limit {
            exp_val = exp_limit
          }
        }
        i = i + 1
      } else {
        break
      }
    }
    d.decimal_point = d.decimal_point + exp_sign * exp_val
  }
  if i != n {
    return Err("parse_double: trailing characters")
  }

  // Clinger fast path: exact IEEE-754 single rounding when mantissa <= 2^53 and -22 <= exp <= 22
  if !fast_many && d.overflowed == 0 && !d.truncated && fast_mant <= 9007199254740992UL {
    let total_exp = exp_sign * exp_val - fast_frac_digits
    if total_exp >= -22 && total_exp <= 22 {
      let mut v = fast_mant.reinterpret_as_int64().to_double()
      if total_exp > 0 {
        v = v * exact_pow10(total_exp)
      } else if total_exp < 0 {
        v = v / exact_pow10(-total_exp)
      }
      return Ok(if neg { -v } else { v })
    }
  }

  decimal_trim(d)
  decimal_to_double(d)
}
