///| mbt_compat/parse_double: 0-ULP exact IEEE-754 binary64 decimal string parser
///| matching MoonBit `@strconv.parse_double` / `@string.parse_double` semantics.

struct ParseDecimal {
  digits : Array[Byte]
  mut digits_num : Int
  mut decimal_point : Int
  mut negative : Bool
  mut truncated : Bool
  mut overflowed : Int
}

fn decimal_new() -> ParseDecimal {
  let digits : Array[Byte] = []
  let mut k = 0
  while k < 800 {
    digits.push(0.to_byte())
    k = k + 1
  }
  ParseDecimal::{
    digits: digits,
    digits_num: 0,
    decimal_point: 0,
    negative: false,
    truncated: false,
    overflowed: 0,
  }
}

fn powtab_at(idx : Int) -> Int {
  let tbl : Array[Int] = [
    1, 3, 6, 9, 13, 16, 19, 23, 26, 29, 33, 36, 39, 43, 46, 49, 53, 56, 59,
  ]
  if idx >= tbl.length() {
    60
  } else {
    tbl[idx]
  }
}

