import "vlib" as vlib

///| Representative `#verify` code for the Lean 4 extraction test
///| (`scripts/test-lean.sh`): loops with early exit, in-place `mut Array`
///| updates, nested struct `mut` fields, trait dictionaries, generic `==`,
///| recursive / mutually recursive types and functions, `guard`, `?`,
///| `for ..=`, literal / guarded patterns, `is` chains, Lean keywords and a
///| cross-package call.

pub struct Point {
  mut x : Int
  mut y : Int
}

pub struct Rect {
  mut lo : Point
  mut hi : Point
  mut tags : Array[Int]
}

pub enum Expr {
  Lit(Int)
  Add(Expr, Expr)
  Neg(Expr)
}

pub enum Tree {
  Leaf(Int)
  Node(Forest)
}

pub struct Forest {
  trees : Array[Tree]
}

#derive(Eq)
pub enum Color {
  Red
  Green
  Blue
}

pub trait Shape {
  area(self : Self) -> Int
  grow(mut self : Self, d : Int) -> Unit
}

#verify
pub fn swap(mut a : Int, mut b : Int) -> Unit {
  let t = a
  a = b
  b = t
}

#verify
pub fn avg2(a : Int, b : Int) -> Int {
  (a + b) / 2
}

#verify
pub fn sum(xs : Array[Int]) -> Int {
  let mut s = 0
  for x in xs {
    s = s + x
  }
  s
}

#verify
pub fn binary_search(xs : Array[Int], target : Int) -> Option[Int] {
  let mut lo = 0
  let mut hi = xs.length()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let v = xs[mid]
    if v == target {
      return Some(mid)
    }
    if v < target {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  None
}

#verify
pub fn insertion_sort(mut a : Array[Int]) -> Unit {
  let n = a.length()
  for i in 1..n {
    let mut j = i
    while j > 0 && a[j - 1] > a[j] {
      a.swap(j - 1, j)
      j = j - 1
    }
  }
}

#verify
pub fn find_first_neg(xs : Array[Int]) -> Int {
  let mut i = 0
  for x in xs {
    if x >= 0 {
      i = i + 1
      continue
    }
    break
  }
  i
}

#verify
pub fn move_rect(mut r : Rect, dx : Int) -> Unit {
  r.lo.x = r.lo.x + dx
  r.hi.x += dx
  swap(mut r.lo.y, mut r.hi.y)
  r.tags.push(dx)
}

#verify
impl Shape for Rect {
  fn area(self : Rect) -> Int {
    (self.hi.x - self.lo.x) * (self.hi.y - self.lo.y)
  }

  fn grow(mut self : Rect, d : Int) -> Unit {
    self.hi.x = self.hi.x + d
    self.hi.y = self.hi.y + d
  }
}

#verify
pub fn total_area[T : Shape](shapes : Array[T]) -> Int {
  let mut t = 0
  for s in shapes {
    t = t + s.area()
  }
  t
}

#verify
pub fn grow_twice[T : Shape](mut s : T) -> Unit {
  s.grow(1)
  s.grow(1)
}

#verify
pub fn grow_rect(mut r : Rect) -> Int {
  grow_twice(mut r)
  r.area()
}

#verify
pub fn count_eq[T](xs : Array[T], v : T) -> Int {
  let mut c = 0
  for x in xs {
    if x == v {
      c = c + 1
    }
  }
  c
}

#verify
pub fn count_red(cs : Array[Color]) -> Int {
  count_eq(cs, Red)
}

#verify
pub fn eval(e : Expr) -> Int {
  match e {
    Lit(v) => v
    Add(a, b) => eval(a) + eval(b)
    Neg(a) => 0 - eval(a)
  }
}

#verify
pub fn is_even(n : Int) -> Bool {
  if n <= 0 {
    true
  } else {
    is_odd(n - 1)
  }
}

#verify
pub fn is_odd(n : Int) -> Bool {
  if n <= 0 {
    false
  } else {
    is_even(n - 1)
  }
}

#verify
pub fn tree_leaf(t : Tree) -> Int {
  match t {
    Leaf(v) => v
    Node(_) => -1
  }
}

#verify
pub fn tree_sum(t : Tree) -> Int {
  match t {
    Leaf(v) => v
    Node(f) => {
      let mut s = 0
      for c in f.trees {
        s = s + tree_sum(c)
      }
      s
    }
  }
}

#verify
pub fn checked_div(a : Int, b : Int) -> Result[Int, String] {
  guard b != 0 else {
    return Err("division by zero")
  }
  Ok(a / b)
}

#verify
pub fn div_sum(a : Int, b : Int, c : Int) -> Result[Int, String] {
  let x = checked_div(a, b)?
  let y = checked_div(a, c)?
  Ok(x + y)
}

#verify
pub fn sum_inclusive(n : Int) -> Int {
  let mut s = 0
  for i in 0..=n {
    s = s + i
  }
  s
}

#verify
pub fn classify(n : Int) -> Int {
  match n {
    0 => 0
    1 => 10
    x if x < 0 => -1
    _ => 100
  }
}

#verify
pub fn first_pos(xs : Array[Option[Int]]) -> Int {
  for x in xs {
    if x is Some(v) && v > 0 {
      return v
    }
  }
  -1
}

#verify
pub fn fun(end : Int, at : Int) -> Int {
  let then = end + at
  then * 2
}

#verify
pub fn bump_acc(mut a : vlib::Acc) -> Int {
  a.record(5)
  vlib::add_to(mut a.total, 1)
  a.total
}

#verify
pub fn shift_mix(a : Int, b : Int) -> Int {
  let x = a << 3
  let y = x >> b
  y % 7 - (a ^ b) & 15
}

pub let LIMIT : Int = 100

pub let HALF : Int = LIMIT / 2

pub struct Pair {
  a : Int
  b : Int
}

#verify
pub fn scaled(x : Int, k~ : Int = 3, off? : Int) -> Int {
  x * k + off.unwrap_or(0)
}

#verify
pub fn misc(p : Pair, c : Color, s : String) -> (Int, Int64, Bool) {
  let q = Pair::{ ..p, a: p.a + LIMIT }
  let (u, v) = (q.a, q.b)
  let w = scaled(u, off=1) + scaled(v, k=2) + HALF
  debug_assert(w != 0, "w is never zero here")
  let big = w.to_int64() * 3L
  let red = c == .Red
  let n = (s + "!").length()
  let fa : FixedArray[Int] = [1, 2, 3]
  let total = fa[0] + fa.length() + n
  (total, big, red && !(s.length() == 0))
}

#verify
pub fn uses_opaque(s : String) -> Int {
  vlib::opaque_len(s) + 1
}
