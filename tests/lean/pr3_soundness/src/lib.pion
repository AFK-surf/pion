import "pr3_dep" as dep

///| Regression suite for PR-3: 13 LLBC & Lean extractor soundness and compilation bugs.

pub struct Box1 {
  mut n : Int
}

pub struct Pt {
  mut x : Int
  mut y : Int
}

pub struct Rect2 {
  mut lo : Pt
  mut hi : Pt
}

pub struct Meter {
  v : Int
}

pub struct Km {
  v : Int
}

#into
#verify
pub fn Meter::from_km(k : Km) -> Meter {
  Meter::{ v: k.v * 1000 }
}

pub struct SubErr {
  code : Int
}

pub struct TopErr {
  code : Int
}

#into
#verify
pub fn TopErr::from_sub(e : SubErr) -> TopErr {
  TopErr::{ code: e.code + 100 }
}

pub struct NamedItem {
  name : Int
}

#verify
fn tick_3_ret_7(mut n : Int) -> Int {
  n = 3
  7
}

#verify
fn bump(mut n : Int) -> Int {
  n = n + 1
  n
}

#verify
fn bump_true(mut n : Int) -> Bool {
  n = n + 1
  true
}

#verify
fn step_false(mut n : Int) -> Bool {
  n = 2
  false
}

#verify
fn stop_mut(mut x : Int) -> Int {
  x = 3
  4
}

#verify
fn change_pt(mut p : Pt) -> Int {
  p = Pt::{ x: 7, y: 8 }
  9
}

// 1. Field compound assignment `b.n += 2` and nested `r.hi.x += dx`
#verify
pub fn c_01_field_compound_assign() -> Int {
  let mut b = Box1::{ n: 10 }
  b.n += 2
  let mut r = Rect2::{ lo: Pt::{ x: 1, y: 2 }, hi: Pt::{ x: 5, y: 6 } }
  r.hi.x += 4
  b.n * 100 + r.hi.x
}

// 2. String indexing `"A"[0]` == 65
#verify
pub fn c_02_string_index() -> Int {
  let s = "ABC"
  s[0] * 1000 + s[2]
}

#verify
pub fn c_02_string_index_oob() -> Int {
  let s = "A"
  s[5]
}

// 3. `#into` call-site argument conversion (direct + optional `name=value`)
pub struct Cm {
  v : Int
}

#into
#verify
pub fn Cm::to_meter(self : Cm) -> Meter {
  Meter::{ v: self.v / 100 }
}

#verify
fn take_meter(into m : Meter, into extra? : Meter) -> Int {
  let e = match extra {
    Some(x) => x.v
    None => 0
  }
  m.v + e
}

#verify
pub fn c_03_into_call_arg() -> Int {
  let a = Km::{ v: 2 }
  let b = Cm::{ v: 500 }
  take_meter(a, extra=b)
}

// 4. `?` error propagation with `#into` conversion
#verify
fn fail_sub() -> Result[Int, SubErr] {
  Err(SubErr::{ code: 7 })
}

#verify
fn wrap_try() -> Result[Int, TopErr] {
  let v = fail_sub()?
  Ok(v)
}

#verify
pub fn c_04_try_into_err() -> Int {
  match wrap_try() {
    Ok(v) => v
    Err(e) => e.code
  }
}

// 5. Lean keyword `name` escaping + reserved item collision `ok` vs `ok_`
#verify
pub fn ok() -> Int {
  11
}

#verify
pub fn ok_() -> Int {
  22
}

#verify
fn read_name(name : NamedItem) -> Int {
  let name_val = name.name
  name_val
}

#verify
pub fn c_05_keyword_and_collision() -> Int {
  let item = NamedItem::{ name: 33 }
  ok() * 10000 + ok_() * 100 + read_name(item)
}

// 6. `lb_retarget` must not overwrite assignment result across `mut` write-back
#verify
pub fn c_06_retarget_mut_assign() -> Int {
  let mut n = 0
  n = tick_3_ret_7(mut n)
  n
}

// 7. Range `..<` / `..=` start snapshotted before end evaluation mutates it
#verify
pub fn c_07_range_start_snapshot() -> Int {
  let mut x = 1
  let mut s1 = 0
  for i in x..<stop_mut(mut x) {
    s1 = s1 + i
  }
  let mut y = 1
  let mut s2 = 0
  for j in y..=stop_mut(mut y) {
    s2 = s2 + j
  }
  s1 * 100 + s2
}

// 8. Struct update `..base` snapshotted before field initializers mutate base
#verify
pub fn c_08_struct_update_base() -> Int {
  let mut p = Pt::{ x: 1, y: 2 }
  let q = Pt::{ ..p, y: change_pt(mut p) }
  q.x * 10 + q.y
}

// 9. C-style `for` `continue` runs step in loop-header scope, not shadowed body scope
#verify
pub fn c_09_for_continue_shadow() -> Int {
  let mut count = 0
  for let mut i = 0; i < 2; i = i + 1 {
    count = count + 1
    let mut i = 20
    if i > 10 {
      continue
    }
    i = i + 1
  }
  count
}

// 10. Literal pattern mismatch must not evaluate match guard
#verify
pub fn c_10_match_lit_guard_skip() -> Int {
  let mut n = 0
  let r1 = match 2 {
    1 if bump_true(mut n) => 9
    _ => n
  }
  let opt : Option[Int] = Some(2)
  let r2 = match opt {
    Some(1) if bump_true(mut n) => 9
    _ => n
  }
  r1 * 10 + r2
}

// 11. Match scrutinee snapshotted so failed guard mutation does not alter later arms
#verify
pub fn c_11_match_scrut_snapshot() -> Int {
  let mut n = 1
  let r = match n {
    1 if step_false(mut n) => 8
    1 => 3
    _ => 4
  }
  r * 10 + n
}

// 12. `StringBuilder` write methods counted as ANF write effects
#verify
pub fn c_12_sb_write_effect() -> Int {
  let mut b = StringBuilder::new()
  b.write_string("a")
  let (s, _) = (b.to_string(), b.write_string("b"))
  let mut m : Map[Int, Int] = Map::new()
  m.set(1, 10)
  let (len_before, _) = (m.length(), m.remove(1))
  s.length() * 10 + len_before
}

// 13. Named arguments evaluated strictly in source-written order (SPEC §3.4/§3.5)
#verify
fn take_ab(a~ : Int, b~ : Int) -> Int {
  a * 10 + b
}

#verify
pub fn c_13_named_arg_eval_order() -> Int {
  let mut n = 0
  take_ab(b=bump(mut n), a=bump(mut n))
}

// 14. Cross-package default parameter must resolve in callee package, not caller locals
#verify
pub fn c_14_cross_pkg_default_param() -> Int {
  let LIMIT = 3
  let _ = LIMIT
  dep::pick()
}

// 15. Local parameter named `ok_` must not capture same-package function `ok()`
#verify
fn probe_ok_shadow(ok_ : Int) -> Int {
  ok() + ok_
}

#verify
pub fn c_15_param_shadow_pkg_fn() -> Int {
  probe_ok_shadow(40)
}

// 16. Loop helper `<fn>_loop0` must not collide with user function `f_loop0`
#verify
pub fn f_loop0() -> Int {
  100
}

#verify
fn f(n : Int) -> Int {
  let mut s = 0
  let mut i = 1
  while i <= n {
    s = s + i
    i = i + 1
  }
  s
}

#verify
pub fn c_16_loop_helper_collision() -> Int {
  f_loop0() + f(3)
}

// 17. Lean 4.36 keywords (`initialize`, `macro_rules`) escaped cleanly
#verify
pub fn initialize() -> Int {
  7
}

#verify
pub fn macro_rules() -> Int {
  3
}

#verify
pub fn c_17_lean4_keywords() -> Int {
  initialize() + macro_rules()
}

// 18. Non-literal `Map(pairs)` and `Map([p])` lowering
#verify
pub fn c_18_map_non_literal() -> Int {
  let k1 = 1
  let pairs = [(k1, 42)]
  let m1 : Map[Int, Int] = Map(pairs)
  let p = (2, 99)
  let m2 : Map[Int, Int] = Map([p])
  let v1 = m1.get(1).unwrap_or(0)
  let v2 = m2.get(2).unwrap_or(0)
  m1.length() * 1000 + m2.length() * 100 + v1 + v2
}

// 19. Cross-package generic default parameter (`Option[T] = None`) instantiated at call site
#verify
pub fn c_19_cross_pkg_generic_default() -> Int {
  dep::gpick(6)
}

// 20. Default parameter expression referencing a prior parameter
#verify
fn pick_prior(x : Int, y~ : Int = x) -> Int {
  x + y
}

#verify
pub fn c_20_default_ref_prior_param() -> Int {
  let x = 99
  let _ = x
  pick_prior(5)
}

// 21. Loop helper `<fn>_loop0` must not be shadowed by function parameter `walk_loop0`
#verify
fn walk(walk_loop0 : Int) -> Int {
  let mut i = 0
  let mut s = 0
  while i < walk_loop0 {
    i = i + 1
    s = s + i
  }
  s
}

#verify
pub fn c_21_loop_helper_param_shadow() -> Int {
  walk(5)
}

// 22. Generic function with local `Map[K, Int]` synthesizes `[Pion.Eq K]`
#verify
fn mk_map_len[K](mut xs : Array[(K, Int)]) -> Int {
  let mut m : Map[K, Int] = Map([])
  while xs.length() > 0 {
    match xs.pop() {
      Some((k, v)) => m.set(k, v)
      None => ()
    }
  }
  m.length()
}

#verify
pub fn c_22_generic_local_map_eq() -> Int {
  let mut xs = [(3, 4), (3, 9)]
  mk_map_len(mut xs)
}

// 23. Additional Lean 4.36 keywords (`partial_fixpoint`, `coinductive`, `simproc`)
#verify
pub fn partial_fixpoint() -> Int {
  13
}

#verify
pub fn coinductive() -> Int {
  29
}

#verify
pub fn simproc() -> Int {
  5
}

#verify
pub fn c_23_more_lean_keywords() -> Int {
  partial_fixpoint() + coinductive() + simproc()
}

// 24. C-style `for` condition `is` pattern binding must not leak into loop body
#verify
pub fn c_24_for_cond_is_no_leak() -> Int {
  let mut a : Array[Int] = [1]
  let o : Option[Int] = Some(99)
  for let mut i = 0; o is Some(a); i = i + 1 {
    a.push(2)
    break
  }
  a.length() * 10 + a[1]
}

// 25. Omitted optional parameter `a?` referenced by a later default parameter
#verify
fn pick_opt_ref(a? : Int, y~ : Int = a.unwrap_or(7)) -> Int {
  y
}

#verify
pub fn l_25_opt_param_default_ref() -> Int {
  let a : Option[Int] = Some(99)
  let _ = a
  pick_opt_ref()
}

// 26. Transitive `[Pion.Eq J]` propagation through generic caller of local-Map callee
#verify
fn wrap_mk_map[J](mut xs : Array[(J, Int)]) -> Int {
  mk_map_len(mut xs)
}

#verify
pub fn l_26_generic_map_eq_transitive() -> Int {
  let mut xs = [(3, 4), (3, 9)]
  wrap_mk_map(mut xs)
}

// 27. Loop helper `<fn>_loop0` must not collide with function's type parameter
#verify
fn walk_tp[walk_tp_loop0](x : walk_tp_loop0, n : Int) -> Int {
  let mut i = 0
  let mut s = 0
  while i < n {
    i = i + 1
    s = s + i
  }
  s
}

#verify
pub fn l_27_loop_helper_tparam_shadow() -> Int {
  walk_tp(0, 5)
}

// 28. Nested loop helper `<fn>_loop1` must not collide with function's type parameter
#verify
fn walk_nested_tp[walk_nested_tp_loop1](x : walk_nested_tp_loop1) -> Int {
  let mut i = 0
  let mut n = 0
  while i < 2 {
    let mut j = 0
    while j < 2 {
      n = n + 1
      j = j + 1
    }
    i = i + 1
  }
  n
}

#verify
pub fn l_28_nested_loop_helper_tparam_shadow() -> Int {
  walk_nested_tp(4)
}

// 29. Generic caller passing product key `(J, Int)` into local-Map callee synthesizes `Pion.Eq (J × I32)`
#verify
fn wrap_mk_map_prod[J](mut xs : Array[((J, Int), Int)]) -> Int {
  mk_map_len(mut xs)
}

#verify
pub fn l_29_generic_map_product_key_eq() -> Int {
  let mut xs = [((1, 2), 3), ((1, 2), 4)]
  wrap_mk_map_prod(mut xs)
}
