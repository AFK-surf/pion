import "pr3_soundness" as p

fn run(name : String) -> Option[Int] {
  if name == "c_01_field_compound_assign" { return Some(p::c_01_field_compound_assign()) }
  if name == "c_02_string_index" { return Some(p::c_02_string_index()) }
  if name == "c_02_string_index_oob" { return Some(p::c_02_string_index_oob()) }
  if name == "c_03_into_call_arg" { return Some(p::c_03_into_call_arg()) }
  if name == "c_04_try_into_err" { return Some(p::c_04_try_into_err()) }
  if name == "c_05_keyword_and_collision" { return Some(p::c_05_keyword_and_collision()) }
  if name == "c_06_retarget_mut_assign" { return Some(p::c_06_retarget_mut_assign()) }
  if name == "c_07_range_start_snapshot" { return Some(p::c_07_range_start_snapshot()) }
  if name == "c_08_struct_update_base" { return Some(p::c_08_struct_update_base()) }
  if name == "c_09_for_continue_shadow" { return Some(p::c_09_for_continue_shadow()) }
  if name == "c_10_match_lit_guard_skip" { return Some(p::c_10_match_lit_guard_skip()) }
  if name == "c_11_match_scrut_snapshot" { return Some(p::c_11_match_scrut_snapshot()) }
  if name == "c_12_sb_write_effect" { return Some(p::c_12_sb_write_effect()) }
  if name == "c_13_named_arg_eval_order" { return Some(p::c_13_named_arg_eval_order()) }
  if name == "c_14_cross_pkg_default_param" { return Some(p::c_14_cross_pkg_default_param()) }
  if name == "c_15_param_shadow_pkg_fn" { return Some(p::c_15_param_shadow_pkg_fn()) }
  if name == "c_16_loop_helper_collision" { return Some(p::c_16_loop_helper_collision()) }
  if name == "c_17_lean4_keywords" { return Some(p::c_17_lean4_keywords()) }
  if name == "c_18_map_non_literal" { return Some(p::c_18_map_non_literal()) }
  if name == "c_19_cross_pkg_generic_default" { return Some(p::c_19_cross_pkg_generic_default()) }
  if name == "c_20_default_ref_prior_param" { return Some(p::c_20_default_ref_prior_param()) }
  if name == "c_21_loop_helper_param_shadow" { return Some(p::c_21_loop_helper_param_shadow()) }
  if name == "c_22_generic_local_map_eq" { return Some(p::c_22_generic_local_map_eq()) }
  if name == "c_23_more_lean_keywords" { return Some(p::c_23_more_lean_keywords()) }
  if name == "c_24_for_cond_is_no_leak" { return Some(p::c_24_for_cond_is_no_leak()) }
  None
}

pub fn main(world : World) -> Int {
  let args = args_get(world)
  if args.length() < 2 {
    return 2
  }
  let name = args[1]
  match run(name) {
    Some(v) => {
      io_println(world, "\{name}: OK \{v}")
      0
    }
    None => 2
  }
}
