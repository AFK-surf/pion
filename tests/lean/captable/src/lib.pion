///| A miniature capability table in the style of a microkernel CSpace
///| (`scripts/test-lean.sh`, proofs in `tests/lean/proofs/CapTableProofs.lean`).
///| Invariant: `count` is the number of non-`Null` slots.
///| Error codes: 1 bad slot, 2 slot occupied, 3 slot empty / wrong kind, 4 null capability.

pub enum Cap {
  Null
  Endpoint(UInt64, Bool, Bool)
  Mint(UInt64, UInt64)
}

pub struct CapTable {
  mut slots : Array[Cap]
  mut count : Int
}

#verify
pub fn cap_is_null(c : Cap) -> Bool {
  match c {
    Null => true
    _ => false
  }
}

#verify
pub fn cap_has_badge(c : Cap, badge : UInt64) -> Bool {
  match c {
    Endpoint(b, _, _) => b == badge
    _ => false
  }
}

#verify
pub fn CapTable::create(cap : Int) -> CapTable {
  CapTable::{ slots: Array::make(cap, Null), count: 0 }
}

#verify
pub fn CapTable::insert(mut self : CapTable, slot : Int, c : Cap) -> Result[Unit, Int] {
  guard slot >= 0 && slot < self.slots.length() else {
    return Err(1)
  }
  guard cap_is_null(self.slots[slot]) else {
    return Err(2)
  }
  guard !cap_is_null(c) else {
    return Err(4)
  }
  self.slots[slot] = c
  self.count = self.count + 1
  Ok(())
}

#verify
pub fn CapTable::copy_cap(mut self : CapTable, src : Int, dst : Int) -> Result[Unit, Int] {
  guard src >= 0 && src < self.slots.length() && dst >= 0 && dst < self.slots.length() else {
    return Err(1)
  }
  let c = self.slots[src]
  guard !cap_is_null(c) else {
    return Err(3)
  }
  guard cap_is_null(self.slots[dst]) else {
    return Err(2)
  }
  self.slots[dst] = c
  self.count = self.count + 1
  Ok(())
}

#verify
pub fn CapTable::mint(
  mut self : CapTable,
  src : Int,
  dst : Int,
  new_badge : UInt64,
  allow_send : Bool,
  allow_recv : Bool,
) -> Result[Unit, Int] {
  guard src >= 0 && src < self.slots.length() && dst >= 0 && dst < self.slots.length() else {
    return Err(1)
  }
  guard cap_is_null(self.slots[dst]) else {
    return Err(2)
  }
  match self.slots[src] {
    Endpoint(_, can_send, can_recv) => {
      self.slots[dst] = Endpoint(new_badge, can_send && allow_send, can_recv && allow_recv)
      self.count = self.count + 1
      Ok(())
    }
    _ => Err(3)
  }
}

#verify
pub fn CapTable::delete(mut self : CapTable, slot : Int) -> Result[Unit, Int] {
  guard slot >= 0 && slot < self.slots.length() else {
    return Err(1)
  }
  guard !cap_is_null(self.slots[slot]) else {
    return Err(3)
  }
  self.slots[slot] = Null
  self.count = self.count - 1
  Ok(())
}

#verify
pub fn CapTable::revoke_badge(mut self : CapTable, badge : UInt64) -> Int {
  let n = self.slots.length()
  let mut i = 0
  let mut revoked = 0
  while i < n {
    if cap_has_badge(self.slots[i], badge) {
      self.slots[i] = Null
      self.count = self.count - 1
      revoked = revoked + 1
    }
    i = i + 1
  }
  revoked
}
