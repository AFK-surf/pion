import "diff_cases" as diff_cases

///| Runs one differential case by name (one process per case, so a trap
///| only ends that case).

fn run(name : String) -> Option[Int64] {
  if name == "wrap_add_max" {
    return Some(diff_cases::c_wrap_add_max())
  }
