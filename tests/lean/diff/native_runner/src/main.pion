pub fn main(world : World) -> Int {
  let args = args_get(world)
  if args.length() < 2 {
    return 2
  }
  let name = args[1]
  match run(name) {
    Some(v) => {
      io_println(world, "\{name}: OK \{v}")
      0
    }
    None => 2
  }
}
