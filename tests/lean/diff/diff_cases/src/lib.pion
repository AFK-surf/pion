#verify
pub fn c_cap_revoke() -> Int64 {
  let mut t = captable::CapTable::create(4)
  let _a = t.insert(0, captable::Endpoint(5UL, true, true))
  let _b = t.insert(1, captable::Endpoint(6UL, true, true))
  let _c = t.insert(2, captable::Endpoint(5UL, false, true))
  let _d = t.insert(3, captable::Mint(5UL, 5UL))
  let n = t.revoke_badge(5UL)
  ri(n) * 1000L + table_digest(t)
}

#verify
pub fn c_sb_basic() -> Int64 {
  let mut sb = StringBuilder()
  sb.write_string("ab")
  sb.write_byte(b'c')
  sb.write_substring("012345", -5, 2)
  sb.write_substring("012345", 4, 99)
  sb.write_substring("012345", 4, 2)
  sb.write_substring("012345", 10, 20)
  let l1 = sb.length()
  let s = sb.to_string()
  let eq_ok = if s == "abc0145" { 1L } else { 0L }
  sb.reset()
  let l2 = sb.length()
  ri(l1) * 100L + eq_ok * 10L + ri(l2)
}

#verify
pub fn c_map_str() -> Int64 {
  let mut m : Map[String, Int] = Map::new()
  m.set("a", 10)
  m.set("b", 20)
  m.set("a", 30)
  let c1 = if m.contains("a") { 1L } else { 0L }
  let v1 = match m.get("a") { Some(v) => ri(v); None => -1L }
  let l1 = ri(m.length())
  m.remove("a")
  let c2 = if m.contains("a") { 1L } else { 0L }
  let v2 = match m.get("b") { Some(v) => ri(v); None => -1L }
  let l2 = ri(m.length())
  m.clear()
  let l3 = ri(m.length())
  c1 * 100000L + v1 * 1000L + l1 * 100L + c2 * 50L + v2 + l2 * 3L + l3
}

#verify
pub fn c_map_int() -> Int64 {
  let mut m : Map[Int, Int] = Map::with_capacity(8)
  m.set(1, 100)
  m.set(2, 200)
  m.set(1, 150)
  let v1 = match m.get(1) { Some(v) => ri(v); None => 0L }
  let v2 = match m.get(3) { Some(v) => ri(v); None => 7L }
  m.remove(2)
  let l = ri(m.length())
  v1 * 100L + v2 * 10L + l
}

#verify
fn dbl_roundtrip_helper(d : Double) -> Double {
  let u = d.reinterpret_as_uint64()
  u.reinterpret_as_double()
}

#verify
pub fn c_double_bits() -> Int64 {
  let bits : Int64 = 0x3FF8000000000000L
  let d = Double::from_bits(bits)
  let d2 = dbl_roundtrip_helper(d)
  let back = d2.to_bits()
  let neg_zero_bits : Int64 = -9223372036854775807L - 1L
  let dz = Double::from_bits(neg_zero_bits)
  let bz = dz.to_bits()
  if back == bits && bz == neg_zero_bits { 12345L } else { 0L }
}

enum DiffOp {
  DAdd
  DSub
  DMul
  DScale(Int)
}

enum DiffSingle {
  DWrap(Int)
}

enum DiffOne {
  DOnly
}

let DIFF_MATCH_K : Int = 42

#verify
fn diff_eval_unit(op : DiffOp) -> Int {
  match op {
    DAdd => 1
    DSub => 2
    DMul => 3
    DScale(n) => n
  }
}

#verify
fn diff_eval_peeled(op : DiffOp, flag : Bool) -> Int {
  match op {
    DAdd => 10
    DScale(0) => 99
    DScale(n) if flag && n > 5 => n * 10
    DSub => 20
    DScale(n) => n + 1
    DMul => 30
  }
}

#verify
fn diff_eval_single(w : DiffSingle) -> Int {
  match w {
    DWrap(0) => 77
    DWrap(x) if x < 0 => -x
    DWrap(x) => x + 2
  }
}

#verify
fn diff_eval_const(x : Int) -> Int {
  match x {
    DIFF_MATCH_K => 500
    n => n + 1
  }
}

#verify
fn diff_eval_wild_tail(x : Option[Bool]) -> Bool {
  match x {
    None => true
    _ => false
    Some(b) => b
  }
}

#verify
fn diff_eval_is_single(o : DiffOne, w : DiffSingle) -> Int {
  let a = if o is DOnly { 10 } else { 0 }
  let b = if w is DWrap(x) { x } else { 0 }
  a + b
}

#verify
fn diff_eval_peeled_dead(x : Bool) -> String {
  match x {
    true if x => "a"
    _ => "b"
    false => "\x80"
  }
}

#verify
fn diff_eval_exhaustive_wild(x : Option[Bool]) -> Bool {
  match x {
    None => true
    Some(b) => b
    _ => false
  }
}

#verify
fn diff_eval_dup_arm(x : Option[Bool]) -> Bool {
  match x {
    None => true
    None => false
    _ => false
  }
}

#verify
fn diff_eval_nested_dup(x : Option[Bool]) -> Int {
  match x {
    Some(true) => 1
    Some(false) => 2
    Some(_) => 99
    None => 3
  }
}

#verify
pub fn c_match_unit_enum() -> Int64 {
  ri(diff_eval_unit(DAdd) * 1000 + diff_eval_unit(DSub) * 100 + diff_eval_unit(DMul) * 10 + diff_eval_unit(DScale(7)))
}

#verify
pub fn c_match_guarded_enum() -> Int64 {
  let a = diff_eval_peeled(DAdd, false)
  let b = diff_eval_peeled(DScale(0), true)
  let c = diff_eval_peeled(DScale(6), true)
  let d = diff_eval_peeled(DScale(6), false)
  let e = diff_eval_peeled(DSub, true)
  let f = diff_eval_peeled(DMul, false)
  ri(a * 100000 + b * 1000 + c * 10 + d + e + f)
}

#verify
pub fn c_match_single_ctor_guard() -> Int64 {
  let a = diff_eval_single(DWrap(0))
  let b = diff_eval_single(DWrap(-5))
  let c = diff_eval_single(DWrap(8))
  ri(a * 1000 + b * 100 + c)
}

#verify
pub fn c_match_const_pat() -> Int64 {
  let a = diff_eval_const(42)
  let b = diff_eval_const(9)
  ri(a * 100 + b)
}

#verify
pub fn c_match_wild_tail() -> Int64 {
  let a = if diff_eval_wild_tail(None) { 10 } else { 0 }
  let b = if diff_eval_wild_tail(Some(true)) { 1 } else { 0 }
  ri(a + b)
}

#verify
pub fn c_match_is_single_ctor() -> Int64 {
  ri(diff_eval_is_single(DOnly, DWrap(7)))
}

#verify
pub fn c_match_peeled_dead_arm() -> Int64 {
  let a = if diff_eval_peeled_dead(true) == "a" { 10 } else { 0 }
  let b = if diff_eval_peeled_dead(false) == "b" { 1 } else { 0 }
  ri(a + b)
}

#verify
pub fn c_match_exhaustive_wild() -> Int64 {
  let a = if diff_eval_exhaustive_wild(None) { 100 } else { 0 }
  let b = if diff_eval_exhaustive_wild(Some(true)) { 10 } else { 0 }
  let c = if diff_eval_exhaustive_wild(Some(false)) { 1 } else { 0 }
  ri(a + b + c)
}

#verify
pub fn c_match_dup_arm() -> Int64 {
  let a = if diff_eval_dup_arm(None) { 10 } else { 0 }
  let b = if diff_eval_dup_arm(Some(true)) { 1 } else { 0 }
  ri(a + b)
}

#verify
pub fn c_match_nested_dup() -> Int64 {
  ri(diff_eval_nested_dup(Some(true)) * 100 + diff_eval_nested_dup(Some(false)) * 10 + diff_eval_nested_dup(None))
}
