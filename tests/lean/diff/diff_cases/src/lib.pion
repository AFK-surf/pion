}

#verify
pub fn c_bs_extremes() -> Int64 {
  opt(algos::binary_search([imin(), 0, imax()], imax()))
}

#verify
pub fn c_sort_mixed() -> Int64 {
  let mut a = [5, -2, 9, imin(), 5, imax(), 0]
