#verify
fn digest(a : Array[Int]) -> Int64 {
  let mut h = 7L
  for x in a {
    h = h * 31L + x.to_int64()
  }
  h
}

#verify
fn opt(x : Option[Int]) -> Int64 {
  match x {
    Some(v) => v.to_int64()
    None => -1L
  }
}

#verify
fn res(x : Result[Unit, Int]) -> Int64 {
  match x {
    Ok(_) => 0L
    Err(e) => e.to_int64()
  }
}

#verify
fn cap_code(c : captable::Cap) -> Int64 {
  match c {
    Null => 0L
    Endpoint(b, s, r) => {
      let sb = if s { 2L } else { 0L }
      let rb = if r { 1L } else { 0L }
      b.reinterpret_as_int64() * 4L + sb + rb
    }
    Mint(a, b) => a.reinterpret_as_int64() * 3L + b.reinterpret_as_int64() + 5L
  }
}

#verify
fn table_digest(t : captable::CapTable) -> Int64 {
  let mut h = t.count.to_int64()
  for c in t.slots {
    h = h * 37L + cap_code(c)
  }
  h
}

#verify
fn desc_digest(d : codec::Desc) -> Int64 {
  rul(d.tag) + rul(d.rights) * 16L + rul(d.badge) * 256L + rul(d.pfn) * 4294967296L
}

#verify
fn sum_incl(lo : Int, hi : Int) -> Int64 {
  let mut n = 0L
  for i in lo..=hi {
    n = n + i.to_int64() - lo.to_int64() + 1L
  }
  n
}

#verify
fn nested(limit : Int, stop : Int, skip : Int) -> Int {
  let mut s = 0
  for i in 0..limit {
    if i == skip {
      continue
    }
    let mut j = 0
    while j < limit {
      if j == stop {
        break
      }
      s = s + i * j + 1
      j = j + 1
    }
    if s > 1000 {
      return -s
    }
  }
  s
}

#verify
fn guarded(a : Int, b : Int) -> Result[Int, Int] {
  guard b != 0 else {
    return Err(-1)
  }
  Ok(a / b)
}

#verify
fn chained(a : Int, b : Int, c : Int) -> Result[Int, Int] {
  let x = guarded(a, b)?
  let y = guarded(x, c)?
  Ok(x + y)
}

#verify
fn res_i(x : Result[Int, Int]) -> Int64 {
  match x {
    Ok(v) => v.to_int64()
    Err(e) => e.to_int64() * 1000L
  }
}

