import "algos" as algos
import "captable" as captable
import "codec" as codec

///| Differential cases (`scripts/test-lean.sh`): each `c_*` runs natively
///| (`native_runner`, one process per case) and through the extracted Lean
///| (`DiffEval.lean`); both must print the same value or both must trap.

#verify
fn imax() -> Int {
  2147483647
}

#verify
fn imin() -> Int {
  -2147483647 - 1
}

#verify
fn lmax() -> Int64 {
  9223372036854775807L
}

#verify
fn lmin() -> Int64 {
  -9223372036854775807L - 1L
}

#verify
fn umax() -> UInt {
  0xFFFF_FFFFU
}

#verify
fn ulmax() -> UInt64 {
  0xFFFF_FFFF_FFFF_FFFFUL
}

#verify
