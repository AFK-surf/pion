///| A 64-bit capability descriptor word (`scripts/test-lean.sh`, proofs in
///| `tests/lean/proofs/CodecProofs.lean`):
///| bits 0..3 `tag`, 4..7 `rights`, 8..31 `badge`, 32..63 `pfn`.

pub struct Desc {
  tag : UInt64
  rights : UInt64
  badge : UInt64
  pfn : UInt64
}

#verify
pub fn desc_valid(d : Desc) -> Bool {
  d.tag <= 15UL && d.rights <= 15UL && d.badge <= 0xFF_FFFFUL && d.pfn <= 0xFFFF_FFFFUL
}

#verify
pub fn pack(d : Desc) -> Option[UInt64] {
  if !desc_valid(d) {
    return None
  }
  let a = d.rights << 4UL
  let b = d.badge << 8UL
  let c = d.pfn << 32UL
  Some(d.tag | a | b | c)
}

#verify
pub fn unpack(raw : UInt64) -> Desc {
  let r = raw >> 4UL
  let b = raw >> 8UL
  let p = raw >> 32UL
  Desc::{ tag: raw & 15UL, rights: r & 15UL, badge: b & 0xFF_FFFFUL, pfn: p }
}

#verify
pub fn restrict_rights(raw : UInt64, mask : UInt64) -> UInt64 {
  let r = raw >> 4UL
  let kept = r & mask & 15UL
  let shifted = kept << 4UL
  raw & 0xFFFF_FFFF_FFFF_FF0FUL | shifted
}
