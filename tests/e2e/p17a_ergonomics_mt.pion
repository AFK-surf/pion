///| P17-A end to end: `Mutex[Array[T]]` / `Mutex[Map[String, Array[String]]]`
///| shared by 8 workers, String parsing, Option/Result helpers, generic `==`
///| monomorphized per instantiation, and `debug_assert` in expression position.

pub val struct Rec {
  id : Int
  tag : String
}

enum Level {
  Low
  High
}

fn same[T](a : T, b : T) -> Bool {
  a == b
}

fn count_same[T](xs : Array[T], x : T) -> Int {
  let mut n = 0
  for y in xs {
    if same(x, y) {
      n = n + 1
    }
  }
  n
}

fn half(n : Int) -> Result[Int, String] {
  if n % 2 == 0 {
    Ok(n / 2)
  } else {
    Err("odd")
  }
}

fn parse_sum(parts : Array[String]) -> Int {
  let mut s = 0
  for p in parts {
    s = s + p.to_int().unwrap_or(0)
  }
  s
}

fn check_parsing() -> Int {
  let mut bad = 0
  if parse_sum("10,20,x,-5, 7,2147483648".split(",")) != 25 {
    bad = bad + 1
  }
  match "9000000000".to_int64() {
    Some(v) => debug_assert(v == 9000000000L, "int64")
    None => bad = bad + 2
  }
  if "9000000000".to_int().is_some() || "".to_int().is_some() {
    bad = bad + 4
  }
  let d = "2.5".to_double().unwrap_or(0.0) + "x1".to_double().unwrap_or(0.25)
  if d != 2.75 {
    bad = bad + 8
  }
  if !half(4).is_ok() || !half(3).is_err() || half(3).unwrap_or(-1) != -1 {
    bad = bad + 16
  }
  let none_name : Option[String] = None
  if none_name.unwrap_or("anon") != "anon" || !none_name.is_none() {
    bad = bad + 32
  }
  bad
}

fn check_generic_eq() -> Int {
  let mut bad = 0
  // Fresh heap strings: equal bytes, distinct pointers.
  let k1 = "ab" + "c"
  let k2 = "a" + "bc"
  if !same(k1, k2) || same(k1, "abd") {
    bad = bad + 128
  }
  if count_same(["x" + "1", "x1", "y"], "x" + "1") != 2 {
    bad = bad + 256
  }
  if !same(High, High) || same(Low, High) || count_same([Low, High, Low], Low) != 2 {
    bad = bad + 512
  }
  if !same(7, 7) || same(1.5, 2.5) {
    bad = bad + 1024
  }
  bad
}

pub fn main(world : World) -> Int {
  let workers = 8
  let per = 400
  let log : Mutex[Array[String]] = Mutex::new(["seed"])
  let recs : Mutex[Array[Rec]] = Mutex::new([])
  let index : Mutex[Map[String, Array[String]]] = Mutex::new(Map::new())
  let next_id = AtomicInt::new(0)
  let popped = AtomicInt::new(0)
  let pop_len = AtomicInt::new(0)

  scope(world, fn(s : Scope) -> Unit {
    let mut w = 0
    while w < workers {
      spawn(s, fn() -> Unit {
        let wid = next_id.fetch_add(1)
        let mut i = 0
        while i < per {
          let item = "w" + wid.to_string() + ":" + i.to_string()
          let l = log.lock()
          l.push(item)
          if i % 4 == 3 {
            // Releases a string some other worker may have created.
            match l.pop() {
              Some(prev) => {
                let _ = popped.fetch_add(1)
                let _ = pop_len.fetch_add(prev.length())
              }
              None => ()
            }
          }
          log.unlock()
          let r = recs.lock()
          r.push(Rec::{ id: wid * per + i, tag: "t" + i.to_string() })
          if i % 8 == 7 {
            r[0] = Rec::{ id: -1, tag: "replaced-" + wid.to_string() }
          }
          recs.unlock()
          let key = "k" + (i % 16).to_string()
          let m = index.lock()
          match m.get(key) {
            Some(bucket) => bucket.push(item)
            None => m.set(key, [item])
          }
          index.unlock()
          i = i + 1
        }
      })
      w = w + 1
    }
  })

  let l = log.lock()
  let log_len = l.length()
  let mut log_sum = 0
  for e in l {
    log_sum = log_sum + e.length()
  }
  log.unlock()
  let r = recs.lock()
  let recs_len = r.length()
  let mut tag_ok = 0
  for rec in r {
    if rec.tag.starts_with("t") || rec.tag.starts_with("replaced-") {
      tag_ok = tag_ok + 1
    }
  }
  recs.unlock()
  let m = index.lock()
  let mut idx_total = 0
  let keys = m.keys()
  for k in keys {
    match m.get(k) {
      Some(bucket) => idx_total = idx_total + bucket.length()
      None => ()
    }
  }
  index.unlock()

  let total = workers * per
  let pops = popped.load()
  let bad = check_parsing() + check_generic_eq()
  let ok = pops == total / 4 &&
  log_len == 1 + total - pops &&
  recs_len == total &&
  tag_ok == total &&
  idx_total == total &&
  keys.length() == 16 &&
  bad == 0
  if ok {
    io_println(
      world,
      "p17a_ok log=" +
      log_len.to_string() +
      " recs=" +
      recs_len.to_string() +
      " index=" +
      idx_total.to_string() +
      " keys=" +
      keys.length().to_string(),
    )
    0
  } else {
    io_eprintln(
      world,
      "p17a_fail pops=" +
      pops.to_string() +
      " log=" +
      log_len.to_string() +
      " sum=" +
      log_sum.to_string() +
      " poplen=" +
      pop_len.load().to_string() +
      " recs=" +
      recs_len.to_string() +
      " tags=" +
      tag_ok.to_string() +
      " index=" +
      idx_total.to_string() +
      " bad=" +
      bad.to_string(),
    )
    1
  }
}
