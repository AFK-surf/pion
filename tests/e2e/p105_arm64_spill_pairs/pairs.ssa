export function l $bigframe(l %a) {
@start
  %buf =l alloc8 4096
  storel %a, %buf
  %bp =l add %buf, 4088
  storel 5, %bp
  %u =l call $sink(l %buf)
  %v0 =l mul %a, 3
  %v1 =l mul %a, 10
  %v2 =l mul %a, 17
  %v3 =l mul %a, 24
  %v4 =l mul %a, 31
  %v5 =l mul %a, 38
  %v6 =l mul %a, 45
  %v7 =l mul %a, 52
  %v8 =l mul %a, 59
  %v9 =l mul %a, 66
  %v10 =l mul %a, 73
  %v11 =l mul %a, 80
  %v12 =l mul %a, 87
  %v13 =l mul %a, 94
  %v14 =l mul %a, 101
  %v15 =l mul %a, 108
  %c =l call $sink(l %a)
  %s0 =l add %c, %v0
  %s1 =l add %s0, %v1
  %s2 =l add %s1, %v2
  %s3 =l add %s2, %v3
  %s4 =l add %s3, %v4
  %s5 =l add %s4, %v5
  %s6 =l add %s5, %v6
  %s7 =l add %s6, %v7
  %s8 =l add %s7, %v8
  %s9 =l add %s8, %v9
  %s10 =l add %s9, %v10
  %s11 =l add %s10, %v11
  %s12 =l add %s11, %v12
  %s13 =l add %s12, %v13
  %s14 =l add %s13, %v14
  %s15 =l add %s14, %v15
  %b0 =l loadl %buf
  %b1 =l loadl %bp
  %t0 =l add %s15, %b0
  %fin =l add %t0, %b1
  ret %fin
}

export function l $user_alloc(l %a, l %b) {
@start
  %p =l alloc8 16
  %p8 =l add %p, 8
  storel %a, %p
  storel %b, %p8
  %u =l call $sink(l %p)
  %x =l loadl %p
  %y =l loadl %p8
  %r =l sub %x, %y
  ret %r
}

