# P105: AArch64 private spill-slot stp/ldp pairing (arm64_slotpair).
# Generated shapes: >10 values live across a call (reload pairs, l and w),
# 8 spilled parameters (store pairs), a 4 KB local frame (imm7 overflow ->
# single ldr/str), escaping user allocs (never paired), varargs and a dynamic
# alloca.  Expected results are checked by driver.c.

export function l $sink(l %x) {
@start
  %r =l xor %x, 3
  ret %r
}

export function l $spill_l(l %a) {
@start
  %v0 =l mul %a, 3
  %v1 =l mul %a, 10
  %v2 =l mul %a, 17
  %v3 =l mul %a, 24
  %v4 =l mul %a, 31
  %v5 =l mul %a, 38
  %v6 =l mul %a, 45
  %v7 =l mul %a, 52
  %v8 =l mul %a, 59
  %v9 =l mul %a, 66
  %v10 =l mul %a, 73
  %v11 =l mul %a, 80
  %v12 =l mul %a, 87
  %v13 =l mul %a, 94
  %v14 =l mul %a, 101
  %v15 =l mul %a, 108
  %c =l call $sink(l %a)
  %s0 =l add %c, %v0
  %s1 =l add %s0, %v1
  %s2 =l add %s1, %v2
  %s3 =l add %s2, %v3
  %s4 =l add %s3, %v4
  %s5 =l add %s4, %v5
  %s6 =l add %s5, %v6
  %s7 =l add %s6, %v7
  %s8 =l add %s7, %v8
  %s9 =l add %s8, %v9
  %s10 =l add %s9, %v10
  %s11 =l add %s10, %v11
  %s12 =l add %s11, %v12
  %s13 =l add %s12, %v13
  %s14 =l add %s13, %v14
  %s15 =l add %s14, %v15
  ret %s15
}

export function w $spill_w(w %a) {
@start
  %v0 =w mul %a, 1
  %v1 =w mul %a, 6
  %v2 =w mul %a, 11
  %v3 =w mul %a, 16
  %v4 =w mul %a, 21
  %v5 =w mul %a, 26
  %v6 =w mul %a, 31
  %v7 =w mul %a, 36
  %v8 =w mul %a, 41
  %v9 =w mul %a, 46
  %v10 =w mul %a, 51
  %v11 =w mul %a, 56
  %v12 =w mul %a, 61
  %v13 =w mul %a, 66
  %v14 =w mul %a, 71
  %v15 =w mul %a, 76
  %al =l extsw %a
  %c =l call $sink(l %al)
  %cw =w copy %c
  %s0 =w xor %cw, %v0
  %s1 =w xor %s0, %v1
  %s2 =w xor %s1, %v2
  %s3 =w xor %s2, %v3
  %s4 =w xor %s3, %v4
  %s5 =w xor %s4, %v5
  %s6 =w xor %s5, %v6
  %s7 =w xor %s6, %v7
  %s8 =w xor %s7, %v8
  %s9 =w xor %s8, %v9
  %s10 =w xor %s9, %v10
  %s11 =w xor %s10, %v11
  %s12 =w xor %s11, %v12
  %s13 =w xor %s12, %v13
  %s14 =w xor %s13, %v14
  %s15 =w xor %s14, %v15
  ret %s15
}

