fn neg[T](x : T) -> T {
  -x
}

fn wrap_neg[U](x : U) -> U {
  neg(x)
}

fn f6[T](x : T) -> T {
  -x
}

fn f5[T](x : T) -> T {
  f6(x)
}

fn f4[T](x : T) -> T {
  f5(x)
}

fn f3[T](x : T) -> T {
  f4(x)
}

fn f2[T](x : T) -> T {
  f3(x)
}

fn f1[T](x : T) -> T {
  f2(x)
}

enum Lv {
  Lo
  Hi
}

fn lt[T](a : T, b : T) -> Bool {
  a < b
}

fn add[T](a : T, b : T) -> T {
  a + b
}

fn sub[T](a : T, b : T) -> T {
  a - b
}

fn mul[T](a : T, b : T) -> T {
  a * b
}

fn dv[T](a : T, b : T) -> T {
  a / b
}

fn bit_and[T](a : T, b : T) -> T {
  a & b
}

fn acc_add[T](a : T, b : T) -> T {
  let mut x = a
  x += b
  x
}

fn acc_sub[T](a : T, b : T) -> T {
  let mut x = a
  x -= b
  x
}

fn neg_all[T](xs : Array[T]) -> Array[T] {
  let out : Array[T] = []
  let mut i = 0
  while i < xs.length() {
    out.push(neg(xs[i]))
    i = i + 1
  }
  out
}

pub fn main(world : World) -> Int {
  let n_d = neg(2.5)
  let wn_d = wrap_neg(2.5)
  let c6_d = f1(2.5)
  let lt_d = lt(1.5, 2.0) && !lt(2.0, 1.5)
  let lt_s = lt("a", "b") && !lt("b", "a")
  let lt_b = (false < true) && !(true < false) && lt(false, true) && !lt(true, false)
  let lt_e = (Lv::Lo < Lv::Hi) && !(Lv::Hi < Lv::Lo) && lt(Lv::Lo, Lv::Hi) && !lt(Lv::Hi, Lv::Lo)
  let s_d = sub(0.0, 2.5)
  let a_d = add(1.5, 2.0)
  let m_d = mul(1.5, 2.0)
  let q_d = dv(1.5, 2.0)
  let a_s = add("a", "b")
  let ca_s = acc_add("hi", "!")
  let ca_d = acc_sub(10.0, 2.5)
  let ys = neg_all([2.5])
  let n_i = neg(7)
  let n_i64 = neg(9L)
  let f_in : Float = 2.5
  let f_exp : Float = -2.5
  let n_f = neg(f_in)
  let a_u : UInt = add(10U, 5U)
  let a_u64 : UInt64 = add(10UL, 5UL)
  let b_a : Byte = (10).to_byte()
  let b_b : Byte = (5).to_byte()
  let b_exp : Byte = (15).to_byte()
  let a_b = add(b_a, b_b)
  let i8_in : Int8 = 5
  let i8_exp : Int8 = -5
  let n_i8 = neg(i8_in)
  let ba = bit_and(6, 3)

  let ok = n_d == -2.5 &&
    wn_d == -2.5 &&
    c6_d == -2.5 &&
    lt_d &&
    lt_s &&
    lt_b &&
    lt_e &&
    s_d == -2.5 &&
    a_d == 3.5 &&
    m_d == 3.0 &&
    q_d == 0.75 &&
    a_s == "ab" &&
    ca_s == "hi!" &&
    ca_d == 7.5 &&
    ys.length() == 1 &&
    ys[0] == -2.5 &&
    n_i == -7 &&
    n_i64 == -9L &&
    n_f == f_exp &&
    a_u == 15U &&
    a_u64 == 15UL &&
    a_b == b_exp &&
    n_i8 == i8_exp &&
    ba == 2

  io_println(
    world,
    "ok=" +
    ok.to_string() +
    " neg=" +
    n_d.to_string() +
    " sub=" +
    s_d.to_string() +
    " add=" +
    a_d.to_string() +
    " mul=" +
    m_d.to_string() +
    " dv=" +
    q_d.to_string() +
    " str=" +
    a_s +
    " arr=" +
    ys[0].to_string(),
  )
  if ok { 0 } else { 1 }
}
