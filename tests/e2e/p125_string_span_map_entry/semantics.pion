fn bound(mut visits : Int, n : Int) -> Int {
  visits = visits * 10 + n
  n
}

fn transform(s : String, mut visits : Int) -> String {
  let left = s.slice(bound(mut visits, 1), bound(mut visits, 3))
  let empty = s.slice(bound(mut visits, 2), bound(mut visits, 2))
  let result = "_" + empty + left + s.slice(0, 1) + empty + "|" + left
  result
}

fn rare(s : String, flag : Bool) -> String {
  "X" + s.slice(0, if flag { return "early" } else { 1 }) + "Y"
}

fn run_map(m : Map[String, Int64], s : String, n : Int) -> Int64 {
  let k = s.slice(1, n)
  match m.get(k) {
    Some(v) => m.set(k, v + 11L)
    None => m.set(k, 7L)
  }
  0L
}

pub fn main(world : World) -> Int {
  let mut calls = 0
  let s = "abcdef"
  if transform(s, mut calls) != "_bca|bc" || calls != 1322 { return 1 }
  if rare(s, true) != "early" || rare(s, false) != "XaY" { return 2 }
  if "abc".slice(0, 3).slice(1, 2) + "z" != "bz" { return 3 }
  let m : Map[String, Int64] = Map::new()
  let _ = run_map(m, s, 4)
  let _ = run_map(m, s, 4)
  let _ = run_map(m, s, 1)
  if m.get("bcd").unwrap_or(0L) != 18L || m.get("").unwrap_or(0L) != 7L { return 4 }
  let distinct = s.slice(1, 4)
  match m.get(distinct) {
    Some(v) => m.set(distinct, v + 1L)
    None => m.set(distinct, 0L)
  }
  if physical_equal(distinct, m.keys()[0]) { return 5 }
  let brand_new = s.slice(4, 6)
  match m.get(brand_new) {
    Some(v) => m.set(brand_new, v + 1L)
    None => m.set(brand_new, 9L)
  }
  for k in m.keys() {
    if k == brand_new && !physical_equal(k, brand_new) { return 6 }
  }
  let mut i = 0
  while i < 200 {
    let text = "k" + i.to_string()
    let _ = run_map(m, text, text.length())
    i = i + 1
  }
  if m.get("193").unwrap_or(0L) != 7L { return 7 }
  io_println(world, "ok")
  0
}
