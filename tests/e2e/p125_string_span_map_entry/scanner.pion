fn scan(s : String, initial : Int, n : Int, c : Int, quota : Int) -> Int {
  let mut idx = initial
  let mut hits = c
  while idx < n && hits < quota {
    if s.code_unit_at(idx) == 120 {
      hits = hits + 1
    }
    idx = idx + 1
  }
  idx * 100 + hits
}
fn fresh(s : String) -> String {
  " " + s
}
pub fn main(w : World) -> Int {
  let s = "abxxxab"
  if scan(s, 0, 7, 0, 2) != 402 { return 1 }
  if scan(s, 3, 7, 2, 10) != 704 { return 2 }
  if scan(s, -1, 10, 4, 4) != -96 { return 3 }
  if scan(s, 0, 8, 0, 1) != 301 { return 4 }
  let sb = StringBuilder()
  sb.write_string(fresh("012").slice(2, 4))
  if sb.to_string() != "12" { return 5 }
  let m : Map[String, Int] = Map::new()
  let k = s.slice(1, 4)
  if m.contains(k) { m.set(k, 1) } else { m.set(k, 3) }
  let b = s.slice(1, 4)
  if m.contains(b) { m.set(b, 4) } else { m.set(b, 99) }
  if m.get("bxx").unwrap_or(0) != 4 { return 6 }
  io_println(w, "ok")
  0
}
