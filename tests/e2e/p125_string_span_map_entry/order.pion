fn mark(w : World, n : Int) -> Int {
  io_eprintln(w, n.to_string())
  n
}

pub fn main(w : World) -> Int {
  let s = "abcd"
  let args = args_get(w)
  let end = if args.length() > 1 { 7 } else { 2 }
  let v = "<" + s.slice(mark(w, 1), mark(w, end)) + s.slice(mark(w, 3), mark(w, 2)) + s.slice(mark(w, 0), mark(w, 1))
  io_println(w, v)
  0
}
