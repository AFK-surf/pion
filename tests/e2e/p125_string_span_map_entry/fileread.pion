fn byte_sum(s : String) -> Int {
  let mut t = 0
  let mut i = 0
  while i < s.length() {
    t = t * 31 % 1000003 + s.code_unit_at(i)
    i = i + 1
  }
  t
}

fn same_bytes(s : String, b : Bytes) -> Bool {
  if b.length() != s.length() { return false }
  let mut i = 0
  while i < b.length() {
    if b[i].to_int() != s.code_unit_at(i) { return false }
    i = i + 1
  }
  true
}

fn report(w : World, dir : String, name : String) -> Unit {
  let path = dir + "/" + name
  match fs_read(w, path) {
    Ok(s) => {
      let bytes = match fs_read_bytes(w, path) {
        Ok(b) => if same_bytes(s, b) { "same" } else { "DIFF" }
        Err(_) => "ERR"
      }
      io_println(w, name + " ok len=" + s.length().to_string() + " sum=" + byte_sum(s).to_string() + " bytes=" + bytes)
    }
    Err(e) => {
      let bytes = match fs_read_bytes(w, path) {
        Ok(_) => "OK"
        Err(be) => if be.length() > 0 { "err" } else { "EMPTY" }
      }
      let msg = if e.length() > 0 { "msg" } else { "EMPTY" }
      io_println(w, name + " err " + msg + " bytes=" + bytes)
    }
  }
}

// Count line prefixes of a file read as a managed String: the file contents
// feed slice spans and scalar map entries directly.
fn tally(w : World, path : String) -> Int {
  let text = match fs_read(w, path) {
    Ok(s) => s
    Err(_) => return -1
  }
  let m : Map[String, Int] = Map::new()
  let mut start = 0
  let mut i = 0
  let mut out = ""
  while i <= text.length() {
    if i == text.length() || text.code_unit_at(i) == 10 {
      if i > start {
        let end = if i - start > 3 { start + 3 } else { i }
        let k = text.slice(start, end)
        match m.get(k) {
          Some(v) => m.set(k, v + 1)
          None => m.set(k, 1)
        }
        out = out + text.slice(start, end) + ";"
      }
      start = i + 1
    }
    i = i + 1
  }
  io_println(w, out)
  m.get("abc").unwrap_or(0) * 100 + m.get("xy").unwrap_or(0) * 10 + m.length()
}

pub fn main(w : World) -> Int {
  let args = args_get(w)
  if args.length() < 2 { return 2 }
  let dir = args[1]
  for name in ["empty.txt", "lines.txt", "binary.bin", "big.txt", "missing.txt"] {
    report(w, dir, name)
  }
  io_println(w, "tally " + tally(w, dir + "/lines.txt").to_string())
  io_println(w, "tally_missing " + tally(w, dir + "/missing.txt").to_string())
  0
}
