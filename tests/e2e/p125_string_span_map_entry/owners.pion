fn replace(mut s : String, bound : Int) -> Int {
  s = "replacement"
  bound
}

fn fresh(s : String) -> String {
  "x" + s
}

pub fn main(w : World) -> Int {
  let mut v = fresh("ABC")
  let a = v.slice(0, replace(mut v, 3)) + "|" + v
  if a != "xAB|replacement" { return 1 }
  let src = fresh("abcdef")
  let b = src.slice(1, 2)
  let c = src.slice(2, 3)
  let wide = b + c + b + c + b + c + b + c + b + c + b + c + fresh("!").slice(1, 2)
  if wide != "abababababab!" { return 2 }
  io_println(w, "ok")
  0
}
