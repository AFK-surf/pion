fn change(m : Map[String, Int], k : String) -> Int {
  m.remove(k)
  let mut i = 0
  while i < 100 {
    m.set(i.to_string(), i)
    i = i + 1
  }
  14
}
pub fn main(w : World) -> Int {
  let k = "x"
  let m : Map[String, Int] = Map::new()
  m.set(k, 1)
  match m.get(k) {
    Some(v) => m.set(k, v + change(m, k))
    None => m.set(k, 2)
  }
  if m.get(k).unwrap_or(0) != 15 { return 1 }
  io_println(w, "ok")
  0
}
