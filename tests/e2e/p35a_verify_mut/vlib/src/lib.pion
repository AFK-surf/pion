pub struct Acc {
  mut total : Int
  mut hist : Array[Int]
}

pub fn add_to(mut x : Int, d : Int) -> Unit {
  x = x + d
}

pub fn push_twice(mut a : Array[Int], v : Int) -> Unit {
  a.push(v)
  a.push(v)
}

pub fn Acc::record(mut self : Acc, v : Int) -> Unit {
  self.total = self.total + v
  self.hist.push(v)
}

pub fn Acc::reset(mut self : Acc) -> Unit {
  self = Acc::{ total: 0, hist: [] }
}

pub fn safe_div(a : Int, b : Int) -> Int {
  a / b
}

pub fn safe_rem(a : Int64, b : Int64) -> Int64 {
  a % b
}

pub fn shl(a : Int, b : Int) -> Int {
  a << b
}

pub fn shl64(a : Int64, b : Int64) -> Int64 {
  a << b
}

pub fn shl_u64(a : UInt64, b : UInt64) -> UInt64 {
  a << b
}

pub fn shl_u64_int(a : UInt64, b : Int) -> UInt64 {
  a << b
}

pub fn rev_ends(mut a : Array[Int]) -> Unit {
  let n = a.length()
  if n >= 2 {
    a.swap(0, n - 1)
  }
}

#verify_opaque
pub fn opaque_len(s : String) -> Int {
  s.length()
}
