import "vlib" as vlib

struct Pair {
  mut a : Int
  mut b : Int
}

struct Big {
  mut items : Array[String]
  mut name : String
}

struct Pod2 {
  x : Int
  y : Int
}

struct Pod3 {
  a : Int
  b : Int
  c : Int
}

trait Bump {
  bump(mut self : Self) -> Unit
}

impl Bump for Pair {
  fn bump(mut self : Pair) -> Unit {
    self.a = self.a + 1
  }
}

fn bump_twice[T : Bump](mut x : T) -> Unit {
  x.bump()
  x.bump()
}

fn set_name(mut s : String, v : String) -> Unit {
  s = v
}

fn grow(mut b : Big) -> Unit {
  b.items.push("x")
  b = Big::{ items: ["fresh"], name: "new" + b.name }
}

fn swap_pair(mut x : Int, mut y : Int) -> Unit {
  let t = x
  x = y
  y = t
}

fn swap_generic[T](mut a : T, mut b : T) -> Unit {
  let t = a
  a = b
  b = t
}

fn bump_all(mut a : Array[Int]) -> Unit {
  let mut i = 0
  while i < a.length() {
    a[i] = a[i] + 1
    i = i + 1
  }
}

fn forward(mut x : Int) -> Unit {
  vlib::add_to(mut x, 5)
  vlib::add_to(mut x, 5)
}

fn early(mut s : String, c : Bool) -> Int {
  if c {
    s = "early"
    return 1
  }
  s = "late"
  2
}

fn reset_pod(mut p : Pod2, v : Int) -> Unit {
  p = Pod2::{ x: v, y: v + 1 }
}

fn set_byte(mut b : Byte, v : Int) -> Unit {
  b = v.to_byte()
}

fn bit(b : Bool) -> String {
  if b { "1" } else { "0" }
}

// P38-B+C layouts: compact 1-byte `Bool`/`Byte` arrays and flat POD struct
// arrays through `swap` (including `i == j`) and `mut arr[i]` write-back.
fn compact_flat() -> String {
  let bools : Array[Bool] = [true, false, false, true]
  bools.swap(0, 2)
  bools.swap(1, 1)
  let mut by : Array[Byte] = [(1).to_byte(), (2).to_byte(), (3).to_byte(), (250).to_byte()]
  by.swap(0, 3)
  by.swap(2, 2)
  set_byte(mut by[1], 77)
  let fby = FixedArray::makei(5, fn(k : Int) -> Byte { (k * 10 + 5).to_byte() })
  fby.swap(1, 4)
  fby.swap(0, 0)
  let mut pods : Array[Pod2] = [
    Pod2::{ x: 1, y: 2 },
    Pod2::{ x: 3, y: 4 },
    Pod2::{ x: 5, y: 6 },
  ]
  pods.swap(0, 2)
  pods.swap(1, 1)
  reset_pod(mut pods[1], 40)
  let fp = FixedArray::makei(3, fn(k : Int) -> Pod2 { Pod2::{ x: k, y: k * 100 } })
  fp.swap(0, 1)
  fp.swap(2, 2)
  let mut q = pods[2]
  reset_pod(mut q, 7)
  let p3 : Array[Pod3] = [Pod3::{ a: 1, b: 2, c: 3 }, Pod3::{ a: 4, b: 5, c: 6 }]
  p3.swap(0, 1)
  "b=\{bit(bools[0])}\{bit(bools[1])}\{bit(bools[2])}\{bit(bools[3])} by=\{by[0].to_int()},\{by[1].to_int()},\{by[2].to_int()},\{by[3].to_int()} fby=\{fby[0].to_int()},\{fby[1].to_int()},\{fby[2].to_int()},\{fby[3].to_int()},\{fby[4].to_int()} pods=\{pods[0].x}:\{pods[0].y},\{pods[1].x}:\{pods[1].y},\{pods[2].x}:\{pods[2].y} fp=\{fp[0].x}:\{fp[0].y},\{fp[1].x}:\{fp[1].y},\{fp[2].x}:\{fp[2].y} q=\{q.x}:\{q.y} p3=\{p3[0].a}:\{p3[0].b}:\{p3[0].c},\{p3[1].a}:\{p3[1].b}:\{p3[1].c}"
}

#verify
fn checked_sum(xs : Array[Int], mut acc : Int) -> Unit {
  for x in xs {
    acc = acc + x
  }
}

pub fn main(world : World) -> Int {
  let args = args_get(world)
  let mode = if args.length() > 1 { args[1] } else { "" }
  if mode == "zero" {
    io_println(world, "\{vlib::safe_div(1, 0)}")
    return 0
  }
  if mode == "ovf" {
    io_println(world, "\{vlib::safe_div(-2147483647 - 1, -1)}")
    return 0
  }
  if mode == "removf" {
    io_println(world, "\{vlib::safe_rem(-9223372036854775807L - 1L, -1L)}")
    return 0
  }
  if mode == "shift" {
    io_println(world, "\{vlib::shl(1, 32)}")
    return 0
  }
  if mode == "shift64" {
    io_println(world, "\{vlib::shl64(1L, 4294967296L)}")
    return 0
  }
  if mode == "shiftu64" {
    io_println(world, "\{vlib::shl_u64(1UL, 4294967296UL)}")
    return 0
  }
  if mode == "shiftu64int" {
    io_println(world, "\{vlib::shl_u64_int(1UL, -1)}")
    return 0
  }
  if mode == "shiftok" {
    io_println(world, "\{vlib::shl64(1L, 40L)} \{vlib::shl_u64(1UL, 63UL)} \{vlib::shl_u64_int(3UL, 33)}")
    return 0
  }
  let mut n = 1
  vlib::add_to(mut n, 41)
  forward(mut n)
  let mut arr = [3, 1, 2]
  vlib::push_twice(mut arr, 9)
  vlib::rev_ends(mut arr)
  bump_all(mut arr)
  let mut p = Pair::{ a: 1, b: 2 }
  swap_pair(mut p.a, mut p.b)
  vlib::add_to(mut arr[2], 100)
  bump_twice(mut p)
  let mut acc = vlib::Acc::{ total: 0, hist: [] }
  let mut k = 0
  while k < 1000 {
    acc.record(k)
    k = k + 1
  }
  let total1 = acc.total
  let hist1 = acc.hist.length()
  acc.reset()
  let mut s1 = "alpha"
  let mut s2 = "beta"
  swap_generic(mut s1, mut s2)
  let mut name = "start"
  let mut r = 0
  let mut j = 0
  while j < 500 {
    set_name(mut name, "n" + j.to_string())
    r = r + early(mut name, j % 2 == 0)
    j = j + 1
  }
  let mut big = Big::{ items: ["a"], name: "b" }
  grow(mut big)
  grow(mut big)
  set_name(mut big.name, "re" + big.name)
  let mut names = ["a", "b", "c"]
  set_name(mut names[1], "B")
  let mut other = ["z"]
  swap_generic(mut names[0], mut other[0])
  let mut sum = 0
  checked_sum([1, 2, 3, 4], mut sum)
  io_println(
    world,
    "p35a n=\{n} arr=\{arr[0]},\{arr[1]},\{arr[2]},\{arr[3]},\{arr[4]} p=\{p.a},\{p.b} acc=\{total1}/\{hist1}/\{acc.total}/\{acc.hist.length()} s=\{s1},\{s2} name=\{name} r=\{r} big=\{big.name}/\{big.items.length()}/\{big.items[0]} names=\{names[0]},\{names[1]},\{names[2]},\{other[0]} sum=\{sum} len=\{vlib::opaque_len("hello")} div=\{vlib::safe_div(17, 5)} rem=\{vlib::safe_rem(17L, 5L)} shl=\{vlib::shl(3, 4)} \{compact_flat()}",
  )
  0
}
