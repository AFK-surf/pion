# P111: AArch64 address folding in vendor/qbe/arm64/isel.c `seladdr`.
# localaddr: fixed local allocs and their constant 4-byte aligned in-object
# offsets stay `SLOT(...)`, i.e. `[x29, #off]`, without an `add x, x29, #off`.
# imm9: single-use `add base, -k` / `sub base, k` (1 <= k <= 256) fold into
# one `ldur` / `stur [base, #-k]`.  Results are checked by driver.c.

# A local struct: stores and loads at +0/+4/+8/+16/+24 address x29 directly;
# its address escapes once to `touch`, after it is filled.
export function l $local_struct(l %a) {
@start
  %p =l alloc8 32
  %f4 =l add %p, 4
  %f8 =l add %p, 8
  %f16 =l add %p, 16
  %f24 =l add %p, 24
  storew 7, %p
  storew 11, %f4
  storel %a, %f8
  stored d_1.5, %f16
  storeh 513, %f24
  call $touch(l %p)
  %x0 =l loadsw %p
  %x4 =l loaduw %f4
  %x8 =l loadl %f8
  %d16 =d loadd %f16
  %i16 =l dtosi %d16
  %x24 =l loadsh %f24
  %s0 =l add %x0, %x4
  %s1 =l add %s0, %x8
  %s2 =l add %s1, %i16
  %s3 =l add %s2, %x24
  ret %s3
}

# A local array: element stores at constant offsets, then a call-free sum.
export function w $local_array(w %a) {
@start
  %p =l alloc4 64
  %e1 =l add %p, 4
  %e2 =l add %p, 8
  %e15 =l add 60, %p
  storew %a, %p
  %b =w mul %a, 3
  storew %b, %e1
  %c =w add %a, 100
  storew %c, %e2
  storew -1, %e15
  call $touch(l %p)
  %y0 =w loadw %p
  %y1 =w loadw %e1
  %y2 =w loadw %e2
  %y15 =w loadsb %e15
  %t0 =w add %y0, %y1
  %t1 =w add %t0, %y2
  %t2 =w add %t1, %y15
  ret %t2
}

# A > 32 KB frame: offsets beyond the scaled imm12 range go back through a
# register address (`Oaddr`) in both emitters.
export function l $bigframe(l %a) {
@start
  %p =l alloc8 32784
  %f4 =l add %p, 4
  storew 0, %f4
  %lo =l add %p, 8
  %hi =l add %p, 32776
  storel %a, %lo
  %b =l xor %a, 4660
  storel %b, %hi
  call $touch(l %p)
  %x =l loadl %lo
  %y =l loadl %hi
  %r =l add %x, %y
  ret %r
}

# Slot offsets that are not a multiple of the access width: `ldr x, [x29, #4]`
# does not exist, so `s % sz != 0` falls back to a register address.
export function l $unaligned(l %a) {
@start
  %p =l alloc8 32
  %f4 =l add %p, 4
  %f12 =l add %p, 12
  %f6 =l add %p, 6
  storel %a, %f4
  storel 77, %f12
  storew 3, %f6
  call $touch(l %p)
  %x =l loadl %f4
  %y =l loadl %f12
  %z =l loaduh %f6
  %r =l add %x, %y
  %s =l add %r, %z
  ret %s
}

# `slot - k` must not fold as `slot + k`. Selector/asm shape only (never
# executed: it would read the 8 bytes below the object).
export function l $sub_slot(l %a) {
@start
  %p =l alloc8 32
  %f8 =l add %p, 8
  storel %a, %f8
  %q =l sub %p, 8
  %x =l loadl %q
  ret %x
}

# Executed form of the same direction check, inside the object: (p + 16) - 8
# must read the sentinel at p + 8, not the one at p + 24.
export function l $sub_mid(l %a) {
@start
  %p =l alloc8 32
  %f8 =l add %p, 8
  %f24 =l add %p, 24
  storel %a, %f8
  %b =l xor %a, 255
  storel %b, %f24
  %f4 =l add %p, 4
  storew 0, %f4
  call $touch(l %p)
  %m =l add %p, 16
  %q =l sub %m, 8
  %x =l loadl %q
  ret %x
}

# RC-header style loads: `sub obj, 24` then a 32-bit load -> ldur w, [x, #-24].
export function w $hdr_w(l %o) {
@start
  %h =l sub %o, 24
  %r =w loadw %h
  ret %r
}

# Every load width and extension at -1, -24, -255 and -256.
export function l $neg_loads(l %p) {
@start
  %a1 =l sub %p, 1
  %v1 =w loadub %a1
  %a2 =l sub %p, 2
  %v2 =w loadsb %a2
  %a3 =l add %p, -24
  %v3 =w loaduh %a3
  %a4 =l sub %p, 26
  %v4 =w loadsh %a4
  %a5 =l sub %p, 255
  %v5 =w loadsb %a5
  %a6 =l sub %p, 256
  %v6 =l loadl %a6
  %a7 =l sub %p, 248
  %v7 =l loadsw %a7
  %a8 =l add %p, -244
  %v8 =l loaduw %a8
  %a9 =l sub %p, 64
  %v9 =s loads %a9
  %a10 =l add %p, -72
  %v10 =d loadd %a10
  %b1 =l extsw %v1
  %b2 =l extsw %v2
  %b3 =l extuw %v3
  %b4 =l extsw %v4
  %b5 =l extsw %v5
  %f9 =d exts %v9
  %i9 =l dtosi %f9
  %i10 =l dtosi %v10
  %s1 =l add %b1, %b2
  %s2 =l add %s1, %b3
  %s3 =l add %s2, %b4
  %s4 =l add %s3, %b5
  %s5 =l xor %s4, %v6
  %s6 =l add %s5, %v7
  %s7 =l add %s6, %v8
  %s8 =l add %s7, %i9
  %s9 =l add %s8, %i10
  ret %s9
}

# Every store width at -1..-256 through `add p, -k` and `sub p, k`.
export function $neg_stores(l %p, w %w, l %l, s %s, d %d) {
@start
  %a1 =l add %p, -1
  storeb %w, %a1
  %a2 =l sub %p, 4
  storeh %w, %a2
  %a3 =l add %p, -40
  storew %w, %a3
  %a4 =l sub %p, 256
  storel %l, %a4
  %a5 =l add %p, -100
  stores %s, %a5
  %a6 =l sub %p, 200
  stored %d, %a6
  ret
}

# -257 is outside imm9: no ldur/stur, the address is materialized.
export function l $neg_257(l %p) {
@start
  %a =l sub %p, 257
  %x =l loadsb %a
  %b =l add %p, -257
  storeb 9, %b
  ret %x
}

# A negative address used twice stays a register (no single-use fold).
export function l $neg_twice(l %p) {
@start
  %a =l sub %p, 16
  %x =l loadl %a
  storel 5, %a
  %y =l loadl %a
  %r =l add %x, %y
  ret %r
}
