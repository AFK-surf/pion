// Wave J2 single-threaded subset for Native vs Wasm32 parity verification.
// Exercises Layer 1, Layer 2 (including materialized closure preserving outer
// mut_local_slots), Layer 3 single-threaded bounds-checked indexing, and full
// string content assertions.

struct Leaf {
  name : String
  tag : String
}

struct Mid {
  leaf : Leaf
  items : Array[String]
}

struct MidMut {
  mut leaf : Leaf
}

struct Top {
  mid : Mid
  mid_mut : MidMut
}

fn assert_str_eq(got : String, want : String) -> Int {
  if got != want {
    panic("string mismatch: got=" + got + " want=" + want)
  }
  got.length()
}

fn make_top(tag_idx : Int) -> Top {
  let n = "node-" + tag_idx.to_string() + "-payload"
  let t = "tag-" + tag_idx.to_string() + "-extra"
  let leaf = Leaf::{ name: n, tag: t }
  let items = [n + ":0", t + ":1", "item-" + tag_idx.to_string()]
  let mid = Mid::{ leaf: leaf, items: items }
  let mid_mut = MidMut::{ leaf: Leaf::{ name: "m-" + tag_idx.to_string(), tag: "mt" } }
  Top::{ mid: mid, mid_mut: mid_mut }
}

fn make_top_named(name : String, tag : String) -> Top {
  let leaf = Leaf::{ name: name, tag: tag }
  let items = [name + ":0", tag + ":1", "item-custom"]
  let mid = Mid::{ leaf: leaf, items: items }
  let mid_mut = MidMut::{ leaf: Leaf::{ name: "mut-" + name, tag: "mt" } }
  Top::{ mid: mid, mid_mut: mid_mut }
}

fn Top::replace_self(mut self : Top, other : Top) -> Int {
  self = other
  1
}

fn swap_top(mut r : Top, other : Top) -> Int {
  r = other
  1
}

fn take_with_int_check(a : String, want : String, x : Int) -> Int {
  assert_str_eq(a, want) + x
}

fn test_layer1_and_negatives() -> Int {
  let t = make_top(1)
  let m = t.mid
  let l = m.leaf
  let n = l.name
  let tag = t.mid.leaf.tag
  let _noise = make_top(999)
  let p1 = assert_str_eq(n, "node-1-payload") + assert_str_eq(tag, "tag-1-extra")

  let mut r = make_top_named("old-root-10-orig", "t10")
  let a = r.mid.leaf.name
  r = make_top_named("REPLACED-11", "t11")
  let s1 = assert_str_eq(a, "old-root-10-orig")

  let mut r2 = make_top_named("old-mutarg-12-orig", "t12")
  let a2 = r2.mid.leaf.name
  let _ = swap_top(mut r2, make_top_named("REPLACED-13", "t13"))
  let s2 = assert_str_eq(a2, "old-mutarg-12-orig")

  let mut r3 = make_top_named("old-mutself-14-orig", "t14")
  let a3 = r3.mid.leaf.name
  let _ = r3.replace_self(make_top_named("REPLACED-15", "t15"))
  let s3 = assert_str_eq(a3, "old-mutself-14-orig")

  let r4 = make_top_named("field-16", "t16")
  let a4 = r4.mid_mut.leaf.name
  r4.mid_mut.leaf = Leaf::{ name: "REPLACED-MUTFIELD", tag: "rt" }
  let s4 = assert_str_eq(a4, "mut-field-16")

  let mut r5 = make_top_named("old-cell-17-orig", "t17")
  let reset_r5 = fn() -> Unit { r5 = make_top_named("REPLACED-CELL-18", "t18") }
  let a5 = r5.mid.leaf.name
  reset_r5()
  let s5 = assert_str_eq(a5, "old-cell-17-orig")

  p1 + s1 + s2 + s3 + s4 + s5
}

fn test_layer2_and_closure() -> Int {
  let mut r1 = make_top_named("arg-block-20-orig", "t20")
  let x1 = take_with_int_check(r1.mid.leaf.name, "arg-block-20-orig", {
    r1 = make_top_named("REPLACED-21", "t21")
    1
  })

  let mut r2 = make_top_named("arg-mutarg-22-orig", "t22")
  let x2 = take_with_int_check(
    r2.mid.leaf.name,
    "arg-mutarg-22-orig",
    swap_top(mut r2, make_top_named("REPLACED-23", "t23")),
  )

  let mut r3 = make_top_named("arg-mutself-24-orig", "t24")
  let x3 = take_with_int_check(
    r3.mid.leaf.name,
    "arg-mutself-24-orig",
    r3.replace_self(make_top_named("REPLACED-25", "t25")),
  )

  let mut r4 = make_top_named("arg-if-26-orig", "t26")
  let x4 = take_with_int_check(
    r4.mid.leaf.name,
    "arg-if-26-orig",
    if x3 > 0 { r4.replace_self(make_top_named("REPLACED-27", "t27")) } else { 0 },
  )

  let mut r5 = make_top_named("arg-after-closure-28-orig", "t28")
  let fns : Array[() -> Int] = [fn() -> Int { 7 }]
  let fv = fns[0]()
  let a5 = r5.mid.leaf.name
  let x5 = take_with_int_check(r5.mid.leaf.name, "arg-after-closure-28-orig", {
    r5 = make_top_named("REPLACED-AFTER-CLOSURE-29", "t29")
    fv
  })
  let x5b = assert_str_eq(a5, "arg-after-closure-28-orig")

  x1 + x2 + x3 + x4 + x5 + x5b
}

fn test_layer3_st() -> Int {
  let t = make_top(30)
  let mut acc = 0
  let mut i = 0
  while i < 3 {
    acc = acc + t.mid.items[i].length()
    i = i + 1
  }
  let bs = "hello-j2-bytes".to_bytes()
  let mut bsum = 0
  let mut j = 0
  while j < bs.length() {
    bsum = bsum + bs[j].to_int()
    j = j + 1
  }
  acc + bsum
}

struct MutBufSt {
  mut src : String
  mut pos : Int
  mut items : Array[Int]
}

fn make_dyn_str_st(prefix : String, id : Int) -> String {
  prefix + "-" + id.to_string() + "-st-payload"
}

fn mutbuf_st_step(b : MutBufSt) -> Int {
  b.pos = b.pos + 1
  b.pos
}

enum MutActionSt { Go }

fn MutActionSt::clobber(b : MutBufSt, s : String) -> Int {
  b.src = s
  0
}

struct MutEqKeySt {
  id : Int
  b : MutBufSt
}

impl Eq for MutEqKeySt {
  fn equal(self : MutEqKeySt, other : MutEqKeySt) -> Bool {
    self.b.src = make_dyn_str_st("ZZZ", 40 + self.id)
    self.id == other.id
  }
}

fn mutbuf_st_clobber_idx(b : MutBufSt, rep : String) -> Int {
  b.src = rep
  0
}

fn test_mut_ref_field_st() -> Int {
  let b1 = MutBufSt::{ src: make_dyn_str_st("pos", 1), pos: 0, items: [] }
  let s1 = b1.src
  let step1 = mutbuf_st_step(b1)
  let mut sum1 = 0
  let mut i = 0
  while i < b1.src.length() {
    sum1 = sum1 + b1.src.code_unit_at(i)
    b1.items.push(i)
    i = i + 1
  }
  let ok1 = assert_str_eq(s1, "pos-1-st-payload") + (if step1 == 1 && sum1 > 0 && b1.items.length() == s1.length() { 1 } else { 0 })

  let b2 = MutBufSt::{ src: make_dyn_str_st("neg", 2), pos: 0, items: [] }
  let b2_alias = b2
  let s2 = b2.src
  b2_alias.src = make_dyn_str_st("REPLACED", 20)
  let ok2 = assert_str_eq(s2, "neg-2-st-payload")

  let b3 = MutBufSt::{ src: make_dyn_str_st("arg", 3), pos: 0, items: [] }
  let ch3 = b3.src.code_unit_at(mutbuf_st_clobber_idx(b3, make_dyn_str_st("REPLACED", 30)))
  let ok3 = if ch3 == 97 { 1 } else { panic("expected 'a' (97), got " + ch3.to_string()) }

  let b4 = MutBufSt::{ src: make_dyn_str_st("aaa", 4), pos: 0, items: [] }
  let s4 = b4.src
  let _ = MutActionSt::clobber(b4, make_dyn_str_st("zzz", 4))
  let junk4 = make_dyn_str_st("qqq", 4)
  let ok4 = assert_str_eq(s4, "aaa-4-st-payload") + 0 * junk4.length()

  let ek1 = 0
  let ek2 = 0
  let b5 = MutBufSt::{ src: make_dyn_str_st("aaa", 5), pos: ek1 + ek2, items: [] }
  let s5 = b5.src
  let ek1 = MutEqKeySt::{ id: 1, b: b5 }
  let ek2 = MutEqKeySt::{ id: 1, b: b5 }
  let eq5 = if ek1 == ek2 { 1 } else { 0 }
  let junk5 = make_dyn_str_st("qqq", 5)
  let ok5 = assert_str_eq(s5, "aaa-5-st-payload") + 0 * junk5.length() + 0 * eq5

  ok1 + ok2 + ok3 + ok4 + ok5
}

pub fn main(_world : World) -> Int {
  let total = test_layer1_and_negatives() + test_layer2_and_closure() + test_layer3_st() + test_mut_ref_field_st()
  io_println("wave_j2_st_ok:" + total.to_string())
  0
}
