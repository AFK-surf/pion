struct Node {
  id : Int
  name : String
}

struct Pt {
  mut x : Int
  y : Int
  label : String
}

struct Counter {
  mut hits : Int
}

fn mk_node_pair(n : Node, other : Option[Node]) -> (Node, Option[Node]) {
  match other {
    None => (n, None)
    Some(m) => (n, Some(m))
  }
}

fn mk_arr_pair(a : Array[Int], b : Array[Int], want_none : Bool) -> (Array[Int], Option[Array[Int]]) {
  if want_none {
    (a, None)
  } else {
    (a, Some(b))
  }
}

fn add2(a : Int, b : Int) -> Int {
  a + b
}

fn mul2(a : Int) -> Int {
  a * 2
}

fn next_idx(c : Counter) -> Int {
  c.hits += 1
  1
}

fn get_pt(c : Counter, p : Pt) -> Pt {
  c.hits += 1
  p
}

fn guard_opt(x : Option[String], min_len : Int) -> Int {
  guard min_len >= 0 else {
    return -1
  }
  guard x is Some(s) && s.length() >= min_len else {
    return -2
  }
  s.length()
}

fn main(world : World) -> Unit {
  // 1. Bug #4: ETuple expected type propagation (null-niche Option in tuple)
  let n1 = Node::{ id: 1, name: "root" }
  let n2 = Node::{ id: 2, name: "child" }
  let (rn1, before1) = mk_node_pair(n1, None)
  debug_assert(rn1.id == 1 && before1.is_none(), "bug4 (Node, None) must be None")
  let (rn2, before2) = mk_node_pair(n1, Some(n2))
  debug_assert(rn2.id == 1 && before2.is_some(), "bug4 (Node, Some) must be Some")
  match before2 {
    Some(m) => debug_assert(m.id == 2 && m.name == "child", "bug4 Some payload")
    None => debug_assert(false, "bug4 expected Some")
  }

  // Bug #4 with if/else returning (Array[Int], Option[Array[Int]])
  let a1 = [10, 20]
  let b1 = [30, 40, 50]
  let (ra1, oa1) = mk_arr_pair(a1, b1, true)
  debug_assert(ra1.length() == 2 && oa1.is_none(), "bug4 if/else None")
  let (ra2, oa2) = mk_arr_pair(a1, b1, false)
  debug_assert(ra2.length() == 2 && oa2.is_some(), "bug4 if/else Some")
  // Unannotated let with if/else tuple
  let (ra3, oa3) = if true { (a1, None) } else { (a1, Some(b1)) }
  debug_assert(ra3[0] == 10 && oa3.is_none(), "bug4 unannotated if/else None")

  // 2. Scientific notation, \xNN escapes, numeric conversions, Double math, Map::clear
  let eps = 1e-9
  let big = 1E9
  let huge = 1.797e308
  let pos_exp = 1.0e+5
  let half_milli = 0.5e-3
  debug_assert(eps > 0.0 && eps < 1e-8, "1e-9")
  debug_assert(big == 1000000000.0, "1E9")
  debug_assert(huge > 1e300, "1.797e308")
  debug_assert(pos_exp == 100000.0, "1.0e+5")
  debug_assert(half_milli == 0.0005, "0.5e-3")

  let bin_s = "\x41\x00\x42"
  debug_assert(bin_s.length() == 3, "hex len 3")
  debug_assert(bin_s.code_unit_at(0) == 65 && bin_s.code_unit_at(1) == 0 && bin_s.code_unit_at(2) == 66, "hex bytes")
  let hi_s = "\x80\xff"
  debug_assert(hi_s.length() == 2 && hi_s.code_unit_at(0) == 128 && hi_s.code_unit_at(1) == 255, "high hex bytes")
  let interp_hex = "X\{42}\x41\x00"
  debug_assert(interp_hex.length() == 5 && interp_hex.code_unit_at(3) == 65 && interp_hex.code_unit_at(4) == 0, "interp hex")

  debug_assert(42.to_double() == 42.0, "Int::to_double")
  debug_assert(100L.to_double() == 100.0, "Int64::to_double")
  let bits = 1.5.to_bits()
  debug_assert(Double::from_bits(bits) == 1.5, "Double bits roundtrip")
  debug_assert((-3.5).abs().floor().to_int() == 3, "abs+floor+to_int")
  debug_assert(3.2.ceil().to_int() == 4, "ceil")
  debug_assert(2.6.round().to_int() == 3, "round")
  debug_assert((-2.9).trunc().to_int() == -2, "trunc")
  debug_assert(9.0.sqrt().to_int() == 3, "sqrt")
  debug_assert(1234567890.0.to_int64() == 1234567890L, "Double::to_int64")
  debug_assert((-42).abs() == 42 && 42.abs() == 42, "Int::abs")
  debug_assert((-9000000000L).abs() == 9000000000L, "Int64::abs")

  let m : Map[String, String] = Map::new()
  m.set("k1", "val1")
  m.set("k2", "val2")
  debug_assert(m.length() == 2, "map len before clear")
  m.clear()
  debug_assert(m.length() == 0 && !m.contains("k1"), "map cleared")
  m.set("k3", "val3")
  debug_assert(m.length() == 1 && m.get("k3").unwrap_or("") == "val3", "map reuse after clear")

  // 3. Pipe |> & ignore
  let piped = 10 |> add2(5) |> mul2
  debug_assert(piped == 30, "pipe operator")
  ("drop_me_" + "heap") |> ignore

  // 4. Compound assignment (locals, arr[i], obj.f, String, Double, Map)
  let mut v = 10
  v += 5
  v -= 3
  v *= 4
  v /= 6
  v %= 5
  v |= 8
  v &= 15
  v ^= 3
  debug_assert(v == 8, "int compound assign")

  let mut ds = 1.5
  ds += 2.25
  ds *= 2.0
  debug_assert(ds == 7.5, "double compound assign")

  let mut s = "hi"
  s += "!"
  debug_assert(s == "hi!", "string += ")

  let ctr = Counter::{ hits: 0 }
  let nums = [10, 20, 30]
  nums[next_idx(ctr)] += 5
  debug_assert(nums[1] == 25 && ctr.hits == 1, "arr[i] += evaluates index once")

  let p0 = Pt::{ x: 1, y: 2, label: "origin" }
  get_pt(ctr, p0).x += 10
  debug_assert(p0.x == 11 && ctr.hits == 2, "obj.f += evaluates receiver once")

  let mc : Map[String, Int] = Map::new()
  mc.set("a", 7)
  mc["a"] += 3
  debug_assert(mc.get("a").unwrap_or(0) == 10, "map[k] += ")

  // 5. guard & is pattern expressions (including heap String RC cleanup on partial && fail)
  debug_assert(guard_opt(Some("hello"), 3) == 5, "guard ok")
  debug_assert(guard_opt(Some("hi"), 3) == -2, "guard partial && fail")
  debug_assert(guard_opt(None, 3) == -2, "guard None fail")
  debug_assert(guard_opt(Some("hello"), -1) == -1, "guard bool fail")

  let os : Option[String] = Some("pion" + "_lang")
  let mut if_hit = 0
  if os is Some(sv) && sv.length() > 100 {
    if_hit = 1
  } else {
    if_hit = 2
  }
  debug_assert(if_hit == 2, "if is && false branch with RC cleanup")
  if os is Some(sv) && sv.length() == 9 {
    if_hit = 3
  }
  debug_assert(if_hit == 3, "if is && true branch")
  let is_ok = os is Some(_)
  let is_no = os is None
  debug_assert(is_ok && !is_no, "standalone is")

  let mut wopt : Option[String] = Some("a")
  let mut wsum = 0
  while wopt is Some(ws) {
    wsum += ws.length()
    if ws.length() >= 4 {
      wopt = None
    } else {
      wopt = Some(ws + "a")
    }
  }
  debug_assert(wsum == 10, "while is Some")

  // 6. Ranges ..<, ..=, and indexed for i, x in arr
  let mut r1 = 0
  for i in 0..<5 {
    r1 += i
  }
  let mut r2 = 0
  for i in 0..=5 {
    r2 += i
  }
  debug_assert(r1 == 10 && r2 == 15, "ranges ..< and ..=")

  let mut isum = 0
  let words = ["a", "bb", "ccc"]
  for idx, w in words {
    isum += idx * 10 + w.length()
  }
  debug_assert(isum == 36, "for i, x in arr")

  // 7. Struct shorthand & functional update with heap String field
  let x = 3
  let y = 4
  let label = "pt_" + "one"
  let p1 = Pt::{ x, y, label }
  let p2 = Pt::{ ..p1, x: 99 }
  debug_assert(p1.x == 3 && p2.x == 99 && p2.y == 4 && p2.label == "pt_one", "struct shorthand & update")

  io_println(world, "p27a_ergonomics_bug4 ok")
}
