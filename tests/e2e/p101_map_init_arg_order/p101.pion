pub struct Pt {
  x : Int
  y : Int
}

pub struct Acc {
  mut v : Int
}

pub struct Cnt {
  base : Int
}

pub enum Er {
  Bad(Int)
}

fn tick(mut n : Int) -> Int {
  n = n + 1
  n
}

fn take(a~ : Int, b~ : Int) -> Int {
  a * 10 + b
}

fn take_big(a~ : Int, b~ : Int, w : World) -> Int {
  // Loop + IO keep this out of the single-pass inliner.
  let mut i = 0
  let mut acc = 0
  while i < 1 {
    acc = acc + a * 10 + b
    i = i + 1
  }
  io_println(w, "take_big " + acc.to_string())
  acc
}

fn take_opt(a~ : Int, b? : Int, c~ : Int = 5) -> Int {
  let bv = match b {
    Some(x) => x
    None => 0
  }
  a * 100 + bv * 10 + c
}

fn take_mut(mut p : Int, a~ : Int, b~ : Int) -> Int {
  p = p + 100
  a * 10 + b
}

fn join2(a~ : String, b~ : String) -> String {
  a + "-" + b
}

fn gen2[T](a~ : T, b~ : T, xs~ : Array[T]) -> Array[T] {
  xs.push(a)
  xs.push(b)
  xs
}

fn hof(f~ : (Int) -> Int, a~ : Int, b~ : Int) -> Int {
  f(a) * 10 + f(b)
}

fn tail(a~ : Int, b~ : Int) -> Int {
  if a <= 0 {
    b
  } else {
    tail(b=b + a, a=a - 1)
  }
}

fn mk_pt(x~ : Int, y~ : Int) -> Pt {
  Pt::{ x: x, y: y }
}

fn find(a~ : Int, b~ : Int) -> Option[Int] {
  if a > 9000 {
    None
  } else {
    Some(a * 10 + b)
  }
}

fn Cnt::take(self : Cnt, a~ : Int, b~ : Int) -> Int {
  self.base + a * 10 + b
}

fn Cnt::make(a~ : Int, b~ : Int) -> Cnt {
  Cnt::{ base: a * 10 + b }
}

pub trait Tk {
  tk(self : Self, a : Int, b : Int) -> Int
}

impl Tk for Cnt {
  fn tk(self : Cnt, a : Int, b : Int) -> Int {
    self.base + a * 10 + b
  }
}

fn bump_s(acc : Acc, s : String) -> String {
  acc.v = acc.v + 1
  s + acc.v.to_string()
}

fn f9() -> Int {
  9
}

fn may_fail(n : Int) -> Result[Int, Er] {
  if n < 0 {
    Err(Bad(n))
  } else {
    Ok(n)
  }
}

fn map_try(n : Int) -> Result[Int, Er] {
  let m : Map[String, Array[Int]] = Map([("a" + n.to_string(), [1, 2]), ("b", [may_fail(n)?])])
  Ok(m.length())
}

fn map_ret(n : Int) -> Int {
  let m : Map[Int, String] = Map([(1, "x" + n.to_string()), (2, if n > 2 { return 77 } else { "y" + n.to_string() })])
  m.length()
}

fn gmap[K, V](k : K, v : V) -> Array[V] {
  let m : Map[String, V] = Map([("k", v)])
  let out : Array[V] = []
  match m.get("k") {
    Some(x) => out.push(x)
    None => ()
  }
  let _ = k
  out
}

fn mk_map() -> Map[String, Int] {
  Map([("z", 26), ("y", 25)])
}

fn map_sum(m : Map[Int, Int]) -> Int {
  let mut t = 0
  for k in m.keys() {
    match m.get(k) {
      Some(v) => t = t + k * v
      None => ()
    }
  }
  t
}

pub struct Holder {
  m : Map[String, String]
}

fn geti(m : Map[Int, Int], k : Int) -> Int {
  match m.get(k) {
    Some(v) => v
    None => -1
  }
}

fn gets(m : Map[String, Int], k : String) -> Int {
  match m.get(k) {
    Some(v) => v
    None => -1
  }
}

fn maps(w : World) -> Unit {
  let m1 : Map[Int, Int] = Map([(1, 9)])
  io_println(w, "single \{m1.length()} \{geti(m1, 1)}")
  let m2 : Map[String, Int] = Map([("a", 1), ("b", 2)])
  io_println(w, "str \{m2.length()} \{gets(m2, "a")} \{gets(m2, "b")} \{gets(m2, "c")}")
  let m3 : Map[Int, Int] = Map([(1, 10), (1, 13)])
  io_println(w, "dup \{m3.length()} \{geti(m3, 1)}")
  let m4 : Map[Int, Int] = Map([(1, f9())])
  io_println(w, "call \{geti(m4, 1)}")
  let mut n = 0
  let m5 : Map[Int, Int] = Map([(tick(mut n), tick(mut n)), (tick(mut n), tick(mut n))])
  io_println(w, "order \{n} \{geti(m5, 1)} \{geti(m5, 3)}")
  let m6 : Map[Int, Array[Int]] = Map([(1, [1, 2, 3]), (2, [4]), (1, [5, 6])])
  match m6.get(1) {
    Some(a) => io_println(w, "arr \{m6.length()} \{a.length()} \{a[1]}")
    None => io_println(w, "arr none")
  }
  let shared = ["s" + n.to_string()]
  let key = "k" + n.to_string()
  let m7 : Map[String, Array[String]] = Map([(key, shared), (key + "2", shared)])
  shared.push("t")
  match m7.get(key) {
    Some(a) => io_println(w, "shared \{m7.length()} \{a.length()} \{key}")
    None => io_println(w, "shared none")
  }
  let m8 : Map[(Int, Int), String] = Map([((1, 2), "p" + key), ((3, 4), "q"), ((1, 2), "r" + key)])
  match m8.get((1, 2)) {
    Some(s) => io_println(w, "vmap \{m8.length()} \{s}")
    None => io_println(w, "vmap none")
  }
  let m9 : Map[Pt, Int] = Map([(Pt::{ x: 1, y: 2 }, 12), (Pt::{ x: 3, y: 4 }, 34)])
  match m9.get(Pt::{ x: 3, y: 4 }) {
    Some(v) => io_println(w, "pod \{m9.length()} \{v}")
    None => io_println(w, "pod none")
  }
  let m10 = Map([("i" + key, [1]), ("j", [2, 3])])
  io_println(w, "infer \{m10.length()}")
  let pairs : Array[(String, Array[Int])] = [("a" + key, [1]), ("b", [2, 2]), ("b", [3, 3, 3])]
  let m11 : Map[String, Array[Int]] = Map(pairs)
  match m11.get("b") {
    Some(a) => io_println(w, "pairs \{m11.length()} \{a.length()}")
    None => io_println(w, "pairs none")
  }
  let pr : (String, Int) = ("pr" + key, 41)
  let m12 : Map[String, Int] = Map([pr, ("x", 1)])
  io_println(w, "elem \{m12.length()} \{gets(m12, "pr" + key)}")
  let h = Holder::{ m: Map([("f", "v" + key)]) }
  match h.m.get("f") {
    Some(s) => io_println(w, "field \{s}")
    None => io_println(w, "field none")
  }
  io_println(w, "ret \{mk_map().length()} \{gets(mk_map(), "y")} \{map_sum(Map([(2, 3), (4, 5)]))}")
  let m13 : Map[String, Map[Int, String]] = Map([("in", Map([(7, "n" + key)]))])
  match m13.get("in") {
    Some(mi) =>
      match mi.get(7) {
        Some(s) => io_println(w, "nested \{s}")
        None => io_println(w, "nested none")
      }
    None => io_println(w, "nested none")
  }
  let m14 : Map[Int, Option[String]] = Map([(1, None), (2, Some("o" + key))])
  io_println(w, "opt \{m14.length()}")
  let m15 : Map[Char, Double] = Map([('a', 1.5), ('b', 2.5)])
  match m15.get('b') {
    Some(d) => io_println(w, "dbl \{d}")
    None => io_println(w, "dbl none")
  }
  let g = gmap(1, "g" + key)
  io_println(w, "gen \{g[0]} \{gmap("q", 5)[0]}")
  match map_try(3) {
    Ok(v) => io_println(w, "try \{v}")
    Err(Bad(v)) => io_println(w, "try err \{v}")
  }
  match map_try(-3) {
    Ok(v) => io_println(w, "try \{v}")
    Err(Bad(v)) => io_println(w, "try err \{v}")
  }
  io_println(w, "early \{map_ret(1)} \{map_ret(5)}")
  let mut i = 0
  let mut tot = 0
  while i < 3000 {
    let lm : Map[String, Array[Int]] = Map([("a" + i.to_string(), [i, i]), ("a" + i.to_string(), [i]), ("b", [i])])
    tot = tot + lm.length() + map_ret(i) + gets(Map([("w", i)]), "w")
    i = i + 1
  }
  io_println(w, "loop \{tot}")
}

fn orders(w : World) -> Unit {
  let mut n = 0
  io_println(w, "free \{take(b=tick(mut n), a=tick(mut n))}")
  n = 0
  io_println(w, "free same \{take(a=tick(mut n), b=tick(mut n))}")
  n = 0
  let tb = take_big(b=tick(mut n), a=tick(mut n), w)
  io_println(w, "big \{tb}")
  n = 0
  io_println(w, "opt \{take_opt(c=tick(mut n), b=tick(mut n), a=tick(mut n))}")
  n = 0
  io_println(w, "opt default \{take_opt(b=tick(mut n), a=tick(mut n))}")
  n = 0
  io_println(w, "opt none \{take_opt(c=tick(mut n), a=tick(mut n))}")
  n = 0
  let mut p = 1
  let tm = take_mut(b=tick(mut n), mut p, a=tick(mut n))
  io_println(w, "mut \{tm} \{p}")
  n = 5
  io_println(w, "read \{take(b=tick(mut n), a=n)} \{take(b=n, a=tick(mut n))}")
  let acc = Acc::{ v: 0 }
  io_println(w, "heap \{join2(b=bump_s(acc, "x"), a=bump_s(acc, "y"))}")
  let c = Cnt::{ base: 1000 }
  n = 0
  io_println(w, "method \{c.take(b=tick(mut n), a=tick(mut n))}")
  n = 0
  io_println(w, "trait \{c.tk(tick(mut n), tick(mut n))}")
  n = 0
  io_println(w, "static \{Cnt::make(b=tick(mut n), a=tick(mut n)).base}")
  n = 0
  let pt = mk_pt(y=tick(mut n), x=tick(mut n))
  io_println(w, "pod \{pt.x} \{pt.y}")
  n = 0
  let fv = match find(b=tick(mut n), a=tick(mut n)) {
    Some(v) => v
    None => -1
  }
  io_println(w, "optres \{fv}")
  n = 0
  io_println(w, "hof \{hof(b=tick(mut n), f=fn(x : Int) -> Int { x + 1 }, a=tick(mut n))}")
  io_println(w, "tail \{tail(b=0, a=100000)}")
  let ga = gen2(xs=["s" + n.to_string()], b=bump_s(acc, "b"), a=bump_s(acc, "a"))
  io_println(w, "gen \{ga.length()} \{ga[1]} \{ga[2]}")
  n = 0
  let gi = gen2(b=tick(mut n), a=tick(mut n), xs=[])
  io_println(w, "gen int \{gi[0]} \{gi[1]}")
}

fn id[T](x : T) -> T {
  x
}

fn gp[K, V](k : K, v : V) -> Array[(K, V)] {
  [(k, v)]
}

fn keep[T](x~ : T, o~ : Option[T]) -> Int {
  match o {
    Some(_) => 1
    None => 2
  }
}

pub struct Bx {
  b : Int
}

fn Bx::keep[T](self : Bx, x~ : T, o~ : Option[T]) -> Int {
  match o {
    Some(_) => self.b + 1
    None => self.b + 2
  }
}

fn gkeep[T](v : T) -> Int {
  keep(o=None, x=id(v))
}

fn gmap_free[T](k : String, v : T) -> Int {
  let m = Map([(id(k), id(v))])
  m.length()
}

fn size[K, V](m : Map[K, V]) -> Int {
  m.length()
}

fn exit_ret(n : Int) -> Int {
  join2(b="owned-" + n.to_string(), a=if n > 0 { return 77 } else { "z" }).length()
}

fn exit_try(n : Int) -> Result[Int, Er] {
  Ok(len3("p" + n.to_string(), ["q" + n.to_string()], may_fail(n)?))
}

fn len3(a : String, b : Array[String], n : Int) -> Int {
  a.length() + b.length() + n
}

fn exit_loop(n : Int) -> Int {
  let mut t = 0
  let mut i = 0
  while i < n {
    i = i + 1
    t = t + len3("l" + i.to_string(), ["m"], if i == 2 { continue } else if i == 5 { break } else { i })
  }
  t
}

pub struct Nm {
  mut name : String
  mut k : Int
}

fn Nm::glue(self : Nm, a : String, n : Int) -> String {
  self.name + a + n.to_string()
}

fn mk_nm(n : Int) -> Nm {
  Nm::{ name: "nm" + n.to_string(), k: n }
}

fn exit_recv(n : Int) -> Result[String, Er] {
  Ok(mk_nm(n).glue("g" + n.to_string(), may_fail(n)?))
}

fn set_mut(mut s : String, t : String, n : Int) -> Int {
  s = s + t + n.to_string()
  s.length()
}

fn exit_mut(n : Int) -> Result[String, Er] {
  let mut s = "s" + n.to_string()
  let k = set_mut(mut s, "t" + n.to_string(), may_fail(n)?)
  Ok(s + k.to_string())
}

fn exit_mut_idx(n : Int) -> Result[String, Er] {
  let mut xs = ["e" + n.to_string(), "f"]
  let mut i = n + 1
  i = i - n - 1
  let k = set_mut(mut xs[i + 0], "t" + n.to_string(), may_fail(n)?)
  Ok(xs[0] + k.to_string())
}

fn exit_clo(n : Int) -> Result[Int, Er] {
  let pre = "c" + n.to_string()
  let f = fn(a : String, k : Int) -> Int { pre.length() + a.length() + k }
  Ok(f("d" + n.to_string(), may_fail(n)?))
}

fn exit_lit(n : Int) -> Result[String, Er] {
  let base = mk_nm(7)
  let x = Nm::{ ..base, k: may_fail(n)? }
  let y = Nm::{ name: "y" + n.to_string(), k: may_fail(n - 1)? }
  Ok(x.name + y.name)
}

fn set42(mut x : Int, b~ : Int) -> Int {
  x = 42
  b
}

fn set_s(mut x : String, b~ : Int) -> Int {
  x = x + "!"
  b
}

fn set_k(mut x : Int, h : Nm) -> Unit {
  x = 42
  h.k = 1
}

pub struct Cell {
  mut v : Int
  mut tag : String
}

pub struct Grid {
  mut rows : Array[Array[Int]]
  mut cells : Array[Cell]
}

fn swap_rows(g : Grid) -> Int {
  g.rows = [[0, 0], [0, 0]]
  9
}

pub struct Mp {
  mut x : Int
  y : Int
}

fn change_in_place(mut p : Mp) -> Int {
  p.x = 7
  9
}

pub struct Sp {
  mut s : String
  y : Int
}

fn change_s(mut p : Sp, n : Int) -> Int {
  p.s = "new" + n.to_string()
  n
}

fn res_s(r : Result[String, Er]) -> String {
  match r {
    Ok(s) => s
    Err(Bad(n)) => "err" + n.to_string()
  }
}

fn res_i(r : Result[Int, Er]) -> String {
  match r {
    Ok(s) => s.to_string()
    Err(Bad(n)) => "err" + n.to_string()
  }
}

fn review(w : World) -> Unit {
  let m1 = Map([(id(7), 42)])
  match m1.get(7) {
    Some(v) => io_println(w, "q map id \{v}")
    None => io_println(w, "q map id none")
  }
  let m2 = Map(gp(7, "seven"))
  match m2.get(7) {
    Some(v) => io_println(w, "q map gp \{v}")
    None => io_println(w, "q map gp none")
  }
  let bx = Bx::{ b: 40 }
  let m4 = Map(
    match bx.b {
      40 => gp((1, 2), [bx.b])
      _ => []
    },
  )
  match m4.get((1, 2)) {
    Some(a) => io_println(w, "q map match \{m4.length()} \{a[0]}")
    None => io_println(w, "q map match none")
  }
  io_println(w, "q gmap \{gmap_free("k", 5)} \{gmap_free("k", "v" + bx.b.to_string())} \{size(Map([(1, 2), (3, 4)]))} \{size(Map([("a", [1])]))} \{size(Map(gp(id('c'), "x")))}")
  let __map_init_1 : Map[Int, Int] = Map::new()
  __map_init_1.set(5, 10)
  let mh : Map[Int, Int] = Map([(2, __map_init_1.length())])
  io_println(w, "q hidden \{geti(mh, 2)}")
  io_println(w, "q none \{keep(x=id("s"), o=None)} \{keep(o=None, x=id("s"))} \{keep(o=Some("t"), x=id("s"))} \{keep(o=None, x=id(3))}")
  io_println(w, "q none if \{keep(o=if bx.b > 1 { None } else { Some("u") }, x=id(id("s")))} \{bx.keep(o=None, x=id("s"))} \{gkeep("s" + bx.b.to_string())} \{gkeep(4)} \{gkeep([1])}")
  io_println(w, "q exit \{exit_ret(7)} \{exit_ret(0)} \{res_i(exit_try(3))} \{res_i(exit_try(-3))} \{exit_loop(9)}")
  io_println(w, "q exit2 \{res_s(exit_recv(3))} \{res_s(exit_recv(-3))} \{res_s(exit_mut(3))} \{res_s(exit_mut(-3))}")
  io_println(w, "q exit3 \{res_s(exit_mut_idx(3))} \{res_s(exit_mut_idx(-3))} \{res_i(exit_clo(3))} \{res_i(exit_clo(-3))}")
  io_println(w, "q exit4 \{res_s(exit_lit(3))} \{res_s(exit_lit(0))} \{res_s(exit_lit(-3))}")
  let mut arr = [5, 6]
  let mut i = 0
  let r1 = set42(mut arr[i], b=tick(mut i))
  io_println(w, "q idx \{arr[0]} \{arr[1]} \{i} \{r1}")
  let mut ss = ["a" + i.to_string(), "b"]
  i = 0
  let r2 = set_s(mut ss[i], b=tick(mut i))
  io_println(w, "q idx str \{ss[0]} \{ss[1]} \{r2}")
  let mut g = Grid::{ rows: [[1, 2], [3, 4]], cells: [Cell::{ v: 1, tag: "x" }, Cell::{ v: 2, tag: "y" }] }
  i = 0
  let r3 = set42(mut g.rows[i + 1][i], b=tick(mut i))
  io_println(w, "q idx nest \{g.rows[1][0]} \{g.rows[1][1]} \{r3}")
  i = 0
  let r4 = set_s(mut g.cells[i].tag, b=tick(mut i))
  io_println(w, "q idx field \{g.cells[0].tag} \{g.cells[1].tag} \{r4}")
  let old = g.rows
  let r5 = set42(mut g.rows[1][1], b=swap_rows(g))
  io_println(w, "q idx base \{old[1][1]} \{g.rows[1][1]} \{r5}")
  let h = mk_nm(0)
  let mut ks = [8, 9]
  set_k(mut ks[h.k], h)
  io_println(w, "q idx callee \{ks[0]} \{ks[1]}")
  let mut p = Mp::{ x: 1, y: 2 }
  let q = Mp::{ ..p, y: change_in_place(mut p) }
  io_println(w, "q base \{q.x}\{q.y} \{p.x}")
  let mut sp = Sp::{ s: "old" + i.to_string(), y: 1 }
  let sq = Sp::{ ..sp, y: change_s(mut sp, 3) }
  io_println(w, "q base str \{sq.s} \{sq.y} \{sp.s}")
  let mut li = 0
  let mut lt = 0
  while li < 2000 {
    lt = lt + exit_ret(li) + exit_loop(li % 7)
    let mut la = ["x" + li.to_string()]
    let mut lz = li - li
    lt = lt + set_s(mut la[lz], b=tick(mut lz)) + la[0].length()
    li = li + 1
  }
  io_println(w, "q loop \{lt}")
}

fn make(cap : String) -> (String, Int) -> Int {
  fn(a : String, k : Int) -> Int { cap.length() + a.length() + k }
}

fn exit_clo_expr(n : Int) -> Int {
  make("capture" + n.to_string())("temp" + n.to_string(), if n > 0 { return 77 } else { n })
}

pub struct FnBox {
  f : (String, Int) -> Int
}

fn exit_clo_field(n : Int) -> Int {
  let box = FnBox::{ f: make("capture" + n.to_string()) }
  box.f("temp" + n.to_string(), if n > 0 { return 77 } else { n })
}

pub trait Goer {
  go(self : Self, a : String, k : Int) -> Int
}

pub struct Gv {
  s : String
}

impl Goer for Gv {
  fn go(self : Gv, a : String, k : Int) -> Int {
    self.s.length() + a.length() + k
  }
}

fn mk_goer(n : Int) -> dyn Goer {
  Gv::{ s: "recv" + n.to_string() }
}

fn exit_dyn(n : Int) -> Int {
  mk_goer(n).go("temp" + n.to_string(), if n > 0 { return 77 } else { n })
}

pub enum Two {
  Both(String, Int)
}

fn exit_ctor(n : Int) -> Int {
  match Both("temp" + n.to_string(), if n > 0 { return 77 } else { n }) {
    Both(s, k) => s.length() + k
  }
}

fn put(mut x : Int, after~ : Int) -> Int {
  x = 42
  after
}

fn put_s(mut x : String, after~ : Int) -> Int {
  x = x + "!"
  after
}

fn replace(xs : Array[Cell]) -> Int {
  xs[0] = Cell::{ v: 9, tag: "new" + xs.length().to_string() }
  3
}

fn put_in(mut x : Int, xs : Array[Cell]) -> Unit {
  let _ = replace(xs)
  x = 42
}

pub struct Deep {
  mut c : Cell
}

fn swap_c(d : Deep) -> Int {
  d.c = Cell::{ v: 9, tag: "dn" }
  4
}

fn swap_local(mut c : Cell) -> Int {
  c = Cell::{ v: 9, tag: "ln" }
  5
}

fn review2(w : World) -> Unit {
  io_println(w, "r exit \{exit_clo_expr(7)} \{exit_clo_expr(0)} \{exit_clo_field(7)} \{exit_clo_field(0)} \{exit_dyn(7)} \{exit_dyn(0)} \{exit_ctor(7)} \{exit_ctor(0)}")
  let old = Cell::{ v: 5, tag: "t" }
  let mut xs = [old]
  let alias = xs
  let r1 = put(mut xs[0].v, after=replace(alias))
  io_println(w, "r host \{old.v} \{xs[0].v} \{r1}")
  let old2 = Cell::{ v: 5, tag: "t" + r1.to_string() }
  let mut ys = [old2]
  let alias2 = ys
  let r2 = put_s(mut ys[0].tag, after=replace(alias2))
  io_println(w, "r host str \{old2.tag} \{ys[0].tag} \{r2}")
  let old3 = Cell::{ v: 5, tag: "t" }
  let mut zs = [old3]
  let alias3 = zs
  put_in(mut zs[0].v, alias3)
  io_println(w, "r host callee \{old3.v} \{zs[0].v}")
  let old4 = Cell::{ v: 5, tag: "t" }
  let mut d = Deep::{ c: old4 }
  let da = d
  let r4 = put(mut d.c.v, after=swap_c(da))
  io_println(w, "r host field \{old4.v} \{d.c.v} \{r4}")
  let old5 = Cell::{ v: 5, tag: "t" }
  let mut c5 = old5
  let r5 = put(mut c5.v, after=swap_local(mut c5))
  io_println(w, "r host local \{old5.v} \{c5.v} \{r5}")
  let mut i = 0
  let mut t = 0
  while i < 500 {
    t = t + exit_clo_expr(i) + exit_clo_field(i) + exit_dyn(i) + exit_ctor(i)
    let mut vs = [Cell::{ v: i, tag: "q" + i.to_string() }]
    t = t + put_s(mut vs[0].tag, after=replace(vs))
    i = i + 1
  }
  io_println(w, "r loop \{t}")
}

fn main(w : World) -> Unit {
  maps(w)
  orders(w)
  review(w)
  review2(w)
}
