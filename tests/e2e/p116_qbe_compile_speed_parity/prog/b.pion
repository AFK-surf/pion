// Many values live across a loop with a rarely taken call.
fn tick(a : Int, b : Int) -> Int {
  ((a * 33) + b) & 4095
}

fn word_mix(seed : Int, n : Int) -> Int {
  let mut a0 = seed & 4095
  let mut a1 = (seed >> 2) & 4095
  let mut a2 = (seed + 7) & 4095
  let mut a3 = (seed + 13) & 4095
  let mut a4 = (seed + 29) & 4095
  let mut a5 = (seed + 31) & 4095
  let mut i = 0
  while i < n {
    a0 = (a0 + a1) & 4095
    a1 = (a1 ^ a2) & 4095
    a2 = (a2 + a3 * 3) & 4095
    if (i % 7) == 3 {
      a3 = tick(a3, a4)
    }
    a4 = (a4 + a5 + i) & 4095
    a5 = (a5 ^ a0) & 4095
    i = i + 1
  }
  (a0 + a1 * 3 + a2 * 5 + a3 * 7 + a4 * 11 + a5 * 13) & 1048575
}
