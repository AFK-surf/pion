// P116 multi-file package: the largest file (big.pion) is a separate QBE unit,
// emitted on the main thread before the workers start (drv_emit_isolated_unit).
pub fn main(world : World) -> Int {
  let mut total = 0
  let mut seed = 1
  while seed <= 6 {
    let code = make_code(seed * 7919, 40 + seed * 9)
    let v = interp(code, seed * 31, 64 * seed)
    let h = fold_hash(seed, 300 + seed)
    let w = word_mix(seed * 1009, 50)
    io_println(world, "seed=" + seed.to_string() + " vm=" + v.to_string() + " fold=" + h.to_string() + " mix=" + w.to_string())
    total = (total * 131 + v + h + w) & 1048575
    seed = seed + 1
  }
  io_println(world, "total=" + total.to_string())
  0
}
