// Loop-carried values redefined on several paths (non-SSA input to phi placement).
fn fold_hash(seed : Int, n : Int) -> Int {
  let mut x = seed
  let mut y = 0
  let mut i = 0
  while i < n {
    if (i & 3) == 0 {
      x = (x * 5 + i) & 65535
    } else if (i & 3) == 1 {
      y = (y + x) & 65535
    } else {
      x = (x + y + 1) & 65535
    }
    i = i + 1
  }
  (x * 65536 + y) & 1048575
}
