// The largest unit: a `match` interpreter (a QBE jump table in a loop) with
// many loop-carried registers, a call on a minority of opcodes and gaps.
fn make_code(seed : Int, n : Int) -> Array[Int] {
  let code : Array[Int] = []
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 75 + 74) % 65537
    code.push(s % 13 - 1)
    i = i + 1
  }
  code
}

fn slow_mix(a : Int, b : Int) -> Int {
  if b <= 0 {
    a & 1048575
  } else {
    slow_mix((a * 5 + b) & 1048575, b - 1)
  }
}

fn interp(code : Array[Int], seed : Int, rounds : Int) -> Int {
  let n = code.length()
  let mut r0 = seed & 1023
  let mut r1 = (seed + 1) & 1023
  let mut r2 = (seed + 2) & 1023
  let mut r3 = (seed + 3) & 1023
  let mut r4 = (seed + 4) & 1023
  let mut r5 = (seed + 5) & 1023
  let mut r6 = (seed + 6) & 1023
  let mut r7 = (seed + 7) & 1023
  let mut r8 = (seed + 8) & 1023
  let mut r9 = (seed + 9) & 1023
  let mut r10 = (seed + 10) & 1023
  let mut r11 = (seed + 11) & 1023
  let mut acc = 0
  let mut pc = 0
  let mut step = 0
  while step < rounds && n > 0 {
    let op = code[pc]
    match op {
      0 => { r0 = (r0 + r1) & 1023 }
      1 => { r1 = (r1 ^ r2) & 1023 }
      2 => { r2 = (r2 + r3 * 3) & 1023 }
      3 => { r3 = (r3 + r4) & 1023 }
      4 => { r4 = (r4 ^ (r5 + 1)) & 1023 }
      5 => { r5 = (r5 + r6 + r7) & 1023 }
      6 => { acc = slow_mix(acc + r6 + r8, 3) }
      7 => { r7 = (r7 + r8 * 5) & 1023 }
      9 => { r9 = (r9 + r10) & 1023 }
      10 => { r10 = (r10 ^ r11) & 1023 }
      11 => { r11 = (r11 + r0 + 1) & 1023 }
      _ => { acc = (acc + op + 2) & 1048575 }
    }
    r8 = (r8 + 1) & 1023
    pc = pc + 1
    if pc >= n {
      pc = 0
    }
    step = step + 1
  }
  (acc + r0 + r1 * 2 + r2 * 3 + r3 * 4 + r4 * 5 + r5 * 6 + r6 * 7 + r7 * 8 + r8 * 9 + r9 * 10 + r10 * 11 + r11 * 12) & 1048575
}
