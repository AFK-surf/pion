# P113 slot conversions, built with the test-only QBE of qbe_slot_hook.c:
# after register allocation each body becomes
#   store{l,w} %rdi/%edi -> SLOT(0); [conv -> %xmm1;] conv SLOT(0) -> %xmm0
# so the conversions read their integer source from the stack slot.
# slot_<g|i><w|l><d|s>: g = grouped (two conversions, xorps), i = isolated.
export function d $slot_gld(l %x) {
@start
	%v =d sltof %x
	ret %v
}
export function s $slot_gls(l %x) {
@start
	%v =s sltof %x
	ret %v
}
export function d $slot_gwd(w %x) {
@start
	%v =d swtof %x
	ret %v
}
export function s $slot_gws(w %x) {
@start
	%v =s swtof %x
	ret %v
}
export function d $slot_ild(l %x) {
@start
	%v =d sltof %x
	ret %v
}
export function s $slot_ils(l %x) {
@start
	%v =s sltof %x
	ret %v
}
export function d $slot_iwd(w %x) {
@start
	%v =d swtof %x
	ret %v
}
export function s $slot_iws(w %x) {
@start
	%v =s swtof %x
	ret %v
}
