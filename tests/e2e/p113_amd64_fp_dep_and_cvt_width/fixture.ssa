# P113 QBE fixture (vendor/qbe/amd64): XMM register copies, neg, div,
# grouped / isolated swtof and sltof, and i64 conversions under register
# pressure. Driven by driver.c; the `.text` of `qbe --obj` and of
# `qbe` + `as` must be byte-identical.

# Ocopy XMM -> XMM (return the second argument).
export function d $second_d(d %a, d %b) {
@start
	ret %b
}
export function s $second_s(s %a, s %b) {
@start
	ret %b
}

# Ocopy through phi copies that swap two XMM values on one edge (no loop:
# loop headers get `.p2align 4`, whose NOP padding differs between --obj
# and GNU as; the branch compares with 1, since a test against 0 is
# `test` in --obj and `cmpl $0` in text).
export function d $swap_sel(d %a, d %b, w %c) {
@start
	%t =w csgew %c, 1
	jnz %t, @swap, @keep
@swap
	jmp @join
@keep
	jmp @join
@join
	%x =d phi @swap %b, @keep %a
	%y =d phi @swap %a, @keep %b
	%r =d sub %x, %y
	ret %r
}

# Ocopy to and from memory stays scalar (movsd / movss).
export function $mem_copy(l %src, l %dst) {
@start
	%a =d loadd %src
	%p =l add %src, 8
	%b =s loads %p
	stored %a, %dst
	%q =l add %dst, 8
	stores %b, %q
	ret
}

# Oneg with a different destination (emitcopy, then xorp with the mask).
export function d $neg_d(d %a, d %b) {
@start
	%r =d neg %b
	ret %r
}
export function s $neg_s(s %a, s %b) {
@start
	%r =s neg %b
	ret %r
}

# Odiv: a / b, b / a (destination is the divisor: xmm15 path), x / x.
export function d $div_ab(d %a, d %b) {
@start
	%r =d div %a, %b
	ret %r
}
export function d $div_ba(d %a, d %b) {
@start
	%r =d div %b, %a
	ret %r
}
export function d $div_xx(d %a) {
@start
	%r =d div %a, %a
	ret %r
}
export function s $div_ab_s(s %a, s %b) {
@start
	%r =s div %a, %b
	ret %r
}
export function s $div_ba_s(s %a, s %b) {
@start
	%r =s div %b, %a
	ret %r
}
export function s $div_xx_s(s %a) {
@start
	%r =s div %a, %a
	ret %r
}

# Isolated conversions: one per block, no xorps.
export function d $iso_wd(w %a) {
@start
	%r =d swtof %a
	ret %r
}
export function d $iso_ld(l %a) {
@start
	%r =d sltof %a
	ret %r
}
export function s $iso_ws(w %a) {
@start
	%r =s swtof %a
	ret %r
}
export function s $iso_ls(l %a) {
@start
	%r =s sltof %a
	ret %r
}

# Grouped conversions: eight in one block, each preceded by xorps.
export function $grouped(l %out, w %a, w %b, l %c, l %d) {
@start
	%x0 =d swtof %a
	%x1 =d swtof %b
	%x2 =d sltof %c
	%x3 =d sltof %d
	%y0 =s swtof %a
	%y1 =s swtof %b
	%y2 =s sltof %c
	%y3 =s sltof %d
	stored %x0, %out
	%o1 =l add %out, 8
	stored %x1, %o1
	%o2 =l add %out, 16
	stored %x2, %o2
	%o3 =l add %out, 24
	stored %x3, %o3
	%o4 =l add %out, 32
	stores %y0, %o4
	%o5 =l add %out, 36
	stores %y1, %o5
	%o6 =l add %out, 40
	stores %y2, %o6
	%o7 =l add %out, 44
	stores %y3, %o7
	ret
}

# Register pressure: 14 general-purpose values, each used three times
# after the i64 conversions, stay live across them, so neighbouring values
# are spilled and reloaded (QBE always reloads a spilled conversion source
# into a register: `amd64_op[].nmem` is 0; the memory-operand forms are
# covered by slots.ssa). $pressure_grouped has two conversions in its block
# (xorps), $pressure_iso / $pressure_iso_s one.
# Out: one 8-byte slot per conversion, then xor, or and and of v[0..13]
# (bitwise only: --obj turns a three-address add into lea, text does not).
export function $pressure_grouped(l %out, l %v) {
@start
	%a0 =l loadl %v
	%p1 =l add %v, 8
	%a1 =l loadl %p1
	%p2 =l add %v, 16
	%a2 =l loadl %p2
	%p3 =l add %v, 24
	%a3 =l loadl %p3
	%p4 =l add %v, 32
	%a4 =l loadl %p4
	%p5 =l add %v, 40
	%a5 =l loadl %p5
	%p6 =l add %v, 48
	%a6 =l loadl %p6
	%p7 =l add %v, 56
	%a7 =l loadl %p7
	%p8 =l add %v, 64
	%a8 =l loadl %p8
	%p9 =l add %v, 72
	%a9 =l loadl %p9
	%p10 =l add %v, 80
	%a10 =l loadl %p10
	%p11 =l add %v, 88
	%a11 =l loadl %p11
	%p12 =l add %v, 96
	%a12 =l loadl %p12
	%p13 =l add %v, 104
	%a13 =l loadl %p13
	%q0 =l add %v, 112
	%c0 =l loadl %q0
	%q1 =l add %v, 120
	%c1 =l loadl %q1
	%r0 =d sltof %c0
	%r1 =s sltof %c1
	%x0 =l xor %a0, %a1
	%x1 =l xor %x0, %a2
	%x2 =l xor %x1, %a3
	%x3 =l xor %x2, %a4
	%x4 =l xor %x3, %a5
	%x5 =l xor %x4, %a6
	%x6 =l xor %x5, %a7
	%x7 =l xor %x6, %a8
	%x8 =l xor %x7, %a9
	%x9 =l xor %x8, %a10
	%x10 =l xor %x9, %a11
	%x11 =l xor %x10, %a12
	%x12 =l xor %x11, %a13
	%y0 =l or %a0, %a1
	%y1 =l or %y0, %a2
	%y2 =l or %y1, %a3
	%y3 =l or %y2, %a4
	%y4 =l or %y3, %a5
	%y5 =l or %y4, %a6
	%y6 =l or %y5, %a7
	%y7 =l or %y6, %a8
	%y8 =l or %y7, %a9
	%y9 =l or %y8, %a10
	%y10 =l or %y9, %a11
	%y11 =l or %y10, %a12
	%y12 =l or %y11, %a13
	%z0 =l and %a0, %a1
	%z1 =l and %z0, %a2
	%z2 =l and %z1, %a3
	%z3 =l and %z2, %a4
	%z4 =l and %z3, %a5
	%z5 =l and %z4, %a6
	%z6 =l and %z5, %a7
	%z7 =l and %z6, %a8
	%z8 =l and %z7, %a9
	%z9 =l and %z8, %a10
	%z10 =l and %z9, %a11
	%z11 =l and %z10, %a12
	%z12 =l and %z11, %a13
	%o0 =l add %out, 0
	stored %r0, %o0
	%o1 =l add %out, 8
	stores %r1, %o1
	%ox =l add %out, 16
	storel %x12, %ox
	%oy =l add %out, 24
	storel %y12, %oy
	%oz =l add %out, 32
	storel %z12, %oz
	ret
}
