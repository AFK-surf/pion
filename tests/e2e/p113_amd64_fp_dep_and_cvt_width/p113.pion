// P113: AMD64 scalar floating-point dependency breaking and the text
// conversion width fix (vendor/qbe/amd64). XMM register copies (plain, from
// `neg` and from `div`) use `movaps`; a block with at least two `swtof` /
// `sltof` zeroes each destination with `xorps` first; the text templates
// spell `cvtsi2{ss,sd}{l,q}`. Every result is printed as its exact IEEE-754
// bit pattern (only NaNs produced by an operation print as `nan`, since
// their sign and payload are not portable) and must match on Native, Wasm32
// and ASan builds.

fn int_min32() -> Int {
  -2147483647 - 1
}

fn int_min64() -> Int64 {
  -9223372036854775807L - 1L
}

fn dbits(x : Double) -> String {
  x.to_bits().to_string()
}

fn fbits(x : Float) -> String {
  x.to_bits().to_string()
}

// Bits, or `nan` for a NaN an operation produced.
fn dres(x : Double) -> String {
  if x.is_nan() {
    "nan"
  } else {
    dbits(x)
  }
}

fn fres(x : Float) -> String {
  if x != x {
    "nan"
  } else {
    fbits(x)
  }
}

// ---- conversions -------------------------------------------------------

// Isolated: one conversion per function.
fn iso_wd(a : Int) -> Double {
  a.to_double()
}

fn iso_ws(a : Int) -> Float {
  (a as Float)
}

fn iso_ld(a : Int64) -> Double {
  a.to_double()
}

fn iso_ls(a : Int64) -> Float {
  (a as Float)
}

// Grouped: eight conversions of mixed widths in one block.
fn grouped(a : Int, b : Int, c : Int64, d : Int64) -> String {
  let x0 = a.to_double()
  let x1 = b.to_double()
  let x2 = c.to_double()
  let x3 = d.to_double()
  let y0 = (a as Float)
  let y1 = b.to_float()
  let y2 = (c as Float)
  let y3 = (d as Float)
  dbits(x0) + " " + dbits(x1) + " " + dbits(x2) + " " + dbits(x3) + " " + fbits(y0) + " " + fbits(y1) + " " + fbits(y2) + " " + fbits(y3)
}

// A spectralnorm-like loop: two conversions per iteration.
fn loop_sum(xs : Array[Int], ys : Array[Int64]) -> Double {
  let mut acc = 0.0
  let mut j = 0
  while j < xs.length() {
    let p = xs[j].to_double()
    let q = ys[j].to_double()
    acc = acc + p / (q + 0.5)
    j = j + 1
  }
  acc
}

fn loop_sum_f(xs : Array[Int], ys : Array[Int64]) -> Float {
  let mut acc = 0.0f
  let mut j = 0
  while j < xs.length() {
    let p = xs[j].to_float()
    let q = (ys[j] as Float)
    acc = acc + p * 0.25f - q * 0.125f
    j = j + 1
  }
  acc
}

// Register pressure: 20 converted values stay live across the sums, so
// some of them (and their integer sources) are spilled to stack slots.
fn pressure(v : Array[Int64]) -> String {
  let a0 = v[0]
  let a1 = v[1]
  let a2 = v[2]
  let a3 = v[3]
  let a4 = v[4]
  let a5 = v[5]
  let a6 = v[6]
  let a7 = v[7]
  let a8 = v[8]
  let a9 = v[9]
  let d0 = a0.to_double()
  let d1 = a1.to_double()
  let d2 = a2.to_double()
  let d3 = a3.to_double()
  let d4 = a4.to_double()
  let d5 = a5.to_double()
  let d6 = a6.to_double()
  let d7 = a7.to_double()
  let d8 = a8.to_double()
  let d9 = a9.to_double()
  let f0 = (a0 as Float)
  let f1 = (a1 as Float)
  let f2 = (a2 as Float)
  let f3 = (a3 as Float)
  let f4 = (a4 as Float)
  let f5 = (a5 as Float)
  let f6 = (a6 as Float)
  let f7 = (a7 as Float)
  let f8 = (a8 as Float)
  let f9 = (a9 as Float)
  let s = d0 * 0.5 + d1 * 0.25 + d2 * 0.125 + d3 + d4 + d5 + d6 + d7 + d8 + d9
  let t = f0 * 0.5f + f1 * 0.25f + f2 * 0.125f + f3 + f4 + f5 + f6 + f7 + f8 + f9
  let mut out = dbits(s) + " " + fbits(t)
  out = out + " | " + dbits(d0) + " " + dbits(d1) + " " + dbits(d2) + " " + dbits(d3) + " " + dbits(d4)
  out = out + " " + dbits(d5) + " " + dbits(d6) + " " + dbits(d7) + " " + dbits(d8) + " " + dbits(d9)
  out = out + " | " + fbits(f0) + " " + fbits(f1) + " " + fbits(f2) + " " + fbits(f3) + " " + fbits(f4)
  out = out + " " + fbits(f5) + " " + fbits(f6) + " " + fbits(f7) + " " + fbits(f8) + " " + fbits(f9)
  // The integer sources are still live here, after every conversion.
  out + " | " + (a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9).to_string()
}

// ---- register copies, neg, div -----------------------------------------

fn copy_d(a : Double, b : Double) -> String {
  let mut x = a
  let mut y = b
  let t = x
  x = y
  y = t
  dbits(x) + " " + dbits(y) + " " + dbits(-x) + " " + dbits(-y)
}

fn div_d(a : Double, b : Double) -> String {
  dres(a / b) + " " + dres(b / a) + " " + dres(a / a)
}

fn neg_div_d(a : Double, b : Double) -> String {
  let n = -a
  let q = b / n
  dres(n) + " " + dres(q) + " " + dres(n / q)
}

fn copy_f(a : Float, b : Float) -> String {
  let mut x = a
  let mut y = b
  let t = x
  x = y
  y = t
  fbits(x) + " " + fbits(y) + " " + fbits(-x) + " " + fbits(-y)
}

fn div_f(a : Float, b : Float) -> String {
  fres(a / b) + " " + fres(b / a) + " " + fres(a / a)
}

// Scalar iteration with loop-carried values (mandelbrot / nbody shape).
fn iterate_d(cr : Double, ci : Double) -> String {
  let mut zr = 0.0
  let mut zi = 0.0
  let mut k = 0
  while k < 40 {
    let tr = zr * zr - zi * zi + cr
    let ti = (zr + zr) * zi + ci
    zr = tr
    zi = ti
    if zr * zr + zi * zi > 4.0 {
      break
    }
    k = k + 1
  }
  k.to_string() + " " + dres(zr) + " " + dres(zi)
}

fn iterate_f(cr : Float, ci : Float) -> String {
  let mut zr = 0.0f
  let mut zi = 0.0f
  let mut k = 0
  while k < 40 {
    let tr = zr * zr - zi * zi + cr
    let ti = (zr + zr) * zi + ci
    zr = tr
    zi = ti
    if zr * zr + zi * zi > 4.0f {
      break
    }
    k = k + 1
  }
  k.to_string() + " " + fres(zr) + " " + fres(zi)
}

fn main(w : World) -> Unit {
  let ws = [int_min32(), 2147483647, -1, 0, 1, 16777217, -16777217, 123456789]
  let ls = [
    int_min64(), 9223372036854775807L, -1L, 0L, 1L, 4294967297L, -4294967297L,
    9007199254740993L, -9007199254740993L, 2147483648L, -2147483649L, 16777217L,
  ]
  for a in ws {
    io_println(w, "iso_w " + a.to_string() + " " + dbits(iso_wd(a)) + " " + fbits(iso_ws(a)))
  }
  for a in ls {
    io_println(w, "iso_l " + a.to_string() + " " + dbits(iso_ld(a)) + " " + fbits(iso_ls(a)))
  }
  let mut j = 0
  while j < ls.length() {
    let a = ws[j % ws.length()]
    let b = ws[(j + 3) % ws.length()]
    let c = ls[j]
    let d = ls[(j + 5) % ls.length()]
    io_println(w, "grouped " + j.to_string() + " " + grouped(a, b, c, d))
    j = j + 1
  }
  let ys : Array[Int64] = [1L, -3L, 4294967297L, -4294967297L, 7L, 2L, -9L, 100L]
  io_println(w, "loop_sum " + dbits(loop_sum(ws, ys)) + " " + fbits(loop_sum_f(ws, ys)))
  io_println(w, "pressure0 " + pressure(ls))
  let rot : Array[Int64] = []
  let mut r = 0
  while r < ls.length() {
    rot.push(ls[(r + 4) % ls.length()])
    r = r + 1
  }
  io_println(w, "pressure1 " + pressure(rot))

  let ds = [
    0.0, Double::from_bits(-9223372036854775807L - 1L), Double::from_bits(1L),
    Double::from_bits(4503599627370495L), 1.0, -2.5, 3.0, 1.0e308,
    Double::from_bits(9218868437227405312L), Double::from_bits(-4503599627370496L),
    Double::from_bits(9221120237041090851L),
  ]
  let mut i = 0
  while i < ds.length() {
    let a = ds[i]
    let b = ds[(i + 1) % ds.length()]
    io_println(w, "d " + i.to_string() + " copy " + copy_d(a, b) + " div " + div_d(a, b) + " negdiv " + neg_div_d(a, b))
    i = i + 1
  }
  let fs = [
    0.0f, Float::from_bits(-2147483647 - 1), Float::from_bits(1), Float::from_bits(8388607),
    1.0f, -2.5f, 3.0f, 3.0e38f, Float::from_bits(2139095040), Float::from_bits(-8388608),
    Float::from_bits(2143289635),
  ]
  i = 0
  while i < fs.length() {
    let a = fs[i]
    let b = fs[(i + 1) % fs.length()]
    io_println(w, "f " + i.to_string() + " copy " + copy_f(a, b) + " div " + div_f(a, b))
    i = i + 1
  }
  io_println(w, "iter_d " + iterate_d(-0.75, 0.1) + " " + iterate_d(0.25, 0.5) + " " + iterate_d(-2.0, 0.0))
  io_println(w, "iter_f " + iterate_f(-0.75f, 0.1f) + " " + iterate_f(0.25f, 0.5f) + " " + iterate_f(-2.0f, 0.0f))
}
