// P133: `for i in a..<b` whose body shadows `i` (`let i = ...` or tuple
// destructuring) must pop the body's scope before incrementing the loop
// counter, and release any owned shadowed binding on every iteration.

fn shadow_same_closure(n : Int) -> Int {
  let fns : Array[() -> Int] = []
  let mut steps = 0
  for i in 0..<n {
    steps = steps + 1
    if steps > n + 2 {
      return -999
    }
    let i = i
    fns.push(fn() -> Int { i * 10 + 1 })
  }
  let mut sum = 0
  let mut k = 0
  while k < fns.length() {
    sum = sum + (fns[k])()
    k = k + 1
  }
  sum
}

fn shadow_expr(n : Int) -> Int {
  let mut sum = 0
  let mut steps = 0
  for i in 0..<n {
    steps = steps + 1
    if steps > n + 2 {
      return -999
    }
    let i = i * 10 + 1
    sum = sum + i
  }
  sum
}

fn shadow_owned_string(n : Int) -> String {
  let sb = StringBuilder()
  let mut steps = 0
  for i in 0..<n {
    steps = steps + 1
    if steps > n + 2 {
      return "OVERFLOW"
    }
    let i = "s" + i.to_string()
    if sb.length() > 0 {
      sb.write_string(",")
    }
    sb.write_string(i)
  }
  sb.to_string()
}

fn shadow_tuple(n : Int) -> Int {
  let mut sum = 0
  let mut steps = 0
  for i in 0..<n {
    steps = steps + 1
    if steps > n + 2 {
      return -999
    }
    let (i, j) = (i + 10, i * 2)
    sum = sum + i + j
  }
  sum
}

fn shadow_int64(n : Int64) -> Int64 {
  let mut sum = 0L
  let mut steps = 0L
  for i in 0L..<n {
    steps = steps + 1L
    if steps > n + 2L {
      return -999L
    }
    let i = i * 100L + 1L
    sum = sum + i
  }
  sum
}

fn shadow_inclusive(n : Int) -> Int {
  let mut sum = 0
  let mut steps = 0
  for i in 0..=n {
    steps = steps + 1
    if steps > n + 3 {
      return -999
    }
    let i = i + 100
    sum = sum + i
  }
  sum
}

fn shadow_owned_continue(n : Int) -> String {
  let sb = StringBuilder()
  let mut steps = 0
  for i in 0..<n {
    steps = steps + 1
    if steps > n + 2 {
      return "OVERFLOW"
    }
    let i = "k" + i.to_string()
    if i == "k2" {
      continue
    }
    if sb.length() > 0 {
      sb.write_string(",")
    }
    sb.write_string(i)
  }
  sb.to_string()
}

fn shadow_nested() -> Int {
  let mut sum = 0
  let mut outer_steps = 0
  for i in 0..<3 {
    outer_steps = outer_steps + 1
    if outer_steps > 5 {
      return -999
    }
    let i = i + 10
    let mut inner_steps = 0
    for i in 0..<2 {
      inner_steps = inner_steps + 1
      if inner_steps > 4 {
        return -998
      }
      let i = i + 20
      sum = sum + i
    }
    sum = sum + i
  }
  sum
}

pub fn main(world : World) -> Int {
  io_println(world, "closure=" + shadow_same_closure(8).to_string())
  io_println(world, "expr=" + shadow_expr(5).to_string())
  io_println(world, "string=" + shadow_owned_string(4))
  io_println(world, "tuple=" + shadow_tuple(4).to_string())
  io_println(world, "i64=" + shadow_int64(4L).to_string())
  io_println(world, "incl=" + shadow_inclusive(3).to_string())
  io_println(world, "cont=" + shadow_owned_continue(5))
  io_println(world, "nested=" + shadow_nested().to_string())
  0
}
