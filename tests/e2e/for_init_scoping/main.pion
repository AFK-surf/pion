struct Cursor {
  mut pos : Int
}

fn test_nested_for() -> Int {
  let mut sum = 0
  let mut outer_iters = 0
  let mut inner_iters = 0
  for ai = 0; ai < 3; ai = ai + 1 {
    outer_iters = outer_iters + 1
    for ai = 0; ai < 2; ai = ai + 1 {
      inner_iters = inner_iters + 1
      sum = sum + ai
    }
    sum = sum + ai * 10
  }
  // outer: ai = 0,1,2 -> 3 iters, ai*10 sum = 0+10+20 = 30
  // inner: 3 * 2 = 6 iters, ai sum = 3 * (0+1) = 3
  // sum = 33, outer_iters = 3, inner_iters = 6
  if outer_iters == 3 && inner_iters == 6 && sum == 33 { 1 } else { 0 }
}

fn test_nested_break_continue() -> Int {
  let mut acc = 0
  for ai = 0; ai < 4; ai = ai + 1 {
    if ai == 1 {
      continue
    }
    for ai = 0; ai < 5; ai = ai + 1 {
      if ai == 1 {
        continue
      }
      if ai == 3 {
        break
      }
      acc = acc + ai
    }
    acc = acc + ai * 100
  }
  // outer runs for ai = 0, 2, 3 -> ai*100 sum = 500
  // inner adds 0 + 2 = 2 each time -> 3 * 2 = 6
  if acc == 506 { 1 } else { 0 }
}

fn test_self_init_shadow() -> Int {
  let x = 10
  let mut s1 = 0
  for x = x + 1; x < 14; x = x + 1 {
    s1 = s1 + x
  }
  // s1 = 11 + 12 + 13 = 36, outer x remains 10
  let mut y = 20
  let mut s2 = 0
  for y = y + 1; y < 23; y = y + 1 {
    s2 = s2 + y
  }
  // s2 = 21 + 22 = 43, outer y remains 20
  if x == 10 && s1 == 36 && y == 20 && s2 == 43 { 1 } else { 0 }
}

fn test_closure_capture() -> Int {
  let outer_fns : Array[() -> Int] = []
  let inner_fns : Array[() -> Int] = []
  for ai = 0; ai < 3; ai = ai + 1 {
    outer_fns.push(fn() -> Int { ai })
    for ai = 10; ai < 12; ai = ai + 1 {
      inner_fns.push(fn() -> Int { ai })
    }
  }
  // Each loop variable is a single mutable slot per loop invocation;
  // after loops complete, outer ai == 3 and each inner invocation ends at 12.
  let o0 = outer_fns[0]()
  let o2 = outer_fns[2]()
  let i0 = inner_fns[0]()
  let i5 = inner_fns[5]()
  // Also verify capturing an outer immutable `ai` while inner `for ai = ...` mutates its own slot.
  let ai = 77
  let get_outer = fn() -> Int { ai }
  let mut inner_sum = 0
  for ai = 1; ai <= 3; ai = ai + 1 {
    let get_inner = fn() -> Int { ai }
    inner_sum = inner_sum + get_inner()
  }
  if o0 == 3 && o2 == 3 && i0 == 12 && i5 == 12 && get_outer() == 77 && inner_sum == 6 {
    1
  } else {
    0
  }
}

fn test_unique_array_shadow() -> Int {
  let a = [10, 20, 30]
  let mut inner_total = 0
  for a = [1, 2]; a.length() < 4; a.push(5) {
    inner_total = inner_total + a.length()
  }
  // inner lengths visited: 2, 3 -> inner_total = 5
  // outer a must remain [10, 20, 30] with clean RC/ASan/LSan.
  if inner_total == 5 && a.length() == 3 && a[0] == 10 && a[1] == 20 && a[2] == 30 {
    1
  } else {
    0
  }
}

fn test_non_ident_init() -> Int {
  let c = Cursor::{ pos: 99 }
  let mut s = 0
  for c.pos = 0; c.pos < 3; c.pos = c.pos + 1 {
    s = s + c.pos
  }
  let mut m = 99
  for (m) = 0; m < 4; m = m + 1 {
    s = s + m
  }
  // c.pos ends at 3, m ends at 4, s = (0+1+2) + (0+1+2+3) = 9
  if c.pos == 3 && m == 4 && s == 9 { 1 } else { 0 }
}

fn test_closure_for_no_leak() -> Int {
  let x = 42
  let mut m = 42
  let f_imm = fn() -> Int {
    for x = 0; x < 3; x = x + 1 {
      let _ = x
    }
    x
  }
  let f_mut = fn() -> Int {
    for m = 0; m < 3; m = m + 1 {
      let _ = m
    }
    m
  }
  let f_self = fn() -> Int {
    let mut acc = 0
    for x = x + 1; x < 45; x = x + 1 {
      acc = acc + x
    }
    // acc = 43 + 44 = 87, outer x still 42
    acc * 100 + x
  }
  let r_imm = f_imm()
  let r_mut = f_mut()
  let r_self = f_self()
  m = m + 1
  let r_mut_after = f_mut()
  if r_imm == 42 && r_mut == 42 && r_mut_after == 43 && r_self == 8742 && x == 42 && m == 43 {
    1
  } else {
    0
  }
}

pub fn main(world : World) -> Int {
  let r1 = test_nested_for()
  let r2 = test_nested_break_continue()
  let r3 = test_self_init_shadow()
  let r4 = test_closure_capture()
  let r5 = test_unique_array_shadow()
  let r6 = test_non_ident_init()
  let r7 = test_closure_for_no_leak()
  let out = "\{r1}\{r2}\{r3}\{r4}\{r5}\{r6}\{r7}"
  io_println(world, out)
  if out == "1111111" { 0 } else { 1 }
}
