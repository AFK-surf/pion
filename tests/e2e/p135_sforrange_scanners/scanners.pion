// P135: the QBE statement scanners behind TCO / TRMA and the single-push loop
// guard must see every `Stmt` (incl. `for i in a..<b`, `for x in arr`, C-style
// `for`, `guard`, tuple `let` and `debug_assert`), so no hidden heap write,
// early exit, shadowing or extra `push` is mistaken for a clean body.

struct Cfg {
  k : Int
}

struct Lbl {
  name : String
}

// TCO with a borrowed RC parameter while a `for i in a..<b` body writes the heap.
fn tco_range_heap(c : Cfg, n : Int, acc : Int) -> Int {
  if n <= 0 {
    return acc + c.k
  }
  let buf = [0, 0]
  for i in 0..<2 {
    buf[i] = n + i
  }
  tco_range_heap(c, n - 1, acc + buf[1])
}

// TRMA (`n + f(n - 1)`) with a `guard` early return inside `for i in a..<b`:
// that return must not skip the accumulator.
fn trma_range_guard(n : Int) -> Int64 {
  if n <= 0 {
    return 0L
  }
  for i in 0..<2 {
    guard n + i != 8 else {
      return 100L
    }
  }
  n.to_int64() + trma_range_guard(n - 1)
}

// TRMA with a `guard` inside `for x in arr` and a C-style `for`.
fn trma_forin_guard(n : Int) -> Int64 {
  if n <= 0 {
    return 0L
  }
  let marks = [3, 5]
  for m in marks {
    guard n != m else {
      return 1000L
    }
  }
  for j = 0; j < 1; j = j + 1 {
    guard n + j != 9 else {
      return 10000L
    }
  }
  n.to_int64() + trma_forin_guard(n - 1)
}

// The loop variable shadows the recursive function's own name.
fn shadow_fn_name(n : Int, acc : Int) -> Int {
  if n <= 0 {
    return acc
  }
  let mut s = 0
  for shadow_fn_name in 0..<3 {
    s = s + shadow_fn_name
  }
  shadow_fn_name(n - 1, acc + s)
}

// The `for x in arr` element shadows the borrowed RC parameter; the inner tail
// call passes an element of a local array that dies on return.
fn shadow_rc_forin(l : Lbl, n : Int) -> Int {
  if n <= 0 {
    return l.name.length()
  }
  let pool = [Lbl::{ name: "ab" + n.to_string() }, Lbl::{ name: "xyz" }]
  for l in pool {
    if l.name.length() == 3 {
      return shadow_rc_forin(l, n - 1)
    }
  }
  shadow_rc_forin(l, n - 1)
}

// Same with a C-style `for` whose init shadows the RC parameter.
fn shadow_rc_cfor(l : Lbl, n : Int) -> Int {
  if n <= 0 {
    return l.name.length()
  }
  for let mut l = Lbl::{ name: "q" }; l.name.length() < 2; l = Lbl::{ name: "zz" } {
    return shadow_rc_cfor(l, n - 1)
  }
  shadow_rc_cfor(l, n - 1)
}

// One top-level `push` plus one inside a tuple `let`: two pushes per iteration.
fn push_tuple(n : Int) -> Int {
  let a : Array[Int] = Array::with_capacity(n)
  let mut s = 0
  let mut i = 0
  while i < n {
    a.push(i)
    let (_, k) = (a.push(i + 1000), i)
    s = s + k
    i = i + 1
  }
  let mut t = 0
  let mut j = 0
  while j < a.length() {
    t = t + a[j]
    j = j + 1
  }
  a.length() * 1000000 + t + s
}

// One top-level `push` plus pushes inside nested `for` loops.
fn push_nested(n : Int) -> Int {
  let a : Array[Int] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    a.push(i)
    for r in 0..<2 {
      a.push(r)
    }
    for x in [7] {
      a.push(x)
    }
    i = i + 1
  }
  let mut t = 0
  for v in a {
    t = t + v
  }
  a.length() * 1000000 + t
}

pub fn main(world : World) -> Int {
  io_println(world, "tco_range_heap=" + tco_range_heap(Cfg::{ k: 5 }, 10, 0).to_string())
  io_println(world, "trma_range_guard=" + trma_range_guard(12).to_string())
  io_println(world, "trma_forin_guard=" + trma_forin_guard(12).to_string())
  io_println(world, "shadow_fn_name=" + shadow_fn_name(4, 0).to_string())
  io_println(world, "shadow_rc_forin=" + shadow_rc_forin(Lbl::{ name: "q" }, 3).to_string())
  io_println(world, "shadow_rc_cfor=" + shadow_rc_cfor(Lbl::{ name: "longer" }, 3).to_string())
  io_println(world, "push_tuple=" + push_tuple(64).to_string())
  io_println(world, "push_nested=" + push_nested(64).to_string())
  0
}
