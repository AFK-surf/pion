// Inner loops avoid array accesses (no bounds-check trap blocks) so the depth-2 loops are
// outlining candidates; `acc` is read after the outer loop (classic live-out), while `pos`
// is read+written only inside the inner loop(s) (the regressed live-out).

// (a) probe6: while -> if -> while.
fn probe_if(xs : Array[Int]) -> Int {
  let n = xs.length()
  let mut pos = 0
  let mut acc = 0
  let mut o = 0
  while o < n {
    let p = xs[o]
    if p > 0 {
      let mut i = 0
      while i < p {
        pos = (pos * 31 + i + 7) % 1000003
        acc = (acc * 3 + pos) % 1000000007
        i = i + 1
      }
    }
    o = o + 1
  }
  acc
}

// (b) while -> if/else -> while in both branches, sharing one outer `let mut pos`.
fn probe_if_else(xs : Array[Int]) -> Int {
  let n = xs.length()
  let mut pos = 1
  let mut acc = 0
  let mut o = 0
  while o < n {
    let p = xs[o]
    if p % 2 == 0 {
      let mut i = 0
      while i < p {
        pos = (pos * 17 + i + 3) % 999983
        acc = (acc * 5 + pos) % 1000000007
        i = i + 1
      }
    } else {
      let mut j = 0
      while j < p {
        pos = (pos * 13 + j * 5 + 1) % 999979
        acc = (acc * 7 + pos) % 1000000009
        j = j + 1
      }
    }
    o = o + 1
  }
  acc
}

// (c) while -> match -> while.
fn probe_match(xs : Array[Int]) -> Int {
  let n = xs.length()
  let mut pos = 5
  let mut acc = 0
  let mut o = 0
  while o < n {
    let p = xs[o]
    match p % 3 {
      0 => {
        let mut i = 0
        while i < p {
          pos = (pos * 7 + i + 11) % 1000033
          acc = (acc * 3 + pos) % 1000000007
          i = i + 1
        }
      }
      1 => { acc = acc + 1 }
      _ => {
        let mut k = 0
        while k < p {
          pos = (pos * 3 + k + 2) % 1000037
          acc = (acc * 11 + pos * 2) % 1000000007
          k = k + 1
        }
      }
    }
    o = o + 1
  }
  acc
}

// (d) nine inner-loop-only read+write slots (> 8 live-outs with `acc`): outlining must back off.
fn probe_wide(xs : Array[Int]) -> Int {
  let n = xs.length()
  let mut a0 = 1
  let mut a1 = 2
  let mut a2 = 3
  let mut a3 = 4
  let mut a4 = 5
  let mut a5 = 6
  let mut a6 = 7
  let mut a7 = 8
  let mut a8 = 9
  let mut acc = 0
  let mut o = 0
  while o < n {
    let p = xs[o]
    if p > 0 {
      let mut i = 0
      while i < p {
        a0 = (a0 * 3 + i) % 10007
        a1 = (a1 * 5 + a0) % 10009
        a2 = (a2 * 7 + a1) % 10037
        a3 = (a3 * 11 + a2) % 10039
        a4 = (a4 * 13 + a3) % 10061
        a5 = (a5 * 17 + a4) % 10067
        a6 = (a6 * 19 + a5) % 10069
        a7 = (a7 * 23 + a6) % 10079
        a8 = (a8 * 29 + a7) % 10091
        acc = (acc * 3 + a8) % 1000000007
        i = i + 1
      }
    }
    o = o + 1
  }
  acc
}

pub fn main(w : World) -> Int {
  let xs = [3, 0, 5, 2, 0, 7, 4, 1, 6, 9, 0, 8]
  io_println(w, "if=" + probe_if(xs).to_string())
  io_println(w, "if_else=" + probe_if_else(xs).to_string())
  io_println(w, "match=" + probe_match(xs).to_string())
  io_println(w, "wide=" + probe_wide(xs).to_string())
  0
}
