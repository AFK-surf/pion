extern "C" fn c_snprintf_iid(buf : Ptr, cap : Int64, fmt : Ptr, ..., a : Int, b : Int, c : Double) -> Int = "snprintf"
extern "C" fn c_snprintf_0(buf : Ptr, cap : Int64, fmt : Ptr, ...) -> Int = "snprintf"
extern "C" fn c_snprintf_bool_byte(buf : Ptr, cap : Int64, fmt : Ptr, ..., flag : Bool, ch : Byte) -> Int = "snprintf"

pub fn main(world : World) -> Int {
  let buf = ptr_alloc(128L)
  let fmt1 = "a=%d b=%d c=%.2f"
  let n1 = c_snprintf_iid(buf, 128L, fmt1.as_cstr(), 42, -7, 3.25)
  let s1 = cstr_to_str(buf)
  if n1 != 16 || s1 != "a=42 b=-7 c=3.25" {
    io_println(world, "FAIL1: n=" + n1.to_string() + " s=" + s1)
    ptr_free(buf)
    return 1
  }

  let fmt0 = "plain"
  let n0 = c_snprintf_0(buf, 128L, fmt0.as_cstr())
  let s0 = cstr_to_str(buf)
  if n0 != 5 || s0 != "plain" {
    io_println(world, "FAIL0: n=" + n0.to_string() + " s=" + s0)
    ptr_free(buf)
    return 2
  }

  let fmt2 = "flag=%d ch=%d"
  let n2 = c_snprintf_bool_byte(buf, 128L, fmt2.as_cstr(), true, b'A')
  let s2 = cstr_to_str(buf)
  if n2 != 12 || s2 != "flag=1 ch=65" {
    io_println(world, "FAIL2: n=" + n2.to_string() + " s=" + s2)
    ptr_free(buf)
    return 3
  }

  ptr_free(buf)
  io_println(world, s1)
  0
}
