# P117 fixture: single-block counted loops for vendor/qbe/main.c
# `expandloops`. Every function takes (dst, src) word pointers that the driver
# may alias; oracle.c holds an independent C version of each.
# Scalar loops: *dst = (*src + i) * 3 each trip; returns (last ^ i) + next,
# so both the phi's and the increment's final values are live out.

export function w $up4(l %dst, l %src) {
@start
	jmp @body
@body
	%i =w phi @start 0, @body %next
	%a =w loadw %src
	%v =w add %a, %i
	%m =w mul %v, 3
	storew %m, %dst
	%next =w add %i, 1
	%c =w csltw %next, 4
	jnz %c, @body, @done
@done
	%r =w xor %m, %i
	%r2 =w add %r, %next
	ret %r2
}

