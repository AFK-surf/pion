# Budget shared by both rounds: five 8-trip loops of 6 instructions (48
# expanded each). The first four spend the function's 192; the fifth must
# stay a loop (a per-round budget expanded it in the second round: 240).
export function w $overbudget(l %dst, l %src) {
@start
	jmp @b0
@b0
	%i0 =w phi @start 0, @b0 %n0
	%a0 =w loadw %src
	%v0 =w add %a0, %i0
	%m0 =w mul %v0, 3
	storew %m0, %dst
	%n0 =w add %i0, 1
	%c0 =w csltw %n0, 8
	jnz %c0, @b0, @a0
@a0
	%s0 =w add %m0, %n0
	jmp @b1
@b1
	%i1 =w phi @a0 0, @b1 %n1
	%a1 =w loadw %src
	%v1 =w add %a1, %i1
	%m1 =w mul %v1, 4
	storew %m1, %dst
	%n1 =w add %i1, 1
	%c1 =w csltw %n1, 8
	jnz %c1, @b1, @a1
@a1
	%t1 =w add %s0, %m1
	%s1 =w add %t1, %n1
	jmp @b2
@b2
	%i2 =w phi @a1 0, @b2 %n2
	%a2 =w loadw %src
	%v2 =w add %a2, %i2
	%m2 =w mul %v2, 5
	storew %m2, %dst
	%n2 =w add %i2, 1
	%c2 =w csltw %n2, 8
	jnz %c2, @b2, @a2
@a2
	%t2 =w add %s1, %m2
	%s2 =w add %t2, %n2
	jmp @b3
@b3
	%i3 =w phi @a2 0, @b3 %n3
	%a3 =w loadw %src
	%v3 =w add %a3, %i3
	%m3 =w mul %v3, 6
	storew %m3, %dst
	%n3 =w add %i3, 1
	%c3 =w csltw %n3, 8
	jnz %c3, @b3, @a3
@a3
	%t3 =w add %s2, %m3
	%s3 =w add %t3, %n3
	jmp @b4
@b4
	%i4 =w phi @a3 0, @b4 %n4
	%a4 =w loadw %src
	%v4 =w add %a4, %i4
	%m4 =w mul %v4, 7
	storew %m4, %dst
	%n4 =w add %i4, 1
	%c4 =w csltw %n4, 8
	jnz %c4, @b4, @a4
@a4
	%t4 =w add %s3, %m4
	%s4 =w add %t4, %n4
	ret %s4
}
