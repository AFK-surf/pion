# dst[i+1] = dst[i] * 3 + src[i] for i = 0..5; src may alias dst (same base or
# shifted by one word either way), so every load must stay after the store of
# the previous copy.
export function w $alias6(l %dst, l %src) {
@start
	jmp @body
@body
	%i =w phi @start 0, @body %next
	%o =l extsw %i
	%o4 =l shl %o, 2
	%pa =l add %dst, %o4
	%pb =l add %src, %o4
	%x =w loadw %pa
	%y =w loadw %pb
	%z =w mul %x, 3
	%s =w add %z, %y
	%q =l add %pa, 4
	storew %s, %q
	%next =w add %i, 1
	%c =w csltw %next, 6
	jnz %c, @body, @done
@done
	%r =w add %s, %next
	ret %r
}

# Three loops in one function: 4 trips, 5 trips (using the first loop's
# live-outs), then 9 trips (kept). The rename map is allocated before the
# first expansion creates temporaries; the second must stay inside it.
export function w $multi(l %dst, l %src) {
@start
	jmp @l1
@l1
	%i =w phi @start 1, @l1 %ni
	%a =w loadw %src
	%v =w add %a, %i
	storew %v, %src
	%ni =w add %i, 2
	%c1 =w csltw %ni, 9
	jnz %c1, @l1, @mid
@mid
	%base =w add %i, %ni
	jmp @l2
@l2
	%j =w phi @mid 10, @l2 %nj
	%b =w loadw %dst
	%w =w add %b, %j
	%w2 =w add %w, %v
	storew %w2, %dst
	%nj =w sub %j, 3
	%c2 =w csgtw %nj, -5
	jnz %c2, @l2, @mid2
@mid2
	%p4 =l add %dst, 4
	jmp @l3
@l3
	%k =w phi @mid2 0, @l3 %nk
	%d =w loadw %p4
	%e =w add %d, %k
	%f =w add %e, %w2
	storew %f, %p4
	%nk =w add %k, 1
	%c3 =w csltw %nk, 9
	jnz %c3, @l3, @end
@end
	%r =w add %w2, %base
	%r2 =w add %r, %j
	%r3 =w add %r2, %f
	%r4 =w add %r3, %nk
	ret %r4
}

# Nested: the inner 3-trip loop is expanded first; the outer 2-trip loop
# then becomes a single block for the second round.
export function w $nested(l %dst, l %src) {
@start
	jmp @outer
@outer
	%o =w phi @start 0, @latch %no
	jmp @inner
@inner
	%k =w phi @outer 0, @inner %nk
	%a =w loadw %dst
	%t =w add %k, %o
	%u =w loadw %src
	%t2 =w add %t, %u
	%v =w add %a, %t2
	storew %v, %dst
	%nk =w add %k, 1
	%c =w csltw %nk, 3
	jnz %c, @inner, @latch
@latch
	%no =w add %o, 1
	%c2 =w csltw %no, 2
	jnz %c2, @outer, @done
@done
	%r =w add %v, %no
	ret %r
}

