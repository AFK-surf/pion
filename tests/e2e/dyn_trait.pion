pub trait Describe {
  describe(self : Self) -> String
  score(self : Self, bonus : Int) -> Int
}

pub struct Dog {
  name : String
}

pub struct Rect {
  w : Int
  h : Int
}

impl Describe for Dog {
  fn describe(self : Dog) -> String {
    "dog:" + self.name
  }
  fn score(self : Dog, bonus : Int) -> Int {
    self.name.length() + bonus
  }
}

impl Describe for Rect {
  fn describe(self : Rect) -> String {
    "rect:" + self.w.to_string() + "x" + self.h.to_string()
  }
  fn score(self : Rect, bonus : Int) -> Int {
    self.w * self.h + bonus
  }
}

impl Describe for Int {
  fn describe(self : Int) -> String {
    "int:" + self.to_string()
  }
  fn score(self : Int, bonus : Int) -> Int {
    self + bonus
  }
}

pub struct Holder {
  tag : String
  item : dyn Describe
}

fn render(x : dyn Describe) -> String {
  x.describe() + "=" + x.score(10).to_string()
}

fn make_item(kind : Int) -> dyn Describe {
  if kind == 0 {
    return Dog::{ name: "luna" }
  }
  if kind == 1 {
    return Rect::{ w: 3, h: 4 }
  }
  42
}

pub fn main(world : World) -> Int {
  // 1. Direct implicit & explicit boxing + fn arg dispatch
  let d : dyn Describe = Dog::{ name: "rex" }
  let n = 7 as dyn Describe
  if render(d) != "dog:rex=13" {
    io_println(world, "FAIL direct dog: " + render(d))
    return 1
  }
  if render(n) != "int:7=17" {
    io_println(world, "FAIL direct int: " + render(n))
    return 2
  }
  if render(Rect::{ w: 2, h: 5 }) != "rect:2x5=20" {
    io_println(world, "FAIL arg rect")
    return 3
  }

  // 2. Heterogeneous Array[dyn Describe] literal + .push(concrete) + .push(dyn)
  let items : Array[dyn Describe] = [
    Dog::{ name: "fido" },
    Rect::{ w: 4, h: 5 },
    100,
  ]
  items.push(Dog::{ name: "bo" })
  items.push(make_item(0))
  items.push(make_item(1))
  items.push(make_item(2))

  let sb = StringBuilder()
  let mut total_score = 0
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_string("|")
    }
    let it = items[i]
    sb.write_string(it.describe())
    total_score = total_score + it.score(1)
    i = i + 1
  }
  let joined = sb.to_string()
  if joined != "dog:fido|rect:4x5|int:100|dog:bo|dog:luna|rect:3x4|int:42" {
    io_println(world, "FAIL joined: " + joined)
    return 4
  }
  // scores with bonus=1: (4+1)+(20+1)+(100+1)+(2+1)+(4+1)+(12+1)+(42+1) = 5+21+101+3+5+13+43 = 191
  if total_score != 191 {
    io_println(world, "FAIL total_score: " + total_score.to_string())
    return 5
  }

  // 3. Niche Option[dyn Describe] (zero secondary boxing)
  let some_d : Option[dyn Describe] = Some(Dog::{ name: "max" })
  let none_d : Option[dyn Describe] = None
  let s1 = match some_d {
    Some(v) => v.describe()
    None => "none"
  }
  let s2 = match none_d {
    Some(v) => v.describe()
    None => "none"
  }
  if s1 != "dog:max" || s2 != "none" {
    io_println(world, "FAIL option: " + s1 + "," + s2)
    return 6
  }

  // 4. Struct field holding dyn Describe
  let h1 = Holder::{ tag: "pet", item: Dog::{ name: "pip" } }
  let h2 = Holder::{ tag: "num", item: 9 }
  if h1.tag + ":" + h1.item.describe() != "pet:dog:pip" {
    io_println(world, "FAIL holder1")
    return 7
  }
  if h2.tag + ":" + h2.item.describe() != "num:int:9" {
    io_println(world, "FAIL holder2")
    return 8
  }

  // 5. Reassigning mutable dyn Describe local (verifies RC drop of previous box)
  let mut cur : dyn Describe = Dog::{ name: "first" }
  if cur.describe() != "dog:first" {
    return 9
  }
  cur = 55
  if cur.describe() != "int:55" {
    return 10
  }
  cur = Dog::{ name: "last" }
  if cur.describe() != "dog:last" {
    return 11
  }

  io_println(world, "dyn_trait ok")
  0
}
