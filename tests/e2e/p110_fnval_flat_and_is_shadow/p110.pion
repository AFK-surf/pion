// P110: generic fns / static methods used as first-class values are
// instantiated like direct calls, and `if` / `guard` `is` bindings shadow
// outer locals of another type in the codegen type probe.
// 1. A generic fn value whose instance needs monomorphization (flat
//    `Array[Pair[X, String]]`, `==`, `Option`) calls the `__mono_*` instance;
//    a polymorphic one passes its `%tp_*` object flags (captured in the closure
//    env when still live in the enclosing generic): passed to a polymorphic
//    higher-order fn, bound to a concretely typed local, through nested
//    generics and as a static method value; thunks convert `Float` / `UInt`
//    / `Double` to the target's ABI and never collide with user fn symbols;
//    a later argument that is itself a generic call (named arguments, a
//    generic method, a block) still fixes `T`, also through `{ second }` or
//    `if c { second } else { second }`, inside `[second]` / `Some(second)`,
//    relayed by generic calls (`pass(second)`), as a default argument, twice
//    in one tuple (`(score, score)` with different instances), in struct
//    fields and enum payloads.
// 2. `if box is Some(x) { x } else { .. }` / `guard box is Some(x)` with an
//    outer `x : Int`: the branch has the pattern's type (`.to_string()`,
//    concat parts, `let`), never the shadowed local's, also when the shadowed
//    name is called (`f()`) and the scrutinee is a generic call.

struct Pair[A, B] {
  first : A
  second : B
}

fn second_of[X](xs : Array[Pair[X, String]]) -> String {
  xs[1].second
}

fn apply[F](f : (Array[Pair[F, String]]) -> String, xs : Array[Pair[F, String]]) -> String {
  f(xs)
}

// `f` comes after the argument that fixes `F`.
fn apply_last[F](xs : Array[Pair[F, String]], f : (Array[Pair[F, String]]) -> String) -> String {
  f(xs)
}

fn wrap[T](ps : Array[Pair[T, String]]) -> String {
  apply(second_of, ps)
}

fn wrap_twice[T](ps : Array[Pair[T, String]]) -> String {
  wrap(ps) + "+" + apply_last(ps, second_of)
}

struct Pairs {
  n : Int
}

fn Pairs::second_of[X](xs : Array[Pair[X, String]]) -> String {
  "m:" + xs[0].second
}

// Polymorphic (no monomorphization): the `%tp_X` flag decides whether the
// loaded element is retained.
fn first_of[X](xs : Array[X]) -> X {
  xs[0]
}

fn use_first[T](xs : Array[T], f : (Array[T]) -> T) -> T {
  f(xs)
}

fn poly_first[T](xs : Array[T]) -> T {
  use_first(xs, first_of)
}

// `==` on a type param: monomorphized per instance.
fn count_eq[X](xs : Array[X], v : X) -> Int {
  let mut n = 0
  for x in xs {
    if x == v {
      n = n + 1
    }
  }
  n
}

fn apply_count[T](f : (Array[T], T) -> Int, xs : Array[T], v : T) -> Int {
  f(xs, v)
}

fn fn_values(w : World) -> Unit {
  let ps : Array[Pair[Int, String]] = [Pair::{ first: 1, second: "a" }, Pair::{ first: 2, second: "b" }]
  io_println(w, "apply=" + apply(second_of, ps))
  io_println(w, "apply_last=" + apply_last(ps, second_of))
  let f : (Array[Pair[Int, String]]) -> String = second_of
  io_println(w, "let=" + f(ps) + f(ps))
  io_println(w, "wrap=" + wrap(ps))
  let ss : Array[Pair[String, String]] = [
    Pair::{ first: "x" + ps.length().to_string(), second: "s0" },
    Pair::{ first: "y", second: "s" + ps.length().to_string() },
  ]
  io_println(w, "wrap_twice=" + wrap_twice(ss) + " " + wrap_twice(ps))
  io_println(w, "method=" + apply(Pairs::second_of, ps) + " " + apply(Pairs::second_of, ss))
  let mf : (Array[Pair[String, String]]) -> String = Pairs::second_of
  io_println(w, "method_let=" + mf(ss))
  let strs = ["p" + ps.length().to_string(), "q"]
  let mut i = 0
  let mut acc = ""
  while i < 3 {
    acc = acc + poly_first(strs) + use_first(strs, first_of)
    i = i + 1
  }
  io_println(w, "poly=" + acc + " " + poly_first([7, 8]).to_string() + " " + use_first([9], first_of).to_string())
  io_println(w, "eq=" + apply_count(count_eq, ["a", "b", "a"], "a").to_string() + " " + apply_count(count_eq, [1, 2, 2, 2], 2).to_string())
}

// Wrapper ABI: `Float` (`s`), `UInt` (`w`) and `Double` (`d`) targets, plain
// and monomorphized (`same` compares with `==`).
fn same[T](x : T, y : T) -> T {
  if x == y {
    y
  } else {
    x
  }
}

fn half(x : Float) -> Float {
  x / 2.0.to_float()
}

fn bump(x : UInt) -> UInt {
  x + 1U
}

// The argument fixing `T` is itself a generic call.
fn second[X](xs : Array[X]) -> X {
  xs[1]
}

fn identity[U](v : U) -> U {
  v
}

fn use_second[T](f : (Array[T]) -> T, xs : Array[T]) -> Int {
  if f(xs) == xs[1] {
    1
  } else {
    0
  }
}

fn identity_named[U](v~ : U) -> U {
  v
}

struct H {
  z : Int
}

fn H::identity[U](self : H, v : U) -> U {
  v
}

// Generic fn values inside containers and relayed through generic calls.
fn pass[A, B](f : (A) -> B) -> (A) -> B {
  f
}

fn use_first_fn[T](fs : Array[(Array[T]) -> T], xs : Array[T]) -> Int {
  let f = fs[0]
  if f(xs) == xs[1] {
    1
  } else {
    0
  }
}

fn use_opt_fn[T](fo : Option[(Array[T]) -> T], xs : Array[T]) -> Int {
  match fo {
    Some(f) => if f(xs) == xs[1] { 1 } else { 0 }
    None => 0
  }
}

fn use_default[T](xs : Array[T], f~ : (Array[T]) -> T = second) -> Int {
  if f(xs) == xs[1] {
    1
  } else {
    0
  }
}

// The same generic fn twice in one argument, each its own instance; inside
// struct fields and enum payloads.
pub trait Tag {
  code(self : Self) -> Int
}

impl Tag for Int {
  fn code(self : Int) -> Int {
    1
  }
}

impl Tag for Int64 {
  fn code(self : Int64) -> Int {
    2
  }
}

fn score[T : Tag](v : T) -> Int {
  v.code()
}

fn both[A, B](p : ((A) -> Int, (B) -> Int), a : A, b : B) -> Int {
  let (f, g) = p
  f(a) * 10 + g(b)
}

struct FnBox[A] {
  f : (A) -> Int
}

fn run_box[A](bx : FnBox[A], a : A) -> Int {
  bx.f(a)
}

enum FnCase[A] {
  Call((A) -> Int)
}

fn run_case[A](c : FnCase[A], a : A) -> Int {
  match c {
    Call(f) => f(a)
  }
}

fn keep[T](x : T) -> T {
  x
}

// Arguments are checked in source order: a move after a read of the same
// local, and an empty array whose element type an earlier argument fixes.
fn take_back[A](f : (A) -> A, v : A) -> A {
  f(v)
}

fn named_pass[A, B](v~ : (A) -> B) -> (A) -> B {
  v
}

fn apply_ab[A, B](f : (A) -> B, a : A, b : B) -> B {
  if f(a) == b {
    b
  } else {
    f(a)
  }
}

// A generic method relaying a fn value, and a relaying call whose own
// arguments fixed one type param (`A`) while the outer call fixes the other.
struct Relay {
  n : Int
}

fn Relay::pass[A, B](self : Relay, f : (A) -> B) -> (A) -> B {
  f
}

fn keep_check[A, B](f : (Array[A]) -> A, xs : Array[A], g : (B) -> B, log : Array[Int]) -> (B) -> B {
  log.push(if f(xs) == xs[1] { 1 } else { 0 })
  g
}

fn apply_same[T](f : (T) -> T, x : T) -> T {
  f(x)
}

// An optional parameter relaying a fn value: `v=second` passes `Some(second)`,
// `v?=o` passes the option itself.
fn opt_relay[A, B](v? : (A) -> B) -> Option[(A) -> B] {
  v
}

fn use_opt_second[T](of : Option[(Array[T]) -> T], xs : Array[T]) -> Int {
  match of {
    Some(f) => if f(xs) == xs[1] { 1 } else { 0 }
    None => 2
  }
}

// A positional relay argument after an omitted optional / labelled param.
fn relay_pad[A, B](pad? : Int, f : (A) -> B) -> (A) -> B {
  f
}

fn relay_lbl[A, B](lbl~ : Int = 0, f : (A) -> B) -> (A) -> B {
  f
}

// A thunk of a generic fn never shares a symbol with a user fn's.
fn pick[X](x : X) -> Int {
  7
}

fn pick__tp_0(x : Int) -> Int {
  8
}

fn pick__mono_Int(x : Int) -> Int {
  9
}

fn scalar_values(w : World) -> Unit {
  let ff : (Float, Float) -> Float = same
  let a = 1.5.to_float()
  let b = 2.5.to_float()
  let fh : (Float) -> Float = half
  io_println(w, "float=" + same(a, b).to_string() + "/" + ff(a, b).to_string() + "/" + fh(b).to_string())
  let fu : (UInt, UInt) -> UInt = same
  let fb : (UInt) -> UInt = bump
  io_println(w, "uint=" + fu(4294967295U, 7U).to_string() + "/" + fb(4294967294U).to_string())
  let fd : (Double, Double) -> Double = same
  io_println(w, "double=" + fd(0.25, 0.25).to_string())
  io_println(w, "later=" + use_second(second, identity([11, 22, 33, 44])).to_string() + use_second(second, [5, 6]).to_string())
  let xs = [11, 22, 33, 44]
  io_println(
    w,
    "later2=" +
    use_second(second, identity_named(v=[11, 22, 33, 44])).to_string() +
    use_second(second, H::{ z: 0 }.identity(xs)).to_string() +
    use_second(second, { let a = [11, 22, 33, 44]; a }).to_string() +
    use_second({ second }, xs).to_string() +
    use_second(if xs.length() > 2 { second } else { second }, xs).to_string(),
  )
  let rel : (Array[Int]) -> Int = pass(second)
  io_println(
    w,
    "relay=" +
    use_first_fn([second], xs).to_string() +
    use_first_fn([pass(second)], [11, 22, 33]).to_string() +
    use_opt_fn(Some(second), xs).to_string() +
    use_second(pass(second), xs).to_string() +
    use_second(pass(second), identity([7, 8, 9])).to_string() +
    use_second(pass(pass(second)), ["a", "b" + xs.length().to_string()]).to_string() +
    use_second(rel, identity(xs)).to_string() +
    use_default(xs).to_string() +
    use_default([11L, 22L, 33L]).to_string() +
    use_default(["p", "q" + xs.length().to_string()]).to_string(),
  )
  io_println(
    w,
    "pairs=" +
    both((score, score), 3, 4L).to_string() +
    "," +
    both((pass(score), pass(score)), 3, 4L).to_string() +
    "," +
    both((score, score), 4L, 3).to_string() +
    "," +
    run_box(FnBox::{ f: score }, 4L).to_string() +
    run_box(keep(FnBox::{ f: score }), 3).to_string() +
    run_case(Call(score), 4L).to_string() +
    run_case(keep(Call(score)), 3).to_string(),
  )
  let owned = "own" + xs.length().to_string()
  let back = take_back({ let _ = owned.length(); identity }, move owned)
  let ys = []
  io_println(w, "order=" + back + "/" + use_second({ ys.push(5); ys.push(6); second }, ys).to_string())
  io_println(
    w,
    "local=" +
    apply_ab({ let identity = fn(x : Int) -> Bool { x > 0 }; identity }, 1, true).to_string() +
    "/" +
    use_second(named_pass(v=second), xs).to_string(),
  )
  let klog : Array[Int] = []
  let kept = apply_same(keep_check(second, [11, 22, 33], identity, klog), 5L)
  io_println(
    w,
    "mrelay=" +
    use_second(Relay::{ n: 0 }.pass(second), xs).to_string() +
    "/" +
    klog[0].to_string() +
    ":" +
    kept.to_string(),
  )
  io_println(
    w,
    "optrelay=" +
    use_opt_second(opt_relay(v=second), xs).to_string() +
    use_opt_second(opt_relay(v?=Some(second)), [3, 4]).to_string(),
  )
  io_println(
    w,
    "skip=" +
    use_second(relay_pad(second), xs).to_string() +
    use_second(relay_pad(pad=1, second), xs).to_string() +
    use_second(relay_lbl(second), xs).to_string(),
  )
  let p1 : (Int) -> Int = pick
  let p2 : (Int) -> Int = pick__tp_0
  let p3 : (Int) -> Int = pick__mono_Int
  let p4 : (String) -> Int = pick
  io_println(w, "pick=" + p1(3).to_string() + "/" + p2(3).to_string() + "/" + p3(3).to_string() + "/" + p4("s").to_string())
}

struct MyRec {
  name : String
  n : Int
}

fn MyRec::to_string(self : MyRec) -> String {
  "MyRec(" + self.name + "," + self.n.to_string() + ")"
}

fn fresh(log : Array[Int]) -> MyRec {
  log.push(log.length())
  MyRec::{ name: "fresh" + log.length().to_string(), n: -1 }
}

fn mk(name : String, n : Int) -> Option[MyRec] {
  Some(MyRec::{ name: name + "!", n: n })
}

fn shadow_direct(box : Option[MyRec], log : Array[Int]) -> String {
  let x : Int = 42
  (if box is Some(x) { x } else { fresh(log) }).to_string() + "/" + x.to_string()
}

fn shadow_method(box : Option[MyRec], log : Array[Int]) -> String {
  let x : Int = 42
  let s = (if box is Some(x) { x } else { fresh(log) }).to_string()
  s
}

fn shadow_let(box : Option[MyRec], log : Array[Int]) -> String {
  let x : Int = 43
  let r = if box is Some(x) { x } else { fresh(log) }
  r.to_string() + "/" + x.to_string()
}

fn shadow_chain(box : Option[MyRec], log : Array[Int]) -> String {
  let x : Int = 44
  let y : Int = 45
  "c=" + (if box is Some(x) && x.n > 0 && Some(x.n) is Some(y) { MyRec::{ name: x.name, n: y } } else { fresh(log) }).to_string() + "/" + (x + y).to_string()
}

fn shadow_else_if(a : Option[MyRec], b : Option[MyRec], log : Array[Int]) -> String {
  let x : Int = 46
  "e=" + (if a is Some(x) { x } else if b is Some(x) { x } else { fresh(log) }).to_string() + "/" + x.to_string()
}

fn shadow_guard(box : Option[MyRec], log : Array[Int]) -> String {
  let x : Int = 47
  let r = {
    guard box is Some(x) else { return "g=none/" + fresh(log).to_string() }
    x
  }
  "g=" + r.to_string() + "|" + {
    guard box is Some(x) else { return "unreachable" }
    x
  }.to_string() + "/" + x.to_string()
}

fn ident[T](x : T) -> T {
  x
}

fn int_fn() -> Int {
  88
}

fn real_fn() -> Double {
  6.25
}

// The `is` binding `f` (from a generic call's result) shadows the parameter
// `f : () -> Int` when probing the callee `f()`.
fn render(box : Option[() -> Double], f : () -> Int) -> String {
  (if ident(box) is Some(f) { f() } else { 1.25 }).to_string() + "|" + f().to_string()
}

fn is_shadow(w : World) -> Unit {
  io_println(w, "render=" + render(Some(real_fn), int_fn) + "/" + render(None, int_fn))
  let log : Array[Int] = []
  io_println(w, shadow_direct(mk("d", 1), log))
  io_println(w, shadow_direct(None, log))
  io_println(w, shadow_method(mk("m", 2), log))
  io_println(w, shadow_method(None, log))
  io_println(w, shadow_let(mk("l", 3), log))
  io_println(w, shadow_let(None, log))
  io_println(w, shadow_chain(mk("c", 4), log))
  io_println(w, shadow_chain(mk("c", -4), log))
  io_println(w, shadow_else_if(None, mk("b", 5), log))
  io_println(w, shadow_else_if(mk("a", 6), mk("b", 5), log))
  io_println(w, shadow_else_if(None, None, log))
  io_println(w, shadow_guard(mk("g", 7), log))
  io_println(w, shadow_guard(None, log))
  io_println(w, "log=" + log.length().to_string())
}

fn main(w : World) -> Unit {
  fn_values(w)
  scalar_values(w)
  is_shadow(w)
}
