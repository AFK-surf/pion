struct Holder[A, B] {
  f : (A) -> B
}

enum Wrap[A, B] {
  Get((A) -> B)
}

fn id[X](x : X) -> X {
  x
}

fn keep[T](x : T) -> T {
  x
}

fn run[A, B](h : Holder[A, B], a : A, b : B) -> Int {
  9
}

fn run_w[A, B](h : Wrap[A, B], a : A, b : B) -> Int {
  9
}

fn main(w : World) -> Unit {
  io_println(w, (run(keep(Holder::{ f: id }), 1, true) + run_w(keep(Get(id)), 1, true)).to_string())
}
