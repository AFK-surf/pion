pub struct Pair[A, B] {
  first : A
  second : B
}

pub fn second_of[X](xs : Array[Pair[X, String]]) -> String {
  xs[1].second
}

pub fn apply[F](f : (Array[Pair[F, String]]) -> String, xs : Array[Pair[F, String]]) -> String {
  f(xs)
}

fn hidden_second[X](xs : Array[Pair[X, String]]) -> String {
  "h:" + xs[1].second
}

fn hidden_plain(xs : Array[Pair[Int, String]]) -> String {
  "p:" + xs[0].second
}

// Instantiated in the caller's package: the private generic fn value is
// monomorphized there too.
pub fn run[T](ps : Array[Pair[T, String]]) -> String {
  apply(second_of, ps) + "," + apply(hidden_second, ps)
}

pub fn run_plain(ps : Array[Pair[Int, String]]) -> String {
  apply(hidden_plain, ps)
}

pub struct Tool {
  n : Int
}

pub fn Tool::pick[X](xs : Array[Pair[X, String]]) -> String {
  "t:" + xs[0].second
}

pub fn identity[A](v : A) -> A {
  v
}

pub fn named[A](v~ : A) -> A {
  v
}

pub fn named_pass[A, B](v~ : (A) -> B) -> (A) -> B {
  v
}
