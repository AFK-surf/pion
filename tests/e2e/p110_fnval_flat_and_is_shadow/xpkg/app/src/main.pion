import "dep" as d

fn wrap[T](ps : Array[d::Pair[T, String]]) -> String {
  d::apply(d::second_of, ps)
}

fn second[X](xs : Array[X]) -> X {
  xs[1]
}

fn use_second[T](f : (Array[T]) -> T, xs : Array[T]) -> Int {
  if f(xs) == xs[1] {
    1
  } else {
    0
  }
}

fn main(w : World) -> Unit {
  let ps : Array[d::Pair[Int, String]] = [
    d::Pair::{ first: 1, second: "a" + "1" },
    d::Pair::{ first: 2, second: "b" + "2" },
  ]
  let f : (Array[d::Pair[Int, String]]) -> String = d::second_of
  let g : (Array[d::Pair[Int, String]]) -> String = d::Tool::pick
  io_println(
    w,
    d::apply(d::second_of, ps) + " " + f(ps) + " " + wrap(ps) + " " + d::run(ps) + " " + d::run_plain(ps) + " " + g(ps) + " " + d::apply(d::Tool::pick, ps) + " " + use_second(second, d::identity([11, 22, 33, 44])).to_string() + use_second(second, d::named(v=[11, 22, 33, 44])).to_string() + use_second(d::named_pass(v=second), [7, 8]).to_string(),
  )
}
