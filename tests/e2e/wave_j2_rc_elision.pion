// Wave J2 RC elision E2E + ASan/LSan soundness & multithreading test suite.
// Covers:
// - Layer 1: deep immutable struct field chains, chained borrows, Perceus last-use
//   early-drop pinning, shadowing, loop rebinding, match early return, closure capture,
//   container/struct/return escape, and negative cases (mut root, mut field, EMutArg,
//   mut self, boxed cell) with full string content assertions.
// - Layer 2: multi-level immutable field-chain args & receivers, closure materialization
//   preserving outer mut_local_slots/borrow_owner_*, plus call-window mutation negative
//   cases (block assign / EMutArg / mut self / EIf then_stmts) with full content assertions.
// - Layer 3: safe load whitelist & CFG trap-branch penetration + multithreaded scope/spawn.

struct Leaf {
  name : String
  tag : String
}

struct Mid {
  leaf : Leaf
  items : Array[String]
}

struct MidMut {
  mut leaf : Leaf
}

struct Top {
  mid : Mid
  mid_mut : MidMut
}

fn assert_str_eq(got : String, want : String) -> Int {
  if got != want {
    panic("string mismatch: got=" + got + " want=" + want)
  }
  got.length()
}

fn make_top(tag_idx : Int) -> Top {
  let n = "node-" + tag_idx.to_string() + "-payload"
  let t = "tag-" + tag_idx.to_string() + "-extra"
  let leaf = Leaf::{ name: n, tag: t }
  let items = [n + ":0", t + ":1", "item-" + tag_idx.to_string()]
  let mid = Mid::{ leaf: leaf, items: items }
  let mid_mut = MidMut::{ leaf: Leaf::{ name: "m-" + tag_idx.to_string(), tag: "mt" } }
  Top::{ mid: mid, mid_mut: mid_mut }
}

fn make_top_named(name : String, tag : String) -> Top {
  let leaf = Leaf::{ name: name, tag: tag }
  let items = [name + ":0", tag + ":1", "item-custom"]
  let mid = Mid::{ leaf: leaf, items: items }
  let mid_mut = MidMut::{ leaf: Leaf::{ name: "mut-" + name, tag: "mt" } }
  Top::{ mid: mid, mid_mut: mid_mut }
}

fn Top::replace_self(mut self : Top, other : Top) -> Int {
  self = other
  1
}

fn swap_top(mut r : Top, other : Top) -> Int {
  r = other
  1
}

fn take_two(a : String, b : String) -> Int {
  a.length() + b.length()
}

fn take_with_int_check(a : String, want : String, x : Int) -> Int {
  assert_str_eq(a, want) + x
}

fn test_layer1_perceus_pinning() -> Int {
  let t = make_top(1)
  let m = t.mid
  let l = m.leaf
  let n = l.name
  let tag = t.mid.leaf.tag
  let _noise = make_top(999)
  assert_str_eq(n, "node-1-payload") + assert_str_eq(tag, "tag-1-extra")
}

fn test_layer1_shadowing_and_loop() -> Int {
  let mut total = 0
  let mut i = 0
  while i < 20 {
    let a = make_top(i)
    let b = a.mid
    let a = make_top(i + 100)
    let c = b.leaf.name
    let d = a.mid.leaf.tag
    total = total + c.length() + d.length()
    i = i + 1
  }
  total
}

fn test_layer1_match_early_ret(k : Int) -> String {
  let t = make_top(k)
  let nm = t.mid.leaf.name
  match k {
    0 => return nm
    1 => return t.mid.leaf.tag
    _ => nm + ":" + t.mid.leaf.tag
  }
}

fn test_layer1_escapes() -> Int {
  let t = make_top(7)
  let nm = t.mid.leaf.name
  let arr = [nm]
  let mp : Map[String, String] = Map::new()
  mp.set("k", nm)
  let f = fn() -> Int { assert_str_eq(nm, "node-7-payload") }
  let r1 = assert_str_eq(arr[0], "node-7-payload")
  let r2 = match mp.get("k") {
    Some(v) => assert_str_eq(v, "node-7-payload")
    None => panic("missing map key")
  }
  r1 + r2 + f()
}

fn test_layer1_negatives() -> Int {
  // 1. Mutable root reassigned after let borrow attempt (distinct pre/post strings)
  let mut r = make_top_named("old-root-10-orig", "t10")
  let a = r.mid.leaf.name
  r = make_top_named("REPLACED-11", "t11")
  let s1 = assert_str_eq(a, "old-root-10-orig")

  // 2. EMutArg mutating root
  let mut r2 = make_top_named("old-mutarg-12-orig", "t12")
  let a2 = r2.mid.leaf.name
  let _ = swap_top(mut r2, make_top_named("REPLACED-13", "t13"))
  let s2 = assert_str_eq(a2, "old-mutarg-12-orig")

  // 3. mut self method mutating root
  let mut r3 = make_top_named("old-mutself-14-orig", "t14")
  let a3 = r3.mid.leaf.name
  let _ = r3.replace_self(make_top_named("REPLACED-15", "t15"))
  let s3 = assert_str_eq(a3, "old-mutself-14-orig")

  // 4. mut field in chain mutated
  let r4 = make_top_named("field-16", "t16")
  let a4 = r4.mid_mut.leaf.name
  r4.mid_mut.leaf = Leaf::{ name: "REPLACED-MUTFIELD", tag: "rt" }
  let s4 = assert_str_eq(a4, "mut-field-16")

  // 5. Boxed cell (mut local captured by closure)
  let mut r5 = make_top_named("old-cell-17-orig", "t17")
  let reset_r5 = fn() -> Unit { r5 = make_top_named("REPLACED-CELL-18", "t18") }
  let a5 = r5.mid.leaf.name
  reset_r5()
  let s5 = assert_str_eq(a5, "old-cell-17-orig")

  s1 + s2 + s3 + s4 + s5
}

fn test_layer2_call_window_negatives() -> Int {
  // 1. Arg 2 reassigns owner of arg 0 via block expression
  let mut r1 = make_top_named("arg-block-20-orig", "t20")
  let x1 = take_with_int_check(r1.mid.leaf.name, "arg-block-20-orig", {
    r1 = make_top_named("REPLACED-21", "t21")
    1
  })

  // 2. Arg 2 mutates owner of arg 0 via nested EMutArg call
  let mut r2 = make_top_named("arg-mutarg-22-orig", "t22")
  let x2 = take_with_int_check(
    r2.mid.leaf.name,
    "arg-mutarg-22-orig",
    swap_top(mut r2, make_top_named("REPLACED-23", "t23")),
  )

  // 3. Arg 2 mutates owner of arg 0 via mut self method
  let mut r3 = make_top_named("arg-mutself-24-orig", "t24")
  let x3 = take_with_int_check(
    r3.mid.leaf.name,
    "arg-mutself-24-orig",
    r3.replace_self(make_top_named("REPLACED-25", "t25")),
  )

  // 4. Arg 2 mutates owner of arg 0 via mut self inside EIf then_stmts
  let mut r4 = make_top_named("arg-if-26-orig", "t26")
  let x4 = take_with_int_check(
    r4.mid.leaf.name,
    "arg-if-26-orig",
    if x3 > 0 { r4.replace_self(make_top_named("REPLACED-27", "t27")) } else { 0 },
  )

  // 5. Materialized non-capturing closure stored in container MUST NOT wipe outer mut_local_slots
  let mut r5 = make_top_named("arg-after-closure-28-orig", "t28")
  let fns : Array[() -> Int] = [fn() -> Int { 7 }]
  let fv = fns[0]()
  let a5 = r5.mid.leaf.name
  let x5 = take_with_int_check(r5.mid.leaf.name, "arg-after-closure-28-orig", {
    r5 = make_top_named("REPLACED-AFTER-CLOSURE-29", "t29")
    fv
  })
  let x5b = assert_str_eq(a5, "arg-after-closure-28-orig")

  x1 + x2 + x3 + x4 + x5 + x5b
}

fn test_layer3_trap_and_mt(world : World) -> Int {
  let t = make_top(30)
  let mut acc = 0
  let mut i = 0
  while i < 3 {
    acc = acc + t.mid.items[i].length()
    i = i + 1
  }
  // Multithreaded Send check with frozen immutable struct + string
  let leaf = Leaf::{ name: "shared-leaf", tag: "mt-tag" }
  let ch : Channel[Int] = Channel::new(4)
  scope(world, fn(s) {
    spawn(s, fn() {
      let n = leaf.name
      ch.send(assert_str_eq(n, "shared-leaf") + assert_str_eq(leaf.tag, "mt-tag"))
    })
    spawn(s, fn() {
      ch.send(take_two(leaf.name, leaf.tag))
    })
  })
  acc + ch.recv().unwrap_or(0) + ch.recv().unwrap_or(0)
}

struct MutBuf {
  mut src : String
  mut pos : Int
  mut items : Array[Int]
}

struct MutInner {
  mut text : String
}

fn MutInner::replace_inner(mut self : MutInner, s : String) -> Int {
  self = MutInner::{ text: s }
  1
}

struct MutWrap {
  mut inner : MutInner
}

trait MutBufMutator {
  fn clobber(self : Self, b : MutBuf, s : String) -> Unit
}

struct Clobberer {
  id : Int
}

impl MutBufMutator for Clobberer {
  fn clobber(self : Clobberer, b : MutBuf, s : String) -> Unit {
    b.src = s
  }
}

enum MutAction { Go }

fn MutAction::clobber(b : MutBuf, s : String) -> Int {
  b.src = s
  0
}

fn mut_action_indirect(b : MutBuf, s : String) -> Int {
  MutAction::clobber(b, s)
}

struct MutEqKey {
  id : Int
  b : MutBuf
}

impl Eq for MutEqKey {
  fn equal(self : MutEqKey, other : MutEqKey) -> Bool {
    self.b.src = make_dyn_str("ZZZ", 120 + self.id)
    self.id == other.id
  }
}

struct MutSelfEqHub {
  mut ow : Option[MutSelfEqOwner]
}

struct MutSelfEqK {
  id : Int
  hub : MutSelfEqHub
}

struct MutSelfEqOwner {
  mut kf : MutSelfEqK
}

impl Eq for MutSelfEqK {
  fn equal(self : MutSelfEqK, other : MutSelfEqK) -> Bool {
    match self.hub.ow {
      Some(o) => o.kf = MutSelfEqK::{ id: 2, hub: MutSelfEqHub::{ ow: None } }
      None => ()
    }
    self.id == other.id
  }
}

fn make_dyn_str(prefix : String, id : Int) -> String {
  prefix + "-" + id.to_string() + "-heap-allocated-payload"
}

fn mutbuf_step(b : MutBuf) -> Int {
  let sb = StringBuilder::new()
  sb.write_string("s")
  let t = sb.to_string()
  b.pos = b.pos + 1
  t.length() + b.pos
}

fn mutbuf_cyc_a(b : MutBuf, k : Int, rep : String) -> Int {
  if k <= 0 { 0 } else { mutbuf_cyc_b(b, k - 1, rep) }
}

fn mutbuf_cyc_b(b : MutBuf, k : Int, rep : String) -> Int {
  b.src = rep
  mutbuf_cyc_a(b, k - 1, rep)
}

fn swap_mut_str(mut s : String, rep : String) -> Int {
  s = rep
  1
}

fn clobber_and_idx(b : MutBuf, rep : String) -> Int {
  b.src = rep
  0
}

fn test_mut_ref_field_promotion() -> Int {
  // 1. Positive: borrowed mut field let across helper calls + loop hoisting + direct method borrow
  let b1 = MutBuf::{ src: make_dyn_str("pos-mut", 1), pos: 0, items: [] }
  let s1 = b1.src
  let step1 = mutbuf_step(b1)
  let mut sum1 = 0
  let mut i = 0
  while i < b1.src.length() {
    sum1 = sum1 + b1.src.code_unit_at(i)
    b1.items.push(i)
    i = i + 1
  }
  let ok1 = assert_str_eq(s1, "pos-mut-1-heap-allocated-payload") + (if step1 > 0 && sum1 > 0 && b1.items.length() == s1.length() { 1 } else { 0 })

  // 2. Negative: direct write to b.src must retain s2
  let b2 = MutBuf::{ src: make_dyn_str("neg-direct", 2), pos: 0, items: [] }
  let s2 = b2.src
  b2.src = make_dyn_str("REPLACED", 20)
  let ok2 = assert_str_eq(s2, "neg-direct-2-heap-allocated-payload")

  // 3. Negative: aliased write through second binding must retain s3
  let b3 = MutBuf::{ src: make_dyn_str("neg-alias", 3), pos: 0, items: [] }
  let b3_alias = b3
  let s3 = b3.src
  b3_alias.src = make_dyn_str("REPLACED", 30)
  let ok3 = assert_str_eq(s3, "neg-alias-3-heap-allocated-payload")

  // 4. Negative: mutual recursion cycle write must retain s4
  let b4 = MutBuf::{ src: make_dyn_str("neg-cycle", 4), pos: 0, items: [] }
  let s4 = b4.src
  let _ = mutbuf_cyc_a(b4, 2, make_dyn_str("REPLACED", 40))
  let ok4 = assert_str_eq(s4, "neg-cycle-4-heap-allocated-payload")

  // 5. Negative: EMutArg write via aliased mut binding must retain s5
  let b5 = MutBuf::{ src: make_dyn_str("neg-mutarg", 5), pos: 0, items: [] }
  let mut b5_alias = b5
  let s5 = b5.src
  let _ = swap_mut_str(mut b5_alias.src, make_dyn_str("REPLACED", 50))
  let ok5 = assert_str_eq(s5, "neg-mutarg-5-heap-allocated-payload")

  // 6. Negative: mut self method on mut field via aliased mut binding must retain x6
  let w6 = MutWrap::{ inner: MutInner::{ text: make_dyn_str("neg-mutself", 6) } }
  let mut w6_alias = w6
  let x6 = w6.inner
  let _ = w6_alias.inner.replace_inner(make_dyn_str("REPLACED", 60))
  let ok6 = assert_str_eq(x6.text, "neg-mutself-6-heap-allocated-payload")

  // 7. Negative: closure write must retain s7
  let b7 = MutBuf::{ src: make_dyn_str("neg-closure", 7), pos: 0, items: [] }
  let cb7 = fn() -> Unit { b7.src = make_dyn_str("REPLACED", 70) }
  let s7 = b7.src
  cb7()
  let ok7 = assert_str_eq(s7, "neg-closure-7-heap-allocated-payload")

  // 8. Negative: trait impl write must retain s8
  let b8 = MutBuf::{ src: make_dyn_str("neg-trait", 8), pos: 0, items: [] }
  let c8 = Clobberer::{ id: 8 }
  let s8 = b8.src
  c8.clobber(b8, make_dyn_str("REPLACED", 80))
  let ok8 = assert_str_eq(s8, "neg-trait-8-heap-allocated-payload")

  // 9. Negative: method receiver must retain when arg mutates b9.src
  let b9 = MutBuf::{ src: make_dyn_str("neg-metharg", 9), pos: 0, items: [] }
  let ch9 = b9.src.code_unit_at(clobber_and_idx(b9, make_dyn_str("REPLACED", 90)))
  let ok9 = if ch9 == 110 { 1 } else { panic("expected 'n' (110) before clobber, got " + ch9.to_string()) }

  // 10. Negative: loop where callee writes b10.src must see updated string on iter 1
  let b10 = MutBuf::{ src: make_dyn_str("aaa", 10), pos: 0, items: [] }
  let mut c10 = 0
  let mut j = 0
  while j < 2 {
    c10 = c10 * 1000 + b10.src.code_unit_at(0)
    if j == 0 {
      let _ = clobber_and_idx(b10, make_dyn_str("zzz", 100))
    }
    j = j + 1
  }
  // 'a' = 97, 'z' = 122 -> 97122
  let ok10 = if c10 == 97122 { 1 } else { panic("expected 97122, got " + c10.to_string()) }

  // 11. Negative: enum associated static method writing b11.src (direct, indirect, method arg, loop)
  let b11 = MutBuf::{ src: make_dyn_str("neg-enum-static", 11), pos: 0, items: [] }
  let s11 = b11.src
  let _ = MutAction::clobber(b11, make_dyn_str("REPLACED", 110))
  let junk11 = make_dyn_str("qqq-enum-static", 11)
  let ok11a = assert_str_eq(s11, "neg-enum-static-11-heap-allocated-payload") + 0 * junk11.length()
  let b11i = MutBuf::{ src: make_dyn_str("neg-enum-indir", 11), pos: 0, items: [] }
  let s11i = b11i.src
  let _ = mut_action_indirect(b11i, make_dyn_str("REPLACED", 112))
  let junk11i = make_dyn_str("qqq-enum-indir", 11)
  let ok11i = assert_str_eq(s11i, "neg-enum-indir-11-heap-allocated-payload") + 0 * junk11i.length()
  let b11b = MutBuf::{ src: make_dyn_str("enum-arg", 11), pos: 0, items: [] }
  let ch11 = b11b.src.code_unit_at(MutAction::clobber(b11b, make_dyn_str("REPLACED", 111)))
  let ok11b = if ch11 == 101 { 1 } else { panic("expected 'e' (101), got " + ch11.to_string()) }
  let b11l = MutBuf::{ src: make_dyn_str("aaa", 11), pos: 0, items: [] }
  let mut c11 = 0
  let mut k11 = 0
  while k11 < 2 {
    c11 = c11 * 1000 + b11l.src.code_unit_at(0)
    let _ = MutAction::clobber(b11l, make_dyn_str("zzz", 113 + k11))
    let _ = make_dyn_str("qqq", 113 + k11)
    k11 = k11 + 1
  }
  let ok11l = if c11 == 97122 { 1 } else { panic("expected 97122, got " + c11.to_string()) }

  // 12. Negative: shadowed local custom Eq writing b12.src (Pillar 1 + Pillar 2 loop)
  let sk1 = 0
  let sk2 = 0
  let b12 = MutBuf::{ src: make_dyn_str("aaa", 12), pos: sk1 + sk2, items: [] }
  let s12 = b12.src
  let sk1 = MutEqKey::{ id: 1, b: b12 }
  let sk2 = MutEqKey::{ id: 1, b: b12 }
  let eq12 = if sk1 == sk2 { 1 } else { 0 }
  let junk12 = make_dyn_str("qqq", 12)
  let ok12a = assert_str_eq(s12, "aaa-12-heap-allocated-payload") + 0 * junk12.length() + 0 * eq12
  let lk1 = 0
  let lk2 = 0
  let b12l = MutBuf::{ src: make_dyn_str("aaa", 12), pos: lk1 + lk2, items: [] }
  let mut c12 = 0
  let mut m12 = 0
  while m12 < 2 {
    c12 = c12 * 1000 + b12l.src.code_unit_at(0)
    let lk1 = MutEqKey::{ id: 2, b: b12l }
    let lk2 = MutEqKey::{ id: 2, b: b12l }
    if lk1 == lk2 {
      c12 = c12 + 0
    }
    let _ = make_dyn_str("qqq", 12)
    m12 = m12 + 1
  }
  // 'a' = 97, 'Z' = 90 -> 97090
  let ok12l = if c12 == 97090 { 1 } else { panic("expected 97090, got " + c12.to_string()) }

  // 13. Negative: borrowed binding name `s` shadowing outer `Int` with self-clobbering custom Eq
  let hub13 = MutSelfEqHub::{ ow: None }
  let ow13 = MutSelfEqOwner::{ kf: MutSelfEqK::{ id: 1, hub: hub13 } }
  hub13.ow = Some(ow13)
  let s13 = 0
  let t13 = s13 + 1
  let s13 = ow13.kf
  let e13 = if s13 == s13 { 1 } else { 0 }
  let junk13 = MutSelfEqK::{ id: 777, hub: MutSelfEqHub::{ ow: None } }
  let ok13 = if s13.id == 1 { 1 + 0 * e13 + 0 * t13 + 0 * junk13.id } else { panic("expected 1, got " + s13.id.to_string()) }
  hub13.ow = None

  ok1 + ok2 + ok3 + ok4 + ok5 + ok6 + ok7 + ok8 + ok9 + ok10 + ok11a + ok11i + ok11b + ok11l + ok12a + ok12l + ok13
}

pub fn main(world : World) -> Int {
  let r1 = test_layer1_perceus_pinning()
  let r2 = test_layer1_shadowing_and_loop()
  let r3 = assert_str_eq(test_layer1_match_early_ret(0), "node-0-payload") +
    assert_str_eq(test_layer1_match_early_ret(1), "tag-1-extra") +
    assert_str_eq(test_layer1_match_early_ret(2), "node-2-payload:tag-2-extra")
  let r4 = test_layer1_escapes()
  let r5 = test_layer1_negatives()
  let r6 = test_layer2_call_window_negatives()
  let r7 = test_layer3_trap_and_mt(world)
  let r8 = test_mut_ref_field_promotion()
  io_println("wave_j2_ok:" + (r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8).to_string())
  0
}
