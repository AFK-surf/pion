// CLBG Track P1: 2-variant null-niche enum adversarial 4-mode E2E
// Covers Native dev/release + Wasm32 dev/release + ASan across 12 scenarios.

#derive(Eq)
enum Tree {
  Leaf
  Node(Tree, Tree)
}

#derive(Eq)
enum PodNiche {
  Empty
  Val(Int)
}

#derive(Eq)
enum Flag {
  Off
  On(Bool)
}

enum MyList[T] {
  Nil
  Cons(T, MyList[T])
}

trait Score {
  fn score(self : Self) -> Int
}

impl Score for Tree {
  fn score(self : Tree) -> Int {
    match self {
      Leaf => 7
      Node(l, r) => 1 + l.score() + r.score()
    }
  }
}

fn dyn_score(x : dyn Score) -> Int {
  x.score()
}

fn opt_dyn_score(x : Option[dyn Score]) -> Int {
  match x {
    None => -1
    Some(d) => d.score()
  }
}

fn make_tree(depth : Int) -> Tree {
  if depth <= 0 {
    Leaf
  } else {
    Node(make_tree(depth - 1), make_tree(depth - 1))
  }
}

fn check_tree(t : Tree) -> Int {
  match t {
    Leaf => 1
    Node(l, r) => 1 + check_tree(l) + check_tree(r)
  }
}

// Erased generic helper (uses %tp_T)
fn list_push[T](xs : MyList[T], v : T) -> MyList[T] {
  Cons(v, xs)
}

fn list_len[T](xs : MyList[T]) -> Int {
  match xs {
    Nil => 0
    Cons(_, tail) => 1 + list_len(tail)
  }
}

fn list_head_or[T](xs : MyList[T], dflt : T) -> T {
  match xs {
    Nil => dflt
    Cons(h, _) => h
  }
}

#verify
fn verified_tree_nodes(t : Tree) -> Int {
  match t {
    Leaf => 1
    Node(l, r) => 1 + verified_tree_nodes(l) + verified_tree_nodes(r)
  }
}

#verify
fn verified_flag_code(f : Flag) -> Int {
  match f {
    Off => 0
    On(b) => if b { 2 } else { 1 }
  }
}

fn make_dyn_flag(b : Bool) -> Flag {
  On(b)
}

fn produce_pod_res(k : Int) -> Result[PodNiche, Int] {
  if k < 0 {
    Err(k)
  } else if k == 0 {
    Ok(Empty)
  } else {
    Ok(Val(k))
  }
}

fn produce_pod_opt(k : Int) -> Option[PodNiche] {
  if k < 0 {
    None
  } else if k == 0 {
    Some(Empty)
  } else {
    Some(Val(k))
  }
}

fn forward_pod_res(k : Int) -> Result[Int, Int] {
  match produce_pod_res(k) {
    Ok(x) =>
      match x {
        Empty => Ok(100)
        Val(v) => Ok(v)
      }
    Err(e) => Err(e)
  }
}

fn forward_pod_opt(k : Int) -> Option[Int] {
  match produce_pod_opt(k) {
    Some(x) =>
      match x {
        Empty => Some(200)
        Val(v) => Some(v)
      }
    None => None
  }
}

pub fn main(world : World) -> Int {
  // 1. Option[Tree]: Some(Leaf) != None, match, unwrap_or, is Some(Leaf), Some(Node(Leaf, Leaf))
  let o_none : Option[Tree] = None
  let o_leaf : Option[Tree] = Some(Leaf)
  let o_node : Option[Tree] = Some(Node(Leaf, Leaf))
  let s1_a = if o_leaf != o_none { 1 } else { 0 }
  let s1_b = match o_leaf {
    None => 0
    Some(Leaf) => 1
    Some(Node(_, _)) => 0
  }
  let s1_c = match o_none {
    None => 1
    Some(_) => 0
  }
  let s1_d = if o_leaf is Some(Leaf) { 1 } else { 0 }
  let s1_e = if o_none is Some(Leaf) { 0 } else { 1 }
  let s1_f = check_tree(o_leaf.unwrap_or(Node(Leaf, Leaf)))
  let s1_g = check_tree(o_none.unwrap_or(Node(Leaf, Leaf)))
  let s1_h = match o_node {
    Some(Node(Leaf, Leaf)) => 1
    _ => 0
  }
  let s1 = s1_a + s1_b + s1_c + s1_d + s1_e + s1_f + s1_g + s1_h

  // 2. Map[Int, Tree] storing Leaf & Node, get & get().unwrap_or
  let m : Map[Int, Tree] = Map([])
  m.set(1, Leaf)
  m.set(2, Node(Leaf, Leaf))
  let m1 = match m.get(1) {
    Some(Leaf) => 10
    _ => 0
  }
  let m2 = match m.get(2) {
    Some(Node(Leaf, Leaf)) => 20
    _ => 0
  }
  let m3 = match m.get(3) {
    None => 30
    Some(_) => 0
  }
  let m4 = check_tree(m.get(1).unwrap_or(Node(Leaf, Leaf)))
  let m5 = check_tree(m.get(99).unwrap_or(Node(Leaf, Leaf)))
  let s2 = m1 + m2 + m3 + m4 + m5

  // 3. Array[Tree] storing Leaf & Node, pop & indexing
  let arr : Array[Tree] = [Leaf, Node(Leaf, Leaf), Leaf]
  let a_first = check_tree(arr[0])
  let a_mid = check_tree(arr[1])
  let a_p1 = match arr.pop() {
    Some(Leaf) => 1
    _ => 0
  }
  let a_p2 = match arr.pop() {
    Some(Node(Leaf, Leaf)) => 1
    _ => 0
  }
  let a_p3 = match arr.pop() {
    Some(Leaf) => 1
    _ => 0
  }
  let a_p4 = match arr.pop() {
    None => 1
    Some(_) => 0
  }
  let s3 = a_first + a_mid + a_p1 + a_p2 + a_p3 + a_p4

  // 4. Channel[Tree] send/recv Leaf and Node + closed recv -> None
  let ch : Channel[Tree] = Channel::new(4)
  let _ = ch.send(Leaf)
  let _ = ch.send(Node(Leaf, Leaf))
  ch.close()
  let c1 = match ch.recv() {
    Some(Leaf) => 10
    _ => 0
  }
  let c2 = match ch.recv() {
    Some(Node(Leaf, Leaf)) => 20
    _ => 0
  }
  let c3 = match ch.recv() {
    None => 30
    Some(_) => 0
  }
  let s4 = c1 + c2 + c3

  // 5. Mutex[Tree] read/write Leaf and Node
  let mx : Mutex[Tree] = Mutex::new(Leaf)
  let mx1 = check_tree(mx.lock())
  mx.set(Node(Leaf, Node(Leaf, Leaf)))
  mx.unlock()
  let mx2 = check_tree(mx.lock())
  mx.set(Leaf)
  mx.unlock()
  let mx3 = check_tree(mx.lock())
  mx.unlock()
  let s5 = mx1 + mx2 + mx3

  // 6. Leaf as dyn Trait dispatch & drop + Option[dyn Trait]
  let d_leaf : dyn Score = Leaf as dyn Score
  let d_node : dyn Score = Node(Leaf, Leaf) as dyn Score
  let s6 = dyn_score(d_leaf) +
    dyn_score(d_node) +
    opt_dyn_score(Some(Leaf as dyn Score)) +
    opt_dyn_score(None)

  // 7. enum Flag { Off; On(Bool) } three-state distinction + #derive(Eq)
  let f_off = Off
  let f_false = On(false)
  let f_true = On(true)
  let f_dyn_f = make_dyn_flag(false)
  let f_dyn_t = make_dyn_flag(true)
  let f_ok = (f_off == Off) &&
    (f_off != f_false) &&
    (f_off != f_true) &&
    (f_false != f_true) &&
    (f_false == f_dyn_f) &&
    (f_true == f_dyn_t) &&
    (verified_flag_code(f_off) == 0) &&
    (verified_flag_code(f_dyn_f) == 1) &&
    (verified_flag_code(f_dyn_t) == 2)
  let s7 = if f_ok { 77 } else { 0 }

  // 8. Generic MyList[T] erased & monomorphized round-trip (Int / String / Tree / Option[Tree])
  let li : MyList[Int] = list_push(list_push(Nil, 10), 20)
  let ls : MyList[String] = list_push(list_push(Nil, "a"), "bc")
  let lt : MyList[Tree] = list_push(list_push(Nil, Leaf), Node(Leaf, Leaf))
  let lo : MyList[Option[Tree]] = list_push(list_push(list_push(Nil, None), Some(Leaf)), Some(Node(Leaf, Leaf)))
  let s8 = list_len(li) +
    list_head_or(li, 0) +
    list_len(ls) +
    list_head_or(ls, "").length() +
    list_len(lt) +
    check_tree(list_head_or(lt, Leaf)) +
    list_len(lo) +
    (match list_head_or(lo, None) {
      Some(Node(Leaf, Leaf)) => 5
      _ => 0
    })

  // 9. physical_equal (including outer Option[Tree]) & deep recursive tree build/destroy
  let pe1 = if physical_equal(Leaf, Leaf) { 1 } else { 0 }
  let pe2 = if physical_equal(Leaf, Node(Leaf, Leaf)) { 0 } else { 1 }
  let n_a = Node(Leaf, Leaf)
  let n_b = Node(Leaf, Leaf)
  let pe3 = if physical_equal(n_a, n_a) { 1 } else { 0 }
  let pe4 = if physical_equal(n_a, n_b) { 0 } else { 1 }
  let o_a : Option[Tree] = Some(n_a)
  let o_b : Option[Tree] = Some(n_a)
  let o_n1 : Option[Tree] = None
  let o_n2 : Option[Tree] = None
  let pe5 = if physical_equal(o_a, o_a) { 1 } else { 0 }
  let pe6 = if physical_equal(o_a, o_b) { 0 } else { 1 }
  let pe7 = if physical_equal(o_n1, o_n2) { 1 } else { 0 }
  let deep = make_tree(11)
  let deep_cnt = check_tree(deep)
  let s9 = pe1 + pe2 + pe3 + pe4 + pe5 + pe6 + pe7 + deep_cnt

  // 10. #verify function operating on niche enum
  let s10 = verified_tree_nodes(Node(Node(Leaf, Leaf), Leaf))

  // 11. Scalarized Result[PodNiche, Int] & Option[PodNiche] (PodEnum SROA + qbe_pod_buf_val)
  let r0 = match produce_pod_res(0) {
    Ok(x) =>
      match x {
        Empty => 10
        Val(v) => v + 1000
      }
    Err(_) => -1000
  }
  let r1 = match produce_pod_res(42) {
    Ok(x) =>
      match x {
        Empty => -1000
        Val(v) => v
      }
    Err(_) => -1000
  }
  let r2 = match produce_pod_res(-3) {
    Ok(_) => -1000
    Err(e) => 0 - e
  }
  let o0 = match produce_pod_opt(0) {
    Some(x) =>
      match x {
        Empty => 20
        Val(v) => v + 1000
      }
    None => -1000
  }
  let o1 = match produce_pod_opt(7) {
    Some(x) =>
      match x {
        Empty => -1000
        Val(v) => v
      }
    None => -1000
  }
  let o2 = match produce_pod_opt(-1) {
    Some(_) => -1000
    None => 1
  }
  let fr0 = match forward_pod_res(0) {
    Ok(v) => v
    Err(_) => -1000
  }
  let fr1 = match forward_pod_res(5) {
    Ok(v) => v
    Err(_) => -1000
  }
  let fr2 = match forward_pod_res(-2) {
    Ok(_) => -1000
    Err(e) => 0 - e
  }
  let fo0 = match forward_pod_opt(0) {
    Some(v) => v
    None => -1000
  }
  let fo1 = match forward_pod_opt(9) {
    Some(v) => v
    None => -1000
  }
  let fo2 = match forward_pod_opt(-1) {
    Some(_) => -1000
    None => 1
  }
  let is_r = if produce_pod_res(0) is Ok(x) {
    match x {
      Empty => 11
      Val(_) => -1000
    }
  } else {
    -1000
  }
  let is_o = if produce_pod_opt(0) is Some(x) {
    match x {
      Empty => 13
      Val(_) => -1000
    }
  } else {
    -1000
  }
  let let_p = match produce_pod_res(0) {
    Ok(v) => v
    Err(_) => Val(999)
  }
  let let_r = match let_p {
    Empty => 17
    Val(_) => -1000
  }
  let s11 = r0 + r1 + r2 + o0 + o1 + o2 + fr0 + fr1 + fr2 + fo0 + fo1 + fo2 + is_r + is_o + let_r

  // 12. Pure-loop depth-4000 left-leaning Tree build & drop (P73 Wasm drop_s2 depth guard)
  let mut ltree : Tree = Leaf
  let mut li_d = 0
  while li_d < 4000 {
    ltree = Node(ltree, Node(Leaf, Leaf))
    li_d = li_d + 1
  }
  let l_top = match ltree {
    Leaf => 0
    Node(_, r) =>
      match r {
        Leaf => 0
        Node(Leaf, Leaf) => 12
        _ => 0
      }
  }
  ltree = Leaf
  let s12 = l_top + (match ltree {
    Leaf => 1
    Node(_, _) => 0
  })

  io_println(
    world,
    "p1_ok s1=" +
    s1.to_string() +
    " s2=" +
    s2.to_string() +
    " s3=" +
    s3.to_string() +
    " s4=" +
    s4.to_string() +
    " s5=" +
    s5.to_string() +
    " s6=" +
    s6.to_string() +
    " s7=" +
    s7.to_string() +
    " s8=" +
    s8.to_string() +
    " s9=" +
    s9.to_string() +
    " s10=" +
    s10.to_string() +
    " s11=" +
    s11.to_string() +
    " s12=" +
    s12.to_string(),
  )
  0
}
