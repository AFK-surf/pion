fn pair_read(a : Array[Int], b : Array[Int], first : Int, count : Int) -> Int {
  let mut i = first
  let mut n = count
  let mut acc = 0
  while n > 0 {
    let x = a[i]
    let y = b[i]
    acc = acc * 10 + x + y
    i = i + 1
    n = n - 1
  }
  acc
}

fn frozen_read(a : ImmArray[Int], b : ImmArray[Int], first : Int, use : Bool) -> Int {
  let i = first
  while use {
    let x = a[i]
    let y = b[i]
    return x + y
  }
  0
}

fn views(a : StrView, b : BytesView, i : Int, use : Bool) -> Byte {
  while use {
    let x = a[i]
    let y = b[i]
    if x == 98 {
      return y
    }
    break
  }
  (0).to_byte()
}

fn repeated(a : Array[Int], i : Int, use : Bool) -> Int {
  while use {
    let x = a[i]
    let y = a[i]
    return x + y
  }
  0
}

fn pair_continue(a : Array[Int], b : Array[Int], count : Int) -> Int {
  let mut i = 0
  let mut acc = 0
  while i < count {
    let x = a[i]
    let y = b[i]
    i = i + 1
    if x == 1 {
      continue
    }
    acc = acc + x * 10 + y
  }
  acc
}

fn alias_push(a : Array[Int], b : Array[Int], alias : Array[Int]) -> Int {
  let mut i = 0
  let mut sum = 0
  while true {
    let x = a[i]
    let y = b[i]
    sum = sum + x + y
    if i == 0 {
      alias.push(9)
    } else {
      return sum
    }
    i = i + 1
  }
  sum
}

fn alias_store(a : Array[Int], b : Array[Int], alias : Array[Int]) -> Int {
  let mut n = 0
  let mut total = 0
  let i = 0
  while n < 2 {
    let x = a[i]
    let y = b[i]
    total = total + x + y
    alias[0] = 7
    n = n + 1
  }
  total
}

fn replace(mut a : Array[Int]) -> Unit {
  a = [9, 7]
}

fn byref(a0 : Array[Int], b : Array[Int]) -> Int {
  let mut a = a0
  let i = 0
  let mut n = 0
  let mut sum = 0
  while n < 2 {
    let x = a[i]
    let y = b[i]
    sum = sum + x + y
    if n == 0 {
      replace(mut a)
    }
    n = n + 1
  }
  sum
}

fn rebind(a0 : Array[Int], b : Array[Int]) -> Int {
  let mut a = a0
  let i = 0
  let mut n = 0
  let mut sum = 0
  while n < 2 {
    let x = a[i]
    let y = b[i]
    sum = sum + x + y
    if n == 0 {
      a = [8, 7]
    }
    n = n + 1
  }
  sum
}

fn scan(s : String, start : Int, bound : Int) -> Int {
  let mut p = start
  while p < bound && s.code_unit_at(p) != 32 {
    p = p + 1
  }
  p
}

pub fn main(world : World) -> Int {
  let k = args_get(world)[1]
  let a : Array[Int] = [1, 2]
  let b : Array[Int] = [3]
  let z : Array[Int] = []
  let n = if k == "both" {
    pair_read(a, b, 3, 1)
  } else if k == "second" {
    pair_read(a, b, 1, 1)
  } else if k == "neg" {
    pair_read(a, b, -1, 1)
  } else if k == "empty" {
    pair_read(z, b, 0, 1)
  } else if k == "skip" {
    pair_read(z, z, -1, 0)
  } else if k == "repeat" {
    repeated(a, 1, true)
  } else if k == "frozen" {
    frozen_read(ImmArray::from_array(a), ImmArray::from_array(a), 1, true)
  } else if k == "views" {
    views("ab".as_view(), "cd".to_bytes().as_view(), 1, true).to_int()
  } else if k == "cont" {
    pair_continue(a, a, 2)
  } else if k == "alias" {
    alias_push(b, b, b)
  } else if k == "payload" {
    alias_store(a, a, a)
  } else if k == "ref" {
    byref(a, b)
  } else if k == "rebind" {
    rebind(a, b)
  } else if k == "s1" {
    scan("a b", 0, 3)
  } else if k == "s2" {
    scan("abc", 1, 3)
  } else if k == "s3" {
    scan("a b", 0, 99)
  } else if k == "s4" {
    scan("abc", 1, 99)
  } else if k == "s5" {
    scan("abc", -1, 2)
  } else if k == "s6" {
    scan("", -1, -2)
  } else if k == "s7" {
    scan("a b", 2, 3)
  } else if k == "s8" {
    scan("é b", 0, 4)
  } else if k == "s9" {
    scan("", 0, 0)
  } else if k == "s10" {
    scan("a b", 3, 3)
  } else {
    pair_read(a, a, 0, 2)
  }
  io_println(world, n.to_string())
  0
}
