# Regression for the packet graph's register allocation of scalar
# single-precision operations: four Float arguments in xmm0..xmm3 (the
# second unused), four Double arguments in xmm4..xmm7, and `%a` live past
# `%u`. Before Ks add / sub / mul kept the scalar operand order, rega(packet)
# gave `%u` another register, and the x86 two-address `mulss` then returned
# the other operand's NaN payload on the packed arm.
export function s $mix(l %p, s %a, s %unused, s %b, s %c, d %d0, d %d1, d %d2, d %d3) {
@start
	%q =l add %p, 8
	%u =s mul %a, %b
	%x =d add %d2, %d1
	%y =d add %d0, %d3
	stored %x, %p
	stored %y, %q
	%v =s mul %c, %a
	%r =s mul %v, %u
	ret %r
}
