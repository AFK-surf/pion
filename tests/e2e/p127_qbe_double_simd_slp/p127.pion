// P127: QBE strict 2 x f64 SLP (vendor/qbe/slp.h). The kernels below update
// adjacent `Double` fields of a struct, so on amd64_sysv / arm64_apple QBE
// packs each pair of field writes into one 128-bit operation behind an entry
// test of MXCSR / FPCR. Every result is printed as its exact IEEE-754 bit
// pattern, first with all exceptions masked (vector arm), then with only the
// divide-by-zero trap enabled (none of the kernels divides), which makes the
// entry test select the retained scalar graph of the same functions. The two
// halves must be identical bit for bit, NaN payloads included; ref.c prints
// the same lines from C.

extern "C" fn p127_fp_scalar_mode(on : Int) -> Int
extern "C" fn p127_clobber_vectors(seed : Int64) -> Unit

pub struct Vec2 {
  mut x : Double
  mut y : Double
}

pub struct Body {
  mut x : Double
  mut y : Double
  mut vx : Double
  mut vy : Double
}

// Every kernel takes its step counter as a `mut` parameter, so it is never
// inlined into run_all (SPEC.md, `mut` parameters) and QBE sees it as one
// bounded function.

// Loop-carried field updates through memory on one base: v += p * dt;
// p += v * dt, with `dt` broadcast to both lanes, and the per-step energy
// `vx * vx + vy * vy` formed as one ordered horizontal sum of a two-lane
// product. Accesses to one base at distinct offsets may be reordered.
fn drift(b : Body, dt : Double, mut n : Int) -> Double {
  let mut e = 0.0
  while n > 0 {
    b.vx = b.vx + b.x * dt
    b.vy = b.vy + b.y * dt
    b.x = b.x + b.vx * dt
    b.y = b.y + b.vy * dt
    e = e + (b.vx * b.vx + b.vy * b.vy)
    n = n - 1
  }
  e
}

// The same recurrence on two structs that may be one object: packing would
// move a read of `v` across a write of `p`, so QBE keeps the scalar code.
fn shear(p : Vec2, v : Vec2, dt : Double, mut n : Int) -> Double {
  let mut e = 0.0
  while n > 0 {
    v.x = v.x + p.x * dt
    v.y = v.y + p.y * dt
    p.x = p.x + v.x * dt
    p.y = p.y + v.y * dt
    e = e + (v.x * v.x + v.y * v.y)
    n = n - 1
  }
  e
}

// The same recurrence carried in locals, with a subtraction: the loop phis
// become vector phis across the back edge, and the fields are written once
// after the loop; the result is a horizontal sum of the final squares.
fn orbit(p : Vec2, v : Vec2, dt : Double, mut n : Int) -> Double {
  let mut px = p.x
  let mut py = p.y
  let mut vx = v.x
  let mut vy = v.y
  while n > 0 {
    vx = vx - px * dt
    vy = vy - py * dt
    px = px + vx * dt
    py = py + vy * dt
    n = n - 1
  }
  p.x = px
  p.y = py
  v.x = vx
  v.y = vy
  px * px + py * py
}

// A packed value live across a foreign call that overwrites every volatile
// vector register (SysV) and the high halves of v8-v15 (AAPCS64): it must be
// kept in a private 16-byte slot and reloaded with both lanes intact. No
// floating-point operation follows the call, so the packet graph is kept.
fn kick(p : Vec2, v : Vec2, dt : Double, mut seed : Int64) -> Unit {
  let nx = p.x * dt + v.x
  let ny = p.y * dt + v.y
  p127_clobber_vectors(seed)
  seed = seed + 1L
  p.x = nx
  p.y = ny
}

fn bits(x : Double) -> String {
  x.to_bits().to_string()
}

fn show(sb : StringBuilder, p : Vec2) -> Unit {
  sb.write_string(" ")
  sb.write_string(bits(p.x))
  sb.write_string(" ")
  sb.write_string(bits(p.y))
}

fn run_all(w : World, tag : String, ds : Array[Double]) -> Unit {
  let n = ds.length()
  let mut i = 0
  while i < n {
    let mut j = 0
    while j < n {
      let a = ds[i]
      let b = ds[j]
      let c = ds[(i + 3) % n]
      let d = ds[(j * 5 + 1) % n]
      let dt = ds[(i + j * 7) % n]
      let sb = StringBuilder::new()
      sb.write_string(tag + " " + i.to_string() + " " + j.to_string())

      let body = Body::{ x: a, y: b, vx: c, vy: d }
      let mut n1 = 3
      let e = drift(body, dt, mut n1)
      sb.write_string(" drift " + bits(body.x) + " " + bits(body.y) + " " + bits(body.vx) + " " +
        bits(body.vy) + " " + bits(e))

      let p = Vec2::{ x: a, y: b }
      let v = Vec2::{ x: c, y: d }
      let mut n2 = 3
      let e1 = shear(p, v, dt, mut n2)
      sb.write_string(" shear")
      show(sb, p)
      show(sb, v)
      sb.write_string(" " + bits(e1))

      let q = Vec2::{ x: a, y: b }
      let mut n5 = 3
      let e2 = shear(q, q, dt, mut n5)
      sb.write_string(" shear_alias")
      show(sb, q)
      sb.write_string(" " + bits(e2))

      let r = Vec2::{ x: a, y: b }
      let s = Vec2::{ x: c, y: d }
      let mut n3 = 3
      let e3 = orbit(r, s, dt, mut n3)
      sb.write_string(" orbit")
      show(sb, r)
      show(sb, s)
      sb.write_string(" " + bits(e3))

      let t = Vec2::{ x: a, y: b }
      let mut n4 = 3
      let e4 = orbit(t, t, dt, mut n4)
      sb.write_string(" orbit_alias")
      show(sb, t)
      sb.write_string(" " + bits(e4))

      let k = Vec2::{ x: a, y: b }
      let kv = Vec2::{ x: c, y: d }
      let mut seed = (i * 64 + j * 4).to_int64()
      let mut step = 0
      while step < 3 {
        kick(k, kv, dt, mut seed)
        step = step + 1
      }
      sb.write_string(" kick")
      show(sb, k)

      let ka = Vec2::{ x: a, y: b }
      kick(ka, ka, dt, mut seed)
      sb.write_string(" kick_alias")
      show(sb, ka)

      io_println(w, sb.to_string())
      j = j + 1
    }
    i = i + 1
  }
}

pub fn main(w : World) -> Int {
  // +0, -0, 1, -1.5, 0.1, 4, pi, min / max subnormal, min normal, max
  // finite, +Inf, -Inf, two quiet NaNs with different signs and payloads,
  // and a signalling NaN.
  let dbits : Array[Int64] = [
    0L, -9223372036854775807L - 1L, 4607182418800017408L, -4613937818241073152L,
    4591870180066957722L, 4616189618054758400L, 4614256656552045848L, 1L,
    4503599627370495L, 4503599627370496L, 9218868437227405311L,
    9218868437227405312L, -4503599627370496L, 9221120237041090561L,
    -2251799813682500L, 9218868437227408301L,
  ]
  let ds : Array[Double] = []
  for b in dbits {
    ds.push(Double::from_bits(b))
  }
  run_all(w, "V", ds)
  let trapping = p127_fp_scalar_mode(1)
  run_all(w, "S", ds)
  let restored = p127_fp_scalar_mode(0)
  io_println(w, "mode " + trapping.to_string() + " " + restored.to_string())
  0
}
