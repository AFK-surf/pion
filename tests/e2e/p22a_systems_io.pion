///| Phase 22-A E2E: systems IO & byte FFI primitives.

///|
extern "C" fn c_fs_cpath(data : Ptr, len : Int64) -> Ptr = "pion_fs_cpath"

///|
fn cpath(s : String) -> Ptr {
  c_fs_cpath(str_data_ptr(s), s.length().to_int64())
}

fn run_read_lines_mode(world : World) -> Int {
  let mut count = 0
  while true {
    match io_read_line(world) {
      Some(line) => {
        count = count + 1
        io_println(world, "\{count}:\{line.length()}:\{line}")
      }
      None => break
    }
  }
  io_println(world, "EOF:\{count}")
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() > 1 && args[1] == "--read-lines" {
    return run_read_lines_mode(world)
  }

  // 1. ptr_read_u8 / ptr_write_u8 / bytes_from_ptr / bytes_copy_to_ptr
  let p = ptr_alloc(16L)
  if ptr_is_null(p) {
    return 1
  }
  ptr_write_u8(p, 0L, 0)
  ptr_write_u8(p, 1L, 127)
  ptr_write_u8(p, 2L, 128)
  ptr_write_u8(p, 3L, 255)
  if ptr_read_u8(p, 0L) != 0 || ptr_read_u8(p, 1L) != 127 {
    ptr_free(p)
    return 2
  }
  if ptr_read_u8(p, 2L) != 128 || ptr_read_u8(p, 3L) != 255 {
    ptr_free(p)
    return 3
  }
  let b = bytes_from_ptr(p, 4)
  if b.length() != 4 {
    ptr_free(p)
    return 4
  }
  if b[0] != b'\x00' || b[1] != b'\x7f' || b[2] != b'\x80' || b[3] != b'\xff' {
    ptr_free(p)
    return 5
  }
  let empty_b = bytes_from_ptr(p, 0)
  if empty_b.length() != 0 {
    ptr_free(p)
    return 6
  }
  let dst = ptr_alloc(16L)
  bytes_copy_to_ptr(b, 1, dst, 2)
  if ptr_read_u8(dst, 0L) != 127 || ptr_read_u8(dst, 1L) != 128 {
    ptr_free(dst)
    ptr_free(p)
    return 7
  }
  ptr_free(dst)
  ptr_free(p)

  // 2. fs_symlink / fs_lstat / fs_readlink / fs_chmod / fs_read_range_nofollow
  let ts = clock_now_ms(world)
  let tmp_dir = "/tmp/pion_p22a_e2e_\{ts}"
  if !fs_mkdir_p(world, tmp_dir) {
    return 10
  }
  let sub_dir = tmp_dir + "/sub"
  if !fs_mkdir_p(world, sub_dir) {
    return 11
  }
  let data_path = tmp_dir + "/data.bin"
  let link_path = tmp_dir + "/link.bin"
  match fs_write(world, data_path, "0123456789abcdefghij") {
    Ok(_) => ()
    Err(_) => return 12
  }
  if !fs_chmod(world, data_path, 420) {
    return 13
  }
  match fs_lstat(world, data_path) {
    Ok(info) => {
      let parts = info.split("|")
      if parts.length() != 5 || parts[0] != "file" || parts[1] != "20" || parts[2] != "0" {
        return 14
      }
    }
    Err(_) => return 15
  }
  if !fs_chmod(world, data_path, 493) {
    return 16
  }
  match fs_lstat(world, data_path) {
    Ok(info) => {
      let parts = info.split("|")
      if parts.length() != 5 || parts[0] != "file" || parts[1] != "20" || parts[2] != "1" {
        return 17
      }
    }
    Err(_) => return 18
  }
  match fs_lstat(world, sub_dir) {
    Ok(info) => {
      if !info.starts_with("dir|") {
        return 19
      }
    }
    Err(_) => return 20
  }
  if !fs_symlink(world, "data.bin", link_path) {
    return 21
  }
  match fs_lstat(world, link_path) {
    Ok(info) => {
      if !info.starts_with("link|") {
        return 22
      }
    }
    Err(_) => return 23
  }
  match fs_readlink(world, link_path) {
    Ok(tgt) => {
      if tgt != "data.bin" {
        return 24
      }
    }
    Err(_) => return 25
  }
  match fs_readlink(world, data_path) {
    Ok(_) => return 26
    Err(e) => {
      if e.length() == 0 {
        return 27
      }
    }
  }
  match fs_lstat(world, tmp_dir + "/missing") {
    Ok(_) => return 28
    Err(e) => {
      if e.length() == 0 {
        return 29
      }
    }
  }

  // fs_read_range_nofollow: valid range, symlink reject, wrong size reject
  match fs_read_range_nofollow(world, data_path, 5L, 10, 20L) {
    Ok(chunk) => {
      if chunk.length() != 10 || chunk.to_string() != "56789abcde" {
        return 30
      }
    }
    Err(_) => return 31
  }
  match fs_read_range_nofollow(world, link_path, 0L, 4, 20L) {
    Ok(_) => return 32
    Err(e) => {
      if e != "changed" {
        return 33
      }
    }
  }
  match fs_read_range_nofollow(world, data_path, 0L, 4, 19L) {
    Ok(_) => return 34
    Err(e) => {
      if e != "changed" {
        return 35
      }
    }
  }
  match fs_read_range_nofollow(world, data_path, 15L, 10, 20L) {
    Ok(_) => return 36
    Err(e) => {
      if e != "changed" {
        return 37
      }
    }
  }

  // 3. proc_exec_capture_bytes: NUL byte preservation + stderr silenced + non-zero exit
  match proc_exec_capture_bytes(world, ["/bin/sh", "-c", "printf 'a\\000b\\377'; echo noisy >&2"]) {
    Ok(raw) => {
      if raw.length() != 4 {
        return 40
      }
      if raw[0] != b'a' || raw[1] != b'\x00' || raw[2] != b'b' || raw[3] != b'\xff' {
        return 41
      }
    }
    Err(_) => return 42
  }
  match proc_exec_capture_bytes(world, ["/bin/sh", "-c", "printf 'ignored'; exit 7"]) {
    Ok(_) => return 43
    Err(e) => {
      if e != "exit 7" {
        return 44
      }
    }
  }

  // 4. io_read_line via piped child invocation of self (CRLF, empty line, trailing line without LF, EOF)
  let self_exe = world_argv(world, 0)
  match proc_exec_capture(world, ["/bin/sh", "-c", "printf 'alpha\\r\\n\\ngamma' | \"$1\" --read-lines", "_", self_exe]) {
    Ok(out) => {
      let want = "1:5:alpha\n2:0:\n3:5:gamma\nEOF:3\n"
      if out != want {
        return 50
      }
    }
    Err(_) => return 51
  }

  // 5. Paths with an embedded NUL never reach the OS: `pion_fs_cpath` (what
  // pionc feeds its `libpionrt_cli.a` helpers `pion_fs_mkdir_excl` /
  // `pion_fs_trylock` through, covered by runtime/test_rt.c) refuses them,
  // and `<prefix>` is never created or written.
  let pre = tmp_dir + "/nulpre"
  let bad = pre + "\0suffix"
  if bad.length() != pre.length() + 7 {
    return 60
  }
  if !ptr_is_null(cpath(bad)) || ptr_is_null(cpath(pre)) || !ptr_is_null(c_fs_cpath(str_data_ptr(pre), 0L)) {
    return 61
  }
  match fs_write(world, bad, "x") {
    Ok(_) => return 63
    Err(_) => ()
  }
  if fs_mkdir_p(world, bad) || fs_exists(world, pre) {
    return 64
  }
  // The same calls on the real name succeed.
  if !fs_mkdir_p(world, pre) || !fs_is_dir(world, pre) {
    return 66
  }

  // Cleanup temp directory
  let _ = proc_exec(world, ["rm", "-rf", tmp_dir])
  io_println(world, "p22a_systems_io ok")
  0
}
