pub struct Glass {
  blur : Int
  solid : Int
}

pub fn glass(blur : Int, solid : Int) -> Glass {
  Glass::{ blur: blur, solid: solid }
}

pub fn Glass::at_strength(self : Glass, k : Int) -> Int {
  self.blur * k + self.solid
}

pub fn Glass::wider(self : Glass, n : Int) -> Glass {
  Glass::{ ..self, blur: self.blur + n }
}

pub struct Box[T] {
  value : T
  count : Int
}

pub fn boxed[T](value : T, count : Int) -> Box[T] {
  Box::{ value: value, count: count }
}

pub fn Box::total[T](self : Box[T], k : Int) -> Int {
  self.count * k
}
