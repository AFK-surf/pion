import "lg"

// `paint` is only a transitive dependency of this package.
pub fn run_match(s : Int, k : Int) -> Int {
  lg::by_if(s > 0, k) + lg::small(s > 0, k)
}

// Instantiated in `app`: a generic of `lg` reached through a generic of `mid`.
pub fn relay[T](v : T, on : Bool, k : Int) -> (T, Int) {
  (v, lg::by_if(on, k) + lg::small(on, k))
}

// Generic of `lg` whose instances land in a package that does not import `lg`.
pub fn deep[T](v : T, on : Bool, k : Int) -> (T, Int) {
  let (a, x) = lg::mono(v, on, lg::plain(), k)
  let (b, y) = lg::slab(a, on, k)
  (b, x + y)
}
