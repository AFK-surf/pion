import "lg"
import "mid"
import "paint"
import "pt"

fn pick(m : Int, base : pt::Glass, k : Int) -> Int {
  let resolved = match m {
    0 => pt::Glass::{ ..base, solid: 1 }
    1 => pt::Glass::{ ..base, solid: 2 }
    _ => pt::Glass::{ ..base, solid: 3 }
  }
  resolved.at_strength(k)
}

fn other_pick(on : Bool, k : Int) -> Int {
  let resolved = if on {
    paint::Glass::{ blur: 1, solid: 1 }
  } else {
    paint::Glass::{ blur: 2, solid: 2 }
  }
  resolved.at_strength(k)
}

fn dead_pick(on : Bool, base : pt::Glass) -> Int {
  let resolved = if on { pt::Glass::{ ..base, solid: 1 } } else { base }
  resolved.at_strength(9)
}

pub fn main(world : World) -> Int {
  let g = pt::glass(10, 5)
  let b = pt::boxed("b", 1)
  io_println(world, "match " + lg::by_match(lg::Plain, g, 2).to_string() + " " + lg::by_match(lg::Solid(9), g, 2).to_string())
  io_println(world, "if " + lg::by_if(true, 2).to_string() + " " + lg::by_if(false, 2).to_string())
  io_println(world, "direct " + lg::direct(lg::Plain, g, 2).to_string() + " " + lg::direct(lg::Solid(9), g, 2).to_string())
  io_println(world, "anon " + lg::anon(true, g, 2).to_string() + " " + lg::anon(false, g, 2).to_string())
  io_println(world, "box " + lg::generic_box(true, b, 5).to_string() + " " + lg::generic_box(false, b, 5).to_string())
  let (s, a) = lg::mono("s", true, g, 2)
  let (n, c) = lg::mono(4, false, g, 2)
  io_println(world, "mono " + s + " " + a.to_string() + " " + n.to_string() + " " + c.to_string())
  io_println(world, "small " + lg::small(true, 4).to_string() + " " + lg::small(false, 4).to_string())
  let (r, d) = mid::relay("r", true, 2)
  io_println(world, "mid " + mid::run_match(1, 2).to_string() + " " + r + " " + d.to_string())
  io_println(world, "pick " + pick(0, g, 2).to_string() + " " + pick(1, g, 2).to_string() + " " + pick(2, g, 2).to_string())
  io_println(world, "other " + other_pick(true, 3).to_string() + " " + other_pick(false, 3).to_string())
  0
}
