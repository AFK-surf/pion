import "paint"

pub enum Mode {
  Plain
  Solid(Int)
}

fn sf() -> Int {
  7
}

// `match` whose first arm is a qualified literal with a spread base.
pub fn by_match(m : Mode, base : paint::Glass, k : Int) -> Int {
  let resolved = match m {
    Plain => paint::Glass::{ ..base, solid: sf() }
    Solid(s) => paint::Glass::{ ..base, solid: s }
  }
  resolved.at_strength(k)
}

pub fn by_if(on : Bool, k : Int) -> Int {
  let resolved = if on {
    paint::Glass::{ blur: 3, solid: 4 }
  } else {
    paint::Glass::{ blur: 5, solid: 6 }
  }
  resolved.at_strength(k)
}

// Method call directly on the `match`, and a chained method.
pub fn direct(m : Mode, base : paint::Glass, k : Int) -> Int {
  let wide = match m {
    Plain => paint::Glass::{ ..base, blur: 1 }
    Solid(s) => paint::Glass::{ ..base, blur: s }
  }.wider(2)
  wide.at_strength(k)
}

pub fn anon(on : Bool, base : paint::Glass, k : Int) -> Int {
  let resolved = if on { { ..base, solid: 11 } } else { { ..base, solid: 12 } }
  resolved.at_strength(k)
}

pub fn generic_box(on : Bool, b : paint::Box[String], k : Int) -> Int {
  let resolved = if on {
    paint::Box::{ ..b, count: 2 }
  } else {
    paint::Box::{ ..b, count: 3 }
  }
  resolved.total(k)
}

// Generic: instantiated in the caller's package, where `paint` is not this alias.
pub fn mono[T](v : T, on : Bool, base : paint::Glass, k : Int) -> (T, Int) {
  let resolved = match on {
    true => paint::Glass::{ ..base, solid: 20 }
    false => paint::Glass::{ ..base, solid: 30 }
  }
  (v, resolved.at_strength(k))
}

fn dead(m : Mode, base : paint::Glass, k : Int) -> Int {
  let resolved = match m {
    Plain => paint::Glass::{ ..base, solid: sf() }
    Solid(s) => paint::Glass::{ ..base, solid: s }
  }
  resolved.at_strength(k)
}

pub fn small(on : Bool, k : Int) -> Int {
  (if on { paint::Glass::{ blur: 2, solid: 1 } } else { paint::Glass::{ blur: 1, solid: 2 } }).at_strength(k)
}

pub fn plain() -> paint::Glass {
  paint::glass(10, 5)
}

pub struct Slab {
  depth : Int
}

pub fn Slab::area(self : Slab, k : Int) -> Int {
  self.depth * k
}

// Unqualified literal of this package inside a generic instantiated elsewhere.
pub fn slab[T](v : T, on : Bool, k : Int) -> (T, Int) {
  let resolved = if on { Slab::{ depth: 3 } } else { Slab::{ depth: 4 } }
  (v, resolved.area(k))
}
