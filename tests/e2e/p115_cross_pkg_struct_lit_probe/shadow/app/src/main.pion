import "lg"
import "paint"

pub fn main(world : World) -> Int {
  let (_, a) = lg::mono("s", true, 2)
  let (_, b) = lg::mono(1, false, 2)
  let (_, c) = lg::spread(1, 2)
  let g = paint::Glass::{ blur: 1, solid: 1 }
  let (_, d) = lg::boxes(1, true, 2)
  let (_, e) = lg::fresh(1, 2)
  let (_, f) = lg::annotated(1, 2)
  let (_, h) = lg::kinds(1, true)
  let (_, i) = lg::kinds(1, false)
  let k : paint::Kind = paint::Kind::Line(1)
  io_println(world, "\{a} \{b} \{c} \{d} \{e} \{f} \{h} \{i} \{k.num()} \{g.at_strength(2)}")
  0
}
