import "paint"

pub fn mono[T](v : T, on : Bool, k : Int) -> (T, Int) {
  let resolved = if on {
    paint::Glass::{ blur: 1, solid: 2 }
  } else {
    paint::Glass::{ blur: 3, solid: 4 }
  }
  (v, resolved.at_strength(k))
}

pub fn spread[T](v : T, k : Int) -> (T, Int) {
  let base = paint::glass(5)
  let g = paint::Glass::{ ..base, solid: 1 }
  (v, g.at_strength(k))
}

pub fn boxes[T](v : T, on : Bool, k : Int) -> (T, Int) {
  let b = paint::boxed("b")
  let resolved = if on { paint::Box::{ ..b, count: 2 } } else { paint::Box::{ ..b, count: 3 } }
  (v, resolved.total(k))
}

pub fn fresh[T](v : T, k : Int) -> (T, Int) {
  (v, paint::Glass::fresh(6).at_strength(k))
}

pub fn annotated[T](v : T, k : Int) -> (T, Int) {
  let g : paint::Glass = { blur: 7, solid: 1 }
  (v, g.at_strength(k))
}
