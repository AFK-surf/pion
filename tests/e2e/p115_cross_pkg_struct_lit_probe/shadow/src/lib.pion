pub struct Glass {
  blur : Int
  solid : Int
}

pub fn Glass::at_strength(self : Glass, k : Int) -> Int {
  1000 + self.blur * k + self.solid
}

pub fn glass(blur : Int) -> Glass {
  Glass::{ blur: blur, solid: 0 }
}

pub fn Glass::fresh(blur : Int) -> Glass {
  glass(blur)
}

pub struct Box[T] {
  value : T
  count : Int
}

pub fn boxed[T](value : T) -> Box[T] {
  Box::{ value: value, count: 1 }
}

pub fn Box::total[T](self : Box[T], k : Int) -> Int {
  1000 + self.count * k
}

pub enum Kind {
  Dot
  Line(Int)
}

pub fn Kind::num(self : Kind) -> Int {
  match self {
    Dot => 1000
    Line(n) => 1000 + n
  }
}

pub struct Flip {
  n : Int
}

pub struct RootOnly {
  n : Int
}

pub enum RootKind {
  Root
}
