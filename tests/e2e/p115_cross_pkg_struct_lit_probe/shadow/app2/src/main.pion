import "paint"
import "rootp"

fn pick(on : Bool) -> Int {
  let g : paint::Glass = paint::glass(2)
  let resolved = if on { paint::Glass::{ ..g, solid: 1 } } else { g }
  resolved.at_strength(2)
}

pub fn main(world : World) -> Int {
  let r = rootp::Glass::{ blur: 1, solid: 1 }
  io_println(world, "\{pick(true)} \{pick(false)} \{paint::Glass::fresh(6).at_strength(2)} \{r.at_strength(2)}")
  0
}
