import "paint"
import "rootp"

fn pick(on : Bool) -> Int {
  let g : paint::Glass = paint::glass(2)
  let resolved = if on { paint::Glass::{ ..g, solid: 1 } } else { g }
  resolved.at_strength(2)
}

fn kind(on : Bool) -> Int {
  (if on { paint::Kind::Dot } else { paint::Kind::Line(3) }).num()
}

pub fn main(world : World) -> Int {
  let r = rootp::Glass::{ blur: 1, solid: 1 }
  let x : paint::Flip = paint::green()
  let k : paint::Kind = paint::Kind::Line(4)
  let rk : rootp::Kind = rootp::Kind::Dot
  let rf : rootp::Flip = rootp::Flip::{ n: 8 }
  io_println(world, "\{pick(true)} \{pick(false)} \{paint::Glass::fresh(6).at_strength(2)} \{r.at_strength(2)} \{x.num()} \{paint::Flip::Green.num()} \{kind(true)} \{kind(false)} \{k.num()} \{rk.num()} \{rf.n}")
  0
}
