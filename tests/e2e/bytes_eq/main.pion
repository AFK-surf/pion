// `Bytes` / `BytesView` value equality: `==` / `!=` compare length + content
// (never `Bytes` capacity), and the built-in `Eq` bound reaches `Option`,
// `Result`, tuples, arrays, `#derive(Eq)` types and generic `[T : Eq]`.

#derive(Eq)
struct Packet {
  id : Int
  body : Bytes
}

#derive(Eq)
struct Window {
  tag : Int
  data : BytesView
}

#derive(Eq)
enum Frame {
  Empty
  Data(Bytes)
  Pair(Int, Bytes)
}

fn eq_any[T : Eq](a : T, b : T) -> Bool {
  a == b
}

fn ne_any[T : Eq](a : T, b : T) -> Bool {
  a != b
}

fn bytes_of(s : String) -> Bytes {
  s.to_bytes()
}

fn mark(sb : StringBuilder, ok : Bool) -> Unit {
  sb.write_string(if ok { "1" } else { "0" })
}

fn view_checks(sb : StringBuilder) -> Unit {
  let a = bytes_of("hello world")
  let b = bytes_of("xhello worldx")
  // stack-allocated zero-copy views consumed directly by `==` / `!=`
  let va = a.as_view()
  let vb = b.view(1, 12)
  mark(sb, va == vb)
  mark(sb, !(va != vb))
  let w1 = a.view(0, 5)
  let w2 = b.view(1, 6)
  mark(sb, w1 == w2)
  // same owner, different offsets, same bytes
  let rep = bytes_of("abab")
  let r1 = rep.view(0, 2)
  let r2 = rep.view(2, 4)
  mark(sb, r1 == r2)
  // same owner, different offsets, different bytes
  let r3 = rep.view(1, 3)
  mark(sb, r1 != r3)
  // different lengths
  mark(sb, a.view(0, 4) != a.view(0, 5))
  // empty views (over empty and non-empty owners)
  let e = Bytes::new(0)
  mark(sb, e.as_view() == a.view(3, 3))
  mark(sb, a.view(0, 0) == b.view(5, 5))
  // subview
  mark(sb, va.subview(6, 11) == vb.subview(6, 11))
  mark(sb, va.subview(0, 5) != vb.subview(6, 11))
  // generic + Option[BytesView]
  mark(sb, eq_any(va, vb))
  mark(sb, ne_any(w1, r1))
  let o1 : Option[BytesView] = Some(a.view(6, 11))
  let o2 : Option[BytesView] = Some(b.view(7, 12))
  let o3 : Option[BytesView] = None
  mark(sb, o1 == o2)
  mark(sb, o1 != o3)
  mark(sb, eq_any(o1, o2))
  let w = Window::{ tag: 1, data: a.view(0, 5) }
  let wb = Window::{ tag: 1, data: b.view(1, 6) }
  let wc = Window::{ tag: 1, data: b.view(2, 7) }
  mark(sb, w == wb)
  mark(sb, w != wc)
  // containers of views
  let views = [a.view(0, 5), a.view(6, 11), e.as_view()]
  mark(sb, views.contains(b.view(7, 12)))
  mark(sb, views.contains(b.view(4, 4)))
  mark(sb, !views.contains(b.view(0, 5)))
  mark(sb, views == [b.view(1, 6), b.view(7, 12), a.view(2, 2)])
  let rv1 : Result[BytesView, Int] = Ok(a.view(0, 5))
  let rv2 : Result[BytesView, Int] = Ok(b.view(1, 6))
  mark(sb, rv1 == rv2)
  mark(sb, (a.view(0, 1), 2) != (b.view(0, 1), 2))
}

fn bytes_checks(sb : StringBuilder) -> Unit {
  // empty Bytes with different capacities
  let e0 = Bytes::new(0)
  let e1 = Bytes::new(0)
  let e16 = Bytes::new(16).slice(0, 0)
  mark(sb, e0 == e1)
  mark(sb, e0 == e16)
  mark(sb, e16 == e0)
  // same content, different objects / capacities
  let a = bytes_of("pion")
  let b = bytes_of("xpionx").slice(1, 5)
  let c = bytes_of("pi").concat(bytes_of("on"))
  mark(sb, a == b)
  mark(sb, a == c)
  mark(sb, !(a != b))
  mark(sb, a == a)
  // same length, different first / middle / last byte
  mark(sb, a != bytes_of("xion"))
  mark(sb, a != bytes_of("pxon"))
  mark(sb, a != bytes_of("piox"))
  // different lengths, including a prefix
  mark(sb, a != bytes_of("pio"))
  mark(sb, a != bytes_of("pions"))
  mark(sb, a != e0)
  mark(sb, e0 != a)
  // mutation flips equality
  let m = bytes_of("pion")
  mark(sb, m == a)
  m[3] = b'x'
  mark(sb, m != a)
  m[3] = b'n'
  mark(sb, m == a)
  // zero bytes inside content
  let z1 = Bytes::new(8)
  let z2 = Bytes::new(8)
  mark(sb, z1 == z2)
  z2[7] = b'\x01'
  mark(sb, z1 != z2)
  // Option[Bytes]
  let n1 : Option[Bytes] = None
  let n2 : Option[Bytes] = None
  let se : Option[Bytes] = Some(Bytes::new(0))
  let sa : Option[Bytes] = Some(bytes_of("pion"))
  let sb2 : Option[Bytes] = Some(c)
  let sx : Option[Bytes] = Some(bytes_of("piox"))
  mark(sb, n1 == n2)
  mark(sb, n1 != se)
  mark(sb, se != n1)
  mark(sb, sa == sb2)
  mark(sb, sa != sx)
  mark(sb, eq_any(sa, sb2))
  mark(sb, ne_any(sa, sx))
  // Result[Bytes, Int]
  let ra : Result[Bytes, Int] = Ok(bytes_of("ok"))
  let rb : Result[Bytes, Int] = Ok(bytes_of("ok"))
  let rc : Result[Bytes, Int] = Err(1)
  let rd : Result[Bytes, Int] = Ok(bytes_of("no"))
  mark(sb, ra == rb)
  mark(sb, ra != rc)
  mark(sb, ra != rd)
  // tuples
  mark(sb, (1, bytes_of("t")) == (1, bytes_of("t")))
  mark(sb, (1, bytes_of("t")) != (2, bytes_of("t")))
  // Array / FixedArray / ImmArray of Bytes
  let arr = [bytes_of("aa"), bytes_of("bb"), Bytes::new(0)]
  let arr2 = [bytes_of("aa"), bytes_of("b").concat(bytes_of("b")), Bytes::new(0)]
  mark(sb, arr == arr2)
  mark(sb, arr.contains(bytes_of("bb")))
  mark(sb, arr.contains(Bytes::new(4).slice(0, 0)))
  mark(sb, !arr.contains(bytes_of("cc")))
  arr2[1][0] = b'c'
  mark(sb, arr != arr2)
  let fa : FixedArray[Bytes] = FixedArray::make(2, Bytes::new(0))
  let fb : FixedArray[Bytes] = FixedArray::make(2, Bytes::new(0))
  mark(sb, fa == fb)
  let ia : ImmArray[Bytes] = [bytes_of("i")]
  let ib : ImmArray[Bytes] = [bytes_of("i")]
  mark(sb, ia == ib)
  // #derive(Eq) struct / enum with Bytes fields
  let p1 = Packet::{ id: 7, body: bytes_of("body") }
  let p2 = Packet::{ id: 7, body: bytes_of("xbody").slice(1, 5) }
  let p3 = Packet::{ id: 7, body: bytes_of("bodY") }
  mark(sb, p1 == p2)
  mark(sb, p1 != p3)
  mark(sb, eq_any(p1, p2))
  let f1 = Frame::Data(bytes_of("f"))
  let f2 = Frame::Data(bytes_of("f"))
  let f3 = Frame::Pair(1, bytes_of("f"))
  mark(sb, f1 == f2)
  mark(sb, f1 != f3)
  mark(sb, Frame::Empty != f1)
  mark(sb, f3 == Frame::Pair(1, bytes_of("f")))
  // generic over plain Bytes
  mark(sb, eq_any(a, c))
  mark(sb, ne_any(a, e0))
  mark(sb, eq_any(e0, e16))
}

// `Array[StrView]` membership compares view content, not view identity.
fn strview_checks(sb : StringBuilder) -> Unit {
  let s = "hello world"
  let t = "xhello worldx"
  let vs = [s.view(0, 5), s.view(6, 11)]
  mark(sb, vs.contains(t.view(1, 6)))
  mark(sb, vs.contains(t.view(7, 12)))
  mark(sb, !vs.contains(t.view(0, 5)))
  mark(sb, vs == [t.view(1, 6), t.view(7, 12)])
}

pub fn main(world : World) -> Int {
  let sb = StringBuilder::new()
  bytes_checks(sb)
  sb.write_string(" ")
  view_checks(sb)
  sb.write_string(" ")
  strview_checks(sb)
  let out = sb.to_string()
  io_println(world, out)
  if out.contains("0") { 1 } else { 0 }
}
