// Round 232: an untyped tuple array literal passed straight to a generic
// `Array[(K, V)]` parameter must monomorphize the callee (`K = Int, V = Int`)
// instead of writing erased 8-byte slots the caller reads as 4-byte `Int`s.

struct Box[K, V] {
  keys : Array[K]
  vals : Array[V]
}

fn mk[K, V](ps : Array[(K, V)]) -> Box[K, V] {
  let keys : Array[K] = []
  let vals : Array[V] = []
  for p in ps {
    keys.push(p.0)
    vals.push(p.1)
  }
  Box::{ keys, vals }
}

fn Box::from_array[K, V](ps : Array[(K, V)]) -> Box[K, V] {
  mk(ps)
}

fn Box::add_all[K, V](self : Box[K, V], ps : Array[(K, V)]) -> Unit {
  for p in ps {
    self.keys.push(p.0)
    self.vals.push(p.1)
  }
}

fn Box::size[K, V](self : Box[K, V]) -> Int {
  self.keys.length()
}

fn show_ii(b : Box[Int, Int]) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < b.keys.length() {
    parts.push(b.keys[i].to_string() + "=" + b.vals[i].to_string())
    i = i + 1
  }
  parts.join(",")
}

fn show_is(b : Box[Int, String]) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < b.keys.length() {
    parts.push(b.keys[i].to_string() + "=" + b.vals[i])
    i = i + 1
  }
  parts.join(",")
}

fn sum_ii(b : Box[Int, Int]) -> Int {
  let mut s = 0
  let mut i = 0
  while i < b.keys.length() {
    s = s + b.keys[i] * 100 + b.vals[i]
    i = i + 1
  }
  s
}

// The caller's own type parameter is also named `K`.
fn same_name[K](x : K) -> Int {
  let b1 = mk([(1, 10), (2, 20)])
  let b2 = mk([(x, 10)])
  let mut s = b2.size() + b2.vals[0]
  for i, k in b1.keys {
    s = s + k * 100 + b1.vals[i]
  }
  s
}

// Reads the untyped result directly (no `Box[Int, Int]` parameter to steer
// monomorphization): this is the shape that used to print `1=10, 0=0, 2=20`.
fn direct() -> String {
  let b = mk([(1, 10), (2, 20), (1, 30)])
  let parts : Array[String] = []
  for i, k in b.keys {
    parts.push("\{k}=\{b.vals[i]}")
  }
  let h = mk([(1, "a"), (2, "b")])
  for i, k in h.keys {
    parts.push(k.to_string() + "=" + h.vals[i])
  }
  parts.join(",")
}

pub fn main(world : World) -> Int {
  let b1 = mk([(1, 10), (2, 20), (1, 30)])
  let b2 : Box[Int, Int] = mk([(1, 10), (2, 20), (1, 30)])
  let s1 = show_ii(b1)
  let s2 = show_ii(b2)
  let chain = sum_ii(mk([(1, 10), (2, 20), (1, 30)]))
  let piped = [(1, 10), (2, 20), (1, 30)] |> mk |> show_ii
  let assoc = show_ii(Box::from_array([(1, 10), (2, 20), (1, 30)]))
  let b3 = mk([(7, 70)])
  b3.add_all([(8, 80), (9, 90)])
  let meth = show_ii(b3)
  let same = same_name("k")
  let heap = show_is(mk([(1, "a"), (2, "b")]))
  let heap2 = show_is(Box::from_array([(3, "c" + "d"), (4, "e")]))
  let dir = direct()
  io_println(
    world,
    "b1=" + s1 + " b2=" + s2 + " chain=" + chain.to_string() + " pipe=" + piped +
    " assoc=" + assoc + " meth=" + meth + " same=" + same.to_string() + " heap=" + heap +
    " heap2=" + heap2 + " direct=" + dir,
  )
  if s1 == s2 { 0 } else { 1 }
}
