struct Scalar2 {
  x : Int
  y : Int
}

struct Meta {
  code : Int
  label : String
}

struct Record {
  id : Int
  name : String
  tags : Array[Int]
  opt : Option[String]
  meta : Meta
}

struct Holder {
  scalars : Array[Scalar2]
  records : Array[Record]
  fixed : FixedArray[Scalar2]
  imm : ImmArray[Scalar2]
}

struct Pair[A, B] {
  first : A
  second : B
}

struct SingleField {
  only : String
}

struct Wide7 {
  f0 : Int
  f1 : Int
  f2 : Int
  f3 : Int
  f4 : Int
  f5 : Int
  f6 : String
}

struct MutBox {
  mut count : Int
  mut label : String
}

fn make_scalars(base : Int) -> Array[Scalar2] {
  [
    Scalar2::{ x: base + 1, y: base + 10 },
    Scalar2::{ x: base + 2, y: base + 20 },
    Scalar2::{ x: base + 3, y: base + 30 },
  ]
}

fn make_records(tag : String) -> Array[Record] {
  [
    Record::{
      id: 10,
      name: tag + "_zero",
      tags: [1, 2, 3],
      opt: Some(tag + "_opt0"),
      meta: Meta::{ code: 100, label: tag + "_m0" },
    },
    Record::{
      id: 20,
      name: tag + "_one",
      tags: [4, 5],
      opt: None,
      meta: Meta::{ code: 200, label: tag + "_m1" },
    },
  ]
}

fn proj_holder_scalar(h : Holder, i : Int) -> Int {
  h.scalars[i].x + h.scalars[i].y
}

fn proj_holder_name(h : Holder, i : Int) -> String {
  h.records[i].name
}

fn proj_owned_branch_scalar(a : Array[Scalar2], b : Array[Scalar2], pick : Bool, i : Int) -> Int {
  (if pick { a } else { b })[i].y
}

fn proj_owned_branch_name(a : Array[Record], b : Array[Record], pick : Bool, i : Int) -> String {
  (if pick { a } else { b })[i].name
}

fn proj_owned_scalar(base : Int, i : Int) -> Int {
  make_scalars(base)[i].y
}

fn proj_owned_name(tag : String, i : Int) -> String {
  make_records(tag)[i].name
}

fn proj_owned_tags(tag : String, i : Int) -> Array[Int] {
  make_records(tag)[i].tags
}

fn proj_owned_opt(tag : String, i : Int) -> Option[String] {
  make_records(tag)[i].opt
}

fn proj_owned_meta(tag : String, i : Int) -> Meta {
  make_records(tag)[i].meta
}

fn proj_matrix_y(mat : Array[Array[Scalar2]], r : Int, c : Int) -> Int {
  mat[r][c].y
}

fn proj_fixed_imm(h : Holder, i : Int) -> Int {
  h.fixed[i].x * 100 + h.imm[i].y
}

fn tick(mut counter : Int) -> Int {
  let cur = counter
  counter = counter + 1
  cur
}

fn push_and_return_idx(arr : Array[Record], mut counter : Int) -> Int {
  let cur = counter
  counter = counter + 1
  let mut k = 0
  while k < 32 {
    arr.push(
      Record::{
        id: 1000 + k,
        name: "pushed_" + k.to_string(),
        tags: [k],
        opt: None,
        meta: Meta::{ code: k, label: "pm" },
      },
    )
    k = k + 1
  }
  cur
}

fn bump(mut v : Int) -> Unit {
  v = v + 7
}

fn early_return_test(h : Holder, i : Int, early : Bool) -> String {
  let s = h.records[i].name
  if early {
    return s + ":early"
  }
  let s2 = make_records("tmp")[i].name
  s + "+" + s2
}

fn maybe_err(fail : Bool) -> Result[Int, String] {
  if fail {
    Err("boom")
  } else {
    Ok(1)
  }
}

fn try_early_exit(h : Holder, i : Int, fail : Bool) -> Result[String, String] {
  let a = h.records[i].name
  let b = make_records("try")[i].name
  let _ = maybe_err(fail)?
  Ok(a + "|" + b)
}

fn pair_first(xs : Array[Pair[String, Array[Int]]], i : Int) -> String {
  xs[i].first
}

fn pair_second(xs : Array[Pair[String, Array[Int]]], i : Int) -> Array[Int] {
  xs[i].second
}

fn main(w : World) -> Unit {
  let h = Holder::{
    scalars: make_scalars(5),
    records: make_records("h"),
    fixed: [Scalar2::{ x: 3, y: 4 }, Scalar2::{ x: 7, y: 8 }],
    imm: [Scalar2::{ x: 11, y: 12 }, Scalar2::{ x: 15, y: 16 }],
  }

  // 1. Scalar & heap fields via struct-field array & owned temp array
  let s_branch = proj_owned_branch_scalar(h.scalars, make_scalars(20), true, 1)
  let n_branch = proj_owned_branch_name(h.records, make_records("alt"), false, 0)
  io_println(w, "scalar=" + proj_holder_scalar(h, 1).to_string() + "," + proj_owned_scalar(10, 2).to_string() + "," + s_branch.to_string() + "," + n_branch)
  io_println(w, "fixed_imm=" + proj_fixed_imm(h, 0).to_string() + "," + proj_fixed_imm(h, 1).to_string())

  let mat : Array[Array[Scalar2]] = [make_scalars(1), make_scalars(100)]
  io_println(w, "mat=" + proj_matrix_y(mat, 1, 2).to_string())

  let n0 = proj_holder_name(h, 0)
  let on1 = proj_owned_name("own", 1)
  let otags = proj_owned_tags("own", 0)
  let oopt = proj_owned_opt("own", 0)
  let ometa = proj_owned_meta("own", 1)
  let opt_s = match oopt {
    Some(v) => v
    None => "none"
  }
  io_println(w, "heap=" + n0 + "," + on1 + "," + otags.length().to_string() + "," + opt_s + "," + ometa.code.to_string() + ":" + ometa.label)

  // 2. Mutation / overwrite / reallocation after projection must not corrupt extracted heap fields
  let mut_recs = make_records("mut")
  let saved_name = mut_recs[0].name
  let saved_tags = mut_recs[0].tags
  let saved_meta = mut_recs[0].meta
  mut_recs[0] = Record::{
    id: 99,
    name: "replaced",
    tags: [9],
    opt: None,
    meta: Meta::{ code: 999, label: "rep" },
  }
  let mut k = 0
  while k < 40 {
    mut_recs.push(
      Record::{
        id: k,
        name: "grow_" + k.to_string(),
        tags: [k],
        opt: Some("g"),
        meta: Meta::{ code: k, label: "gm" },
      },
    )
    k = k + 1
  }
  mut_recs.clear()
  io_println(w, "after_clear=" + saved_name + "," + saved_tags[1].to_string() + "," + saved_meta.label)

  // 3. Early return and ? early exit RC balance
  let er1 = early_return_test(h, 0, true)
  let er2 = early_return_test(h, 1, false)
  let te1 = match try_early_exit(h, 0, true) {
    Ok(v) => v
    Err(e) => "err:" + e
  }
  let te2 = match try_early_exit(h, 1, false) {
    Ok(v) => v
    Err(e) => "err:" + e
  }
  io_println(w, "early=" + er1 + ";" + er2 + ";" + te1 + ";" + te2)

  // 4. Side-effecting index (evaluated exactly once) + reallocating index
  let mut idx = 0
  let s_a = h.scalars[tick(mut idx)].x
  let s_b = h.records[tick(mut idx)].name
  let arr_se = make_records("se")
  let mut idx2 = 0
  let se_name = arr_se[push_and_return_idx(arr_se, mut idx2)].name
  io_println(w, "side=" + s_a.to_string() + "," + s_b + ",idx=" + idx.to_string() + ",se=" + se_name + ",idx2=" + idx2.to_string() + ",len=" + arr_se.length().to_string())

  // 5. Nested field access & multi-field expressions
  let nested = h.records[0].meta.label + "/" + make_records("n")[1].meta.code.to_string()
  let multi = (h.records[0].id + h.records[1].meta.code).to_string() + "/" + h.records[0].name + ":" + h.records[1].meta.label
  io_println(w, "nested=" + nested + ";multi=" + multi)

  // 6. Mutable struct writeback & mut field arg (non-flat, unaffected)
  let mut mboxes : Array[MutBox] = [
    MutBox::{ count: 10, label: "a" },
    MutBox::{ count: 20, label: "b" },
  ]
  mboxes[0].count = mboxes[0].count + 5
  bump(mut mboxes[1].count)
  mboxes[0].label = mboxes[0].label + "!"
  io_println(w, "mut=" + mboxes[0].count.to_string() + ":" + mboxes[0].label + "," + mboxes[1].count.to_string())

  // 7. Generic flat struct + non-flat fallbacks (1-field, 7-field, Map)
  let pairs : Array[Pair[String, Array[Int]]] = [
    Pair::{ first: "p0", second: [7, 8] },
    Pair::{ first: "p1", second: [9] },
  ]
  let gf = pair_first(pairs, 1)
  let gs = pair_second(pairs, 0)
  let singles : Array[SingleField] = [SingleField::{ only: "solo" }]
  let wides : Array[Wide7] = [
    Wide7::{ f0: 1, f1: 2, f2: 3, f3: 4, f4: 5, f5: 6, f6: "wide" },
  ]
  let rmap : Map[String, Record] = Map([("k", make_records("m")[0])])
  io_println(w, "misc=" + gf + "," + gs[1].to_string() + "," + singles[0].only + "," + wides[0].f6 + "," + rmap["k"].name)
}
