import "helper" as h

let CONST_INTS : Array[Int] = [10, 20, 30, 40]
let CONST_STRS : Array[String] = ["alpha", "beta", "gamma"]

fn local_cmp(a : String, b : String) -> Int {
  a.length() + b.length()
}

fn local_inc(x : Int) -> Int {
  x + 10
}

fn run_cmp(f : (String, String) -> Int, a : String, b : String) -> Int {
  f(a, b)
}

fn run_unary(f : (Int) -> Int, x : Int) -> Int {
  f(x)
}

fn clone_arr[T](xs : Array[T]) -> Array[T] {
  let out : Array[T] = []
  let mut i = 0
  while i < xs.length() {
    out.push(xs[i])
    i = i + 1
  }
  out
}

fn make_map[T](k : String, v : T) -> Map[String, T] {
  let m : Map[String, T] = Map()
  m.set(k, v)
  m
}

fn test_bug1_mt_const(world : World) -> Int {
  let acc = AtomicInt::new(0)
  scope(world, fn(s : Scope) -> Unit {
    for t in 0..4 {
      spawn(s, fn() -> Unit {
        let mut local_sum = 0
        let mut iter = 0
        while iter < 1000 {
          let iv = CONST_INTS[(iter + t) % CONST_INTS.length()]
          let sv = CONST_STRS[(iter + t) % CONST_STRS.length()]
          local_sum = local_sum + iv + sv.length()
          iter = iter + 1
        }
        let _ = acc.fetch_add(local_sum)
      })
    }
  })
  acc.load()
}

fn test_bug2_empty_branch(cond : Bool, k : Int) -> Int {
  let xs = if cond { [] } else { ["a", "b"] }
  xs.push("hello" + "_world")
  xs.push("foo" + "_bar")
  let ys = match k {
    0 => []
    _ => ["x", "y"]
  }
  ys.push("baz" + "_qux")
  xs.length() + ys.length() + xs[0].length() + ys[0].length()
}

fn test_bug3_generic_containers() -> Int {
  let strs : Array[String] = ["s" + "_1", "s" + "_22", "s" + "_333"]
  let cstrs = clone_arr(strs)
  cstrs.push("s" + "_4444")
  let ints : Array[Int] = [1, 2, 3]
  let cints = clone_arr(ints)
  cints.push(4)
  let ms = make_map("k", "val" + "_dyn")
  let mi = make_map("n", 99)
  let slen = match ms.get("k") {
    Some(v) => v.length()
    None => 0
  }
  let ival = match mi.get("n") {
    Some(v) => v
    None => 0
  }
  cstrs.length() + cstrs[3].length() + cints.length() + cints[3] + slen + ival
}

fn test_bug4_bare_fn_closures() -> Int {
  let a = run_cmp(local_cmp, "hi" + "!", "yo")
  let b = run_unary(local_inc, 5)
  let c = run_cmp(h::cmp_str, "hello" + "!", "hi")
  let d = run_unary(h::add_one, 41)
  a + b + c + d
}

fn make_res(ok : Bool) -> Result[Int, String] {
  if ok {
    Ok(77)
  } else {
    Err("fail")
  }
}

struct Box[T] {
  item : T
}

enum MaybeBox[T] {
  MBVal(T)
  MBEmpty
}

fn wrap_ok[T](v : T) -> Result[T, String] {
  Ok(v)
}

fn wrap_err[E](e : E) -> Result[Int, E] {
  Err(e)
}

fn wrap_some[T](v : T) -> Option[T] {
  Some(v)
}

fn wrap_box[T](v : T) -> Box[T] {
  Box::{ item: v }
}

fn wrap_enum[T](v : T) -> MaybeBox[T] {
  MBVal(v)
}

fn wrap_pair[T](v : T) -> (T, Int) {
  (v, 7)
}

fn try_unwrap_arr(i : Int) -> Result[Int, String] {
  let arr : Array[String] = ["row_" + i.to_string(), "val_" + i.to_string()]
  let unwrapped = wrap_ok(arr)?
  let m : Map[String, String] = Map()
  m.set("k", "v_" + i.to_string())
  let unwrapped_m = wrap_ok(m)?
  Ok(unwrapped.length() + unwrapped_m.length())
}

fn test_bug6_generic_drop() -> Int {
  let mut total = 0
  let mut i = 0
  while i < 200 {
    let r_arr = match try_unwrap_arr(i) {
      Ok(n) => n
      Err(_) => 0
    }
    let r_int = match wrap_ok(i) {
      Ok(v) => v
      Err(_) => 0
    }
    let r_err_s = match wrap_err("err_" + i.to_string()) {
      Ok(v) => v
      Err(e) => e.length()
    }
    let r_err_i = match wrap_err(i) {
      Ok(v) => v
      Err(e) => e
    }
    let r_some_s = match wrap_some("opt_" + i.to_string()) {
      Some(s) => s.length()
      None => 0
    }
    let r_some_i = match wrap_some(i) {
      Some(v) => v
      None => 0
    }
    let bs = wrap_box("box_" + i.to_string())
    let bi = wrap_box(i)
    let es = wrap_enum("enum_" + i.to_string())
    let ei = wrap_enum(i)
    let es_len = match es {
      MBVal(s) => s.length()
      MBEmpty => 0
    }
    let ei_val = match ei {
      MBVal(v) => v
      MBEmpty => 0
    }
    let (ps, pn) = wrap_pair("pair_" + i.to_string())
    let (pi, pn2) = wrap_pair(i)
    total = total + r_arr + r_int + r_err_s + r_err_i + r_some_s + r_some_i + bs.item.length() + bi.item + es_len + ei_val + ps.length() + pn + pi + pn2
    i = i + 1
  }
  total
}

test "bug5 early return in match inside test block" {
  let a = match make_res(true) {
    Ok(v) => v
    Err(_) => {
      return
    }
  }
  debug_assert(a == 77, "expected 77")
  let b = match make_res(false) {
    Ok(v) => v
    Err(_) => {
      return
    }
  }
  debug_assert(b == -1, "unreachable after early return")
}

enum ShadowEnum {
  SArr(Array[String])
  SEmpty
}

fn test_bug2_probe_shadowing() -> Int {
  let x : ShadowEnum = ShadowEnum::SArr(["a" + "_1", "b" + "_2"])
  let out = match x {
    ShadowEnum::SArr(x) => x
    _ => []
  }
  out.push("c" + "_3")
  let empty_x : ShadowEnum = ShadowEnum::SEmpty
  let out2 = match empty_x {
    ShadowEnum::SEmpty => []
    ShadowEnum::SArr(x) => x
  }
  out2.push("d" + "_4")
  let cond = true
  let y = 10
  let out3 = if cond {
    []
  } else {
    let y : Array[String] = ["e" + "_5"]
    y
  }
  out3.push("f" + "_6")
  out.length() + out2.length() + out2[0].length() + out3.length() + out3[0].length() + y
}

pub fn main(world : World) -> Int {
  let r1 = test_bug1_mt_const(world)
  let r2 = test_bug2_empty_branch(true, 0)
  let r2s = test_bug2_probe_shadowing()
  let r3 = test_bug3_generic_containers()
  let r4 = test_bug4_bare_fn_closures()
  let r6 = test_bug6_generic_drop()
  io_println(
    world,
    "p24a ok r1=" + r1.to_string() + " r2=" + r2.to_string() + " r2s=" + r2s.to_string() + " r3=" + r3.to_string() + " r4=" + r4.to_string() + " r6=" + r6.to_string(),
  )
  0
}
