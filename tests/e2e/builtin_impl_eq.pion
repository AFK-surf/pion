// End-to-end runtime test for built-in `impl Eq` (Native + Wasm32)

struct K {
  id : Int
  hits : Array[Int]
}

impl Eq for K {
  fn equal(self : K, other : K) -> Bool {
    let _ = self.id
    let _ = other.id
    self.hits[0] = self.hits[0] + 1
    false
  }
}

#derive(Eq)
struct WrapK {
  first : Int
  k : K
}

#derive(Eq)
struct ShortCircuitBox {
  a : K
  b : K
}

enum Color {
  Red
  Green
  Blue
}

impl Eq for Color {
  fn equal(a : Color, b : Color) -> Bool {
    match (a, b) {
      (Red, Red) | (Red, Green) | (Green, Red) | (Green, Green) => true
      _ => false
    }
  }
}

#derive(Eq)
struct ColorWrap {
  c : Color
}

// 2-field immutable POD struct -> stored flat inline in Array/FixedArray/ImmArray
struct FlatPair {
  a : Int
  b : Int
}

impl Eq for FlatPair {
  fn equal(x : FlatPair, y : FlatPair) -> Bool {
    x.a == y.a
  }
}

// Struct with closure field (Picked pattern)
struct Picked {
  tag : Int
  cb : () -> Int
}

impl Eq for Picked {
  fn equal(a : Picked, b : Picked) -> Bool {
    a.tag == b.tag
  }
}

// Identity-based Transition pattern
struct Transition {
  id : Int
}

impl Eq for Transition {
  fn equal(a : Transition, b : Transition) -> Bool {
    physical_equal(a, b)
  }
}

// Generic unconstrained impl Eq (TheseItems[T] with physical_equal)
struct TheseItems[T] {
  item : T
}

impl[T] Eq for TheseItems[T] {
  fn equal(a : TheseItems[T], b : TheseItems[T]) -> Bool {
    physical_equal(a, b)
  }
}

// Generic constrained impl Eq (Box[T : Eq])
struct Box[T] {
  v : T
}

impl[T : Eq] Eq for Box[T] {
  fn equal(a : Box[T], b : Box[T]) -> Bool {
    a.v == b.v
  }
}

// Partial-bound generic impl Eq (Pair[A, B : Eq])
struct Pair[A, B] {
  first : A
  second : B
}

impl[A, B : Eq] Eq for Pair[A, B] {
  fn equal(x : Pair[A, B], y : Pair[A, B]) -> Bool {
    x.second == y.second
  }
}

// Inherent `equal` coexisting with built-in `impl Eq`
struct DualEq {
  v : Int
}

fn DualEq::equal(self : DualEq, other : DualEq) -> Bool {
  self.v != other.v
}

impl Eq for DualEq {
  fn equal(self : DualEq, other : DualEq) -> Bool {
    self.v == other.v
  }
}

// Recursive type with custom impl Eq
enum RecNode {
  Leaf(Int)
  Branch(RecNode)
}

impl Eq for RecNode {
  fn equal(a : RecNode, b : RecNode) -> Bool {
    match (a, b) {
      (Leaf(x), Leaf(y)) => x == y
      (Branch(x), Branch(y)) => x == y
      _ => false
    }
  }
}

// Aliasing mutation during Array[MutEl] comparison
struct MutEl {
  tag : Int
  arr_box : Array[Array[MutEl]]
  hits : Array[Int]
}

impl Eq for MutEl {
  fn equal(self : MutEl, other : MutEl) -> Bool {
    self.hits[0] = self.hits[0] + 1
    if self.arr_box.length() > 0 {
      let arr = self.arr_box[0]
      if arr.length() > 0 {
        arr[0] = MutEl::{ tag: 99, arr_box: [], hits: self.hits }
      }
    }
    self.tag == other.tag
  }
}

fn gen_eq[T : Eq](a : T, b : T) -> Bool {
  a == b
}

fn fwd1[T : Eq](a : T, b : T) -> Bool { gen_eq(a, b) }
fn fwd2[T : Eq](a : T, b : T) -> Bool { fwd1(a, b) }
fn fwd3[T : Eq](a : T, b : T) -> Bool { fwd2(a, b) }
fn fwd4[T : Eq](a : T, b : T) -> Bool { fwd3(a, b) }
fn fwd5[T : Eq](a : T, b : T) -> Bool { fwd4(a, b) }

fn make_k(log : Array[Int], tag : Int, hits : Array[Int]) -> K {
  log.push(tag)
  K::{ id: tag, hits: hits }
}

fn make_rec(n : Int, leaf : Int) -> RecNode {
  let mut cur = RecNode::Leaf(leaf)
  let mut i = 0
  while i < n {
    cur = RecNode::Branch(cur)
    i = i + 1
  }
  cur
}

pub fn main(world : World) -> Int {
  // 1. Non-reflexive K + no pointer-identity shortcut across all containers
  let hits = [0]
  let k = K::{ id: 1, hits: hits }
  if k == k { panic("k == k must be false") }
  if hits[0] != 1 { panic("k == k hits must be 1") }
  if !(k != k) { panic("k != k must be true") }
  if hits[0] != 2 { panic("k != k hits must be 2") }

  // Single-element Array/FixedArray/ImmArray via [T : Eq]
  let xs : Array[K] = [k]
  if gen_eq(xs, xs) { panic("[k] == [k] must be false") }
  if hits[0] != 3 { panic("[k] == [k] hits must be 3") }

  let fx : FixedArray[K] = FixedArray::make(1, k)
  if gen_eq(fx, fx) { panic("FixedArray [k] == [k] must be false") }
  if hits[0] != 4 { panic("FixedArray hits must be 4") }

  let ix : ImmArray[K] = xs.to_imm()
  if gen_eq(ix, ix) { panic("ImmArray [k] == [k] must be false") }
  if hits[0] != 5 { panic("ImmArray hits must be 5") }

  // Option (niche), Result, Tuple, #derive(Eq) wrapper
  let ok_opt : Option[K] = Some(k)
  let no_opt : Option[K] = None
  if ok_opt == ok_opt { panic("Some(k) == Some(k) must be false") }
  if hits[0] != 6 { panic("Option hits must be 6") }
  if !(no_opt == no_opt) { panic("None == None must be true") }
  if hits[0] != 6 { panic("None == None must not call equal") }

  let res_k : Result[K, Int] = Ok(k)
  if res_k == res_k { panic("Ok(k) == Ok(k) must be false") }
  if hits[0] != 7 { panic("Result hits must be 7") }

  let tup_k = (k, 42)
  if tup_k == tup_k { panic("(k, 42) == (k, 42) must be false") }
  if hits[0] != 8 { panic("Tuple hits must be 8") }

  let wk = WrapK::{ first: 1, k: k }
  if wk == wk { panic("WrapK == WrapK must be false") }
  if hits[0] != 9 { panic("WrapK hits must be 9") }

  // 2. Operand single evaluation & short-circuiting
  let eval_log : Array[Int] = []
  let _ = make_k(eval_log, 10, hits) != make_k(eval_log, 20, hits)
  if eval_log.length() != 2 || eval_log[0] != 10 || eval_log[1] != 20 {
    panic("operands must be evaluated once left-to-right")
  }
  let sc_a = [0]
  let sc_b = [0]
  let sc1 = ShortCircuitBox::{ a: K::{ id: 1, hits: sc_a }, b: K::{ id: 2, hits: sc_b } }
  if sc1 == sc1 { panic("ShortCircuitBox must be false") }
  if sc_a[0] != 1 || sc_b[0] != 0 { panic("second field must short-circuit") }

  // 3. Payload-less enum with custom impl Eq + niche Option[UnitEnum]
  if !(Color::Red == Color::Green) { panic("Red == Green must be true") }
  if Color::Blue == Color::Blue { panic("Blue == Blue must be false") }
  let oc1 : Option[Color] = Some(Color::Red)
  let oc2 : Option[Color] = Some(Color::Green)
  let oc3 : Option[Color] = Some(Color::Blue)
  if !(oc1 == oc2) { panic("Some(Red) == Some(Green) must be true") }
  if oc3 == oc3 { panic("Some(Blue) == Some(Blue) must be false") }
  if !(ColorWrap::{ c: Color::Red } == ColorWrap::{ c: Color::Green }) {
    panic("ColorWrap custom enum Eq failed")
  }

  // 4. Flat POD struct arrays with custom impl Eq
  let fp_a : Array[FlatPair] = [FlatPair::{ a: 1, b: 10 }, FlatPair::{ a: 2, b: 20 }]
  let fp_b : Array[FlatPair] = [FlatPair::{ a: 1, b: 99 }, FlatPair::{ a: 2, b: 88 }]
  if !(fp_a == fp_b) { panic("FlatPair Array == must use custom impl Eq") }
  if !fp_a.contains(FlatPair::{ a: 2, b: 777 }) { panic("FlatPair Array::contains must use custom impl Eq") }
  let fp_fa : FixedArray[FlatPair] = FixedArray::make(2, FlatPair::{ a: 5, b: 1 })
  let fp_fb : FixedArray[FlatPair] = FixedArray::make(2, FlatPair::{ a: 5, b: 9 })
  if !(fp_fa == fp_fb) { panic("FlatPair FixedArray == must use custom impl Eq") }
  let fp_ia = fp_a.to_imm()
  let fp_ib = fp_b.to_imm()
  if !(fp_ia == fp_ib) { panic("FlatPair ImmArray == must use custom impl Eq") }

  // 5. Picked, Transition, TheseItems[closure], Box[T : Eq] + 5-layer forwarding, Pair[closure, Int]
  let p1 = Picked::{ tag: 7, cb: fn() -> Int { 1 } }
  let p2 = Picked::{ tag: 7, cb: fn() -> Int { 2 } }
  if !(p1 == p2) { panic("Picked == failed") }

  let tr1 = Transition::{ id: 1 }
  let tr2 = Transition::{ id: 1 }
  if !(tr1 == tr1) || tr1 == tr2 { panic("Transition physical_equal failed") }

  let ti1 = TheseItems::{ item: fn() -> Unit { () } }
  let ti2 = TheseItems::{ item: fn() -> Unit { () } }
  if !(ti1 == ti1) || ti1 == ti2 { panic("TheseItems[closure] failed") }

  let b1 = Box::{ v: 42 }
  let b2 = Box::{ v: 42 }
  let b3 = Box::{ v: 99 }
  if !fwd5(b1, b2) || fwd5(b1, b3) { panic("Box[Int] 5-layer forwarding failed") }
  let bk = Box::{ v: k }
  let hits_before = hits[0]
  if fwd5(bk, bk) { panic("Box[K] 5-layer forwarding must be false") }
  if hits[0] != hits_before + 1 { panic("Box[K] must invoke K::equal once") }

  let pr1 = Pair::{ first: fn() -> Unit { () }, second: 123 }
  let pr2 = Pair::{ first: fn() -> Unit { () }, second: 123 }
  if !(pr1 == pr2) { panic("Pair[closure, Int] failed") }

  // 6. Inherent `equal` vs built-in `impl Eq`
  let d1 = DualEq::{ v: 5 }
  let d2 = DualEq::{ v: 5 }
  if !(d1 == d2) { panic("DualEq == must call impl Eq") }
  if d1.equal(d2) { panic("DualEq.equal must call inherent equal") }

  // 7. Deep recursion (64 levels)
  let r1 = make_rec(64, 7)
  let r2 = make_rec(64, 7)
  let r3 = make_rec(64, 8)
  if !(r1 == r2) || r1 == r3 { panic("RecNode 64-level recursion failed") }

  // 8. Aliasing mutation + RC safety during Array[MutEl] comparison
  let mhits = [0]
  let abox : Array[Array[MutEl]] = []
  let mel = MutEl::{ tag: 1, arr_box: abox, hits: mhits }
  let marr : Array[MutEl] = [mel]
  abox.push(marr)
  if !(marr == marr) { panic("MutEl aliasing comparison failed") }
  if mhits[0] != 1 { panic("MutEl hits must be 1") }

  io_println(world, "builtin_impl_eq ok")
  0
}
