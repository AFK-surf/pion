// P114: a register-hungry interpreter loop (24 loop-carried registers plus
// accumulator, pc and step count) dispatched through a `match` jump table in
// the loop header. Most opcodes only touch registers, 8 and 9 call out (so
// values come back from their private spill homes on a minority of
// entries), 10 and 12 are gaps (duplicate default entries), negative opcodes
// and 14+ are out of range (default), 11 may leave the loop early and 13
// jumps. Every program runs for 0..5000 rounds; ref.py computes the output.

// Recursive (not a tail call), so it stays a real call in run_vm: the
// values live across it come back from their spill homes.
fn mix_step(h : Int, k : Int) -> Int {
  if k >= 3 {
    h
  } else {
    mix_step((h * 5 + k) & 1048575, k + 1) & 1048575
  }
}

fn mix(a : Int, b : Int) -> Int {
  mix_step((a & 1048575) * 31 + (b & 1048575) + 7, 0)
}

fn gen_code(seed : Int, n : Int) -> Array[Int] {
  let code : Array[Int] = []
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 75 + 74) % 65537
    code.push(s % 17 - 2)
    i = i + 1
  }
  code
}

fn run_vm(code : Array[Int], rounds : Int, seed : Int) -> Int {
  let mem : Array[Int] = []
  let mut z = 0
  while z < 64 {
    mem.push((seed + z * 13) & 1023)
    z = z + 1
  }
  let n = code.length()
  let mut r0 = seed & 1023
  let mut r1 = (seed >> 3) & 1023
  let mut r2 = (seed >> 6) & 1023
  let mut r3 = (seed + 11) & 1023
  let mut r4 = (seed + 22) & 1023
  let mut r5 = (seed + 33) & 1023
  let mut r6 = (seed + 44) & 1023
  let mut r7 = (seed + 55) & 1023
  let mut r8 = (seed + 66) & 1023
  let mut r9 = (seed + 77) & 1023
  let mut r10 = (seed + 88) & 1023
  let mut r11 = (seed + 99) & 1023
  let mut r12 = (seed + 110) & 1023
  let mut r13 = (seed + 121) & 1023
  let mut r14 = (seed + 132) & 1023
  let mut r15 = (seed + 143) & 1023
  let mut r16 = (seed + 154) & 1023
  let mut r17 = (seed + 165) & 1023
  let mut r18 = (seed + 176) & 1023
  let mut r19 = (seed + 187) & 1023
  let mut r20 = (seed + 198) & 1023
  let mut r21 = (seed + 209) & 1023
  let mut r22 = (seed + 220) & 1023
  let mut r23 = (seed + 231) & 1023
  let mut acc = 1
  let mut pc = 0
  let mut steps = 0
  if rounds > 0 && n > 0 {
    // The next opcode is fetched at the end of a round, so the loop header
    // itself dispatches and holds the shadow stores of the loop values.
    let mut op = code[0]
    pc = if n == 1 { 0 } else { 1 }
    while true {
      steps = steps + 1
      match op {
        0 => {
          r0 = (r0 + r1) & 1048575
          r8 = (r8 + r0) & 1048575
          r16 = (r16 + r8 + 1) & 1048575
        }
        1 => {
          r1 = (r1 + r2 + 1) & 1048575
          r9 = (r9 + r1) & 1048575
          r17 = (r17 + r9 + 1) & 1048575
        }
        2 => {
          r2 = ((r2 ^ r3) + 3) & 1048575
          r10 = (r10 + r2) & 1048575
          r18 = (r18 + r10 + 1) & 1048575
        }
        3 => {
          r3 = (r3 + r4 * 3) & 1048575
          r11 = (r11 + r3) & 1048575
          r19 = (r19 + r11 + 1) & 1048575
        }
        4 => {
          r4 = (r4 + r5) & 1048575
          r12 = (r12 + r4) & 1048575
          r20 = (r20 + r12 + 1) & 1048575
        }
        5 => {
          r5 = (r5 + r6 + steps) & 1048575
          r13 = (r13 + r5) & 1048575
          r21 = (r21 + r13 + 1) & 1048575
        }
        6 => {
          mem[r0 & 63] = r7
          r6 = (r6 + 1) & 1048575
          r14 = (r14 + r6) & 1048575
          r22 = (r22 + r14 + 1) & 1048575
        }
        7 => {
          r7 = (r7 + mem[r1 & 63]) & 1048575
          r15 = (r15 + r7) & 1048575
          r23 = (r23 + r15 + 1) & 1048575
        }
        8 => {
          acc = mix(acc, r0 + r1 + r2 + r3)
          r12 = (r12 + r13 + r14 + r15 + acc) & 1048575
          r16 = (r16 + r17 + r18 + r19 + acc) & 1048575
        }
        9 => {
          r0 = mix(r4, r5)
          r1 = mix(r6, r7)
          r8 = (r8 + r9 + r10 + r11) & 1048575
          r20 = (r20 + r21 + r22 + r23) & 1048575
        }
        11 =>
        if (r0 & 3) == 0 {
          break
        }
        13 => pc = (r3 & 255) % n
        _ => acc = (acc + 1 + r2 + op) & 1048575
      }
      if steps >= rounds {
        break
      }
      op = code[pc]
      pc = pc + 1
      if pc >= n {
        pc = 0
      }
    }
  }
  let mut h = (acc * 31 + steps) & 1048575
  h = (h * 31 + pc) & 1048575
  h = (h * 31 + r0) & 1048575
  h = (h * 31 + r1) & 1048575
  h = (h * 31 + r2) & 1048575
  h = (h * 31 + r3) & 1048575
  h = (h * 31 + r4) & 1048575
  h = (h * 31 + r5) & 1048575
  h = (h * 31 + r6) & 1048575
  h = (h * 31 + r7) & 1048575
  h = (h * 31 + r8) & 1048575
  h = (h * 31 + r9) & 1048575
  h = (h * 31 + r10) & 1048575
  h = (h * 31 + r11) & 1048575
  h = (h * 31 + r12) & 1048575
  h = (h * 31 + r13) & 1048575
  h = (h * 31 + r14) & 1048575
  h = (h * 31 + r15) & 1048575
  h = (h * 31 + r16) & 1048575
  h = (h * 31 + r17) & 1048575
  h = (h * 31 + r18) & 1048575
  h = (h * 31 + r19) & 1048575
  h = (h * 31 + r20) & 1048575
  h = (h * 31 + r21) & 1048575
  h = (h * 31 + r22) & 1048575
  h = (h * 31 + r23) & 1048575
  let mut q = 0
  while q < 64 {
    h = (h * 3 + mem[q]) & 1048575
    q = q + 1
  }
  h
}

pub fn main(world : World) -> Int {
  let lens = [0, 1, 2, 7, 17, 64, 257]
  let rounds = [0, 1, 2, 3, 19, 200, 5000]
  let mut total = 0
  let mut li = 0
  while li < lens.length() {
    let mut seed = 1
    while seed <= 5 {
      let code = gen_code(seed * 7919 + lens[li], lens[li])
      let mut line = "len=" + lens[li].to_string() + " seed=" + seed.to_string()
      let mut ri = 0
      while ri < rounds.length() {
        let v = run_vm(code, rounds[ri], seed * 1009 + ri)
        line = line + " " + v.to_string()
        total = (total * 31 + v) & 1048575
        ri = ri + 1
      }
      io_println(world, line)
      seed = seed + 1
    }
    li = li + 1
  }
  io_println(world, "total=" + total.to_string())
  0
}
