	%r =d sub %v, %x
	ret %r
}

export function s $n_side0_divs(s %x, l %p) {
@start
	%v =s loads %p
	%r =s div %v, %x
	ret %r
}

export function d $n_self_subd(d %x, l %p) {
@start
	%v =d loadd %p
	%r =d sub %v, %v
	ret %r
}

export function s $n_multi_divs(s %x, l %p, l %q) {
@start
	%v =s loads %p
	%r =s div %x, %v
	stores %v, %q
	ret %r
}

export function d $n_store_subd(d %x, l %p, d %y) {
@start
	%v =d loadd %p
	stored %y, %p
	%r =d sub %x, %v
	ret %r
}

export function s $n_store_divs(s %x, l %p, s %y) {
@start
	%v =s loads %p
	stores %y, %p
	%r =s div %x, %v
	ret %r
}

export function d $n_call_divd(d %x, l %p) {
@start
	%v =d loadd %p
	call $p119_clobber(l %p)
	%r =d div %x, %v
	ret %r
}

export function s $n_call_subs(s %x, l %p) {
@start
	%v =s loads %p
	call $p119_clobber(l %p)
	%r =s sub %x, %v
	ret %r
}

export function d $n_width_sd(d %x, l %p) {
@start
	%v =s loads %p
	%e =d exts %v
	%r =d sub %x, %e
	ret %r
}

export function s $n_width_ds(s %x, l %p) {
@start
	%v =d loadd %p
	%t =s truncd %v
	%r =s div %x, %t
	ret %r
}

export function d $n_const_subd(l %p) {
@start
	%v =d loadd %p
	%r =d sub d_1.5, %v
	ret %r
}

export function s $n_const_divs(l %p) {
@start
	%v =s loads %p
	%r =s div s_3, %v
	ret %r
}
