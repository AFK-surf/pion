# P119 fixture: AMD64 scalar FP right-operand load fold (vendor/qbe/amd64/isel.c
# foldoperandloads). p_* functions must fold the load into subs{s,d} / divs{s,d}
# with a memory source; n_* functions must not. check_fpfold.py holds the
# per-function expectations, driver.c the C reference of each function.
#   p_<op><k>_ptr   x op [p]                    RTmp address
#   p_<op><k>_off   x op [p + 24]               RMem base + offset
#   p_<op><k>_idx   x op [p + i*W + 8]          RMem base + index*scale + offset
#   p_<op><k>_slot  x op [slot + j*W + 16]      RMem stack slot (+ index, offset);
#                   the bits of [p] are stored at [slot + i*W + 16] (i == j)
#   p_<op><k>_hp    in[0] op [q] with 20 FP values live (in[1..19] are stored
#                   to out[1..19] before and to out[20..38] after): in[0]
#                   lives in a stack slot and is reloaded into the destination
#   n_side0_*       the load is the left operand
#   n_self_subd     [p] - [p] from one load (two uses)
#   n_multi_divs    the loaded value is also stored to [q] (two uses)
#   n_store_*       a store to the same address between load and operation
#   n_call_*        a call (which overwrites [p]) between load and operation
#   n_width_*       loads + exts + subd / loadd + truncd + divs
#   n_const_*       FP constant left operand (itself a memory operand)

export function s $p_subs_ptr(s %x, l %p) {
@start
	%v =s loads %p
	%r =s sub %x, %v
	ret %r
}

export function s $p_subs_off(s %x, l %p) {
@start
	%a =l add %p, 24
	%v =s loads %a
	%r =s sub %x, %v
	ret %r
}

export function s $p_subs_idx(s %x, l %p, l %i) {
@start
	%o =l mul %i, 4
	%b =l add %p, %o
	%a =l add %b, 8
	%v =s loads %a
	%r =s sub %x, %v
	ret %r
}

export function s $p_subs_slot(s %x, l %p, l %i, l %j) {
@start
	%s =l alloc8 64
	%bits =w loadw %p
	%o =l mul %i, 4
	%b =l add %s, %o
	%a =l add %b, 16
	storew %bits, %a
	%o2 =l mul %j, 4
	%b2 =l add %s, %o2
	%a2 =l add %b2, 16
	%v =s loads %a2
	%r =s sub %x, %v
	ret %r
}

