// P119: AMD64 scalar floating-point right-operand load fold, from Pion source
// to native code. Each subtraction / division reads its right operand
// straight from an array element or a struct field, which QBE turns into
// `subs{s,d}` / `divs{s,d}` with a memory source on AMD64. Every result is
// printed as its exact IEEE-754 bit pattern (NaN results print as `nan`,
// since NaN propagation differs between architectures); pion_ref.c prints
// the same lines from C.

fn int_min32() -> Int {
  -2147483647 - 1
}

fn int_min64() -> Int64 {
  -9223372036854775807L - 1L
}

fn dres(x : Double) -> String {
  if x.is_nan() {
    "nan"
  } else {
    x.to_bits().to_string()
  }
}

fn fres(x : Float) -> String {
  if x != x {
    "nan"
  } else {
    x.to_bits().to_string()
  }
}

pub struct Body {
  x : Double
  y : Double
  m : Float
}

fn sub_row_d(xs : Array[Double], ys : Array[Double], i : Int) -> String {
  let sb = StringBuilder::new()
  let a = xs[i]
  let mut j = 0
  while j < ys.length() {
    sb.write_string(" ")
    sb.write_string(dres(a - ys[j]))
    j = j + 1
  }
  sb.to_string()
}

fn div_row_d(xs : Array[Double], ys : Array[Double], i : Int) -> String {
  let sb = StringBuilder::new()
  let a = xs[i]
  let mut j = 0
  while j < ys.length() {
    sb.write_string(" ")
    sb.write_string(dres(a / ys[j]))
    j = j + 1
  }
  sb.to_string()
}

fn sub_row_f(xs : Array[Float], ys : Array[Float], i : Int) -> String {
  let sb = StringBuilder::new()
  let a = xs[i]
  let mut j = 0
  while j < ys.length() {
    sb.write_string(" ")
    sb.write_string(fres(a - ys[j]))
    j = j + 1
  }
  sb.to_string()
}

fn div_row_f(xs : Array[Float], ys : Array[Float], i : Int) -> String {
  let sb = StringBuilder::new()
  let a = xs[i]
  let mut j = 0
  while j < ys.length() {
    sb.write_string(" ")
    sb.write_string(fres(a / ys[j]))
    j = j + 1
  }
  sb.to_string()
}

// nbody shape: differences of fields of two array elements.
fn pairs(bodies : Array[Body]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bodies.length() {
    let b = bodies[i]
    let mut j = 0
    while j < bodies.length() {
      let c = bodies[j]
      let dx = b.x - c.x
      let dy = b.y / c.y
      let dm = b.m - c.m
      sb.write_string(" ")
      sb.write_string(dres(dx))
      sb.write_string(",")
      sb.write_string(dres(dy))
      sb.write_string(",")
      sb.write_string(fres(dm))
      j = j + 1
    }
    i = i + 1
  }
  sb.to_string()
}

fn main(w : World) -> Unit {
  let dbits : Array[Int64] = [
    0L, int_min64(), 1L, -9218868437227405313L, 4503599627370496L, 4607182418800017408L,
    -4613937818241073152L, 4599676419421066581L, 4614256656552045848L, 9218868437227405311L,
    9218868437227405312L, -4503599627370496L, 9221120237041090851L,
  ]
  let fbits : Array[Int] = [
    0, int_min32(), 1, -2139095041, 8388608, 1065353216, -1077936128, 1051372203, 1078530011,
    2139095039, 2139095040, -8388608, 2143289635,
  ]
  let ds : Array[Double] = []
  for b in dbits {
    ds.push(Double::from_bits(b))
  }
  let fs : Array[Float] = []
  for b in fbits {
    fs.push(Float::from_bits(b))
  }
  let mut i = 0
  while i < ds.length() {
    io_println(w, "subd " + i.to_string() + sub_row_d(ds, ds, i))
    io_println(w, "divd " + i.to_string() + div_row_d(ds, ds, i))
    io_println(w, "subs " + i.to_string() + sub_row_f(fs, fs, i))
    io_println(w, "divs " + i.to_string() + div_row_f(fs, fs, i))
    i = i + 1
  }
  let bodies : Array[Body] = []
  let mut k = 0
  while k < 6 {
    bodies.push(Body::{ x: ds[k + 3], y: ds[(k * 5 + 1) % 12], m: fs[(k * 7 + 2) % 12] })
    k = k + 1
  }
  io_println(w, "pairs" + pairs(bodies))
}
