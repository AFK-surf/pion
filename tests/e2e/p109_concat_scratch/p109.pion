// P109: native N-way `pion_str_concat_n` chains format built-in `Int` / `Int64`
// `.to_string()` parts into caller stack slots (3..8 parts) instead of heap
// temporaries. Outputs must match the heap path (>8 parts, Wasm32) bit for bit.

pub trait Render {
  to_string(self : Self) -> String
}

impl Render for Int {
  fn to_string(self : Int) -> String {
    "int#" + (self * 2).to_string()
  }
}

struct Pt {
  x : Int
  y : Int64
}

fn Pt::to_string(self : Pt) -> String {
  "Pt(" + self.x.to_string() + ";" + self.y.to_string() + ")"
}

fn int_min32() -> Int {
  -2147483647 - 1
}

fn int_min64() -> Int64 {
  -9223372036854775807L - 1L
}

fn hot3(a : Int, b : Int64) -> String {
  a.to_string() + "/" + b.to_string()
}

fn hot4(a : Int, b : Int) -> String {
  "k_" + a.to_string() + "_" + b.to_string()
}

fn hot5(a : Int64, b : Int, c : Int64) -> String {
  a.to_string() + "," + b.to_string() + "," + c.to_string()
}

fn hot6(a : Int, b : Int64, c : Int) -> String {
  "a=" + a.to_string() + " b=" + b.to_string() + " c=" + c.to_string()
}

fn hot7(a : Int, b : Int, c : Int, d : Int64) -> String {
  a.to_string() + b.to_string() + c.to_string() + d.to_string() + "|" + a.to_string() + "|"
}

fn hot8(a : Int, b : Int64, c : Int, d : Int64) -> String {
  "<" + a.to_string() + ":" + b.to_string() + ":" + c.to_string() + ":" + d.to_string()
}

// Same receiver formatted several times in one chain: every part has its own slot.
fn same_recv(i : Int) -> String {
  i.to_string() + "|" + i.to_string() + "|" + (i + 1).to_string() + "|" + (i * -3).to_string()
}

fn method_recv(xs : Array[Int], n : Int64) -> String {
  "len=" + xs.length().to_string() + " n=" + (n * 3L).to_string() + " last=" + xs[xs.length() - 1].to_string()
}

// More than 8 parts: heap fallback.
fn wide9(a : Int, b : Int64) -> String {
  a.to_string() + "." + b.to_string() + "." + a.to_string() + "." + b.to_string() + "." + a.to_string()
}

fn tick(log : Array[Int], v : Int) -> Int {
  log.push(v)
  v * 10
}

fn tick64(log : Array[Int], v : Int) -> Int64 {
  log.push(v)
  v.to_int64() * -100L
}

fn ordered(log : Array[Int]) -> String {
  "(" + tick(log, 1).to_string() + "," + tick64(log, 2).to_string() + "," + tick(log, 3).to_string() + ")"
}

fn parse_digit(s : String) -> Option[Int] {
  if s.length() == 1 {
    let c = s.code_unit_at(0)
    if c >= 48 && c <= 57 {
      return Some(c - 48)
    }
  }
  None
}

// `?` exits between parts: the already formatted stack parts need no cleanup.
fn try_join(a : String, b : String) -> Option[String] {
  Some("d=" + parse_digit(a)?.to_string() + "+" + parse_digit(b)?.to_string() + "!")
}

fn wrap[T : Render](v : T) -> String {
  "[" + v.to_string() + "]" + "!"
}

fn custom(p : Pt) -> String {
  "pt=" + p.to_string() + " #" + p.x.to_string()
}

fn opt_str(o : Option[String]) -> String {
  match o {
    Some(s) => s
    None => "none"
  }
}

fn main(w : World) -> Unit {
  let mn32 = int_min32()
  let mx32 = 2147483647
  let mn64 = int_min64()
  let mx64 = 9223372036854775807L
  io_println(w, hot3(0, 0L))
  io_println(w, hot3(-1, -1L))
  io_println(w, hot4(mn32, mx32))
  io_println(w, hot5(mn64, mn32, mx64))
  io_println(w, hot6(mx32, mn64, -1))
  io_println(w, hot7(1, -22, 333, mx64))
  io_println(w, hot8(mn32, mn64, mx32, mx64))
  io_println(w, same_recv(7))
  io_println(w, same_recv(mx32))
  io_println(w, method_recv([5, 6, -9], mn64 / 4L))
  io_println(w, wide9(mn32, mn64))
  let log : Array[Int] = []
  io_println(w, ordered(log))
  io_println(w, "log=" + log[0].to_string() + log[1].to_string() + log[2].to_string())
  io_println(w, opt_str(try_join("4", "9")))
  io_println(w, opt_str(try_join("x", "9")))
  io_println(w, opt_str(try_join("4", "yy")))
  io_println(w, wrap(21))
  io_println(w, custom(Pt::{ x: -5, y: mn64 }))
  // Loop: the same slots are reused by every iteration.
  let keys : Array[String] = []
  let mut i = -3
  while i < 1000 {
    keys.push("k_" + i.to_string() + "_" + (i * i).to_int64().to_string() + "_" + (i - 7).to_string())
    i = i + 1
  }
  let mut total = 0
  let mut j = 0
  while j < keys.length() {
    total = total + keys[j].length() * (j % 7 + 1)
    j = j + 1
  }
  io_println(w, keys[0] + " " + keys[3] + " " + keys[keys.length() - 1])
  io_println(w, "keys=" + keys.length().to_string() + " total=" + total.to_string() + ".")
}
