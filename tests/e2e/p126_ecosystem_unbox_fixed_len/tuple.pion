// Immediately destructured short primitive tuples returned by inlined callees.
let scale : Int = 3

fn mix(a : Int, b : Int) -> (Int, Int) {
  let x = a ^ b
  (a + x, b - x)
}

fn project(a : Int, b : Int) -> Int {
  let (x, y) = mix(a, b)
  x * 1000 + y
}

fn second_only(a : Int, b : Int) -> Int {
  let (_, y) = mix(a, b)
  y
}

fn loop_mix(n : Int) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < n {
    let (p, q) = mix(i, acc & 255)
    acc = acc + p - q
    i = i + 1
  }
  acc
}

fn wide(a : Int, f : Float, d : Double, l : Int64, u : UInt) -> (Float, Double, Int64, UInt, Bool) {
  let g = f * f
  (g, d + 0.5, l * 3L, u + 7U, a > 0)
}

fn use_wide(a : Int) -> Int {
  let f : Float = 1.5
  let (g, d, l, u, flag) = wide(a, f, 2.25, 4000000000L, 4000000000U)
  let mut r = 0
  if g == 2.25 { r = r + 1 }
  if d == 2.75 { r = r + 10 }
  if l == 12000000000L { r = r + 100 }
  if u == 4000000007U { r = r + 1000 }
  if flag { r = r + 10000 }
  r
}

// The tuple escapes: it keeps its heap box and identity.
fn escape(a : Int, b : Int) -> Int {
  let t = mix(a, b)
  let (x, y) = t
  if !physical_equal(t, t) || physical_equal(t, mix(a, b)) { return -1 }
  x + y
}

// Object-field tuples unbox the tuple wrapper when immediately destructured
// while keeping heap allocation and reference counting on each element.
fn named(n : Int) -> (String, Array[Int]) {
  let s = "n" + n.to_string()
  (s, [n, n + 1])
}

fn use_named(n : Int) -> Int {
  let (s, xs) = named(n)
  s.length() * 100 + xs[1]
}

// The destructuring inline keeps the body's last-use early drops: `a` is
// released before the second string is built.
fn drop_pair(x : Int) -> (Int, Int) {
  let a = x.to_string()
  let n = a.length()
  let b = (x + 1).to_string()
  (n, b.length())
}

fn use_drop_pair(x : Int) -> Int {
  let (a, b) = drop_pair(x)
  a * 10 + b
}

// Plain and destructuring inlined bodies keep the callee's lexical scope.
fn add_scale(x : Int) -> Int {
  x * scale
}

fn scaled(x : Int, scale : Int) -> Int {
  add_scale(x) + scale
}

fn pair_scale(x : Int) -> (Int, Int) {
  (x * scale, x + scale)
}

fn use_pair(x : Int, scale : Int) -> Int {
  let (a, b) = pair_scale(x)
  a * 100 + b + scale
}

fn main(world : World) -> Int {
  io_println(world, "project " + project(6, 3).to_string() + " " + second_only(6, 3).to_string())
  io_println(world, "loop " + loop_mix(1000).to_string())
  io_println(world, "wide " + use_wide(1).to_string() + " " + use_wide(-1).to_string())
  io_println(world, "escape " + escape(6, 3).to_string())
  let mut named_total = 0
  let mut i = 0
  while i < 200 {
    named_total = named_total + use_named(i)
    i = i + 1
  }
  io_println(world, "named " + named_total.to_string())
  io_println(world, "drop " + use_drop_pair(9).to_string() + " " + use_drop_pair(99999).to_string())
  io_println(world, "scope " + scaled(5, 100).to_string() + " " + use_pair(5, 1000).to_string())
  0
}
