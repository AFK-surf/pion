// Immutable aliases of package `FixedArray` / `ImmArray` literal tables check
// bounds against the literal length; every other binding keeps the header.
let fixed_words : FixedArray[Int] = [3, 5, 7, 11]
let imm_words : ImmArray[Int] = [2, 4, 6, 8, 10, 12]
let dyn_words : Array[Int] = [1, 2, 3, 4]

// probe_fixed_*: every bounds check compares against 4.
fn probe_fixed_sum(n : Int) -> Int {
  let xs = fixed_words
  let mut i = 0
  let mut total = 0
  while i < n {
    total = total + xs[i]
    i = i + 1
  }
  total
}

// probe_imm_*: every bounds check compares against 6.
fn probe_imm_sum(n : Int) -> Int {
  let ys = imm_words
  let mut i = 0
  let mut total = 0
  while i < n {
    total = total + ys[i] * (i + 1)
    i = i + 1
  }
  total
}

// A write through another alias changes the element, never the length.
fn probe_fixed_alias_write(k : Int, v : Int) -> Int {
  let a = fixed_words
  let b = fixed_words
  b[k] = v
  a[k] * 10 + a.length()
}

// probe_dyn_*: no bounds check may compare against 4.
fn probe_dyn_param(fixed_words : FixedArray[Int], k : Int) -> Int {
  let xs = fixed_words
  let mut i = 0
  let mut total = 0
  while i < xs.length() {
    total = total + xs[i]
    i = i + 1
  }
  total * 100 + xs[k]
}

fn probe_dyn_local(k : Int) -> Int {
  let fixed_words : FixedArray[Int] = [1, 2, 3, 4, 5, 6, 7, 8, 9]
  let xs = fixed_words
  xs[k] + xs.length()
}

fn probe_dyn_mut(k : Int, other : FixedArray[Int]) -> Int {
  let mut r = fixed_words
  if k > 3 { r = other }
  r[k]
}

fn probe_dyn_array(k : Int) -> Int {
  let zs = dyn_words
  zs.push(k)
  zs[k]
}

fn main(world : World) -> Int {
  io_println(world, "fixed " + probe_fixed_sum(4).to_string() + " imm " + probe_imm_sum(6).to_string())
  io_println(world, "alias " + probe_fixed_alias_write(2, 70).to_string() + " " + fixed_words[2].to_string() + " " + probe_fixed_sum(4).to_string())
  let other : FixedArray[Int] = [2, 4, 6, 8, 10]
  io_println(world, "param " + probe_dyn_param(other, 3).to_string() + " local " + probe_dyn_local(8).to_string())
  io_println(world, "mut " + probe_dyn_mut(1, other).to_string() + " " + probe_dyn_mut(4, other).to_string())
  io_println(world, "dyn " + probe_dyn_array(4).to_string() + " " + dyn_words.length().to_string())
  io_println(world, "trap next")
  // Index 4 of the 4-element table: the immediate check must still trap.
  probe_fixed_sum(5)
}
