// `?` and `match` consume cross-file `Result` / `Option` returns immediately.
fn sum_bytes(r : ByteReader, n : Int) -> Result[Int, Int] {
  let mut total = 0
  let mut i = 0
  while i < n {
    let b = r.read_byte()?
    total = total * 31 + b
    i = i + 1
  }
  Ok(total)
}

// The caller's `bias` must not capture the callee's top-level `bias`.
fn through(x : Int, bias : Int) -> Result[Int, Int] {
  let v = get_value(x)?
  Ok(v + bias)
}

fn opt_match(x : Int, bias : Int) -> Int {
  match find_small(x) {
    Some(v) => v + bias
    None => 0 - bias
  }
}

// The `?` inside the argument leaves before `get_value` runs.
fn arg_early(r : ByteReader, x : Int) -> Result[Int, Int] {
  let v = get_value(r.read_byte()? + x)?
  Ok(v)
}

fn show(r : Result[Int, Int]) -> String {
  match r {
    Ok(v) => "ok " + v.to_string()
    Err(e) => "err " + e.to_string()
  }
}

fn main(world : World) -> Int {
  let r = ByteReader::{ data: [1, 2, 3, 4, 5], pos: 0 }
  io_println(world, show(sum_bytes(r, 3)) + " pos " + r.pos.to_string())
  io_println(world, show(sum_bytes(r, 5)) + " pos " + r.pos.to_string())
  let mut total = 0
  for i in 0..<2 {
    let bias = 200 + i
    total = total + match through(if i == 0 { -1 } else { 2 }, bias) {
      Ok(n) => n
      Err(e) => e
    }
  }
  io_println(world, "through " + total.to_string())
  io_println(world, "opt " + opt_match(5, 1000).to_string() + " " + opt_match(500, 1000).to_string())
  let r2 = ByteReader::{ data: [10, -20], pos: 0 }
  io_println(world, show(arg_early(r2, 5)) + " " + show(arg_early(r2, 5)) + " " + show(arg_early(r2, 5)) + " pos " + r2.pos.to_string())
  let boxed = get_value(2)
  if !physical_equal(boxed, boxed) || physical_equal(boxed, get_value(2)) { return 1 }
  0
}
