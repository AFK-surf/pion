// Callees of `main.pion` live in this separate file: their `Result` / `Option`
// returns are consumed immediately by cross-file callers.
let bias : Int = 7

pub struct ByteReader {
  data : Array[Int]
  mut pos : Int
}

pub fn ByteReader::read_byte(self : ByteReader) -> Result[Int, Int] {
  if self.pos >= self.data.length() { return Err(-1) }
  let b = self.data[self.pos]
  self.pos = self.pos + 1
  Ok(b)
}

pub fn get_value(x : Int) -> Result[Int, Int] {
  if x < 0 { return Err(bias) }
  let a = x + 1
  let b = a + 2
  let c = b + 3
  let d = c + 4
  Ok(d + bias)
}

pub fn find_small(x : Int) -> Option[Int] {
  if x > 100 { return None }
  Some(x * 2 + bias)
}
