///| P128: Map[String, Int] on Wasm32 (set / get / [] / contains / remove /
///| copy). Every map hash is inlined; the module carries no `__pion_map_hash`.
pub fn main(w : World) -> Int {
  let m : Map[String, Int] = Map::new()
  let words = ["pion", "wasm", "map", "hash", "pion", "map", "pion", "size"]
  for word in words {
    let prev = match m.get(word) {
      Some(v) => v
      None => 0
    }
    m[word] = prev + 1
  }
  let cp = m.copy()
  m.remove("hash")
  let mut sum = 0
  for word in ["pion", "wasm", "map", "hash", "size", "none"] {
    let v = match m.get(word) {
      Some(x) => x
      None => -1
    }
    sum = sum * 10 + v + 1
    io_println(w, word + "=" + v.to_string() + " contains=" + m.contains(word).to_string())
  }
  io_println(w, "len " + m.length().to_string() + " copy " + cp.length().to_string() + " pion " + m["pion"].to_string())
  io_println(w, "sum " + sum.to_string())
  0
}
