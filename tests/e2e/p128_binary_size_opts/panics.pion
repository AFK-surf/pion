///| P128: runtime panics that reach the pooled diagnostics of `pion_rt.c`
///| (`struct PionErrors` + `pion_die(offsetof(...))`). The trap operands come
///| from argv so no constant folding can move them.
pub fn main(w : World) -> Int {
  let args = args_get(w)
  let mode = if args.length() > 1 { args[1] } else { "" }
  let n = args.length()
  io_println(w, "mode " + mode)
  if mode == "slice" {
    let s = "abcd"
    io_println(w, s.slice(1, n + 6))
  } else if mode == "map" {
    let m : Map[String, Int] = Map::new()
    m["alpha"] = 1
    m["beta"] = 2
    let k = "gamma" + n.to_string()
    io_println(w, m[k].to_string())
  } else if mode == "bytes" {
    let b = Bytes::new(1 - n)
    io_println(w, b.length().to_string())
  } else if mode == "ok" {
    let m : Map[String, Int] = Map::new()
    m["alpha"] = 40 + n
    let b = Bytes::new(n)
    io_println(w, "abcd".slice(1, n + 1) + " " + m["alpha"].to_string() + " " + b.length().to_string())
  }
  0
}
