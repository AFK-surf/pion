///| P128: a program using host file I/O (`.text.pion_io` is kept).
pub fn main(w : World) -> Int {
  let args = args_get(w)
  if args.length() < 2 {
    io_eprintln(w, "usage: fileio <path>")
    return 2
  }
  let path = args[1]
  match fs_write(w, path, "p128 line one\np128 line two\n") {
    Ok(_) => ()
    Err(e) => {
      io_eprintln(w, "write failed: " + e)
      return 1
    }
  }
  match fs_read(w, path) {
    Ok(s) => io_print(w, s)
    Err(e) => {
      io_eprintln(w, "read failed: " + e)
      return 1
    }
  }
  match fs_read(w, path + ".missing") {
    Ok(_) => io_println(w, "unexpected read")
    Err(_) => io_println(w, "missing file: Err")
  }
  0
}
