///| P128: raw `Ptr` access, C strings and SHA-256 are not host I/O: they
///| stay outside `.text.pion_io`, which `--gc-sections` still removes.
pub fn main(w : World) -> Int {
  let p = ptr_alloc(8L)
  if ptr_is_null(p) {
    return 1
  }
  ptr_write_u8(p, 0L, 112)
  ptr_write_u8(p, 1L, 105)
  ptr_write_u8(p, 2L, 111)
  ptr_write_u8(p, 3L, 110)
  ptr_write_u8(p, 4L, 0)
  let name = cstr_to_str(p)
  let sum = ptr_read_u8(p, 0L) + ptr_read_u8(p, 3L)
  ptr_free(p)
  io_println(w, name + " " + sum.to_string() + " " + sha256_hex("abc"))
  0
}
