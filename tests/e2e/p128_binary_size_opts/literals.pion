///| P128: many private string literals (`pion_str_<n>_hdr`) and C-string
///| panic texts (`pion_cstr_<n>`, from the Bytes write and match guards).
enum Shape {
  Dot
  Line(Int)
  Box(Int, Int)
}

fn area(s : Shape) -> Int {
  match s {
    Dot => 0
    Line(n) => n
    Box(a, b) => a * b
  }
}

fn label(i : Int) -> String {
  if i % 3 == 0 {
    "fizz"
  } else if i % 5 == 0 {
    "buzz"
  } else {
    "plain-" + i.to_string()
  }
}

pub fn main(w : World) -> Int {
  let b = Bytes::new(8)
  let mut i = 0
  while i < 8 {
    b[i] = (i * 7).to_byte()
    i = i + 1
  }
  let shapes = [Dot, Line(3), Box(4, 5)]
  let mut total = 0
  for s in shapes {
    total = total + area(s)
  }
  let mut out = "literals:"
  let mut j = 1
  while j <= 6 {
    out = out + " " + label(j)
    j = j + 1
  }
  io_println(w, out)
  io_println(w, "bytes " + b[7].to_int().to_string() + " area " + total.to_string())
  io_println(w, "the quick brown fox jumps over the lazy dog")
  0
}
