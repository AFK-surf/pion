// `break` / `continue` in a nested C-style `for` `init`, in `for ... in`
// range bounds and in a `for x in` iterable leave / continue the enclosing
// loop; a loop nested inside a `while` condition breaks itself. Owned String
// temporaries in those positions are released on every path.

fn make_str(n : Int) -> String {
  "m" + n.to_string()
}

fn init_exits(n : Int, stop : Int) -> Int {
  let mut total = 0
  let mut k = 0
  while k < n {
    k = k + 1
    for i = (if k == stop { break } else if k % 3 == 0 { continue } else { make_str(k).length() }); i < 6; i = i + 1 {
      total = total + i
    }
    total = total + 100
  }
  total * 100 + k
}

fn bound_exits(n : Int) -> Int {
  let mut total = 0
  for k in 0..<n {
    for i in 0..<(if make_str(k) == "m4" { break } else if k % 2 == 1 { continue } else { k }) {
      total = total + i + 1
    }
    total = total + 1000
  }
  total
}

fn iter_exits(n : Int) -> Int {
  let xs : Array[String] = ["a", "bb", "ccc"]
  let mut total = 0
  let mut k = 0
  while k < n {
    k = k + 1
    for x in (if make_str(k) == "m5" { break } else if k == 2 { continue } else { xs }) {
      total = total + x.length() * k
    }
    total = total + 1000
  }
  total * 10 + k
}

fn cond_loop(n : Int) -> Int {
  let mut j = 0
  while j < ({
    let mut m = 0
    while true {
      if make_str(m) == make_str(n) { break }
      m = m + 1
    }
    m
  }) {
    j = j + 1
  }
  j
}

fn main(world : World) -> Int {
  io_println(world, init_exits(8, 0).to_string() + " " + init_exits(8, 5).to_string() + " " + bound_exits(4).to_string() + " " + bound_exits(9).to_string())
  io_println(world, iter_exits(3).to_string() + " " + iter_exits(9).to_string() + " " + cond_loop(0).to_string() + " " + cond_loop(7).to_string())
  let mut acc = 0
  let mut r = 0
  while r < 2000 {
    acc = acc + init_exits(r % 10, r % 7) + bound_exits(r % 9) + iter_exits(r % 8) + cond_loop(r % 6)
    r = r + 1
  }
  io_println(world, "rounds " + acc.to_string())
  0
}
