// `break` / `continue` in the condition of a nested `while` / `for` leave or
// continue the enclosing loop; owned String operands of those conditions
// are released on every path.

fn make_str(n : Int) -> String {
  "m" + n.to_string()
}

fn nested_while(n : Int, stop_i : Int, stop_j : Int) -> Int {
  let mut total = 0
  let mut i = 0
  while i < n {
    i = i + 1
    let mut j = 0
    while j < 4 &&
      make_str(j) != (if i == stop_i && j == stop_j { break } else if j > i { continue } else { "x" }) {
      j = j + 1
      total = total + 1
    }
    total = total + 100
  }
  total * 100 + i
}

fn nested_for(n : Int) -> Int {
  let mut total = 0
  let mut outer = 0
  while outer < n {
    outer = outer + 1
    for k = 0; (if k > outer { continue } else if outer == 6 && k == 2 { break } else { k < 5 }); k = k + 1 {
      total = total + make_str(k).length()
    }
    total = total + 1000
  }
  total * 100 + outer
}

fn main(world : World) -> Int {
  io_println(world, nested_while(5, 0, 0).to_string() + " " + nested_while(9, 6, 3).to_string() + " " + nested_while(9, 2, 0).to_string())
  io_println(world, nested_for(4).to_string() + " " + nested_for(9).to_string())
  let mut acc = 0
  let mut r = 0
  while r < 2000 {
    acc = acc + nested_while(r % 10, r % 7, r % 4) + nested_for(r % 9)
    r = r + 1
  }
  io_println(world, "rounds " + acc.to_string())
  0
}
