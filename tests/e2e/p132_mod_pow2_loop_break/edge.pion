// Edge cases: a `% 2^k == 0` operand that leaves the function inside a
// value-context comparison, and `continue` / `break` in the `init` of a
// nested C-style `for` (they belong to the enclosing loop).

fn blk_or(n : Int) -> Int {
  let r = ((({ return 29; 3 }) % 4 == 0) == (n == 1 || n == 2))
  if r { 1 } else { 0 }
}

fn blk_if(n : Int) -> Int {
  let r = ((({ return 31; 3 }) % 4 == 0) == (if n > 1 { true } else { false }))
  if r { 1 } else { 0 }
}

// `continue` / `break` from a nested C-style `for` `init` under `for ... in`
// range / array and `while` outer loops: the outer loop must still advance
// (its lowering may not assume a body that only falls through).
fn init_cont_range() -> Int {
  let mut s = 0
  for k in 0..<3 {
    for i = (if k == 1 { continue } else { 0 }); i < 3; i = i + 1 {
      s = s + 10 * k + i
    }
    s = s + 1000
  }
  s
}

fn init_cont_in() -> Int {
  let mut s = 0
  let ks : Array[Int] = [0, 1, 2]
  for k in ks {
    for i = (if k == 1 { continue } else { 0 }); i < 3; i = i + 1 {
      s = s + 10 * k + i
    }
    s = s + 1000
  }
  s
}

fn init_break_while(n : Int) -> Int {
  let mut s = 0
  let mut k = 0
  while k < n {
    k = k + 1
    for i = (if k == 3 { break } else { 1 }); i < 4; i = i + 1 {
      s = s + "s".length() * (10 * k + i)
    }
    s = s + 1000
  }
  s * 10 + k
}

fn main(world : World) -> Int {
  io_println(world, blk_or(1).to_string() + " " + blk_or(5).to_string() + " " + blk_if(2).to_string())
  io_println(world, init_cont_range().to_string() + " " + init_cont_in().to_string())
  io_println(world, init_break_while(2).to_string() + " " + init_break_while(6).to_string())
  0
}
