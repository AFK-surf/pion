// Edge cases: a `% 2^k == 0` operand that leaves the function inside a
// value-context comparison, and `continue` / `break` in the step of a nested
// C-style `for` (they belong to the enclosing loop).

fn blk_or(n : Int) -> Int {
  let r = ((({ return 29; 3 }) % 4 == 0) == (n == 1 || n == 2))
  if r { 1 } else { 0 }
}

fn blk_if(n : Int) -> Int {
  let r = ((({ return 31; 3 }) % 4 == 0) == (if n > 1 { true } else { false }))
  if r { 1 } else { 0 }
}

fn step_cont_range() -> Int {
  let mut s = 0
  for k in 0..<3 {
    for i = 0; i < 5; (if i == 2 { continue } else { i = i + 1 }) {
      s = s + 10 * k + i
    }
    s = s + 1000
  }
  s
}

fn step_cont_in() -> Int {
  let mut s = 0
  let ks : Array[Int] = [0, 1, 2]
  for k in ks {
    for i = 0; i < 5; (if i == 2 { continue } else { i = i + 1 }) {
      s = s + 10 * k + i
    }
    s = s + 1000
  }
  s
}

fn step_break_while(n : Int) -> Int {
  let mut s = 0
  let mut k = 0
  while k < n {
    k = k + 1
    for i = 0; i < 5; (if k == 3 && i == 1 { break } else { i = i + 1 }) {
      s = s + "s".length() * (10 * k + i)
    }
    s = s + 1000
  }
  s * 10 + k
}

fn main(world : World) -> Int {
  io_println(world, blk_or(1).to_string() + " " + blk_or(5).to_string() + " " + blk_if(2).to_string())
  io_println(world, step_cont_range().to_string() + " " + step_cont_in().to_string())
  io_println(world, step_break_while(2).to_string() + " " + step_break_while(6).to_string())
  0
}
