// `x % 256 == 0` on Int8: 256 narrows to 0, so this is a division by zero,
// not the 8-bit power-of-two fold. `#verify` code panics with the Pion
// diagnostic; `plain` (the same test without `#verify`) traps like any other
// integer `%` by zero.

#verify
fn z256(x : Int8) -> Bool {
  x % 256 == 0
}

fn plain(x : Int8) -> Bool {
  x % 256 == 0
}

fn main(world : World) -> Int {
  let args = args_get(world)
  let x : Int8 = 3
  let r = if args.length() > 1 && args[1] == "plain" { plain(x) } else { z256(x) }
  io_println(world, if r { "true" } else { "false" })
  0
}
