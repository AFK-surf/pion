// `x % 2^k == 0` with a divisor the operand's width cannot represent (Int8
// `% 256`, UInt `% 4294967296U`) narrows it to 0: a division by zero, never
// the power-of-two fold. `#verify` code panics with the Pion diagnostic; plain
// code behaves exactly like the same `%` through a variable divisor on the
// same target (an x86_64 trap, no trap on ARM64, a Wasm32 trap).

#verify
fn v256(x : Int8) -> Bool {
  x % 256 == 0
}

#verify
fn v2_32(x : UInt) -> Bool {
  x % 4294967296U == 0U
}

fn plain_folded(x : Int8) -> Bool {
  x % 256 == 0
}

fn plain_unfolded(x : Int8, d : Int8) -> Bool {
  x % d == 0
}

fn main(world : World) -> Int {
  let args = args_get(world)
  let mode = if args.length() > 1 { args[1] } else { "" }
  let x : Int8 = 3
  let r = if mode == "verify8" {
    v256(x)
  } else if mode == "verify32" {
    v2_32(3U)
  } else if mode == "folded" {
    plain_folded(x)
  } else {
    plain_unfolded(x, 256)
  }
  io_println(world, if r { "true" } else { "false" })
  0
}
