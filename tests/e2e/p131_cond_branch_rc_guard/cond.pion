// Comparisons in `if` / `while` conditions (`qbe_emit_cond_branch_leaf`)
// whose owned left operand (a fresh String / StrView / Array / struct / enum)
// is followed by a right operand that may leave early: the left operand must
// be released exactly once on the completing and on every exiting path.

#derive(Eq)
struct Tag {
  name : String
  k : Int
}

#derive(Eq)
enum Shape {
  Dot(String)
  Pair(String, Int)
}

fn make_str(n : Int) -> String {
  "m" + n.to_string()
}

fn range_arr(n : Int) -> Array[Int] {
  let a : Array[Int] = []
  let mut i = 0
  while i < n {
    a.push(i * 3)
    i = i + 1
  }
  a
}

fn mk_tag(n : Int) -> Tag {
  Tag::{ name: make_str(n), k: n % 4 }
}

fn mk_shape(n : Int) -> Shape {
  if n % 2 == 0 {
    Shape::Dot(make_str(n))
  } else {
    Shape::Pair(make_str(n), n)
  }
}

fn check(n : Int) -> Result[String, String] {
  if n < 0 {
    Err("neg" + n.to_string())
  } else {
    Ok("m" + n.to_string())
  }
}

// 1. `==` with a `return` branch on the right.
fn eq_ret(n : Int) -> Int {
  if make_str(n) == (if n > 5 { return n } else { "m1" }) {
    1
  } else {
    0
  }
}

// `!=` as well.
fn ne_ret(n : Int) -> Int {
  if make_str(n) != (if n > 5 { return n * 10 } else { "m2" }) {
    1
  } else {
    0
  }
}

// 2. String order comparisons.
fn lt_ret(n : Int) -> Int {
  if make_str(n) < (if n > 5 { return n } else { "m3" }) {
    1
  } else if make_str(n) >= (if n == 4 { return 40 } else { "m4" }) {
    2
  } else {
    3
  }
}

// 3. `break` and `continue` on the right inside loops.
fn loop_exits(n : Int) -> Int {
  let mut hits = 0
  let mut i = 0
  while i < n {
    i = i + 1
    if make_str(i) == (if i % 3 == 0 { continue } else { make_str(i) }) {
      hits = hits + 1
    }
    if make_str(i) == (if i > 7 { break } else { "m5" }) {
      hits = hits + 100
    }
  }
  let mut j = 0
  while j < 20 {
    if make_str(j) != (if j > 4 { break } else { "never" }) {
      j = j + 1
    }
  }
  hits * 1000 + i * 10 + j
}

// 4. `?` on the right in a Result function.
fn try_eq(n : Int) -> Result[Int, String] {
  if make_str(n) == check(n - 3)? {
    Ok(1)
  } else {
    Ok(0)
  }
}

// 5. Other owned RC operands: Array[Int], a #derive(Eq) struct and enum with
// String fields, a StrView over a fresh String.
fn arr_ret(n : Int) -> Int {
  if range_arr(n) == (if n > 4 { return 0 - n } else { range_arr(n % 3) }) {
    1
  } else {
    0
  }
}

fn tag_ret(n : Int) -> Int {
  if mk_tag(n) == (if n > 5 { return n + 1000 } else { mk_tag(n % 2) }) {
    1
  } else {
    0
  }
}

fn shape_try(n : Int) -> Result[Int, String] {
  if mk_shape(n) != Shape::Dot(check(n - 2)?) {
    Ok(1)
  } else {
    Ok(0)
  }
}

fn view_ret(n : Int) -> Int {
  if make_str(n).as_view() == (if n > 5 { return n * 7 } else { "m2".as_view() }) {
    1
  } else {
    0
  }
}

// 6. The left operand itself leaves; the right operand is never evaluated.
fn lhs_exit(n : Int) -> Int {
  if (if n > 2 { return n + 500 } else { make_str(n) }) == make_str(n) {
    1
  } else {
    0
  }
}

fn res(r : Result[Int, String]) -> String {
  match r {
    Ok(v) => "ok " + v.to_string()
    Err(e) => "err " + e
  }
}

fn main(world : World) -> Int {
  io_println(world, "eq " + eq_ret(1).to_string() + " " + eq_ret(2).to_string() + " " + eq_ret(8).to_string())
  io_println(world, "ne " + ne_ret(2).to_string() + " " + ne_ret(3).to_string() + " " + ne_ret(6).to_string())
  io_println(world, "lt " + lt_ret(2).to_string() + " " + lt_ret(5).to_string() + " " + lt_ret(4).to_string() + " " + lt_ret(9).to_string())
  io_println(world, "loop " + loop_exits(5).to_string() + " " + loop_exits(12).to_string())
  io_println(world, "try " + res(try_eq(5)) + " | " + res(try_eq(3)) + " | " + res(try_eq(1)))
  io_println(world, "arr " + arr_ret(2).to_string() + " " + arr_ret(3).to_string() + " " + arr_ret(6).to_string())
  io_println(world, "tag " + tag_ret(1).to_string() + " " + tag_ret(4).to_string() + " " + tag_ret(7).to_string())
  io_println(world, "shape " + res(shape_try(4)) + " | " + res(shape_try(3)) + " | " + res(shape_try(1)))
  io_println(world, "view " + view_ret(2).to_string() + " " + view_ret(3).to_string() + " " + view_ret(6).to_string())
  io_println(world, "lhs " + lhs_exit(1).to_string() + " " + lhs_exit(3).to_string())
  // Many rounds of every path: a leak or a double release shows under
  // LeakSanitizer / AddressSanitizer and in the checksum.
  let mut acc = 0
  let mut i = 0
  while i < 3000 {
    let k = i % 11
    acc = acc + eq_ret(k) + ne_ret(k) + lt_ret(k) + loop_exits(k) + arr_ret(k)
    acc = acc + tag_ret(k) + view_ret(k) + lhs_exit(k)
    acc = acc + res(try_eq(k)).length() + res(shape_try(k)).length()
    i = i + 1
  }
  io_println(world, "rounds " + acc.to_string())
  0
}
