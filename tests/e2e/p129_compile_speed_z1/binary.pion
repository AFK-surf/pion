// Binary expressions through the frame stack of `check_binary_chain` and
// `qbe_emit_binary_chain`, and the lazily allocated left-operand guards: an
// owned String / Array left operand whose right operand leaves early through
// `?` or `return` must be released exactly once on both paths.

fn tag(n : Int) -> Result[String, String] {
  if n < 0 {
    Err("neg" + n.to_string())
  } else {
    Ok("t" + n.to_string())
  }
}

fn count(n : Int) -> Result[Int, String] {
  if n > 3 {
    Err("big" + n.to_string())
  } else {
    Ok(n * 7)
  }
}

fn range_arr(n : Int) -> Array[Int] {
  let a : Array[Int] = []
  let mut i = 0
  while i < n {
    a.push(i * i)
    i = i + 1
  }
  a
}

fn want(n : Int) -> Result[Array[Int], String] {
  if n > 3 {
    Err("want" + n.to_string())
  } else {
    Ok(range_arr(n))
  }
}

fn find(n : Int) -> Option[Int] {
  if n % 2 == 0 {
    Some(n / 2)
  } else {
    None
  }
}

// Owned String left operand, `?` on the right.
fn cat_try(s : String, n : Int) -> Result[String, String] {
  Ok((s + "-") + tag(n)?)
}

// Owned String left operand, `return` on the right.
fn cat_ret(s : String, n : Int) -> String {
  (s + "<") + (if n > 5 { return "ret" + n.to_string() } else { n.to_string() })
}

fn make_str(n : Int) -> String {
  "m" + n.to_string()
}

// A fresh owned String / Array from a call (not a `+` chain, which is
// flattened into one concatenation) on the left of `==`, and a right operand
// whose branch leaves through `return`: the guard of `qbe_emit_binary_chain`
// (a value context; an `if` condition goes through `qbe_emit_cond_branch`).
fn str_eq_ret(n : Int) -> Int {
  let same = make_str(n) == (if n > 5 { return n * 100 } else { "m" + (n % 3).to_string() })
  if same { 1 } else { 0 }
}

fn arr_eq_ret(n : Int) -> Int {
  let same = range_arr(n) == (if n > 4 { return 0 - n } else { range_arr(n % 3) })
  if same { 1 } else { 0 }
}

// Owned String left operand compared with a right operand that may leave.
fn str_eq_try(n : Int, m : Int) -> Result[Bool, String] {
  Ok(("t" + n.to_string()) == tag(m)?)
}

// Owned Array left operand compared with a right operand that may leave.
fn arr_len_try(n : Int, m : Int) -> Result[Int, String] {
  Ok(range_arr(n).length() + count(m)?)
}

fn arr_eq_try(n : Int, m : Int) -> Result[Bool, String] {
  Ok(range_arr(n) == want(m)?)
}

// Borrowed left operand: a parameter needs no guard.
fn borrowed_try(s : String, n : Int) -> Result[Bool, String] {
  Ok(s == tag(n)?)
}

// Short-circuit operators with a right operand that may leave.
fn logic_try(a : Int, b : Int) -> Result[Bool, String] {
  Ok((a > 0 && count(b)? > 0) || (a < -5 || count(b + 1)? == 14))
}

fn shifts(x : Int, s : Int) -> Int {
  ((x << 3) >> 1) + ((x >> s) << s) + (1 << s)
}

fn twice(d : Double, f : Float) -> Double {
  let g : Float = 2.0 * f
  2.0 * d + 2.0 * (d + 1.0) + g.to_double()
}

// `==` / `!=` whose left operand takes its type from the right one.
fn hint_eq(n : Int) -> Int {
  let mut r = 0
  if None == find(n) { r = r + 1 }
  if [] != range_arr(n) { r = r + 10 }
  if Some(n / 2) == find(n) { r = r + 100 }
  r
}

fn res(r : Result[String, String]) -> String {
  match r {
    Ok(v) => "ok " + v
    Err(e) => "err " + e
  }
}

fn resb(r : Result[Bool, String]) -> String {
  match r {
    Ok(v) => if v { "ok true" } else { "ok false" }
    Err(e) => "err " + e
  }
}

fn resi(r : Result[Int, String]) -> String {
  match r {
    Ok(v) => "ok " + v.to_string()
    Err(e) => "err " + e
  }
}

fn main(world : World) -> Int {
  let base = "base" + 7.to_string()
  io_println(world, res(cat_try(base, 3)) + " | " + res(cat_try(base, -4)))
  io_println(world, cat_ret(base, 2) + " | " + cat_ret(base, 9))
  io_println(world, resb(str_eq_try(5, 5)) + " | " + resb(str_eq_try(5, 6)) + " | " + resb(str_eq_try(5, -1)))
  io_println(world, resi(arr_len_try(4, 2)) + " | " + resi(arr_len_try(4, 9)))
  io_println(world, resb(arr_eq_try(3, 3)) + " | " + resb(arr_eq_try(2, 3)) + " | " + resb(arr_eq_try(2, 8)))
  io_println(world, resb(borrowed_try("t4", 4)) + " | " + resb(borrowed_try(base, -2)))
  io_println(world, resb(logic_try(1, 2)) + " | " + resb(logic_try(-1, 1)) + " | " + resb(logic_try(1, 7)) + " | " + resb(logic_try(-9, 7)) + " | " + resb(logic_try(-1, 9)))
  io_println(world, shifts(13, 2).to_string() + " " + shifts(-40, 3).to_string())
  io_println(world, twice(1.25, 0.5).to_string())
  io_println(world, str_eq_ret(1).to_string() + " " + str_eq_ret(2).to_string() + " " + str_eq_ret(4).to_string() + " " + str_eq_ret(7).to_string() + " | " + arr_eq_ret(2).to_string() + " " + arr_eq_ret(3).to_string() + " " + arr_eq_ret(4).to_string() + " " + arr_eq_ret(6).to_string())
  io_println(world, hint_eq(4).to_string() + " " + hint_eq(3).to_string() + " " + hint_eq(0).to_string())
  // Many rounds of both exits: a leaked or doubly released left operand shows
  // under LeakSanitizer / AddressSanitizer and in the checksum.
  let mut acc = 0
  let mut i = 0
  while i < 2000 {
    let k = i % 9 - 3
    acc = acc + res(cat_try(base + i.to_string(), k)).length()
    acc = acc + cat_ret(base, k + 3).length()
    acc = acc + resb(str_eq_try(k, k % 4)).length()
    acc = acc + resi(arr_len_try(k + 3, k)).length()
    acc = acc + resb(arr_eq_try(k + 3, k)).length()
    acc = acc + resb(logic_try(k, k + 2)).length()
    acc = acc + str_eq_ret(i % 9) + arr_eq_ret(i % 8)
    i = i + 1
  }
  io_println(world, "rounds " + acc.to_string())
  0
}
