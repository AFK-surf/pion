// Function bodies for the `inline_rc` pass (`irc_process_ssa`): with RC
// markers, without RC but with real calls (release only), with `call`-prefixed
// identifiers but no call, and with UTF-8 string literals. dev and --release
// must print the same output.

fn fib(n : Int) -> Int {
  if n < 2 {
    n
  } else {
    fib(n - 1) + fib(n - 2)
  }
}

// No RC: real calls only.
fn calls_only(a : Int, b : Int) -> Int {
  fib(a) * 3 + fib(b)
}

// No RC and no call: `call`-prefixed names (the function symbol
// `$pion_fn_callfoo` appears in its callers' bodies, the locals do not reach
// the SSA; `inline_rc_test.pion` covers `%call...` temporaries directly).
fn callfoo(x : Int) -> Int {
  let callbar = x * 3 + 1
  let call_ = callbar ^ x
  let callx2 = call_ + callbar
  callx2 - x
}

// RC markers: Strings and Arrays built, shared and dropped.
fn with_rc(n : Int) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < n {
    parts.push("p" + i.to_string())
    i = i + 1
  }
  let mut s = ""
  for p in parts {
    s = s + p + ","
  }
  s
}

// UTF-8 multi-byte literals.
fn greet(n : Int) -> String {
  "你好，" + n.to_string() + " 世界 \u{E9} 😀 " + with_rc(2)
}

fn utf8_len(n : Int) -> Int {
  let s = greet(n) + "中文"
  s.length() * 10 + n
}

fn main(world : World) -> Int {
  io_println(world, calls_only(10, 12).to_string())
  io_println(world, callfoo(7).to_string() + " " + callfoo(-3).to_string())
  io_println(world, with_rc(5))
  io_println(world, greet(42))
  io_println(world, utf8_len(9).to_string())
  let mut acc = 0
  let mut i = 0
  while i < 500 {
    acc = acc + utf8_len(i) + callfoo(i) + with_rc(i % 7).length()
    i = i + 1
  }
  io_println(world, "acc " + acc.to_string())
  0
}
