// Track P2 E2E test:
// 1. QBE SSA const rem -> div+mul+sub dedup (Int/Int64, rem-first & div-first,
//    across calls, mixed with UInt/UInt64, boundaries 0/+-1/INT_MIN/INT_MAX).
// 2. StringBuilder LICM: positive (revcomp-like), negative 1 (arg side effect),
//    negative 2 (custom MyBuf::write_byte).
// 3. StringBuilder::write_bytes fast/slow path: empty, exact cap-1, realloc,
//    temporary Bytes rvalue, embedded NUL and 0x80..0xFF raw bytes.

fn opaque_i64(x : Int64) -> Int64 {
  x ^ 0L
}

fn big_mul_small_step(v : Int64) -> (Int64, Int64) {
  let rem = v % 1000000000L
  let quot = v / 1000000000L
  (quot, rem)
}

fn div_before_rem_call(v : Int64) -> (Int64, Int64) {
  let quot = v / 1000000000L
  let _ = opaque_i64(quot)
  let rem = v % 1000000000L
  (quot, rem)
}

fn check_i32_pair(x : Int, d : Int, q : Int, r : Int) -> Unit {
  if q * d + r != x {
    panic("i32 identity failed")
  }
  let ad = if d < 0 { -d } else { d }
  let ar = if r < 0 { -r } else { r }
  if ar >= ad {
    panic("i32 remainder range failed")
  }
  if r != 0 && ((x < 0) != (r < 0)) {
    panic("i32 remainder sign failed")
  }
}

fn check_i64_pair(x : Int64, d : Int64, q : Int64, r : Int64) -> Unit {
  if q * d + r != x {
    panic("i64 identity failed")
  }
  let ad = if d < 0L { -d } else { d }
  let ar = if r < 0L { -r } else { r }
  if ar >= ad {
    panic("i64 remainder range failed")
  }
  if r != 0L && ((x < 0L) != (r < 0L)) {
    panic("i64 remainder sign failed")
  }
}

fn test_divrem_const_dedup() -> Unit {
  let xs32 : Array[Int] = [
    0, 1, -1, 2, -2, 3, -3, 7, -7, 10, -10,
    139967, 139968, 139969, -139968,
    999999999, 1000000000, -1000000000,
    2147483647, -2147483648,
  ]
  let mut i = 0
  while i < xs32.length() {
    let x = xs32[i]
    // rem before div
    let r3 = x % 3
    let q3 = x / 3
    check_i32_pair(x, 3, q3, r3)
    // div before rem
    let q7 = x / 7
    let r7 = x % 7
    check_i32_pair(x, 7, q7, r7)
    let r10 = x % 10
    let q10 = x / 10
    check_i32_pair(x, 10, q10, r10)
    let r139 = x % 139968
    let q139 = x / 139968
    check_i32_pair(x, 139968, q139, r139)
    let r1e9 = x % 1000000000
    let q1e9 = x / 1000000000
    check_i32_pair(x, 1000000000, q1e9, r1e9)
    // negative divisors
    let rn3 = x % -3
    let qn3 = x / -3
    check_i32_pair(x, -3, qn3, rn3)
    let qn7 = x / -7
    let rn7 = x % -7
    check_i32_pair(x, -7, qn7, rn7)
    let rn1e9 = x % -1000000000
    let qn1e9 = x / -1000000000
    check_i32_pair(x, -1000000000, qn1e9, rn1e9)
    // power-of-two divisors (untouched by rewrite)
    let r8 = x % 8
    let q8 = x / 8
    check_i32_pair(x, 8, q8, r8)
    let rn4 = x % -4
    let qn4 = x / -4
    check_i32_pair(x, -4, qn4, rn4)
    // d = 1
    if x / 1 != x || x % 1 != 0 {
      panic("i32 d=1 failed")
    }
    // d = -1 for non-INT_MIN
    if x != -2147483648 {
      if x / -1 != -x || x % -1 != 0 {
        panic("i32 d=-1 failed")
      }
    }
    i = i + 1
  }

  let xs64 : Array[Int64] = [
    0L, 1L, -1L, 3L, -3L, 7L, -7L, 10L, -10L,
    139968L, -139968L, 1000000000L, -1000000000L,
    1234567890123456789L, -1234567890123456789L,
    9223372036854775807L, -9223372036854775807L - 1L,
  ]
  i = 0
  while i < xs64.length() {
    let x = xs64[i]
    let (q1, r1) = big_mul_small_step(x)
    check_i64_pair(x, 1000000000L, q1, r1)
    let (q2, r2) = div_before_rem_call(x)
    if q1 != q2 || r1 != r2 {
      panic("div_before_rem_call mismatch")
    }
    let r3 = x % 3L
    let q3 = x / 3L
    check_i64_pair(x, 3L, q3, r3)
    let q7 = x / 7L
    let r7 = x % 7L
    check_i64_pair(x, 7L, q7, r7)
    let r10 = x % 10L
    let q10 = x / 10L
    check_i64_pair(x, 10L, q10, r10)
    let r139 = x % 139968L
    let q139 = x / 139968L
    check_i64_pair(x, 139968L, q139, r139)
    let rn3 = x % -3L
    let qn3 = x / -3L
    check_i64_pair(x, -3L, qn3, rn3)
    let qn7 = x / -7L
    let rn7 = x % -7L
    check_i64_pair(x, -7L, qn7, rn7)
    let rn1e9 = x % -1000000000L
    let qn1e9 = x / -1000000000L
    check_i64_pair(x, -1000000000L, qn1e9, rn1e9)
    i = i + 1
  }

  // Mix with UInt and UInt64 to ensure unsigned ops are unaffected
  let u32 : UInt = 4000000003U
  let uq32 = u32 / 1000000000U
  let ur32 = u32 % 1000000000U
  if uq32 != 4U || ur32 != 3U {
    panic("u32 div/rem failed")
  }
  let u64 : UInt64 = 18000000000000000007UL
  let uq64 = u64 / 1000000000UL
  let ur64 = u64 % 1000000000UL
  if uq64 != 18000000000UL || ur64 != 7UL {
    panic("u64 div/rem failed")
  }
}

struct MyBuf {
  arr : Array[Int]
}

fn MyBuf::write_byte(self : MyBuf, b : Byte) -> Unit {
  self.arr.push(b.to_int())
}

fn MyBuf::length(self : MyBuf) -> Int {
  self.arr.push(33)
  33
}

fn test_strbuf_licm_cases() -> Unit {
  // Positive: revcomp-like loop
  let seq : Array[Int] = [0, 1, 2, 3, 2, 1, 0]
  let comp : Array[Byte] = [b'T', b'G', b'C', b'A']
  let sb = StringBuilder::new()
  let mut i = seq.length() - 1
  while i >= 0 {
    let b = seq[i]
    sb.write_byte(comp[b])
    i = i - 1
  }
  if sb.to_string() != "TGCA" + "CGT" {
    panic("revcomp positive failed: " + sb.to_string())
  }

  // Negative 1: arg side effect triggers arr realloc
  let arr1 : Array[Int] = [1, 2, 3, 4]
  let sb1 = StringBuilder::new()
  let mut sum1 = 0
  i = 0
  while i < 40 {
    sum1 = sum1 + arr1[i]
    sb1.write_byte({ arr1.push(i + 10); b'a' })
    i = i + 1
  }
  // arr1 starts [1,2,3,4], then pushes 10,11,...,49 -> indices 0..39 sum to 1+2+3+4 + sum(10..45)
  let mut want1 = 1 + 2 + 3 + 4
  let mut k = 0
  while k < 36 {
    want1 = want1 + (k + 10)
    k = k + 1
  }
  if sum1 != want1 || sb1.length() != 40 {
    panic("neg1 failed")
  }

  // Negative 2: custom MyBuf::write_byte mutating aliased arr
  let arr2 : Array[Int] = [5, 6, 7, 8]
  let mb = MyBuf::{ arr: arr2 }
  let mut sum2 = 0
  i = 0
  while i < 40 {
    sum2 = sum2 + arr2[i]
    mb.write_byte(b'!')
    i = i + 1
  }
  let want2 = 5 + 6 + 7 + 8 + 36 * 33
  if sum2 != want2 || arr2.length() != 44 {
    panic("neg2 failed")
  }

  // Negative 3: inner `let sb = mb` shadowing outer StringBuilder
  let arr3 : Array[Int] = [5, 6, 7, 8]
  let sb_outer = StringBuilder::new()
  let mb3 = MyBuf::{ arr: arr3 }
  let mut sum3 = 0
  i = 0
  while i < 40 {
    let sb_outer = mb3
    sum3 = sum3 + arr3[i]
    sb_outer.write_byte(b'!')
    i = i + 1
  }
  if sum3 != 1214 || arr3.length() != 44 || sb_outer.length() != 0 {
    panic("neg3 shadowed sb failed")
  }

  // Negative 4: local closure parameter named `panic` inside sb.write_byte(panic())
  let arr4 : Array[Int] = [1, 2, 3, 4]
  let res4 = run_local_closure_panic(arr4, fn() -> Byte {
    arr4.push(25)
    b'p'
  })
  let want4 = 1 + 2 + 3 + 4 + 36 * 25
  if res4 != want4 || arr4.length() != 44 {
    panic("neg4 local closure panic failed")
  }

  // Negative 5: `opt is Some(sb) && { sb.write_byte(b'!'); true }` shadowing outer StringBuilder
  let arr5 : Array[Int] = [5, 6, 7, 8]
  let sb5 = StringBuilder::new()
  let opt5 : Option[MyBuf] = Some(MyBuf::{ arr: arr5 })
  let mut sum5 = 0
  i = 0
  while i < 40 {
    sum5 = sum5 + arr5[i]
    if opt5 is Some(sb5) && { sb5.write_byte(b'!'); true } {
      sum5 = sum5 + 0
    }
    i = i + 1
  }
  if sum5 != 1214 || arr5.length() != 44 || sb5.length() != 0 {
    panic("neg5 and-rhs is shadow sb failed")
  }

  // Negative 6: `match i { _ if opt is Some(sb) => sb.write_byte(b'!') }` shadowing outer StringBuilder
  let arr6 : Array[Int] = [5, 6, 7, 8]
  let sb6 = StringBuilder::new()
  let opt6 : Option[MyBuf] = Some(MyBuf::{ arr: arr6 })
  let mut sum6 = 0
  i = 0
  while i < 40 {
    sum6 = sum6 + arr6[i]
    match i {
      _ if opt6 is Some(sb6) => sb6.write_byte(b'!')
      _ => ()
    }
    i = i + 1
  }
  if sum6 != 1214 || arr6.length() != 44 || sb6.length() != 0 {
    panic("neg6 match-guard is shadow sb failed")
  }

  // Negative 7: flat POD val struct borrowed element with sequential `let sb = pb` shadowing
  let pod_arr : Array[PodPair] = [PodPair::{ a: 7, b: 11 }]
  let pb = PodBuf::{ arr: pod_arr }
  let pod_res = run_flat_pod_shadow_sb(pod_arr, pb)
  if pod_res != 18 || pod_arr[0].a != 9 || pod_arr[0].b != 33 {
    panic("neg7 flat pod shadow sb failed")
  }

  // Negative 8: match guard `opt is Some(x)` shadowing outer `x : String` inside `sb.write_byte(match ...)`
  let arr8 : Array[Int] = [5, 6, 7, 8]
  let sb8 = StringBuilder::new()
  let x = "abc"
  let opt8 : Option[MyBuf] = Some(MyBuf::{ arr: arr8 })
  let mut sum8 = 0
  i = 0
  while i < 40 {
    sum8 = sum8 + arr8[i]
    sb8.write_byte(match i {
      _ if opt8 is Some(x) => x.length().to_byte()
      _ => b'?'
    })
    i = i + 1
  }
  if sum8 != 1214 || arr8.length() != 44 || sb8.length() != 40 || x.length() != 3 {
    panic("neg8 match-guard shadow str len failed")
  }

  // Negative 9: inner `let scratch = alias` shadowing outer unfrozen local array `scratch`
  let arr9 : Array[Int] = [5, 6, 7, 8]
  let (sum9, scratch_len9) = run_shadow_unfrozen_scratch(arr9, arr9)
  if sum9 != 1214 || arr9.length() != 44 || scratch_len9 != 1 {
    panic("neg9 shadow unfrozen scratch failed")
  }
}

fn run_shadow_unfrozen_scratch(arr : Array[Int], alias : Array[Int]) -> (Int, Int) {
  let sb = StringBuilder::new()
  let scratch : Array[Int] = [0]
  let mut i = 0
  let mut sum = 0
  while i < 40 {
    sum = sum + arr[i]
    let scratch = alias
    scratch.push(33)
    sb.write_byte(b'!')
    i = i + 1
  }
  if sb.length() != 40 {
    return (-1, -1)
  }
  (sum, scratch.length())
}

val struct PodPair {
  a : Int
  b : Int
}

struct PodBuf {
  arr : Array[PodPair]
}

fn PodBuf::write_byte(self : PodBuf, b : Byte) -> Unit {
  self.arr[0] = PodPair::{ a: 9, b: b.to_int() }
}

fn run_flat_pod_shadow_sb(arr : Array[PodPair], pb : PodBuf) -> Int {
  let sb = StringBuilder::new()
  let saved = arr[0]
  let sb = pb
  sb.write_byte(b'!')
  saved.a + saved.b
}

fn run_local_closure_panic(arr : Array[Int], panic : () -> Byte) -> Int {
  let sb = StringBuilder::new()
  let mut i = 0
  let mut sum = 0
  while i < 40 {
    sum = sum + arr[i]
    sb.write_byte(panic())
    i = i + 1
  }
  if sb.length() != 40 {
    return -1
  }
  sum
}

fn make_temp_bytes(n : Int, seed : Int) -> Bytes {
  let bs = Bytes::new(n)
  let mut i = 0
  while i < n {
    bs[i] = ((i * 31 + seed) & 255).to_byte()
    i = i + 1
  }
  bs
}

fn test_write_bytes_fast_and_slow() -> Unit {
  // 1. Empty Bytes
  let sb = StringBuilder::with_capacity(16)
  let empty = Bytes::new(0)
  sb.write_bytes(empty)
  if sb.length() != 0 || sb.to_string() != "" {
    panic("empty write_bytes failed")
  }

  // 2. Exact cap - 1 boundary (fast path: slen + blen == cap - 1 < cap)
  let b15 = "0123456789abcde".to_bytes()
  sb.write_bytes(b15)
  if sb.length() != 15 || sb.to_string() != "0123456789abcde" {
    panic("exact cap-1 write_bytes failed")
  }

  // 3. Cross realloc boundary (slow path: 15 + 1 == 16, not < 16)
  sb.write_bytes("f".to_bytes())
  if sb.length() != 16 || sb.to_string() != "0123456789abcdef" {
    panic("cross cap boundary write_bytes failed")
  }

  // 4. Temporary Bytes expression (non-borrowed rvalue) + multiple growth steps
  let sb2 = StringBuilder::with_capacity(8)
  let mut total = 0
  let mut round = 0
  while round < 10 {
    let sz = round * 7 + 3
    sb2.write_bytes(make_temp_bytes(sz, round))
    total = total + sz
    round = round + 1
  }
  if sb2.length() != total {
    panic("temp write_bytes length mismatch")
  }

  // 5. Embedded NUL (0x00) and non-UTF-8 raw bytes (0x80..0xFF) on both fast and slow paths
  let raw_arr : Array[Byte] = [b'\x00', b'A', b'\x00', b'\x80', b'\xFE', b'\xFF', b'Z', b'\x00']
  let raw = Bytes::new(8)
  let mut ri = 0
  while ri < 8 {
    raw[ri] = raw_arr[ri]
    ri = ri + 1
  }
  // Fast path (preallocated cap=64)
  let sb_fast = StringBuilder::with_capacity(64)
  sb_fast.write_bytes(raw)
  sb_fast.write_bytes(raw)
  let s_fast = sb_fast.to_string()
  // Slow path (tiny cap=4 forces realloc during write_bytes)
  let sb_slow = StringBuilder::with_capacity(4)
  sb_slow.write_bytes(raw)
  sb_slow.write_bytes(raw)
  let s_slow = sb_slow.to_string()
  if s_fast.length() != 16 || s_slow.length() != 16 || s_fast != s_slow {
    panic("raw bytes fast vs slow mismatch")
  }
  let bf = s_fast.to_bytes()
  let bs = s_slow.to_bytes()
  let mut bi = 0
  while bi < 16 {
    let want = raw_arr[bi % 8]
    if bf[bi] != want || bs[bi] != want {
      panic("raw byte content mismatch")
    }
    bi = bi + 1
  }

  // 6. Real slow-path realloc boundary: with_capacity(64) -> fill 63 bytes (exact cap-1),
  //    then append temporary Bytes with embedded NUL + 0x80..0xFF crossing 64 to trigger realloc.
  let sb_real_slow = StringBuilder::with_capacity(64)
  let prefix63 = Bytes::new(63)
  let mut pi = 0
  while pi < 63 {
    prefix63[pi] = (65 + (pi % 26)).to_byte()
    pi = pi + 1
  }
  sb_real_slow.write_bytes(prefix63)
  if sb_real_slow.length() != 63 {
    panic("prefix63 length mismatch")
  }
  // Temporary Bytes expression with embedded NUL & high bytes -> 63 + 16 = 79 >= 64 (forces slow path + realloc)
  sb_real_slow.write_bytes({
    let t = Bytes::new(16)
    let mut ti = 0
    while ti < 16 {
      t[ti] = raw_arr[ti % 8]
      ti = ti + 1
    }
    t
  })
  let s_real = sb_real_slow.to_string()
  if s_real.length() != 79 {
    panic("real slow path length mismatch")
  }
  let b_real = s_real.to_bytes()
  pi = 0
  while pi < 63 {
    if b_real[pi] != (65 + (pi % 26)).to_byte() {
      panic("real slow path prefix byte mismatch")
    }
    pi = pi + 1
  }
  let mut ti = 0
  while ti < 16 {
    if b_real[63 + ti] != raw_arr[ti % 8] {
      panic("real slow path suffix byte mismatch")
    }
    ti = ti + 1
  }
}

pub fn main(w : World) -> Int {
  test_divrem_const_dedup()
  test_strbuf_licm_cases()
  test_write_bytes_fast_and_slow()
  io_println(w, "p_clbg_p2_divrem_licm_strbuf ok")
  0
}
