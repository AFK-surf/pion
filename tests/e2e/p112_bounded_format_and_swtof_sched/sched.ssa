# P112: vendor/qbe/gcm.c `groupconverts`. In a loop block (<= 192
# instructions, no store / call, only virtual temporaries) with 2..4
# `swtof` / `Kd`, the conversions and their in-block integer non-comparison
# dependencies are stably moved first; floating arithmetic keeps its order.
# conv2 / conv3 / conv4 must be grouped; every neg_* keeps source order.
# Each function wraps in 32 bits (add / mul / sub / xor with shl) and is
# checked bit for bit against driver.c for the 625 inputs in
# {0, 1, -1, INT32_MIN, INT32_MAX}^4.

export function d $conv2(w %a, w %b, w %c0, w %d) {
@start
  jmp @loop
@loop
  %i =w phi @start 0, @loop %i1
  %s =d phi @start d_0, @loop %s9
  %x1 =w add %a, %i
  %f1 =d swtof %x1
  %s1 =d add %s, %f1
  %m2 =w mul %b, 3
  %x2 =w add %m2, %i
  %f2 =d swtof %x2
  %s2 =d sub %s1, %f2
  %s9 =d add %s2, d_0.25
  %i1 =w add %i, 1
  %c =w csltw %i1, 3
  jnz %c, @loop, @end
@end
  ret %s9
}

export function d $conv3(w %a, w %b, w %c0, w %d) {
@start
  jmp @loop
@loop
  %i =w phi @start 0, @loop %i1
  %s =d phi @start d_0, @loop %s9
  %x1 =w add %a, %i
  %f1 =d swtof %x1
  %s1 =d add %s, %f1
  %m2 =w mul %b, 3
  %x2 =w add %m2, %i
  %f2 =d swtof %x2
  %s2 =d sub %s1, %f2
  %x3 =w sub %c0, %i
  %f3 =d swtof %x3
  %s3 =d mul %s2, d_0.5
  %s4 =d add %s3, %f3
  %s9 =d add %s4, d_0.25
  %i1 =w add %i, 1
  %c =w csltw %i1, 3
  jnz %c, @loop, @end
@end
