# A store in the block.

export function d $neg_store(w %a, w %b, w %c0, w %d, l %p) {
@start
  jmp @loop
@loop
  %i =w phi @start 0, @loop %i1
  %s =d phi @start d_0, @loop %s9
  %x1 =w add %a, %i
  %f1 =d swtof %x1
  %s1 =d add %s, %f1
  storew %x1, %p
  %m2 =w mul %b, 3
  %x2 =w add %m2, %i
  %f2 =d swtof %x2
  %s2 =d sub %s1, %f2
  %x3 =w sub %c0, %i
  %f3 =d swtof %x3
  %s3 =d mul %s2, d_0.5
  %s4 =d add %s3, %f3
  %t4 =w shl %i, 30
  %x4 =w xor %d, %t4
  %f4 =d swtof %x4
  %s5 =d mul %s4, %f4
  %s9 =d add %s5, d_0.25
  %i1 =w add %i, 1
  %c =w csltw %i1, 3
  jnz %c, @loop, @end
@end
  ret %s9
}

