// P112: in a native hot loop, a string `+` chain of at most 8 parts whose
// literals are ASCII of at most 8 bytes and whose other parts are
// `.to_string()` of `Int` / `Int64` locals is formatted into one bounded stack
// buffer and copied once by `pion_str_from_cstr`. Everything else (longer or
// non-ASCII literals, > 8 parts, other receivers, trait dispatch, code outside
// loops, Wasm32) keeps the original lowering. Outputs must match bit for bit.

pub trait Render {
  to_string(self : Self) -> String
}

impl Render for Int {
  fn to_string(self : Int) -> String {
    "int#" + (self * 2).to_string()
  }
}

fn int_min32() -> Int {
  -2147483647 - 1
}

fn int_min64() -> Int64 {
  -9223372036854775807L - 1L
}

fn show(s : String) -> String {
  s.replace("\0", "<NUL>") + " (" + s.length().to_string() + "B)"
}

// 2 parts, `Int` local.
fn two_int(xs : Array[Int]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    out.push("k" + v.to_string())
    j = j + 1
  }
  out
}

// 2 parts, `Int64` local.
fn two_i64(ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  for y in ys {
    out.push("n=" + y.to_string())
  }
  out
}

// 3 parts; an exactly 8-byte literal.
fn three(xs : Array[Int]) -> Array[String] {
  let out : Array[String] = []
  for v in xs {
    out.push("12345678" + v.to_string() + "]")
  }
  out
}

// 4 parts, mixed widths.
fn four(xs : Array[Int], ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    let w = ys[j]
    out.push("k_" + v.to_string() + "_" + w.to_string())
    j = j + 1
  }
  out
}

// 5 parts, the same receiver twice.
fn five(xs : Array[Int], ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    let w = ys[j]
    out.push(v.to_string() + "," + w.to_string() + "," + v.to_string())
    j = j + 1
  }
  out
}

// 6 parts; the mutable loop counter is a receiver too.
fn six(xs : Array[Int], ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    let w = ys[j]
    out.push("x" + v.to_string() + "y" + w.to_string() + "z" + j.to_string())
    j = j + 1
  }
  out
}

// 7 parts with embedded NUL bytes.
fn seven(xs : Array[Int], ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    let w = ys[j]
    out.push("a\0b" + v.to_string() + "\0" + w.to_string() + "" + v.to_string() + "\0\0")
    j = j + 1
  }
  out
}

// 8 parts, all integers: the widest buffer (8 * 20 + 1 bytes).
fn eight(xs : Array[Int], ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    let w = ys[j]
    out.push(
      w.to_string() + w.to_string() + w.to_string() + w.to_string() + v.to_string() + w.to_string() + w.to_string() + w.to_string(),
    )
    j = j + 1
  }
  out
}

// 2 parts, a trailing literal.
fn tail_lit(xs : Array[Int]) -> Array[String] {
  let out : Array[String] = []
  for v in xs {
    out.push(v.to_string() + "!")
  }
  out
}

// 2 parts, both integers.
fn two_ints(xs : Array[Int], ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    let w = ys[j]
    out.push(v.to_string() + w.to_string())
    j = j + 1
  }
  out
}

// Right-nested chain: `"[ " + (v.to_string() + "]")`.
fn right_nest(ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  for w in ys {
    out.push("[ " + (w.to_string() + "]"))
  }
  out
}

// Nested loops reuse the same buffer every iteration.
fn nested(xs : Array[Int]) -> Int {
  let mut total = 0
  for a in xs {
    for b in xs {
      let s = "<" + a.to_string() + "|" + b.to_string() + ">"
      total = total + s.length() + s.code_unit_at(s.length() - 2)
    }
  }
  total
}

// Fallback: a 9-byte literal.
fn long_lit(xs : Array[Int]) -> Array[String] {
  let out : Array[String] = []
  for v in xs {
    out.push("123456789" + v.to_string())
  }
  out
}

// Fallback: a non-ASCII literal.
fn non_ascii(xs : Array[Int]) -> Array[String] {
  let out : Array[String] = []
  for v in xs {
    out.push("é" + v.to_string() + "!")
  }
  out
}

// Fallback: 9 parts.
fn nine(xs : Array[Int], ys : Array[Int64]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let v = xs[j]
    let w = ys[j]
    out.push(v.to_string() + "." + w.to_string() + "." + v.to_string() + "." + w.to_string() + "." + v.to_string())
    j = j + 1
  }
  out
}

// Fallback: receivers that are not plain `Int` / `Int64` locals.
fn other_recv(xs : Array[Int], us : Array[UInt]) -> Array[String] {
  let out : Array[String] = []
  let mut j = 0
  while j < xs.length() {
    let u = us[j]
    out.push("u" + u.to_string() + "/" + (xs[j] - 1).to_string())
    j = j + 1
  }
  out
}

// Fallback: trait dispatch.
fn wrap[T : Render](vs : Array[T]) -> Array[String] {
  let out : Array[String] = []
  for v in vs {
    out.push("[" + v.to_string() + "]")
  }
  out
}

// Fallback: outside any loop.
fn cold(v : Int, w : Int64) -> String {
  "c" + v.to_string() + ":" + w.to_string()
}

fn dump(w : World, tag : String, rows : Array[String]) -> Unit {
  for r in rows {
    io_println(w, tag + " " + show(r))
  }
}

fn main(w : World) -> Unit {
  let xs = [int_min32(), 2147483647, -1, 0, 1, 42, -100000]
  let ys = [int_min64(), 9223372036854775807L, -1L, 0L, 1L, -2147483649L, 2147483648L]
  let us = [4294967295U, 0U, 1U, 2147483648U, 7U, 8U, 9U]
  dump(w, "two_int", two_int(xs))
  dump(w, "two_i64", two_i64(ys))
  dump(w, "three", three(xs))
  dump(w, "four", four(xs, ys))
  dump(w, "five", five(xs, ys))
  dump(w, "six", six(xs, ys))
  dump(w, "seven", seven(xs, ys))
  dump(w, "eight", eight(xs, ys))
  dump(w, "tail_lit", tail_lit(xs))
  dump(w, "two_ints", two_ints(xs, ys))
  dump(w, "right_nest", right_nest(ys))
  io_println(w, "nested " + nested(xs).to_string())
  dump(w, "long_lit", long_lit(xs))
  dump(w, "non_ascii", non_ascii(xs))
  dump(w, "nine", nine(xs, ys))
  dump(w, "other_recv", other_recv(xs, us))
  dump(w, "wrap", wrap(xs))
  io_println(w, "cold " + show(cold(int_min32(), int_min64())))
  // Many short keys through a map, as in `hashmap_str`.
  let m : Map[String, Int] = Map([])
  let mut i = -500
  while i < 500 {
    let t = i * 7
    m.set("k_" + i.to_string() + "_" + t.to_string(), i)
    i = i + 1
  }
  let mut hits = 0
  let mut k = -600
  while k < 600 {
    let t = k * 7
    match m.get("k_" + k.to_string() + "_" + t.to_string()) {
      Some(v) => hits = hits + v + 1000
      None => ()
    }
    k = k + 1
  }
  io_println(w, "map " + m.length().to_string() + " " + hits.to_string())
}
