pub struct S {
  mut x : Int
  mut y : Int
}

#verify
pub fn swap(mut a : Int, mut b : Int) -> Unit {
  let t = a
  a = b
  b = t
}

#verify_opaque
pub fn trusted(x : Int) -> Int {
  x
}

#verify
pub fn sum(xs : Array[Int]) -> Int {
  let ys = xs.copy()
  let mut t = trusted(0)
  for v in ys {
    t = t + v
  }
  t + xs.length()
}

pub fn run() -> Int {
  let mut s = S::{ x: 1, y: 2 }
  swap(mut s.x, mut s.y)
  s.x + sum([1, 2, 3])
}
