# Minimal reproducers of vendor/qbe miscompilations and asm bugs found by
# qbe-tv + differential fuzzing (B1-B6) and Lean-model review (B7-B13). driver.c checks exact results;
# scripts/test-tv.sh [5/5] builds them through text asm and --obj.

# B1 gvn.c dedupjmp: jnz tests the low 32 bits, 1<<32 is false.
export function l $bug1_dedupjmp_lowbits() {
@start
	jnz 4294967296, @t, @f
@t
	jmp @j
@f
	jmp @j
@j
	%r =l phi @t 1, @f 2
	ret %r
}

# B2 copy.c phicopyref: the l phi must not be replaced by the earlier,
# otherwise equal, w phi (it would drop the high 32 bits).
export function l $bug2_phi_class(w %a, l %c, l %d) {
@start
	jnz %a, @t, @f
@t
	jmp @j
@f
	jmp @j
@j
	%w =w phi @t %c, @f %d
	%x =l phi @t %c, @f %d
	%r =l sub 0, %x
	ret %r
}

# B3 copy.c dwl: a w shift by 32 is a shift by 0, the and must stay.
export function w $bug3_dwl_shr32(l %d) {
@start
	%h =w extuh %d
	%s =w shr %h, 32
	%r =w and %s, 3
	ret %r
}

# B4 amd64/isel.c: jnz/sel test the low 32 bits, not the 64-bit ZF of an
# l-class and/neg.
export function w $bug4a_amd64_jnz_l_and(l %c) {
@start
	%t =l and %c, -4294967296
	jnz %t, @nz, @z
@nz
	ret 1
@z
	ret 2
}

export function w $bug4b_amd64_jnz_l_neg(l %c) {
@start
	%t =l neg %c
	jnz %t, @nz, @z
@nz
	ret 1
@z
	ret 2
}

export function w $bug4c_amd64_sel_l_and(l %c, l %m, w %x, w %y) {
@start
	%t =l and %c, %m
	jnz %t, @a, @b
@a
	jmp @j
@b
	jmp @j
@j
	%r =w phi @a %x, @b %y
	ret %r
}

# B5 ops.h: an x86 shift by a count that is 0 mod the width leaves the
# flags alone, so it cannot provide ZF to jnz.
export function w $bug5_amd64_shift_zflag(w %a, w %b, l %c) {
@start
	%k =w and %b, %c
	%s =w shl %a, %k
	jnz %s, @nz, @z
@nz
	ret 1
@z
	ret 2
}

# B6 amd64/emit.c: immediate shift counts are emitted masked to a byte
# (as amd64/elf.c does); `shlq $4294967295` is rejected by as.
export function l $bug6_amd64_shift_imm(l %c, w %a) {
@start
	%r0 =l shl %c, -1
	%r1 =l shr %c, 4294967360
	%r2 =w sar %a, -31
	%r3 =l extsw %r2
	%r4 =l xor %r0, %r1
	%r =l xor %r4, %r3
	ret %r
}

# B7 copy.c dwl: a phi that failed the width check in the first arm of an
# and must not count as narrow when the second arm reaches it again.
export function w $bug7_dwl_phi_retry(w %c, w %x, w %y) {
@start
	jnz %c, @a, @b
@a
	jmp @j
@b
	jmp @j
@j
	%p =w phi @a %x, @b %y
	%o =w or %p, 1
	%t =w and %p, %o
	%r =w and %t, 65535
	ret %r
}

# B8 copy.c dwl: %b is narrow only if %a is (cycle); once %a fails, %b's
# assumption must be dropped too before the second arm of the and.
export function w $bug8_dwl_phi_cycle(w %c, w %k, w %x) {
@start
	jmp @h
@h
	%a =w phi @l %b, @start %x
	jnz %c, @l1, @l2
@l1
	jmp @l
@l2
	jmp @l
@l
	%b =w phi @l1 %a, @l2 0
	%o =w or %b, 1
	%t =w and %a, %o
	%r =w and %t, 65535
	jnz %k, @h, @e
@e
	ret %r
}

# B9 gvn.c propjnz0: jnz tests the low 32 bits only; the zero branch must
# not rewrite a 64-bit ret of the tested temp to 0.
export function l $bug9_gvn_jnz_retl(l %x) {
@start
	jnz %x, @nz, @z
@nz
	ret 7
@z
	ret %x
}

# B10 load.c loadopt: a halfword store writes 16 bits; forwarding it to a
# load at offset 1 must mask the bits shifted down from above them.
export function w $bug10_load_shr_mask(w %v) {
@start
	%s =l alloc4 4
	storew 0, %s
	storeh %v, %s
	%p =l add %s, 1
	%r =w loaduh %p
	ret %r
}

# B11 mem.c promote: a 4-byte slot read with an l-class loadsw/loaduw
# must extend the low 32 bits, whatever the store class.
export function l $bug11a_promote_loadsw(l %x) {
@start
	%s =l alloc4 4
	storew %x, %s
	%r =l loadsw %s
	ret %r
}

export function l $bug11b_promote_loaduw(l %x) {
@start
	%s =l alloc4 4
	storew %x, %s
	%r =l loaduw %s
	ret %r
}

export function l $bug11c_promote_s_loadsw(w %x) {
@start
	%f =s cast %x
	%s =l alloc4 4
	stores %f, %s
	%r =l loadsw %s
	ret %r
}

export function l $bug11d_promote_s_loaduw(w %x) {
@start
	%f =s cast %x
	%s =l alloc4 4
	stores %f, %s
	%r =l loaduw %s
	ret %r
}

# B12 copy.c copyref: `cne 0` of a 0/1 w temp is the temp itself only for
# a w result; an l result must not be replaced by the narrower w temp.
export function l $bug12_cnew_l_result(w %a) {
@start
	%c =w csltw %a, 0
	%r =l cnew %c, 0
	ret %r
}

# B7b copy.c dwl: nested cycle q = phi(p, bad), p = phi(q, 0); refuting q in
# the first arm of the and must also drop p's mark, so the cne stays.
export function w $bug7b_dwl_nested_cycle(w %c, w %k, w %bad) {
@start
	jmp @h
@h
	%q =w phi @l %p, @start %bad
	jnz %c, @l1, @l2
@l1
	jmp @l
@l2
	jmp @l
@l
	%p =w phi @l1 %q, @l2 0
	%r =w and %q, %p
	%z =w cnew %r, 0
	jnz %k, @h, @e
@e
	ret %z
}

# B13 copy.c phicopyref: a 0/1 phi equals the dominating jnz argument only
# when that w temp is as wide as the phi; an l phi must stay.
export function l $bug13_phi_width_l(w %x) {
@start
	%c =w csltw %x, 0
	%t =w xor %c, 1
	jnz %t, @yes, @no
@yes
	jmp @join
@no
	jmp @join
@join
	%p =l phi @yes 1, @no 0
	%r =l xor %p, 2
	ret %r
}

export function w $bug13_phi_width_w(w %x) {
@start
	%c =w csltw %x, 0
	%t =w xor %c, 1
	jnz %t, @yes, @no
@yes
	jmp @join
@no
	jmp @join
@join
	%p =w phi @yes 1, @no 0
	%r =w xor %p, 2
	ret %r
}
