///| Integer functions whose QBE optimisation (load elimination, GVN, GCM)
///| `scripts/test-tv.sh` validates with `qbe-tv --trace`: constant folding,
///| common subexpressions, algebraic identities, constant reassociation,
///| loop-invariant code and phis, diamonds, branch facts, array reads and
///| writes with calls, and safe / possibly trapping divisions.

pub fn fold_consts() -> Int {
  let a = 6 * 7
  let b = a - 2
  (b << 2) + (100 / 4) - (17 % 5)
}

pub fn fold_wide() -> Int64 {
  let x = 0x1234_5678L * 16L
  (x >> 3) ^ 0xFFL
}

pub fn cse(a : Int, b : Int) -> Int {
  let x = (a + b) * (a - b)
  let y = (a + b) * (a - b)
  x + y + (a + b)
}

pub fn identities(x : Int, y : Int) -> Int {
  let a = x + 0
  let b = a * 1
  let c = b - b
  let d = (y | 0) & -1
  let e = d ^ 0
  b + c + e + (x & x) + (y | y) - (x ^ x)
}

pub fn reassoc(x : Int) -> Int {
  let a = x + 3
  let b = a + 5
  let c = b - 2
  c * 4
}

pub fn reassoc64(x : Int64) -> Int64 {
  ((x + 10L) + 20L) & 0xFFFFL
}

pub fn masks(x : Int) -> Int {
  let lo = x & 0xFF
  let hi = (x >> 8) & 0xFF
  (lo | (hi << 8)) & 0xFFFF
}

pub fn unsigned_ops(a : UInt, b : UInt) -> UInt {
  let s = a + b
  let m = s * 8U
  let d = m / 16U
  d % 32U
}

pub fn shifts64(a : UInt64, n : Int) -> UInt64 {
  let k = n & 31
  (a << k) | (a >> 7)
}

pub fn sum_to(n : Int) -> Int {
  let mut s = 0
  let mut i = 0
  while i < n {
    s = s + i * 2
    i = i + 1
  }
  s
}

pub fn invariant_loop(n : Int, a : Int, b : Int) -> Int {
  let mut s = 0
  let mut i = 0
  while i < n {
    let k = a * b + 7
    s = s + k + i
    i = i + 1
  }
  s
}

pub fn nested_loops(n : Int) -> Int {
  let mut t = 0
  for i in 0..<n {
    for j in 0..<i {
      t = t + (i ^ j)
    }
  }
  t
}

pub fn diamond(x : Int, y : Int) -> Int {
  let r = if x < y {
    x * 2
  } else if x == y {
    0
  } else {
    y * 3
  }
  r + 1
}

pub fn branch_facts(x : Int) -> Int {
  if x == 0 {
    x + 5
  } else {
    if x != 0 {
      x - 1
    } else {
      99
    }
  }
}

pub fn select_bool(a : Int, b : Int) -> Bool {
  a < b && b < 100
}

pub fn clamp(x : Int, lo : Int, hi : Int) -> Int {
  if x < lo {
    lo
  } else if x > hi {
    hi
  } else {
    x
  }
}

pub fn gcd(a0 : Int, b0 : Int) -> Int {
  let mut a = a0
  let mut b = b0
  while b != 0 {
    let t = a % b
    a = b
    b = t
  }
  a
}

pub fn safe_div(x : Int) -> Int {
  (x / 8) + (x % 3) + (x / -1)
}

pub fn maybe_trap(x : Int, y : Int, c : Bool) -> Int {
  if c {
    x / y
  } else {
    x + y
  }
}

pub fn array_sum(xs : Array[Int]) -> Int {
  let mut s = 0
  for x in xs {
    s = s + x
  }
  s
}

pub fn array_update(xs : Array[Int], k : Int) -> Int {
  if xs.length() > 2 {
    xs[0] = xs[1] + k
    xs[2] = xs[0] * 2
  }
  xs.length()
}

pub fn push_some(n : Int) -> Array[Int] {
  let out : Array[Int] = []
  for i in 0..<n {
    out.push(i * i)
  }
  out
}

pub fn calls(a : Int) -> Int {
  let x = clamp(a, 0, 10)
  let y = gcd(a, 12)
  x + y + diamond(x, y)
}

pub fn popcount(x0 : UInt64) -> Int {
  let mut x = x0
  let mut c = 0
  while x != 0UL {
    x = x & (x - 1UL)
    c = c + 1
  }
  c
}

pub fn collatz_steps(n0 : Int64) -> Int {
  let mut n = n0
  let mut steps = 0
  while n > 1L && steps < 1000 {
    if (n & 1L) == 0L {
      n = n / 2L
    } else {
      n = 3L * n + 1L
    }
    steps = steps + 1
  }
  steps
}
