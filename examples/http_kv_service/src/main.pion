///| pion-kv: a multithreaded HTTP/1.1 + JSON key-value service.
///|
///|   http_kv_service --self-test
///|   http_kv_service --port <p> --workers <n> --max-conns <m> [--port-file <path>]
///|
///| Server mode listens on 127.0.0.1:<p> (0 = ephemeral; the real port is written
///| to --port-file, which may be a FIFO the client reads), hands accepted
///| connections to <n> worker OS threads over a `Channel[Int]`, and after <m>
///| connections drains the workers and prints the final `/stats` JSON
///| (`--max-reqs` is the older name of `--max-conns`). Each connection is
///| HTTP/1.1 keep-alive: a worker answers request after request on it
///| (pipelined bytes included) until the client sends `Connection: close`, speaks
///| HTTP/1.0 without keep-alive, or closes; short-lived clients get one exchange.

import "json"
import "http"

pub struct Options {
  self_test : Bool
  port : Int
  workers : Int
  max_reqs : Int
  port_file : String
}

fn parse_int(s : String) -> Option[Int] {
  if s.length() == 0 || s.length() > 9 {
    return None
  }
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  Some(v)
}

fn parse_options(args : Array[String]) -> Result[Options, String] {
  let mut self_test = false
  let mut port = 0
  let mut workers = 4
  let mut max_reqs = 0
  let mut port_file = ""
  let mut i = 1
  while i < args.length() {
    let a = args[i]
    if a == "--self-test" {
      self_test = true
      i = i + 1
      continue
    }
    if i + 1 >= args.length() {
      return Err("missing value for " + a)
    }
    let v = args[i + 1]
    if a == "--port-file" {
      port_file = v
    } else {
      let n = match parse_int(v) {
        Some(n) => n
        None => return Err("invalid number for " + a + ": " + v)
      }
      if a == "--port" {
        port = n
      } else if a == "--workers" {
        workers = n
      } else if a == "--max-reqs" || a == "--max-conns" {
        max_reqs = n
      } else {
        return Err("unknown option " + a)
      }
    }
    i = i + 2
  }
  if !self_test && (workers < 1 || workers > 256 || max_reqs < 1 || port > 65535) {
    return Err("need --workers 1..256, --max-conns >= 1 and --port 0..65535")
  }
  Ok(Options::{
    self_test: self_test,
    port: port,
    workers: workers,
    max_reqs: max_reqs,
    port_file: port_file,
  })
}

/// Serves one connection: request after request (HTTP/1.1 keep-alive and
/// pipelining) until the client asks to close or hangs up; returns how many
/// requests were answered.
fn serve_conn(world : World, svc : Service, fd : Int) -> Int {
  let conn = http::new_conn(fd)
  let mut answered = 0
  while true {
    match http::conn_read_request(world, conn) {
      Ok(Some(req)) => {
        let keep = http::should_keep_alive(req)
        let resp = handle(svc, req.method, req.path, req.body)
        answered = answered + 1
        if !http::write_http_response_ka(world, fd, resp, keep) || !keep {
          break
        }
      }
      Ok(None) => break
      Err(e) => {
        let _ = http::write_http_response(world, fd, http::err_json(400, e))
        answered = answered + 1
        break
      }
    }
  }
  tcp_close(world, fd)
  answered
}

fn serve(world : World, opts : Options) -> Int {
  let lfd = tcp_listen(world, "127.0.0.1", opts.port)
  if lfd < 0 {
    io_eprintln(world, "listen on 127.0.0.1:" + opts.port.to_string() + " failed")
    return 1
  }
  let port = tcp_local_port(world, lfd)
  if opts.port_file.length() > 0 {
    match fs_write(world, opts.port_file, port.to_string() + "\n") {
      Ok(_) => ()
      Err(e) => {
        io_eprintln(world, "write port file: " + e)
        return 1
      }
    }
  }
  io_eprintln(
    world,
    "pion-kv (keep-alive) listening on 127.0.0.1:" + port.to_string() + " workers=" + opts.workers.to_string(),
  )
  let svc = new_service()
  let conns : Channel[Int] = Channel::new(256)
  let accept_errors = AtomicInt::new(0)
  let served = AtomicInt::new(0)
  let max_reqs = opts.max_reqs
  let workers = opts.workers
  scope(world, fn(s : Scope) -> Unit {
    let mut wi = 0
    while wi < workers {
      spawn(s, fn() -> Unit {
        while true {
          match conns.recv() {
            Some(fd) => {
              let _ = serve_conn(world, svc, fd)
              let _ = served.fetch_add(1)
            }
            None => break
          }
        }
      })
      wi = wi + 1
    }
    let mut n = 0
    while n < max_reqs {
      let fd = tcp_accept(world, lfd)
      if fd < 0 {
        let _ = accept_errors.fetch_add(1)
        break
      }
      let _ = conns.send(fd)
      n = n + 1
    }
    conns.close()
  })
  tcp_close(world, lfd)
  let st = stats(svc)
  io_println(world, json::encode(st))
  if accept_errors.load() > 0 || served.load() != max_reqs {
    io_eprintln(world, "served " + served.load().to_string() + " of " + max_reqs.to_string() + " connections")
    return 1
  }
  0
}

// ---------------------------------------------------------------------------
// --self-test: routes, JSON and multithreaded KV stress without the network.

fn expect(world : World, failures : AtomicInt, cond : Bool, what : String) -> Unit {
  if !cond {
    let _ = failures.fetch_add(1)
    io_eprintln(world, "FAIL: " + what)
  }
}

/// One request through the full text path: format, parse, route, format, parse.
fn roundtrip(svc : Service, method : String, path : String, body : String) -> http::HttpResponse {
  let raw = http::format_request(method, "127.0.0.1", 0, path, body)
  match http::parse_response(handle_raw(svc, raw)) {
    Ok(r) => r
    Err(e) => http::err_json(500, "unparsable response: " + e)
  }
}

fn functional(world : World, failures : AtomicInt) -> Unit {
  let svc = new_service()
  let h = roundtrip(svc, "GET", "/health", "")
  expect(world, failures, h.status == 200 && h.body == "{\"ok\":true,\"service\":\"pion-kv\"}", "health: " + h.body)
  let v = "键值服务 🚀 \"quoted\""
  let put_body = json::stringify(json::JObj([json::field("value", json::JStr(v))]))
  let p = roundtrip(svc, "PUT", "/items/greeting%20one", put_body)
  expect(
    world,
    failures,
    p.status == 200 && p.body == "{\"ok\":true,\"key\":\"greeting one\",\"value\":\"键值服务 🚀 \\\"quoted\\\"\"}",
    "put: " + p.body,
  )
  let g = roundtrip(svc, "GET", "/items/greeting%20one", "")
  let back = match json::parse(g.body) {
    Ok(j) =>
    match json::obj_get(j, "value") {
      Some(x) =>
      match json::as_str(x) {
        Some(s) => s
        None => ""
      }
      None => ""
    }
    Err(_) => ""
  }
  expect(world, failures, g.status == 200 && back == v, "get utf-8 value: " + g.body)
  let bad = roundtrip(svc, "PUT", "/items/x", "{\"value\":")
  expect(world, failures, bad.status == 400 && bad.body.contains("invalid json"), "bad json: " + bad.body)
  let wrong = roundtrip(svc, "PUT", "/items/x", "{\"value\":42}")
  expect(world, failures, wrong.status == 400, "non-string value: " + wrong.body)
  let miss = roundtrip(svc, "GET", "/items/nope", "")
  expect(world, failures, miss.status == 404 && miss.body == "{\"error\":\"not found\"}", "miss: " + miss.body)
  let d = roundtrip(svc, "DELETE", "/items/greeting%20one", "")
  expect(world, failures, d.status == 200 && d.body == "{\"deleted\":true}", "delete: " + d.body)
  let d2 = roundtrip(svc, "DELETE", "/items/greeting%20one", "")
  expect(world, failures, d2.status == 404, "delete twice: " + d2.body)
  let nr = roundtrip(svc, "GET", "/nope", "")
  expect(world, failures, nr.status == 404, "no route: " + nr.body)
  let st = roundtrip(svc, "GET", "/stats", "")
  expect(
    world,
    failures,
    st.status == 200 &&
    st.body == "{\"total_reqs\":10,\"keys\":0,\"hits\":1,\"misses\":1,\"puts\":1,\"deletes\":1}",
    "stats: " + st.body,
  )
}

fn stress(world : World, failures : AtomicInt, workers : Int, ops : Int) -> Int64 {
  let svc = new_service()
  let mismatches = AtomicInt::new(0)
  let t0 = clock_now_ms(world)
  scope(world, fn(s : Scope) -> Unit {
    let mut w = 0
    while w < workers {
      let wid = w
      spawn(s, fn() -> Unit {
        let mut i = 0
        while i < ops {
          let key = "w" + wid.to_string() + "-k" + i.to_string()
          let value = "值-" + wid.to_string() + "-" + i.to_string()
          let body = json::stringify(json::JObj([json::field("value", json::JStr(value))]))
          let p = roundtrip(svc, "PUT", "/items/" + key, body)
          let g = roundtrip(svc, "GET", "/items/" + key, "")
          let want = json::encode(ItemResp::{ key: key, value: value })
          if p.status != 200 || g.status != 200 || g.body != want {
            let _ = mismatches.fetch_add(1)
          }
          if i % 2 == 1 {
            let d = roundtrip(svc, "DELETE", "/items/" + key, "")
            let m = roundtrip(svc, "GET", "/items/" + key, "")
            if d.status != 200 || m.status != 404 {
              let _ = mismatches.fetch_add(1)
            }
          }
          i = i + 1
        }
      })
      w = w + 1
    }
  })
  let elapsed = clock_now_ms(world) - t0
  let st = stats(svc)
  let n = workers * ops
  let half = workers * (ops / 2)
  expect(world, failures, mismatches.load() == 0, "stress mismatches: " + mismatches.load().to_string())
  expect(world, failures, st.puts == n && st.keys == n - half, "stress puts/keys: " + json::encode(st))
  expect(world, failures, st.hits == n && st.misses == half && st.deletes == half, "stress hits/misses: " + json::encode(st))
  expect(world, failures, st.total_reqs == 2 * n + 2 * half, "stress total: " + json::encode(st))
  io_println(world, "stress " + workers.to_string() + "x" + ops.to_string() + ": " + json::encode(st))
  elapsed
}

fn body_of(r : Result[http::HttpResponse, String]) -> String {
  match r {
    Ok(resp) => resp.status.to_string() + " " + resp.body
    Err(e) => "error: " + e
  }
}

/// Keep-alive over real 127.0.0.1 TCP: one worker serves a connection that
/// carries three pipelined requests sent in a single write (one chunked), then a
/// fourth with `Connection: close`, after which the server must hang up.
fn keepalive_loopback(world : World, failures : AtomicInt) -> Unit {
  let svc = new_service()
  let lfd = tcp_listen(world, "127.0.0.1", 0)
  if lfd < 0 {
    expect(world, failures, false, "keep-alive: listen failed")
    return
  }
  let port = tcp_local_port(world, lfd)
  let answered = AtomicInt::new(-1)
  scope(world, fn(s : Scope) -> Unit {
    spawn(s, fn() -> Unit {
      let fd = tcp_accept(world, lfd)
      if fd >= 0 {
        answered.store(serve_conn(world, svc, fd))
      }
    })
    let cfd = tcp_connect(world, "127.0.0.1", port)
    if cfd < 0 {
      expect(world, failures, false, "keep-alive: connect failed")
      return
    }
    let put = http::format_request_ka("PUT", "127.0.0.1", port, "/items/ka", "{\"value\":\"v1\"}", true)
    let chunked = "PUT /items/kb HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n" +
    "6\r\n{\"valu\r\n8\r\ne\":\"v2\"}\r\n0\r\n\r\n"
    let get = http::format_request_ka("GET", "127.0.0.1", port, "/items/ka", "", true)
    let batch = put + chunked + get
    expect(world, failures, tcp_write(world, cfd, batch) == batch.length(), "keep-alive: pipelined write")
    let conn = http::new_conn(cfd)
    let r1 = body_of(http::conn_read_response(world, conn))
    let r2 = body_of(http::conn_read_response(world, conn))
    let r3 = body_of(http::conn_read_response(world, conn))
    expect(world, failures, r1 == "200 {\"ok\":true,\"key\":\"ka\",\"value\":\"v1\"}", "keep-alive r1: " + r1)
    expect(world, failures, r2 == "200 {\"ok\":true,\"key\":\"kb\",\"value\":\"v2\"}", "keep-alive r2 (chunked): " + r2)
    expect(world, failures, r3 == "200 {\"key\":\"ka\",\"value\":\"v1\"}", "keep-alive r3: " + r3)
    let last = http::format_request("GET", "127.0.0.1", port, "/stats", "")
    expect(world, failures, tcp_write(world, cfd, last) == last.length(), "keep-alive: final write")
    let r4 = body_of(http::conn_read_response(world, conn))
    expect(
      world,
      failures,
      r4 == "200 {\"total_reqs\":4,\"keys\":2,\"hits\":1,\"misses\":0,\"puts\":2,\"deletes\":0}",
      "keep-alive r4: " + r4,
    )
    let after = body_of(http::conn_read_response(world, conn))
    expect(world, failures, after == "error: connection closed before response", "server closed after close: " + after)
    tcp_close(world, cfd)
  })
  tcp_close(world, lfd)
  expect(world, failures, answered.load() == 4, "keep-alive: answered " + answered.load().to_string())
  io_println(world, "keep-alive loopback: 4 requests on 1 connection (3 pipelined, 1 chunked)")
}

fn self_test(world : World) -> Int {
  let failures = AtomicInt::new(0)
  functional(world, failures)
  keepalive_loopback(world, failures)
  let ms = stress(world, failures, 8, 500)
  if failures.load() != 0 {
    io_eprintln(world, "self-test FAILED: " + failures.load().to_string() + " check(s)")
    return 1
  }
  io_println(world, "self-test ok (stress " + ms.to_string() + " ms)")
  0
}

pub fn main(world : World) -> Int {
  match parse_options(world_args(world)) {
    Ok(opts) => if opts.self_test { self_test(world) } else { serve(world, opts) }
    Err(e) => {
      io_eprintln(world, "error: " + e)
      io_eprintln(
        world,
        "usage: http_kv_service --self-test | --port <p> --workers <n> --max-conns <m> [--port-file <path>]",
      )
      2
    }
  }
}
