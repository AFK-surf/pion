///| https_server tests (pure): router, counters and option parsing. Real TLS
///| sockets run in `--self-test` (driven by `std/tls/e2e/run_server_e2e.sh`).

test "routes and counters" {
  let svc = new_service()
  let h = handle(svc, "GET", "/health", "", "TLSv1.3", "localhost")
  let want_h = "{\"ok\":true,\"service\":\"pion-https\",\"protocol\":\"TLSv1.3\",\"sni\":\"localhost\"}"
  debug_assert(h.status == 200 && h.body == want_h, "health " + h.body)
  let body = "{\"a\":[1,true,null],\"s\":\"值 🚀\"}"
  let e = handle(svc, "POST", "/echo", body, "TLSv1.3", "")
  debug_assert(e.status == 200 && e.body == body && !e.quit, "echo " + e.body)
  let bad = handle(svc, "POST", "/echo", "{\"a\":", "TLSv1.3", "")
  debug_assert(bad.status == 400 && bad.body.contains("invalid json"), "bad json " + bad.body)
  debug_assert(handle(svc, "GET", "/echo", "", "TLSv1.3", "").status == 405, "echo method")
  debug_assert(handle(svc, "GET", "/nope", "", "TLSv1.3", "").status == 404, "no route")
  let st = handle(svc, "GET", "/stats", "", "TLSv1.3", "")
  let want = "{\"total\":6,\"health\":1,\"echo\":1,\"stats\":1,\"bad\":3,\"handshake_failures\":0}"
  debug_assert(st.status == 200 && st.body == want, "stats " + st.body)
  let q = handle(svc, "POST", "/quit", "", "TLSv1.2", "")
  debug_assert(q.status == 200 && q.quit, "quit")
  debug_assert(!handle(svc, "GET", "/quit", "", "TLSv1.2", "").quit, "GET /quit does not stop")
}

test "options" {
  match parse_options(["srv", "--cert", "c.pem", "--key", "k.pem", "--port", "8443", "--max-conns", "3"]) {
    Ok(o) => debug_assert(o.mode == "serve" && o.port == 8443 && o.max_conns == 3 && o.cert == "c.pem", "parsed")
    Err(e) => debug_assert(false, e)
  }
  match parse_options(["srv", "--self-test", "--cert", "c", "--key", "k", "--expect-proto", "TLSv1.2"]) {
    Ok(o) => debug_assert(o.mode == "self-test" && o.expect_proto == "TLSv1.2", "self-test")
    Err(e) => debug_assert(false, e)
  }
  match parse_options(["srv", "--self-test"]) {
    Ok(_) => debug_assert(false, "missing cert accepted")
    Err(e) => debug_assert(e.contains("--cert"), e)
  }
  match parse_options(["srv", "--cert", "c", "--key", "k", "--port", "70000"]) {
    Ok(_) => debug_assert(false, "port 70000 accepted")
    Err(e) => debug_assert(e.contains("--port"), e)
  }
  match parse_options(["srv", "--bogus", "1"]) {
    Ok(_) => debug_assert(false, "bogus accepted")
    Err(e) => debug_assert(e.contains("unknown option"), e)
  }
}
