///| Root package unit tests for pion_station: worker job execution, SSE hub, CLI options.

test "worker execute_job kinds" {
  let h = execute_job(router::JobTask::{
    id: "j1",
    session_id: "s1",
    kind: "hash",
    payload: "abc",
  })
  debug_assert(
    h == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "sha256 abc: " + h
  )

  let rx = execute_job(router::JobTask::{
    id: "j2",
    session_id: "s1",
    kind: "regex_extract",
    payload: "[0-9]+|a=12, b=345, c=6",
  })
  debug_assert(rx == "12,345,6", "regex_extract: " + rx)

  let c1 = execute_job(router::JobTask::{
    id: "j3",
    session_id: "s1",
    kind: "compute",
    payload: "pion-station",
  })
  let c2 = execute_job(router::JobTask::{
    id: "j4",
    session_id: "s1",
    kind: "compute",
    payload: "pion-station",
  })
  debug_assert(c1.starts_with("fnv:") && c1 == c2, "compute deterministic: " + c1)
}

test "sse hub history and broadcast" {
  let hub = new_sse_hub()
  let f1 = format_sse_job_done("j1", "s1", "hash", "deadbeef")
  sse_broadcast(hub, f1)
  let (past, ch) = sse_subscribe(hub)
  debug_assert(past.length() == 1 && past[0] == f1, "past history")
  let f2 = format_sse_job_done("j2", "s1", "compute", "fnv:1")
  sse_broadcast(hub, f2)
  match ch.recv() {
    Some(got) => debug_assert(got == f2, "live broadcast")
    None => debug_assert(false, "channel closed early")
  }
  sse_close_all(hub)
  match ch.recv() {
    Some(_) => debug_assert(false, "expected closed channel")
    None => ()
  }
}

test "cross-package dyn router::Handler dispatch" {
  let c = router::new_counters()
  let rt = router::new_router(c)
  match router::router_add(rt, "GET", "^/info$", "", "", StationInfoHandler::{ version: "1.0", workers: 4 }) {
    Ok(_) => ()
    Err(e) => debug_assert(false, e)
  }
  let resp = router::router_dispatch(rt, "GET", "/info", "", "", "TLSv1.3", "localhost", 0L)
  debug_assert(resp.status == 200 && resp.body.contains("\"version\":\"1.0\""), "info: " + resp.body)
}

test "cli option parsing" {
  match parse_options(["pion_station", "--self-test", "--cert", "c.pem", "--key", "k.pem", "--db", "a.db", "--workers", "4"]) {
    Ok(o) =>
    debug_assert(
      o.mode == "self-test" && o.cert == "c.pem" && o.key == "k.pem" && o.db == "a.db" && o.workers == 4,
      "parsed self-test"
    )
    Err(e) => debug_assert(false, e)
  }
  match parse_options(["pion_station", "--cert", "c.pem"]) {
    Ok(_) => debug_assert(false, "missing key accepted")
    Err(e) => debug_assert(e.contains("--key"), e)
  }
}
