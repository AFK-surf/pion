///| store unit tests: CRUD, transactions, restart/reopen recovery, and consistency.

fn unwrap_store(r : Result[Store, String]) -> Store {
  match r {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "store open failed: " + e)
      Store::{ db_addr: Mutex::new(0L), path: "" }
    }
  }
}

test "libsqlite3 linked" {
  let v = sqlite_version()
  debug_assert(v.starts_with("3."), "expected sqlite 3.x, got " + v)
}

test "sessions, messages, jobs CRUD and stats in memory" {
  let s = unwrap_store(open(":memory:"))
  match create_session(s, "s-1", "Alpha", 1000L) {
    Ok(rec) => debug_assert(rec.id == "s-1" && rec.title == "Alpha" && rec.created_ms == 1000L, "session rec")
    Err(e) => debug_assert(false, e)
  }
  match create_session(s, "s-2", "Beta", 2000L) {
    Ok(_) => ()
    Err(e) => debug_assert(false, e)
  }
  // Duplicate primary key must fail
  match create_session(s, "s-1", "Dup", 3000L) {
    Ok(_) => debug_assert(false, "duplicate session accepted")
    Err(e) => debug_assert(e.contains("UNIQUE") || e.contains("rc=19"), "dup err: " + e)
  }
  match list_sessions(s) {
    Ok(rows) => {
      debug_assert(rows.length() == 2, "2 sessions")
      debug_assert(rows[0].id == "s-1" && rows[1].id == "s-2", "session order")
    }
    Err(e) => debug_assert(false, e)
  }
  match append_message(s, "s-1", "user", "hello 🚀", 1100L) {
    Ok(m) => debug_assert(m.id == 1L && m.role == "user" && m.body == "hello 🚀", "msg 1")
    Err(e) => debug_assert(false, e)
  }
  match append_message(s, "s-1", "agent", "world", 1200L) {
    Ok(m) => debug_assert(m.id == 2L && m.role == "agent", "msg 2")
    Err(e) => debug_assert(false, e)
  }
  match list_messages(s, "s-1") {
    Ok(ms) => {
      debug_assert(ms.length() == 2, "2 messages")
      debug_assert(ms[0].body == "hello 🚀" && ms[1].body == "world", "msg bodies")
    }
    Err(e) => debug_assert(false, e)
  }
  match create_job(s, "j-1", "s-1", "hash", "abc", 1300L) {
    Ok(j) => debug_assert(j.status == "queued" && j.result == "", "job queued")
    Err(e) => debug_assert(false, e)
  }
  match update_job(s, "j-1", "done", "ba7816bf", 1400L) {
    Ok(_) => ()
    Err(e) => debug_assert(false, e)
  }
  match get_job(s, "j-1") {
    Ok(Some(j)) => debug_assert(j.status == "done" && j.result == "ba7816bf", "job done")
    Ok(None) => debug_assert(false, "job missing")
    Err(e) => debug_assert(false, e)
  }
  match stats(s) {
    Ok(st) =>
    debug_assert(
      st.sessions == 2L && st.messages == 2L && st.jobs_done == 1L && st.jobs_total == 1L,
      "stats mismatch"
    )
    Err(e) => debug_assert(false, e)
  }
  match close(s) {
    Ok(_) => ()
    Err(e) => debug_assert(false, e)
  }
}

test "restart persistence recovery on file DB" {
  let path = "/tmp/pion_station_store_ut.db"
  let s1 = unwrap_store(open(path))
  match clear_all(s1) {
    Ok(_) => ()
    Err(e) => debug_assert(false, e)
  }
  let _ = create_session(s1, "pers-1", "Recovered Session", 10L)
  let _ = append_message(s1, "pers-1", "user", "survives restart", 20L)
  let _ = create_job(s1, "job-p1", "pers-1", "compute", "42", 30L)
  let _ = update_job(s1, "job-p1", "done", "result-42", 40L)
  match close(s1) {
    Ok(_) => ()
    Err(e) => debug_assert(false, e)
  }
  // Reopen the same file DB and verify all rows survived
  let s2 = unwrap_store(open(path))
  match stats(s2) {
    Ok(st) =>
    debug_assert(
      st.sessions == 1L && st.messages == 1L && st.jobs_done == 1L && st.jobs_total == 1L,
      "recovered stats"
    )
    Err(e) => debug_assert(false, e)
  }
  match get_session(s2, "pers-1") {
    Ok(Some(rec)) => debug_assert(rec.title == "Recovered Session", "recovered session title")
    _ => debug_assert(false, "recovered session missing")
  }
  match list_messages(s2, "pers-1") {
    Ok(ms) => debug_assert(ms.length() == 1 && ms[0].body == "survives restart", "recovered message")
    _ => debug_assert(false, "recovered messages missing")
  }
  match get_job(s2, "job-p1") {
    Ok(Some(j)) => debug_assert(j.status == "done" && j.result == "result-42", "recovered job")
    _ => debug_assert(false, "recovered job missing")
  }
  let _ = clear_all(s2)
  let _ = close(s2)
}
