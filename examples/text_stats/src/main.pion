import "analyzer" as az

pub fn merge_stats(a : az::Stats, b : az::Stats) -> az::Stats {
  let total_words = a.words + b.words
  let avg = if total_words > 0 {
    math_floor(
      ((a.avg_word_len * a.words + b.avg_word_len * b.words) as Double) /
      (total_words as Double),
    ).to_int()
  } else {
    0
  }
  az::Stats::{
    lines: a.lines + b.lines,
    words: total_words,
    bytes: a.bytes + b.bytes,
    avg_word_len: avg,
    tagged: a.tagged + b.tagged,
  }
}

pub fn main(world : World) -> Int {
  let ch : Channel[az::Stats] = Channel::new(4)
  let doc1 = "# pion overview\nfast native compiler with biased rc"
  let doc2 = "multi package workspace\nzero target dir pollution in pion"
  scope(world, fn(s : Scope) -> Unit {
    spawn(s, fn() -> Unit {
      let _ = ch.send(az::analyze_text(doc1))
    })
    spawn(s, fn() -> Unit {
      let _ = ch.send(az::analyze_text(doc2))
    })
  })
  ch.close()
  let mut total = az::Stats::{
    lines: 0,
    words: 0,
    bytes: 0,
    avg_word_len: 0,
    tagged: 0,
  }
  let mut done = false
  while !done {
    match ch.recv() {
      Some(st) => total = merge_stats(total, st)
      None => done = true
    }
  }
  let tmp_path = "/tmp/pion_text_stats_demo.bin"
  let payload = az::normalize_preview("lines=" + total.lines.to_string() + ",words=" + total.words.to_string())
  match fs_write_bytes(world, tmp_path, payload.to_bytes()) {
    Ok(_) => ()
    Err(e) => {
      io_eprintln(world, "write failed: " + e)
      return 1
    }
  }
  let _ = fs_append(world, tmp_path, "\n")
  let mtime = fs_mtime_ms(world, tmp_path)
  let read_back = match fs_read_bytes(world, tmp_path) {
    Ok(bs) => bs.to_string().trim()
    Err(e) => {
      io_eprintln(world, "read failed: " + e)
      return 1
    }
  }
  let _ = fs_remove(world, tmp_path)
  let echo_out = match proc_exec_capture(world, ["echo", "pion-exec-ok"]) {
    Ok(out) => out.trim()
    Err(e) => {
      io_eprintln(world, "exec failed: " + e)
      return 1
    }
  }
  debug_assert(total.lines == 4, "expected 4 total lines")
  debug_assert(total.words == 18, "expected 18 total words")
  debug_assert(total.tagged == 2, "expected 2 tagged lines")
  debug_assert(mtime > 0L, "expected positive mtime")
  debug_assert(read_back == payload, "bytes roundtrip mismatch")
  debug_assert(echo_out == "pion-exec-ok", "proc_exec_capture mismatch")
  io_println(
    world,
    "text_stats ok: lines=" +
    total.lines.to_string() +
    " words=" +
    total.words.to_string() +
    " tagged=" +
    total.tagged.to_string() +
    " exec=" +
    echo_out,
  )
  0
}

test "app integration" {
  let s1 = az::analyze_text("# pion test\nalpha beta")
  let s2 = az::analyze_text("gamma delta pion")
  let merged = merge_stats(s1, s2)
  debug_assert(merged.lines == 3, "merged lines")
  debug_assert(merged.words == 8, "merged words")
  debug_assert(merged.tagged == 2, "merged tagged")
}
