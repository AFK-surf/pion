pub val struct Stats {
  lines : Int
  words : Int
  bytes : Int
  avg_word_len : Int
  tagged : Int
}

pub fn normalize_preview(s : String) -> String {
  let clean = s.trim().replace("\r\n", "\n")
  let raw_bytes = clean.to_bytes()
  let header = Bytes::new(6)
  header[0] = b'['
  header[1] = b'p'
  header[2] = b'i'
  header[3] = b'o'
  header[4] = b'n'
  header[5] = b']'
  let prefix = header.slice(0, 6)
  let combined = prefix.concat(raw_bytes)
  combined.to_string()
}

pub fn analyze_text(raw : String) -> Stats {
  let normalized = raw.trim().replace("\r\n", "\n")
  let lines = normalized.split("\n")
  let mut line_count = 0
  let mut word_count = 0
  let mut char_total = 0
  let mut tagged_count = 0
  let mut i = 0
  while i < lines.length() {
    let line = lines[i].trim()
    if line.length() > 0 {
      line_count = line_count + 1
      if line.starts_with("#") || line.contains("pion") {
        tagged_count = tagged_count + 1
      }
      let parts = line.split(" ")
      let mut j = 0
      while j < parts.length() {
        let w = parts[j].trim()
        if w.length() > 0 {
          word_count = word_count + 1
          char_total = char_total + w.length()
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  let byte_len = normalized.to_bytes().length()
  let avg_len = if word_count > 0 {
    math_floor((char_total as Double) / (word_count as Double)).to_int()
  } else {
    0
  }
  Stats::{
    lines: line_count,
    words: word_count,
    bytes: byte_len,
    avg_word_len: avg_len,
    tagged: tagged_count,
  }
}

test "analyzer basics" {
  let sample = "  # pion fast compiler\nhello world from pion  "
  let st = analyze_text(sample)
  debug_assert(st.lines == 2, "expected 2 lines")
  debug_assert(st.words == 8, "expected 8 words")
  debug_assert(st.tagged == 2, "expected 2 tagged lines")
  debug_assert(st.avg_word_len == 4, "expected avg_word_len == 4")
  let prev = normalize_preview("  hi  ")
  debug_assert(prev == "[pion]hi", "normalize_preview roundtrip")
  debug_assert(prev.starts_with("[pion]") && prev.ends_with("hi"), "starts/ends_with")
  debug_assert(prev.index_of("hi") == 6, "index_of")
}
