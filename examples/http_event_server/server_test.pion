///| http_event_server tests (pure): routes, counters, the pipelined request
///| framer and option parsing. Real kqueue/epoll IO runs in `--self-test`.

test "routes and counters" {
  let svc = new_service()
  debug_assert(handle(svc, "GET", "/health", "").body == "{\"ok\":true,\"service\":\"pion-event-kv\"}", "health")
  debug_assert(handle(svc, "POST", "/health", "").status == 405, "health method")
  let p = handle(svc, "PUT", "/kv/user%3A1", "{\"value\":\"ada\"}")
  debug_assert(p.status == 200 && p.body == "{\"ok\":true,\"key\":\"user:1\"}", "put " + p.body)
  let g = handle(svc, "GET", "/kv/user%3A1", "")
  debug_assert(g.status == 200 && g.body == "{\"key\":\"user:1\",\"value\":\"ada\"}", "get " + g.body)
  debug_assert(handle(svc, "GET", "/kv/ghost", "").status == 404, "miss")
  debug_assert(handle(svc, "DELETE", "/kv/user%3A1", "").status == 405, "no delete")
  debug_assert(handle(svc, "GET", "/kv/", "").status == 400, "empty key")
  debug_assert(handle(svc, "PUT", "/kv/x", "{\"value\":1}").status == 400, "non-string value")
  debug_assert(handle(svc, "GET", "/nope", "").status == 404, "no route")
  let st = handle(svc, "GET", "/stats", "")
  let want = "{\"total_reqs\":10,\"keys\":1,\"hits\":1,\"misses\":1,\"puts\":1,\"bad_requests\":2,\"accepted\":0}"
  debug_assert(st.body == want, "stats " + st.body)
}

test "pipelined framing keeps partial requests" {
  let svc = new_service()
  let out = StringBuilder()
  let one = "PUT /kv/a HTTP/1.1\r\nContent-Length: 13\r\n\r\n{\"value\":\"1\"}"
  let two = "GET /kv/a HTTP/1.1\r\n\r\n"
  let (used, n, close) = answer_buffered(svc, one + "\r\n" + two + "GET /kv", out)
  debug_assert(!close && n == 2 && used == one.length() + 2 + two.length(), "used " + used.to_string())
  let text = out.to_string()
  debug_assert(text.starts_with("HTTP/1.1 200 OK\r\n"), "first: " + text)
  debug_assert(text.ends_with("{\"key\":\"a\",\"value\":\"1\"}"), "second: " + text)
  debug_assert(text.contains("Connection: keep-alive"), "keep-alive: " + text)
  let out2 = StringBuilder()
  let (u2, n2, c2) = answer_buffered(svc, "GET /health HTTP/1.1\r\n", out2)
  debug_assert(u2 == 0 && n2 == 0 && !c2 && out2.to_string() == "", "incomplete head waits")
  let out3 = StringBuilder()
  let (u3, n3, c3) = answer_buffered(svc, "\r\n\r\n", out3)
  debug_assert(u3 == 0 && n3 == 0 && !c3 && out3.to_string() == "", "blank lines wait for a request")
}

test "options" {
  match parse_options(["srv", "--port", "8080", "--workers", "4", "--max-reqs", "40001"]) {
    Ok(o) => debug_assert(o.port == 8080 && o.workers == 4 && o.max_reqs == 40001 && !o.self_test, "parsed")
    Err(e) => debug_assert(false, e)
  }
  match parse_options(["srv", "--workers", "0"]) {
    Ok(_) => debug_assert(false, "0 workers accepted")
    Err(e) => debug_assert(e.contains("--workers"), e)
  }
  match parse_options(["srv", "--bogus", "1"]) {
    Ok(_) => debug_assert(false, "bogus accepted")
    Err(e) => debug_assert(e.contains("unknown option"), e)
  }
}
